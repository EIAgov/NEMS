					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlanYear_ALTB),
					coeff_cEXXX_DSP_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}
				Comment: "subbituminous diversity row by Coal Demand region, plant type (coal), and planning year (trillion Btu * 0.1)";
			}
			Constraint rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: F(*)(**)GEN(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					coeff_cEMRX_RNW_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((RetireGroup),
					coeff_cEXX0_INT_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,RetireGroup) *
					      cEXX0_INT(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((RetireGroup),
					coeff_cEXX0_RNW_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_DGN_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_INT_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) *
					      cEXXX_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyState,SupplyRegion_ALTa),
					coeff_cG_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,SupplyState,SupplyRegion_ALTa) *
					      cG(SupplyState,PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear))
					+
					coeff_cGDG_PV_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cGDG_PV(SupplyRegion_ALT1,PlanYear)
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cH_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					coeff_cHGEN_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cHGEN(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					coeff_cHSAF_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cHSAF(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cJ_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cJM_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cJMR_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cJX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cJXX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cM_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyState),
					coeff_cNN_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,SupplyState) *
					      cNN(SupplyState,PlantType,SupplyRegion_ALT1,PlanYear))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cO_DISP_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cO_HYD_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((Seasonx),
					coeff_cOMR_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cOXX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cU_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cUM_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUMR_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cUX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUXX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyState),
					coeff_cXX_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,SupplyState) *
					      cXX(SupplyState,PlantType,SupplyRegion_ALT1,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cZMrnw_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cZXrnw_rFGENge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					>=
					
					0.
				}
				Comment: "generation balance row by EMM region, plant type and planning year (billion kwh)";
			}
			Constraint rFL_H2le {
				IndexDomain: (Season,CensusRegion_ALT1,PlanYear);
				Text: "OML Rows: FL_H2(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rFL_H2le(Season,CensusRegion_ALT1,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((H2SupplyStep),
					coeff_cSUH2_rFL_H2le(Season,CensusRegion_ALT1,PlanYear,H2SupplyStep) *
					      cSUH2(CensusRegion_ALT1,H2SupplyStep,Season,PlanYear))
					
					<=
					
					0.
				}
				Comment: "hydrogen fuel balance row by  season, Fuel (census) region, and planning year (trillion Btu)";
			}
			Constraint rFL_NGle {
				IndexDomain: (GasSeason,FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: FL_NG(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,ECPFuelType),
					coeff_cF_rFL_NGle(GasSeason,FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((FuelSupplyStep),
					coeff_cTNG_rFL_NGle(GasSeason,FuelRegion_ALT1,PlanYear,FuelSupplyStep) *
					      cTNG(FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear))
					+
					coeff_cTNG0_rFL_NGle(GasSeason,FuelRegion_ALT1,PlanYear) *
					      cTNG0(FuelRegion_ALT1,GasSeason,PlanYear)
					+
					sum((PlantType,ECPFuelType),
					coeff_cY_rFL_NGle(GasSeason,FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "natural gas transportation fuel balance row by Gas season, Fuel region, and planning year (trillion Btu)";
			}
			Constraint rFMRle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear);
				Text: "OML Rows: F(*)(**)MR(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rFMRle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cM_rFMRle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((PlantType,ECPFuelType),
					coeff_cY_rFMRle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,PlantType,ECPFuelType) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "Fuel balance row for must-run capacity by fuel region, plant type (oil or gas only), gas season and planning year (trill Btu)";
			}
			Constraint rFUELDSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: FUELDS(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,ECPFuelType,GasSeason),
					coeff_cF_rFUELDSle(FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					coeff_cTDSXX_rFUELDSle(FuelRegion_ALT1,PlanYear) *
					      cTDSXX(FuelRegion_ALT1,PlanYear)
					+
					sum((PlantType,ECPFuelType,GasSeason),
					coeff_cY_rFUELDSle(FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "transportation fuel balance row for distillate fuel, by fuel region and planning year (trillion Btu)";
			}
			Constraint rFUELNGXle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: FUELNGX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rFUELNGXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rFUELNGXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rFUELNGXle(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((GasSupplyStep),
					coeff_cSUNGX_rFUELNGXle(PlanYear,GasSupplyStep) *
					      cSUNGX(GasSupplyStep,PlanYear))
					+
					sum((FuelRegion_ALT1,FuelSupplyStep,GasSeason),
					coeff_cTNG_rFUELNGXle(PlanYear,FuelRegion_ALT1,FuelSupplyStep,GasSeason) *
					      cTNG(FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear))
					+
					sum((FuelRegion_ALT1,GasSeason),
					coeff_cTNG0_rFUELNGXle(PlanYear,FuelRegion_ALT1,GasSeason) *
					      cTNG0(FuelRegion_ALT1,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "production balance row for natural gas, by planning year (trillion Btu)";
			}
			Constraint rFUELOLXle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: FUELOLX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rFUELOLXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rFUELOLXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rFUELOLXle(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((OilSupplyStep),
					coeff_cSUOLX_rFUELOLXle(PlanYear,OilSupplyStep) *
					      cSUOLX(OilSupplyStep,PlanYear))
					+
					sum((FuelRegion_ALT1),
					coeff_cTDSXX_rFUELOLXle(PlanYear,FuelRegion_ALT1) *
					      cTDSXX(FuelRegion_ALT1,PlanYear))
					+
					sum((FuelRegion_ALT1),
					coeff_cTRSXX_rFUELOLXle(PlanYear,FuelRegion_ALT1) *
					      cTRSXX(FuelRegion_ALT1,PlanYear))
					
					<=
					
					0.
				}
				Comment: "production balance row for total oil use, by planning year (trillion Btu)";
			}
			Constraint rFUELRSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: FUELRS(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,ECPFuelType,GasSeason),
					coeff_cF_rFUELRSle(FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					coeff_cTRSXX_rFUELRSle(FuelRegion_ALT1,PlanYear) *
					      cTRSXX(FuelRegion_ALT1,PlanYear)
					+
					sum((PlantType,ECPFuelType,GasSeason),
					coeff_cY_rFUELRSle(FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "transportation fuel balance row for residual fuel, by fuel region and planning year (trillion Btu)";
			}
			Constraint rFWDXle {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,PlanYear);
				Text: "OML Rows: F(*)WD(**)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((BiomassSector),
					coeff_cDX_rFWDXle(CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassSector) *
					      cDX(CoalDemandRegion_ALT1,BiomassSector,BiomassType,PlanYear))
					+
					coeff_cSWD_rFWDXle(CoalDemandRegion_ALT1,BiomassType,PlanYear) *
					      cSWD(CoalDemandRegion_ALT1,BiomassType,PlanYear)
					+
					sum((BiomassStep),
					coeff_cSWDX_rFWDXle(CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassStep) *
					      cSWDX(CoalDemandRegion_ALT1,BiomassStep,PlanYear))
					+
					sum((BiomassStep),
					coeff_cSX_rFWDXle(CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassStep) *
					      cSX(CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear))
					
					<=
					
					0.
				}
				Comment: "transportation balance row for biomass by coal demand region, biomass type and planning year (trillion Btu)";
			}
			Constraint rFWDXXXle {
				IndexDomain: (CoalDemandRegion_ALT1,PlanYear);
				Text: "OML Rows: F(*)WDXXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cJM_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cJX_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((BiomassType),
					coeff_cSWD_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,BiomassType) *
					      cSWD(CoalDemandRegion_ALT1,BiomassType,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cUM_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cUX_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber),
					coeff_cW_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cZMrnw_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cZXrnw_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					<=
					
					0.
				}
				Comment: "production balance row for biomass by coal demand region and planning year (trillion Btu)";
			}
			Constraint rFXXle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear);
				Text: "OML Rows: F(*)(**)XX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType,ECPFuelType),
					coeff_cF_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,PlantType,ECPFuelType) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rFXXle(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					
					<=
					
					0.
				}
				Comment: "total fuel balance row for oil or gas capacity by fuel region, plant type, gas season and planning year (trillion Btu)";
			}
			Constraint rFXXSle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear);
				Text: "OML Rows: F(*)(**)(*)XX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType),
					coeff_cFXX_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,PlantType) *
					      cFXX(FuelRegion_ALT1,PlantType,Scrubber,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cM_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((CoalSupplyCurve,ACIOption),
					coeff_cT_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,CoalSupplyCurve,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,BioCOFCF,PlantType),
					coeff_cW_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,BioCOFCF,PlantType) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					<=
					
					0.
				}
				Comment: "fuel balance row for coal capacity by fuel region, plant type, scrub or unscrub and planning year (trillion Btu)";
			}
			Constraint rGBASge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: G(*)(**)BAS(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEBAS_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cEBAS(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cH_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cJM_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cJMR_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cJX_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cJXX_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cO_HYD_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((Seasonx),
					coeff_cOMR_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cOXX_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cUM_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUMR_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cUX_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUXX_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cZMrnw_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cZXrnw_rGBASge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					>=
					
					0.
				}
				Comment: "row to exclude existing generation from baseline";
			}
			Constraint rGCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Rows: G(*)CFGEN(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cRCFGEN_rGCFGENge(SupplyRegion_ALT1,PlanYear) *
					      cRCFGEN(SupplyRegion_ALT1,PlanYear)
					+
					sum((FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber),
					coeff_cW_rGCFGENge(SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					>=
					
					coeff_cRHS_rGCFGENge(SupplyRegion_ALT1,PlanYear)
				}
				Comment: "impose minimum cofiring generation by EMM region and planning year (billion kwh)";
			}
			Constraint rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: G(*)(**)INC(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEGEN_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cEGEN(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					coeff_cIGEN_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cIGEN(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cJ_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cM_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cO_DISP_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cU_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cXGEN_rGINCge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cXGEN(SupplyRegion_ALT1,PlantType,PlanYear)
					
					>=
					
					0.
				}
				Comment: "row to determine incremental generation";
			}
			Constraint rGNNUCge {
				IndexDomain: (SupplyState,PlanYear);
				Text: "OML Rows: GN(**)NUC(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,Nuclear),
					coeff_cNUC_rGNNUCge(SupplyState,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					
					>=
					
					coeff_cRHS_rGNNUCge(SupplyState,PlanYear)
				}
				Comment: "required generation from nuclear plants receiving zero emission credits or subsidies by state and planning year (billion kwh)";
			}
			Constraint rGRGRDge {
				IndexDomain: (SupplyRegion_ALT2,PlanYear);
				Text: "OML Rows: GRGRD(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rGRGRDge(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+

				!EP$ORNW,37 (2)
				ccalc_cJMR_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				1 - ccalc_cJMR_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)
				endif;
				
				! MAX Electricity - MIN SR
				!EP$ORNW,38 (1)
				ccalc_cUX_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 THEN
				round(1 - UPFORT(OtherRenewable), 2)
				endif;
				ccalc_cUX_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) |
				ccalc_cUX_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)<=ECP_MIN('1')):=0;
				
				!EP$ORNW,38 (2)
				ccalc_cUXX_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 THEN
				round(1 - UPFORT(OtherRenewable), 2)
				endif;
				ccalc_cUXX_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) |
				ccalc_cUXX_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)<=ECP_MIN('1')):=0;
				
				!EP$ORNW,39 (1)
				ccalc_cUM_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				round(1 - UPFORT(OtherRenewable), 2)
				endif;
				ccalc_cUM_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) |
				ccalc_cUM_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)<=ECP_MIN('1')):=0;
				
				!EP$ORNW,39 (2)
				ccalc_cUMR_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				round(1 - UPFORT(OtherRenewable), 2)
				endif;
				ccalc_cUMR_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) |
				ccalc_cUMR_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)<=ECP_MIN('1')):=0;
				
				!EP$ORNW,44 (1)
				ccalc_cUX_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 THEN
				1 - ccalc_cUX_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)
				endif;
				
				!EP$ORNW,44 (2)
				ccalc_cUXX_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 THEN
				1 - ccalc_cUXX_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)
				endif;
				
				!EP$ORNW,45 (1)
				ccalc_cUM_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				1 - ccalc_cUM_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)
				endif;
				
				!EP$ORNW,45 (2)
				ccalc_cUMR_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=

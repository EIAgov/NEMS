					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rLUSUBXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rLUSUBXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rLUSUBXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLUSUBXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLUSUBXle(PlantType_ALT2)
				}
				Comment: "impose capacity limit on subsidized builds if required (GW)";
			}
			Constraint rLUXXCCSle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: LUXXCCS(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rLUXXCCSle(PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rLUXXCCSle(PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					coeff_cRHS_rLUXXCCSle(PlanYear)
				}
				Comment: "national limit on CCS retrofits (GW)";
			}
			Constraint rLUXXCOFle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: LUXXCOF(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB),
					coeff_cBCOF_rLUXXCOFle(PlanYear,SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB) *
					      cBCOF(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLUXXCOFle(PlanYear)
				}
				Comment: "national limit on cofiring retrofits (GW)";
			}
			Constraint rLXXINTle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Rows: L(*)XXINT(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,RetireGroup),
					coeff_cEXX0_INT_rLXXINTle(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) *
					      cEXX0_INT(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_INT_rLXXINTle(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					coeff_cGELXXX_rLXXINTle(SupplyRegion_ALT1,PlanYear) *
					      cGELXXX(SupplyRegion_ALT1,PlanYear)
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLXXINTle(SupplyRegion_ALT1,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLXXINTle(SupplyRegion_ALT1,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLXXINTle(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLXXINTle(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					coeff_cRINTXX_rLXXINTle(SupplyRegion_ALT1,PlanYear) *
					      cRINTXX(SupplyRegion_ALT1,PlanYear)
					
					<=
					
					0.
				}
				Comment: "limit regional intermittent generation to share of total generation (billion kWh)";
			}
			Constraint rMELle {
				IndexDomain: (SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: M(*)EL(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1),
					coeff_cBELYY_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALT1) *
					      cBELYY(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTEL_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((CanadianSupplyRegion),
					coeff_cTELCAN_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion) *
					      cTELCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTSR_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((CanadianSupplyRegion),
					coeff_cTSRCAN_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion) *
					      cTSRCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					coeff_cRHS_rMELle(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear)
				}
				Comment: "limit total imports from other regions (GW)";
			}
			Constraint rMVSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear);
				Text: "OML Rows: MVSO2(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto),
					coeff_cMVS_rMVSO2le(CoalDemandRegion,PlanYear,CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto) *
					      cMVS(CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto,PlanYear))
					
					<=
					
					coeff_cRHS_rMVSO2le(CoalDemandRegion,PlanYear)
				}
				Comment: "limit SO2 allowance purchases from other regions - CSAPR (thousand tons)";
			}
			Constraint rMXXeq {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: M(*)(**)X(*)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rMXXeq(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rMXXeq(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rMXXeq(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					=
					0.
				}
				Comment: "impose planned maintenance requirement (billion kWh)";
			}
			Constraint rMXXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: M(*)(**)X(*)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cE_MR_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType) *
					      cE_MR(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_DSP_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,RetireGroup) *
					      cEXX0_DSP(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_DSP_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((PlantType,Season),
					coeff_cPH_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,Season) *
					      cPH(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((PlantType,Season),
					coeff_cPM_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,Season) *
					      cPM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((PlantType,Season),
					coeff_cPX_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,Season) *
					      cPX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((PlantType,Season),
					coeff_cPY_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,Season) *
					      cPY(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rMXXge(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					>=
					
					0.
				}
				Comment: "impose planned maintenance requirement (billion kWh)";
			}
			Constraint rNGCLCFge {
				IndexDomain: (CoalGroup,PlanYear_ALTB);
				Text: "OML Rows: GCF(****)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cNNG_rNGCLCFge(CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB)
					+
					sum((CommitYear),
					coeff_cNNGCL_rNGCLCFge(CoalGroup,PlanYear_ALTB,CommitYear) *
					      cNNGCL(CommitYear,CoalGroup))
					
					>=
					
					0.
				}
				Comment: "coal and gas cofiring capacity balance constraint to ensure coal part of capacity being always greater than gas part (GW) when cofiring is chosen";
			}
			Constraint rNUCle {
				IndexDomain: (Nuclear,PlanYear);
				Text: "OML Rows: NUC(****)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear),
					coeff_cNUC_rNUCle(Nuclear,PlanYear,CommitYear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR),
					coeff_cNUCSR_rNUCle(Nuclear,PlanYear,CommitYearSR) *
					      cNUCSR(CommitYearSR,Nuclear))
					
					<=
					
					coeff_cRHS_rNUCle(Nuclear,PlanYear)
				}
				Comment: "capacity balance row for nuclear units (GW)";
			}
			Constraint rNUCeq {
				IndexDomain: (Nuclear,PlanYear);
				Text: "OML Rows: NUC(****)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear),
					coeff_cNUC_rNUCeq(Nuclear,PlanYear,CommitYear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR),
					coeff_cNUCSR_rNUCeq(Nuclear,PlanYear,CommitYearSR) *
					      cNUCSR(CommitYearSR,Nuclear))
					
					=
					coeff_cRHS_rNUCeq(Nuclear,PlanYear)
				}
				Comment: "capacity balance row for must run nuclear units (GW)";
			}
			Constraint rO0le {
				IndexDomain: (NaturalGasGroup,PlantType);
				Text: "OML Rows: O(****)(**)0";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((NGCommitYear),
					coeff_cE_rO0le(NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					
					<=
					
					coeff_cRHS_rO0le(NaturalGasGroup,PlantType)
				}
				Comment: "capacity balance row for baseload gas units (GW)   **** index should be NatGasGroup ***";
			}
			Constraint rOHRIle {
				IndexDomain: (CoalGroup);
				Text: "OML Rows: O(****)HRI";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((HTRTYear,RetrofitCFG),
					coeff_cRETROHTRT_rOHRIle(CoalGroup,HTRTYear,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					0.
				}
				Comment: "Row to Commit Heat Rate Improvement Retrofits for all years";
			}
			Constraint rOXXle {
				IndexDomain: (CoalGroup,PlanYear);
				Text: "OML Rows: O(****)XX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cNNG_rOXXle(CoalGroup,PlanYear,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear),
					coeff_cNNGCL_rOXXle(CoalGroup,PlanYear,CommitYear) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((CommitYear,RetrofitCFG),
					coeff_cRETRO_rOXXle(CoalGroup,PlanYear,CommitYear,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,RetrofitCFG),
					coeff_cRETROHTRT_rOXXle(CoalGroup,PlanYear,HTRTYear,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					coeff_cRHS_rOXXle(CoalGroup,PlanYear)
				}
				Comment: "capacity balance row for coal units (GW)";
			}
			Constraint rP2ELXeq {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,PlanYear);
				Text: "OML Rows: P2(*)ELX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((LoadGroup,LoadSegment),
					coeff_c2EL_rP2ELXeq(SupplyRegion_ALT1,Seasonx,PlanYear,LoadGroup,LoadSegment) *
					      c2EL(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((PlantType,LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rP2ELXeq(SupplyRegion_ALT1,Seasonx,PlanYear,PlantType,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((PlantType,LoadGroup,LoadSegment),
					coeff_cO_HYD_rP2ELXeq(SupplyRegion_ALT1,Seasonx,PlanYear,PlantType,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					
					=
					0.
				}
				Comment: "energy balance for demand response technology (use must balance storage during season) (billion kWh)";
			}
			Constraint rPSELXle {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,PlanYear);
				Text: "OML Rows: PS(*)ELX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rPSELXle(SupplyRegion_ALT1,Seasonx,PlanYear,PlantType,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((PlantType,LoadGroup,LoadSegment),
					coeff_cO_HYD_rPSELXle(SupplyRegion_ALT1,Seasonx,PlanYear,PlantType,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((LoadGroup,LoadSegment),
					coeff_cSEL_rPSELXle(SupplyRegion_ALT1,Seasonx,PlanYear,LoadGroup,LoadSegment) *
					      cSEL(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					0.
				}
				Comment: "energy balance for pumped storage capacity (billion kWh)";
			}
			Constraint rQMRXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: Q(*)(**)MRX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cM_rQMRXge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cQXMR_rQMRXge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cQXMR(SupplyRegion_ALT1,PlantType,PlanYear)
					
					>=
					
					coeff_cRHS_rQMRXge(SupplyRegion_ALT1,PlantType,PlanYear)
				}
				Comment: "force must run requirements for dispatchable plant types (billion kWh)";
			}
			Constraint rQXXXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: Q(*)(**)XXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEMRX_RNW_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((Seasonx,LoadGroup,LoadSegment),
					coeff_cH_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx,LoadGroup,LoadSegment) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cJM_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cJMR_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cOMR_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cUM_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUMR_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,Seasonx),
					coeff_cZMrnw_rQXXXge(SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					>=
					
					0.
				}
				Comment: "force must run requirements for renewable plant types (billion kWh)";
			}
			Constraint rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1);
				Text: "OML Rows: R(*)MXRET0";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,PlanYear),
					coeff_cE_MR_rRMXRET0ge(SupplyRegion_ALT1,PlantType,PlanYear) *
					      cE_MR(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),

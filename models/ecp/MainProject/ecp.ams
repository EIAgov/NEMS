			Parameter ccalc_cEVN_rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear,PlantType) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: EVN(**)(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))>0 AND NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))< 9990.0) THEN
					if TST_NOX_COAL(PlantType, NOXRegion, PlanYear)>0 then
					-1
					endif
					endif
				}
				Comment: "EP$COAL,92";
			}
			Parameter ccalc_cEVN_rEUNOXn {
				IndexDomain: (NOXRegion,PlanYear,PlantType) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: EVN(**)(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))<=0 or NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))>= 9990.0) THEN
					if TST_NOX_COAL(PlantType, NOXRegion, PlanYear)>0 then
					-1
					endif
					endif
				}
				Comment: "EP$COAL,92";
			}
			Parameter ccalc_cEVN_rEVNle {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Text: "OML Columns: EVN(**)(**)(*) and OML Rows: EVN(**)(**)(*)";
				Definition: {
					if TST_NOX_COAL(PlantType, NOXRegion, PlanYear)>0 and ord(PlanYear)>NOX_LT('1') then
					1
					endif
				}
				Comment: "EP$COAL,91";
			}
			Parameter ccalc_cRHS_rKge {
				IndexDomain: (CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)| ord(CoalType)=TOT_TYPE(CoalSupplyCurve);
				Text: "OML Columns: RHSECP and OML Rows: K(**)(**)(*)(*)(*)";
				Definition: {
					if EFD_CONT(CoalSupplyCurve, CoalDemandRegion_ALT1, Scrubber_element(Scrubber), LastModelYear_TYR(PlanYear))>ECP_MIN('1') AND
					TOT_TYPE(CoalSupplyCurve) > 0 then
					EFD_CONT(CoalSupplyCurve, CoalDemandRegion_ALT1, Scrubber_element(Scrubber), LastModelYear_TYR(PlanYear)) * 0.1
					endif
				}
				Comment: "EP$COAL,94";
			}
		}
		DeclarationSection EP_CPS_Completed;
		DeclarationSection EP_CPP_Completed;
		DeclarationSection EP_CPP2_Completed;
		DeclarationSection EP_CSUPPLY_Completed {
			Parameter StepSize {
				IndexDomain: CoalSupplyStep;
				Definition: {
					if ord(CoalSupplyStep)>1 then
						sum(eleven|ord(eleven)=ord(ec::CoalSupplyStep), XCL_STEPS(Eleven)-XCL_STEPS(Eleven-1))
					else
						sum(eleven|ord(eleven)=ord(ec::CoalSupplyStep), 1+ XCL_STEPS(Eleven))
					endif;
				}
			}
			Parameter VAL_OTH {
				IndexDomain: (CoalSupplyCurve,PlanYear);
			}
			Parameter VAL_SO2_EPA {
				IndexDomain: (PlantType,CoalSupplyCurve,FuelRegion_ALT1,SO2Region,numACI,PlanYear);
			}
			Parameter C_HTRT {
				IndexDomain: (CoalPlant,CoalDemandRegion,PlanYear);
			}
			Parameter Allowed {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType,numACI);
			}
			Parameter MACT_EMF {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType);
			}
			Parameter MACT_SW {
				IndexDomain: (EmissionRank,PlantType);
			}
			Parameter EMF_T {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType,numACI);
			}
			Parameter ACI {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType,numACI);
			}
			Parameter EMF_PRCNT {
				IndexDomain: (EmissionRank,PlantType);
			}
			Parameter EMF_IN {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType);
			}
			Parameter EMF_OUT {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlantType);
			}
			Parameter COF_CMB {
				IndexDomain: (BiomassCOF,BiomassOption);
				Definition: {
					if (ord(BiomassCOF) = 1 and ord(BiomassOption) = 1) then
					  1
					elseif (ord(BiomassCOF) = 1 and ord(BiomassOption) = 2) then
					  2
					elseif (ord(BiomassCOF) = 1 and ord(BiomassOption) = 3) then
					  3
					elseif (ord(BiomassCOF) = 1 and ord(BiomassOption) = 4) then
					  4
					elseif (ord(BiomassCOF) = 1 and ord(BiomassOption) = 5) then
					  5
					elseif (ord(BiomassCOF) = 1 and ord(BiomassOption) = 6) then
					  6
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 1) then
					  7
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 2) then
					  8
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 3) then
					  9
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 4) then
					  10
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 5) then
					  11
					elseif (ord(BiomassCOF) = 2 and ord(BiomassOption) = 6) then
					  12
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 1) then
					  13
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 2) then
					  14
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 3) then
					  15
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 4) then
					  16
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 5) then
					  17
					elseif (ord(BiomassCOF) = 3 and ord(BiomassOption) = 6) then
					  18
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 1) then
					  19
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 2) then
					  20
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 3) then
					  21
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 4) then
					  22
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 5) then
					  23
					elseif (ord(BiomassCOF) = 4 and ord(BiomassOption) = 6) then
					  24
					elseif (ord(BiomassCOF) = 5 and ord(BiomassOption) = 1) then
					  25
					elseif (ord(BiomassCOF) = 5 and ord(BiomassOption) = 2) then
					  26
					endif
				}
			}
			ElementParameter BiomassCOF_Element {
				IndexDomain: BioCOFCF;
				Range: BiomassCOF_;
			}
			ElementParameter BiomassOption_Element {
				IndexDomain: BioCOFCF;
				Range: BiomassOption_;
			}

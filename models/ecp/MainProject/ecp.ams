				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				round(SR_MIN_CF(OtherRenewable),2)
				else
				round(0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr), 2)
				endif
				endif;
				ccalc_cJM_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) |
				ccalc_cJM_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)<=ECP_MIN('1')):=0;
				

					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALTfrom)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALTfrom) > 0) and SupplyRegion_ALT1=SupplyRegion_ALTZ and PlantType=PlantType_ALT1 and
					MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999
				}
				Text: {

		DeclarationSection EPO_ELAST_Completed {
			Parameter ULEL_calc {
				IndexDomain: (MNUMYR,PlantType_ALT2);
				Definition: {
					IF (MNUMYR = cyr + 1) THEN
					    IF (UPVTYP(PlantType_ALT2) > 0) THEN
					
					    	IF (UPOVR(PlantType_ALT2) < 9999.0 AND UPAVLYR(PlantType_ALT2) <= (UPPLYR(PlantType_ALT2) + ORD(cyr) + UHBSYR('1')) AND ESTSWTCH(PlantType_ALT2) > 0 )THEN
					
					    		IF (rLUle(PlantType_ALT2,DispatchType_element(PlantType_ALT2),'1','1').Level >= rLUle(PlantType_ALT2,DispatchType_element(PlantType_ALT2),'1','1').Upper ) THEN
					    			 1
					    		ELSE
					    			0
					
					     		ENDIF
					     	ENDIF
					     ENDIF
					ELSE
						ULEL(MNUMYR,PlantType_ALT2)
					ENDIF
				}
			}
			Parameter ULOV_calc {
				IndexDomain: MNUMYR;
				Definition: {
					
					/*
					** Not active in current model - national overbuild constraint **
					
					               IF (ICAP .EQ. WICT)THEN
					                   ULOV_CH(MIN(CURIYR + OLYR - 1,MNUMYR)) = '  NA'
					                   ROW = 'RUYYYYY'//UPYRCD(YEAR + UPPLYR(ICAP)); call makmsk(ROW_mask,':RUYYYYY:',UPYRCD(YEAR + UPPLYR(ICAP)))
					                   CALL CWFSROW(ROW,'AUP     ',STATUS,CVALUE,ROW_mask,IRET)
					                  IF (IRET .EQ. 0)THEN
					                   ACT = CVALUE(1)
					                   UPPER = CVALUE(2)
					                   DUAL_VALUE = CVALUE(3)
					                   IF (UPAVLYR(ICAP) .LE. FULLYR) THEN
					                     IF (ACT .GE. UPPER)THEN
					                        ULOV(MIN(CURIYR + OLYR - 1,MNUMYR)) = 1
					                        ULOV_CH(MIN(CURIYR + OLYR - 1,MNUMYR)) = ' YES'
					                     ELSE
					                        ULOV(MIN(CURIYR + OLYR - 1,MNUMYR)) = 0
					                        ULOV_CH(MIN(CURIYR + OLYR - 1,MNUMYR)) = '  NO'
					                     END IF
					                   END IF
					                   */
				}
			}
		}
		DeclarationSection EPO_COF_Completed;
		DeclarationSection EPO_SEQBNS_Completed;
	}

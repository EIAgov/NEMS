				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and GRD_RATS(DSP_Types, SupplyRegion_SUB)> 0):=
				
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				 (GRD_RATS(DSP_Types, SupplyRegion_SUB) - GRD_NRYR(SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))) *
				 GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * 0.001
				endif;
				!EP$ODSP,92
				ccalc_cO_DISP_rGRGRDge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |

					PlanYear=RetirementPlanYear
				}
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: R(*)MXRET0"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and UPRETRAT('1')>0 THEN
					if TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					1
					endif
					endif
				}
				Comment: "EP$BRNW,62";
			}
			Parameter ccalc_cEMRX_RNW_rQXXXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: Q(*)(**)XXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					-8.760 * MIN(MUSTRUN(PlantType, SupplyRegion_ALT1), TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear) * UPFORT(PlantType)) / TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)
					endif
					endif
				}
				Comment: "EP$BRNW,64";
			}
			Parameter ccalc_cRHS_rLRENle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: RHSECP and OML Rows: L(*)(**)REN(*)";
				Definition: {
					IF ((UPVTYP(PlantType)= 1) AND OLYEAR(PlanYear, PlantType) <= UNXPH('1')) THEN
					if ESTSWTCH(PlantType)>0 and UPAVLYR(PlantType)<=FULLYEAR_ALT(PlanYear, PlantType) then
					IF (OLYEAR(PlanYear, PlantType) < UNXPH('1')) THEN
					        EPBLDBND(RnwStor(PlantType), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					ELSE
					        5.0 * EPBLDBND(RnwStor(PlantType), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					ENDIF
					endif
					endif
				}
				Comment: "EP$BRNW,66";
			}
			Parameter ccalc_cRHS_rLRNle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(ElasticityStep)<=EPSTSUP(RnwStor(PlantType), SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: RHSECP and OML Rows: L(*)(**)RN(*)(*)";
				Definition: {
					IF ((UPVTYP(PlantType)= 1) AND OLYEAR(PlanYear, PlantType) <= UNXPH('1')) THEN
					if ESTSWTCH(PlantType)<0 and UPAVLYR(PlantType)<=FULLYEAR_ALT(PlanYear, PlantType) then
					EPBDSUP(RnwStor(PlantType), ElasticityStep_Element(ElasticityStep), SupplyRegion_ALT1, cyr)
					endif
					endif
				}
				Comment: "EP$BRNW,67";
			}
			Parameter ccalc_cBBIO_rLRENle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) | (PlantType=WIWD_Element or PlantType=WIBI_Element) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!BIO and OML Rows: L(*)(**)REN(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					IF (ESTSWTCH(PlantType) > 0) THEN
					1

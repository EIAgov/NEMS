					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: L(*)XXINT(*)";

			        put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			        for (PlantType,OwnerType) do
			            if EPLVCAP(PlantType,OwnerType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,ord(OwnerType):<10:0,EPLVCAP(PlantType,OwnerType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPLVEXT":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPLVEXT(PlantType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,EPLVEXT(PlantType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 

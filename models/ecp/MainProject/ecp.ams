			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPRENEW":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (ExplicitPlanningHorizon) do
			            if EPRENEW(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(ExplicitPlanningHorizon):<10:0,EPRENEW(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPRMRGN":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (ExplicitPlanningHorizon) do
			            if EPRMRGN(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(ExplicitPlanningHorizon):<10:0,EPRMRGN(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPTAVD":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPTAVD(PlantType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,EPTAVD(PlantType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			      endfor; 
			      putclose;
		}
	}

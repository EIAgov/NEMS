				}
			}
			Parameter ccalc_cBSNUC_rLBLDXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND
					UPVTYP(PlantType)= 1 and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND UPOVR(PlantType) < 9000 and PlantType=PlantType_ALT2 and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: L(*)(**)BLDX"
				}
				Definition: {
					if UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)<999 then
					1
					endif
				}
				Comment: "EP$NUC,60";
			}
			Parameter ccalc_cBXNUC_rLBLDXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND
					UPVTYP(PlantType)= 1 and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND UPOVR(PlantType) < 9000 and PlantType=PlantType_ALT2
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!NUC and OML Rows: L(*)(**)BLDX"
				}
				Definition: {
					if UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)<999 then
					1
					endif
				}
				Comment: "EP$NUC,60";
			}
			Parameter ccalc_cBSNUC_rLUBLDXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND
					UPVTYP(PlantType)= 1 and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND UPOVR(PlantType) < 9000 and PlantType=PlantType_ALT2 and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: LU(**)BLDX"
				}
				Definition: {
					if UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND UPBLDREG_us00(PlantType)<999 then
					1
					endif
				}
				Comment: "EP$NUC,59";
			}
			Parameter ccalc_cBXNUC_rLUBLDXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND
					UPVTYP(PlantType)= 1 and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND UPOVR(PlantType) < 9000 and PlantType=PlantType_ALT2
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!NUC and OML Rows: LU(**)BLDX"
				}
				Definition: {
					if UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND UPBLDREG_us00(PlantType)<999 then
					1
					endif
				}
				Comment: "EP$NUC,59";
			}
			Parameter ccalc_cBSNUC_rLUANNle {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPOVR(PlantType) < 9000 and PlanYear=PlanYear_ALTB and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
				}
				Comment: "EP$NUC,51";
			}
			Parameter ccalc_cBXNUC_rLUANNle {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPOVR(PlantType) < 9000 and PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!NUC and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
				}
				Comment: "EP$NUC,51";
			}
		}
		DeclarationSection EP_ODSP_Completed {
			Parameter Condition_ODSP {
				IndexDomain: (SupplyRegion_SUB,DSP_Types,FuelRegion,PlanYear,OperatingMode,Season);
			}
			Parameter Condition_ODSP_ALT {
				IndexDomain: (SupplyRegion_SUB,DSP_Types,PlanYear,OperatingMode,Season);
			}
			Parameter DSP_HTRT_NMR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					AVG_HTRT(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
					endif
				}
			}
			Parameter HR_NMR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					1 $ (AVG_HTRT(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0)
					endif
				}
			}
			Parameter DSP_HTRT_MR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					AVG_HTRT_MR(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
					endif
				}
			}
			Parameter HR_MR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					1 $ (AVG_HTRT_MR(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0)
					endif
				}
			}
			Parameter DSP_HTRT_MOD_NMR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					AVG_HTRT_MOD(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
					endif
				}
			}
			Parameter HR_MOD_NMR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					1 $ (AVG_HTRT_MOD(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0)
					endif
				}
			}
			Parameter DSP_HTRT_MOD_MR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					AVG_HTRT_MR_MOD(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
					endif
				}
			}
			Parameter HR_MOD_MR {
				IndexDomain: (DispatchableECP, FuelRegion, SupplyRegion_SUB, PlanYear) | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF (FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 0) OR (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)> 0 AND UPVTYP(DispatchableECP)= 1) THEN
					1 $ (AVG_HTRT_MR_MOD(DispatchableECP, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0)
					endif
				}
			}
			Parameter MCF_ODSP {
				IndexDomain: (SupplyRegion,PlantType,PlanYear) | PlantType in DSP_Types_ and ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(PlantType,SupplyRegion) > 0)) THEN
					    IF (UPVTYP(PlantType)= 0) THEN
					        IF (UPMAXCF(PlantType, SupplyRegion, LastModelYear_MNUMYR4(PlanYear))> 0) THEN
					                UPMAXCF(PlantType, SupplyRegion, LastModelYear_MNUMYR4(PlanYear))
					        else
					                EPECFC(PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					        endif
					    else
					        UPMCF(PlantType)
					    endif
					endif
				}
			}
			Parameter FOR_ODSP {
				IndexDomain: (SupplyRegion,PlantType,PlanYear) | PlantType in DSP_Types_ and ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(PlantType,SupplyRegion) > 0)) THEN
					    IF UPVTYP(PlantType)= 0 and UPMAXCF(PlantType, SupplyRegion, LastModelYear_MNUMYR4(PlanYear))> 0 and UP_XFOR(PlantType, SupplyRegion, LastModelYear_MNUMYR4(PlanYear)) THEN
					        UP_XFOR(PlantType, SupplyRegion, LastModelYear_MNUMYR4(PlanYear))
					    else
					        UPFORT(PlantType)
					    endif
					endif
				}
			}
			Parameter ADJ_HGHT_ODSP {
				IndexDomain: (SupplyRegion,PlanYear);
				Definition: UOUNCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear)) + UOUCCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear));
				Comment: "excludes firm trade";
			}
			Parameter MAX_HGHT_ODSP {
				IndexDomain: (SupplyRegion,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion,cyr);
				Definition: {
					Max(SlicePerSeason | ord(SlicePerSeason)<=NSTP(Season, SupplyRegion) ,
					   (EPHGHT(VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					       + ADJ_HGHT_ODSP(SupplyRegion,PlanYear)))
				}
				Comment: "excludes firm trade";
			}
			Parameter MIN_HGHT_ODSP {
				IndexDomain: (SupplyRegion,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion,cyr);
				Definition: {
					Min(SlicePerSeason | ord(SlicePerSeason)<=NSTP(Season, SupplyRegion) ,
					   (EPHGHT(VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					       + ADJ_HGHT_ODSP(SupplyRegion,PlanYear)))
				}
				Comment: "excludes firm trade";
			}
			Parameter DERATE_ODSP {
				IndexDomain: (DispatchableECP, SliceGroup, SupplyRegion, PlanYear) | ord(SupplyRegion)<=UNRGNS('1') and DispatchableECP in DSP_Types_ and ord(SliceGroup)<=9;
				Definition: {
					IF (EPECAP(FuelRegion0, DispatchableECP, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(DispatchableECP)= 1 AND
					UPAVLYR(DispatchableECP)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(DispatchableECP,SupplyRegion) >0) ) THEN
					IF (IFOSBS(DispatchableECP) = 1) THEN
					   MAX((1 - FOR_ODSP(SupplyRegion, DispatchableECP, PlanYear)) *
					   FOS_CF_ECP(StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), SupplyRegion),SR_MIN_CF(DispatchableECP))
					ELSE
					   (1 - FOR_ODSP(SupplyRegion, DispatchableECP, PlanYear)) *
					(EPHGHT(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) +
					   ADJ_HGHT_ODSP(SupplyRegion, PlanYear)) / MAX_HGHT_ODSP(SupplyRegion, VLSSeason_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion), PlanYear)
					ENDIF
					endif
				}
			}
			Parameter GEN_ODSP {
				IndexDomain: (DispatchableECP, Season, SupplyRegion, FuelRegion,  OperatingMode, PlanYear);
			}
			Parameter IFOSBS {
				IndexDomain: DispatchableECP;
				Definition: {
					IF (UPPCFB(DispatchableECP, One_Element)> 0.001 AND UPAVLYR(DispatchableECP)< 9000) THEN   !set flag for baseload fossil types which will use RESTORE CF mode
					        1
					ENDIF
				}
			}
			Parameter VALUE_MIN_SR_ODSP {
				IndexDomain: (DispatchableECP,SliceGroup,SupplyRegion,PlanYear);
			}
			Parameter GEN_MIN_SR_ODSP {
				IndexDomain: (DispatchableECP,Season,SupplyRegion,FuelRegion,OperatingMode,PlanYear);
			}
			Parameter VALUE_MAX_SR_ODSP {
				IndexDomain: (DispatchableECP,SliceGroup,SupplyRegion,PlanYear);
			}
			Parameter GEN_MAX_SR_ODSP {
				IndexDomain: (DispatchableECP,Season,SupplyRegion,FuelRegion,OperatingMode,PlanYear);
			}
			Parameter load_level {
				IndexDomain: (PlantType, Season, SupplyRegion, FuelRegion, OperatingMode, PlanYear);
			}
			Parameter HTRT_ADJ {
				IndexDomain: (SupplyRegion, PlantType, FuelRegion, OperatingMode, Season, PlanYear);
			}
			Parameter HTRT_ADJ_MIN {
				IndexDomain: (SupplyRegion, PlantType, FuelRegion, OperatingMode, Season, PlanYear);
			}
			Parameter HTRT_ADJ_MAX {
				IndexDomain: (SupplyRegion, PlantType, FuelRegion, OperatingMode, Season, PlanYear);
			}
			Parameter VOM_DSP {
				IndexDomain: (DispatchableECP, SupplyRegion, FullPlanningHorizon) | DispatchableECP in DSP_Types_ and ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, DispatchableECP, Explicit2FullPlanningHorizon(FullPlanningHorizon), SupplyRegion, cyr)>0 OR (UPVTYP(DispatchableECP)= 1 AND
					UPAVLYR(DispatchableECP)<=FULLYEAR_YR(PlanYear_FullPlanningHorizon(FullPlanningHorizon))) OR (WPTTYP(DispatchableECP,SupplyRegion) > 0)) THEN
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * EPVOM(DispatchableECP, SupplyRegion, cyr) * 1000.0
					endif
				}
			}
			Parameter VOMCST_DSP {
				IndexDomain: (DispatchableECP, SupplyRegion, PlanYear) | DispatchableECP in DSP_Types_ and ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					VOM_DSP(DispatchableECP, SupplyRegion, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion,cyr),Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOM_DSP(DispatchableECP, SupplyRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion,cyr))) *
					VOM_DSP(DispatchableECP, SupplyRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + EPDSCRT('1',SupplyRegion,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion,cyr),UNXPH01)(PlanYear)
					endif
				}
			}
			Parameter ccalc_cRHS_rQMRXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: RHSECP and OML Rows: Q(*)(**)MRX(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) ) and MUSTRUN(PlantType, SupplyRegion_ALT1) THEN
					  min(MCF_ODSP(SupplyRegion_ALT1, PlantType, PlanYear) * EPECAP_MR(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) * 8.760,
					  MUSTRUN(PlantType, SupplyRegion_ALT1)) * 0.001
					endif
				}
				Comment: "EP$ODSP,1";
			}
			Parameter ccalc_cQXMR_rQMRXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: Q(*)(**)XMR(*) and OML Rows: Q(*)(**)MRX(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR WPTTYP(PlantType,SupplyRegion_ALT1)>0 ) and MUSTRUN(PlantType, SupplyRegion_ALT1) THEN
					1
					endif
				}
				Comment: "EP$ODSP,2";
			}
			Parameter ccalc_cQXMR_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: Q(*)(**)XMR(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR WPTTYP(PlantType,SupplyRegion_ALT1)>0) and MUSTRUN(PlantType, SupplyRegion_ALT1) THEN
					2000
					endif
				}
				Comment: "EP$ODSP,3";
			}
			Parameter ccalc_cON_rCXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType_ALT2=PlantType and
					(PlantType=WIET_Element OR PlantType=WICT_Element OR PlantType= WIAT_Element) and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: O(*)(*)(**)N(*)(*) and OML Rows: C(*)(**)X(*)(*)(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(PlantType,SupplyRegion_ALT1)>0) ) THEN
					IF (HR_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear)  OR
					HR_MOD_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear)  ) THEN
					1
					endif
					endif
				}
				Comment: "EP$ODSP,4";
			}
			Parameter ccalc_cMN_rCMle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType_ALT2=PlantType and
					(PlantType=WIET_Element OR PlantType=WICT_Element OR PlantType= WIAT_Element) and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: M(*)(*)(**)N(*)(*) and OML Rows: C(*)(**)M(*)(*)(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(PlantType,SupplyRegion_ALT1)>0)) and
					EPECAP_MR(FuelRegion_ALT1, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 THEN
					IF (HR_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear) OR HR_MR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear) OR
					HR_MOD_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear) OR HR_MOD_MR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear) ) THEN
					1
					endif
					endif
				}
				Comment: "EP$ODSP,5";
			}
			Parameter ccalc_cON_rNSRn {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType,Season) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(Seasonx)=ord(Season) and
					(PlantType=WIET_Element OR PlantType=WICT_Element OR PlantType= WIAT_Element) and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr) and
					LoadGroup = LoadGroup_element(LoadGroup, Season) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: O(*)(*)(**)N(*)(*) and OML Rows: N(*)SR(*)(*)(*)(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND
					UPAVLYR(PlantType)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(PlantType,SupplyRegion_ALT1)>0) ) THEN
					IF (HR_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear) OR
					HR_MOD_NMR(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear)  ) THEN
					1 - FOR_ODSP(SupplyRegion_ALT1, PlantType, PlanYear)
					endif
					endif
				}
				Comment: "EP$ODSP,6";
			}
			Parameter ccalc_cMN_rNSRn {

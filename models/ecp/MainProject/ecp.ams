				!EP$ORNW,29 (1)
				ccalc_cZMrnw_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				(1  -EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) * SR_CREDIT(OtherRenewable)
				endif;
				
				!EP$ORNW,29 (2)
				ccalc_cOMR_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				(1 - EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) * SR_CREDIT(OtherRenewable)
				endif;
				
				!MIN Electricity - MAX SR
				!EP$ORNW,30 (1)
				ccalc_cJX_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=

		DeclarationSection EP_RELRM_Completed;
		DeclarationSection EP_RET_Completed {
			Parameter ccalc_cRHS_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1);
				Text: "OML Columns: RHSECP and OML Rows: R(*)MXRET0";
				Definition: {
					!        REVISE RHS FOR RETIREMENT LIMIT ROWS
					IF (USW_ERET('1') = 1 AND UPRETRAT('1') > 0.0) THEN
					
					max((sum(beforeWIPC | (USW_BACT('1') <= 0 or (UHBSYR('1') + val(cyr) + UPRTLT('1')) < UBACT_YR('1')) and
					(UHBSYR('1') + val(cyr) + UPRTLT('1'))<> UDSI_YR('1') and (UHBSYR('1') + val(cyr) + UPRTLT('1'))<> UYR_ACE('01'),
					EPECAP0(beforeWIPC, ExplicitPlanningHorizon_element2,SupplyRegion_ALT1,cyr))+
					sum(afterWIPC, EPECAP0(afterWIPC, ExplicitPlanningHorizon_element2,SupplyRegion_ALT1,cyr)) )*0.001*(1 - UPRETRAT('1')),0)
					
					endif
								!
								!        REVISE RHS FOR RETIREMENT LIMIT ROWS
								!
									  !  VALUE = 0.0
								!         DO IP = 1 , WIPC - 1
								!         Exclude Existing Coal if Retrofit/Retirement Decision Forced
								!          IF ((USW_BACT <= 0 .OR. (UHBSYR + CURIYR + UPRTLT) < UBACT_YR) .AND.  &
								!              (UHBSYR + CURIYR + UPRTLT) .NE. UDSI_YR) THEN
								!            VALUE = VALUE + DBLE(EPECAP(0,UCPDSPI(IP),UPRTLT + 1) * 0.001)
								 !         END IF
								 !        END DO
								!         DO IP = WIPC , ECP$DSP
								!            VALUE = VALUE + DBLE(EPECAP(0,UCPDSPI(IP),UPRTLT + 1) * 0.001)
								!         END DO
								!sum(PlantType,EPECAP(PlantType | PlantType <> 'DB' and PlantType <> 'DP' ,ExplicitPlanningHorizon_element2,SupplyRegion_ALT1,cyr) * 0.001*(1.0 - UPRETRAT('1')))
								!UCPINTI(Intermittent)
									! DO IP = 1 , ECP$INT
									    !(EPECAP(0,UCPINTI(IP),UPRTLT + 1) * 0.001)
									!END DO
								!         DO IP = 1 , ECP$STO
								  !          IF (UCPSTOI(IP) .GT. 0) THEN
									      ! VALUE = VALUE + DBLE(EPECAP(0,UCPSTOI(IP),UPRTLT + 1) * 0.001)
									   ! END IF
								 !        END DO
								   !      DO IP = 1 , ECP$RNW
								   !         IF (UCPRNWI(IP) .GT. 0) THEN
									       !VALUE = VALUE + DBLE(EPECAP(0,UCPRNWI(IP),UPRTLT + 1) * 0.001)
								   !         END IF
								 !        END DO
								!         IF ((USW_BACT .LE. 0 .OR. (UHBSYR + CURIYR + UPRTLT) .LT. UBACT_YR) .AND.  &
								!             (UHBSYR + CURIYR + UPRTLT) .NE. UDSI_YR) THEN
								  !           VALUE = VALUE * DBLE(1.0 - UPRETRAT)
								!         ELSE
								!            VALUE = VALUE * DBLE(MIN(0.75,(1.0 - UPRETRAT)))
								!         END IF
								!        VALUE = MAX ( VALUE , DBLE(0.0) )
								!        VALUE = DIGITS2( VALUE , DIGITS_PARM)
								  !       CALL CRHS(UPRHS,ROW,VALUE,ROW_mask)
								  !    END IF
				}
				Comment: "EP$RET,3";
			}
			Parameter ccalc_cEMXRET0_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)MXRET0 and OML Rows: R(*)MXRET0";
				Definition: {
					IF (USW_ERET('1') = 1 AND UPRETRAT('1') > 0.0) THEN
					   1
					ENDIF
				}
				Comment: "EP$RET,1";
			}
			Parameter ccalc_cEMXRET0_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)MXRET0 and OML Rows: ECPCOSTS";
				Definition: {
					IF (USW_ERET('1') = 1 AND UPRETRAT('1') > 0.0) THEN
					   2000
					ENDIF
				}
				Comment: "EP$RET,2";
			}
		}
		DeclarationSection EP_RFS_Completed {
			Parameter T_BM {
				IndexDomain: (BiomassStep, CoalDemandRegion, FullPlanningHorizon, BiomassType)  | ord(BiomassStep)<=NM_BM_SUP_STP('1');
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					if ord(BiomassStep)=1 then
					max(0, WDSUP_Q(BiomassStep_element(BiomassStep), CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType))
					else
					max(0, WDSUP_Q(BiomassStep_element(BiomassStep), CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType) -
					WDSUP_Q(BiomassStep_element(BiomassStep)-1, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType))
					endif
					ENDIF
				}
			}
			Parameter T1_BM {
				IndexDomain: (BiomassStep, CoalDemandRegion, FullPlanningHorizon, BiomassType)  | ord(BiomassStep)<=NM_BM_SUP_STP('1');
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					max(0, UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * WDSUP_P(BiomassStep_element(BiomassStep), CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType))
					ENDIF
				}
			}
			Parameter Biomass_Bound {
				IndexDomain: (BiomassStep, CoalDemandRegion, PlanYear, BiomassType)  | ord(BiomassStep)<=NM_BM_SUP_STP('1');
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					T_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon_PlanYear(PlanYear), BiomassType)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(T_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon+2, BiomassType),ord(FullPlanningHorizon),AVGDCR))/
					T_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon+(UNXPH('1')-1), BiomassType) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
			}
			Parameter Biomass_Cost {
				IndexDomain: (BiomassStep, CoalDemandRegion, PlanYear, BiomassType)  | ord(BiomassStep)<=NM_BM_SUP_STP('1');
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					T1_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon_PlanYear(PlanYear), BiomassType) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(T1_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon+2, BiomassType),ord(FullPlanningHorizon),AVGDCR)) *
					T1_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon+(UNXPH('1')-1), BiomassType) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					endif
				}
				Comment: "BTU Costs for Biomass Fuel Supply Curve";
			}
			Parameter MP_BM_SEC {
				IndexDomain: (BiomassSector, BiomassType);
				Definition: {
					if BiomassSector='RS' then
					MP_BM_RS(BiomassType) !Residential
					elseif BiomassSector='CM' then
					MP_BM_CM(BiomassType) !Commercial
					elseif BiomassSector='IN' then
					MP_BM_IN(BiomassType) !Industrial
					elseif BiomassSector='H2' then
					MP_BM_H2(BiomassType) !Hydrogen Production
					elseif BiomassSector='ET' then
					MP_BM_ET(BiomassType) !Cellulosic Ethanol Production
					elseif BiomassSector='BT' then
					MP_BM_BT(BiomassType) !Biomass to Liquids
					endif
				}
			}
			Parameter QBMSECCL {
				IndexDomain: (BiomassSector, BiomassType, CoalDemandRegion, FullPlanningHorizon);
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					if BiomassSector='RS' then
					max(0, QBMRSCL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Residential
					elseif BiomassSector='CM' then
					max(0, QBMCMCL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Commercial
					elseif BiomassSector='IN' then
					max(0, QBMINCL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Industrial
					elseif BiomassSector='H2' then
					 max(0, QBMH2CL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Hydrogen Production
					elseif BiomassSector='ET' then
					max(0, QBMETCL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Cellulosic Ethanol Production
					elseif BiomassSector='BT' then
					max(0, QBMBTCL(BiomassType, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon))) !Biomass to Liquids
					endif
					endif
				}
			}
			Parameter ccalc_cSWD_rFWDXXXle {
				IndexDomain: (CoalDemandRegion_ALT1,PlanYear,BiomassType);
				Text: "OML Columns: S(*)WD(**)(*) and OML Rows: F(*)WDXXX(*)";
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					-1
					ENDIF
				}
				Comment: "EP$RFS,3";
			}
			Parameter ccalc_cSWD_rFWDXle {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,PlanYear);
				Text: "OML Columns: S(*)WD(**)(*) and OML Rows: F(*)WD(**)X(*)";
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					1
					ENDIF
				}
				Comment: "EP$RFS,4";
			}
			Parameter ccalc_cSWDX_ECPCOSTS {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassStep,PlanYear) | ord(BiomassStep)=NM_BM_SUP_STP('1')+1;
				Text: "OML Columns: S(*)WDX(**)(*) and OML Rows: ECPCOSTS";
				Definition: 9999.9;
				Comment: "EP$RFS,8";
			}
			Parameter ccalc_cSWDX_rFWDXle {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassStep) | ord(BiomassStep)=NM_BM_SUP_STP('1')+1;
				Text: "OML Columns: S(*)WDX(**)(*) and OML Rows: F(*)WD(**)X(*)";
				Definition: {
					IF (WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0) THEN
					-1
					ENDIF
				}
				Comment: "EP$RFS,9";
			}
			Parameter ccalc_cSX_UBOUND {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear);
				Text: "OML Columns: S(*)(**)X(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if Biomass_Bound(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType) >0 then
					Biomass_Bound(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType)
					else
					inf
					endif
				}
				Comment: "EP$RFS,5";
			}
			Parameter ccalc_cSX_rFWDXle {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassStep);
				Text: "OML Columns: S(*)(**)X(**)(*) and OML Rows: F(*)WD(**)X(*)";
				Definition: {
					if Biomass_Bound(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType) >0 then
					-1
					endif
				}
				Comment: "EP$RFS,6";
			}
			Parameter ccalc_cSX_ECPCOSTS {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear);
				Text: "OML Columns: S(*)(**)X(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if Biomass_Bound(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType) >0  and
					abs(Biomass_Cost(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType))>=ECP_MIN('1') then
					Biomass_Cost(BiomassStep, CoalDemandRegion_ALT1, PlanYear, BiomassType)
					endif
				}
				Comment: "EP$RFS,7";
			}
			Parameter ccalc_cDX_LBOUND {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassSector,BiomassType,PlanYear);
				Text: "OML Columns: D(*)(**)(**)X(*) and OML Rows: LBOUND";
				Definition: {
					IF WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0 AND MP_BM_SEC(BiomassSector, BiomassType) THEN
					if ord(PlanYear)<UNXPH('1') then
					QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))/
					QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
					ENDIF
				}
				Comment: {
					"EP$RFS,11; EP$RFS,13; EP$RFS,15; EP$RFS,17; EP$RFS,19; EP$RFS,21;"
				}
			}
			Parameter ccalc_cDX_rFWDXle {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassType,PlanYear,BiomassSector);
				Text: "OML Columns: D(*)(**)(**)X(*) and OML Rows: F(*)WD(**)X(*)";
				Definition: {
					IF WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0 AND MP_BM_SEC(BiomassSector, BiomassType) THEN
					1
					ENDIF
				}
				Comment: {
					"EP$RFS,10; EP$RFS,12; EP$RFS,14; EP$RFS,16; EP$RFS,18; EP$RFS,20;"
				}
			}
			Parameter ccalc_cDX_UBOUND {
				IndexDomain: (CoalDemandRegion_ALT1,BiomassSector,BiomassType,PlanYear);
				Text: "OML Columns: D(*)(**)(**)X(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0 AND MP_BM_SEC(BiomassSector, BiomassType) THEN
					if ord(PlanYear)<UNXPH('1') then
					QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))/
					QBMSECCL(BiomassSector, BiomassType, CoalDemandRegion_ALT1, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
					ELSE
					inf
					ENDIF
				}
				Comment: {
					"EP$RFS,11; EP$RFS,13; EP$RFS,15; EP$RFS,17; EP$RFS,19; EP$RFS,21;"
				}
			}
		}
		DeclarationSection EP_RPS_Completed {
			Parameter GENX {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					Sum(SliceGroup | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)),
					         EPHGHT(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) *
					         EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)/1000.0 )
				}
			}
			Parameter DEMX {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1'))THEN
					     IF (ORD(CYR) + ORD(PlanYear) -1  <= UNYEAR('1') ) THEN
					           QELASN(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) * 0.001
					     ELSE
					           QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1')))) * 0.001 *
					             (MAX(1.0,(QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1'))))
					                / QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1')-20)))) ^ (1.0 / 20.0) ))
					                ^ ((ORD(CYR) + ORD(PlanYear) -1  ) - UNYEAR('1'))
					     ENDIF
					ELSE
					     PVVDEM(SupplyRegion_ALT1) / PVV_ONE(SupplyRegion_ALT1)
					ENDIF
				}
			}
			Parameter DEM {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					     IF (ORD(CYR) + ORD(FullPlanningHorizon) -1  <= UNYEAR('1') ) THEN
					           QELASN(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001
					     ELSE
					           QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1')))) * 0.001 *
					             (MAX(1.0,(QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1'))))
					                / QELASN(SupplyRegion_ALT1,Element(MNUMYR_,(UNYEAR('1')-20)))) ^ (1.0 / 20.0) ))
					                ^ ((ORD(CYR) + ORD(FullPlanningHorizon) -1  ) - UNYEAR('1'))
					     ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVVDEM {
				IndexDomain: SupplyRegion_ALT1;
				Definition: SUM(FullPlanningHorizon,(DEM(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
			}
			Parameter RPS {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					    UPRNWBND(LastModelYear_MNUMYRX2(FullPlanningHorizon))
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter RPSR {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					    UPRNWBNDR(LastModelYear_MNUMYRX2(FullPlanningHorizon),SupplyRegion_ALT1)
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVVRPS {
				Definition: SUM(FullPlanningHorizon,(RPS(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
			}
			Parameter PVVRPSR {
				IndexDomain: SupplyRegion_ALT1;
				Definition: SUM(FullPlanningHorizon,(RPSR(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
			}
			Parameter DPV {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					    DPVTOTGENNR(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVVDPV {
				IndexDomain: SupplyRegion_ALT1;
				Definition: SUM(FullPlanningHorizon,(DPV(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
			}
			Parameter PVV_COGGU {
				IndexDomain: (SupplyRegion_ALT1)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: SUM(FullPlanningHorizon,(COGGU(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ORD(FullPlanningHorizon)));
			}
			Parameter COGGR {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					 	IF (UPRNWCOGR(SupplyRegion_ALT1) = 1) THEN
					 		URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon))
					 	ELSEIF (UPRNWCOGR(SupplyRegion_ALT1) = 2) THEN
					 		URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon))
					 	ELSE
					 		0.0
					 	ENDIF
					
					 ELSE
					 0.0
					 ENDIF
				}
			}
			Parameter COGGU {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					   IF (UPRNWCOG('1') = 1) THEN
					       URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon))
					    ELSEIF (UPRNWCOG('1') = 2) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR2(FullPlanningHorizon))
					    ELSE
						0.0
					    ENDIF
					
					ELSE
					   0.0
					ENDIF
				}
			}
			Parameter PVV_COGGR {
				IndexDomain: (SupplyRegion_ALT1)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: SUM(FullPlanningHorizon,(COGGR(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ORD(FullPlanningHorizon)));
			}
			Parameter CRDPRN {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (UPRNWSUN('1') > 0 AND (UHBSYR('1') + ord(FullPlanningHorizon) + CURIYR('1') + UNXPH('1') - 2) >= UPRNWSUN('1')) then
					0
					elseif UPRNWBND(LastModelYear_MNUMYRX2(FullPlanningHorizon+UNXPH('1') - 1)) >= 0.005 then
					RPSCAPYR(ModelYear_KYR(FullPlanningHorizon)) * UPGNPD(ModelYear_KYR(FullPlanningHorizon))
					endif
				}
			}
			Parameter CRDPRN1 {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon);
				Definition: {
					IF (UPRNWSUNR(SupplyRegion_ALT1) > 0 AND (UHBSYR('1') + ord(FullPlanningHorizon) + CURIYR('1') + UNXPH('1') - 2) >= UPRNWSUNR(SupplyRegion_ALT1)) then
					0
					elseif UPRNWBNDR(LastModelYear_MNUMYRX2(FullPlanningHorizon+UNXPH('1') - 1),SupplyRegion_ALT1) >= 0.001 then
					UPRNWCAPR(SupplyRegion_ALT1) * UPGNPD(ModelYear_KYR(FullPlanningHorizon))
					endif
				}
			}
			Parameter ccalc_cGCGRNW_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)CGRNW(*) and OML Rows: ECPCOSTS";
				Definition: ECP_MIN('1');
			}
			Parameter ccalc_cGCGRNW_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1) | Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion and ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)CGRNW(*) and OML Rows: G(*)RNWXX(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cGCGRNW_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)CGRNW(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					   IF (UPRNWCOGR(SupplyRegion_ALT1) = 1) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSEIF (UPRNWCOGR(SupplyRegion_ALT1) = 2) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSE
						0.0
					    ENDIF
					 ELSE
					  PVV_COGGR(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
					 ENDIF
				}
			}
			Parameter ccalc_cGCGRNW_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)CGRNW(*) and OML Rows: LBOUND";
				Definition: {
					
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					   IF (UPRNWCOGR(SupplyRegion_ALT1) = 1) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSEIF (UPRNWCOGR(SupplyRegion_ALT1) = 2) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSE
						0.0
					    ENDIF
					 ELSE
					  PVV_COGGR(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
					 ENDIF
				}
			}
			Parameter ccalc_cGCRRNW_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1);
				Text: "OML Columns: G(*)CRRNW(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF (UPRNWCAPR(SupplyRegion_ALT1)> 0 AND UPRNWBNDR(ModelYear_MNUMYRX(PlanYear), SupplyRegion_ALT1) > 0.001) THEN
					1
					endif
				}
				Comment: "EP$RPS,35";
			}
			Parameter ccalc_cGCRRNW_rGURNWXXge {
				IndexDomain: (PlanYear,SupplyRegion_ALT1) | ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: G(*)CRRNW(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAPR(SupplyRegion_ALT1)> 0 AND UPRNWBNDR(ModelYear_MNUMYRX(PlanYear), SupplyRegion_ALT1) > 0.001) THEN
					-1
					endif
				}
				Comment: "EP$RPS,36";
			}
			Parameter ccalc_cGCRRNW_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: G(*)CRRNW(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAPR(SupplyRegion_ALT1)> 0 AND UPRNWBNDR(ModelYear_MNUMYRX(PlanYear), SupplyRegion_ALT1) > 0.001) THEN
					IF ord(PlanYear)< UNXPH('1') THEN
					max(0, UPRNWCAPR(SupplyRegion_ALT1) * UPGNPD(ModelYear_MNUMYRF(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear) )
					else
					max(0, sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CRDPRN1(SupplyRegion_ALT1, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					CRDPRN1(SupplyRegion_ALT1, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear) )
					endif
					endif
				}
				Comment: "EP$RPS,37";
			}
			Parameter ccalc_cGUCGRN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUCGRNW(*)(*) and OML Rows: ECPCOSTS";
				Definition: ECP_MIN('1');
			}
			Parameter ccalc_cGUCGRN_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUCGRNW(*)(*) and OML Rows: LBOUND";
				Definition: {
					
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					   IF (UPRNWCOG('1') = 1) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSEIF (UPRNWCOG('1') = 2) THEN
						URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					    ELSE
						0.0
					    ENDIF
					 ELSE
					  PVV_COGGU(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
					 ENDIF
				}
			}
			Parameter ccalc_cGUCGRN_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUCGRNW(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					 IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (UPRNWCOG('1') = 1) THEN
						     URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
						ELSEIF (UPRNWCOG('1') = 2) THEN
						     URPSCGG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) + URPSCGO(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
						ELSE
						     0.0
						ENDIF
					ELSE
					        PVV_COGGU(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
					ENDIF
				}
			}
			Parameter ccalc_cGUCGRN_rGURNWXXge {
				IndexDomain: (PlanYear,SupplyRegion_ALT1) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUCGRNW(*)(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
						1.0
					ENDIF
				}
				Comment: "EP$RPS,32";
			}
			Parameter ccalc_cGUCGRN_rGURNWXXn {
				IndexDomain: (PlanYear,SupplyRegion_ALT1) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUCGRN(*)(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') <= 0) THEN
						1.0
					ENDIF
				}
				Comment: "EP$RPS,32";
			}
			Parameter ccalc_cGUCRRNW_rGURNWXXge {
				IndexDomain: (PlanYear);
				Text: "OML Columns: GUCRRNW(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAP('1') > 0 and UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.001) THEN
					1
					endif
				}
				Comment: "EP$RPS,33";
			}
			Parameter ccalc_cGUCRRNW_ECPCOSTS {
				IndexDomain: (PlanYear);
				Text: "OML Columns: GUCRRNW(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAP('1') > 0 and UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.001) THEN
					IF ord(PlanYear)< UNXPH('1') THEN
					max(0, RPSCAPYR(ModelYear_MNUMYRF(PlanYear)) * UPGNPD(ModelYear_MNUMYRF(PlanYear)) * PWF_Function(EPDSCRT('1',first(SupplyRegion_),cyr),Year)(PlanYear) )
					else
					max(0, sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CRDPRN(FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',first(SupplyRegion_),cyr))) *
					CRDPRN(FullPlanningHorizon) / ((1 + EPDSCRT('1',first(SupplyRegion_),cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',first(SupplyRegion_),cyr),UNXPH01)(PlanYear) )
					endif
					endif
				}
				Comment: "EP$RPS,34";
			}
			Parameter ccalc_cGELXXX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: ECPCOSTS";
				Definition: ECP_MIN('1');
			}
			Parameter ccalc_cGELXXX_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: LBOUND";
				Definition: {
					Sum(SliceGroup | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)),
					         EPHGHT(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) *
					         EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)/1000.0 )
				}
			}
			Parameter ccalc_cGELXXX_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					Sum(SliceGroup | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)),
					         EPHGHT(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) *
					         EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)/1000.0 )
				}
			}
			Parameter ccalc_cGELXXX_rGURNWXXn {
				IndexDomain: (PlanYear,SupplyRegion_ALT1);
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: GURNWXX(*)";
				Definition: {
					! calculated in subroutine EPRPS_SUB
				}
			}
			Parameter ccalc_cGELXXX_rGURNWXXge {
				IndexDomain: (PlanYear,SupplyRegion_ALT1)|ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: GURNWXX(*)";
				Definition: {
					! calculated in subroutine EPRPS_SUB
				}
			}
			Parameter ccalc_cGRNXXX_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1) | Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion and ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)RNXXX(*) and OML Rows: G(*)RNWXX(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cGRNXXX_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)RNXXX(*) and OML Rows: LBOUND";
				Definition: {
					IF (UPRNWCASR(SupplyRegion_ALT1) = 3) THEN
						IF (ORD(PlanYear) < UNXPH('1'))THEN
							UPRNWBNDR(LastModelYear_MNUMYRX(PlanYear),SupplyRegion_ALT1) * DEMX(SupplyRegion_ALT1,PlanYear)
						ELSE
							PVVRPSR(SupplyRegion_ALT1) / PVV_ONE(SupplyRegion_ALT1)* DEMX(SupplyRegion_ALT1,PlanYear)
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGRNXXX_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)RNXXX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (UPRNWCASR(SupplyRegion_ALT1) = 3) THEN
					   9999.9
					else
					   inf
					endif
				}
			}
			Parameter ccalc_cGUDGPV_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUDGPV(*)(*) and OML Rows: LBOUND";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
						IF (DPVDISPATCH('1') = 1 AND UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1 )) > 0.005) THEN
							IF (ORD(PlanYear) < UNXPH('1')) THEN
					    			DPVTOTGENNR(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) * 0.001
							ELSE
					    			PVVDPV(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGUDGPV_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1) | Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion and ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUDGPV(*)(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF (UPRNWCASR(SupplyRegion_ALT1) > 0) AND (DPVDISPATCH('1') = 1 ) THEN
					-1.0
					ENDIF
				}
			}
			Parameter ccalc_cGUDGPV_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1) | ORD(SupplyRegion_ALT1) = ORD(SupplyRegion_ALTY) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUDGPV(*)(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
						IF (DPVDISPATCH('1') = 1 AND UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1 )) > 0.005) THEN
					  	-1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGUDGPV_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GUDGPV(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (UPRNWCAS('1') > 0 AND (DPVDISPATCH('1') = 1 AND UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1 )) > 0.005)) THEN
						IF (ORD(PlanYear) < UNXPH('1')) THEN
							DPVTOTGENNR(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) * 0.001
						ELSE
							PVVDPV(SupplyRegion_ALT1) /$ PVV_ONE(SupplyRegion_ALT1)
						ENDIF
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cGTRPS_ECPCOSTS {
				IndexDomain: (RPSRegion_ALT1,RPSRegion_ALT2,PlanYear) | RPSRegion_ALT1 <> RPSRegion_ALT2;
				Text: "OML Columns: G(*)(*)TRPS(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (Max(SupplyRegion_ALT1|UPRNWRGN(SupplyRegion_ALT1)=ord(RPSRegion_ALT2),UPRNWCASR(SupplyRegion_ALT1) > 0 ) > 0) THEN
					   IF (Max((SupplyRegion_ALT1,SupplyRegion),UPXRGN(SupplyRegion_ALT1,SupplyRegion $ (ord(RPSRegion_ALT2) = UPRNWRGN(SupplyRegion_ALT1) and ord(RPSRegion_ALT1) = UPRNWRGN(SupplyRegion)))=1) > 0) THEN
					       ECP_MIN('1')
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGTRPS_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,RPSRegion_ALT1,RPSRegion_ALT2) | RPSRegion_ALT1 <> RPSRegion_ALT2;
				Text: "OML Columns: G(*)(*)TRPS(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					   IF (Max(SupplyRegion_ALT1|UPRNWRGN(SupplyRegion_ALT1)=ord(RPSRegion_ALT2),UPRNWCASR(SupplyRegion_ALT1) > 0 ) > 0) THEN
					      IF (Max((SupplyRegion_ALT1,SupplyRegion),UPXRGN(SupplyRegion_ALT1,SupplyRegion $ (ord(RPSRegion_ALT2) = UPRNWRGN(SupplyRegion_ALT1) and ord(RPSRegion_ALT1) = UPRNWRGN(SupplyRegion)))=1) > 0) THEN
					
					      IF (RPSRegion = RPSRegion_ALT1) THEN
					-1.0
					      ELSEIF (RPSRegion = RPSRegion_ALT2) THEN
					1.0 - LINELOSS('1')
					      ENDIF
					      ENDIF
					   ENDIF
				}
			}
			Parameter ccalc_cGTRPS_rETRPSle {
				IndexDomain: (RPSRegion,RPSRegion_ALTX,PlanYear,RPSRegion_ALT1,RPSRegion_ALT2)| RPSRegion_ALT1 <> RPSRegion_ALT2;
				Text: "OML Columns: G(*)(*)TRPS(*) and OML Rows: E(*)(*)TRPS(*)";
				Definition: {
					IF (Max(SupplyRegion_ALT1|UPRNWRGN(SupplyRegion_ALT1) = ord(RPSRegion_ALT2),UPRNWCASR(SupplyRegion_ALT1) > 0 ) > 0) THEN
					   IF (Max((SupplyRegion_ALT1,SupplyRegion),UPXRGN(SupplyRegion_ALT1,SupplyRegion $ (ord(RPSRegion_ALT2) = UPRNWRGN(SupplyRegion_ALT1) and ord(RPSRegion_ALT1) = UPRNWRGN(SupplyRegion)))=1) > 0) THEN
					
					   IF (RPSRegion = RPSRegion_ALT1 and RPSRegion_ALTX = RPSRegion_ALT2) THEN
					 1.0 / (1.0 - LINELOSS('1'))
					   ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGURNXX_rGURNWXXge {
				IndexDomain: (PlanYear,SupplyRegion_ALT1) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: GURNXX(*)(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
						1.0
					ENDIF
				}
			}
			Parameter ccalc_cGURNXX_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1) | SupplyRegion_ALTY = SupplyRegion_ALT1 and ORD(SupplyRegion_ALTY) <= UNRGNS('1');
				Text: "OML Columns: GURNXX(*)(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
						-1.0
					ENDIF
				}
			}
			Parameter ccalc_cRNWGEN_ECPCOSTS {
				IndexDomain: (RPSRegion_ALT1,PlanYear) | ORD(RPSRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: RNWGEN(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					    IF ((Max(SupplyRegion_ALT1| UPRNWRGN(SupplyRegion_ALT1) = ord(RPSRegion_ALT1),UPRNWCASR(SupplyRegion_ALT1) > 0 ) > 0)
						 OR UPRNWCAS('1') > 0)   THEN
						IF (Max(SupplyRegion_ALT1| ord(SupplyRegion_ALT1) = ord(RPSRegion_ALT1),ord(SupplyRegion_ALT1) = UPRNWRGN(SupplyRegion_ALT1)) > 0 ) THEN	
							(2000.0) * UPGNPD(element(MNUMYRF_,ORD(cyr) + ORD(PlanYear) - 1))	
						endif
					    ENDIF
				}
			}
			Parameter ccalc_cRNWGEN_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,RPSRegion_ALT1)| ORD(RPSRegion_ALT1) <= UNRGNS('1') and RPSRegion = RPSRegion_ALT1;
				Text: "OML Columns: RNWGEN(*)(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF ((Max(SupplyRegion_ALT1|UPRNWRGN(SupplyRegion_ALT1) = ord(RPSRegion_ALT1),UPRNWCASR(SupplyRegion_ALT1) > 0 ) > 0)
					 OR UPRNWCAS('1') > 0)   THEN
						IF (Max(SupplyRegion_ALT1| ord(SupplyRegion_ALT1) = ord(RPSRegion_ALT1),ord(SupplyRegion_ALT1) = UPRNWRGN(SupplyRegion_ALT1)) > 0 ) THEN
							1.0
						endif
					ENDIF
				}
			}
			Parameter ccalc_cRNWGENU_ECPCOSTS {
				IndexDomain: (PlanYear);
				Text: "OML Columns: RNWGENU(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
					   (2000.0) * UPGNPD(element(MNUMYRF_,ORD(cyr) + ORD(PlanYear) - 1))
					ENDIF
				}
			}
			Parameter ccalc_cRNWGENU_rGURNWXXge {
				IndexDomain: (PlanYear);
				Text: "OML Columns: RNWGENU(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0) THEN
					   1.0
					ENDIF
				}
			}
			Parameter ccalc_cGXXX_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)(**)XXX(*) and OML Rows: LBOUND";
				Definition: {
					IF (UPRNWCASR(SupplyRegion_ALT1) > 0 OR UPRNWCAS('1') > 0)   THEN
					   IF (ORD(PlantType) > card(DispatchableECP)) THEN
					     IF (EXSGEN(PlantType,SupplyRegion_ALT1) > 0.0 AND
					            (UPRNWEXGR(PlantType,SupplyRegion_ALT1) * UPRNWSHRR(PlantType,SupplyRegion_ALT1) > 0.0 OR
					             UPRNWEXG(PlantType) * UPRNWSHR(PlantType) > 0.0))  THEN
					             EXSGEN(PlantType,SupplyRegion_ALT1)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGXXX_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType) |Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion and ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)(**)XXX(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) > card(DispatchableECP)) THEN
					      IF (EXSGEN(PlantType,SupplyRegion_ALT1) > 0.0 AND (UPRNWEXGR(PlantType,SupplyRegion_ALT1) * UPRNWSHRR(PlantType,SupplyRegion_ALT1))  > 0.0)THEN
					         -1.0 * UPRNWEXGR(PlantType,SupplyRegion_ALT1) * UPRNWSHRR(PlantType,SupplyRegion_ALT1)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGXXX_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)(**)XXX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (UPRNWCASR(SupplyRegion_ALT1) > 0 OR UPRNWCAS('1') > 0)   THEN
					   IF (ORD(PlantType) > card(DispatchableECP)) THEN
					     IF (EXSGEN(PlantType,SupplyRegion_ALT1) > 0.0 AND
					            (UPRNWEXGR(PlantType,SupplyRegion_ALT1) * UPRNWSHRR(PlantType,SupplyRegion_ALT1) > 0.0 OR
					             UPRNWEXG(PlantType) * UPRNWSHR(PlantType) > 0.0))  THEN
					             EXSGEN(PlantType,SupplyRegion_ALT1)
					      else
					         inf
					      endif
					   else
					      inf
					   endif
					else
					   inf
					endif
				}
			}
			Parameter ccalc_cGXXX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)(**)XXX(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) > card(DispatchableECP))THEN
					      IF (EXSGEN(PlantType,SupplyRegion_ALT1) > 0.0 AND (UPRNWEXG(PlantType) * UPRNWSHR(PlantType)) > 0.0 AND UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1 )) > 0.005)THEN
					         ECP_MIN('1')
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cGXXX_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType)| SupplyRegion_ALTY = SupplyRegion_ALT1 and ORD(SupplyRegion_ALTY) <= UNRGNS('1');
				Text: "OML Columns: G(*)(**)XXX(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) > card(DispatchableECP))THEN
					      IF (EXSGEN(PlantType,SupplyRegion_ALT1) > 0.0 AND (UPRNWEXG(PlantType) * UPRNWSHR(PlantType)) > 0.0 AND UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1 )) > 0.005)THEN
					         -1.0 * UPRNWEXG(PlantType) * UPRNWSHR(PlantType)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEBAS_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)BAS(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (UPRNWBAS(PlantType) > 0.0) THEN
					      ECP_MIN('1')
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEBAS_rGBASge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)BAS(*) and OML Rows: G(*)(**)BAS(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (UPRNWBAS(PlantType) > 0.0)THEN
					      -1.0
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEBAS_rGURNWXXge {
				IndexDomain: (PlanYear,SupplyRegion_ALT1,PlantType) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)BAS(*) and OML Rows: GURNWXX(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (UPRNWBAS(PlantType) > 0)THEN
					       IF (ORD(PlanYear) < UNXPH('1'))THEN
					           UPRNWBND(LastModelYear_MNUMYRX(PlanYear))
					       ELSE
					           PVVRPS / PVV_ONE(SupplyRegion_ALT1)
					       ENDIF
					    ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cEBAS_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)BAS(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (UPRNWBAS(PlantType) > 0.0)THEN
					        UPRNWBAS(PlantType) * EXPGEN(PlantType,SupplyRegion_ALT1)
					   ELSE
					        inf
					   ENDIF
					ELSE
					   inf
					ENDIF
				}
			}
			Parameter ccalc_cEGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)GEN(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					            ECP_MIN('1')
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEGEN_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)GEN(*) and OML Rows: LBOUND";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         EXPGEN(PlantType,SupplyRegion_ALT1)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEGEN_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)GEN(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         EXPGEN(PlantType,SupplyRegion_ALT1)
					      ELSE
					        inf
					      ENDIF
					   ELSE
					      inf
					   ENDIF
					ELSE
					   inf
					ENDIF
				}
			}
			Parameter ccalc_cEGEN_rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: E(*)(**)GEN(*) and OML Rows: G(*)(**)INC(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         -1.0 *  UPRNWEXG(PlantType)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cIGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: I(*)(**)GEN(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         ECP_MIN('1')
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cIGEN_rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: I(*)(**)GEN(*) and OML Rows: G(*)(**)INC(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         -1.0
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cIGEN_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType) |SupplyRegion_ALTY = SupplyRegion_ALT1 and ORD(SupplyRegion_ALTY) <= UNRGNS('1');
				Text: "OML Columns: I(*)(**)GEN(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         UPRNWSHR(PlantType)
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cXGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: X(*)(**)GEN(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					   IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         2000.0
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cXGEN_rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)|ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: X(*)(**)GEN(*) and OML Rows: G(*)(**)INC(*)";
				Definition: {
					IF (UPRNWCAS('1') > 0 OR UPRNWCASR(SupplyRegion_ALT1) > 0)THEN
					    IF (ORD(PlantType) <= card(DispatchableECP)) THEN
					      IF (UPRNWEXG(PlantType) > 0.0)THEN
					         1.0
					      ENDIF
					   ENDIF
					ENDIF
				}
			}
		}
		DeclarationSection EP_ST_RPS_Completed {
			Parameter ST_RPS_TRD {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion)<=UNRGNS('1') and
					2<=ord(PlanYear)<=UNXPH('1') and NM_ST_RPS('1')>0
				}
				Text: "Identifies state RPS trade partners - 0=> no, 1=> yes";
				Definition: {
					if sum((PlantType, RPSTranche) | ST_RPS_IMPORTS(RPSTranche) and ST_RPS_REQ(SupplyRegion, RPSTranche, LastModelYear_MNUMYRF(PlanYear))>0 and
					ST_RPS_EMM_MAP(SupplyRegion, RPSTranche)>0 and ST_RPS_EMM_MAP(SupplyRegion_ALT1, RPSTranche)<=0 and
					ST_RPS_ECP_NW(PlantType, RPSTranche), 1)>0 and
					UPXRGN(SupplyRegion_ALT1, SupplyRegion)>0  then
					1   ! Require equivalent trade to match the sale of RPS credits, after losses
					endif
				}
			}
			Parameter GRW {
				IndexDomain: SupplyRegion_SUB;
				Definition: MAX(1, (QELASN(SupplyRegion_SUB, last(MNUMYR)) / QELASN(SupplyRegion_SUB, nth(MNUMYR,UNYEAR('1') - 20))) ^ (1.0 / 20.0));
				Comment: "Determine Sales Growth Rate by EMM Region - Average over last 20 years of the forecast horizon";
			}
			Parameter EMM_REQ {
				IndexDomain: (SupplyRegion_SUB, PlanYear) | ord(PlanYear)>=2;
				Definition: {
					IF sum(RPSTranche | ord(RPSTranche)<= NM_ST_RPS('1'), ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(PlanYear)))>0 THEN
					1
					endif
				}
			}
			Parameter TST_REQ {
				IndexDomain: (SupplyRegion_SUB, PlanYear) | ord(PlanYear)>=2;
				Definition: sum(RPSTranche | ord(RPSTranche)<= NM_ST_RPS('1'), ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(PlanYear)));
			}
			Parameter GrowthRateFactor {
				IndexDomain: (SupplyRegion_SUB, FullPlanningHorizon);
				Definition: {
					if ord(FullPlanningHorizon)+CURIYR('1')-1 <= UNYEAR('1') then
					1
					else
					GRW(SupplyRegion_SUB)^(ord(FullPlanningHorizon)+CURIYR('1')-1 - UNYEAR('1'))
					endif
				}
			}
			Parameter AVG_PVSales {
				IndexDomain: (SupplyRegion_SUB, FullPlanningHorizon);
				Definition: QELASN(SupplyRegion_SUB, LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001 * GrowthRateFactor(SupplyRegion_SUB, FullPlanningHorizon);
				Comment: "Variable used to calculate average present value sales for muliple year periods (currently just the last period)";
			}
			Parameter TotalSales {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					AVG_PVSales(SupplyRegion_SUB, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(AVG_PVSales(SupplyRegion_SUB, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))/
					AVG_PVSales(SupplyRegion_SUB, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
				Comment: "Total Sales for each explicit planning period";
			}
			Parameter TCG_QAL {
				IndexDomain: (OwnerType, SupplyRegion_SUB, CHPFuel) | ord(CHPFuel)<=TC_FUELS('1');
				Definition: {
					if OwnerType=One_element and sum(RPSTranche | ord(RPSTranche)<= NM_ST_RPS('1') and ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(UNXPH_PlanYear))>0 and
					(ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche)>0 or ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche)>0), 1) then
					1
					elseif OwnerType=Two_element and sum(RPSTranche | ord(RPSTranche)<= NM_ST_RPS('1') and ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(UNXPH_PlanYear))>0 and
					((ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche)>0 and ST_RPS_CHP_SW(RPSTranche)<>0) or
					(ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche)>0 and ST_RPS_DG_SW(RPSTranche)<>0)), 1) then
					1
					endif
				}
			}
			Parameter Share_STRPS {
				IndexDomain: (SupplyRegion_SUB, CHPFuel, PlanYear) | ord(CHPFuel)<=TC_FUELS('1');
				Definition: {
					if sum(RPSTranche | ord(RPSTranche)<= NM_ST_RPS('1') and ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(PlanYear))>0 and
					(ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche)>0 or ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche)>0), 1) then
					1
					endif
				}
			}
			Parameter Share_STRPS1 {
				IndexDomain: (RPSTranche, SupplyRegion_SUB, CHPFuel, PlanYear) | ord(CHPFuel)<=TC_FUELS('1') and ord(PlanYear)>=2 and ord(RPSTranche)<= NM_ST_RPS('1');
				Definition: {
					if ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(PlanYear))>0 and
					(ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche)>0 or ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche)>0) then
					H_SALES(StateCodes_Element(RPSTranche), UtilityType0, SupplyRegion_SUB) / $ H_SALES(StateCodes0, UtilityType0, SupplyRegion_SUB)
					endif
				}
			}
			ElementParameter TST_STATES {
				IndexDomain: (SupplyState, PlantType, SupplyRegion_SUB, PlanYear);
				Range: RPSTranche_;
			}
			Parameter GWH {
				IndexDomain: (PlantType,SupplyRegion_SUB,RPSTranche,PlanYear);
			}
			Parameter EX_GEN {
				IndexDomain: (PlantType,SupplyRegion_SUB,RPSTranche,PlanYear);
			}
			Parameter PCAP {
				IndexDomain: (RPSTranche, FullPlanningHorizon) | ord(FullPlanningHorizon)>=2 and ord(RPSTranche)<= NM_ST_RPS('1');
				Definition: {
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))*
					if ST_RPS_PCAP_TYP(RPSTranche)>0 then
					ST_RPS_PCAP_87(RPSTranche, MNUMYRF_KYR(FullPlanningHorizon))
					else
					200
					endif
				}
			}
			Parameter Test_SupplyRgns_STRPS {
				IndexDomain: (SupplyState, RPSTrancheID, PlanYear);
				Definition: {
					sum(SupplyRegion_SUB|
					ST_RPS_REQ(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID), ModelYear_MNUMYRF(PlanYear))>0 and
					ST_RPS_EMM_MAP(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID))>0,1)
				}
			}
			Parameter ccalc_cGSTRPS_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and (EMM_REQ(SupplyRegion_ALT1, PlanYear)>0 AND TST_REQ(SupplyRegion_ALT1, PlanYear) >0);
				Text: "OML Columns: G(*)STRPS(*) and OML Rows: LBOUND";
				Definition: TotalSales(SupplyRegion_ALT1, PlanYear);
				Comment: "EP$ST_RPS,1";
			}
			Parameter ccalc_cGSTRPS_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and (EMM_REQ(SupplyRegion_ALT1, PlanYear)>0 AND TST_REQ(SupplyRegion_ALT1, PlanYear) >0);
				Text: "OML Columns: G(*)STRPS(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: TotalSales(SupplyRegion_ALT1, PlanYear);
				Comment: "EP$ST_RPS,1";
			}
			Parameter ccalc_cGSTRPS_rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID);
				Text: "OML Columns: G(*)STRPS(*) and OML Rows: G(**)(*)RPS(*)";
				Definition: {
					-ST_RPS_REQ(SupplyRegion_ALT1, RPSTranche_Element(SupplyState, RPSTrancheID), ModelYear_MNUMYRF(PlanYear)) $
					(ST_RPS_REQ(SupplyRegion_ALT1, RPSTranche_Element(SupplyState, RPSTrancheID), ModelYear_MNUMYRF(PlanYear))>0)
				}
				Comment: {
					"EP$ST_RPS,3; ESTABLISH STATE RPS REQUIRMEMENTS AS A FUNCTION OF EMM REGION SALES"
				}
			}
			Parameter ccalc_cGDG_PV_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and  ord(PlanYear)>=2 and DPVDISPATCH('1') and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)DG_PV(*) and OML Rows: LBOUND";
				Definition: {
					IF (TOT_GEN_RES(WIPV_Element,'2', SupplyRegion_ALT1, cyr)>0) THEN
						DPVTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) * 0.001 * TOT_GEN_RES(WIPV_Element,'2', SupplyRegion_ALT1, cyr)/
						(CURTAILSUB(WIPV_Element,'2', SupplyRegion_ALT1, cyr) + TOT_GEN_RES(WIPV_Element, '2',SupplyRegion_ALT1, cyr) )
					ELSE
						DPVTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) * 0.001
					ENDIF
				}
				Comment: {
					"EP$ST_RPS,4; IF DG PV IS ADDED TO UTILITY PV, IT MUST BE SUBTRACTED FROM UTILITY PV TO AVOID DOUBLE COUNTING"
				}
			}
			Parameter ccalc_cGDG_PV_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and  ord(PlanYear)>=2 and DPVDISPATCH('1') and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)DG_PV(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (TOT_GEN_RES(WIPV_Element,'2', SupplyRegion_ALT1, cyr)>0) THEN
						DPVTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) * 0.001 * TOT_GEN_RES(WIPV_Element,'2', SupplyRegion_ALT1, cyr)/
						(CURTAILSUB(WIPV_Element,'2', SupplyRegion_ALT1, cyr) + TOT_GEN_RES(WIPV_Element, '2',SupplyRegion_ALT1, cyr) )
					ELSE
						DPVTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) * 0.001
					ENDIF
				}
				Comment: {
					"EP$ST_RPS,4; IF DG PV IS ADDED TO UTILITY PV, IT MUST BE SUBTRACTED FROM UTILITY PV TO AVOID DOUBLE COUNTING"
				}
			}
			Parameter ccalc_cGDG_PV_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and  ord(PlanYear)>=2 and DPVDISPATCH('1') and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)DG_PV(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: {
					if PlantType=WIPV_Element then
					-1
					endif
				}
				Comment: {
					"EP$ST_RPS,5; IF DG PV IS ADDED TO UTILITY PV, IT MUST BE SUBTRACTED FROM UTILITY PV TO AVOID DOUBLE COUNTING"
				}
			}
			Parameter ccalc_cGTCG_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CHPFuel,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CHPFuel)<=TC_FUELS('1') and ord(PlanYear)>=2 and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)(**)TCG(*) and OML Rows: LBOUND";
				Definition: {
					if Share_STRPS(SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and TCG_QAL(One_element, SupplyRegion_ALT1, CHPFuel)= 1 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, One_element)> 0.001 then
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, One_element)* 0.001
					endif
				}
				Comment: {
					"EP$ST_RPS,6; ACCOUNT FOR TRADITIONAL COGEN / END USE DISTRIBUTED GENERATION IN STATE RPS IF QUALIFIED"
				}
			}
			Parameter ccalc_cGTCG_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CHPFuel,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CHPFuel)<=TC_FUELS('1') and ord(PlanYear)>=2 and
					Share_STRPS(SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and TCG_QAL(One_element, SupplyRegion_ALT1, CHPFuel)= 1 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, One_element)> 0.001 and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)(**)TCG(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, One_element)* 0.001;
				Comment: {
					"EP$ST_RPS,6; ACCOUNT FOR TRADITIONAL COGEN / END USE DISTRIBUTED GENERATION IN STATE RPS IF QUALIFIED"
				}
			}
			Parameter ccalc_cGTCO_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CHPFuel,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CHPFuel)<=TC_FUELS('1') and ord(PlanYear)>=2 and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)(**)TCO(*) and OML Rows: LBOUND";
				Definition: {
					if Share_STRPS(SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and TCG_QAL(Two_element, SupplyRegion_ALT1, CHPFuel)= 1 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, Two_element)> 0.001 then
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, Two_element)* 0.001
					endif
				}
				Comment: {
					"EP$ST_RPS,7; ACCOUNT FOR TRADITIONAL COGEN / END USE DISTRIBUTED GENERATION IN STATE RPS IF QUALIFIED"
				}
			}
			Parameter ccalc_cGTCO_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CHPFuel,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CHPFuel)<=TC_FUELS('1') and ord(PlanYear)>=2 and
					Share_STRPS(SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and TCG_QAL(Two_element, SupplyRegion_ALT1, CHPFuel)= 1 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, Two_element)> 0.001 and
					NM_ST_RPS('1')>0
				}
				Text: "OML Columns: G(*)(**)TCO(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, Two_element)* 0.001;
				Comment: {
					"EP$ST_RPS,7; ACCOUNT FOR TRADITIONAL COGEN / END USE DISTRIBUTED GENERATION IN STATE RPS IF QUALIFIED"
				}
			}
			Parameter ccalc_cGTCG_rGRPSge {
				IndexDomain: {
					(SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1,CHPFuel) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID) and
					ord(CHPFuel)<=TC_FUELS('1')
				}
				Text: "OML Columns: G(*)(**)TCG(*) and OML Rows: G(**)(*)RPS(*)";
				Definition: {
					if Share_STRPS1(RPSTranche_Element(SupplyState, RPSTrancheID),SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, One_element)> 0.001 then
					
					Share_STRPS1(RPSTranche_Element(SupplyState, RPSTrancheID),SupplyRegion_ALT1, CHPFuel, PlanYear) *
					
					if ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))>0 then
					ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))
					elseif ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))>0 then
					ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))
					endif
					
					endif
				}
				Comment: {
					"EP$ST_RPS,8; EP$ST_RPS,10"
				}
			}
			Parameter ccalc_cGTCO_rGRPSge {
				IndexDomain: {
					(SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1,CHPFuel) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID) and
					ord(CHPFuel)<=TC_FUELS('1')
				}
				Text: "OML Columns: G(*)(**)TCO(*) and OML Rows: G(**)(*)RPS(*)";
				Definition: {
					if Share_STRPS1(RPSTranche_Element(SupplyState, RPSTrancheID),SupplyRegion_ALT1, CHPFuel, PlanYear) >0 and
					CGTOTGENNR(SupplyRegion_ALT1, LastModelYear_MNUMYR(PlanYear), CHPFuel, Two_element)> 0.001 then
					
					Share_STRPS1(RPSTranche_Element(SupplyState, RPSTrancheID),SupplyRegion_ALT1, CHPFuel, PlanYear) *
					
					if ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_CHP_SW(RPSTranche_Element(SupplyState, RPSTrancheID))=1 then
					ST_RPS_CHP(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))
					elseif ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_DG_SW(RPSTranche_Element(SupplyState, RPSTrancheID))=1 then
					ST_RPS_DG(TCFuel_Element(CHPFuel), RPSTranche_Element(SupplyState, RPSTrancheID))
					endif
					
					endif
				}
				Comment: {
					"EP$ST_RPS,9; EP$ST_RPS,11"
				}
			}
			Parameter ccalc_cXX_LBOUND {
				IndexDomain: (SupplyState,PlantType,SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: X(**)X(**)(*)(*) and OML Rows: LBOUND";
			}
			Parameter ccalc_cXX_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,SupplyState);
				Text: "OML Columns: X(**)X(**)(*)(*) and OML Rows: F(*)(**)GEN(*)";
			}
			Parameter ccalc_cXX_rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1);
				Text: "OML Columns: X(**)X(**)(*)(*) and OML Rows: G(**)(*)RPS(*)";
			}
			Parameter ccalc_cXX_UBOUND {
				IndexDomain: (SupplyState,PlantType,SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: X(**)X(**)(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
			}
			Parameter ccalc_cNN_rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1);
				Text: "OML Columns: N(**)N(**)(*)(*) and OML Rows: G(**)(*)RPS(*)";
			}
			Parameter ccalc_cNN_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,SupplyState);
				Text: "OML Columns: N(**)N(**)(*)(*) and OML Rows: F(*)(**)GEN(*)";
			}
			Parameter ccalc_cGCAP_rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear) | ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID);
				Text: "OML Columns: G(**)(*)CAP(*) and OML Rows: G(**)(*)RPS(*)";
				Definition: 1;
				Comment: {
					"EP$ST_RPS,21; EP$ST_RPS,23"
				}
			}
			Parameter ccalc_cGCAP_ECPCOSTS {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear) |ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID);
				Text: "OML Columns: G(**)(*)CAP(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PCAP(RPSTranche_Element(SupplyState, RPSTrancheID), FullPlanningHorizon_PlanYear(PlanYear)) *
					PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PCAP(RPSTranche_Element(SupplyState, RPSTrancheID), FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PCAP(RPSTranche_Element(SupplyState, RPSTrancheID), FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					endif;
				}
				Comment: {
					"EP$ST_RPS,22; EP$ST_RPS,24   Create price cap to allow for alternative compliance payments"
				}
			}
			Parameter ccalc_cGXCOF_rFCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,SupplyState);
				Text: "OML Columns: G(**)XCOF(*) and OML Rows: F(*)CFGEN(*)";
			}
			Parameter ccalc_cGXCOF_rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear);
				Text: "OML Columns: G(**)XCOF(*) and OML Rows: G(**)(*)RPS(*)";
			}
			Parameter ccalc_cG_rGRPSge {
				IndexDomain: {
					(SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and
					ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID)
				}
				Text: "OML Columns: G(**)(**)(*)(*)(*) and OML Rows: G(**)(*)RPS(*)";
				Definition: {
					if ST_RPS_IMPORTS(RPSTranche_Element(SupplyState, RPSTrancheID)) and ST_RPS_REQ(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID), LastModelYear_MNUMYRF(PlanYear))>0 and
					ST_RPS_EMM_MAP(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_EMM_MAP(SupplyRegion_ALT1, RPSTranche_Element(SupplyState, RPSTrancheID))<=0 and
					UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)>0 and ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID)) then
					(1.0 - LINELOSS('1')) * ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID))   ! Satisfy RPS Requirement
					endif
				}
				Comment: "EP$ST_RPS,15  Satisfy RPS Requirement";
			}
			Parameter ccalc_cG_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,SupplyState,SupplyRegion_ALTa) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and
					ord(PlanYear)>=2
				}
				Text: "OML Columns: G(**)(**)(*)(*)(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: {
					if sum(RPSTrancheID | ST_RPS_IMPORTS(RPSTranche_Element(SupplyState, RPSTrancheID)) and ST_RPS_REQ(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID), LastModelYear_MNUMYRF(PlanYear))>0 and
					ST_RPS_EMM_MAP(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_EMM_MAP(SupplyRegion_ALT1, RPSTranche_Element(SupplyState, RPSTrancheID))<=0 and
					ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID)), 1)>0 and
					UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)>0  then
					-1   ! Use generation from export region for qualified ECP type
					endif
				}
				Comment: "EP$ST_RPS,16 Use generation from export region for qualified ECP type";
			}
			Parameter ccalc_cG_rLTRPSle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyState,PlantType) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and
					ord(PlanYear)>=2
				}
				Text: "OML Columns: G(**)(**)(*)(*)(*) and OML Rows: L(*)(*)TRPS(*)";
				Definition: {
					if sum(RPSTrancheID | ST_RPS_IMPORTS(RPSTranche_Element(SupplyState, RPSTrancheID)) and ST_RPS_REQ(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID), LastModelYear_MNUMYRF(PlanYear))>0 and
					ST_RPS_EMM_MAP(SupplyRegion_ALTa, RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_EMM_MAP(SupplyRegion_ALT1, RPSTranche_Element(SupplyState, RPSTrancheID))<=0 and
					ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID)), 1)>0 and
					UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)>0  then
					1   ! Require equivalent trade to match the sale of RPS credits, after losses
					endif
				}
				Comment: "EP$ST_RPS,17   Require equivalent trade to match the sale of RPS credits, after losses";
			}
		}
		DeclarationSection EP_SEQBNS_Completed;
		DeclarationSection EP_SUBFIN_Completed;
		DeclarationSection EP_SUBLIM_Completed {
			Parameter ccalc_cRHS_rLUSUBXle {
				IndexDomain: (PlantType_ALT2);
				Text: "OML Columns: RHSECP and OML Rows: LU(**)SUBX";
			}
		}
		DeclarationSection EPA_TRANRG_ECP_Completed {
			Parameter ccalc_cT_rEUSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption);
				Text: "OML Columns: T(**)(*)(**)(*)(*) and OML Rows: EUSO2(**)(*)";
			}
			Parameter ccalc_cRHS_rEUSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: EUSO2(**)(*)";
				Definition: {
					if TSO2_LIM_BY_CLRG(CoalDemandRegion)> 0 and (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TSO2_YR_BY_CLRG('1') then
					   IF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE2('1') THEN
					        TSO2_LIM_BY_CLRG(CoalDemandRegion)
					   ELSEIF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1') THEN
					        TSO2_LM1_BY_CLRG(CoalDemandRegion)
					   ENDIF
					endif
				}
				Comment: "EPA$TRANRG_ECP,1";
			}
			Parameter ccalc_cCTLSO_rEUSO2le {
				IndexDomain: {
					(CoalDemandRegion,PlanYear) | PV_SO_CTL(CoalDemandRegion, PlanYear)>ECP_MIN('1') and
					TSO2_SHR_BY_CLRG(CoalDemandRegion, first(SO2_Transport_))>ECP_MIN('1')
				}
				Text: "OML Columns: CTLSO(**)(*) and OML Rows: EUSO2(**)(*)";
				Definition: {
					if TSO2_YR_BY_CLRG('1') < 9999 and TSO2_LIM_BY_CLRG(CoalDemandRegion) > 0 then
					 TSO2_SHR_BY_CLRG(CoalDemandRegion, first(SO2_Transport_))
					endif
				}
				Comment: "EPA$TRANRG_ECP,5";
			}
			Parameter ccalc_cTRSXX_rEUSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear,FuelRegion_ALT1);
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: EUSO2(**)(*)";
				Definition: {
					IF (TSO2_LIM_BY_CLRG(CoalDemandRegion_EPCSMP(FuelRegion_ALT1)) and TSO2_YR_BY_CLRG('1') < 9999) THEN
					UFRSO2(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * 0.5 * TSO2_OSH_BY_OLCL(CensusRegion_EPCSMP(FuelRegion_ALT1), CoalDemandRegion, first(SO2_Transport)) $
					(UFRSO2(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * 0.5 * TSO2_OSH_BY_OLCL(CensusRegion_EPCSMP(FuelRegion_ALT1), CoalDemandRegion, first(SO2_Transport)) > ECP_MIN('1') )
					endif
				}
				Comment: "EPA$TRANRG_ECP,6";
			}
		}

			Parameter ccalc_cEMRX_RNW_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType<>WIHY_Element and
					SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					-max(UPRNWSHR(PlantType)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(PlantType)>0  and
					 -max(UPRNWSHR(PlantType)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,29";
			}
			Parameter ccalc_cEXXX_RNW_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType<>WIHY_Element and
					PlanYear=PlanYear_ALTB and SupplyRegion_ALT2=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_RNW(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					(TMP_ECF(PlantType, SupplyRegion_ALT1) - TMP_RCF(PlantType, SupplyRegion_ALT1)) * 8.76 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0  and
					 abs((TMP_ECF(PlantType, SupplyRegion_ALT1) - TMP_RCF(PlantType, SupplyRegion_ALT1)) * 8.76 *
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)))) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,32";
			}
			Parameter ccalc_cEXXX_RNW_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: ECPCOSTS"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_RNW(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					max(0,
					IF ord(PlanYear_ALTB)< UNXPH('1') THEN
					FOM_EXXX_RNW(PlantType, SupplyRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear_ALTB)) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear_ALTB)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(FOM_EXXX_RNW(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXXX_RNW(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+(UNXPH('1') - 1)) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear_ALTB)
					endif)
					endif
					endif
				}
				Comment: "EP$BRNW,33";
			}

			              put @5,ord(SupplyRegion_ALT1):<10:0,ord(SupplyRegion):<10:0,ord(MNUMYRX):<10:0,UTNEWTRN(SupplyRegion_ALT1,SupplyRegion,MNUMYRX):>18:10,/;
			            endif; 

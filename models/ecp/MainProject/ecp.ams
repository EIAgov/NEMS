			Parameter ccalc_cMVI11_rXCXle {
				IndexDomain: (CoalType,CoalSupplyCurve,PlanYear);
				Text: "OML Columns: MV(**)I11(*) and OML Rows: XC(**)(**)X(*)";
			}
			Parameter ccalc_cMVI11_UBOUND {
				IndexDomain: (CoalSupplyCurve,PlanYear);
				Text: "OML Columns: MV(**)I11(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
			}
			Parameter MIN_COF {
				IndexDomain: {
					(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,PlanYear_ALTB)| UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB))> 0.0
				}
				Definition: MAX(0.0 , (UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB)) - UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB))) * 0.001);
			}
			Parameter ccalc_cBCOF_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB);
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: ECPCOSTS";
			}
			Parameter ccalc_cRHS_rCCOFXle {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF);
				Text: "OML Columns: RHSECP and OML Rows: C(*)(*)(*)COFX";
				Definition: Min((PlanYear_ALTB),MIN_COF(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,PlanYear_ALTB));
			}
			Parameter ccalc_cBCOF_rCCOFXle {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB)| (UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+1))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+1))> 0.0)
				}
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: C(*)(*)(*)COFX";
				Definition: {
					if (((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1')) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1')) ) then
					1.0
					endif;
				}
			}
			Parameter ccalc_cBCOF_rHCOFle {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,PlanYear_ALTB)|PlanYear > PlanYear_ALTB and (UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0)
				}
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: H(*)(*)(*)COF(*)";
				Definition: {
					if (((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1') and  ord(PlanYear) > UPCFCLT('1')) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1')) ) then
					-1.0
					endif;
				}
			}
			Parameter ccalc_cBCOF_rLUXXCOFle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB)|PlanYear_ALTB = PlanYear and ord(PlanYear_ALTB)+UPCFCLT('1') < UNXPH('1') and ( UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0)
				}
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: LUXXCOF(*)";
				Definition: {
					if (((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1')) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1'))) then
					1.0
					endif;
				}
			}
			Parameter ccalc_cBCOF_rLUXXCOFn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB)| ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1') and PlanYear_ALTB = PlanYear and ( UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0)
				}
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: LUXXCOF(*)";
				Definition: {
					if (((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1') ) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1'))) then
					1.0
					endif;
				}
			}
			Parameter ccalc_cBCOF_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB)|UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0
				}
				Text: "OML Columns: B(*)(*)(*)COF(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					!IF (((CURIYR + UHBSYR + YEAR - UPCFCLT - 1) .GE. UYR_STEO .AND. YEAR .GT. UPCFCLT) .OR. YEAR .EQ. UNXPH) THEN
					!MAX(0.0 , (UCF_TCAP1(COF_EMM,NERC,IRG,CURIYR+YEAR-1) - UCF_RCAP1(COF_EMM,NERC,IRG,CURIYR+YEAR-1)) * 0.001)
					if (((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1')) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1')) ) then
					MAX(0.0 , (UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1'))) - UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))) * 0.001)
					endif;
				}
			}
			Parameter ccalc_cECOF_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear)|UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0
				}
				Text: "OML Columns: E(*)(*)(*)COF(*) and OML Rows: LBOUND";
				Range: nonnegative;
				Definition: UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear)) * 0.001;
			}
			Parameter ccalc_cECOF_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear)|UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0
				}
				Text: "OML Columns: E(*)(*)(*)COF(*) and OML Rows: ECPCOSTS";
				Definition: {
					ECP_MIN('1');
				}
			}
			Parameter ccalc_cECOF_rHCOFle {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear)|UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0
				}
				Text: "OML Columns: E(*)(*)(*)COF(*) and OML Rows: H(*)(*)(*)COF(*)";
				Definition: -1;
			}
			Parameter ccalc_cECOF_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear)|UCF_TCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0  OR
					UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear))> 0.0
				}
				Text: "OML Columns: E(*)(*)(*)COF(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: UCF_RCAP1(BiomassCOF,SupplyRegion_ALT1,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear)) * 0.001;
			}
			Parameter ccalc_cRHS_rLUXXCOFle {
				IndexDomain: (PlanYear)| ord(PlanYear) + UPCFCLT('1') < UNXPH('1');
				Text: "OML Columns: RHSECP and OML Rows: LUXXCOF(*)";
				Definition: UPBQMAX('1') * (1.0 + UPBRMAX('1')) ^ (ord(PlanYear) - 1);
			}
			Parameter ccalc_cW_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: ECPCOSTS";
			}
			Parameter ccalc_cW_rFCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: F(*)CFGEN(*)";
			}
			Parameter ccalc_cW_rFGWDn {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,FuelRegion_ALT1,BioCOFCF,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: F(*)(**)GWD(*)";
			}
			Parameter ccalc_cW_rFWDXXXle {
				IndexDomain: (CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: F(*)WDXXX(*)";
			}
			Parameter ccalc_cW_rFXXSle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,BioCOFCF,PlantType);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: F(*)(**)(*)XX(*)";
			}
			Parameter ccalc_cW_rGCFGENn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: G(*)CFGEN(*)";
			}
			Parameter ccalc_cW_rGCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: G(*)CFGEN(*)";
			}
			Parameter ccalc_cW_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: G(*)RNWXX(*)";
			}
			Parameter ccalc_cW_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: GURNWX(*)(*)";
			}
			Parameter ccalc_cW_rGWDXn {
				IndexDomain: (CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: G(*)(**)WDX(*)";
			}
			Parameter ccalc_cW_rHCOFle {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: H(*)(*)(*)COF(*)";
			}
			Parameter ccalc_cW_rHCSHle {
				IndexDomain: (CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: H(*)(**)CSH(*)";
			}
			Parameter ccalc_cW_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear);
				Text: "OML Columns: W(*)(*)(*)(**)(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
			}
			Parameter ccalc_cEUHG_rEUHGle {
				IndexDomain: (PlantType,nHGCODE,PlanYear);
				Text: "OML Columns: EUHG(**)(*)(*) and OML Rows: EUHG(**)(*)(*)";
			}
			Parameter ccalc_cEUHG_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear,PlantType);
				Text: "OML Columns: EUHG(**)(*)(*) and OML Rows: EUHGXX(*)(*)";
			}
			Parameter ccalc_cEUHG_ECPCOSTS {
				IndexDomain: (PlantType,nHGCODE,PlanYear);
				Text: "OML Columns: EUHG(**)(*)(*) and OML Rows: ECPCOSTS";
			}
			Parameter ccalc_cEUSO_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear,PlantType);
				Text: "OML Columns: EUSO(**)(*)(*) and OML Rows: EUSO2X(*)(*)";
			}
			Parameter ccalc_cEUSO_rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear,PlantType);
				Text: "OML Columns: EUSO(**)(*)(*) and OML Rows: EUSO2X(*)(*)";
			}
			Parameter ccalc_cEUSO_rEUSOle {
				IndexDomain: (PlantType,SO2Region,PlanYear);
				Text: "OML Columns: EUSO(**)(*)(*) and OML Rows: EUSO(**)(*)(*)";
			}
			Parameter ccalc_cEUSO_ECPCOSTS {
				IndexDomain: (PlantType,SO2Region,PlanYear);
				Text: "OML Columns: EUSO(**)(*)(*) and OML Rows: ECPCOSTS";
			}
		}
		DeclarationSection EP_DSM_Completed;
		DeclarationSection EP_ELAST_Completed {
			Parameter PVVLIM {
				IndexDomain: (PlantType,ElasticityStep);
				Definition: SUM(FullPlanningHorizon,(LIM(PlantType,ElasticityStep,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon))) * 0.001;
			}
			Parameter LIM {
				IndexDomain: (PlantType,ElasticityStep,FullPlanningHorizon);
				Definition: {
																																					       IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
						  IF (UPAVLYR(PlantType) < (ORD(CYR) + UHBSYR('1') + UNXPH('1') - 2)) THEN
						     ESTCPLIM(PlantType,ElasticityStep) * (1 + ESTCPSTP(PlantType,'1')) ^ (ORD(FullPlanningHorizon) - UNXPH('1') + 1)
							   ELSEIF (UPAVLYR(PlantType) = (ORD(CYR) + UHBSYR('1') + UNXPH('1') - 2)) THEN
						     ESTCPLIM(PlantType,ElasticityStep) * (1 + ESTCPSTP(PlantType,'1')) ^ (ORD(FullPlanningHorizon) - UNXPH('1'))
						  ELSE
						     IF UPAVLYR(PlantType) > (ORD(CYR) + UHBSYR('1') + ORD(FullPlanningHorizon - 1)) THEN
							0.0
						     ELSE
							ESTCPLIM(PlantType,ElasticityStep) * (1 + ESTCPSTP(PlantType,'1')) ^ ((ORD(CYR) + UHBSYR('1') + (ORD(FullPlanningHorizon) - 1)) - UPAVLYR(PlantType))
						     ENDIF
						  ENDIF
					       ELSE
						  0.0
					       ENDIF
					
					
						!IF (UPAVLYR(PlantTYpe) > JYR + UNXPH + CURIYR + UHBSYR - 2
					
						/* LIM(0) = ESTCPLIM(PLANT,STEPS)
						DO JYR = 1 , UNFPH - UNXPH + 1
						    IF (UPAVLYR(ICAP) .GT. JYR + UNXPH + CURIYR + UHBSYR - 2) THEN
						       LIM(JYR) = 0.0
						    ELSE IF (UPAVLYR(ICAP) .EQ. JYR + UNXPH + CURIYR + UHBSYR - 2) THEN
						      LIM(JYR) = ESTCPLIM(PLANT,STEPS)
						    ELSE
						       LIM(JYR) = MAX(LIM(JYR-1) * (1.0 + ESTCPSTP(ICAP,1)), ESTCPLIM(PLANT,STEPS))
						    END IF
						 END DO   */
				}
			}
			ElementParameter BuildType_element {
				IndexDomain: PlantType| ORD(PlantType) <> WIWL('1') AND ORD(PlantType) <> WIPT('1');
				Range: BuildType_;
				Definition: {
					IF (UCPDSPIS(PlantType) > 0) THEN                ! DISPATCHABLE
					
					 'B'
					ELSEIF (UCPINTIS(PlantType) > 0) THEN           ! INTERMITTENT
					  'I'
					ELSEIF (UCPSTOIS(PlantType) > 0) THEN           ! STORAGE
					  'I'
					 ELSEIF (UCPRNWIS(PlantType) > 0) THEN           ! RENEWABLE
					  'B'
					 ELSEIF (UCPDGNIS(PlantType) > 0) THEN           ! DISTRIBUTED
					   'B'
					 ENDIF
				}
			}
			ElementParameter DispatchType_element {
				IndexDomain: PlantType | ORD(PlantType) <> WIWL('1') AND ORD(PlantType) <> WIPT('1');
				Range: DispatchType_;
				Definition: {
					IF (UCPDSPIS(PlantType) > 0) THEN                ! DISPATCHABLE
					   'DS'
					ELSEIF (UCPINTIS(PlantType) > 0) THEN           ! INTERMITTENT
					     'IN'
					ELSEIF (UCPSTOIS(PlantType) > 0) THEN           ! STORAGE
					    'ST'
					 ELSEIF (UCPRNWIS(PlantType) > 0) THEN           ! RENEWABLE
					    'RN'
					 ELSEIF (UCPDGNIS(PlantType) > 0) THEN           ! DISTRIBUTED
					    'DG'
					 ENDIF
				}
			}
			Parameter ccalc_cUNP_LBOUND {
				IndexDomain: (BuildType,PlantType,ElasticityStep,PlanYear) | BuildType = BuildType_element(PlantType)and ESTSWTCH(PlantType) > 0;
				Text: "OML Columns: (*)U(**)NP(*)(*) and OML Rows: LBOUND";
				Definition: {
					IF ((ORD(PlanYear) + UPPLYR(PlantType)) <= UNXPH('1') AND
						(UPOVR(PlantType) < 9999.0) AND (UPAVLYR(PlantType) <= FULLYEAR(PlanYear,PlantType))) THEN
						IF ( (ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1 <= ORD(LAST(MNUMYR))) AND (ORD(ElasticityStep) = 1) ) THEN
					  		IF ((ESTYRPLN(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0) OR (UPCAPFLR(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0)) THEN
					   		MIN(ESTCPLIM(PlantType,ElasticityStep),(ESTYRPLN(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) + UPCAPFLR(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) )) * 0.001
					  		ENDIF
					  	ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cUNP_UBOUND {
				IndexDomain: (BuildType,PlantType,ElasticityStep,PlanYear) | BuildType = BuildType_element(PlantType)and ESTSWTCH(PlantType) > 0;
				Text: "OML Columns: (*)U(**)NP(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF ((ORD(PlanYear) + UPPLYR(PlantType)) <= UNXPH('1') AND
						(UPOVR(PlantType) < 9999.0) AND (UPAVLYR(PlantType) <= FULLYEAR(PlanYear,PlantType))) THEN
						IF ( (ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1 <= ORD(LAST(MNUMYR))) AND (ORD(ElasticityStep) = 1) ) THEN
					  		IF ((ESTYRPLN(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0) OR (UPCAPFLR(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0)) THEN
					   			MIN(ESTCPLIM(PlantType,ElasticityStep),(ESTYRPLN(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) + UPCAPFLR(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) )) * 0.001
					  		ELSE
					  			inf
					  		ENDIF
						ELSE
							inf
						ENDIF
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cUNP_rLUle {
				IndexDomain: (PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,BuildType,PlantType) | PlantType_ALT2 = PlantType AND BuildType = BuildType_element(PlantType) AND DispatchType = DispatchType_element(PlantType)and ESTSWTCH(PlantType_ALT2) > 0;
				Text: "OML Columns: (*)U(**)NP(*)(*) and OML Rows: LU(**)(**)(*)(*)";
				Definition: {
					IF ((ORD(PlanYear) + UPPLYR(PlantType_ALT2)) <= UNXPH('1')) THEN
					  IF (UPOVR(PlantType_ALT2) < 9999.0) AND (UPAVLYR(PlantType_ALT2) <= FULLYEAR(PlanYear,PlantType_ALT2)) THEN
						IF ( (ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1 <= ORD(LAST(MNUMYR))) AND (ORD(ElasticityStep) = 1) ) THEN
					  		IF ((ESTYRPLN(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0) OR (UPCAPFLR(PlantType , Element(MNUMYR_, ORD(CYR) + OLYEAR(PlanYear,PlantType) - 1)) > 0.0)) THEN
					   			1.0
					  		ENDIF
						ENDIF
					  ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rLUle {
				IndexDomain: (PlantType_ALT2,DispatchType,ElasticityStep,PlanYear) | DIspatchType_element(PlantType_ALT2) = DispatchType and ESTSWTCH(PlantType_ALT2) > 0 and ORD(ElasticityStep) <= ESTSWTCH(PlantType_ALT2);
				Text: "OML Columns: RHSECP and OML Rows: LU(**)(**)(*)(*)";
				Definition: {
					IF ((ORD(PlanYear) + UPPLYR(PlantType_ALT2)) <= UNXPH('1')) THEN
					  IF (UPOVR(PlantType_ALT2) < 9999.0) AND (UPAVLYR(PlantType_ALT2) <= FULLYEAR(PlanYear,PlantType_ALT2)) THEN
					      IF (OLYEAR(PlanYear,PlantType_ALT2) < UNXPH('1')) THEN
					           MAX(0.0, ESTCPLIM(PlantType_ALT2,ElasticityStep) * 0.001 * (1.0 + ESTCPSTP(PlantType_ALT2,'1')) ^ (ORD(PlanYear) - 1) - UPCAPFLR(PlantType_ALT2,LastModelYear_MNUMYR(PlanYear)))
					      ELSE
					           999.99
					      ENDIF
					    ENDIF
					 ENDIF
				}
			}
		}
		DeclarationSection EP_ETT_Completed {
			Parameter CAPACITY_DERATE {
				Definition: 0.75;
			}
			Parameter IFPH2 {
				IndexDomain: PlanYear;
				Definition: UNFPH('1') - ord(PlanYear) + 1;
			}
			Parameter VOM_ETT {
				IndexDomain: {
					(SupplyRegion,SupplyRegion_ALT1,LoadGroup,LoadSegment,FullPlanningHorizon) | ord(FullPlanningHorizon)<=UNFPH('1') - UNXPH('1') + 1 and
					ord(LoadGroup)<=EPNGRP('1', SupplyRegion, cyr) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion, cyr)
				}
				Definition: {
					if UPXRGN(SupplyRegion,SupplyRegion_ALT1)=1 then
					UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * 0.001 * EPWDTH(LoadSlice_element(SupplyRegion, LoadGroup, LoadSegment, UNXPH_PlanYear), UNXPH_Element, SupplyRegion, cyr) *
					(BARRIER(LastModelYear_MNUMYR(UNXPH_PlanYear)) + PTHRESH1(LastModelYear_MNUMYR(UNXPH_PlanYear), SupplyRegionAll_Element(SupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1))
					+ PTHRESH2(LastModelYear_MNUMYR(UNXPH_PlanYear), SupplyRegionAll_Element(SupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)))
					endif
				}
			}
			Parameter VOMCST_ETT {
				IndexDomain: {
					(SupplyRegion,SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion, cyr)
				}
				Definition: {
					if UPXRGN(SupplyRegion,SupplyRegion_ALT1)=1 then
					IF ord(PlanYear)< UNXPH('1') THEN
					UPGNPD(LastModelYear_MNUMYRF(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion,cyr),Year)(PlanYear) * 0.001 *
					EPWDTH(LoadSlice_element(SupplyRegion, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) *
					(BARRIER(LastModelYear_MNUMYR(PlanYear)) + PTHRESH1(LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)) +
					PTHRESH2(LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)))
					else
					
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOM_ETT(SupplyRegion, SupplyRegion_ALT1, LoadGroup, LoadSegment, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion,cyr))) *
					VOM_ETT(SupplyRegion, SupplyRegion_ALT1, LoadGroup, LoadSegment, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion,cyr),UNXPH01)(PlanYear)
					
					endif
					endif
				}
			}
			Parameter VOMCAN_ETT {
				IndexDomain: {
					(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,FullPlanningHorizon) | ord(FullPlanningHorizon)<=UNFPH('1') - UNXPH('1') + 1 and
					ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr)
				}
				Definition: {
					if (ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(UNXPH_PlanYear)) > ECP_MIN('1')) then
					
					UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * 0.001 * EPWDTH(LoadSlice_element(first(SupplyRegion), LoadGroup, LoadSegment, UNXPH_PlanYear), UNXPH_Element, first(SupplyRegion), cyr) *
					( CAN_CST(ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(UNXPH_PlanYear)) * CAN_CST_SCMULT(LastModelYear_MNUMYR(UNXPH_PlanYear)) )
					endif
				}
			}
			Parameter VOMCSTCAN_ETT {
				IndexDomain: {
					(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear) | ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Definition: {
					if (ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) > ECP_MIN('1')) then
					IF ord(PlanYear)< UNXPH('1') THEN
					UPGNPD(LastModelYear_MNUMYRF(PlanYear)) * PWF_Function(EPDSCRT('1',first(SupplyRegion),cyr),Year)(PlanYear) * 0.001 *
					EPWDTH(LoadSlice_element(first(SupplyRegion), LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), first(SupplyRegion), cyr) *
					( CAN_CST(ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) * CAN_CST_SCMULT(LastModelYear_MNUMYR(PlanYear)) )
					
					else
					
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOMCAN_ETT(CanadianSupplyRegion, LoadGroup, LoadSegment, ImportStep, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',first(SupplyRegion),cyr))) *
					VOMCAN_ETT(CanadianSupplyRegion, LoadGroup, LoadSegment, ImportStep, FullPlanningHorizon) / ((1 + EPDSCRT('1',first(SupplyRegion),cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',first(SupplyRegion),cyr),UNXPH01)(PlanYear)
					
					endif
					endif
				}
			}
			Parameter VOMCAN1_ETT {
				IndexDomain: {
					(CanadianSupplyRegion,SupplyRegion_ALT1,LoadGroup,LoadSegment,FullPlanningHorizon) | ord(FullPlanningHorizon)<=UNFPH('1') - UNXPH('1') + 1 and
					ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(UNXPH_PlanYear), SupplyRegionAll_Element(SupplyRegion_ALT1), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, UNXPH_PlanYear)>ECP_MIN('1') then
					UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * 0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALT1, LoadGroup, LoadSegment, UNXPH_PlanYear), UNXPH_Element, SupplyRegion_ALT1, cyr) *
					(BARRIER(LastModelYear_MNUMYR(UNXPH_PlanYear)) + PTHRESH1(LastModelYear_MNUMYR(UNXPH_PlanYear), EXRG_CanadianSupplyRegion(CanadianSupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1))
					+ PTHRESH2(LastModelYear_MNUMYR(UNXPH_PlanYear), EXRG_CanadianSupplyRegion(CanadianSupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)))
					endif
				}
			}
			Parameter VOMCSTCAN1_ETT {
				IndexDomain: {
					(CanadianSupplyRegion,SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALT1), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					IF ord(PlanYear)< UNXPH('1') THEN
					UPGNPD(LastModelYear_MNUMYRF(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear) * 0.001 *
					EPWDTH(LoadSlice_element(SupplyRegion_ALT1, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) *
					(BARRIER(LastModelYear_MNUMYR(PlanYear)) + PTHRESH1(LastModelYear_MNUMYR(PlanYear), EXRG_CanadianSupplyRegion(CanadianSupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)) +
					PTHRESH2(LastModelYear_MNUMYR(PlanYear), EXRG_CanadianSupplyRegion(CanadianSupplyRegion), SupplyRegionAll_Element(SupplyRegion_ALT1)))
					else
					
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOMCAN1_ETT(CanadianSupplyRegion, SupplyRegion_ALT1, LoadGroup, LoadSegment, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					VOMCAN1_ETT(CanadianSupplyRegion, SupplyRegion_ALT1, LoadGroup, LoadSegment, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear)
					
					endif
					endif
				}
			}
			Parameter TST_CAN {
				IndexDomain: {
					(CanadianSupplyRegion,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Definition: {
					sum(ImportStep | ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) > ECP_MIN('1'),
					ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) )
				}
			}
			Parameter ccalc_cBELXX_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB) | ord(SupplyRegion_ALTY)<=UNRGNS('1') and ord(SupplyRegion_ALTZ)<=UNRGNS('1') and
					ord(PlanYear_ALTB)>=2
				}
				Text: "OML Columns: B(*)(*)ELXX(*) and OML Rows: ECPCOSTS";
				Definition: {
					if UPXRGN(SupplyRegion_ALTY, SupplyRegion_ALTZ)=1 then
					!use same FCF as for transmission builds (use CT as plt type, all same)
					(EMM_CNXT_CST(SupplyRegion_ALTY, SupplyRegion_ALTZ) * EPCCRF(WICT_Element,SupplyRegion_ALTY,cyr) * UPGNPD(ModelYear_MNUMYRF(PlanYear_ALTB)) /
					CRF_Function(EPDSCRT('1',SupplyRegion_ALTY,cyr),IFPH2)(PlanYear_ALTB) ) * PWF_Function(EPDSCRT('1',SupplyRegion_ALTY,cyr),Year)(PlanYear_ALTB)
					endif
				}
				Comment: "EP$ETT,55";
			}
			Parameter ccalc_cBELXX_rLELXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB)| ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and
					ord(PlanYear_ALTB)>=2 and PlanYear>=PlanYear_ALTB
				}
				Text: "OML Columns: B(*)(*)ELXX(*) and OML Rows: L(*)(*)ELXX(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTY, SupplyRegion_ALTZ)=1 then
					if SupplyRegion_ALT1=SupplyRegion_ALTY and SupplyRegion_ALTa=SupplyRegion_ALTZ then
					-1
					elseif SupplyRegion_ALT1=SupplyRegion_ALTZ and SupplyRegion_ALTa=SupplyRegion_ALTY then
					-1
					endif
					endif
				}
				Comment: {
					"EP$ETT,56; EP$ETT,57"
				}
			}
			Parameter ccalc_cBELXX_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB)| ord(SupplyRegion_ALTZ)<=UNRGNS('1') and ord(SupplyRegion_ALTY)<=UNRGNS('1') and
					ord(PlanYear_ALTB)>=2 and PlanYear>=PlanYear_ALTB
				}
				Text: "OML Columns: B(*)(*)ELXX(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTY, SupplyRegion_ALTZ)=1 then
					if SupplyRegion_ALTX=SupplyRegion_ALTY then
					-CAPACITY_DERATE
					elseif SupplyRegion_ALTX=SupplyRegion_ALTZ then
					CAPACITY_DERATE
					endif
					endif
				}
				Comment: {
					"EP$ETT,58; EP$ETT,59"
				}
			}
			Parameter ccalc_cBELYY_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and ord(PlanYear)>=2;
				Text: "OML Columns: B(*)(*)ELYY(*) and OML Rows: ECPCOSTS";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					ECP_MIN('1')
					endif
				}
				Comment: "EP$ETT,60";
			}
			Parameter ccalc_cBELYY_rLELle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and ord(PlanYear)>=2
				}
				Text: "OML Columns: B(*)(*)ELYY(*) and OML Rows: L(*)(*)EL(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					-1
					endif
				}
				Comment: "EP$ETT,62";
			}
			Parameter ccalc_cBELYY_rLELXXle {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and ord(PlanYear)>=2;
				Text: "OML Columns: B(*)(*)ELYY(*) and OML Rows: L(*)(*)ELXX(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					1
					endif
				}
				Comment: "EP$ETT,61";
			}
			Parameter ccalc_cBELYY_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALT1) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and ord(PlanYear)>=2
				}
				Text: "OML Columns: B(*)(*)ELYY(*) and OML Rows: M(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					-0.75
					endif
				}
				Comment: "EP$ETT,64";
			}
			Parameter ccalc_cBELYY_rXELle {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTa)<=UNRGNS('1') and ord(PlanYear)>=2
				}
				Text: "OML Columns: B(*)(*)ELYY(*) and OML Rows: X(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					-0.75
					endif
				}
				Comment: "EP$ETT,63";
			}
			Parameter ccalc_cRHS_rLELle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(SupplyRegion_ALTa)<=UNRGNS('1')
				}
				Text: "OML Columns: RHSECP and OML Rows: L(*)(*)EL(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), SupplyRegionAll_Element(SupplyRegion_ALT1)) $
					(CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), SupplyRegionAll_Element(SupplyRegion_ALT1))>=ECP_MIN('1') or
					CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), SupplyRegionAll_Element(SupplyRegion_ALT1))<=-ECP_MIN('1'))
					endif
				}
				Comment: "EP$ETT,24";
			}
			Parameter ccalc_cRHS_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear) |  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTa,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTa)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr)
				}
				Text: "OML Columns: RHSECP and OML Rows: M(*)EL(*)(*)(*)(*)";
				Definition: {
					IF (UPCIMP(SupplyRegion_ALTa)) THEN
					URNCSTIM_ECP(Season_elementx(Seasonx, SupplyRegion_ALTa), SupplyRegion_ALTa, cyr)
					endif
				}
				Comment: "EP$ETT,23";
			}
			Parameter ccalc_cRHS_rXELle {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: RHSECP and OML Rows: X(*)EL(*)(*)(*)(*)";
				Definition: {
					IF (UPGTRN(SupplyRegion_ALT1)) THEN
					URNCSTEX_ECP(Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr)
					endif
				}
				Comment: "EP$ETT,22";
			}
			Parameter ccalc_cTEL_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr)
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom,SupplyRegion_ALTX)=1 then
					if -ECP_MIN('1') < VOMCST_ETT(SupplyRegion_ALTfrom,SupplyRegion_ALTX, LoadGroup, LoadSegment, PlanYear) < ECP_MIN('1') then
					ECP_MIN('1')
					else
					VOMCST_ETT(SupplyRegion_ALTfrom,SupplyRegion_ALTX, LoadGroup, LoadSegment, PlanYear)
					endif
					endif
				}
				Comment: "EP$ETT,27";
			}
			Parameter ccalc_cTEL_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 then
					IF (CO2_IM_BY_RG(SupplyRegion_ALTX, CO2CapGroup_element(CarbonRegion)) and CO2_DE_BY_RG(SupplyRegion_ALTfrom, CO2CapGroup_element(CarbonRegion)))THEN
					0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALTfrom, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALTfrom, cyr) *
					CO2_DE_BY_RG(SupplyRegion_ALTfrom, CO2CapGroup_element(CarbonRegion))
					endif
					endif
				}
				Comment: "EP$ETT,50";
			}
			Parameter ccalc_cTEL_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr)
					and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 then
					if SupplyRegion_ALT1=SupplyRegion_ALTfrom then
					-1
					elseif SupplyRegion_ALT1=SupplyRegion_ALTX then
					1-LINELOSS('1')
					endif
					endif
				}
				Comment: {
					"EP$ETT,29; EP$ETT,36"
				}
			}
			Parameter ccalc_cTEL_rLELle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(SupplyRegion_ALTa)<=UNRGNS('1') and SupplyRegion_ALTfrom=SupplyRegion_ALT1 and SupplyRegion_ALTX=SupplyRegion_ALTa
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: L(*)(*)EL(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 then
					1
					endif
				}
				Comment: "EP$ETT,25";
			}
			Parameter ccalc_cTEL_rLTRPSle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and SupplyRegion_ALT1=SupplyRegion_ALTfrom and SupplyRegion_ALTa=SupplyRegion_ALTX
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: L(*)(*)TRPS(*)";
				Definition: {
					IF UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 then
					if (ST_RPS_TRD(SupplyRegion_ALTfrom,SupplyRegion_ALTX, PlanYear)=1 ) then
					-0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALTfrom, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALTfrom, cyr)
					endif
					endif
				}
				Comment: "EP$ETT,49";
			}
			Parameter ccalc_cTEL_rETRPSle {
				IndexDomain: {
					(RPSRegion,RPSRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and RPSRegion<>RPSRegion_ALTX
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: E(*)(*)TRPS(*)";
				Definition: {
					IF UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 then
					if (UPRNWCASR(MAP_NERC_TO_RPS_RGN2(SupplyRegion_ALTX)) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALTfrom) and RPSRegion_ALTX=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALTX)) then
					-0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALTfrom, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALTfrom, cyr)
					endif
					endif
				}
				Comment: "EP$ETT,47";
			}
			Parameter ccalc_cTEL_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTfrom,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTfrom)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: M(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SupplyRegion_ALTa=SupplyRegion_ALTX then
					1
					endif
				}
				Comment: "EP$ETT,45";
			}
			Parameter ccalc_cTEL_rXELle {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)EL(*)(*)(*) and OML Rows: X(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SupplyRegion_ALT1=SupplyRegion_ALTfrom then
					1
					endif
				}
				Comment: "EP$ETT,43";
			}
			Parameter ccalc_cTELCAN_ECPCOSTS {
				IndexDomain: (CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear);
				Text: {
					"OML Columns: T(*)(*)EL(*)(*)(*)!CAN and OML Rows: ECPCOSTS"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					if -ECP_MIN('1') < VOMCSTCAN1_ETT(CanadianSupplyRegion,SupplyRegion_ALTa, LoadGroup, LoadSegment, PlanYear) < ECP_MIN('1') then
					ECP_MIN('1')
					else
					VOMCSTCAN1_ETT(CanadianSupplyRegion,SupplyRegion_ALTa, LoadGroup, LoadSegment, PlanYear)
					endif
					endif
				}
				Comment: "EP$ETT,69";
			}
			Parameter ccalc_cTELCAN_rLEL2cange {
				IndexDomain: {
					(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTa,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTa)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: {
					"OML Columns: T(*)(*)EL(*)(*)(*)!CAN and OML Rows: L(*)EL(*)(*)(*)(*)!can"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					-1
					endif
				}
				Comment: "EP$ETT,71";
			}
			Parameter ccalc_cTELCAN_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3 and
					SupplyRegion_ALT1=SupplyRegion_ALTa
				}
				Text: {
					"OML Columns: T(*)(*)EL(*)(*)(*)!CAN and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					1-LINELOSS('1')
					endif
				}
				Comment: "EP$ETT,73";
			}
			Parameter ccalc_cTELCAN_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTa,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTa)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: {
					"OML Columns: T(*)(*)EL(*)(*)(*)!CAN and OML Rows: M(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					1
					endif
				}
				Comment: "EP$ETT,76";
			}
			Parameter ccalc_cTELCAN_UBOUND {
				IndexDomain: {
					(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: {
					"OML Columns: T(*)(*)EL(*)(*)(*)!CAN and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') then
					CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))
					else
					inf
					endif
				}
				Comment: "EP$ETT,68";
			}
			Parameter ccalc_cVEL_ECPCOSTS {
				IndexDomain: {
					(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear) | ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: "OML Columns: V(*)EL(*)(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) > ECP_MIN('1')) THEN
					if -ECP_MIN('1') < VOMCSTCAN_ETT(CanadianSupplyRegion, LoadGroup, LoadSegment, ImportStep, PlanYear) < ECP_MIN('1') then
					ECP_MIN('1')
					else
					VOMCSTCAN_ETT(CanadianSupplyRegion, LoadGroup, LoadSegment, ImportStep, PlanYear)
					endif
					endif
				}
				Comment: "EP$ETT,67";
			}
			Parameter ccalc_cVEL_rLEL2cange {
				IndexDomain: {
					(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,ImportStep) | ORD(Seasonx) <= EPNMSP('1',first(SupplyRegion),cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,first(SupplyRegion))) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr)
				}
				Text: {
					"OML Columns: V(*)EL(*)(*)(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)!can"
				}
				Definition: {
					IF (ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) > ECP_MIN('1')) THEN
					1
					endif
				}
				Comment: "EP$ETT,66";
			}
			Parameter ccalc_cVEL_UBOUND {
				IndexDomain: {
					(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear) | ord(LoadGroup)<=EPNGRP('1', first(SupplyRegion), cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), first(SupplyRegion), cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: "OML Columns: V(*)EL(*)(*)(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) > ECP_MIN('1')) THEN
					ECP_GW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), ImportStep, CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) *
					ECANSQZ(CanadianSupplyRegion, LastModelYear_MNUMYR(PlanYear)) * CAN_QTY_SCMULT(LastModelYear_MNUMYR(PlanYear))
					else
					inf
					endif
				}
				Comment: "EP$ETT,65";
			}
			Parameter ccalc_cTSR_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr)
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom,SupplyRegion_ALTX)=1 and SR_TRAN_CREDIT('1')>0  then
					if -ECP_MIN('1') < VOMCST_ETT(SupplyRegion_ALTfrom,SupplyRegion_ALTX, LoadGroup, LoadSegment, PlanYear) < ECP_MIN('1') then
					ECP_MIN('1')
					else
					VOMCST_ETT(SupplyRegion_ALTfrom,SupplyRegion_ALTX, LoadGroup, LoadSegment, PlanYear)
					endif
					endif
				}
				Comment: "EP$ETT,28";
			}
			Parameter ccalc_cTSR_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SR_TRAN_CREDIT('1')>0 then
					IF (CO2_IM_BY_RG(SupplyRegion_ALTX, CO2CapGroup_element(CarbonRegion)) and CO2_DE_BY_RG(SupplyRegion_ALTfrom, CO2CapGroup_element(CarbonRegion)))THEN
					0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALTfrom, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALTfrom, cyr) *
					CO2_DE_BY_RG(SupplyRegion_ALTfrom, CO2CapGroup_element(CarbonRegion)) * (1.0 - SR_TRAN_CREDIT('1'))
					endif
					endif
				}
				Comment: "EP$ETT,51";
			}
			Parameter ccalc_cTSR_rETRPSle {
				IndexDomain: {
					(RPSRegion,RPSRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALTfrom, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and RPSRegion<>RPSRegion_ALTX
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: E(*)(*)TRPS(*)";
				Definition: {
					IF UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SR_TRAN_CREDIT('1')>0 then
					if (UPRNWCASR(MAP_NERC_TO_RPS_RGN2(SupplyRegion_ALTX)) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALTfrom) and RPSRegion_ALTX=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALTX)) then
					-0.001 * EPWDTH(LoadSlice_element(SupplyRegion_ALTfrom, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALTfrom, cyr) *
					(1.0 - SR_TRAN_CREDIT('1'))
					endif
					endif
				}
				Comment: "EP$ETT,48";
			}
			Parameter ccalc_cTSR_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr)
					and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SR_TRAN_CREDIT('1')>0 then
					if SupplyRegion_ALT1=SupplyRegion_ALTfrom then
					-1 * (1 - SR_TRAN_CREDIT('1'))
					elseif SupplyRegion_ALT1=SupplyRegion_ALTX then
					1-LINELOSS('1') * (1 - SR_TRAN_CREDIT('1'))
					endif
					endif
				}
				Comment: {
					"EP$ETT,32; EP$ETT,39"
				}
			}
			Parameter ccalc_cTSR_rLELle {
				IndexDomain: {
					(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ord(LoadGroup)<=EPNGRP('1', SupplyRegion_ALT1, cyr) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(SupplyRegion_ALTa)<=UNRGNS('1') and SupplyRegion_ALTfrom=SupplyRegion_ALT1 and SupplyRegion_ALTX=SupplyRegion_ALTa
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: L(*)(*)EL(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALT1, SupplyRegion_ALTa)=1 and SR_TRAN_CREDIT('1')>0 then
					1
					endif
				}
				Comment: "EP$ETT,26";
			}
			Parameter ccalc_cTSR_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTfrom,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTfrom)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr) and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: M(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SupplyRegion_ALTa=SupplyRegion_ALTX and SR_TRAN_CREDIT('1')>0 then
					1
					endif
				}
				Comment: "EP$ETT,46";
			}
			Parameter ccalc_cTSR_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTfrom, cyr)
					and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1') and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SR_TRAN_CREDIT('1')>0 then
					if SupplyRegion_ALT1=SupplyRegion_ALTfrom then
					-1 * SR_TRAN_CREDIT('1')
					elseif SupplyRegion_ALT1=SupplyRegion_ALTX then
					1-LINELOSS('1') * SR_TRAN_CREDIT('1')
					endif
					endif
				}
				Comment: {
					"EP$ETT,33; EP$ETT,40"
				}
			}
			Parameter ccalc_cTSR_rXELle {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and
					ord(SupplyRegion_ALTX)<=UNRGNS('1')
				}
				Text: "OML Columns: T(*)(*)SR(*)(*)(*) and OML Rows: X(*)EL(*)(*)(*)(*)";
				Definition: {
					if UPXRGN(SupplyRegion_ALTfrom, SupplyRegion_ALTX)=1 and SupplyRegion_ALT1=SupplyRegion_ALTfrom and SR_TRAN_CREDIT('1')>0 then
					1
					endif
				}
				Comment: "EP$ETT,44";
			}
			Parameter ccalc_cTSRCAN_ECPCOSTS {
				IndexDomain: (CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear);
				Text: {
					"OML Columns: T(*)(*)SR(*)(*)(*)!CAN and OML Rows: ECPCOSTS"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') and SR_TRAN_CREDIT('1')>0 then
					if -ECP_MIN('1') < VOMCSTCAN1_ETT(CanadianSupplyRegion,SupplyRegion_ALTa, LoadGroup, LoadSegment, PlanYear) < ECP_MIN('1') then
					ECP_MIN('1')
					else
					VOMCSTCAN1_ETT(CanadianSupplyRegion,SupplyRegion_ALTa, LoadGroup, LoadSegment, PlanYear)
					endif
					endif
				}
				Comment: "EP$ETT,70";
			}
			Parameter ccalc_cTSRCAN_rLEL2cange {
				IndexDomain: {
					(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTa,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTa)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: {
					"OML Columns: T(*)(*)SR(*)(*)(*)!CAN and OML Rows: L(*)EL(*)(*)(*)(*)!can"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') and SR_TRAN_CREDIT('1')>0 then
					-1
					endif
				}
				Comment: "EP$ETT,72";
			}
			Parameter ccalc_cTSRCAN_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3 and
					SupplyRegion_ALT1=SupplyRegion_ALTa
				}
				Text: {
					"OML Columns: T(*)(*)SR(*)(*)(*)!CAN and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') and SR_TRAN_CREDIT('1')>0 then
					1-LINELOSS('1') * (1.0 - SR_TRAN_CREDIT('1'))
					endif
				}
				Comment: "EP$ETT,74";
			}
			Parameter ccalc_cTSRCAN_rMELle {
				IndexDomain: {
					(SupplyRegion_ALTa,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALTa,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALTa)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3
				}
				Text: {
					"OML Columns: T(*)(*)SR(*)(*)(*)!CAN and OML Rows: M(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') and SR_TRAN_CREDIT('1')>0 then
					1
					endif
				}
				Comment: "EP$ETT,77";
			}
			Parameter ccalc_cTSRCAN_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion,SupplyRegion_ALTa) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALTa, cyr) and ord(CanadianSupplyRegion)<=card(CanadianSupplyRegion)-3 and
					SupplyRegion_ALT1=SupplyRegion_ALTa
				}
				Text: {
					"OML Columns: T(*)(*)SR(*)(*)(*)!CAN and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					if CNSTRNTS_ECP(Season_element(LoadGroup), LastModelYear_MNUMYR(PlanYear), SupplyRegionAll_Element(SupplyRegion_ALTa), EXRG_CanadianSupplyRegion(CanadianSupplyRegion))>ECP_MIN('1') and
					TST_CAN(CanadianSupplyRegion, LoadGroup, LoadSegment, PlanYear)>ECP_MIN('1') and SR_TRAN_CREDIT('1')>0 then
					1-LINELOSS('1') * SR_TRAN_CREDIT('1')
					endif
				}
				Comment: "EP$ETT,75";
			}
		}
		DeclarationSection EP_FLCRV_Completed {
			Parameter PV_WOPEX {
				IndexDomain: PlanYear;
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					WOPEX(FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(WOPEX(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					WOPEX(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					endif
				}
			}
			Parameter WOPEX {
				IndexDomain: FullPlanningHorizon;
				Definition: XIT_WOP(ExpectationYrIndex_KYR(FullPlanningHorizon), element(OwnerType_,2)) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
			}
			Parameter WHDEX {
				IndexDomain: FullPlanningHorizon;
				Definition: (XOGWPRNG(last(OGSMReg_), ExpectationYrIndex_KYR(FullPlanningHorizon)) / CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon))) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
			}
			Parameter PV_WHDEX {
				IndexDomain: (GasSupplyStep,PlanYear);
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX(GasSupplyStep, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX(GasSupplyStep, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX(GasSupplyStep, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
			}
			Parameter PDELX1 {
				IndexDomain: (FuelRegion,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					(XPRSEL(CensusRegion_EPCSMP(FuelRegion), ExpectationYrIndex_KYR(FullPlanningHorizon)) - PJRSEL(LastModelYear_MNUMYR2(FullPlanningHorizon)) * P2025ADJ(PlanYear_FullPlanningHorizon(FullPlanningHorizon))) *
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) - WOPEX(FullPlanningHorizon)
				}
			}
			Parameter PV_PDELX1 {
				IndexDomain: (FuelRegion,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX1(FuelRegion, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX1(FuelRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX1(FuelRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
			}
			Parameter PDELX2 {
				IndexDomain: (FuelRegion,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					(XPDSEL(CensusRegion_EPCSMP(FuelRegion), ExpectationYrIndex_KYR(FullPlanningHorizon)) - PJDSEL(LastModelYear_MNUMYR2(FullPlanningHorizon)) * P2025ADJ(PlanYear_FullPlanningHorizon(FullPlanningHorizon))) *
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) - WOPEX(FullPlanningHorizon)
				}
			}
			Parameter PDELX3 {
				IndexDomain: (FuelRegion,GasSeason,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					(SPNGELGR(GasRegion_EPGSMP(FuelRegion), LastModelYear_MNUMYR2(FullPlanningHorizon), GasSeason_Three(GasSeason)) * UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)) -
					WHDEX(FullPlanningHorizon_MYR(FullPlanningHorizon))) * (UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) / UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)))
				}
			}
			Parameter PDELX4 {
				IndexDomain: (FuelRegion,FuelSupplyStep,GasSeason,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					if ord(FuelSupplyStep)<=5 then
					((SPNGELGR(GasRegion_EPGSMP(FuelRegion), LastModelYear_MNUMYR2(FullPlanningHorizon), GasSeason_Three(GasSeason)) + (EL_MRKUP_BETA(GasSeason_Three(GasSeason)) *
					(Qrem_temp(FuelRegion, FuelSupplyStep, GasSeason, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) - Qzero(FuelRegion, GasSeason, PlanYear_FullPlanningHorizon(FullPlanningHorizon))) /
					CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon))) / CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon))) * UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)) -
					WHDEX(FullPlanningHorizon_MYR(FullPlanningHorizon))) * (UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) / UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)))
					
					elseif 10<=ord(FuelSupplyStep)<=18 and Qrem_temp(FuelRegion, FuelSupplyStep, GasSeason, PlanYear_FullPlanningHorizon(FullPlanningHorizon))>0 then
					((SPNGELGR(GasRegion_EPGSMP(FuelRegion), LastModelYear_MNUMYR2(FullPlanningHorizon), GasSeason_Three(GasSeason)) - (EL_MRKUP_BETA(GasSeason_Three(GasSeason)) *
					(Qzero(FuelRegion, GasSeason, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) - Qrem_temp(FuelRegion, FuelSupplyStep, GasSeason, PlanYear_FullPlanningHorizon(FullPlanningHorizon))) /
					CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon))) / CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon))) * UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)) -
					WHDEX(FullPlanningHorizon_MYR(FullPlanningHorizon))) * (UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) / UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)))
					endif
				}
			}
			Parameter PV_PDELX2 {
				IndexDomain: (FuelRegion,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX2(FuelRegion, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX2(FuelRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX2(FuelRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
			}
			Parameter PV_PDELX3 {
				IndexDomain: (FuelRegion,GasSeason,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX3(FuelRegion,GasSeason, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX3(FuelRegion,GasSeason, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX3(FuelRegion,GasSeason, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
			}
			Parameter PV_PDELX4 {
				IndexDomain: (FuelRegion,FuelSupplyStep,GasSeason,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX4(FuelRegion,FuelSupplyStep,GasSeason, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX4(FuelRegion,FuelSupplyStep,GasSeason, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX4(FuelRegion,FuelSupplyStep,GasSeason, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
			}
			Parameter QBASE {
				IndexDomain: PlanYear;
				Definition: {
					if ORD(CYR)+ORD(PlanYear)-1 <= UNYEAR('1') then
					 QNGEL(last(CensusRegion_), LastModelYear_MNUMYR(PlanYear))
					 else
					 QNGEL(last(CensusRegion_), LastModelYear_MNUMYR(PlanYear)) * UPNGGRWE('1') ^ (ORD(CYR)+ORD(PlanYear)-1 - UNYEAR('1'))
					 endif
				}
			}
			Parameter QBAST {
				IndexDomain: PlanYear;
				Definition: OGPRDNG(last(OGSMReg_), cyr-1) * UPNGGRWT('1') ^ ord(PlanYear);
			}
			Parameter QSIZE {
				IndexDomain: PlanYear;
				Definition: QBASE(PlanYear) * UPCRVSIZ('1');
			}
			Parameter QDEL {
				IndexDomain: (GasSupplyStep,PlanYear);
				Definition: {
					IF (UPCRVSW('1') <= 1)THEN
					IF (ord(GasSupplyStep) <= UPCRVSTP('1')) THEN
					(QBAST(PlanYear) - QSIZE(PlanYear) * (UPCRVSTP('1') - ord(GasSupplyStep) + 1) / CFNGU(LastModelYear_MNUMYR(PlanYear))) / $ QBAST(PlanYear)
					else
					(QBAST(PlanYear) + QSIZE(PlanYear) * (ord(GasSupplyStep) - (UPCRVSTP('1') + 1)) / CFNGU(LastModelYear_MNUMYR(PlanYear))) / $ QBAST(PlanYear)
					endif
					endif
				}
			}
			Parameter PDEL {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
				Definition: {
					IF (UPCRVSW('1') <= 1) THEN
					1.0 + (QDEL(GasSupplyStep, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) - 1.0) * UPCRVELA('1') * EFAC(GasSupplyStep, PlanYear_FullPlanningHorizon(FullPlanningHorizon))
					elseif UPCRVSW('1') = 2 then
					
					ELNGSCRV_Function(VALUENG)(GasSupplyStep,FullPlanningHorizon)/
					ELNGSCRV_Function(VALUENG0)(GasSupplyStep,FullPlanningHorizon)
					endif
				}
			}
			Parameter PDELX {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
				Definition: {
					if ord(FullPlanningHorizon)>= UNXPH('1') and UPCRVSW('1') <= 1 then
					WHDEX(FullPlanningHorizon)
					else
					WHDEX(FullPlanningHorizon)*PDEL(GasSupplyStep, FullPlanningHorizon)
					endif
				}
			}
			Parameter EFAC {
				IndexDomain: (GasSupplyStep,PlanYear);
				Definition: {
					IF (UPCRVSW('1') <= 1)THEN
					IF (ord(GasSupplyStep) <= UPCRVSTP('1')) THEN
					  0.5
					else
					  IF (QDEL(GasSupplyStep, PlanYear) <= 1.025) THEN
					        1.0 + 0.25 * (QDEL(GasSupplyStep, PlanYear) - 1.000) / (1.025 - 1.000)
					  ELSEIF (QDEL(GasSupplyStep, PlanYear) <= 1.05) THEN
					        1.25 + 0.25 * (QDEL(GasSupplyStep, PlanYear) - 1.025) / (1.050 - 1.025)
					  ELSEIF (QDEL(GasSupplyStep, PlanYear) <= 1.10) THEN
					        1.5 + 0.75 * (QDEL(GasSupplyStep, PlanYear) - 1.050) / (1.100 - 1.050)
					  ELSE
					        2.25 + 0.75 * (QDEL(GasSupplyStep, PlanYear) - 1.100) / (1.150 - 1.100)
					  ENDIF
					endif
					endif
				}
			}
			Parameter P2025ADJ {
				IndexDomain: PlanYear;
				Definition: {
					if ord(PlanYear)+CURIYR('1')-1 <= UNYEAR('1') then
					1
					else
					UPCARGRW('1') ^ (ord(PlanYear)+CURIYR('1')-1 - UNYEAR('1'))
					endif
				}
			}
			Parameter VALUENG {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
				Definition: ((ord(GasSupplyStep) - 1) - UPCRVSTP('1')) * QSIZE(PlanYear_FullPlanningHorizon(FullPlanningHorizon));
			}
			Parameter VALUENG0 {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
				Definition: 0;
			}
			Parameter SO2SHR {
				IndexDomain: (SO2Region,PlanYear,FuelRegion_ALT1);
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1'))THEN
					        TSO2_SHR_BY_OLRG(CensusRegion_EPCSMP(FuelRegion_ALT1), SO2Region_SO2Transport(SO2Region))
					ELSE
					        SO2_SHR_BY_OLRG(CensusRegion_EPCSMP(FuelRegion_ALT1), SO2Region_SO2ComplyGroup(SO2Region))
					ENDIF
				}
			}
			Parameter M_SIZE {
				IndexDomain: (Season, FuelRegion, PlanYear);
				Definition: {
					0.001 * AVG_HTRT(WIAC_Element, FuelRegion0, first(SupplyRegion), ExplicitPlanningHorizon_element(PlanYear)) * UPMCF(WIAC_Element) * NG_SP_HRS(Season, PlanYear, first(SupplyRegion)) *
					UPLRMIN(WIAC_Element) * 0.001 * UPMSSIZ(WIAC_Element)
				}
			}
			Parameter NG_SP_HRS {
				IndexDomain: (Season, PlanYear, SupplyRegion);
				Definition: sum(SliceGroup | SliceGroup2Season_Map(Season, SliceGroup, PlanYear, SupplyRegion), EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) * 0.001);
			}
			Parameter QDELX {
				IndexDomain: (FuelRegion,GasSeason,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: SQNGELGR(GasRegion_EPGSMP(FuelRegion), LastModelYear_MNUMYR2(FullPlanningHorizon), GasSeason_Three(GasSeason));
			}
			Parameter QGWX {
				IndexDomain: (FuelRegion,GasSeason,FullPlanningHorizon)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: 1;
			}
			Parameter QGW {
				IndexDomain: (FuelRegion,GasSeason,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					QDELX(FuelRegion,GasSeason, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(QDELX(FuelRegion,GasSeason, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) /
					QDELX(FuelRegion,GasSeason, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(QGWX(FuelRegion,GasSeason, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					QGWX(FuelRegion,GasSeason, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
			}
			Parameter Qzero {
				IndexDomain: (FuelRegion,GasSeason,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: max(QGW(FuelRegion, GasSeason, PlanYear),M_SIZE(element(Season_,ord(GasSeason)), FuelRegion, PlanYear));
			}
			Parameter Qremaining {
				IndexDomain: (FuelRegion,GasSeason,PlanYear)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: Qzero(FuelRegion, GasSeason, PlanYear)- M_SIZE(element(Season_,ord(GasSeason)), FuelRegion, PlanYear);
			}
			Parameter NSize {
				IndexDomain: (FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Definition: {
					if ord(FuelSupplyStep)<=5 then
					M_SIZE(element(Season_,ord(GasSeason)), FuelRegion_ALT1, PlanYear) * (3.0 ^ (ord(FuelSupplyStep) - 1))
					elseif 9<ord(FuelSupplyStep)<18 then
					M_SIZE(element(Season_,ord(GasSeason)), FuelRegion_ALT1, PlanYear) * (3.0 ^ (val(FuelSupplyStep) - 1))
					endif
				}
			}
			Parameter Qrem_temp {
				IndexDomain: (FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Definition: {
					if ord(FuelSupplyStep)<=5 then
					  Qzero(FuelRegion_ALT1, GasSeason, PlanYear) + sum(FuelSupplyStep_ALT1 | FuelSupplyStep_ALT1<=FuelSupplyStep, NSize(FuelRegion_ALT1, FuelSupplyStep_ALT1, GasSeason, PlanYear))
					elseif 10<=ord(FuelSupplyStep)<=18 then
					  if val(FuelSupplyStep)=1 then
					    Qremaining(FuelRegion_ALT1, GasSeason, PlanYear)
					  else
					    Qremaining(FuelRegion_ALT1, GasSeason, PlanYear)-sum(FuelSupplyStep_ALT1 | 10<=ord(FuelSupplyStep_ALT1)<=18 and FuelSupplyStep_ALT1<FuelSupplyStep,
					    NSize(FuelRegion_ALT1, FuelSupplyStep_ALT1, GasSeason, PlanYear))
					  endif
					endif
				}
			}
			Parameter TST_SO2P {
				IndexDomain: (SO2Region,PlanYear,FuelRegion_ALT1);
				Definition: {
					if ccalc_cTRSXX_rEUSORSle(SO2Region, PlanYear, FuelRegion_ALT1) then
					1
					endif
				}
			}
			Parameter TST_HGP {
				IndexDomain: (nHGCODE,PlanYear,FuelRegion_ALT1);
				Definition: {
					if ccalc_cTRSXX_rEUHGRSle(nHGCODE, PlanYear, FuelRegion_ALT1) then
					1
					endif
				}
			}
			Parameter MR_TST {
				IndexDomain: (FuelRegion, DispatchableECP, PlanYear, SupplyRegion)  | ord(FuelRegion)<=UNFRGN('1');
				Definition: {
					IF DispatchableECP <> WIA2_Element THEN
					  IF EPECAP_MR(FuelRegion, DispatchableECP, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 THEN
					    1
					  ENDIF
					ELSE
					  IF EPECAP_MR(FuelRegion, WIEC_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) >0 OR
					  EPECAP_MR(FuelRegion, DispatchableECP, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) >0 THEN
					    1
					  ENDIF
					ENDIF
				}
			}
			Parameter VALCAR {
				IndexDomain: (PlanYear,FuelRegion,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					 ECPFuelsPerPlant(PlantType, ECPFuelType)=1) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cF_rFL_NGle(GasSeason, FuelRegion, PlanYear, PlantType, ECPFuelType) * ENGEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cF_rFUELRSle(FuelRegion, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cF_rFUELDSle(FuelRegion, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 * (1.0 - UPPCEF(PlantType))
					 endif
					endif
				}
			}
			Parameter ccalc_cSUOLX_rFUELOLXle {
				IndexDomain: (PlanYear,OilSupplyStep) | ord(OilSupplyStep)=1;
				Text: "OML Columns: SUOLX(**)(*) and OML Rows: FUELOLX(*)";
				Definition: -1;
				Comment: "EP$FLCRV,3";
			}
			Parameter ccalc_cSUOLX_UBOUND {
				IndexDomain: (OilSupplyStep,PlanYear) | ord(OilSupplyStep)=1;
				Text: "OML Columns: SUOLX(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: 10000;
				Comment: "EP$FLCRV,4";
			}
			Parameter ccalc_cSUOLX_ECPCOSTS {
				IndexDomain: (OilSupplyStep,PlanYear);
				Text: "OML Columns: SUOLX(**)(*) and OML Rows: ECPCOSTS";
				Definition: PV_WOPEX(PlanYear);
				Comment: "EP$FLCRV,5";
			}
			Parameter ccalc_cSUNGX_rFUELNGXle {
				IndexDomain: (PlanYear,GasSupplyStep);
				Text: "OML Columns: SUNGX(**)(*) and OML Rows: FUELNGX(*)";
				Definition: -1;
				Comment: "EP$FLCRV,6";
			}
			Parameter ccalc_cSUNGX_UBOUND {
				IndexDomain: (GasSupplyStep,PlanYear);
				Text: "OML Columns: SUNGX(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF GasSupplyStep=first(GasSupplyStep_) THEN
					        QBASE(PlanYear) - UPCRVSTP('1') * QSIZE(PlanYear)
					ELSE
					        QSIZE(PlanYear)
					ENDIF
				}
				Comment: "EP$FLCRV,7";
			}
			Parameter ccalc_cSUNGX_ECPCOSTS {
				IndexDomain: (GasSupplyStep,PlanYear);
				Text: "OML Columns: SUNGX(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (UPCRVSW('1') <= 1) THEN
					PV_WHDEX(GasSupplyStep, PlanYear)*PDEL(GasSupplyStep, FullPlanningHorizon_PlanYear(PlanYear))
					elseif UPCRVSW('1') = 2 then
					PV_WHDEX(GasSupplyStep, PlanYear)
					endif
				}
				Comment: "EP$FLCRV,8";
			}
			Parameter ccalc_cTRSXX_rFUELOLXle {
				IndexDomain: (PlanYear,FuelRegion_ALT1) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: FUELOLX(*)";
				Definition: 1;
				Comment: "EP$FLCRV,10";
			}
			Parameter ccalc_cTRSXX_rFUELRSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: FUELRS(*)(*)";
				Definition: -1;
				Comment: "EP$FLCRV,11";
			}
			Parameter ccalc_cTRSXX_ECPCOSTS {
				IndexDomain: (FuelRegion_ALT1,PlanYear);
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: ECPCOSTS";
				Definition: MAX(-(PV_WOPEX(PlanYear) - 0.001) , PV_PDELX1(FuelRegion_ALT1, PlanYear));
				Comment: "EP$FLCRV,12";
			}
			Parameter ccalc_cTRSXX_rEUSORSle {
				IndexDomain: (SO2Region,PlanYear,FuelRegion_ALT1);
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: EUSORS(*)(*)";
				Definition: {
					IF (SO2SHR(SO2Region, PlanYear, FuelRegion_ALT1) > 0.0001) THEN
					  UFRSO2(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * SO2SHR(SO2Region, PlanYear, FuelRegion_ALT1) * 0.5 $
					  (UFRSO2(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * SO2SHR(SO2Region, PlanYear, FuelRegion_ALT1) * 0.5 > ECP_MIN('1'))
					endif
				}
				Comment: "EP$FLCRV,13";
			}
			Parameter ccalc_cTRSXX_rEUHGRSle {
				IndexDomain: (nHGCODE,PlanYear,FuelRegion_ALT1);
				Text: "OML Columns: T(*)RSXX(*) and OML Rows: EUHGRS(*)(*)";
				Definition: {
					IF USW_HG('1')  THEN
					UFRHG(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * 0.5 $ (UFRHG(EFDFuelType_UIRL, FuelRegion_EPCSMP(FuelRegion_ALT1)) * 0.5 > ECP_MIN('1'))
					endif
				}
				Comment: "EP$FLCRV,14";
			}
			Parameter ccalc_cTDSXX_rFUELOLXle {
				IndexDomain: (PlanYear,FuelRegion_ALT1) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)DSXX(*) and OML Rows: FUELOLX(*)";
				Definition: 1;
				Comment: "EP$FLCRV,16";
			}
			Parameter ccalc_cTDSXX_rFUELDSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)DSXX(*) and OML Rows: FUELDS(*)(*)";
				Definition: -1;
				Comment: "EP$FLCRV,17";
			}
			Parameter ccalc_cTDSXX_ECPCOSTS {
				IndexDomain: (FuelRegion_ALT1,PlanYear);
				Text: "OML Columns: T(*)DSXX(*) and OML Rows: ECPCOSTS";
				Definition: PV_PDELX2(FuelRegion_ALT1, PlanYear);
				Comment: "EP$FLCRV,18";
			}
			Parameter ccalc_cTNG0_rFUELNGXle {
				IndexDomain: (PlanYear,FuelRegion_ALT1,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG0(*)(*) and OML Rows: FUELNGX(*)";
				Definition: 1;
				Comment: "EP$FLCRV,20";
			}
			Parameter ccalc_cTNG0_rFL_NGle {
				IndexDomain: (GasSeason,FuelRegion_ALT1,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG0(*)(*) and OML Rows: FL_NG(*)(*)(*)";
				Definition: -1;
				Comment: "EP$FLCRV,21";
			}
			Parameter ccalc_cTNG0_ECPCOSTS {
				IndexDomain: (FuelRegion_ALT1,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG0(*)(*) and OML Rows: ECPCOSTS";
				Definition: PV_PDELX3(FuelRegion_ALT1, GasSeason, PlanYear);
				Comment: "EP$FLCRV,22";
			}
			Parameter ccalc_cTNG0_UBOUND {
				IndexDomain: (FuelRegion_ALT1,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG0(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: M_SIZE(element(Season_,ord(GasSeason)), FuelRegion_ALT1, PlanYear);
				Comment: "EP$FLCRV,23";
			}
			Parameter ccalc_cTNG_UBOUND {
				IndexDomain: (FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG(*)(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if ord(FuelSupplyStep)<5 then
					NSize(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear)
					elseif (10<=ord(FuelSupplyStep)<=18 and Qrem_temp(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear)>0) then
					  if ord(FuelSupplyStep)=18 then
					    Qrem_temp(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear)
					  else
					    min(Qrem_temp(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear), NSize(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear))
					  endif
					else
					inf
					endif
				}
				Comment: {
					"EP$FLCRV,24; EP$FLCRV,28"
				}
			}
			Parameter ccalc_cTNG_rFL_NGle {
				IndexDomain: (GasSeason,FuelRegion_ALT1,PlanYear,FuelSupplyStep) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG(*)(*)(*) and OML Rows: FL_NG(*)(*)(*)";
				Definition: {
					if ord(FuelSupplyStep)<=5 or (10<=ord(FuelSupplyStep)<=18 and Qrem_temp(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear)>0) then
					-1
					endif
				}
				Comment: {
					"EP$FLCRV,26; EP$FLCRV,30"
				}
			}
			Parameter ccalc_cTNG_rFUELNGXle {
				IndexDomain: (PlanYear,FuelRegion_ALT1,FuelSupplyStep,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG(*)(*)(*) and OML Rows: FUELNGX(*)";
				Definition: {
					if ord(FuelSupplyStep)<=5 or (10<=ord(FuelSupplyStep)<=18 and Qrem_temp(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear)>0) then
					1
					endif
				}
				Comment: {
					"EP$FLCRV,25; EP$FLCRV,29"
				}
			}
			Parameter ccalc_cTNG_ECPCOSTS {
				IndexDomain: (FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear) | ord(FuelRegion_ALT1)<=UNFRGN('1');
				Text: "OML Columns: T(*)NG(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: PV_PDELX4(FuelRegion_ALT1, FuelSupplyStep, GasSeason, PlanYear);
				Comment: {
					"EP$FLCRV,27; EP$FLCRV,31"
				}
			}
			Parameter ccalc_cF_rFXXle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,PlantType,ECPFuelType) | PlantType_ALT2=PlantType and ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: F(*)(**)XX(*)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					!Fill BTU Balance Rows By Plant Type
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0 OR UPFHYT(ECPFuelType)>0) THEN
					-1
					endif
					endif
				}
				Comment: "EP$FLCRV,32";
			}
			Parameter ccalc_cF_rFL_NGle {
				IndexDomain: (GasSeason,FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: FL_NG(*)(*)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					PlantType <> WIIC_Element and ECPFuelsPerPlant(PlantType, ECPFuelType)=1) THEN
					!Use Natural Gas
					IF (UPFGAS(ECPFuelType)> 0) THEN
					 IF (UPFGAS(ECPFuelType) = 1) THEN
					    UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					    (1-UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))) $ ((1-UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1'))
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,33";
			}
			Parameter ccalc_cF_rFL_H2le {
				IndexDomain: {
					(Season,CensusRegion_ALT1,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType=WIIC_Element and
					ord(Season)=ord(GasSeason) and CensusRegion_ALT1=CensusRegion_EPCSMP(FuelRegion_ALT1)
				}
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: FL_H2(*)(*)(*)";
				Definition: {
					IF ECPFuelsPerPlant(PlantType, ECPFuelType)=1 THEN
					!Use Hydrogen Gas
					if (ord(cyr) + UHBSYR('1') >= UPSTYR('1')) then
					1
					endif
					endif
				}
				Comment: "EP$FLCRV,33_1";
			}
			Parameter ccalc_cF_rFUELRSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: FUELRS(*)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1) THEN
					!Use Residual Fuel Oil
					 IF (UPFRES(ECPFuelType)> 0) THEN
					 IF (UPFRES(ECPFuelType) = 1) THEN
					    UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					    (1-UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))) $ ((1-UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1'))
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,34";
			}
			Parameter ccalc_cF_rFUELDSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: FUELDS(*)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1) THEN
					!Use Distillate Fuel Oil
					 IF (UPFDIS(ECPFuelType)> 0) THEN
					 IF (UPFDIS(ECPFuelType) = 1) THEN
					    UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXOIL(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					    (1-UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))) $ ((1-UPMXGAS(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1'))
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,35";
			}
			Parameter ccalc_cF_rEUCARXXn {
				IndexDomain: {
					(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonNationalCap(PlanYear)=0
				}
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: EUCARXX(*)";
				Definition: {
					!PUT INTO CARBON ROWS
					IF (VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) > ECP_MIN('1')) THEN
					VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason)
					ENDIF
				}
				Comment: "EP$FLCRV,36";
			}
			Parameter ccalc_cF_rEUCARXXle {
				IndexDomain: {
					(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonNationalCap(PlanYear)=1
				}
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: EUCARXX(*)";
				Definition: {
					!PUT INTO CARBON ROWS
					IF (VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) > ECP_MIN('1')) THEN
					VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason)
					ENDIF
				}
				Comment: "EP$FLCRV,36";
			}
			Parameter ccalc_cF_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonRegionCap_ALT(CarbonRegion,PlanYear) = 1
				}
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) > ECP_MIN('1')) THEN
					  VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) *
					  CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					ENDIF
				}
				Comment: "EP$FLCRV,37";
			}
			Parameter ccalc_cF_rEUCARn {
				IndexDomain: {
					(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonRegionCap_ALT(CarbonRegion,PlanYear) = 0
				}
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) > ECP_MIN('1')) THEN
					  VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) *
					  CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					ENDIF
				}
				Comment: "EP$FLCRV,37";
			}
			Parameter ccalc_cF_rEUCARCRn {
				IndexDomain: (PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: F(*)(**)(**)(*)(*) and OML Rows: EUCARCR(*)";
				Definition: {
					!Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Non - Must Run
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) > ECP_MIN('1')) THEN
					  VALCAR(PlanYear, FuelRegion_ALT1, PlantType, ECPFuelType, GasSeason) *
					  sum(CO2CapGroup,CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup))*UPPCEF(PlantType)
					ENDIF
				}
				Comment: "EP$FLCRV,38";
			}
			Parameter ccalc_cY_rFMRle {
				IndexDomain: {
					(FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,PlantType,ECPFuelType) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					PlantType=PlantType_ALT2
				}
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: F(*)(**)MR(*)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!Fill BTU Balance Rows By Plant Type
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					-1
					endif
					endif
				}
				Comment: "EP$FLCRV,40";
			}
			Parameter ccalc_cY_rFL_NGle {
				IndexDomain: (GasSeason,FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: FL_NG(*)(*)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					!Use Natural Gas
					IF (UPFGAS(ECPFuelType)> 0) THEN
					 IF (UPFGAS(ECPFuelType) = 1) THEN
					    UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					    (1-UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))) $ ((1-UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1'))
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,41";
			}
			Parameter ccalc_cY_rFUELRSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: FUELRS(*)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					!Use Residual Fuel Oil
					 IF (UPFRES(ECPFuelType)> 0) THEN
					 IF (UPFRES(ECPFuelType) = 1) THEN
					    UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					    (1-UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))) $ ((1-UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1'))
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,42";
			}
			Parameter ccalc_cY_rFUELDSle {
				IndexDomain: (FuelRegion_ALT1,PlanYear,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: FUELDS(*)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					!Use Distillate Fuel Oil
					 IF (UPFDIS(ECPFuelType)> 0) THEN
					 IF (UPFDIS(ECPFuelType) = 1) THEN
					    UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) $
					    (UPMXOIL_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear))>ECP_MIN('1'))
					 ELSE
					   ( 1-UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)) ) $ ( (1-UPMXGAS_MR(PlantType, FuelRegion_ALT1, LastModelYear_MNUMYR(PlanYear)))>ECP_MIN('1') )
					 ENDIF
					endif
					endif
				}
				Comment: "EP$FLCRV,43";
			}
			Parameter ccalc_cY_rEUCARXXn {
				IndexDomain: {
					(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonNationalCap(PlanYear)=0
				}
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: EUCARXX(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!PUT INTO CARBON ROWS
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cY_rFL_NGle(GasSeason, FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType) * EGFEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELRSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELDSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 * (1.0 - UPPCEF(PlantType))
					 endif
					endif
				}
				Comment: "EP$FLCRV,44";
			}
			Parameter ccalc_cY_rEUCARXXle {
				IndexDomain: {
					(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonNationalCap(PlanYear)=1
				}
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: EUCARXX(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!PUT INTO CARBON ROWS
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cY_rFL_NGle(GasSeason, FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType) * EGFEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELRSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELDSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 * (1.0 - UPPCEF(PlantType))
					 endif
					endif
				}
				Comment: "EP$FLCRV,44";
			}
			Parameter ccalc_cY_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonRegionCap_ALT(CarbonRegion,PlanYear) = 1
				}
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cY_rFL_NGle(GasSeason, FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType) * EGFEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELRSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELDSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 *
					 (1.0 - UPPCEF(PlantType))*CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					 endif
					endif
				}
				Comment: "EP$FLCRV,45";
			}
			Parameter ccalc_cY_rEUCARn {
				IndexDomain: {
					(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_ and
					CarbonRegionCap_ALT(CarbonRegion,PlanYear) = 0
				}
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cY_rFL_NGle(GasSeason, FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType) * EGFEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELRSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELDSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 *
					 (1.0 - UPPCEF(PlantType))*CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					 endif
					endif
				}
				Comment: "EP$FLCRV,45";
			}
			Parameter ccalc_cY_rEUCARCRn {
				IndexDomain: (PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) | ord(FuelRegion_ALT1)<=UNFRGN('1') and PlantType in DispatchableECP_;
				Text: "OML Columns: Y(*)(**)(**)(*)(*) and OML Rows: EUCARCR(*)";
				Definition: {
					! Create Vectors to Blend Oil and Natural Gas to Feed Appropriate Plant Types - Must Run Only
					!PUT INTO CARBON ROWS
					!Include in Regional CO2 Limits, If Appropriate
					IF (UPTTYP(PlantType)> NW_COAL('1') AND PlantType <> WICN_Element AND PlantType <> WIAN_Element AND PlantType <> WISM_Element and
					ECPFuelsPerPlant(PlantType, ECPFuelType)=1 and sum(SupplyRegion, MR_TST(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion)) > 0) THEN
					 IF (UPFGAS(ECPFuelType)>0 OR UPFRES(ECPFuelType)>0 OR UPFDIS(ECPFuelType)> 0) THEN
					 (ccalc_cY_rFL_NGle(GasSeason, FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType) * EGFEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELRSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * ERLEL(LastModelYear_MNUMYR(PlanYear)) +
					 ccalc_cY_rFUELDSle(FuelRegion_ALT1, PlanYear, PlantType, ECPFuelType, GasSeason) * EDSEL(LastModelYear_MNUMYR(PlanYear))) * 0.001 *
					 (1.0 - UPPCEF(PlantType))*sum(CO2CapGroup,CO2_OG_BY_FL(FuelRegion_ALT1, CO2CapGroup))*UPPCEF(PlantType)
					 endif
					endif
				}
				Comment: "EP$FLCRV,46";
			}
			Parameter ccalc_cEUSORS_ECPCOSTS {
				IndexDomain: (SO2Region,PlanYear);
				Text: "OML Columns: EUSORS(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if sum(FuelRegion, TST_SO2P(SO2Region, PlanYear, FuelRegion)) then
					ECP_MIN('1')
					endif
				}
				Comment: "EP$FLCRV,48";
			}
			Parameter ccalc_cEUSORS_rEUSORSle {
				IndexDomain: (SO2Region,PlanYear);
				Text: "OML Columns: EUSORS(*)(*) and OML Rows: EUSORS(*)(*)";
				Definition: {
					if sum(FuelRegion, TST_SO2P(SO2Region, PlanYear, FuelRegion)) then
					-1
					endif
				}
				Comment: "EP$FLCRV,49";
			}
			Parameter ccalc_cEUSORS_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear) | CHK_rEUSO2X(SO2Region, PlanYear)=1;
				Text: "OML Columns: EUSORS(*)(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					if sum(FuelRegion, TST_SO2P(SO2Region, PlanYear, FuelRegion)) then
					1
					endif
				}
				Comment: "EP$FLCRV,50";
			}
			Parameter ccalc_cEUSORS_rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear) | CHK_rEUSO2X(SO2Region, PlanYear)=0;
				Text: "OML Columns: EUSORS(*)(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					if sum(FuelRegion, TST_SO2P(SO2Region, PlanYear, FuelRegion)) then
					1
					endif
				}
				Comment: "EP$FLCRV,50";
			}
			Parameter ccalc_cEUHGRS_rEUHGRSle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: EUHGRS(*)(*) and OML Rows: EUHGRS(*)(*)";
				Definition: {
					if USW_HG('1')>0 and sum(FuelRegion,TST_HGP(nHGCODE, PlanYear, FuelRegion)) then
					-1
					endif
				}
				Comment: "EP$FLCRV,52";
			}
			Parameter ccalc_cEUHGRS_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: EUHGRS(*)(*) and OML Rows: EUHGXX(*)(*)";
				Definition: {
					if USW_HG('1')>0 and sum(FuelRegion,TST_HGP(nHGCODE, PlanYear, FuelRegion)) then
					1
					endif
				}
				Comment: "EP$FLCRV,53";
			}
			Parameter ccalc_cEUHGRS_ECPCOSTS {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: EUHGRS(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if USW_HG('1')>0 and sum(FuelRegion,TST_HGP(nHGCODE, PlanYear, FuelRegion)) then
					ECP_MIN('1')
					endif
				}
				Comment: "EP$FLCRV,54";
			}
		}
		DeclarationSection EP_FLCRV_HYDROGEN {
			Parameter PDELX_H2 {
				IndexDomain: (CensusRegion_ALT1, Season, H2SupplyStep,FullPlanningHorizon) | (ord(cyr) + UHBSYR('1') >= UPSTYR('1'));
				Definition: EPHRTS_PRICES(cyr, CensusRegion_ALT1, Season, H2SupplyStep) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
			}
			Parameter ccalc_cSUH2_rFL_H2le {
				IndexDomain: {
					(Season,CensusRegion_ALT1,PlanYear,H2SupplyStep) | (ord(cyr) + UHBSYR('1') >= UPSTYR('1')) and ord(Season) <= EPNMSP('1',element(SupplyRegion_,UNRGNS('1')),cyr)
					 and CensusRegion_ALT1<=last(CensusRegion)-2
				}
				Text: "OML Columns: SUH2(*)(*)(*)(*) and OML Rows: FL_H2(*)(*)(*)";
				Definition: -1;
				Comment: "EP$FLCRV_H2,2";
			}
			Parameter ccalc_cSUH2_ECPCOSTS {
				IndexDomain: {
					(CensusRegion_ALT1,H2SupplyStep,Season,PlanYear) | (ord(cyr) + UHBSYR('1') >= UPSTYR('1')) and ord(Season) <= EPNMSP('1',element(SupplyRegion_,UNRGNS('1')),cyr)
					 and CensusRegion_ALT1<=last(CensusRegion)-2
				}
				Text: "OML Columns: SUH2(*)(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					PDELX_H2(CensusRegion_ALT1, Season, H2SupplyStep, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(PDELX_H2(CensusRegion_ALT1, Season, H2SupplyStep, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					PDELX_H2(CensusRegion_ALT1, Season, H2SupplyStep, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					
					endif
				}
				Comment: "EP$FLCRV_H2,3";
			}
			Parameter ccalc_cSUH2_UBOUND {
				IndexDomain: {
					(CensusRegion_ALT1,H2SupplyStep,Season,PlanYear) | (ord(cyr) + UHBSYR('1') >= UPSTYR('1')) and ord(Season) <= EPNMSP('1',element(SupplyRegion_,UNRGNS('1')),cyr)
					 and CensusRegion_ALT1<=last(CensusRegion)-2
				}
				Text: "OML Columns: SUH2(*)(*)(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: EPHRTS_QUANTITY(cyr, CensusRegion_ALT1, Season, H2SupplyStep);
				Comment: "EP$FLCRV_H2,4";
			}
		}
		DeclarationSection EP_GRD_Completed {
			Parameter CAP_GRD {
				IndexDomain: (SupplyRegion,FullPlanningHorizon) | ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					if DPVDISPATCH('1')=1 then
					DPVTOTCAPNR(SupplyRegion,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001
					endif
				}
			}
			Parameter GEN_GRD {
				IndexDomain: (SupplyRegion,FullPlanningHorizon) | ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					if DPVDISPATCH('1')=1 then
					DPVTOTGENNR(SupplyRegion,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001
					endif
				}
			}
			Parameter PV_CAP {
				IndexDomain: (SupplyRegion,PlanYear);
				Definition: {
					if DPVDISPATCH('1')=1 then
					IF ord(PlanYear)< UNXPH('1') THEN
					CAP_GRD(SupplyRegion, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CAP_GRD(SupplyRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) /
					CAP_GRD(SupplyRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
					endif
				}
			}
			Parameter PV_GEN {
				IndexDomain: (SupplyRegion,PlanYear);
				Definition: {
					if DPVDISPATCH('1')=1 then
					IF ord(PlanYear)< UNXPH('1') THEN
					GEN_GRD(SupplyRegion, FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(GEN_GRD(SupplyRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) /
					GEN_GRD(SupplyRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
					endif
				}
			}
			Parameter ccalc_cDPVCP_UBOUND {
				IndexDomain: (SupplyRegion_ALTtwo,PlanYear) | ord(SupplyRegion_ALTtwo)<=UNRGNS('1');
				Text: "OML Columns: DPVCP(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if DPVDISPATCH('1')=1 and GRD_RATS(WIPV_Element, SupplyRegion_ALTtwo)>0 then
					PV_CAP(SupplyRegion_ALTtwo, PlanYear)
					else
					inf
					endif
				}
				Comment: "EP$GRD,1";
			}
			Parameter ccalc_cDPVCP_LBOUND {
				IndexDomain: (SupplyRegion_ALTtwo,PlanYear);
				Text: "OML Columns: DPVCP(**)(*) and OML Rows: LBOUND";
				Definition: {
					if DPVDISPATCH('1')=1 and GRD_RATS(WIPV_Element, SupplyRegion_ALTtwo)>0 then
					PV_CAP(SupplyRegion_ALTtwo, PlanYear)
					endif
				}
				Comment: "EP$GRD,1";
			}
			Parameter ccalc_cDPVCP_rGRGRDge {
				IndexDomain: (SupplyRegion_ALT2,PlanYear,SupplyRegion_ALTtwo) | SupplyRegion_ALTtwo=SupplyRegion_ALT2;
				Text: "OML Columns: DPVCP(**)(*) and OML Rows: GRGRD(**)(*)";
				Definition: {
					if DPVDISPATCH('1')=1 and GRD_RATS(WIPV_Element, SupplyRegion_ALTtwo)>0 then
					if PV_CAP(SupplyRegion_ALTtwo, PlanYear)>0 then
					-1.0 * (PV_GEN(SupplyRegion_ALTtwo, PlanYear) / PV_CAP(SupplyRegion_ALTtwo, PlanYear)) *
					(GRD_RATS(WIPV_Element, SupplyRegion_ALTtwo) - GRD_NRYR(SupplyRegion_ALTtwo,ExplicitPlanningHorizon_element(PlanYear)))
					else
					-1
					endif
					endif
				}
				Comment: "EP$GRD,2";
			}
		}
		DeclarationSection EP_INT_Completed {
			Parameter UPV_CF {
				IndexDomain: (LoadGroup,LoadSegment,Seasonx,SupplyRegion,PlanYear)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					UPICFC1(WIPV_Element,ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment),SupplyRegion,cyr) / EPIACF(WIPV_Element,SupplyRegion,cyr) *
					  EPECFC_UPV(WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr) * EP_SP_CAP_FAC(Season_elementx(Seasonx, SupplyRegion),WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr)
				}
			}
			Parameter DPV_CF {
				IndexDomain: (LoadGroup,LoadSegment,Seasonx,SupplyRegion,PlanYear) | ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					UPICFC_DPV1(WIPV_Element,ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment),SupplyRegion,cyr) / EPIACF(WIPV_Element,SupplyRegion,cyr) *
					DPVTOTGENNR(SupplyRegion, LastModelYear_MNUMYR(PlanYear)) / (8.76 * DPVTOTCAPNR(SupplyRegion, LastModelYear_MNUMYR(PlanYear)) )
				}
			}
			Parameter FOM_EXX0_INT {
				IndexDomain: (RetireGroup, Intermittent, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, Intermittent, RetirementYear, SupplyRegion, cyr)>0 OR (UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion)>0)) THEN
					if USW_ERET('1')=1 then
					if ord(FullPlanningHorizon)=1 then
					0
					else
					EPGFOM(RetireGroup, Intermittent, SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
					endif
				}
			}
			Parameter VOM_EXX0_INT {
				IndexDomain: (RetireGroup, Intermittent, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, Intermittent, RetirementYear, SupplyRegion, cyr)>0 OR (UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion)>0)) THEN
					if USW_ERET('1')=1 then
					(EPIRVOM(IntStor(Intermittent), SupplyRegion, cyr) * 8.76 * EPECFC(Intermittent, first(ExplicitPlanningHorizon), SupplyRegion, cyr)) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
				}
			}
			Parameter FOM_EXXX_INT {
				IndexDomain: (Intermittent, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, Intermittent, RetirementYear, SupplyRegion, cyr)>0 OR (UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion)>0)) THEN
					if TST_INT(SupplyRegion,Intermittent,PlanYear_FullPlanningHorizon(FullPlanningHorizon))>1.0e-10 then
					if ord(FullPlanningHorizon)=1 then
					0
					else
					EPIRFOM(IntStor(Intermittent), SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
					endif
				}
			}
			Parameter VOM_EXXX_INT {
				IndexDomain: (Intermittent, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					if TST_INT(SupplyRegion,Intermittent,PlanYear_FullPlanningHorizon(FullPlanningHorizon))>1.0e-10 then
					(EPIRVOM(IntStor(Intermittent), SupplyRegion, cyr) * 8.76 * EPECFC(Intermittent, first(ExplicitPlanningHorizon), SupplyRegion, cyr)) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
				}
			}
			Parameter TST_INT {
				IndexDomain: (SupplyRegion,PlantType,PlanYear) | PlantType in Intermittent_ and ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					max(EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) * 0.001 -
					if ord(PlanYear)>UPRTLT('1') then
					sum(RetireGroup, EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion, cyr)*0.001)
					endif
					,0)
				}
			}
			Parameter cEXX0_INT_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					if PlantType=WIPT_Element then
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)
					elseif PlantTYpe=WIPV_Element then
					UPV_CF(LoadGroup,LoadSegment,Seasonx,SupplyRegion_ALT1,PlanYear)
					else
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr) *
					EPECFC(PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) /
					EPIACF(PlantType, SupplyRegion_ALT1, cyr) * EP_SP_CAP_FAC(Season_elementx(Seasonx, SupplyRegion_ALT1), PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					endif
					endif
					endif
				}
			}
			Parameter cEXX0_INT_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1')
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					0.001 *
					if sum(SliceGroup | ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr),
					ccalc_cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadGroup_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadSegment_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), PlanYear, PlantType, RetireGroup) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr))<=0 then
					0.0001
					else
					sum(SliceGroup | ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr),
					ccalc_cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadGroup_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadSegment_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), PlanYear, PlantType, RetireGroup) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr))
					endif
					endif
					endif
				}
			}
			Parameter cEXXX_INT_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					if PlantType=WIPT_Element then
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)
					elseif PlantType=WIPV_Element then
					 if (EPECAP('00',WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) > 0) then
					 (DPVTOTCAPNR(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))*0.001 * DPV_CF(LoadGroup,LoadSegment,Seasonx,SupplyRegion_ALT1,PlanYear) +
					 UPV_CF(LoadGroup,LoadSegment,Seasonx,SupplyRegion_ALT1,PlanYear) *
					 (EPECAP('00',WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)*0.001 - DPVTOTCAPNR(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))*0.001))/ EPECAP('00',WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)/0.001
					 else
					   0.0
					 endif
					else
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr) *
					EPECFC(PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) /
					EPIACF(PlantType, SupplyRegion_ALT1, cyr) * EP_SP_CAP_FAC(Season_elementx(Seasonx, SupplyRegion_ALT1), PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					endif
					endif
					endif
				}
			}
			Parameter cEXXX_INT_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					0.001 *
					if sum(SliceGroup | ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr),
					ccalc_cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadGroup_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadSegment_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), PlanYear, PlantType, PlanYear) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr))<=0 then
					0.0001
					else
					sum(SliceGroup | ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr),
					ccalc_cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadGroup_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), LoadSegment_SliceGroup(SliceGroup, PlanYear, SupplyRegion_ALT1), PlanYear, PlantType, PlanYear) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr))
					endif
					endif
					endif
				}
			}
			Parameter GEN_INT_Intermediate {
				IndexDomain: {
					(SupplyRegion,PlantType,OwnerType,ElasticityStep,PlanYear,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0)
				}
				Definition: {
					IF (PlantType = WIWN_Element or PlantType = WIWL_Element) AND (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) - 1) <= (ECP_FYR('1') + UPPLYR(PlantType)) then
					0
					else
					sum(SliceGroup| ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr),
					UPICFC1(PlantType, ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), SupplyRegion, cyr) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr))
					endif
				}
			}
			Parameter GEN_INT {
				IndexDomain: {
					(SupplyRegion,PlantType,OwnerType,ElasticityStep,PlanYear,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0)
				}
				Definition: {
					if GEN_INT_Intermediate(SupplyRegion, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) <=0 then
					0.0001
					else
					GEN_INT_Intermediate(SupplyRegion, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)
					endif
				}
			}
			Parameter GENIMP_INT {
				IndexDomain: {
					(SupplyRegion,SupplyRegion_ALTZ,PlantType,OwnerType,ElasticityStep,PlanYear,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) and
					UPETTSW(PlantType)= 1 and 0<EPTCST(SupplyRegion, Counter_ImportRegion(SupplyRegion, SupplyRegion_ALTZ), cyr)<9999
				}
				Definition: {
					sum(SliceGroup| ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr),
					UPICFC1(PlantType, ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion), SupplyRegion, cyr) *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr))
				}
			}
			Parameter ccalc_cEXX0_INT_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) and
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion_ALT1, cyr) * 0.001
					else
					inf
					endif
				}
				Comment: "EP$INT,1";
			}
			Parameter ccalc_cEXX0_INT_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: ECPCOSTS"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					max(ECP_MIN('1'),
					(sum(FullPlanningHorizon, !PVV_Function(VOM_EXX0_INT(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr)) +
					VOM_EXX0_INT(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)) +
					!PVV_Function(FOM_EXX0_INT(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXX0_INT(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					sum(PlanYear| PlanYear=RetirementPlanYear, PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear)) - (ord(RetireGroup)-1))*
					(1.0 - UPRETFHU('1')))
					endif
					endif
				}
				Comment: "EP$INT,2";
			}
			Parameter ccalc_cEXX0_INT_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					SupplyRegion_ALT1=SupplyRegion_ALTX and ord(PlanYear)>UPRTLT('1')
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					round(EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr), 2) $ (round(EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr), 2)>ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,3";
			}
			Parameter ccalc_cEXX0_INT_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: R(*)MXRET0"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 and UPRETRAT('1')>0 then
					1
					endif
					endif
				}
				Comment: "EP$INT,4";
			}
			Parameter ccalc_cEXX0_INT_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType) $
					(abs(cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType))>= ECP_MIN('1'))
				}
				Comment: "EP$INT,5";
			}
			Parameter ccalc_cEXX0_INT_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (SR_INT(PlantType, SupplyRegion_ALT1)> 0.0 and ccalc_cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, RetireGroup)<>0) THEN
					 - 1.0 * ccalc_cEXX0_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, RetireGroup) * SR_INT(PlantType, SupplyRegion_ALT1) +
					  IF (PlantType=WIPT_Element and SR_CREDIT(PlantType)>0) THEN
					        NET_PT_STORAGE_SR_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					  endif
					endif
				}
				Comment: "EP$INT,8";
			}
			Parameter ccalc_cEXX0_INT_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1')
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup) $ (cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup)>=ECP_MIN('1'));
				Comment: "EP$INT,9";
			}
			Parameter ccalc_cEXX0_INT_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)* cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup)) $
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)>0 and (UPRNWSHRR(PlantType, SupplyRegion_ALT1)* cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup))>=ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,10";
			}
			Parameter ccalc_cEXX0_INT_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					(UPRNWSHR(PlantType)* cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup)) $
					(UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(PlantType)>0 and (UPRNWSHR(PlantType)* cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup))>=ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,11";
			}
			Parameter ccalc_cEXX0_INT_rLXXINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1')
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: L(*)XXINT(*)"
				}
				Definition: cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup) $ (UPINTSW('1')>=2 and UCPINTIS(PlantType)>0);
				Comment: "EP$INT,12";
			}
			Parameter ccalc_cEXX0_INT_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and SupplyRegion_ALT2=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!INT and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if USW_ERET('1')=1 and RET_GRP(PlantType)>0 then
					cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup) * (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0 and abs(cEXX0_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear, RetireGroup)*
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))))>=ECP_MIN('1'))
					 endif
					 endif
				}
				Comment: "EP$INT,15";
			}
			Parameter ccalc_cEXXX_INT_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) |  ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					if PlantType in Intermittent_ then
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)>1.0e-10 then
					TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)
					else
					inf
					endif
					else
					inf
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					NET_STORAGE_CAP_EX(element(Season_,EPNMSP('1',SupplyRegion_ALT1,cyr)), SupplyRegion_ALT1, cyr)
					else
					inf
					endif
				}
				Comment: {
					"EP$INT,16; CALC_STORAGE_VAL,1"
				}
			}
			Parameter ccalc_cEXXX_INT_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) |  ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: ECPCOSTS"
				}
				Definition: {
					if PlantType in Intermittent_ then
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)>1.0e-10 then
					max(ECP_MIN('1'),
					IF ord(PlanYear_ALTB)< UNXPH('1') THEN
					(FOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear_ALTB)) +
					VOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear_ALTB))) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear_ALTB)
					else
					(sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(FOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) +
					FOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))+
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr)))) *
					VOM_EXXX_INT(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon))))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear_ALTB)
					endif)
					endif
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					0.001
					endif
				}
				Comment: {
					"EP$INT,17; CALC_STORAGE_VAL,2"
				}
			}
			Parameter ccalc_cEXXX_INT_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					SupplyRegion_ALTX=SupplyRegion_ALT1 and ord(PlanYear)>1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					if PlantType in Intermittent_ and PlanYear=PlanYear_ALTB then
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)>1.0e-10 then
					EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr) $ (EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)>ECP_MIN('1'))
					endif
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					MIN(DINURAL_STORAGE_CAPACITY_CREDIT(cyr, SupplyRegion_ALTX), 1.0)
					endif
				}
				Comment: {
					"EP$INT,18; CALC_STORAGE_VAL,4"
				}
			}
			Parameter ccalc_cEXXX_INT_rRXXXXXn {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					SupplyRegion_ALTX=SupplyRegion_ALT1 and ord(PlanYear)=1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					if PlantType in Intermittent_ and PlanYear=PlanYear_ALTB then
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)>1.0e-10 then
					EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr) $ (EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)>ECP_MIN('1'))
					endif
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					MIN(DINURAL_STORAGE_CAPACITY_CREDIT(cyr, SupplyRegion_ALTX), 1.0)
					endif
				}
				Comment: {
					"EP$INT,18; CALC_STORAGE_VAL,4"
				}
			}
			Parameter ccalc_cEXXX_INT_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB);
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: R(*)MXRET0"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB)>1.0e-10 and USW_ERET('1')=1 and UPRETRAT('1')>0 and ord(PlanYear_ALTB)= UPRTLT('1') + 1 then
					1
					endif
					endif
				}
				Comment: "EP$INT,19";
			}
			Parameter ccalc_cEXXX_INT_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					if PlantType in Intermittent_ and PlanYear=PlanYear_ALTB then
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType) $
					(cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType)>= ECP_MIN('1'))
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					NET_STORAGE_LOAD_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
				}
				Comment: {
					"EP$INT,20; CALC_STORAGE_VAL,3"
				}
			}
			Parameter ccalc_cEXXX_INT_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					if PlantType in Intermittent_ and  PlanYear=PlanYear_ALTB then
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					IF (SR_INT(PlantType, SupplyRegion_ALT1)> 0.0 and ccalc_cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, PlanYear_ALTB)<>0) THEN
					 - 1.0 * ccalc_cEXXX_INT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, PlanYear_ALTB) * SR_INT(PlantType, SupplyRegion_ALT1) +
					  IF (PlantType=WIPT_Element and SR_CREDIT(PlantType)>0) THEN
					        NET_PT_STORAGE_SR_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					  endif
					endif
					endif
					endif
					elseif PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear then
					IF (SR_CREDIT(PlantType) > 0.0) THEN
					NET_STORAGE_SR_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
					endif
				}
				Comment: {
					"EP$INT,23; CALC_STORAGE_VAL,5"
				}
			}
			Parameter ccalc_cEXXX_INT_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear) $ (abs(cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear))>=ECP_MIN('1'))
					endif
				}
				Comment: "EP$INT,24";
			}
			Parameter ccalc_cEXXX_INT_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)* cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear)) $
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)>0 and (UPRNWSHRR(PlantType, SupplyRegion_ALT1)* cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear))>=ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,25";
			}
			Parameter ccalc_cEXXX_INT_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					(UPRNWSHR(PlantType)* cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear)) $
					(UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(PlantType)>0 and (UPRNWSHR(PlantType)* cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear))>=ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,26";
			}
			Parameter ccalc_cEXXX_INT_rLXXINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: L(*)XXINT(*)"
				}
				Definition: cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear) $ (UPINTSW('1')>=2 and UCPINTIS(PlantType)>0);
				Comment: "EP$INT,27";
			}
			Parameter ccalc_cEXXX_INT_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB and SupplyRegion_ALT1=SupplyRegion_ALT2
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!INT and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_INT(SupplyRegion_ALT1,PlantType,PlanYear)>1.0e-10 then
					cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear) * (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0 and abs(cEXXX_INT_rFGENge(SupplyRegion_ALT1, PlantType, PlanYear)*
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))))>=ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$INT,30";
			}
			Parameter ccalc_cRHS_rLUANNle {
				IndexDomain: (PlantType,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: LU(**)ANN(*)";
				Definition: {
					IF PlantType in Intermittent_ or PlantType in OtherRenewable_ or PlantType in NUC_Types_ or PlantType in DispatchableECP_ then
					IF (UPVTYP(PlantType)= 1) AND OLYEAR(PlanYear, PlantType) <= UNXPH('1') and
					UPAVLYR(PlantType) <= FULLYEAR_ALT(PlanYear, PlantType) and
					UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					  UPANNLMT(PlantType, OLYEAR_MNUMYR(PlanYear, PlantType))
					endif
					endif
				}
				Comment: {
					"EP$INT,31; EP$BRNW,65; EP$NUC,50; EP$BDSP,59"
				}
			}
			Parameter ccalc_cRHS_rLINTle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear) | PlantType_ALT2 in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: "OML Columns: RHSECP and OML Rows: L(*)(**)INT(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType_ALT2, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType_ALT2)= 1 AND UPBLDREG(PlantType_ALT2, SupplyRegion_ALT1)>0)) THEN
					IF ((UPVTYP(PlantType_ALT2)= 1) AND OLYEAR(PlanYear, PlantType_ALT2) <= UNXPH('1')) THEN
					if ESTSWTCH(PlantType_ALT2)>0 and PlantType_ALT2=BCAP_element(PlantType_ALT2, SupplyRegion_ALT1) and
					 UPAVLYR(PlantType_ALT2)<=FULLYEAR_ALT(PlanYear, PlantType_ALT2) then
					IF (OLYEAR(PlanYear, PlantType_ALT2) < UNXPH('1')) THEN
					        EPBLDBND(IntStor(PlantType_ALT2), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					ELSE
					        5.0 * EPBLDBND(IntStor(PlantType_ALT2), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					ENDIF
					endif
					endif
					endif
				}
				Comment: {
					"EP$INT,32
					! (EPBNDTYP(RCAP) .NE. \'Z\') condition is ignored since row type is always \'L\' and cannot =\'Z\'"
				}
			}
			Parameter ccalc_cIS_rLINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear, PlantType)=2 and PlantType_ALT2=BCAP_element(PlantType, SupplyRegion_ALT1) and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: L(*)(**)INT(*)";
				Definition: {
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					1
					endif
					endif
				}
				Comment: "EP$INT,35";
			}
			Parameter ccalc_cIX_rLINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and PlantType_ALT2=BCAP_element(PlantType, SupplyRegion_ALT1) and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: L(*)(**)INT(*)";
				Definition: {
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					IF (ESTSWTCH(PlantType) > 0) THEN
					1
					endif
					endif
					endif
				}
				Comment: {
					"EP$INT,35
					(EPBNDTYP(RCAP) .NE. \'Z\') condition is ignored since row type is always \'L\' and cannot =\'Z\'"
				}
			}
			Parameter ccalc_cIS_rLUle {
				IndexDomain: {
					(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear, PlantType)=2 and PlantType_ALT2=KCAP_element(PlantType) and PlanYear=PlanYear_ALTB and DispatchType='IN'
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: LU(**)(**)(*)(*)";
				Definition: {
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					IF (ESTSWTCH(PlantType) > 0) THEN
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,36";
			}
			Parameter ccalc_cIX_rLUle {
				IndexDomain: {
					(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and PlanYear=PlanYear_ALTB and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1')
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: LU(**)(**)(*)(*)";
				Definition: {
					if PlantType in Intermittent_ and PlantType_ALT2=KCAP_element(PlantType) and DispatchType='IN'  and UPVTYP(PlantType)= 1 then
					IF ( (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					IF (ESTSWTCH(PlantType) > 0) THEN
					1
					endif
					endif
					elseif PlantType=WIDS_Element and PlantType_ALT2= WIDS_Element and DispatchType='ST'  and ElasticityStep= '1' then
					1
					endif
				}
				Comment: "EP$INT,36 and CALC_STORAGE_VAL,12";
			}
			Parameter ccalc_cIS_rLUANNn {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear, PlantType)=2 and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: LU(**)ANN(*)";
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) > 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,38";
			}
			Parameter ccalc_cIX_rLUANNn {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: LU(**)ANN(*)";
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) > 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,38";
			}
			Parameter ccalc_cIS_rLUANNle {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear, PlantType)=2 and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: LU(**)ANN(*)";
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,38";
			}
			Parameter ccalc_cIX_rLUANNle {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: LU(**)ANN(*)";
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)) THEN
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,38";
			}
			Parameter ccalc_cIS_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB);
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: ECPCOSTS";
				Comment: {
					"EP$INT,39; EP$INT,40; Calculated in Calculate_INTBLDCOSTS"
				}
			}
			Parameter ccalc_cIX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB);
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: ECPCOSTS";
				Comment: {
					"EP$INT,39; EP$INT,40; CALC_STORAGE_VAL,8; CALC_STORAGE_VAL,9
					Calculated in Calculate_INTBLDCOSTS and Calculate_STORAGECST"
				}
			}
			Parameter ccalc_cIS_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)  | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and SupplyRegion_ALTX=SupplyRegion_ALT1
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					IF  UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF (PlantType = WIWN_Element AND (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) - 1) <= (ECP_FYR('1') + UPPLYR(PlantType))) then
					0
					elseif EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)>ECP_MIN('1') then
					EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)
					endif
					endif
				}
				Comment: "EP$INT,41";
			}
			Parameter ccalc_cIX_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)  | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and SupplyRegion_ALTX=SupplyRegion_ALT1
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if PlantType in Intermittent_  then
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF (PlantType = WIWN_Element AND (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) - 1) <= (ECP_FYR('1') + UPPLYR(PlantType))) then
					0
					elseif EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)>ECP_MIN('1') then
					EPIRCCR(IntStor(PlantType), SupplyRegion_ALT1, cyr)
					endif
					endif
					elseif PlantType=WIDS_Element and ElasticityStep=ElasticityStep1 then
					MIN(DINURAL_STORAGE_CAPACITY_CREDIT(cyr, SupplyRegion_ALT1), 1.0)
					endif
				}
				Comment: {
					"EP$INT,41; CALC_STORAGE_VAL,13"
				}
			}
			Parameter ccalc_cIS_rRUYYYYYn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: RUYYYYY(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					        1
					endif
				}
				Comment: "EP$INT,42";
			}
			Parameter ccalc_cIX_rRUYYYYYn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: RUYYYYY(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					        1
					endif
				}
				Comment: "EP$INT,42";
			}
			Parameter ccalc_cIS_rTOTBLDn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear, PlantType)=2 and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: TOTBLD(*)(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					        1
					endif
				}
				Comment: "EP$INT,43";
			}
			Parameter ccalc_cIX_rTOTBLDn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: TOTBLD(*)(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					        1
					endif
				}
				Comment: "EP$INT,43";
			}
			Parameter ccalc_cIS_rLBLDXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND Subsidy_Case(PlanYear_ALTB, PlantType)=2 and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and PlantType_ALT2=LCAP_element(PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: L(*)(**)BLDX";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND
					        UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0 and
					        UPBLDREG_us00(LCAP_element(PlantType))<999 THEN
					        1
					endif
				}
				Comment: "EP$INT,46";
			}
			Parameter ccalc_cIS_rLUBLDXle {

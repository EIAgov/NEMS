				0.0000005 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *

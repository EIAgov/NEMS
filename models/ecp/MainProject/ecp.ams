					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType),
					coeff_cEMRX_RNW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,RetireGroup),
					coeff_cEXX0_INT_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) *
					      cEXX0_INT(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((SupplyRegion_ALT1,PlantType,RetireGroup),
					coeff_cEXX0_RNW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_INT_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_RNW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1),
					coeff_cGUDGPV_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1) *
					      cGUDGPV(SupplyRegion_ALT1,PlanYear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cGURNXX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1) *
					      cGURNXX(SupplyRegion_ALT1,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType),
					coeff_cGXXX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType) *
					      cGXXX(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment),
					coeff_cH_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType),
					coeff_cIGEN_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType) *
					      cIGEN(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cJM_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cJMR_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cJX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cJXX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cM_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rGURNWXge(SupplyRegion_ALTY,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rGURNWXge(SupplyRegion_ALTY,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment),
					coeff_cO_HYD_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cOMR_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cOXX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cUM_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cUMR_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cUX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,Seasonx),
					coeff_cUXX_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,Seasonx) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber),
					coeff_cW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cZMrnw_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cZXrnw_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					>=
					
					0.
				}
				Comment: "accumulate RPS generation for national constraint by EMM region and planning year (if relevant) (bkwh)";
			}
			Constraint rGURNWXXge {
				IndexDomain: (PlanYear);
				Text: "OML Rows: GURNWXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType),
					coeff_cEBAS_rGURNWXXge(PlanYear,SupplyRegion_ALT1,PlantType) *
					      cEBAS(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cGCRRNW_rGURNWXXge(PlanYear,SupplyRegion_ALT1) *
					      cGCRRNW(SupplyRegion_ALT1,PlanYear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion_ALT1) *
					      cGELXXX(SupplyRegion_ALT1,PlanYear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cGUCGRN_rGURNWXXge(PlanYear,SupplyRegion_ALT1) *
					      cGUCGRN(SupplyRegion_ALT1,PlanYear))
					+
					coeff_cGUCRRNW_rGURNWXXge(PlanYear) *
					      cGUCRRNW(PlanYear)
					+
					sum((SupplyRegion_ALT1),
					coeff_cGURNXX_rGURNWXXge(PlanYear,SupplyRegion_ALT1) *
					      cGURNXX(SupplyRegion_ALT1,PlanYear))
					+
					coeff_cRNWGENU_rGURNWXXge(PlanYear) *
					      cRNWGENU(PlanYear)
					
					>=
					
					0.
				}
				Comment: "national RPS constraint if in place (bkwh)";
			}
			Constraint rHCOFeq {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear);
				Text: "OML Rows: H(*)(*)(*)COF(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBCOF_rHCOFeq(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,PlanYear_ALTB) *
					      cBCOF(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB))
					
					=
					0.
				}
				Comment: {
					"capacity balance row for biomass retrofits by coal demand region, coal demand region, biomass cofiring retrofit category (GW)!equality not used but cr"
				}
			}
			Constraint rHCOFle {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear);
				Text: "OML Rows: H(*)(*)(*)COF(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBCOF_rHCOFle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,PlanYear_ALTB) *
					      cBCOF(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB))
					+
					coeff_cECOF_rHCOFle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear) *
					      cECOF(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear)
					+
					sum((FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber),
					coeff_cW_rHCOFle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					<=
					
					0.
				}
				Comment: "capacity balance row for biomass retrofits by coal demand region, coal demand region, biomass cofiring retrofit category (GW)";
			}
			Constraint rHCSHle {
				IndexDomain: (CoalDemandRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: H(*)(**)CSH(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rHCSHle(CoalDemandRegion_ALT1,PlantType,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber),
					coeff_cW_rHCSHle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					<=
					
					0.
				}
				Comment: "limit biomass cofiring share in coal palnts by coal demand region, plant type (coal), and planning year (trillion Btu)";
			}
			Constraint rKge {
				IndexDomain: (CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear);
				Text: "OML Rows: K(**)(**)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cK_rKge(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear) *
					      cK(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rKge(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rKge(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rKge(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					>=
					
					coeff_cRHS_rKge(CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)
				}
				Comment: "enforce coal contracts by Coal type, coal supply curve, coal demand region, scrub or unscrub, and planning year (trillion Btu * 0.1)";
			}
			Constraint rKHY_le {
				IndexDomain: (SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: K(*)(**)(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEMRX_RNW_rKHY_le(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					coeff_cH_rKHY_le(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear)
					
					<=
					
					0.
				}
				Comment: "require use of must-run hydro capacity  by EMM region, hydro plant type, season, load group, load segment, and planning year (GW)";
			}
			Constraint rLBLDXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2);
				Text: "OML Rows: L(*)(**)BLDX";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLBLDXle(SupplyRegion_ALT1,PlantType_ALT2)
				}
				Comment: "impose regional build limit option (if used) by EMM region and plant type (GW)";
			}
			Constraint rLDGXXle {
				IndexDomain: (SupplyRegion_ALT1,DistGenAvoidStep,PlanYear);
				Text: "OML Rows: L(*)DGXX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBSDGN_rLDGXXle(SupplyRegion_ALT1,DistGenAvoidStep,PlanYear,PlantType,OwnerType,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBX_DGN_rLDGXXle(SupplyRegion_ALT1,DistGenAvoidStep,PlanYear,PlantType,OwnerType,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLDGXXle(SupplyRegion_ALT1,DistGenAvoidStep,PlanYear)
				}
				Comment: "limit distributed generation builds by EMM region, DG supply step, and planning year (GW)";
			}
			Constraint rLEL2cange {
				IndexDomain: (CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: {
					"OML Rows: L(*)EL(*)(*)(*)(*)!can"
				}
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALTa),
					coeff_cTELCAN_rLEL2cange(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) *
					      cTELCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTa),
					coeff_cTSRCAN_rLEL2cange(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) *
					      cTSRCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					+
					sum((ImportStep),
					coeff_cVEL_rLEL2cange(CanadianSupplyRegion,Seasonx,LoadGroup,LoadSegment,PlanYear,ImportStep) *
					      cVEL(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear))
					
					>=
					
					0.
				}
				Comment: "limit Canadian imports by Canadian supply region, season, load group, load segment, and planning year (GW)";
			}
			Constraint rLEL2ge {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: L(*)EL(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_c2EL_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      c2EL(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_INT_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,RetireGroup) *
					      cEXX0_INT(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_INT_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cH_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cJ_MINSR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cJM_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((PlantType),
					coeff_cJMR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cJX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((PlantType),
					coeff_cJXX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((VLoadSegment),
					coeff_cLDBLD_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,VLoadSegment) *
					      cLDBLD(SupplyRegion_ALT1,VLoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cM_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((PlantType),
					coeff_cO_HYD_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((PlantType),
					coeff_cOMR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((PlantType),
					coeff_cOXX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					coeff_cSEL_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cSEL(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTEL_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((CanadianSupplyRegion,SupplyRegion_ALTa),
					coeff_cTELCAN_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion,SupplyRegion_ALTa) *
					      cTELCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTSR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((CanadianSupplyRegion,SupplyRegion_ALTa),
					coeff_cTSRCAN_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CanadianSupplyRegion,SupplyRegion_ALTa) *
					      cTSRCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cUM_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((PlantType),
					coeff_cUMR_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cUX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((PlantType),
					coeff_cUXX_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					coeff_cXEXPRT_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cXEXPRT(SupplyRegion_ALT1,PlanYear)
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cZMrnw_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType),
					coeff_cZXrnw_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,FuelRegion_ALT1,PlantType) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					>=
					
					coeff_cRHS_rLEL2ge(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
				}
				Comment: "load requirement by EMM region, season, load group, load segment, and planning year (GW)";
			}
			Constraint rLELle {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: L(*)(*)EL(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cBELYY_rLELle(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear) *
					      cBELYY(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear)
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTEL_rLELle(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTSR_rLELle(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					coeff_cRHS_rLELle(SupplyRegion_ALT1,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear)
				}
				Comment: "limit interregional transfers between EMM regions by load group, load segment, and planning year (GW)";
			}
			Constraint rLELXXle {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear);
				Text: "OML Rows: L(*)(*)ELXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB),
					coeff_cBELXX_rLELXXle(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB) *
					      cBELXX(SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB))
					+
					coeff_cBELYY_rLELXXle(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear) *
					      cBELYY(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear)
					
					<=
					
					0.
				}
				Comment: "Annual transmission capacity constraint, both directions";
			}
			Constraint rLINTle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear);
				Text: "OML Rows: L(*)(**)INT(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLINTle(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLINTle(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLINTle(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLINTle(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLINTle(SupplyRegion_ALT1,PlantType_ALT2,PlanYear)
				}
				Comment: "Regional resource curves (GW)";
			}
			Constraint rLP_RETge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Rows: L(*)P_RET(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cLP_RET_rLP_RETge(SupplyRegion_ALT1,PlanYear) *
					      cLP_RET(SupplyRegion_ALT1,PlanYear)
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rLP_RETge(SupplyRegion_ALT1,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rLP_RETge(SupplyRegion_ALT1,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					>=
					
					coeff_cRHS_rLP_RETge(SupplyRegion_ALT1,PlanYear)
				}
				Comment: "force planned retrofits in last planning year (GW) - * row only exists for PlanYear=3 *";
			}
			Constraint rLP2XXXle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Rows: L(*)P2XXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLP2XXXle(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLP2XXXle(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_RNW_rLP2XXXle(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_RNW_rLP2XXXle(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					coeff_cXP2XXX_rLP2XXXle(SupplyRegion_ALT1,PlanYear) *
					      cXP2XXX(SupplyRegion_ALT1,PlanYear)
					
					<=
					
					coeff_cRHS_rLP2XXXle(SupplyRegion_ALT1,PlanYear)
				}
				Comment: "limit amount of P2 demand storage capacity that can be built, if allowed (GW)";
			}
			Constraint rLRENle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: L(*)(**)REN(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rLRENle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rLRENle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLRENle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLRENle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLRENle(SupplyRegion_ALT1,PlantType,PlanYear)
				}
				Comment: "limit regional builds of certain renewable plant types - those without supply steps (GW)";
			}
			Constraint rLRNeq {
				IndexDomain: (SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear);
				Text: "OML Rows: L(*)(**)RN(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,PlanYear_ALTB),
					coeff_cBSRNW_rLRNeq(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear,OwnerType,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,PlanYear_ALTB),
					coeff_cBXRNW_rLRNeq(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear,OwnerType,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					=
					0.
				}
				Comment: "limit regional builds of renewable plant types with supply steps (GW)";
			}
			Constraint rLRNle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear);
				Text: "OML Rows: L(*)(**)RN(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,PlanYear_ALTB),
					coeff_cBSRNW_rLRNle(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear,OwnerType,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,PlanYear_ALTB),
					coeff_cBXRNW_rLRNle(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear,OwnerType,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLRNle(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear)
				}
				Comment: "limit regional builds of renewable plant types with supply steps (GW)";
			}
			Constraint rLTRPSle {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear);
				Text: "OML Rows: L(*)(*)TRPS(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyState,PlantType),
					coeff_cG_rLTRPSle(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyState,PlantType) *
					      cG(SupplyState,PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment),
					coeff_cTEL_rLTRPSle(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					0.
				}
				Comment: "State RPS transfer balance constraint - trade of RPS credits must match power transfer (bill kWh)";
			}
			Constraint rLUANNle {
				IndexDomain: (PlantType,PlanYear);
				Text: "OML Rows: LU(**)ANN(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLUANNle(PlantType,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLUANNle(PlantType,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLUANNle(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLUANNle(PlantType,PlanYear)
				}
				Comment: "impose annual national build limit by plant type (GW)";
			}
			Constraint rLUBLDXle {
				IndexDomain: (PlantType_ALT2);
				Text: "OML Rows: LU(**)BLDX";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rLUBLDXle(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rLUBLDXle(PlantType_ALT2)
				}
				Comment: "LE row used only if a cumulative limit on builds by type is set - over all years (GW)";
			}
			Constraint rLUle {
				IndexDomain: (PlantType_ALT2,DispatchType,ElasticityStep,PlanYear);
				Text: "OML Rows: LU(**)(**)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,PlanYear_ALTB),
					coeff_cB_DSP_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,PlanYear_ALTB),
					coeff_cBBIO_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBSNUC_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBSRNW_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBXNUC_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cBXRNW_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,PlanYear_ALTB),
					coeff_cI_IMP_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cIS_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB),
					coeff_cIX_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((BuildType,PlantType),
					coeff_cUNP_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,BuildType,PlantType) *
					      cUNP(BuildType,PlantType,ElasticityStep,PlanYear))
					
					<=
					
					coeff_cRHS_rLUle(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear)
				}
				Comment: "short term elasticity supply steps (GW)";
			}
			Constraint rLUSUBXge {
				IndexDomain: (PlantType_ALT2);
				Text: "OML Rows: LU(**)SUBX";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rLUSUBXge(PlantType_ALT2,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+

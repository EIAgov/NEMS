			Parameter ccalc_cBSRNW_r2P2le {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIP2_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and ord(LoadSegment)=1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: 2(*)P2(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 -1
					endif
					endif
				}
				Comment: "EP$BRNW,87";
			}
			Parameter ccalc_cBXRNW_r2P2le {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIP2_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and ord(LoadSegment)=1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: 2(*)P2(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 -1
					endif
					endif
				}
				Comment: "EP$BRNW,87";
			}
			Parameter ccalc_cBSRNW_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC $
					 (EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC > ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,88";
			}
			Parameter ccalc_cBXRNW_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC $
					 (EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC > ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,88";
			}
			Parameter ccalc_cBSRNW_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) and SR_CREDIT(PlantType)>0) THEN
					 SR_CREDIT(PlantType) * (1.0 - EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC) $
					 (SR_CREDIT(PlantType) * (1.0 - EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC) > ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,91";
			}
			Parameter ccalc_cBXRNW_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and
					ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) and SR_CREDIT(PlantType)>0) THEN
					 SR_CREDIT(PlantType) * (1.0 - EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC) $
					 (SR_CREDIT(PlantType) * (1.0 - EPRSCFC(PlantType, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1, cyr) * HYDFAC) > ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,91";
			}
			Parameter ccalc_cBSRNW_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					(GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) $
					(abs(GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,92";
			}
			Parameter ccalc_cBXRNW_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					(GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) $
					(abs(GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,92";
			}
			Parameter ccalc_cBSRNW_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) $
					(abs(UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,93";
			}
			Parameter ccalc_cBXRNW_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) $
					(abs(UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,93";
			}
			Parameter ccalc_cBSRNW_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.005 AND UPRNWSHR(PlantType)> 0.0) THEN
					 IF ( 0.999999 < UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 < 1.000001) then
					1.000001
					elseif ( -ECP_MIN('1') < UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001< ECP_MIN('1')) then
					ECP_MIN('1')
					else
					UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001
					endif
					endif
					endif
					endif
				}
				Comment: "EP$BRNW,94";
			}
			Parameter ccalc_cBXRNW_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.005 AND UPRNWSHR(PlantType)> 0.0) THEN
					 IF ( 0.999999 < UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 < 1.000001) then
					1.000001
					elseif ( -ECP_MIN('1') < UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001< ECP_MIN('1')) then
					ECP_MIN('1')
					else
					UPRNWSHR(PlantType) * GEN_RNW(SupplyRegion_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001
					endif
					endif
					endif
					endif
				}
				Comment: "EP$BRNW,94";
			}
			Parameter ccalc_cBSRNW_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and SupplyRegion_ALT2=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					TMP_RCF(PlantType, SupplyRegion_ALT1) * 8.76 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0  and
					 abs(TMP_RCF(PlantType, SupplyRegion_ALT1) * 8.76 *
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)))) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,99";
			}
			Parameter ccalc_cBXRNW_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType=WIHY_Element and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and SupplyRegion_ALT2=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!RNW and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					TMP_RCF(PlantType, SupplyRegion_ALT1) * 8.76 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0  and
					 abs(TMP_RCF(PlantType, SupplyRegion_ALT1) * 8.76 *
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)))) >= ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,99";
			}
		}
		DeclarationSection EP_CARLM_Completed {
			Parameter CAR_ABOFF {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							AB_CAP_TOT(Element(MNUMYR_,M2YR(FullPlanningHorizon))) * AB_OFFSET_FRAC(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2OQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_ABOFF {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_ABOFF(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_ABOT {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						AB_COVD_EM_OTH(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_ABOT {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_ABOT(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_ABFL {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						AB_COVD_EM_FUE(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_ABFL {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_ABFL(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_ABREF {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						AB_COVD_EM_REF(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_ABREF {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_ABREF(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_ABIND {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						AB_COVD_EM_IND(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_ABIND {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_ABIND(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_ESC {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							(AB_RESERVE_P('3',Element(MNUMYR_,M2YR(FullPlanningHorizon))) * 1000.0) * UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon))) + ECP_MIN('1')
						ELSE
							CO2ESGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon))) * (44. / 12.) * UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_ESC {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_ESC(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_LIM_ALLSEC {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
					       	EMISSIONS_GOAL(Element(MNUMYR_,M2YR(FullPlanningHorizon))) - EMRSC('11','01',Element(MNUMYR_,M2YR(FullPlanningHorizon))) - EMCMC('11','01',Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					            		- EMINCC('11','01',Element(MNUMYR_,M2YR(FullPlanningHorizon))) - EMTRC('11','01',Element(MNUMYR_,M2YR(FullPlanningHorizon))) - EMNT('11','01',Element(MNUMYR_,M2YR(FullPlanningHorizon))) * 0.001
					
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_LIM_ALLSEC {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_LIM_ALLSEC(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CAR_LIM {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						EMISSIONS_GOAL(Element(MNUMYR_,M2YR(FullPlanningHorizon)))
					ELSE
						0
					ENDIF
				}
			}
			Parameter PVV_CAR_LIM {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CAR_LIM(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter CARBFEE {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF ((ORD(FullPlanningHorizon) + ORD(cyr) + UNXPH('1') - 2) <= UNYEAR('1')) THEN
							UPGNPD(Element(MNUMYRF_,ORD(FullPlanningHorizon) + ORD(cyr) + UNXPH('1') - 2)) *
							EMETAX('02',Element(MNUMYR_,ORD(FullPlanningHorizon) + ORD(cyr) + UNXPH('1') - 2)) * 1000.0
						ELSE
							UPGNPD(Element(MNUMYRF_,ORD(FullPlanningHorizon) + ORD(cyr) + UNXPH('1') - 2)) *
							EMETAX('02',Element(MNUMYR_,UNYEAR('1'))) * 1000.0 *
							UPCARGRW('1') ^ ( ORD(FullPlanningHorizon) + ORD(cyr) + UNXPH('1') - 2 - UNYEAR('1')	)
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_CARBFEE {
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(CARBFEE(FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_LIM {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							AB_CAP_TOT(Element(MNUMYR_,M2YR(FullPlanningHorizon))) -
							(AB_CAP_TOT(Element(MNUMYR_,M2YR(FullPlanningHorizon))) * AB_CSTCONT_FRAC(Element(MNUMYR_,M2YR(FullPlanningHorizon))))
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon))) -
							CO2EQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSEIF (CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon))) > 0) THEN
							CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REGION_LIM {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_LIM(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_AUC {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							(AB_AUCTION_P(Element(MNUMYR_,M2YR(FullPlanningHorizon))) * 1000.0) * UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ELSEIF (CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon))) > 0.0) THEN
							CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
							* UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_AUC {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_AUC(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_RSV {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2RQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_RSV {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_RSV(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_RSVCOST {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1') AND (AB_CSTCONT_AVL(cyr) > 0.0)) THEN
							(AB_RESERVE_P('2',Element(MNUMYR_,M2YR(FullPlanningHorizon))) * 1000.0) * UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2RPGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))* UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_RSVCOST {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_RSVCOST(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_ECR {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2EQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_ECR {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_ECR(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter REGION_ECRCOST {
				IndexDomain: (CarbonRegion,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
						IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2EPGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,M2YR(FullPlanningHorizon)))* UPGNPD(Element(MNUMYRF_,M2YR(FullPlanningHorizon)))
						ELSE
							0
						ENDIF
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_REG_ECRCOST {
				IndexDomain: CarbonRegion;
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(REGION_ECRCOST(CarbonRegion,FullPlanningHorizon) )/
					(1 + AVGDCR) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter ccalc_cCAROTHX_ECPCOSTS {
				IndexDomain: (PlanYear);
				Text: "OML Columns: CAROTHX(*) and OML Rows: ECPCOSTS";
				Definition: ECP_MIN('1');
			}
			Parameter ccalc_cCAROTHX_LBOUND {
				IndexDomain: (PlanYear);
				Text: "OML Columns: CAROTHX(*) and OML Rows: LBOUND";
				Definition: ECP_OCAR(Element(MNUMYR_,MYR(PlanYear)));
			}
			Parameter ccalc_cCAROTHX_rEUCARXXn {
				IndexDomain: (PlanYear)| CarbonNationalCap(PlanYear) = 0;
				Text: "OML Columns: CAROTHX(*) and OML Rows: EUCARXX(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCAROTHX_rEUCARXXle {
				IndexDomain: (PlanYear) | CarbonNationalCap(PlanYear) = 1;
				Text: "OML Columns: CAROTHX(*) and OML Rows: EUCARXX(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCAROTHX_UBOUND {
				IndexDomain: (PlanYear);
				Text: "OML Columns: CAROTHX(*) and OML Rows: UBOUND";
				Range: free;
				Default: inf;
				Definition: ECP_OCAR(Element(MNUMYR_,MYR(PlanYear)));
			}
			Parameter ccalc_cCARBONX_ECPCOSTS {
				IndexDomain: (PlanYear);
				Text: "OML Columns: CARBONX(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (USW_CAR('1') = 1 OR USW_CAR('1') = 3 AND (MYR(PlanYear)+ UHBSYR('1') >= UYR_CAR('1') )) THEN
						IF (ELEC_FLAG('1') = 1 OR PERMIT_FLAG('1')=1) THEN !OR MARKET_FLAG) THEN
							1000.0
						ELSEIF (ETAX_FLAG('1') = 1) THEN
							EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) * 1000.0 * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
					               (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
					        ELSE
					        	0.0001
					        ENDIF
					ELSEIF ((USW_CAR('1') = 0 OR USW_CAR('1') = 2)  AND (EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) > 0.0) AND (TAX_FLAG('1') = 1 OR PERMIT_FLAG('1')=1)) THEN  !tax case
						IF (ORD(PlanYear) < UNXPH('1')) THEN
							IF ((ORD(PlanYear) + ORD(cyr) -1) <= UNYEAR('1')) THEN
								EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) * 1000.0 * UPGNPD(element(MNUMYRF_,ORD(CYR)+ORD(PlanYear)-1)) *
					              		(1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
					              	ELSE
								EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) * 1000.0 * UPGNPD(element(MNUMYRF_,ORD(CYR)+ORD(PlanYear)-1)) *
					              		 UPCARGRW('1')^(ORD(PlanYear) + ORD(cyr) -1 - UNYEAR('1')) * (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
					              	ENDIF
					        ELSE
					        	PVV_CARBFEE * (1.0 + AVGDCR)^(-1.0 * (UNXPH('1')-1))
					        ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cCARBONX_rEUCARXXle {
				IndexDomain: (PlanYear) |  CarbonNationalCap(PlanYear) = 1;
				Text: "OML Columns: CARBONX(*) and OML Rows: EUCARXX(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cCARBONX_UBOUND {
				IndexDomain: (PlanYear);
				Text: "OML Columns: CARBONX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (USW_CAR('1') = 1 OR USW_CAR('1') = 3 AND (MYR(PlanYear)+ UHBSYR('1') >= UYR_CAR('1') )) THEN
						IF (ELEC_FLAG('1') = 1 OR PERMIT_FLAG('1')=1) THEN !OR MARKET_FLAG) THEN
							.001
					        ELSE
					        	1000.0
					        ENDIF
					ELSEIF ((USW_CAR('1') = 0 OR USW_CAR('1') = 2)  AND (EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) > 0.0) AND (TAX_FLAG('1') = 1 OR PERMIT_FLAG('1')=1)) THEN  !tax case
						1000.0
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cCARLM_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear)| CarbonRegionCap(CarbonRegion,PlanYear) = 1;
				Text: "OML Columns: CARLM(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							(AB_AUCTION_P(Element(MNUMYR_,MYR(PlanYear))) * 1000.0) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
							 (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
					
						ELSEIF (CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) > 0.0) THEN
							CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
							(1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
						ELSE
							0
						ENDIF
					ELSE
						PVV_REG_AUC(CarbonRegion)
					ENDIF
					
					
					
					! didn't implement MAX(ECP_MIN... ) - only if not CA??
					
					!               IF (GRP .EQ. CARGRP_CA)THEN
					!                  CALL CVAL(COLUMN,UPOBJ,PV_AUC,COLUMN_mask,UPOBJ,'EP$CARLM,17')
					!               ELSE
					!                  CALL CVAL(COLUMN,UPOBJ,MAX(ECP_MIN,PV_AUC),COLUMN_mask,UPOBJ,'EP$CARLM,18')
					!               END IF
					!
				}
			}
			Parameter ccalc_cCARLM_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear) | CarbonRegionCap_ALT(CarbonRegion,PlanYear) = 1;
				Text: "OML Columns: CARLM(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: -1;
			}
			Parameter ccalc_cCARLM_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CARLM(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							AB_CAP_TOT(Element(MNUMYR_,MYR(PlanYear))) -
							(AB_CAP_TOT(Element(MNUMYR_,MYR(PlanYear))) * AB_CSTCONT_FRAC(Element(MNUMYR_,MYR(PlanYear))))
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) -
							CO2EQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
						ELSE
							IF (CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) > 0) THEN
								CO2BYGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
							ELSE
								inf
							ENDIF
						ENDIF
					ELSE
						IF (PVV_REGION_LIM(CarbonRegion) > 0) THEN
							PVV_REGION_LIM(CarbonRegion) / PVV_KW1
						ELSE
							inf
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rEUCARXXle {
				IndexDomain: (PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: EUCARXX(*)";
				Definition: {
					IF (USW_CAR('1') = 1 OR USW_CAR('1') = 3 AND (MYR(PlanYear)+ UHBSYR('1') >= UYR_CAR('1') )) THEN
					
						IF (ELEC_FLAG('1') = 1) THEN
							IF (ORD(PlanYear) < UNXPH('1')) THEN
								EMISSIONS_GOAL(Element(MNUMYR_,MYR(PlanYear)))
							ELSE
								PVV_CAR_LIM / PVV_KW1
							ENDIF
					    ELSEIF (PERMIT_FLAG('1') = 1)  THEN !.OR. MARKET_FLAG
					            IF (ORD(PlanYear) < UNXPH('1')) THEN
					        		EMISSIONS_GOAL(Element(MNUMYR_,MYR(PlanYear))) - EMRSC('11','01',Element(MNUMYR_,MYR(PlanYear))) - EMCMC('11','01',Element(MNUMYR_,MYR(PlanYear)))
					        		- EMINCC('11','01',Element(MNUMYR_,MYR(PlanYear))) - EMTRC('11','01',Element(MNUMYR_,MYR(PlanYear))) - EMNT('11','01',Element(MNUMYR_,MYR(PlanYear))) * 0.001
					        	ELSE
					        		PVV_CAR_LIM_ALLSEC / PVV_KW1
					        	ENDIF
					        ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cCARBK_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARBK(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (AB_ALLBANK_AVL(cyr - 1) > 0.0) THEN
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						(AB_AUCTION_P(Element(MNUMYR_,MYR(PlanYear))) * 1000.0) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
						 (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear)) + (2.0 * ECP_MIN('1'))
					ELSE
						PVV_REG_AUC(CarbonRegion)+ (2.0 * ECP_MIN('1'))
					ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cCARBK_rEUBNKle {
				IndexDomain: (CarbonRegion,PlanYear)| ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARBK(**)(*) and OML Rows: EUBNK(**)X";
				Definition: {
					IF (AB_ALLBANK_AVL(cyr - 1) > 0.0) THEN
						1
					ENDIF
				}
			}
			Parameter ccalc_cCARBK_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)| ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARBK(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					IF (AB_ALLBANK_AVL(cyr - 1) > 0.0) THEN
						-1
					ENDIF
				}
			}
			Parameter ccalc_cCARRS_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CARRS(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							IF (AB_CSTCONT_AVL(cyr) > 0.0)THEN
							(AB_RESERVE_P('2',Element(MNUMYR_,MYR(PlanYear))) * 1000.0) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
							 (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
							 ENDIF
					
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2RPGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))* UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
							(1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
						ELSE
							0
						ENDIF
					ELSE
						PVV_REG_RSVCOST(CarbonRegion)
					ENDIF
				}
			}
			Parameter ccalc_cCARRS_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CARRS(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
						IF (AB_CSTCONT_AVL(cyr) > 0.0)THEN
							-1.0
						ENDIF
					ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
						-1.0
					ELSE
						0.0
					ENDIF
				}
			}
			Parameter ccalc_cCARRS_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CARRS(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
						IF (ORD(PlanYear) < UNXPH('1')) THEN
							CO2RQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
						ELSE
							PVV_REG_RSV(CarbonRegion) / PVV_KW1
						ENDIF
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cCARRS_rEURSVle {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CARRS(**)(*) and OML Rows: EURSV(**)X";
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
						IF (AB_CSTCONT_AVL(cyr) > 0.0)THEN
							1.0
						ENDIF
					ELSE
						0.0
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rEUBNKle {
				IndexDomain: (CarbonRegion)| ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: RHSECP and OML Rows: EUBNK(**)X";
				Definition: {
					IF (AB_ALLBANK_AVL(cyr - 1) > 0.0) THEN
						AB_ALLBANK_AVL(cyr - 1)
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rEURSVle {
				IndexDomain: (CarbonRegion);
				Text: "OML Columns: RHSECP and OML Rows: EURSV(**)X";
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
						IF (AB_CSTCONT_AVL(cyr) > 0.0)THEN
							AB_CSTCONT_AVL(cyr)
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cCARES_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear)| CarbonRegionCap(CarbonRegion,PlanYear) = 1;
				Text: "OML Columns: CARES(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (CO2ESGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),cyr) * SCALPR('1') < 9000.0) THEN
					    IF (ORD(PlanYear) < UNXPH('1')) THEN
					    	IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
					    		(AB_RESERVE_P('3',Element(MNUMYR_,MYR(PlanYear))) * 1000.0) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
					    		(1.0 + AVGDCR)^(-1.0 * ORD(PlanYear)) + ECP_MIN('1')
						ELSE
							CO2ESGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) * (44. / 12.)
							* UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) * (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
					    	ENDIF
					    ELSE
					    	PVV_REG_ESC(CarbonRegion)
					    ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cCARES_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)| CarbonRegionCap(CarbonRegion,PlanYear) = 1;
				Text: "OML Columns: CARES(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cCARIN_LBOUND {
				IndexDomain: (CarbonRegion,PlanYear) |ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARIN(**)(*) and OML Rows: LBOUND";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_IND(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABIND / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCARIN_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARIN(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCARIN_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARIN(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_IND(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABIND / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCARFL_LBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARFL(**)(*) and OML Rows: LBOUND";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_FUE(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABFL / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCARFL_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARFL(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCARFL_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARFL(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_FUE(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABFL / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCAROF_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1') OR ORD(CarbonRegion) = CARGRP_RG('1');
				Text: "OML Columns: CAROF(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
						  (AB_AUCTION_P(Element(MNUMYR_,MYR(PlanYear))) * 1000.0) * UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) *
						 (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear)) +  ECP_MIN('1')
						ELSEIF (CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear))) > 0.0) THEN
							CO2FLGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
							* UPGNPD(Element(MNUMYRF_,ORD(PlanYear) + ORD(cyr)- 1)) * (1.0 + AVGDCR)^(-1.0 * ORD(PlanYear)) +  ECP_MIN('1')
						 ELSE
						 	0.0
						 ENDIF
					ELSE
						PVV_REG_AUC(CarbonRegion)+ ECP_MIN('1')
					ENDIF
				}
			}
			Parameter ccalc_cCAROF_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1') OR ORD(CarbonRegion) = CARGRP_RG('1');
				Text: "OML Columns: CAROF(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cCAROF_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear)| CarbonRegionCap(CarbonRegion,PlanYear) = 1;
				Text: "OML Columns: CAROF(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
							AB_CAP_TOT(Element(MNUMYR_,MYR(PlanYear))) * AB_OFFSET_FRAC(Element(MNUMYR_,MYR(PlanYear)))
						ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2OQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
						ENDIF
					ELSE
						PVV_CAR_ABOFF(CarbonRegion) / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCAROT_LBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CAROT(**)(*) and OML Rows: LBOUND";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_OTH(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABOT / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCAROT_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CAROT(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCAROT_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CAROT(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_OTH(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABOT / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCARRF_LBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARRF(**)(*) and OML Rows: LBOUND";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_REF(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABREF / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCARRF_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARRF(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cCARRF_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear)|ORD(CarbonRegion) = CARGRP_CA('1');
				Text: "OML Columns: CARRF(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						AB_COVD_EM_REF(Element(MNUMYR_,MYR(PlanYear)))
					ELSE
						PVV_CAR_ABREF / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCAREC_ECPCOSTS {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CAREC(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
							CO2EPGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))* UPGNPD(Element(MNUMYRF_,CURIYR('1') + ORD(PlanYear) - 1)) *
							(1.0 + AVGDCR)^(-1.0 * ORD(PlanYear))
						ELSE
							0
						ENDIF
					ELSE
						PVV_REG_ECRCOST(CarbonRegion) / PVV_KW1
					ENDIF
				}
			}
			Parameter ccalc_cCAREC_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CAREC(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
						-1.0
					ELSE
						0.0
					ENDIF
				}
			}
			Parameter ccalc_cCAREC_UBOUND {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Columns: CAREC(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
						IF (ORD(PlanYear) < UNXPH('1')) THEN
							CO2EQGRP(Element(CO2CapGroup_,ORD(CarbonRegion)),Element(MNUMYR_,MYR(PlanYear)))
						ELSE
							PVV_REG_ECR(CarbonRegion) / PVV_KW1
						ENDIF
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cCARI_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,CarbonRegion,PlanYear) | CO2_IM_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARI(*)(**)(*) and OML Rows: LBOUND";
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					KWH_IM_BY_RG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KWH_IM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					KWH_IM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
				Comment: "EP$CARLM,30";
			}
			Parameter ccalc_cCARI_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,CarbonRegion,PlanYear) | CO2_IM_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARI(*)(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					KWH_IM_BY_RG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KWH_IM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					KWH_IM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
				Comment: "EP$CARLM,30";
			}
			Parameter ccalc_cCARI_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear,SupplyRegion_ALT1) | CO2_IM_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARI(*)(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					if ord(CarbonRegion)=CARGRP_CA('1') then
					if ord(PlanYear)<UNXPH('1') then
					CO2_IM_BY_CA(LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CO2_IM_BY_CA(LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					CO2_IM_BY_CA(LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
					else
					CO2_IM_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					endif
				}
				Comment: "EP$CARLM,31";
			}
			Parameter ccalc_cCARD_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,CarbonRegion,PlanYear) | CO2_DF_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARD(*)(**)(*) and OML Rows: LBOUND";
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					KWH_DM_BY_RG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KWH_DM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					KWH_DM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
				Comment: "EP$CARLM,34";
			}
			Parameter ccalc_cCARD_rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear,SupplyRegion_ALT1) | CO2_DF_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARD(*)(**)(*) and OML Rows: EUCAR(**)(*)";
				Definition: {
					if ord(CarbonRegion)=CARGRP_CA('1') then
					if ord(PlanYear)<UNXPH('1') then
					CO2_DF_BY_CA(LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CO2_DF_BY_CA(LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					CO2_DF_BY_CA(LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
					else
					CO2_DF_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))
					endif
				}
				Comment: "EP$CARLM,35";
			}
			Parameter ccalc_cCARD_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,CarbonRegion,PlanYear) | CO2_DF_BY_RG(SupplyRegion_ALT1, CO2CapGroup_element(CarbonRegion))>0;
				Text: "OML Columns: CARD(*)(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					KWH_DM_BY_RG(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KWH_DM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+2)),ord(FullPlanningHorizon),AVGDCR)) /
					KWH_DM_BY_RG(SupplyRegion_ALT1, LastModelYear_MNUMYR2(FullPlanningHorizon+(UNXPH('1')-1))) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(KW_ALT(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
					KW_ALT(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
				Comment: "EP$CARLM,34";
			}
		}
		DeclarationSection EP_CCAP_Completed {
			Parameter ONEVAL {
				IndexDomain: PlanYear;
			}
			Parameter OBJTRN2 {
				IndexDomain: (CensusRegion,FullPlanningHorizon);
				Definition: {
					IF (CURIYR('1')+Year_FullPlanningHorizon(FullPlanningHorizon)+UHBSYR('1')-1 <= I_45Q_LYR_NEW('1') AND ord(FullPlanningHorizon)-2 <= I_45Q_DURATION('1') AND RUN45Q > 0) THEN
					        UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * CO2_PRC_DIS_45Q(CensusRegion,LastModelYear_MNUMYR2(FullPlanningHorizon))
					ELSE
					        UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) *  CO2_PRC_DIS_NTC(CensusRegion,LastModelYear_MNUMYR2(FullPlanningHorizon))
					ENDIF
					
					!removed previous MUST_STORE conditions - assumes always =1 and must store CO2
				}
			}
			Parameter ccalc_cNTX_rZCSRGeq {
				IndexDomain: (CensusRegion,PlanYear) | CensusRegion <> '10' and CensusRegion <> '11';
				Text: "OML Columns: NTX(**)__(*) and OML Rows: ZCSRG(**)(*)";
				Definition: {
					!if MUST_STORE(FuelRegion, element(MNUMYRF_, MIN(CURIYR('1') + UNFPH('1') - 1, UNYEAR('1')))) then
					-1
					!endif
					
					! get rid of MUST_STORE for CCATS - only use equality
				}
				Comment: "EP$CCAP,15";
			}
			Parameter ccalc_cNTX_rZCSRGge {
				IndexDomain: (CensusRegion,PlanYear) | CensusRegion <> '10' and CensusRegion <> '11';
				Text: "OML Columns: NTX(**)__(*) and OML Rows: ZCSRG(**)(*)";
				Definition: {
					
					! get rid of MUST_STORE for CCATS - only use equality
				}
				Comment: "EP$CCAP,15";
			}
			Parameter ccalc_cNTX_ECPCOSTS {
				IndexDomain: (CensusRegion,PlanYear) | CensusRegion <> '10' and CensusRegion <> '11';
				Text: "OML Columns: NTX(**)__(*) and OML Rows: ECPCOSTS";
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					OBJTRN2(CensusRegion, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(OBJTRN2(FuelRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
					OBJTRN2(CensusRegion, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,Year)(PlanYear)
					endif
				}
				Comment: "EP$CCAP,16";
			}
		}
		DeclarationSection EP_CF_Completed {
			Parameter ccalc_cHGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: H(*)(**)GEN(*) and OML Rows: ECPCOSTS";
				Definition: -0.0001;
			}
			Parameter ccalc_cHGEN_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: H(*)(**)GEN(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cHSAF_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: H(*)(**)SAF(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					 1000.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ELSE
					 2000.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cHSAF_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: H(*)(**)SAF(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: 1.0;
			}
		}
		DeclarationSection EP_CFMIN_Completed {
			Parameter CFRHS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)|ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					    UPCFGEN(LastModelYear_MNUMYR(PlanYear),SupplyRegion_ALT1)
					 ELSE
					    PVV_GEN(SupplyRegion_ALT1) / PVV_ONE(SupplyRegion_ALT1)
					 ENDIF
				}
			}
			Parameter PVV_GEN {
				IndexDomain: (SupplyRegion_ALT1)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Definition: SUM(FullPlanningHorizon,(GEN(SupplyRegion_ALT1,FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ORD(FullPlanningHorizon)));
			}
			Parameter GEN {
				IndexDomain: (SupplyRegion_ALT1,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					   UPCFGEN(LastModelYear_MNUMYR2(FullPlanningHorizon),SupplyRegion_ALT1)
					ELSE
					   0.0
					ENDIF
				}
			}
			Parameter ccalc_cRCFGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: R(*)CFGEN(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (CFRHS(SupplyRegion_ALT1,PlanYear) > 0) THEN
					  2000.0
					ENDIF
				}
			}
			Parameter ccalc_cRCFGEN_rGCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: R(*)CFGEN(*) and OML Rows: G(*)CFGEN(*)";
				Definition: {
					IF (CFRHS(SupplyRegion_ALT1,PlanYear) > 0) THEN
					  1.0
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rGCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)  |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: RHSECP and OML Rows: G(*)CFGEN(*)";
				Definition: CFRHS(SupplyRegion_ALT1,PlanYear);
			}
			Parameter ccalc_cSCFGEN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: S(*)CFGEN(*) and OML Rows: ECPCOSTS";
				Definition: -.0001;
			}
			Parameter ccalc_cSCFGEN_rFCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: S(*)CFGEN(*) and OML Rows: F(*)CFGEN(*)";
				Definition: -1.0;
			}
		}
		DeclarationSection EP_COAL_Completed {
			Parameter ccalc_cNNGCL_rNGCLCFge {
				IndexDomain: (CoalGroup,PlanYear_ALTB,CommitYear);
				InitialData: 0;
			}
			Parameter ccalc_cNNG_rNGCLCFge {
				IndexDomain: (CoalGroup,PlanYear_ALTB);
				InitialData: 0;
			}
			Parameter I_PWR {
				IndexDomain: PlanYear;
				Definition: sum(PlanYear_ALTB| PlanYear_ALTB<=PlanYear and UCL_VIN(ExplicitPlanningHorizon_element(PlanYear_ALTB)),1 );
			}
			Parameter IFRST {
				IndexDomain: PlanYear;
				Definition: {
					if UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))=0 or ord(PlanYear)=1 then
					  1
					elseif UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))>UCL_VIN(ExplicitPlanningHorizon_element(PlanYear)-1) then
					  1
					endif
				}
			}
			Parameter CGRP {
				IndexDomain: PlanYear;
				Definition: {
					if UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))=0 or ord(PlanYear)=1 then
					  CGRP(PlanYear-1)+1
					elseif UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))>UCL_VIN(ExplicitPlanningHorizon_element(PlanYear)-1) then
					  CGRP(PlanYear-1)+1
					endif
				}
			}
			ElementParameter CGRP_Element {
				IndexDomain: PlanYear;
				Range: PlanYear_;
				Definition: element(PlanYear_, CGRP(PlanYear));
			}
			ElementParameter L_YR {
				Range: PlanYear_;
				Definition: {
					min(PlanYear,
					 if UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))>0 and
					UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))=UCL_VIN(UNXPH_Element) then
					  PlanYear
					endif)
				}
			}
			ElementParameter F_YR {
				Range: PlanYear_;
				Definition: {
					min(PlanYear,
					 if UCL_VIN(ExplicitPlanningHorizon_element(PlanYear))=1 then
					  PlanYear
					endif)
				}
			}
			Parameter BYR {
				IndexDomain: PlanYear;
				Definition: {
					IF ord(PlanYear)<UNXPH('1') THEN
					   CURIYR('1') + ord(PlanYear) - 1
					ELSE
					   CURIYR('1') + UNFPH('1') - 1
					ENDIF
				}
			}
			Parameter HG_TST {
				IndexDomain: (CoalConfiguration,PlanYear);
			}
			Parameter AYR {
				Definition: ECP_FYR('1') + 1 - UHBSYR('1');
			}
			Parameter AGE {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Definition: BYR(PlanYear) + UHBSYR('1') - ECL_YR(CoalGroup_SUB);
			}
			Parameter UPCCSSYR {
				Definition: 0;
			}
			Parameter NYR {
				IndexDomain: PlanYear;
				Definition: {
					if ord(PlanYear)=UNXPH('1') then
					  1 + UNFPH('1') - UNXPH('1')
					else
					  1
					endif
				}
			}
			ElementParameter ECPt_FROM {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: PlantType_;
				Definition: {
					element(PlantType_,
					UCL_ECP(element(CoalConfiguration_,ECL_RCFG(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB))));
				}
			}
			ElementParameter ECPt_TO {
				IndexDomain: CoalConfiguration;
				Range: PlantType_;
				Definition: element(PlantType_, UCL_ECP(CoalConfiguration));
			}
			ElementParameter I_CoalConfiguration {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: CoalConfiguration_;
				Definition: element(CoalConfiguration_,ECL_RCFG(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB));
			}
			ElementParameter I_CNFG {
				IndexDomain: CoalGroup_SUB;
				Range: CoalConfiguration_;
				Definition: {
					if ECL_RCFG(ExplicitPlanningHorizon_1, CoalGroup_SUB)=0 then
					  element(CoalConfiguration_,ECL_ICFG(CoalGroup_SUB))
					else
					  element(CoalConfiguration_,ECL_RCFG(ExplicitPlanningHorizon_1, CoalGroup_SUB))
					endif
				}
			}
			ElementParameter RetrofitCFG_Element {
				IndexDomain: (PlanYear, CoalGroup, RetrofitCFG);
				Range: CoalConfiguration_;
			}
			ElementParameter IECP_CL {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
				Range: PlantType_;
				Definition: {
					if CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
					CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear) then
					if UCL_ECP(CoalConfiguration)<>EMM_CL_ECPT(CoalGroup_SUB, LastModelYear_MNUMYR(PlanYear)) and
					CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear) then
					  element(PlantType_,EMM_CL_ECPT(CoalGroup_SUB, LastModelYear_MNUMYR(PlanYear)))
					else
					  element(PlantType_,UCL_ECP(CoalConfiguration))
					endif
					endif
				}
			}
			Parameter CoalConfiguriation_MAP {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter RetrofitCombinations_MAP {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			ElementParameter I_RetrofitCombinations {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
				Range: RetrofitCombinations_;
			}
			Parameter OV_CLtNG {
				IndexDomain: (CoalGroup,PlanYear);
			}
			Parameter PLAN_TEST {
				IndexDomain: CoalGroup_SUB;
				Definition: {
					IF (ECL_RCFG(ExplicitPlanningHorizon_1, CoalGroup_SUB) <> ECL_RCFG(ExplicitPlanningHorizon_2, CoalGroup_SUB) or
					ECL_RCFG(ExplicitPlanningHorizon_1, CoalGroup_SUB) <> ECL_RCFG(ExplicitPlanningHorizon_3, CoalGroup_SUB)) THEN
					1
					endif
				}
			}
			Parameter CP_PEN {
				IndexDomain: (PlantType,CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter CP_PEN_CGCF {
				IndexDomain: (PlantType,CoalGroup_SUB,PlanYear);
			}
			Parameter HRCPEN {
				IndexDomain: (PlantType,CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter HRCPEN_CGCF {
				IndexDomain: (PlantType,CoalGroup_SUB,PlanYear);
			}
			Parameter ECP_SHR {
				IndexDomain: (PlantType, CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter ECP_SHR_CGCF {
				IndexDomain: (PlantType, CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter TECP {
				IndexDomain: (PlantType, CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration);
			}
			Parameter TECP_CGCF {
				IndexDomain: (PlantType, CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration);
			}
			Parameter TBTU_COAL {
				IndexDomain: CoalGroup_SUB;
				Definition: sum(CoalSupplyCurve_Dom, CMM_CL_BTUS(CoalSupplyCurve_Dom, CoalGroup_SUB));
			}
			Parameter TestFGD {
				IndexDomain: CoalGroup_SUB;
			}
			ElementParameter TestFGD_CNFG {
				IndexDomain: CoalGroup_SUB;
				Range: CoalConfiguration_;
			}
			Parameter Condition_COAL {
				IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter Condition_COAL_CGCF {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter CF_NewECPType {
				IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter CF_NewECPType_CGCF {
				IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter TST_NOX_COAL {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
			}

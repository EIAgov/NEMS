			}
			Constraint rEUSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear);
				Text: "OML Rows: EUSO2(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cCTLSO_rEUSO2le(CoalDemandRegion,PlanYear) *
					      cCTLSO(CoalDemandRegion,PlanYear)
					+
					sum((CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto),
					coeff_cMVS_rEUSO2le(CoalDemandRegion,PlanYear,CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto) *
					      cMVS(CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUSO2le(CoalDemandRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((FuelRegion_ALT1),
					coeff_cTRSXX_rEUSO2le(CoalDemandRegion,PlanYear,FuelRegion_ALT1) *
					      cTRSXX(FuelRegion_ALT1,PlanYear))
					
					<=
					
					coeff_cRHS_rEUSO2le(CoalDemandRegion,PlanYear)
				}
				Comment: "limit use of SO2 emissions to available allowances by Coal Demand region and planning year (thousand tons -- CSAPR)";
			}
			Constraint rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear);
				Text: "OML Rows: EUSO2X(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBNKSO2_rEUSO2Xle(SO2Region,PlanYear,PlanYear_ALTB) *
					      cBNKSO2(SO2Region,PlanYear_ALTB))
					+
					sum((PlanYear_ALTB),
					coeff_cBNKXTR_rEUSO2Xle(SO2Region,PlanYear,PlanYear_ALTB) *
					      cBNKXTR(SO2Region,PlanYear_ALTB))
					+
					coeff_cCTLSO2_rEUSO2Xle(SO2Region,PlanYear) *
					      cCTLSO2(SO2Region,PlanYear)
					+
					sum((PlantType),
					coeff_cEUSO_rEUSO2Xle(SO2Region,PlanYear,PlantType) *
					      cEUSO(PlantType,SO2Region,PlanYear))
					+
					coeff_cEUSORS_rEUSO2Xle(SO2Region,PlanYear) *
					      cEUSORS(SO2Region,PlanYear)
					
					<=
					
					coeff_cRHS_rEUSO2Xle(SO2Region,PlanYear)
				}
				Comment: "limit use of SO2 emissions to available allowances by SO2 region and planning year (thousand tons -- CAIR)";
			}
			Constraint rEUSOle {
				IndexDomain: (PlantType,SO2Region,PlanYear);
				Text: "OML Rows: EUSO(**)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEUSO_rEUSOle(PlantType,SO2Region,PlanYear) *
					      cEUSO(PlantType,SO2Region,PlanYear)
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUSOle(PlantType,SO2Region,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}

			Parameter ccalc_cI_IMP_rLEL2ge {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB);
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!IMP and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					!Done in EP_INT_Calculations procedure to save time
				}
				Comment: "EP$INT,78";
			}
			Parameter ccalc_cI_SUBIMP_rLEL2ge {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB);
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!SUBIMP and OML Rows: L(*)EL(*)(*)(*)(*)"
				}

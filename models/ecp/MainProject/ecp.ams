					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and PlantType_ALT2=LCAP_element(PlantType)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: L(*)(**)BLDX";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0 AND

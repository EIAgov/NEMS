				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!SUBIMP and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF GRD_RATS(PlantType_ALT1, SupplyRegion_ALT2)>0 THEN
					IF ( -ECP_MIN('1') < GENIMP_INT(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, PlantType_ALT1, OwnerType, ElasticityStep_ALT1, PlanYear, PlanYear_ALTB) * 0.001 *

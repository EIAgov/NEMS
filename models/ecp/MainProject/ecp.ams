			}
		}
		Set Season1_ {
			SubsetOf: Seasonmd_;
			Index: Season1;
			Definition: {
				{1,2,3}
			}
		}
		Set SlicePerSeason_ {
			Index: SlicePerSeason, SlicePerSeason_ALT1;
			Definition: {
				{1..8}
			}
		}
		Set ActiveSliceGroup_ {
			SubsetOf: SliceGroup_;
			Index: ActiveSliceGroup;
			Definition: {
				{SliceGroup | ord(SliceGroup)<=MaxSliceGroup}
			}
		}
		Parameter MaxSliceGroup {
			Range: integer;
			Definition: max((ExplicitPlanningHorizon, SupplyRegion_SUB), EPNSTP(ExplicitPlanningHorizon, SupplyRegion_SUB, cyr));
		}
		Index NaturalGasGroup1 {
			Range: NaturalGasGroup_;
		}
		Set NaturalGasGroup_SUB_ {
			SubsetOf: NaturalGasGroup_;
			Index: NaturalGasGroup_SUB;
			Definition: {
				{NaturalGasGroup |ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')}
			}
		}
		Set CoalGroup_SUB_ {
			SubsetOf: CoalGroup_;
			Index: CoalGroup_SUB;
			Definition: {
				{CoalGroup | ord(CoalGroup)<=NUM_CL('1') and ECL_RG(CoalGroup)>0}
			}
		}
		Index Scrubber_I {
			Range: Scrubber_;
		}
	}
	DeclarationSection TranslationSetRelated {
		ElementParameter MX_ISCV_Element {
			IndexDomain: CoalSupplyCurve| ord(CoalSupplyCurve)>MX_NCOALS('1');
			Range: CoalSupplyCurve_Int_;
			Definition: Element(CoalSupplyCurve_Int_, ord(CoalSupplyCurve)-MX_NCOALS('1'));
		}
		Parameter NG_CoalShare {
			IndexDomain: (FuelRegion,PlantType);
			Definition: CPCTNSH(FuelRegion,EFDFuelType_PlantType(PlantType));
		}
		ElementParameter EFDFuelType_to_PlantType {
			IndexDomain: EFDFuelType;
			Range: PlantType_;
			Definition: element(PlantType_,ord(EFDFuelType));
		}
		Parameter NG_CoalShareExist2 {
			IndexDomain: (FuelRegion,PlantType);
			Definition: {
				if CPCTNSH(FuelRegion,EFDFuelType_PlantType(PlantType))>0 Then
				   1
				endif
			}
		}
		Parameter NG_CoalShareExist {
			IndexDomain: (FuelRegion,EFDFuelType)|CPCTNSH(FuelRegion,EFDFuelType)>0;
			Definition: 1;
		}
		ElementParameter CO2CapGroup_element {
			IndexDomain: CarbonRegion;
			Range: CO2CapGroup_;
			Definition: element(CO2CapGroup_,ORD(CarbonRegion));
		}
		Parameter CarRegLim {
			IndexDomain: (CarbonRegion,PlanYear);
			Definition: {
				IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
					AB_CAP_TOT(LastModelYear_MNUMYR(PlanYear))
				ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
					CO2BYGRP(CO2CapGroup_element(CarbonRegion),LastModelYear_MNUMYR(PlanYear)) - CO2EQGRP(CO2CapGroup_element(CarbonRegion),LastModelYear_MNUMYR(PlanYear))
				ENDIF
			}
		}
		Parameter CarRegLim_ALT {
			IndexDomain: (CarbonRegion,FullPlanningHorizon);
			Definition: {
				IF (ORD(CarbonRegion) = CARGRP_CA('1')) THEN
					AB_CAP_TOT(LastModelYear_MNUMYR2(FullPlanningHorizon))
				ELSEIF (ORD(CarbonRegion) = CARGRP_RG('1')) THEN
					CO2BYGRP(CO2CapGroup_element(CarbonRegion),LastModelYear_MNUMYR2(FullPlanningHorizon)) - CO2EQGRP(CO2CapGroup_element(CarbonRegion),LastModelYear_MNUMYR2(FullPlanningHorizon))
				ENDIF
			}
		}
		Parameter PVV_CarRegLim {
			IndexDomain: (CarbonRegion,PlanYear);
			Definition: {
				IF ord(PlanYear)< UNXPH('1') THEN
				 CarRegLim_ALT(CarbonRegion, FullPlanningHorizon_PlanYear(PlanYear))
				else
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				! PVV_Function(CarRegLim_ALT(CarbonRegion, FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
				CarRegLim_ALT(CarbonRegion, FullPlanningHorizon+2) /
				((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
				endif
			}
		}
		Parameter CarbonRegionCap {
			IndexDomain: (CarbonRegion,PlanYear);
			Definition: {
				IF (CarRegLim(CarbonRegion,PlanYear) > 0 AND CarRegLim(CarbonRegion,PlanYear) < 9000.0) THEN
					1
				ELSE
					0
				ENDIF
			}
		}
		Parameter CarbonRegionCap_ALT {
			IndexDomain: (CarbonRegion,PlanYear);
			Definition: {
				IF (PVV_CarRegLim(CarbonRegion,PlanYear) > 0 AND PVV_CarRegLim(CarbonRegion,PlanYear) < 9000.0) THEN
					1
				ELSE
					0
				ENDIF
			}
		}
		Parameter CarbonNationalCap {
			IndexDomain: PlanYear;
			Definition: {
				IF (USW_CAR('1') = 1 OR USW_CAR('1') = 3 AND (MYR(PlanYear)+ UHBSYR('1') >= UYR_CAR('1') )) THEN
					1
				ELSEIF ((USW_CAR('1') = 0 OR USW_CAR('1') = 2)  AND (TAX_FLAG('1') = 1 OR PERMIT_FLAG('1') =1) AND
					(EMETAX('02',Element(MNUMYR_,MYR(PlanYear))) > 0)) THEN
					1
				ELSE
					0
				ENDIF
			}
			Comment: "flag to set if national carbon row should be active (=1) or free row (=0)";
		}
		Parameter MYR {
			IndexDomain: PlanYear;
			Definition: {
				IF (Ord(PlanYear) < UNXPH('1')) THEN
					MIN(CURIYR('1') + ORD(PlanYear) - 1,UNYEAR('1'))
				ELSE
					MIN(CURIYR('1') + UNFPH('1') - 1,UNYEAR('1'))
				ENDIF
			}
		}
		Parameter M2YR {
			IndexDomain: FullPlanningHorizon;
			Definition: MIN(CURIYR('1') + UNXPH('1') + ORD(FullPlanningHorizon) - 2 , UNYEAR('1'));
		}
		Parameter MapFuelRegion {
			IndexDomain: (PlantType,SupplyRegion);
			Definition: {
				EPNFLRG(element(CensusRegion_,UPCENSUS(PlantType,SupplyRegion)),
				        element(FuelRegion_,UPCLRG(SupplyRegion)), element(FuelRegion_,UPNGRG(SupplyRegion)),
				        element(CO2CapGroup_,UPCARG(SupplyRegion)))
			}
		}
		Parameter NucFLRG {
			IndexDomain: SupplyRegion;
			Definition: MapFuelRegion(element(PlantType_,WIAN('1')),SupplyRegion);
		}
		Parameter UPSUBTYP {
			IndexDomain: PlantType;
			Definition: {
				IF (AIMMS_GRP(PlantType) = AINU('1')) THEN
					WIAN('1')
				ELSE
					ORD(PlantType)
				ENDIF
			}
		}
		ElementParameter NUCFuelRegion {
			IndexDomain: PlantType | PlantType in NUC_Types_;
			Range: FuelRegion_;
			Definition: element(FuelRegion_, UPFLTP(PlantType, first(FuelsPerPlant)));
		}
		Parameter UPCAPD_DUM {
			IndexDomain: (MNUMYRX,PlantType);
			Text: "CAPITAL COST DEFLATOR";
		}
		Parameter UPGNPD_DUM {
			IndexDomain: (MNUMYRF);
			Text: "GNP DEFLATOR";
		}
		ElementParameter OperatingMode_element {
			IndexDomain: SliceGroup;
			Range: OperatingMode_;
			Definition: Element(OperatingMode_,ORD(SliceGroup));
		}
		ElementParameter SlicePerSeason_element {
			IndexDomain: OperatingMode;
			Range: SlicePerSeason_;
			Definition: Element(SlicePerSeason_,ORD(OperatingMode));
		}
		ElementParameter Slice_element {
			IndexDomain: (OperatingMode,Season, SupplyRegion_ALT1) | ord(OperatingMode)<=NSTP(Season, SupplyRegion_ALT1) and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr);
			Range: SlicePerSeason_;
			Definition: Element(SlicePerSeason_,NSTP(Season, SupplyRegion_ALT1)-ORD(OperatingMode)+1);
		}
		ElementParameter Slice_elementx {
			IndexDomain: (OperatingMode,Seasonx, SupplyRegion_ALT1) | ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_ALT1, cyr);
			Range: SlicePerSeason_;
			Definition: Element(SlicePerSeason_,NSTP(Season_elementx(Seasonx, SupplyRegion_ALT1), SupplyRegion_ALT1)-ORD(OperatingMode)+1);
		}
		Parameter VLSMAP {
			IndexDomain: (SliceGroup,Seasonx,ExplicitPlanningHorizon,SupplyRegion);
		}
		Parameter MNUMNR {
			Definition: sum(SupplyRegion,CARD(SupplyRegion));
		}
		Parameter OVRCST_sub {
			IndexDomain: (SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear_ALTB) | ORD(PlanYear_ALTB) < UNXPH('1');
			Definition: {
				! IF available and subsidized (need variable)
				 UPOVR(PlantType) * UPLRPC(PlantType) * UPLROPT(PlantType) * UPLRLC(PlantType) * EPRGM(PlantType,SupplyRegion_ALT1,cyr) * EPACM(PlantType,SupplyRegion_ALT1,cyr) * ESTCPCST(PlantType,ElasticityStep) !* ANNADJ
			}
		}
		Parameter OVRCST {
			IndexDomain: (SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear_ALTB) | ORD(PlanYear_ALTB) < UNXPH('1');
			Definition: {
				! IF available (need variable)
				IF (UPSUBCAS(PlantType) = 2 ) THEN
				  (UPOVR(PlantType) * UPLRPC(PlantType) * UPLROPT(PlantType) * UPLRLC(PlantType) * EPRGM(PlantType,SupplyRegion_ALT1,cyr) * EPACM(PlantType,SupplyRegion_ALT1,cyr)
				       * ESTCPCST(PlantType,ElasticityStep))/(1.0 - UPCSB(PlantType))  !* )ANNADJ
				ELSE
				  UPOVR(PlantType) * UPLRPC(PlantType) * UPLROPT(PlantType) * UPLRLC(PlantType) * EPRGM(PlantType,SupplyRegion_ALT1,cyr) * EPACM(PlantType,SupplyRegion_ALT1,cyr) * ESTCPCST(PlantType,ElasticityStep) !* ANNADJ
				ENDIF
			}
		}
		Parameter ADJ_HGHT {
			IndexDomain: (SupplyRegion,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion,cyr);
			Definition: UOUNCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear)) + UOUCCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear)) + UEITAJ_ECP(Season,SupplyRegion,LastModelYear_MNUMYR(PlanYear));
		}
		Parameter MAX_HGHT {
			IndexDomain: (SupplyRegion_ALT1,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Definition: {
				Max((LoadGroup,LoadSegment)|LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and LoadGroup = LoadGroup_element(LoadGroup,Season) ,
				   (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
				       + ADJ_HGHT(SupplyRegion_ALT1,Season,PlanYear)))
			}
		}
		Parameter MIN_HGHT {
			IndexDomain: (SupplyRegion_ALT1,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Definition: {
				Min((LoadGroup,LoadSegment)|LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and LoadGroup = LoadGroup_element(LoadGroup,Season) ,
				   (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
				       + ADJ_HGHT(SupplyRegion_ALT1,Season,PlanYear)))
			}
		}
		Parameter ADJ_HGHT_NT {
			IndexDomain: (SupplyRegion,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion,cyr);
			Definition: UOUNCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear)) + UOUCCP(SupplyRegion,LastModelYear_MNUMYR(PlanYear));
			Comment: "excludes firm trade";
		}
		Parameter MAX_HGHT_NT {
			IndexDomain: (SupplyRegion_ALT1,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Definition: {
				Max((LoadGroup,LoadSegment)|LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and LoadGroup = LoadGroup_element(LoadGroup,Season) ,
				   (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
				       + ADJ_HGHT_NT(SupplyRegion_ALT1,Season,PlanYear)))
			}
			Comment: "excludes firm trade";
		}
		Parameter MIN_HGHT_NT {
			IndexDomain: (SupplyRegion_ALT1,Season,PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Definition: {
				Min((LoadGroup,LoadSegment)|LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and LoadGroup = LoadGroup_element(LoadGroup,Season) ,
				   (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
				       + ADJ_HGHT_NT(SupplyRegion_ALT1,Season,PlanYear)))
			}
			Comment: "excludes firm trade";
		}
		ElementParameter Season_element2 {
			IndexDomain: (SliceGroup,ExplicitPlanningHorizon,SupplyRegion)   | ORD(SupplyRegion) <= UNRGNS('1');
			Range: Season_;
			Definition: element(Season_,EPGECPS(SliceGroup,ExplicitPlanningHorizon,SupplyRegion,cyr));
		}
		Parameter SHOURS {
			IndexDomain: (Season,SupplyRegion,PlanYear);
			Definition: {
				SUM(SliceGroup | Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion) = Season,
				         EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr) * 0.001)
			}
		}
		Parameter AVGUDCR {
			Definition: SUM(SupplyRegion|ORD(SupplyRegion)<=UNRGNS('1'),EPUTDSCRT('1',SupplyRegion,cyr)) / UNRGNS('1');
		}
		Parameter AVGDCR {
			Definition: SUM(SupplyRegion|ORD(SupplyRegion)<=UNRGNS('1'),EPDSCRT('1',SupplyRegion,cyr)) / UNRGNS('1');
		}
		Parameter PVV_KW {
			Definition: SUM(FullPlanningHorizon,(KW(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
		}
		Parameter PVV_KW_ALT {
			Definition: {
				SUM(FullPlanningHorizon|ord(FullPlanningHorizon)<=UNFPH('1')-2,(KW_ALT(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				 / ((1 + AVGDCR) ^ (UNXPH('1')-1))
			}
		}
		Parameter PVV_KW1 {
			Definition: SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(KW1(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
		}
		Parameter PVV_ONE {
			IndexDomain: SupplyRegion | ORD(SupplyRegion) <= UNRGNS('1');
			Definition: SUM(FullPlanningHorizon,(KW(FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion,cyr)) ^ ORD(FullPlanningHorizon)));
		}
		Parameter PVV_KW2 {
			IndexDomain: SupplyRegion | ORD(SupplyRegion) <= UNRGNS('1');
			Definition: SUM(FullPlanningHorizon|ORD(FullPlanningHorizon)<=(UNFPH('1') - UNXPH('1') + 1),(KW1(FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion,cyr)) ^ ORD(FullPlanningHorizon)));
		}
		Parameter KW {
			IndexDomain: FullPlanningHorizon;
			Definition: {
				IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
				   1.0
				ELSE
				   0.0
				ENDIF
			}
		}
		Parameter KW1 {
			IndexDomain: FullPlanningHorizon;
			Definition: {
				IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1)) THEN
				   1.0
				ELSE
				   0.0
				ENDIF
			}
		}
		Parameter KW_ALT {
			IndexDomain: FullPlanningHorizon;
			Definition: 1.0;
		}
		ElementParameter LastModelYear_MNUMYR {
			IndexDomain: (PlanYear);
			Range: MNUMYR_;
			Definition: element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+ORD(PlanYear)-1));
		}
		ElementParameter LastModelYear_MNUMYR2 {
			IndexDomain: (FullPlanningHorizon);
			Range: MNUMYR_;
			Definition: element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+ORD(FullPlanningHorizon)-1));
		}
		ElementParameter LastModelYear_MNUMYR4 {
			IndexDomain: (PlanYear);
			Range: MNUMYR_;
			Definition: {
				if ORD(PlanYear)<UNXPH('1') then
				element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+ORD(PlanYear)-1))
				else
				element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+UNFPH('1')-1))
				endif
			}
		}
		ElementParameter LastModelYear_TYR {
			IndexDomain: (PlanYear);
			Range: MNUMYR_;
			Definition: {
				if ORD(PlanYear)<UNXPH('1') then
				element(MNUMYR_,MIN(UNYEAR('1'),CURIYR('1')+ORD(PlanYear)-1))
				else
				element(MNUMYR_,UNYEAR('1'))
				endif
			}
		}
		ElementParameter LastModelYear_MNUMYRX {
			IndexDomain: (PlanYear);
			Range: MNUMYRX_;
			Definition: element(MNUMYRX_,MIN(UNYEAR('1'),ORD(CYR)+ORD(PlanYear)-1));
		}
		ElementParameter LastModelYear_MNUMYRX2 {
			IndexDomain: (FullPlanningHorizon);
			Range: MNUMYRX_;
			Definition: element(MNUMYRX_,MIN(UNYEAR('1'),ORD(CYR)+ORD(FullPlanningHorizon)-1));
		}
		ElementParameter LastModelYear_MNUMYRF {
			IndexDomain: (PlanYear);
			Range: MNUMYRF_;
			Definition: element(MNUMYRF_,MIN(UNYEAR('1'),ORD(CYR)+ORD(PlanYear)-1));
		}
		ElementParameter LastModelYear_MNUMYRF2 {
			IndexDomain: (FullPlanningHorizon);
			Range: MNUMYRF_;
			Definition: element(MNUMYRF_,MIN(UNYEAR('1'),ORD(CYR)+ORD(FullPlanningHorizon)-1));
		}
		ElementParameter PeakSliceGroup_element {
			IndexDomain: (ExplicitPlanningHorizon,SupplyRegion);
			Range: LoadGroup_;
			Definition: element(LoadGroup_,EPLDGR('01',ExplicitPlanningHorizon,SupplyRegion,CYR));
		}
		ElementParameter Season_element {
			IndexDomain: LoadGroup;
			Range: Season_;
			Definition: element(Season_,MAP_ECP_SP(LoadGroup));
		}
		ElementParameter ECPLoadGroup_element {
			IndexDomain: LoadGroup;
			Range: ECPLoadGroup_;
			Definition: element(ECPLoadGroup_,ORD(LoadGroup));
		}
		ElementParameter ECPLoadGroup_to_LoadGroup {
			IndexDomain: ECPLoadGroup;
			Range: LoadGroup_;
			Definition: element(LoadGroup_,ORD(ECPLoadGroup));
		}
		ElementParameter DSMLoadGroup_element {
			IndexDomain: LoadGroup;
			Range: DSMLoadGroup_;
			Definition: element(DSMLoadGroup_,ORD(LoadGroup));
		}
		ElementParameter ECPLoadGroup_element1 {
			IndexDomain: DSMLoadGroup;
			Range: ECPLoadGroup_;
			Definition: element(ECPLoadGroup_,ORD(DSMLoadGroup));
		}
		ElementParameter DSMLoadGroup_element1 {
			IndexDomain: DSMLoadGroup;
			Range: LoadGroup_;
			Definition: element(LoadGroup_,ORD(DSMLoadGroup));
		}
		ElementParameter Seasonx_element {
			IndexDomain: (SupplyRegion,LoadGroup);
			Range: Seasonx_;
			Definition: element(Seasonx_,EPGECP(ECPLoadGroup_element(LoadGroup),SupplyRegion,cyr));
		}
		ElementParameter Seasonx_SliceGroup {
			IndexDomain: (SliceGroup,PlanYear,SupplyRegion)   | ORD(SupplyRegion) <= UNRGNS('1');
			Range: Seasonx_;
			Definition: element(Seasonx_,EPGECPS(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr));
		}
		ElementParameter DayType_element {
			IndexDomain: LoadGroup;
			Range: DayType_;
			Definition: element(DayType_,ord(LoadGroup));
		}
		ElementParameter DayType_element1 {
			IndexDomain: DSMLoadGroup;
			Range: DayType_;
			Definition: element(DayType_,ord(DSMLoadGroup));
		}
		ElementParameter NumStepsPerGroup_element {
			IndexDomain: (LoadGroup,SupplyRegion);
			Range: StepsPerGroup_;
			Definition: element(StepsPerGroup_,EPNSPG(DayType_element(LoadGroup),SupplyRegion,cyr));
			Comment: "returns number of StepsPerGroup (segments) per load group";
		}
		ElementParameter StepsPerGroup_fromSliceGroup {
			IndexDomain: (SliceGroup,PlanYear,SupplyRegion);
			Range: StepsPerGroup_;
			Definition: Element(StepsPerGroup_,EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr));
		}
		ElementParameter ECPLoadGroup_fromSliceGroup {
			IndexDomain: (SliceGroup,PlanYear,SupplyRegion);
			Range: ECPLoadGroup_;
			Definition: Element(ECPLoadGroup_,EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr));
		}
		ElementParameter ModelYear_MNUMYR1 {
			IndexDomain: (FullPlanningHorizon);
			Range: MNUMYR_;
			Definition: element(MNUMYR_,ORD(CYR)+ORD(FullPlanningHorizon)-1);
		}
		ElementParameter ModelYear_MNUMYRF {
			IndexDomain: (PlanYear);
			Range: MNUMYRF_;
			Definition: element(MNUMYRF_,ORD(CYR)+ORD(PlanYear)-1);
		}
		ElementParameter ModelYear_MNUMYRX {
			IndexDomain: (PlanYear);
			Range: MNUMYRX_;
			Definition: element(MNUMYRX_,ORD(CYR)+ORD(PlanYear)-1);
		}
		ElementParameter Season_elementx {
			IndexDomain: (Seasonx,SupplyRegion_ALT1) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Range: Season_;
			Definition: element(Season_,ORD(Seasonx));
		}
		ElementParameter Seasonx_element2 {
			IndexDomain: (Season,SupplyRegion_ALT1)| ORD(Season) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
			Range: Seasonx_;
			Definition: element(Seasonx_,ORD(Season));
		}
		ElementParameter LoadGroup_element {
			IndexDomain: (LoadGroup,Season) | ord(LoadGroup) >= ECPSEDEF_First(Season) and ord(LoadGroup) <= ECPSEDEF_Last(Season);
			Range: LoadGroup_;
			Definition: Element(LoadGroup_, ord(LoadGroup) );
		}
		ElementParameter LoadSegment_to_StepsPerGroup {
			IndexDomain: LoadSegment;
			Range: StepsPerGroup_;
			Definition: element(StepsPerGroup_,ORD(LoadSegment));
		}
		ElementParameter LoadSegment1 {
			Range: LoadSegment_;
			Definition: first(LoadSegment_);
		}
		ElementParameter StepsPerGroup1 {
			Range: StepsPerGroup_;
			Definition: first(StepsPerGroup_);
		}
		ElementParameter LoadSlice_element {
			IndexDomain: (SupplyRegion,LoadGroup,LoadSegment,PlanYear);
			Range: SliceGroup_;
			Definition: element(SliceGroup_,EPLMAP(ECPLoadGroup_element(LoadGroup),LoadSegment_to_StepsPerGroup(LoadSegment),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr));
		}
		ElementParameter NumLoadSegment_element {
			IndexDomain: (SupplyRegion,LoadGroup);
			Range: LoadSegment_;
			Definition: element(LoadSegment_,EPNSPG(DayType_element(LoadGroup),SupplyRegion,cyr));
			Comment: "returns number of load segments in each load group";
		}
		ElementParameter LoadSegment_SliceGroup {
			IndexDomain: (SliceGroup, PlanYear, SupplyRegion);
			Range: LoadSegment_;
			Definition: element(LoadSegment_,EPLDSG(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr));
		}
		ElementParameter LoadGroup_SliceGroup {
			IndexDomain: (SliceGroup, PlanYear, SupplyRegion);
			Range: LoadGroup_;

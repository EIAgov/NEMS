	DeclarationSection TransferVariable_Output_Check {
		Parameter Delta_diff;
		Parameter B_CCST_ADJ_diff {
			IndexDomain: (PlantType);
			Text: "ADJUSTMENT FACTOR CALCULATED FROM PROGRAM GOALS";
			Definition: {
				if B_CCST_ADJ_calc(PlantType) <> inf
				   and B_CCST_ADJ_pass(PlantType) <> inf then
				  abs(B_CCST_ADJ_calc(PlantType) - B_CCST_ADJ_pass(PlantType)) > Delta_diff
				else
				    0
				endif
			}
		}
		Parameter BANK_HG_diff {
			IndexDomain: (CoalDemandRegion);
			Definition: {
				if BANK_HG_calc(CoalDemandRegion) <> inf
				   and BANK_HG_pass(CoalDemandRegion) <> inf then
				  abs(BANK_HG_calc(CoalDemandRegion) - BANK_HG_pass(CoalDemandRegion)) > Delta_diff
				else
				    0
				endif
			}
		}
		Parameter BILCAP_diff {
			IndexDomain: (SupplyRegion_ALT1,FuelRegion,OwnerType);
			Text: "levelized capital cost for new BECCS builds by EMM and fuel region";
			Definition: {
				if BILCAP_calc(SupplyRegion_ALT1,FuelRegion,OwnerType) <> inf
				   and BILCAP_pass(SupplyRegion_ALT1,FuelRegion,OwnerType) <> inf then
				  abs(BILCAP_calc(SupplyRegion_ALT1,FuelRegion,OwnerType) - BILCAP_pass(SupplyRegion_ALT1,FuelRegion,OwnerType)) > Delta_diff
				else
				    0
				endif
			}
		}
		Parameter BILFCF_diff {
			IndexDomain: (SupplyRegion_ALT1,FuelRegion,OwnerType);

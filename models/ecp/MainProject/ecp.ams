			IndexDomain: SupplyRegion;
			Range: SupplyRegionAll_;
			Definition: {
				if RegGridIndex('1') = 1 then
						Element(SupplyRegionAll_,ord(SupplyRegion)-1)
				elseif RegGridIndex('1') = 4 then
						if (ord(SupplyRegion) > 1) then
						       Element(SupplyRegionAll_,ord(SupplyRegion)-18)
						else
						       Element(SupplyRegionAll_,ord(SupplyRegion))
						endif
				else
				    		Element(SupplyRegionAll_,ord(SupplyRegion))
				endif
			}
		}
		ElementParameter MAP_NERC_TO_RPS_RGN {
			IndexDomain: SupplyRegion;
			Range: RPSRegion_;
			Definition: {
				!IF UNRGNS('1') = 22 and  (ord(SupplyRegion)=6 or ord(SupplyRegion)=7) THEN
				!Element(RPSRegion_, 8)
				!ELSEIF (UNRGNS('1')= 25 and ord(SupplyRegion)=8) THEN
				!Element(RPSRegion_, 9)
				!else
				!Element(RPSRegion_, ord(SupplyRegion))
				!ENDIF
				Element(RPSRegion_,UPRNWRGN(SupplyRegion))
			}
		}
		ElementParameter MAP_NERC_TO_RPS_RGN2 {
			IndexDomain: SupplyRegion;
			Range: SupplyRegion_;

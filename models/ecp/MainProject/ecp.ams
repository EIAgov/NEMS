				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_MIN_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * VOMCST_DSP(DSP_Types, SupplyRegion_SUB, PlanYear)
				endif;
				!EP$ODSP,59
				ccalc_cJ_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr, PlanYear) |

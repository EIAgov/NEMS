			        put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			        for (PlantType,OwnerType) do
			            if EPLVFCF(PlantType,OwnerType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,ord(OwnerType):<10:0,EPLVFCF(PlantType,OwnerType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPLVFLC":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPLVFLC(PlantType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,EPLVFLC(PlantType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPLVFOM":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPLVFOM(PlantType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,EPLVFOM(PlantType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPLVTRN":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPLVTRN(PlantType,SupplyRegion,NEMSYearIndex) then

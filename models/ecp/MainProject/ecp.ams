				!EP$ODSP,68
				ccalc_cJ_rEUNle((DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and ord(PlanYear)>NOX_LT('1')):=
				
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.0000005 * GEN_MIN_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				EPNOX_G(Season1_element(Season1), ExplicitPlanningHorizon_element(PlanYear), DSP_Types, NOXRegion, SupplyRegion_SUB, cyr) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!EP$ODSP,69
				ccalc_cJ_rEUNle((DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB)  and ord(PlanYear)>NOX_LT('1')):=
				
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.0000005 * GEN_MIN_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				EPNOX_G(Seasonhr_element(Season_hr), ExplicitPlanningHorizon_element(PlanYear), DSP_Types, NOXRegion, SupplyRegion_SUB, cyr) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear)
				endif;
				ccalc_cJ_rEUNle((DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Seasonmd) |
				ccalc_cJ_rEUNle(DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				
				!EP$ODSP,70
				ccalc_cU_rEUNle((DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Season1) |

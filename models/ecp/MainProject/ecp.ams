			Constraint rGRPSge {
				IndexDomain: (SupplyState,RPSTrancheID,PlanYear);
				Text: "OML Rows: G(**)(*)RPS(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa),
					coeff_cG_rGRPSge(SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa) *
					      cG(SupplyState,PlantType,SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear))
					+
					coeff_cGCAP_rGRPSge(SupplyState,RPSTrancheID,PlanYear) *
					      cGCAP(SupplyState,RPSTrancheID,PlanYear)
					+
					sum((SupplyRegion_ALT1),
					coeff_cGSTRPS_rGRPSge(SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1) *
					      cGSTRPS(SupplyRegion_ALT1,PlanYear))
					+
					sum((SupplyRegion_ALT1,CHPFuel),
					coeff_cGTCG_rGRPSge(SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1,CHPFuel) *
					      cGTCG(SupplyRegion_ALT1,CHPFuel,PlanYear))
					+
					sum((SupplyRegion_ALT1,CHPFuel),
					coeff_cGTCO_rGRPSge(SupplyState,RPSTrancheID,PlanYear,SupplyRegion_ALT1,CHPFuel) *

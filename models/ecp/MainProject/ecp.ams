					(SupplyRegion_ALT1,PlantType,ElasticityStep,PlanYear,OwnerType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlantType<>WIWD_Element and PlantType<>WIBI_Element and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!RNW and OML Rows: L(*)(**)RN(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) AND
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) AND (ESTSWTCH(PlantType) < 0) THEN
					if EPBDSUP(RnwStor(PlantType), ElasticityStep_Element(ElasticityStep), SupplyRegion_ALT1, cyr)=0 then

			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			! write variables with implicit year index as implemented via direct access files in nems.
			! use NEMSYearIndex to set the Year    
			      NEMSYearIndex:=stringtoelement(mnumyr_,FormatString("%02i", CURCALYR('1')-1989));
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"URNCSTEX_ECP":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			      for (Season,SupplyRegion) do
			        if URNCSTEX_ECP(Season,SupplyRegion,NEMSYearIndex) then
			             put @5,ord(Season):<10:0,ord(SupplyRegion):<10:0,URNCSTEX_ECP(Season,SupplyRegion,NEMSYearIndex):>18:10,/;
			        endif; 
			      endfor; 

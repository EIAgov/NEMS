	Section Procedures_and_Functions {
		Procedure COMBINE_COAL_RATES {
			Body: {
				TMP_RATE(Four, CoalSupplyCurve_Int, CoalDemandRegion,FullPlanningHorizon):=
				if Four='1' then
				  999.999
				else
				 if (XCL_TRATI2(CoalSupplyCurve_Int, Four-1) > 0.0 AND XCL_TR_IN(Four-1, CoalSupplyCurve_Int, CoalDemandRegion, cyr) < 900.0 AND XCL_TR_IN(Four-1, CoalSupplyCurve_Int, CoalDemandRegion, cyr) > 0.0 and
				 (XCL_TR_IN(Four-1, CoalSupplyCurve_Int, CoalDemandRegion, cyr) * XCL_TESCI(Four-1, LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion) + XCL_TRATI2(CoalSupplyCurve_Int, Four-1))<=
				 TMP_RATE(Four-1, CoalSupplyCurve_Int, CoalDemandRegion,FullPlanningHorizon)) then
				  XCL_TR_IN(Four-1, CoalSupplyCurve_Int, CoalDemandRegion, cyr) * XCL_TESCI(Four-1, LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion) + XCL_TRATI2(CoalSupplyCurve_Int, Four-1)
				 else
				  TMP_RATE(Four-1, CoalSupplyCurve_Int, CoalDemandRegion,FullPlanningHorizon)
				 endif
				endif;
			}
		}
		Procedure EP_RPS_Calculations {
			Body: {
				          !	for (FullPlanningHorizon | (ORD(FullPlanningHorizon) >= UNXPH('1')) ) do
				          !		IF (ORD(CYR) + ORD(FullPlanningHorizon) -1  <= UNYEAR('1') ) THEN
				          !			DEM(SupplyRegion_SUB,FullPlanningHorizon) := QELASN(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001;
				          !		ELSE
				          !			DEM(SupplyRegion_SUB,FullPlanningHorizon) := QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1')))) * 0.001 *
				          !			(MAX(1.0,(QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1'))))
				          !				/ QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1')-20)))) ^ (1.0 / 20.0) ))
				          !				^ ((ORD(CYR) + ORD(FullPlanningHorizon) -1  ) - UNYEAR('1'));
				          !		ENDIF;
				          !        	
				          !      		COGGR(SupplyRegion_SUB,FullPlanningHorizon) :=
				          !      		IF (UPRNWCOGR(SupplyRegion_SUB) = 1) THEN
				          !      			URPSCGG(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon))
				          !      		ELSEIF (UPRNWCOGR(SupplyRegion_SUB) = 2) THEN
				          !      			URPSCGG(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon)) + URPSCGO(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon))
				          !      		ELSE
				          !      			0.0
				          !      		ENDIF;
				          !      		
				          !              	IF (UPRNWCOG('1') = 1) THEN
				          !                	COGGU(SupplyRegion_SUB,FullPlanningHorizon) := URPSCGG(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon));
				          !                ELSEIF (UPRNWCOG('1') = 2) THEN
				          !              		COGGU(SupplyRegion_SUB,FullPlanningHorizon) := URPSCGG(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon)) + URPSCGO(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon));
				          !                ELSE
				          !              		COGGU(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !                ENDIF;
				          !
				          !		RPSR(SupplyRegion_SUB,FullPlanningHorizon) := UPRNWBNDR(LastModelYear_MNUMYRX2(FullPlanningHorizon),SupplyRegion_SUB);
				          !		DPV(SupplyRegion_SUB,FullPlanningHorizon) := DPVTOTGENNR(SupplyRegion_SUB,LastModelYear_MNUMYR2(FullPlanningHorizon)) * 0.001;
				          !	endfor;
				          !	for (FullPlanningHorizon | (ORD(FullPlanningHorizon) < UNXPH('1')) ) do
				          !		DEM(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !		RPSR(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !		DPV(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !		COGGR(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !		COGGU(SupplyRegion_SUB,FullPlanningHorizon) := 0.0;
				          !	endfor;
				          !
				          !	PVVDEM(SupplyRegion_SUB) := SUM(FullPlanningHorizon,(DEM(SupplyRegion_SUB,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
				          !	PVVRPSR(SupplyRegion_SUB) := SUM(FullPlanningHorizon,(RPSR(SupplyRegion_SUB,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
				          !	PVVDPV(SupplyRegion_SUB) := SUM(FullPlanningHorizon,(DPV(SupplyRegion_SUB,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
				          !	PVV_COGGR(SupplyRegion_SUB) := SUM(FullPlanningHorizon,(COGGR(SupplyRegion_SUB,FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion_SUB,cyr)) ^ ORD(FullPlanningHorizon)));
				          !	PVV_COGGU(SupplyRegion_SUB) := SUM(FullPlanningHorizon,(COGGU(SupplyRegion_SUB,FullPlanningHorizon) / (1 + EPDSCRT('1',SupplyRegion_SUB,cyr)) ^ ORD(FullPlanningHorizon)));
				          !
				          !	for (PlanYear | (ORD(PlanYear) < UNXPH('1'))) do
				          !		IF (ORD(CYR) + ORD(PlanYear) -1  <= UNYEAR('1') ) THEN
				          !			DEMX(SupplyRegion_SUB,PlanYear) := QELASN(SupplyRegion_SUB,LastModelYear_MNUMYR(PlanYear)) * 0.001;
				          !		ELSE
				          !			DEMX(SupplyRegion_SUB,PlanYear) := QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1')))) * 0.001 *
				          !			(MAX(1.0,(QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1'))))
				          !				/ QELASN(SupplyRegion_SUB,Element(MNUMYR_,(UNYEAR('1')-20)))) ^ (1.0 / 20.0) ))
				          !				^ ((ORD(CYR) + ORD(PlanYear) -1  ) - UNYEAR('1'));
				          !		ENDIF;
				          !	endfor;
				          !	for (PlanYear | (ORD(PlanYear) >= UNXPH('1'))) do	
				          !		DEMX(SupplyRegion_SUB,PlanYear) := PVVDEM(SupplyRegion_SUB) / PVV_ONE(SupplyRegion_SUB);
				          !	endfor;
				          !
				          !!	for (PlanYear) do
				          !	GENX(SupplyRegion_SUB,PlanYear) :=
				          !		Sum(SliceGroup | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_SUB,cyr)),
				          !		(EPHGHT(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_SUB,cyr) *
				          !		EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_SUB,cyr)/1000.0 ));
				          !!	endfor;
				          !
				          !
				          !for (FullPlanningHorizon | ORD(FullPlanningHorizon) >= UNXPH('1')) do
				          !    RPS(FullPlanningHorizon) := UPRNWBND(LastModelYear_MNUMYRX2(FullPlanningHorizon));
				          !endfor;
				          !for (FullPlanningHorizon | ORD(FullPlanningHorizon) < UNXPH('1')) do
				          !     RPS(FullPlanningHorizon) := 0.0;
				          !endfor;
				          !
				          !PVVRPS := SUM(FullPlanningHorizon,(RPS(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
				
				          ! done calculating local variables, now fill coefficients
				
				!yda: Replaced below with no for loops
				!          for (SupplyRegion_SUB | ORD(SupplyRegion_SUB) <= UNRGNS('1')) do
				!          	for (PlanYear | (ORD(PlanYear) < UNXPH('1'))) do
				!          		TMPCOEF := -1.0 * UPRNWBND(LastModelYear_MNUMYRX(PlanYear)) * DEMX(SupplyRegion_SUB,PlanYear) / GENX(SupplyRegion_SUB,PlanYear);
				!          		IF (TMPCOEF > -1.0 * ECP_MIN('1') AND TMPCOEF < ECP_MIN('1')) THEN
				!          			TMPCOEF := ECP_MIN('1');
				!          		ENDIF;
				!          		IF (UPRNWCAS('1') > 0) THEN	
				!          		ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion_SUB) := TMPCOEF;
				!          		ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion_SUB) := 0;
				!          		ELSE
				!          		ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion_SUB) := TMPCOEF;
				!          		ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion_SUB) := 0;
				!          		ENDIF;
				!          	endfor;
				!          	for (PlanYear | (ORD(PlanYear) >= UNXPH('1'))) do
				!          		TMPCOEF := -1.0 * PVVRPS / PVV_ONE(SupplyRegion_SUB)* DEMX(SupplyRegion_SUB,PlanYear) / GENX(SupplyRegion_SUB,PlanYear);
				!          		IF (TMPCOEF > -1.0 * ECP_MIN('1') AND TMPCOEF < ECP_MIN('1')) THEN
				!          			TMPCOEF := ECP_MIN('1');
				!          		ENDIF;
				!          		IF (UPRNWCAS('1') > 0) THEN	
				!          		ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion_SUB) := TMPCOEF;
				!          		ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion_SUB) := 0;
				!          		ELSE
				!          		ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion_SUB) := TMPCOEF;
				!          		ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion_SUB) := 0;
				!          		ENDIF;
				!          	endfor;
				!          endfor;
				
				TMPCOEF1((PlanYear, SupplyRegion) | ORD(SupplyRegion) <= UNRGNS('1')):=
				if ord(PlanYear)<UNXPH('1') then
				        -1.0 * UPRNWBND(LastModelYear_MNUMYRX(PlanYear)) * DEMX(SupplyRegion,PlanYear) / GENX(SupplyRegion,PlanYear)
				else
				        -1.0 * PVVRPS / PVV_ONE(SupplyRegion)* DEMX(SupplyRegion,PlanYear) / GENX(SupplyRegion,PlanYear)
				endif;
				TMPCOEF1((PlanYear, SupplyRegion) | ORD(SupplyRegion) <= UNRGNS('1') and -ECP_MIN('1')<TMPCOEF1(PlanYear, SupplyRegion)<ECP_MIN('1')):= ECP_MIN('1');
				IF (UPRNWCAS('1') > 0) THEN	
				        ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion) := TMPCOEF1(PlanYear, SupplyRegion);
				        ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion) := 0;
				ELSE
				        ccalc_cGELXXX_rGURNWXXn(PlanYear,SupplyRegion) := TMPCOEF1(PlanYear, SupplyRegion);
				        ccalc_cGELXXX_rGURNWXXge(PlanYear,SupplyRegion) := 0;
				ENDIF;
			}
			Parameter TMPCOEF1 {
				IndexDomain: (PlanYear,SupplyRegion);
			}
		}
		DeclarationSection EPRPS_SUB_Variables {
			Parameter TMPCOEF;
			Parameter ccalc_cGELXXX_rGURNWXXge1 {
				IndexDomain: (PlanYear,SupplyRegion);
			}
			Parameter ccalc_cGELXXX_rGURNWXXn1 {
				IndexDomain: (PlanYear,SupplyRegion);
			}
		}
		Function PWF_Function {
			Arguments: (PWF_Rate,PWF_Year);
			IndexDomain: PlanYear;
			Body: {
				PWF_Function(PlanYear) := (1 + PWF_Rate) ^ ( -PWF_Year(PlanYear));
			}
			Comment: {
				"Same as PWF_f, but has a PlanYear dimension
				PRESENT WORTH FACTOR FUNCTION
				CALCULATES A FACTOR THAT EQUATES IN PRESENT VALUE TERMS A VALUE I YEARS IN THE FUTURE AT X DISCOUNT RATE"
			}
			Parameter PWF_Rate {
				Property: Input;
			}
			Parameter PWF_Year {
				IndexDomain: PlanYear;
				Property: Input;
			}
		}
		Function PWF_f {
			Arguments: (PWF_Rate,PWF_Year);
			Body: {
				PWF_f := (1 + PWF_Rate) ^ ( -PWF_Year);
			}
			Comment: {
				"PRESENT WORTH FACTOR FUNCTION
				CALCULATES A FACTOR THAT EQUATES IN PRESENT VALUE TERMS A VALUE I YEARS IN THE FUTURE AT X DISCOUNT RATE"
			}
			Parameter PWF_Rate {
				Property: Input;
			}
			Parameter PWF_Year {
				Property: Input;
			}
		}
		Function CRF_Function {
			Arguments: (CRF_Rate,CRF_Year);
			IndexDomain: PlanYear;
			Body: {
				CRF_Function(PlanYear) := CRF_Rate /(1 - (1 + CRF_Rate) ^ ( - CRF_Year(PlanYear)));
			}
			Comment: {
				"Same as CRF_f, but has a PlanYear dimension
				CRF IS A FUNCTION THAT RETURNS THE ANNUITY FACTOR ASSOCIATED WITH A INPUT INTEREST RATE (DECIMAL FRACTION) AND TERM (INTERGER YEARS)"
			}
			Parameter CRF_Rate {
				Property: Input;
			}
			Parameter CRF_Year {
				IndexDomain: PlanYear;
				Property: Input;
			}
		}
		Function CRF_f {
			Arguments: (CRF_Rate,CRF_Year);
			Body: {
				CRF_f := CRF_Rate /$(1 - (1 + CRF_Rate) ^ ( - CRF_Year));
			}
			Comment: "CRF IS A FUNCTION THAT RETURNS THE ANNUITY FACTOR ASSOCIATED WITH A INPUT INTEREST RATE (DECIMAL FRACTION) AND TERM (INTERGER YEARS)";
			Parameter CRF_Rate {
				Property: Input;
			}
			Parameter CRF_Year {
				Property: Input;
			}
		}
		Function PVV_Function {
			Arguments: (PVV_Vector,PVV_Year,PVV_Rate);
			Body: {
				PVV_Function:= PVV_Vector / ((1 + PVV_Rate) ^ PVV_year);
			}
			Comment: {
				"YDA: This function takes longer than the explicit calculation since it takes PVV_Vector as a single value, not an array
				PRESENT WORTH FACTOR FUNCTION CALCULATES A FACTOR THAT EQUATES IN PRESENT VALUE TERMS A VALUE I YEARS IN THE FUTURE AT X DISCOUNT RATE
				Needs to be summed up in the calling procedure"
			}
			Parameter PVV_Vector {
				Property: Input;
			}
			Parameter PVV_Rate {
				Property: Input;
			}
			Parameter PVV_Year {
				Property: Input;
			}
		}
		Function PVBV_f {
			Arguments: (LIFE,NOYRS,DR);
			Body: {
				PVBV_f:=(1-((1+DR)^(-NOYRS))*(DR*NOYRS+1))/((DR^2)*LIFE);
			}
			Comment: {
				"FUNCTION TO CALCULATE THE PRESENT VALUE OF THE BOOK VALUE
				!     OUTSTANDING: USED IN THE UTILITY PRESENT VALUE OF RATE BASE
				!     CALCULATION
				!     INPUTS: ECONOMIC LIFE (LIFE), NOYRS (YEARS FOR THE CALCULATION),
				!     DISCOUNT RATE (DR)"
			}
			Parameter LIFE {
				Property: Input;
			}
			Parameter NOYRS {
				Property: Input;
			}
			Parameter DR {
				Property: Input;
			}
		}
		Function EP_LGNP_f {
			Arguments: (OLYR,OPYRS,DSCRT);
			Body: {
				GNP((FullPlanningHorizon) | ord(FullPlanningHorizon)<=OPYRS):=UPGNPD(MNUMYRF_KYR(FullPlanningHorizon+OLYR-1));
				EP_LGNP_f := sum(FullPlanningHorizon | ord(FullPlanningHorizon)<=OPYRS,
				!PVV_Function(GNP(FullPlanningHorizon), ord(FullPlanningHorizon), DSCRT))*
				GNP(FullPlanningHorizon) / ((1 + DSCRT) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT, OLYR - 1);
			}
			Parameter OLYR {
				Property: Input;
			}
			Parameter OPYRS {
				Property: Input;
			}
			Parameter DSCRT {
				Property: Input;
			}
			Parameter GNP {
				IndexDomain: FullPlanningHorizon;
			}
		}
		Function ELNGSCRV_Function {
			Arguments: (Value);
			IndexDomain: (GasSupplyStep,FullPlanningHorizon);
			Body: {
				!  SET VARIABLES WHICH DON'T CHANGE BASED ON VALUE COMING IN
				
				XQBASE(FullPlanningHorizon) := NGSCRV_Q0(LastModelYear_MNUMYR2(FullPlanningHorizon));
				XPBASE(FullPlanningHorizon) := NGSCRV_P0(LastModelYear_MNUMYR2(FullPlanningHorizon));
				
				AQBASE(FullPlanningHorizon) := XQBASE(FullPlanningHorizon) * (1. - NGSCRV_PER(One_element));
				BQBASE(FullPlanningHorizon) := XQBASE(FullPlanningHorizon) * (1. + NGSCRV_PER(One_element));
				APBASE(FullPlanningHorizon) := XPBASE(FullPlanningHorizon) * (1.- (NGSCRV_PER(One_element) /NGSCRV_ELAS('3')));
				BPBASE(FullPlanningHorizon) := XPBASE(FullPlanningHorizon) * (1.+ (NGSCRV_PER(One_element) /NGSCRV_ELAS('3')));
				
				CQBASE(FullPlanningHorizon) := AQBASE(FullPlanningHorizon) * (1. - NGSCRV_PER(Two_element));
				DQBASE(FullPlanningHorizon) := BQBASE(FullPlanningHorizon) * (1. + NGSCRV_PER(Two_element));
				CPBASE(FullPlanningHorizon) := APBASE(FullPlanningHorizon) * (1.- (NGSCRV_PER(Two_element) /NGSCRV_ELAS('2')));
				DPBASE(FullPlanningHorizon) := BPBASE(FullPlanningHorizon) * (1.+ (NGSCRV_PER(Two_element) /NGSCRV_ELAS('4')));
				
				!  TRANSLATE CHANGE IN CONSUMPTION TO PLACE ON SUPPLY CURVE
				
				QVAR(GasSupplyStep, FullPlanningHorizon) := NGSCRV_Q(LastModelYear_MNUMYR2(FullPlanningHorizon)) + (Value(GasSupplyStep, FullPlanningHorizon) /CFNGU(LastModelYear_MNUMYR2(FullPlanningHorizon)));
				QBASE1(GasSupplyStep, FullPlanningHorizon) :=
				IF (QVAR(GasSupplyStep, FullPlanningHorizon) <= CQBASE(FullPlanningHorizon)) THEN
				CQBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) <= AQBASE(FullPlanningHorizon)) THEN
				AQBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= DQBASE(FullPlanningHorizon)) THEN
				DQBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= BQBASE(FullPlanningHorizon)) THEN
				BQBASE(FullPlanningHorizon)
				ELSE
				XQBASE(FullPlanningHorizon)
				ENDIF;
				PBASE(GasSupplyStep, FullPlanningHorizon) :=
				IF (QVAR(GasSupplyStep, FullPlanningHorizon) <= CQBASE(FullPlanningHorizon)) THEN
				CPBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) <= AQBASE(FullPlanningHorizon)) THEN
				APBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= DQBASE(FullPlanningHorizon)) THEN
				DPBASE(FullPlanningHorizon)
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= BQBASE(FullPlanningHorizon)) THEN
				BPBASE(FullPlanningHorizon)
				ELSE
				XPBASE(FullPlanningHorizon)
				ENDIF;
				ELAS(GasSupplyStep, FullPlanningHorizon) :=
				IF (QVAR(GasSupplyStep, FullPlanningHorizon) <= CQBASE(FullPlanningHorizon)) THEN
				NGSCRV_ELAS('1')
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) <= AQBASE(FullPlanningHorizon)) THEN
				NGSCRV_ELAS('2')
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= DQBASE(FullPlanningHorizon)) THEN
				NGSCRV_ELAS('5')
				ELSEIF (QVAR(GasSupplyStep, FullPlanningHorizon) >= BQBASE(FullPlanningHorizon)) THEN
				NGSCRV_ELAS('4')
				ELSE
				NGSCRV_ELAS('3')
				ENDIF;
				ELNGSCRV_Function(GasSupplyStep,FullPlanningHorizon) := PBASE(GasSupplyStep, FullPlanningHorizon) *
				(((1/ELAS(GasSupplyStep, FullPlanningHorizon))*(QVAR(GasSupplyStep, FullPlanningHorizon)-QBASE1(GasSupplyStep, FullPlanningHorizon))/QBASE1(GasSupplyStep, FullPlanningHorizon)) + 1);
				ELNGSCRV_Function((GasSupplyStep,FullPlanningHorizon)|ELNGSCRV_Function(GasSupplyStep,FullPlanningHorizon) <= 0.0) := XPBASE(FullPlanningHorizon);
			}
			Parameter QBASE1 {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
			}
			Parameter XQBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter AQBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter BQBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter CQBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter DQBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter PBASE {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
			}
			Parameter XPBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter APBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter BPBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter CPBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter DPBASE {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter QVAR {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
			}
			Parameter ELAS {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
			}
			Parameter Value {
				IndexDomain: (GasSupplyStep,FullPlanningHorizon);
				Property: Input;
			}
		}
		Procedure Carbon_Taxes_Calculation {
			Body: {
				if CURIYR('1')+UHBSYR('1') = ECP_FYR('1') then !yda: does this need also a cycle indication?
				!if FirstTime then
				!FirstTime:=0;
				!FirstYear(MNUMYR):=1;
				PJRSEL(MNUMYR):=JRSEL(MNUMYR);
				PJDSEL(MNUMYR):=JDSEL(MNUMYR);
				PJCLEL(MNUMYR):=JCLEL(MNUMYR);
				PJNGEL(MNUMYR):=JNGEL(MNUMYR);
				endif;
				CarbonTax_FileName:="../../ecp/CarbonTaxes_"+formatstring("%i",curcalyr(1))+".txt";
				if CURIYR('1')+UHBSYR('1') > ECP_FYR('1') then
				
				read from file CarbonTax_FileName;
				endif;
				!if FirstYear(cyr) then  !yda: is this needed?
				!FirstYear(cyr):=0;
				PJRSEL(jyr):= max(0, PJRSEL(jyr)+ UPCALPHA('1')*(JRSEL(cyr-1)-PJRSEL(cyr-1)));
				PJDSEL(jyr):= max(0, PJDSEL(jyr)+ UPCALPHA('1')*(JDSEL(cyr-1)-PJDSEL(cyr-1)));
				PJCLEL(jyr):= max(0, PJCLEL(jyr)+ UPCALPHA('1')*(JCLEL(cyr-1)-PJCLEL(cyr-1)));
				PJNGEL(jyr):= max(0, PJNGEL(jyr)+ UPCALPHA('1')*(JNGEL(cyr-1)-PJNGEL(cyr-1)));
				!endif;
				CarbonTax_FileName:="../../ecp/CarbonTaxes_"+formatstring("%i",curcalyr(1)+1)+".txt";
				write PJRSEL, PJDSEL, PJCLEL, PJNGEL to file CarbonTax_FileName;
				!casefilesave("data\\CarbonTaxes.data",CarbonTax_identifiers);
			}
			Comment: {
				"!yda:needs revisiting"
			}
		}
		Procedure SliceGroup2Season_Calculate {
			Body: {
				empty SliceGroup2Season_Map,Season2SliceGroup;
				for (Season,PlanYear,SupplyRegion) do!
				  SliceGroupElement:=element(SliceGroup_,EPFRST(Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr));
				  while (SliceGroupElement) do
				     SliceGroup2Season_Map(Season, SliceGroupElement,PlanYear,SupplyRegion):=1;
				!     Season2SliceGroup(SliceGroupElement,PlanYear,SupplyRegion):=Season;
				     SliceGroupElement:=element(SliceGroup_,EPNEXT(SliceGroupElement, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr));
				  endwhile;
				endfor;
			}
			ElementParameter SliceGroupElement {
				Range: SliceGroup_;
			}
		}
		Procedure ST_RPS_Mapping {
			Body: {
				empty SupplyState_Element, RPSTrancheID_i;
				RPSTrancheID_i(SupplyState):= first(RPSTrancheID_);
				for RPSTranche | ord(RPSTranche)<=NM_ST_RPS('1') do
				
				SupplyState_Element:= element(SupplyState_,ST_RPS_STnm(RPSTranche));
				
				Map_ST_RPS(SupplyState_Element, RPSTrancheID_i(SupplyState_Element)):=ST_RPS_STnm(RPSTranche);
				RPSTranche_Element(SupplyState_Element, RPSTrancheID_i(SupplyState_Element)):=RPSTranche;
				RPSTrancheID_i(SupplyState_Element)+=1;
				endfor;
			}
			ElementParameter SupplyState_Element {
				Range: SupplyState_;
			}
			ElementParameter RPSTrancheID_i {
				IndexDomain: SupplyState;
				Range: RPSTrancheID_;
			}
		}
		Procedure NGBS_TEST_RGNS {
			Body: {
				empty TEST_RGNS;
				TEST_RGNS((NaturalGasGroup, NGSupplyRegion(NaturalGasGroup),NGFuelRegion(NaturalGasGroup)) |
				ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')):=1;
				ICNT(SupplyRegion_SUB, FuelRegion):=1;
				
				for NaturalGasGroup | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') do
				  IF GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001 AND
				  ICNT(NGSupplyRegion(NaturalGasGroup),NGFuelRegion(NaturalGasGroup)) AND
				  GRP_CAP(UNXPH_Element,NaturalGasGroup)>0.0001 THEN
				        ICNT(NGSupplyRegion(NaturalGasGroup),NGFuelRegion(NaturalGasGroup)):=0;
				  ELSE
				    TEST_RGNS(NaturalGasGroup, NGSupplyRegion(NaturalGasGroup),NGFuelRegion(NaturalGasGroup)):=0;
				  ENDIF;
				endfor;
			}
			Parameter ICNT {
				IndexDomain: (SupplyRegion_SUB, FuelRegion);
			}
			Parameter JCNT {
				IndexDomain: PlanYear;
			}
		}
		Procedure CoalConfiguration_Mapping {
			Body: {
				empty CoalConfiguriation_MAP, RetrofitCFG_Element, I_RetrofitCombinations;
				
				HG_TST(CoalConfiguration,PlanYear):=
				IF (HG_BYR('1') <= BYR(PlanYear) + UHBSYR('1')) or
				(EMLIM('4', element(MNUMYR_,MIN(UNYEAR('1'),BYR(PlanYear)))) < 100) or
				(UCL_CNFG('8', CoalConfiguration)=0) then
				1
				endif;
				
				CoalConfiguriation_MAP((CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):=
				sum(RetrofitCombinations| UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear))>0 and
				ord(CoalConfiguration)=UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear)) and
				HG_TST(CoalConfiguration,PlanYear)=1, 1);
				
				!RetrofitCombinations_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration):=
				!sum(RetrofitCombinations| UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear))>0 and
				!ord(CoalConfiguration)=UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear)) and
				!HG_TST(CoalConfiguration,PlanYear)=1, ord(RetrofitCombinations));
				
				I_RetrofitCombinations((CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):=
				min(RetrofitCombinations| UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear))>0 and
				ord(CoalConfiguration)=UCL_RCMB(RetrofitCombinations, I_CoalConfiguration(CoalGroup_SUB, PlanYear)) and
				HG_TST(CoalConfiguration,PlanYear)=1, RetrofitCombinations);
				
				
				RetrofitCFG_Element(PlanYear, CoalGroup_SUB, first(RetrofitCFG)):=
				I_CoalConfiguration(CoalGroup_SUB, PlanYear);
				
				RetrofitCFG_Element((PlanYear, CoalGroup_SUB, RetrofitCFG)|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, elementcast(CoalConfiguration_, RetrofitCFG))=1) :=
				elementcast(CoalConfiguration_, RetrofitCFG);
			}
		}
		Procedure Calculate_EPSUBFIN {
			Body: {
				!     CHECK FOR TIME-DEPENDENT DEBT/EQUITY SUBSIDIES
				
				!     COST OF DEBT
				ADJ(PlantType, FullPlanningHorizon) | UPNIRTEY(PlantType)<>0 and ((CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) >= UPNIRTES(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) <= UPNIRTEL(PlantType)):= UPNIRTEY(PlantType);
				ONE((PlantType,FullPlanningHorizon) | UPNIRTEY(PlantType)<>0):=1;
				PVONE((SupplyRegion, PlantType, PlanYear) | UPNIRTEY(PlantType)<>0):= sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!        PVV_Function(ONE(PlantType,FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion, cyr))) *
				        ONE(PlantType,FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon)))*
				        PWF_f(EPDSCRT('1',SupplyRegion,cyr),UNXPH('1')-1);
				CSTDTADJ((SupplyRegion, PlantType, PlanYear) | UPNIRTEY(PlantType)<>0):=
				if OLYEAR(PlanYear, PlantType)< UNXPH('1') then
				        if ((CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) >= UPNIRTES(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) <= UPNIRTEL(PlantType)) then
				            UPNIRTEY(PlantType)
				        endif
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!        PVV_Function(ADJ(PlantType, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion, cyr))) *
				        ADJ(PlantType, FullPlanningHorizon+2) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon)))*
				        PWF_f(EPDSCRT('1',SupplyRegion,cyr),UNXPH('1')-1)/ PVONE(SupplyRegion, PlantType, PlanYear)
				endif;
				!     COST OF EQUITY
				ADJ(PlantType, FullPlanningHorizon):=0;
				ADJ(PlantType, FullPlanningHorizon) | UPNRRTEY(PlantType)<>0 and ((CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) >= UPNRRTES(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) <= UPNRRTEL(PlantType)):= UPNRRTEY(PlantType);
				CSTEQADJ((SupplyRegion, PlantType, PlanYear) | UPNRRTEY(PlantType)<>0):=
				if OLYEAR(PlanYear, PlantType)< UNXPH('1') then
				        if ((CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) >= UPNRRTES(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) <= UPNRRTEL(PlantType)) then
				            UPNRRTEY(PlantType)
				        endif
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!        PVV_Function(ADJ(PlantType, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion, cyr))) *
				        ADJ(PlantType, FullPlanningHorizon+2) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon))) *
				        PWF_f(EPDSCRT('1',SupplyRegion,cyr),UNXPH('1')-1)/ PVONE(SupplyRegion, PlantType, PlanYear)
				endif;
				!     DEBT FRACTION
				ADJ(PlantType, FullPlanningHorizon):=0;
				ADJ(PlantType, FullPlanningHorizon) | UPNFDTY(PlantType)<>0 and ((CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) >= UPNFDTS(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + ord(FullPlanningHorizon) -1) <= UPNFDTL(PlantType)):= UPNFDTY(PlantType);
				SHRDTADJ((SupplyRegion, PlantType, PlanYear) | UPNFDTY(PlantType)<>0):=
				if OLYEAR(PlanYear, PlantType)< UNXPH('1') then
				        if ((CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) >= UPNFDTS(PlantType) AND
				        (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) -1) <= UPNFDTL(PlantType)) then
				            UPNFDTY(PlantType)
				        endif
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!        PVV_Function(ADJ(PlantType, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion, cyr))) *
				        ADJ(PlantType, FullPlanningHorizon+2) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon)))*
				        PWF_f(EPDSCRT('1',SupplyRegion,cyr),UNXPH('1')-1)/ PVONE(SupplyRegion, PlantType, PlanYear)
				endif;
			}
			DeclarationSection Local_Declaration {
				Parameter ADJ {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ONE {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter PVONE {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
			}
		}
		Procedure Calculate_CFDGN {
			Body: {
				!
				
				for (ExplicitPlanningHorizon, Season, SupplyRegion_SUB)| ord(ExplicitPlanningHorizon)<=UNXPH('1') and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr)  do
				VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB):=  EPFRST(Season, ExplicitPlanningHorizon, SupplyRegion_SUB, cyr);
				VLS_element(Season, ExplicitPlanningHorizon, SupplyRegion_SUB):=element(SliceGroup_, VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB));
				I_CNT:=0;
				Slice_element:=first(SlicePerSeason);
				
				while VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB) do
				I_CNT+=1;
				VLSMAP1(Slice_element, Season, ExplicitPlanningHorizon, SupplyRegion_SUB):= VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB);
				
				VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB):=  EPNEXT(VLS_element(Season, ExplicitPlanningHorizon, SupplyRegion_SUB), ExplicitPlanningHorizon, SupplyRegion_SUB, cyr);
				VLS_element(Season, ExplicitPlanningHorizon, SupplyRegion_SUB):=element(SliceGroup_, VLS(Season, ExplicitPlanningHorizon, SupplyRegion_SUB));
				Slice_element+=1;
				endwhile;
				
				endfor;
				!SliceGroup_element:=first(SliceGroup);
				!VLSMAP2(SliceGroup_element, Season, ExplicitPlanningHorizon, SupplyRegion_SUB):= EPFRST(Season, ExplicitPlanningHorizon, SupplyRegion_SUB, cyr);
				!VLSMAP2((SliceGroup, Season, ExplicitPlanningHorizon, SupplyRegion_SUB) | ord(ExplicitPlanningHorizon)<=UNXPH('1') and
				!ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and SliceGroup>SliceGroup_element ):=
				!sum(SliceGroup_ALT| val(SliceGroup_ALT)=VLSMAP2(SliceGroup-1, Season, ExplicitPlanningHorizon, SupplyRegion_SUB), EPNEXT(SliceGroup_ALT, ExplicitPlanningHorizon, SupplyRegion_SUB, cyr));
				
				
				NSTP(Season, SupplyRegion_SUB):=sum(SlicePerSeason| VLSMAP1(SlicePerSeason, Season, first(ExplicitPlanningHorizon), SupplyRegion_SUB), 1);
				
				VLSMODE((SliceGroup, ExplicitPlanningHorizon, SupplyRegion_SUB) | ord(ExplicitPlanningHorizon)<=UNXPH('1')):=
				sum((SlicePerSeason,Season)| VLSMAP1(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion_SUB)=ord(SliceGroup) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr), ord(SlicePerSeason));
				VLSSEAS((SliceGroup, ExplicitPlanningHorizon, SupplyRegion_SUB) | ord(ExplicitPlanningHorizon)<=UNXPH('1')):=
				sum((SlicePerSeason,Season)| VLSMAP1(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion_SUB)=ord(SliceGroup) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr), ord(Season));
				
				VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion):=element(SliceGroup_,VLSMAP1(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion));
				VLSMode_element(SliceGroup, ExplicitPlanningHorizon, SupplyRegion):=element(OperatingMode_,VLSMODE(SliceGroup, ExplicitPlanningHorizon, SupplyRegion));
				VLSSeason_element(SliceGroup, ExplicitPlanningHorizon, SupplyRegion):=element(Season_,VLSSEAS(SliceGroup, ExplicitPlanningHorizon, SupplyRegion));
				
				Slice_element:=first(SlicePerSeason);
				CapacityFactor(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion_SUB):=0;
				CapacityFactor((SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion_SUB) | ord(ExplicitPlanningHorizon)<=UNXPH('1') and
				ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and SlicePerSeason>Slice_element and ord(SlicePerSeason)<=NSTP(Season, SupplyRegion_SUB)+1):=
				sum(SlicePerSeason_ALT1| SlicePerSeason_ALT1<SlicePerSeason,
				EPWDTH(VLSSliceGroup_element(SlicePerSeason_ALT1, Season, ExplicitPlanningHorizon, SupplyRegion_SUB), ExplicitPlanningHorizon, SupplyRegion_SUB, cyr));
				
				Slice_last(Season, SupplyRegion_SUB):=element(SlicePerSeason_,NSTP(Season, SupplyRegion_SUB)+1);
				CapacityFactor(SlicePerSeason, Season, ExplicitPlanningHorizon, SupplyRegion_SUB)/= $ CapacityFactor(Slice_last(Season, SupplyRegion_SUB), Season, ExplicitPlanningHorizon, SupplyRegion_SUB);
			}
			DeclarationSection Local_Declaration {
				ElementParameter VLS_element {
					IndexDomain: (Season, ExplicitPlanningHorizon, SupplyRegion_SUB);
					Range: SliceGroup_;
				}
				ElementParameter Slice_element {
					Range: SlicePerSeason_;
				}
				ElementParameter Slice_last {
					IndexDomain: (Season, SupplyRegion);
					Range: SlicePerSeason_;
				}
				Parameter VLS {
					IndexDomain: (Season, ExplicitPlanningHorizon, SupplyRegion_SUB);
				}
				Parameter I_CNT;
			}
		}
		Procedure Calculate_INTBLDCOSTS {
			Body: {
				! DETERMINE PRESENT VALUE OF PRODUCTION TAX CREDIT SUBSIDIES
				! determine annual generation based on time slice CF used in load (from RESTORE)
				GENNEW((SupplyRegion_SUB, Intermittent, PlanYear)| ((UPGSUB(Intermittent) >0 AND (CURIYR('1') + OLYEAR(PlanYear, Intermittent) - 1) >= (UPGSY1(Intermittent) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, Intermittent) - 1) <= (UPGSYL(Intermittent) - UHBSYR('1'))) OR
				(UPGSUBPT(Intermittent) > 0 AND UPGSUBYR(Intermittent, OLYEAR_MNUMYR(PlanYear, Intermittent))> 0))) :=
				IF (EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR (UPVTYP(Intermittent)= 1 AND
				UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) then
				sum(SliceGroup | ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr),
				UPICFC1(Intermittent, ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), SupplyRegion_SUB, cyr) *
				EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr))
				endif;
				
				SOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(Intermittent)) :=
				IF (UPGSUBPT(Intermittent)<= 0) THEN
				        (UPGSUB(Intermittent) * GENNEW(SupplyRegion_SUB, Intermittent, PlanYear) / 1000.0 )
				ELSE
				        (UPGSUBYR(Intermittent, OLYEAR_MNUMYR(PlanYear, Intermittent))) * GENNEW(SupplyRegion_SUB, Intermittent, PlanYear) / 1000.0
				ENDIF;
				!CHECK IF PTC IS CAPPED
				SOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)| UPGSMX(Intermittent)>0):= MIN(SOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),UPGSMX(Intermittent));
				!IF PTC IS REAL, THEN APPLY DEFLATOR
				SOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)| UPGSTY(Intermittent)<=0) *= UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				!ADJUST FOR TAX BENEFIT
				SOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon) /= 1.0 - UPTXRT('1');
				SOML((SupplyRegion_SUB, Intermittent, FullPlanningHorizon)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and (UPGSUB(Intermittent) >0 AND
				(CURIYR('1') + OLYEAR(first(PlanYear), Intermittent) - 1) >= (UPGSY1(Intermittent) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(first(PlanYear), Intermittent) - 1) <= (UPGSYL(Intermittent) - UHBSYR('1')))):=
				SOM(SupplyRegion_SUB, Intermittent, first(PlanYear), FullPlanningHorizon)/
				(GENNEW(SupplyRegion_SUB, Intermittent, first(PlanYear)) / 1000.0);  !only for PlanYear=1
				PVSOM(SupplyRegion_SUB, Intermittent, PlanYear) :=
				if (UPGSUB(Intermittent) >0 AND (CURIYR('1') + OLYEAR(PlanYear, Intermittent) - 1) >= (UPGSY1(Intermittent) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, Intermittent) - 1) <= (UPGSYL(Intermittent) - UHBSYR('1'))) OR
				(UPGSUBPT(Intermittent) > 0 AND UPGSUBYR(Intermittent, OLYEAR_MNUMYR(PlanYear, Intermittent))> 0) then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(Intermittent),
				!PVV_Function(SOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))*
				SOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1)
				else
				0
				endif;
				PVSOML(SupplyRegion_SUB, Intermittent) :=
				if (UPGSUB(Intermittent) >0 AND (CURIYR('1') + OLYEAR(first(PlanYear_), Intermittent) - 1) >= (UPGSY1(Intermittent) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(first(PlanYear_), Intermittent) - 1) <= (UPGSYL(Intermittent) - UHBSYR('1'))) OR
				(UPGSUBPT(Intermittent) > 0 AND UPGSUBYR(Intermittent, OLYEAR_MNUMYR(first(PlanYear_), Intermittent))> 0) then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(Intermittent),
				!PVV_Function(SOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))*
				SOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear_), Intermittent)-1)
				else
				0
				endif;
				!CHECK FOR TIME-DEPENDENT DEBT/EQUITY SUBSIDIES
				!EPSUBFIN_Sub; moved to mainexecution
				!DETERMINE PRESENT VALUE OF FIXED O&M AT OLYR INCLUDE EXTERNALITY COSTS, IF ANY
				ARB((SupplyRegion_SUB, WIPT_Element, PlanYear, FullPlanningHorizon)|
				(EPECAP(FuelRegion0, WIPT_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(WIPT_Element)= 1 AND UPBLDREG(WIPT_Element, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIPT_Element) + 1) :=
				(PT_OFFSET(SupplyRegion_SUB) - PT_STORAGE_PROFIT(SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIPT_Element, PlanYear));
				
				FOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1) :=
				EPIRFOM(IntStor(Intermittent), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				
				VOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1) :=
				(EPIRVOM(IntStor(Intermittent), SupplyRegion_SUB, cyr) * 8.76 * EPIACF(Intermittent, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				
				TOM((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1) :=
				EPCFOM(Intermittent, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				
				!EXT and GPS are not converted, exist but not used in FORTRAN  */
				
				!EXTR((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)|
				!(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				!(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1) :=
				!(EPEXT(Intermittent, last(EmissionType_SUP_), SupplyRegion_SUB, cyr) * 8.76 * EPIACF(Intermittent, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				
				FOML((SupplyRegion_SUB, Intermittent, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1) :=
				EPIRFOM(IntStor(Intermittent), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, first(PlanYear)));
				
				VOML((SupplyRegion_SUB, Intermittent, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1) :=
				EPIRVOM(IntStor(Intermittent), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, first(PlanYear)));
				
				TOML((SupplyRegion_SUB, Intermittent, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1) :=
				EPCFOM(Intermittent, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, first(PlanYear)));
				
				!EXTL((SupplyRegion_SUB, Intermittent, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1) :=
				!EPEXT(Intermittent, last(EmissionType_SUP_), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, first(PlanYear)));
				
				PVARB((SupplyRegion_SUB, WIPT_Element, PlanYear)|
				(EPECAP(FuelRegion0, WIPT_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(WIPT_Element)= 1 AND UPBLDREG(WIPT_Element, SupplyRegion_SUB)>0)) ) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIPT_Element) + 1,
				!PVV_Function(ARB(SupplyRegion_SUB, WIPT_Element, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1'))) *
				ARB(SupplyRegion_SUB, WIPT_Element, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1')) ^ ord(FullPlanningHorizon)))*
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1')),OLYEAR(PlanYear, WIPT_Element)-1);
				
				PVFOM((SupplyRegion_SUB, Intermittent, PlanYear)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1,
				!PVV_Function(FOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1);
				
				PVVOM((SupplyRegion_SUB, Intermittent, PlanYear)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1,
				!PVV_Function(VOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1);
				
				PVTOM((SupplyRegion_SUB, Intermittent, PlanYear)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1,
				!PVV_Function(TOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				TOM(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1);
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				
				!PVEXT(SupplyRegion_SUB, Intermittent, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1,
				!PVV_Function(EXTR(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				!PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1);
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY AND EXTERNALITY COSTS
				PVFOML((SupplyRegion_SUB, Intermittent)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1,
				!PVV_Function(FOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), Intermittent)-1);
				
				PVVOML((SupplyRegion_SUB, Intermittent)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1,
				!PVV_Function(VOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), Intermittent)-1);
				
				PVTOML((SupplyRegion_SUB, Intermittent)|
				(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1,
				!PVV_Function(TOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				TOML(SupplyRegion_SUB, Intermittent, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), Intermittent)-1);
				
				!PVEXTL(SupplyRegion_SUB, Intermittent) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1,
				!PVV_Function(EXTL(SupplyRegion_SUB, Intermittent, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				!PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), Intermittent)-1);
				
				PVGNPR((SupplyRegion_SUB, Intermittent)| (EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) ) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), Intermittent),(UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1),
				(EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(Intermittent)));
				PVGNP((SupplyRegion_SUB, Intermittent)| (EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0))) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), Intermittent),(UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				EPLVFOM_calc(Intermittent, SupplyRegion_SUB, cyr) := (PVFOML(SupplyRegion_SUB, Intermittent) + PVTOML(SupplyRegion_SUB, Intermittent)) /$ PVGNP(SupplyRegion_SUB, Intermittent);
				EPLVVOM_calc(Intermittent, SupplyRegion_SUB, cyr) := PVVOML(SupplyRegion_SUB, Intermittent) /$ PVGNP(SupplyRegion_SUB, Intermittent);
				EPLVEXT_calc(Intermittent, SupplyRegion_SUB, cyr) := (- PVSOML(SupplyRegion_SUB, Intermittent)) /$ PVGNP(SupplyRegion_SUB, Intermittent);
				EPLVFLC_calc(Intermittent, SupplyRegion_SUB, cyr) := 0.0;
				
				
				
				
				
				ITCADJ((Intermittent, PlanYear) | OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent)):=
				IF ((UPGSUB(Intermittent) > 0.0 AND (CURIYR('1')+OLYEAR(PlanYear, Intermittent) - 1) >= (UPGSY1(Intermittent) - UHBSYR('1')) AND
				(CURIYR('1')+OLYEAR(PlanYear, Intermittent) - 1) <= (UPGSYL(Intermittent) - UHBSYR('1'))) OR
				(UPGSUBPT(Intermittent) > 0 AND UPGSUBYR(Intermittent,element(MNUMYR_,min(UNYEAR('1') , CURIYR('1')+OLYEAR(PlanYear, Intermittent) - 1))) > 0.0)) THEN
				        1.0-UPCSB(Intermittent)
				ELSE
				        1.0
				ENDIF;
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(Intermittent):=(UPANNADJ(Intermittent, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(Intermittent, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((Intermittent, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(Intermittent, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(Intermittent, last(MNUMYR)) * ANNRTE(Intermittent) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, Intermittent, PlanYear) | OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				        (UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				if OLYEAR(PlanYear, Intermittent)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, Intermittent)-1) <= UNYEAR('1') THEN
				        UPANNADJ(Intermittent, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, Intermittent)-1))
				  ELSE
				        UPANNADJ(Intermittent, last(MNUMYR)) * ANNRTE(Intermittent) ^ ((CURIYR('1')+OLYEAR(PlanYear, Intermittent)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(Intermittent, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(Intermittent, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				OVRCST((SupplyRegion_SUB, Intermittent, PlanYear,OwnerType,ElasticityStep,subsidy_type)|
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				IF (UPSUBCAS(Intermittent)= 2 AND Subsidy_Case(PlanYear, Intermittent)=2)THEN
				   IF subsidy_type='X' THEN
				        (EPIROVR(IntStor(Intermittent), SupplyRegion_SUB, cyr) / (1.0 - UPCSB(Intermittent))) * UPLRPC(Intermittent) * UPLROPT(Intermittent) * UPLRLC(Intermittent) *
				        EPRGM(Intermittent, SupplyRegion_SUB, cyr) * EPACM(Intermittent, SupplyRegion_SUB, cyr) *
				        EPCCSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) *
				        ANNADJ(SupplyRegion_SUB, Intermittent, PlanYear)
				   ELSE
				        EPIROVR(IntStor(Intermittent), SupplyRegion_SUB, cyr) * UPLRPC(Intermittent) * UPLROPT(Intermittent) * UPLRLC(Intermittent) *
				        EPRGM(Intermittent, SupplyRegion_SUB, cyr) * EPACM(Intermittent, SupplyRegion_SUB, cyr) *
				        EPCCSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) * ANNADJ(SupplyRegion_SUB, Intermittent, PlanYear)
				   ENDIF
				 ELSE
				   (EPIROVR(IntStor(Intermittent), SupplyRegion_SUB, cyr)/ITCADJ(Intermittent, PlanYear)) * UPLRPC(Intermittent) * UPLROPT(Intermittent) * UPLRLC(Intermittent) *
				   EPRGM(Intermittent, SupplyRegion_SUB, cyr) * EPACM(Intermittent, SupplyRegion_SUB, cyr) *
				   EPCCSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) * ANNADJ(SupplyRegion_SUB, Intermittent, PlanYear)
				ENDIF;
				
				!EPINCST;
				Condition_INT((SupplyRegion_SUB,Intermittent,PlanYear,OwnerType,ElasticityStep,subsidy_type) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=1;
				
				ROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type)
				endif;
				
				INTR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type)
				endif;
				EPINCST_p(
					PLTS         : Intermittent_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_INT(SupplyRegion_SUB,Intermittent,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					CLT          : UPCLYR(Intermittent) ,
					PLT          : UPPLYR(Intermittent) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PROFILE      : UPCPRO(Intermittent, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, Intermittent) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				TXBOOK(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) / $
				FNBOOK(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				CAPNNSTL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				FNBOOK(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				
				!CAPNUG((SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				!UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				!UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				!(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				!! The function EPCNBLD_f is used here. The procedure EPCNBLD can be used alternatively to save time.
				!if ord(OwnerType)=2 then
				!EPCNBLD_f(DEBT_F(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type),PRATIO(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type),
				!UPNRPRM('1'),UPNIPRM('1'),UTROE(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type),UTINT(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type),
				!UPTXRT('1'), UPTXLF(Intermittent),UPNCLF(Intermittent),UPNLLF(Intermittent))
				!elseif ord(OwnerType)=1 then
				!EPNBLD_f(UTROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, subsidy_type),(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(Intermittent)),
				!PRATIO(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type),EPUFPE(('1'), SupplyRegion_SUB, cyr),
				!UPECLF(Intermittent),UPTXLF(Intermittent),UPTXRT('1'),UPUCLF(Intermittent))
				!endif;
				
				DR_EPNBLD(SupplyRegion_SUB, Intermittent):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(Intermittent));
				EPNBLD_p(
					PLTS         : Intermittent_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_INT(SupplyRegion_SUB,Intermittent,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					ROR    : UTROR(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType1, subsidy_type) ,
					DR     : DR_EPNBLD(SupplyRegion_SUB, Intermittent) ,
					RATIO  : PRATIO(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType1, ElasticityStep, subsidy_type) ,
					PE     : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL     : UPECLF(Intermittent) ,
					TL     : UPTXLF(Intermittent) ,
					T      : UPTXRT('1') ,
					CL     : UPUCLF(Intermittent) ,
					NBLDP1 : CAPUTIL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType1, ElasticityStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS         : Intermittent_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_INT(SupplyRegion_SUB,Intermittent,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					DF2    : DEBT_F(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType2, subsidy_type) ,
					RATIO  : PRATIO(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType2, ElasticityStep, subsidy_type) ,
					ROEPRM : UPNRPRM('1') ,
					INTPRM : UPNIPRM('1') ,
					UTROE  : UTROE(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType2, subsidy_type) ,
					UTINT  : UTINT(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType2, subsidy_type) ,
					TR     : UPTXRT('1') ,
					TL     : UPTXLF(Intermittent) ,
					CL     : UPNCLF(Intermittent) ,
					DL2    : UPNLLF(Intermittent) ,
					CAP    : CAPNUG(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType2, ElasticityStep, subsidy_type) );
				CAP((SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_INT(SupplyRegion_SUB,Intermittent,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, Intermittent, PlanYear) := (EPCOVR(Intermittent, SupplyRegion_SUB, cyr) + EPCTRM(Intermittent, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, Intermittent)+CURIYR('1')-1))) * EPCCRF(Intermittent, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				(( CAPNNSTL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, Intermittent, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(Intermittent)),(UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(Intermittent)),OLYEAR(PlanYear, Intermittent));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cIX_ECPCOSTS((SupplyRegion_SUB, Intermittent, OwnerType, ElasticityStep, PlanYear) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				IF (UPSUBCAS(Intermittent)= 1 AND Subsidy_Case(PlanYear, Intermittent)=2) THEN
				        OBJVAL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				        EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				        PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) +
				        PVARB(SupplyRegion_SUB, Intermittent, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				        EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				        PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) -
				        PVSOM(SupplyRegion_SUB, Intermittent, PlanYear) + PVARB(SupplyRegion_SUB, Intermittent, PlanYear)
				ENDIF;
				
				ccalc_cIS_ECPCOSTS((SupplyRegion_SUB, Intermittent, OwnerType, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, Intermittent)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) ):=
				OBJVAL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) -
				PVSOM(SupplyRegion_SUB, Intermittent, PlanYear) + PVARB(SupplyRegion_SUB, Intermittent, PlanYear);
				
				!PURCHASED CAPACITY ROW
				ccalc_cIX_rPXXXXXn((SupplyRegion_SUB, PlanYear, Intermittent, OwnerType, ElasticityStep, PlanYear_ALTB) | UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and
				OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear_ALTB, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				0.001 * OBJVAL(SupplyRegion_SUB, Intermittent, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X);
				
				ccalc_cIS_rPXXXXXn((SupplyRegion_SUB, PlanYear, Intermittent, OwnerType, ElasticityStep, PlanYear_ALTB) | Subsidy_Case(PlanYear_ALTB, Intermittent)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and
				OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear_ALTB, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0)):=
				0.001 * OBJVAL(SupplyRegion_SUB, Intermittent, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S);
				
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) | UPBLDREG(Intermittent, SupplyRegion)> 0.0 and
				Condition_INT(SupplyRegion, Intermittent, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), ElasticityStep1, SubsidyType_X)) :=Subsidy_Case(PlanYear, Intermittent);
				
				!COMPUTE LEVELIZED CAPITAL COST AND FIXED CHARGE FACTOR--NUGS
				subsidy_type0(PlanYear, Intermittent):=element(Subsidy_Type_, Subsidy_Case(PlanYear, Intermittent)) ;
				EPLVCAP_calc(Intermittent, OwnerType, SupplyRegion_SUB, cyr):=
				(( CAP(SupplyRegion_SUB, Intermittent, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), Intermittent)) *
				CAPUTIL(SupplyRegion_SUB, Intermittent, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), Intermittent)) ) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, Intermittent) ,(UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, Intermittent),OLYEAR(first(PlanYear), Intermittent)) /$ PVGNP(SupplyRegion_SUB, Intermittent);
				
				
				EPLVFCF_calc(Intermittent, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(Intermittent, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, Intermittent, first(PlanYear),OwnerType,ElasticityStep1,subsidy_type0(first(PlanYear), Intermittent));
				
				EPLVTRN_calc(Intermittent, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, Intermittent, first(PlanYear)) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, Intermittent),(UNFPH('1') - OLYEAR(first(PlanYear), Intermittent) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, Intermittent) ,OLYEAR(first(PlanYear), Intermittent)) /$ PVGNP(SupplyRegion_SUB, Intermittent);
				
				EPLVBCK_calc(Intermittent, SupplyRegion_SUB, cyr):=EPIRCCR(IntStor(Intermittent), SupplyRegion_SUB, cyr);
				
				!REVISE OBJECTIVE FUNCTION COEFFICIENT
				TRANS1((SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear)| MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ)) :=
				EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, Intermittent)+CURIYR('1')-1))) * EPCCRF(Intermittent, SupplyRegion_SUB, cyr);
				
				OBJVAL1((SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear, OwnerType, ElasticityStep, subsidy_type) |  MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) and
				UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr)<9999):=
				(( CAPNNSTL(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, Intermittent, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(Intermittent)),(UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(Intermittent)),OLYEAR(PlanYear, Intermittent));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				!CHECK FOR SUBSIDY LIMIT FOR PTC -- EXCLUDE FOR UNSUBSIDIZED CAPACITY
				ccalc_cI_IMP_ECPCOSTS((SupplyRegion_SUB, Intermittent, OwnerType, SupplyRegion_ALTZ, ElasticityStep, PlanYear) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) and MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ) and
				UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr)<9999):=
				IF (UPSUBCAS(Intermittent)= 1 AND Subsidy_Case(PlanYear, Intermittent)=2) THEN
				        OBJVAL1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				        EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				        PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) +
				        PVARB(SupplyRegion_SUB, Intermittent, PlanYear)
				ELSE
				        OBJVAL1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				        EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				        PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) -
				        PVSOM(SupplyRegion_SUB, Intermittent, PlanYear) + PVARB(SupplyRegion_SUB, Intermittent, PlanYear)
				ENDIF;
				
				ccalc_cI_SUBIMP_ECPCOSTS((SupplyRegion_SUB, Intermittent, OwnerType, SupplyRegion_ALTZ, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, Intermittent)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) and MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ) and
				UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr)<9999):=
				OBJVAL1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, Intermittent, PlanYear) *
				EPFXSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, Intermittent, PlanYear) +
				PVVOM(SupplyRegion_SUB, Intermittent, PlanYear) * EPVRSUP(IntStor(Intermittent), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) -
				PVSOM(SupplyRegion_SUB, Intermittent, PlanYear) + PVARB(SupplyRegion_SUB, Intermittent, PlanYear);
				
				ccalc_cI_IMP_rPXXXXXn((SupplyRegion_ALTZ, PlanYear, SupplyRegion_SUB, Intermittent, OwnerType, SupplyRegion_ALTZ, ElasticityStep, PlanYear_ALTB) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) and MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ) and
				UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr)<9999):=
				0.001 * OBJVAL1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X);
				
				ccalc_cI_SUBIMP_rPXXXXXn((SupplyRegion_ALTZ, PlanYear, SupplyRegion_SUB, Intermittent, OwnerType, SupplyRegion_ALTZ, ElasticityStep, PlanYear_ALTB) | Subsidy_Case(PlanYear_ALTB, Intermittent)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) AND UPVTYP(Intermittent)= 1 and
				UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear, Intermittent) AND (UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0) AND
				(UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUB) > 0) and MAP_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ) and
				UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUB, Counter_ImportRegion(SupplyRegion_SUB, SupplyRegion_ALTZ), cyr)<9999):=
				0.001 * OBJVAL1(SupplyRegion_SUB, Intermittent, SupplyRegion_ALTZ, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S);
			}
			Comment: {
				"Calculates coefficients for EP$INT subroutine: ccalc_cIX_ECPCOSTS and ccalc_cIS_ECPCOSTS; ccalc_cI_IMP_ECPCOSTS and ccalc_cI_SUBIMP_ECPCOSTS;
				ccalc_cIX_rPXXXXXn and ccalc_cIS_rPXXXXXn"
			}
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, PlantType, PlanYear);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter TRANS1 {
					IndexDomain: (SupplyRegion, PlantType, SupplyRegion_ALTZ, PlanYear);
				}
				Parameter OBJVAL1 {
					IndexDomain: (SupplyRegion, PlantType, SupplyRegion_ALTZ, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,ElasticityStep,subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter TOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVTOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DR_EPNBLD {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_INT {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
			}
		}
		Procedure Calculate_NUCBLDCOSTS {
			Body: {
				! DETERMINE PRESENT VALUE OF PRODUCTION TAX CREDIT SUBSIDIES
				DSCRT(SupplyRegion_SUB, NUCs):=EPDSCRT(('1'), SupplyRegion_SUB, cyr) ;
				DSCRT_WRSK(SupplyRegion_SUB, NUCs):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(NUCs));
				
				
				FLCST((SupplyRegion_SUB, NUCs, PlanYear)| OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) := sum(PlanYear_ALTB| ord(PlanYear_ALTB)>=OLYEAR(PlanYear, NUCs),
				!UPMCF(NUCs) * 8.760 * !AVG_HTRT(NUCs, NUCFuelRegion(NUCs), SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) *
				!AVG_HTRT(NUCs, FuelRegion0, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) *
				!UPPFL(ECPFuelType, FuelRegion, ExplicitPlanningHorizon)(FUEL,IRG,JYR)
				UPMCF(NUCs) * NUCFLPRC(SupplyRegion_SUB,Element(CommitYear_,ORD(PlanYear_ALTB)))*8.76 *
				AVG_HTRT(NUCs,Element(FuelRegion_,NUCFLRG(SupplyRegion_SUB)),SupplyRegion_SUB,Element(ExplicitPlanningHorizon_,ORD(PlanYear_ALTB))))
				* 0.001;
				FLCSTL((SupplyRegion_SUB, NUCs)|  UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) :=
				!UPMCF(NUCs) * 8.760 * AVG_HTRT(NUCs, FuelRegion0, SupplyRegion_SUB, first(ExplicitPlanningHorizon)) *
				!UPPFL(ECPFuelType, FuelRegion, ExplicitPlanningHorizon)(FUEL,IRG,JYR)
				UPMCF(NUCs) * NUCFLPRC(SupplyRegion_SUB,first(CommitYear))*8.76 *
				AVG_HTRT(NUCs,Element(FuelRegion_,NUCFLRG(SupplyRegion_SUB)),SupplyRegion_SUB,first(ExplicitPlanningHorizon))
				* 0.001;
				
				SOM((SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(NUCs) and
				((UPGSUB(NUCs) >0 AND (CURIYR('1') + OLYEAR(PlanYear, NUCs) - 1) >= (UPGSY1(NUCs) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, NUCs) - 1) <= (UPGSYL(NUCs) - UHBSYR('1'))) OR
				(UPGSUBPT(NUCs) > 0 AND UPGSUBYR(NUCs, OLYEAR_MNUMYR(PlanYear, NUCs))> 0))) :=
				if OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 then
				IF (UPGSUBPT(NUCs)<= 0) THEN
				        UPGSUB(NUCs) * 8.76 * UPMCF(NUCs)
				ELSE
				        UPGSUBYR(NUCs, OLYEAR_MNUMYR(PlanYear, NUCs)) * 8.76 * UPMCF(NUCs)
				ENDIF
				endif;
				!CHECK IF PTC IS CAPPED
				SOM((SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon)| UPGSMX(NUCs)>0):= MIN(SOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon),UPGSMX(NUCs));
				!IF PTC IS REAL, THEN APPLY DEFLATOR
				SOM((SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon)| UPGSTY(NUCs)<=0) *= UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, NUCs, PlanYear));
				!ADJUST FOR TAX BENEFIT
				SOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon) /= 1.0 - UPTXRT('1');
				SOML((SupplyRegion_SUB, NUCs, FullPlanningHorizon)|
				ord(FullPlanningHorizon)<=UPGSYR(NUCs) and UPVTYP(NUCs)= 1 and
				UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND (UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000):=
				SOM(SupplyRegion_SUB, NUCs, first(PlanYear), FullPlanningHorizon)/
				(8.76 * UPMCF(NUCs));  !only for PlanYear=1
				PVSOM(SupplyRegion_SUB, NUCs, PlanYear) :=
				if OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(NUCs),
				!PVV_Function(SOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)))*
				SOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs),OLYEAR(PlanYear, NUCs)-1)
				else
				0
				endif;
				PVSOML(SupplyRegion_SUB, NUCs) :=
				if OLYEAR(first(PlanYear), NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(NUCs),
				!PVV_Function(SOML(SupplyRegion_SUB, NUCs, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)))*
				SOML(SupplyRegion_SUB, NUCs, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs),OLYEAR(first(PlanYear_), NUCs)-1)
				else
				0
				endif;
				
				!DETERMINE PRESENT VALUE OF FIXED O&M AT OLYR INCLUDE EXTERNALITY COSTS, IF ANY
				
				FOM((SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)>=OLYEAR(PlanYear, NUCs) and
				OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) :=
				EPFOM(NUCs, SupplyRegion_SUB, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
				
				VOM((SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)>=OLYEAR(PlanYear, NUCs) and
				OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) :=
				UPMCF(NUCs) * 8.76 * EPVOM(NUCs, SupplyRegion_SUB, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
				
				!GPS are not converted, exist but not used in FORTRAN  */
				
				FOML((SupplyRegion_SUB, NUCs, FullPlanningHorizon)| ord(FullPlanningHorizon)<=(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1) and
				UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) :=
				EPFOM(NUCs, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, NUCs, first(PlanYear)));
				
				VOML((SupplyRegion_SUB, NUCs, FullPlanningHorizon)| ord(FullPlanningHorizon)<=(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1) and
				UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000) :=
				EPVOM(NUCs, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, NUCs, first(PlanYear)));
				
				PVFOM((SupplyRegion_SUB, NUCs, PlanYear)| OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				sum(FullPlanningHorizon, !PVV_Function(FOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)));
				FOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)));
				
				PVVOM((SupplyRegion_SUB, NUCs, PlanYear)|OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				sum(FullPlanningHorizon, !PVV_Function(VOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)));
				VOM(SupplyRegion_SUB, NUCs, PlanYear, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)));
				
				!PV$GPS are not converted, exist but not used in FORTRAN  */
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY COSTS
				PVFOML((SupplyRegion_SUB, NUCs)| UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1,
				! PVV_Function(FOML(SupplyRegion_SUB, NUCs,FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)))*
				FOML(SupplyRegion_SUB, NUCs,FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs),OLYEAR(first(PlanYear_), NUCs)-1);
				
				PVVOML((SupplyRegion_SUB, NUCs)| UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1,
				! PVV_Function(VOML(SupplyRegion_SUB, NUCs, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, NUCs)))*
				VOML(SupplyRegion_SUB, NUCs, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, NUCs)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs),OLYEAR(first(PlanYear_), NUCs)-1);
				
				
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(NUCs):=(UPANNADJ(NUCs, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(NUCs, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((NUCs, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(NUCs, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(NUCs, last(MNUMYR)) * ANNRTE(NUCs) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, NUCs, PlanYear) | OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and
				UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND (UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND
				UPOVR(NUCs) < 9000):=
				if OLYEAR(PlanYear, NUCs)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, NUCs)-1) <= UNYEAR('1') THEN
				        UPANNADJ(NUCs, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, NUCs)-1))
				  ELSE
				        UPANNADJ(NUCs, last(MNUMYR)) * ANNRTE(NUCs) ^ ((CURIYR('1')+OLYEAR(PlanYear, NUCs)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(NUCs, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(NUCs, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				Condition_NUC((SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type) | ORD(ElasticityStep) <= MAX(1,ESTSWTCH(NUCs)) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and
				UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND (UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND
				UPOVR(NUCs) < 9000):=1;
				
				OVRCST((SupplyRegion_SUB, NUCs, PlanYear,OwnerType,ElasticityStep,subsidy_type)|
				Condition_NUC(SupplyRegion_SUB, NUCs, PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				UPOVR(NUCs) * UPLRPC(NUCs) * UPLROPT(NUCs) * UPLRLC(NUCs) * EPRGM(NUCs, SupplyRegion_SUB, cyr) * EPACM(NUCs, SupplyRegion_SUB, cyr) *
				ESTCPCST(NUCs, ElasticityStep) * ANNADJ(SupplyRegion_SUB, NUCs, PlanYear);
				OVRCST((SupplyRegion_SUB, NUCs, PlanYear,OwnerType,ElasticityStep,SubsidyType_X)| UPSUBCAS(NUCs)= 2 AND Subsidy_Case(PlanYear, NUCs)=2)/=
				      (1.0 - UPCSB(NUCs));
				
				
				
				ROR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type)
				endif;
				
				INTR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type)
				endif;
				EPINCST_p(
					PLTS         : NUC_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					CLT          : UPCLYR(NUCs) ,
					PLT          : UPPLYR(NUCs) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PROFILE      : UPCPRO(NUCs, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, NUCs) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				TXBOOK(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) / $
				FNBOOK(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				CAPNNSTL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				FNBOOK(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				
				
				EPNBLD_p(
					PLTS         : NUC_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					ROR          : UTROR(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					DR           : DSCRT(SupplyRegion_SUB, NUCs) ,
					RATIO        : PRATIO(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PE           : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL           : UPECLF(NUCs) ,
					TL           : UPTXLF(NUCs) ,
					T            : UPTXRT('1') ,
					CL           : UPUCLF(NUCs) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS         : NUC_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					DF2          : DEBT_F(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					RATIO        : PRATIO(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					ROEPRM       : UPNRPRM('1') ,
					INTPRM       : UPNIPRM('1') ,
					UTROE        : UTROE(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					UTINT        : UTINT(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, subsidy_type) ,
					TR           : UPTXRT('1') ,
					TL           : UPTXLF(NUCs) ,
					CL           : UPNCLF(NUCs) ,
					DL2          : UPNLLF(NUCs) ,
					CAP          : CAPNUG(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				CAP((SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, NUCs, PlanYear) := (EPCOVR(NUCs, SupplyRegion_SUB, cyr) + EPCTRM(NUCs, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, NUCs)+CURIYR('1')-1))) * EPCCRF(NUCs, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				(( CAPNNSTL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, NUCs, PlanYear) ) / $
				CRF_f(EPDSCRT('1', SupplyRegion_SUB, cyr) ,(UNFPH('1') - OLYEAR(PlanYear, NUCs) + 1)) ) *
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, NUCs));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cBXNUC_ECPCOSTS((SupplyRegion_SUB, NUCs, OwnerType, ElasticityStep, PlanYear) |
				ORD(ElasticityStep) <= MAX(1,ESTSWTCH(NUCs)) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and
				UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND (UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND
				UPOVR(NUCs) < 9000):=
				IF (UPSUBCAS(NUCs)= 1 AND Subsidy_Case(PlanYear, NUCs)=2) THEN
				        OBJVAL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, NUCs, PlanYear)  +
				        PVVOM(SupplyRegion_SUB, NUCs, PlanYear)  + FLCST(SupplyRegion_SUB, NUCs, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, NUCs, PlanYear)  +
				        PVVOM(SupplyRegion_SUB, NUCs, PlanYear)  + FLCST(SupplyRegion_SUB, NUCs, PlanYear) -
				        PVSOM(SupplyRegion_SUB, NUCs, PlanYear)
				ENDIF;
				!
				ccalc_cBSNUC_ECPCOSTS((SupplyRegion_SUB, NUCs, OwnerType, ElasticityStep, PlanYear) |
				ORD(ElasticityStep) <= MAX(1,ESTSWTCH(NUCs)) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, NUCs) <= UNXPH('1') AND UPVTYP(NUCs)= 1 and
				UPAVLYR(NUCs)<= FULLYEAR_ALT(PlanYear, NUCs) AND (UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND
				UPOVR(NUCs) < 9000 and Subsidy_Case(PlanYear, NUCs)=2):=
				!if UPSUBFCF (IECP)> 0 then  !UPSUBFCF not passed currently all plants set to 0
				OBJVAL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, NUCs, PlanYear) +
				PVVOM(SupplyRegion_SUB, NUCs, PlanYear)  + FLCST(SupplyRegion_SUB, NUCs, PlanYear) - PVSOM(SupplyRegion_SUB, NUCs, PlanYear)  ;
				!
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((NUCs, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) | UPBLDREG(NUCs, SupplyRegion)> 0.0 and
				Condition_NUC(SupplyRegion, NUCs, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), ElasticityStep1, SubsidyType_X)) :=Subsidy_Case(PlanYear, NUCs);
				
				subsidy_type0(PlanYear, NUCs):=element(Subsidy_Type_, Subsidy_Case(PlanYear, NUCs)) ;
				!PVGNPR((SupplyRegion_SUB, NUCs)| UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				!(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				! EP_LGNP_f(OLYEAR(first(PlanYear), NUCs),(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1),
				!(EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(NUCs)));
				PVGNP((SupplyRegion_SUB, NUCs)| UPVTYP(NUCs)= 1 and UPAVLYR(NUCs)<= FULLYEAR_ALT(first(PlanYear), NUCs) AND
				(UPBLDREG_us00(NUCs)> 0 AND UPBLDREG(NUCs, SupplyRegion_SUB)>0) AND UPOVR(NUCs) < 9000 ) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), NUCs),(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				
				EPLVFOM_calc(NUCs, SupplyRegion_SUB, cyr) := PVFOML(SupplyRegion_SUB, NUCs)  /$ PVGNP(SupplyRegion_SUB, NUCs);
				EPLVVOM_calc(NUCs, SupplyRegion_SUB, cyr) := PVVOML(SupplyRegion_SUB, NUCs) /$ PVGNP(SupplyRegion_SUB, NUCs);
				EPLVEXT_calc(NUCs, SupplyRegion_SUB, cyr) := ( - PVSOML(SupplyRegion_SUB, NUCs)) /$ PVGNP(SupplyRegion_SUB, NUCs);
				EPLVFLC_calc(NUCs, SupplyRegion_SUB, cyr) := FLCSTL(SupplyRegion_SUB, NUCs) /$ PVGNP(SupplyRegion_SUB, NUCs);
				EPLVCAP_calc(NUCs, OwnerType, SupplyRegion_SUB, cyr):=
				if ord(OwnerType)=1 then
				(( CAPNNSTL(SupplyRegion_SUB, NUCs, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), NUCs)) *
				CAPUTIL(SupplyRegion_SUB, NUCs, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), NUCs)) ) /
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, NUCs) ,(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, NUCs),OLYEAR(first(PlanYear), NUCs)) /$ PVGNP(SupplyRegion_SUB, NUCs)
				else
				(( CAPNNSTL(SupplyRegion_SUB, NUCs, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), NUCs)) *
				CAPNUG(SupplyRegion_SUB, NUCs, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), NUCs)) ) /
				CRF_f(DSCRT(SupplyRegion_SUB, NUCs),(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1)) ) *
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs),OLYEAR(first(PlanYear), NUCs)) /$ PVGNP(SupplyRegion_SUB, NUCs)
				endif;
				
				EPLVFCF_calc(NUCs, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(NUCs, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, NUCs, first(PlanYear),OwnerType,ElasticityStep1,subsidy_type0(first(PlanYear), NUCs));
				
				EPLVTRN_calc(NUCs, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, NUCs, first(PlanYear)) /
				CRF_f(DSCRT(SupplyRegion_SUB, NUCs),(UNFPH('1') - OLYEAR(first(PlanYear), NUCs) + 1)) ) *
				PWF_f(DSCRT(SupplyRegion_SUB, NUCs) ,OLYEAR(first(PlanYear), NUCs)) /$ PVGNP(SupplyRegion_SUB, NUCs);
				
				EPLVBCK_calc(NUCs, SupplyRegion_SUB, cyr):=1;
				
				
				
				!!temp calc
				!PVCAP_temp((SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				!Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				! CAPNNSTL(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				!CAP(SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type)  /
				!CRF_f(EPDSCRT('1', SupplyRegion_SUB, cyr) ,(UNFPH('1') - OLYEAR(PlanYear, NUCs) + 1))  *
				!PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, NUCs));
				!PVTRN_temp((SupplyRegion_SUB, NUCs, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				!Condition_NUC(SupplyRegion_SUB,NUCs,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				!TRANS(SupplyRegion_SUB, NUCs, PlanYear) /
				!CRF_f(EPDSCRT('1', SupplyRegion_SUB, cyr) ,(UNFPH('1') - OLYEAR(PlanYear, NUCs) + 1)) *
				!PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, NUCs));
				!FLCST_temp(SupplyRegion_SUB, NUCs, PlanYear):=FLCST(SupplyRegion_SUB, NUCs, PlanYear);
				!PVFOM_temp(SupplyRegion_SUB, NUCs, PlanYear):=PVFOM(SupplyRegion_SUB, NUCs, PlanYear);
				!PVVOM_temp(SupplyRegion_SUB, NUCs, PlanYear):=PVVOM(SupplyRegion_SUB, NUCs, PlanYear);
				!PVSOM_temp(SupplyRegion_SUB, NUCs, PlanYear):=PVSOM(SupplyRegion_SUB, NUCs, PlanYear);
				!
			}
			Comment: "Calculates costs for EP$NUC subroutine: ccalc_cBXNUC_ECPCOSTS and ccalc_cBSNUC_ECPCOSTS";
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, PlantType, PlanYear);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,ElasticityStep,subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter TOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVTOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DSCRT {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter DSCRT_WRSK {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_NUC {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FLCST {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter FLCSTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
			}
		}
		Procedure Calculate_STORAGECOSTS {
			Body: {
				!DETERMINE PRESENT VALUE OF FIXED O&M AT OLYR INCLUDE EXTERNALITY COSTS, IF ANY
				ARB((SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon)| CURIYR('1') + OLYEAR(PlanYear, WIDS_Element) + UHBSYR('1') - 1 >= UPAVLYR(WIDS_Element)
				and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1) :=
				(OFFSET(SupplyRegion_SUB) - STORAGE_PROFIT(SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIDS_Element, PlanYear));
				
				FOM((SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon)| CURIYR('1') + OLYEAR(PlanYear, WIDS_Element) + UHBSYR('1') - 1 >= UPAVLYR(WIDS_Element)
				and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1):=
				EPFOM(WIDS_Element, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIDS_Element, PlanYear));
				
				VOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon):=0;
				
				TOM((SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon)| CURIYR('1') + OLYEAR(PlanYear, WIDS_Element) + UHBSYR('1') - 1 >= UPAVLYR(WIDS_Element)
				and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1):=
				EPCFOM(WIDS_Element, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIDS_Element, PlanYear));
				
				!EXTR((SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon)|
				!(EPECAP(FuelRegion0, Intermittent, ExplicitPlanningHorizon_element(first(PlanYear)), SupplyRegion_SUB, cyr)>0 OR
				!(UPVTYP(Intermittent)= 1 AND UPBLDREG(Intermittent, SupplyRegion_SUB)>0)) and ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1) :=
				!(EPEXT(Intermittent, last(EmissionType_SUP_), SupplyRegion_SUB, cyr) * 8.76 * EPIACF(Intermittent, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, Intermittent, PlanYear));
				
				FOML((SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1) :=
				EPFOM(WIDS_Element, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIDS_Element, first(PlanYear)));
				
				VOML((SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1) :=
				EPVOM(WIDS_Element, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, WIDS_Element, first(PlanYear)));
				
				!EXTR and EXTL not computed here since not used in FORTRAN
				
				PVARB(SupplyRegion_SUB, WIDS_Element, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1,
				!PVV_Function(ARB(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1'))) *
				ARB(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1')) ^ ord(FullPlanningHorizon)))*
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) + Battery_Extra_Discount('1')),OLYEAR(PlanYear, WIDS_Element)-1);
				
				PVFOM(SupplyRegion_SUB, WIDS_Element, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1,
				!PVV_Function(FOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, WIDS_Element)-1);
				
				PVVOM(SupplyRegion_SUB, WIDS_Element, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1,
				!PVV_Function(VOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, WIDS_Element)-1);
				
				PVTOM(SupplyRegion_SUB, WIDS_Element, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1,
				!PVV_Function(TOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				TOM(SupplyRegion_SUB, WIDS_Element, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, WIDS_Element)-1);
				
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY AND EXTERNALITY COSTS
				PVFOML(SupplyRegion_SUB, WIDS_Element) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1,
				!PVV_Function(FOML(SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOML(SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), WIDS_Element)-1);
				
				PVVOML(SupplyRegion_SUB, WIDS_Element) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1,
				!PVV_Function(VOML(SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOML(SupplyRegion_SUB, WIDS_Element, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), WIDS_Element)-1);
				
				PVSOM(SupplyRegion_SUB, WIDS_Element, PlanYear) :=0;
				PVSOML(SupplyRegion_SUB, WIDS_Element) :=0;
				
				PVGNPR(SupplyRegion_SUB, WIDS_Element) := EP_LGNP_f(OLYEAR(first(PlanYear), WIDS_Element),(UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1),
				(EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIDS_Element)));
				PVGNP(SupplyRegion_SUB, WIDS_Element) := EP_LGNP_f(OLYEAR(first(PlanYear), WIDS_Element),(UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				EPLVFOM_calc(WIDS_Element, SupplyRegion_SUB, cyr) := (PVFOML(SupplyRegion_SUB, WIDS_Element)) / PVGNP(SupplyRegion_SUB, WIDS_Element);
				EPLVVOM_calc(WIDS_Element, SupplyRegion_SUB, cyr) := PVVOML(SupplyRegion_SUB, WIDS_Element) / PVGNP(SupplyRegion_SUB, WIDS_Element);
				EPLVEXT_calc(WIDS_Element, SupplyRegion_SUB, cyr) := ( - PVSOML(SupplyRegion_SUB, WIDS_Element)) / PVGNP(SupplyRegion_SUB, WIDS_Element);
				EPLVFLC_calc(WIDS_Element, SupplyRegion_SUB, cyr) := -STO_IN_COST2(SupplyRegion_SUB)/ $ STO_OUT_GEN2(SupplyRegion_SUB) * (STO_OUT_CF2_AVG(SupplyRegion_SUB)/0.1);
				
				
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(WIDS_Element):=(UPANNADJ(WIDS_Element, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(WIDS_Element, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((WIDS_Element, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(WIDS_Element, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(WIDS_Element, last(MNUMYR)) * ANNRTE(WIDS_Element) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, WIDS_Element, PlanYear) | OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element) ):=
				if OLYEAR(PlanYear, WIDS_Element)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, WIDS_Element)-1) <= UNYEAR('1') THEN
				        UPANNADJ(WIDS_Element, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, WIDS_Element)-1))
				  ELSE
				        UPANNADJ(WIDS_Element, last(MNUMYR)) * ANNRTE(WIDS_Element) ^ ((CURIYR('1')+OLYEAR(PlanYear, WIDS_Element)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(WIDS_Element, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(WIDS_Element, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				OVRCST((SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X)| OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element) ):= UPOVR(WIDS_Element) * UPLRPC(WIDS_Element) * UPLROPT(WIDS_Element) * UPLRLC(WIDS_Element) *
				EPRGM(WIDS_Element, SupplyRegion_SUB, cyr) * EPACM(WIDS_Element, SupplyRegion_SUB, cyr) * ANNADJ(SupplyRegion_SUB, WIDS_Element, PlanYear);
				
				Condition_DS((SupplyRegion_SUB,WIDS_Element,PlanYear,OwnerType,ElasticityStep,subsidy_type)| OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element) and UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and
				ElasticityStep=ElasticityStep1 and subsidy_type=SubsidyType_X ):=1;
				
				ROR(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X)
				endif;
				
				INTR(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion, WIDS_Element, PlanYear, OwnerType, SubsidyType_X)
				endif;
				
				EPINCST_p(
					PLTS         : PlantType_DS_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DS(SupplyRegion_SUB,PlantDS,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					CLT          : UPCLYR(PlantDS) ,
					PLT          : UPPLYR(PlantDS) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PROFILE      : UPCPRO(PlantDS, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, PlantDS) ,   !Possibly assign MNUMYRX=1
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) :=
				TXBOOK(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) / $
				FNBOOK(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X);
				CAPNNSTL(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) :=
				FNBOOK(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X);
				
				!CAPNUG((SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) |
				!UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				!UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element)):=
				! The function EPCNBLD_f is used here. The procedure EPCNBLD can be used alternatively to save time.
				!if ord(OwnerType)=2 then
				!EPCNBLD_f(DEBT_F(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, SubsidyType_X),PRATIO(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X),
				!UPNRPRM('1'),UPNIPRM('1'),UTROE(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, SubsidyType_X),UTINT(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, SubsidyType_X),
				!UPTXRT('1'), UPTXLF(WIDS_Element),UPNCLF(WIDS_Element),UPNLLF(WIDS_Element))
				!elseif ord(OwnerType)=1 then
				!EPNBLD_f(UTROR(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, SubsidyType_X),(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(WIDS_Element)),
				!PRATIO(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X),EPUFPE(('1'), SupplyRegion_SUB, cyr),
				!UPECLF(WIDS_Element),UPTXLF(WIDS_Element),UPTXRT('1'),UPUCLF(WIDS_Element))
				!endif;
				
				DR_EPNBLD(SupplyRegion_SUB, WIDS_Element):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(WIDS_Element));
				EPNBLD_p(
					PLTS         : PlantType_DS_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DS(SupplyRegion_SUB,PlantDS,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					ROR          : UTROR(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, PlantDS) ,
					RATIO        : PRATIO(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PE           : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL           : UPECLF(PlantDS) ,
					TL           : UPTXLF(PlantDS) ,
					T            : UPTXRT('1') ,
					CL           : UPUCLF(PlantDS) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS         : PlantType_DS_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DS(SupplyRegion_SUB,PlantDS,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					DF2          : DEBT_F(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					RATIO        : PRATIO(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					ROEPRM       : UPNRPRM('1') ,
					INTPRM       : UPNIPRM('1') ,
					UTROE        : UTROE(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					UTINT        : UTINT(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, subsidy_type) ,
					TR           : UPTXRT('1') ,
					TL           : UPTXLF(PlantDS) ,
					CL           : UPNCLF(PlantDS) ,
					DL2          : UPNLLF(PlantDS) ,
					CAP          : CAPNUG(SupplyRegion_SUB, PlantDS, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				CAP((SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_DS(SupplyRegion_SUB,WIDS_Element,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, WIDS_Element, PlanYear) := (EPCOVR(WIDS_Element, SupplyRegion_SUB, cyr) + EPCTRM(WIDS_Element, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, WIDS_Element)+CURIYR('1')-1))) * EPCCRF(WIDS_Element, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element) ):=
				(( CAPNNSTL(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) *
				CAPNUG(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) + TRANS(SupplyRegion_SUB, WIDS_Element, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIDS_Element)),(UNFPH('1') - OLYEAR(PlanYear, WIDS_Element) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIDS_Element)),OLYEAR(PlanYear, WIDS_Element));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cIX_ECPCOSTS((SupplyRegion_SUB, WIDS_Element, OwnerType, ElasticityStep1, PlanYear) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIDS_Element) <= UNXPH('1') AND
				UPAVLYR(WIDS_Element)<= FULLYEAR_ALT(PlanYear, WIDS_Element)):=
				if ord(OwnerType)=1 then
				 OBJVAL(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) + PVFOM(SupplyRegion_SUB, WIDS_Element, PlanYear) +
				 PVARB(SupplyRegion_SUB, WIDS_Element, PlanYear) + PVTOM(SupplyRegion_SUB, WIDS_Element, PlanYear) + PVVOM(SupplyRegion_SUB, WIDS_Element, PlanYear)
				 else
				  OBJVAL(SupplyRegion_SUB, WIDS_Element, PlanYear, OwnerType, ElasticityStep1, SubsidyType_X) + PVARB(SupplyRegion_SUB, WIDS_Element, PlanYear) +
				  PVFOM(SupplyRegion_SUB, WIDS_Element, PlanYear) + PVVOM(SupplyRegion_SUB, WIDS_Element, PlanYear)
				 endif;
				
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((WIDS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) |
				Condition_DS(SupplyRegion, WIDS_Element, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), ElasticityStep1, SubsidyType_X)) :=1;
				
				!COMPUTE LEVELIZED CAPITAL COST AND FIXED CHARGE FACTOR--NUGS
				!subsidy_type0(PlanYear, WIDS_Element):=element(Subsidy_Type_, Subsidy_Case(PlanYear, WIDS_Element)) ;
				EPLVCAP_calc(WIDS_Element, OwnerType, SupplyRegion_SUB, cyr):=
				(( CAP(SupplyRegion_SUB, WIDS_Element, first(PlanYear), OwnerType, ElasticityStep1, SubsidyType_X) *
				CAPUTIL(SupplyRegion_SUB, WIDS_Element, first(PlanYear), OwnerType, ElasticityStep1, SubsidyType_X) ) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, WIDS_Element) ,(UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, WIDS_Element),OLYEAR(first(PlanYear), WIDS_Element)) /$ PVGNP(SupplyRegion_SUB, WIDS_Element);
				
				
				EPLVFCF_calc(WIDS_Element, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(WIDS_Element, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, WIDS_Element, first(PlanYear),OwnerType,ElasticityStep1,SubsidyType_X);
				
				EPLVTRN_calc(WIDS_Element, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, WIDS_Element, first(PlanYear)) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, WIDS_Element),(UNFPH('1') - OLYEAR(first(PlanYear), WIDS_Element) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, WIDS_Element) ,OLYEAR(first(PlanYear), WIDS_Element)) /$ PVGNP(SupplyRegion_SUB, WIDS_Element);
				
				EPLVBCK_calc(WIDS_Element, SupplyRegion_SUB, cyr):=1;
			}
			Comment: "Calculates costs for CALC_STORAGE_VAL subroutine: ccalc_cIX_ECPCOSTS";
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,ElasticityStep,subsidy_type);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, PlantType, PlanYear);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter TOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVTOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DR_EPNBLD {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_DS {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
			}
		}
		Procedure Calculate_DGBLDCOSTS {
			Body: {
				! DETERMINE PRESENT VALUE OF PRODUCTION TAX CREDIT SUBSIDIES
				SOM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(DistributedGenType) and
				((UPGSUB(DistributedGenType) >0 AND (CURIYR('1') + OLYEAR(PlanYear, DistributedGenType) - 1) >= (UPGSY1(DistributedGenType) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, DistributedGenType) - 1) <= (UPGSYL(DistributedGenType) - UHBSYR('1'))) OR
				UPGSUBPT(DistributedGenType) > 0 )) :=
				if OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') then
				IF (UPGSUBPT(DistributedGenType)<= 0) THEN
				        UPGSUB(DistributedGenType) * 8.76 * UPMCF(DistributedGenType)
				ELSE
				        UPGSUBYR(DistributedGenType, OLYEAR_MNUMYR(PlanYear, DistributedGenType)) * 8.76 * UPMCF(DistributedGenType)
				ENDIF
				endif;
				!CHECK IF PTC IS CAPPED
				SOM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| UPGSMX(DistributedGenType)>0):= MIN(SOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon),UPGSMX(DistributedGenType));
				!IF PTC IS REAL, THEN APPLY DEFLATOR
				SOM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| UPGSTY(DistributedGenType)<=0) *= UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, PlanYear));
				!ADJUST FOR TAX BENEFIT
				SOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon) /= 1.0 - UPTXRT('1');
				SOML((SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(DistributedGenType) and UPGSUB(DistributedGenType) >0 AND
				(CURIYR('1') + OLYEAR(first(PlanYear), DistributedGenType) - 1) >= (UPGSY1(DistributedGenType) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(first(PlanYear), DistributedGenType) - 1) <= (UPGSYL(DistributedGenType) - UHBSYR('1'))):=
				SOM(SupplyRegion_SUB, DistributedGenType, first(PlanYear), FullPlanningHorizon)/
				(8.76 * UPMCF(DistributedGenType));  !only for PlanYear=1
				PVSOM(SupplyRegion_SUB, DistributedGenType, PlanYear) :=
				if ((UPGSUB(DistributedGenType) >0 AND (CURIYR('1') + OLYEAR(PlanYear, DistributedGenType) - 1) >= (UPGSY1(DistributedGenType) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, DistributedGenType) - 1) <= (UPGSYL(DistributedGenType) - UHBSYR('1'))) OR
				UPGSUBPT(DistributedGenType) > 0) and OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1')  then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(DistributedGenType),
				!PVV_Function(SOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))*
				SOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, DistributedGenType)-1)
				else
				0
				endif;
				PVSOML(SupplyRegion_SUB, DistributedGenType) :=
				if ((UPGSUB(DistributedGenType) >0 AND (CURIYR('1') + OLYEAR(first(PlanYear_), DistributedGenType) - 1) >= (UPGSY1(DistributedGenType) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(first(PlanYear_), DistributedGenType) - 1) <= (UPGSYL(DistributedGenType) - UHBSYR('1'))) OR
				UPGSUBPT(DistributedGenType) > 0 ) and OLYEAR(first(PlanYear_), DistributedGenType) <= UNXPH('1') then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(DistributedGenType),
				!PVV_Function(SOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))*
				SOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear_), DistributedGenType)-1)
				else
				0
				endif;
				!CHECK FOR TIME-DEPENDENT DEBT/EQUITY SUBSIDIES
				!EPSUBFIN_Sub; moved to mainexecution
				!FOR NEW CAPACITY, DETERMINE PRESENT VALUE OF FUEL, O&M, AND EXTERNALITY COSTS BEGINNING IN OLYR
				
				FOM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') and
				ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1) :=
				(EPFOM(DistributedGenType, SupplyRegion_SUB, cyr)+EPCFOM(DistributedGenType, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, PlanYear));
				
				VOM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') and
				ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1) :=
				EPVOM(DistributedGenType, SupplyRegion_SUB, cyr) * 1000 * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, PlanYear));
				
				PRM((SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') and
				ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1) :=
				(PNGELGR(element(GasRegion_,UPNGRG(SupplyRegion_SUB)), cyr) - OGWPRNG(last(OGSMReg_), cyr)/CFNGU(cyr) + UPDGFPR('1')) *
				UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, PlanYear));  !add markup to premium
				
				!EXT and GPS are not converted, exist but not used in FORTRAN  */
				
				FOML((SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1) :=
				(EPFOM(DistributedGenType, SupplyRegion_SUB, cyr)+EPCFOM(DistributedGenType, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, first(PlanYear)));
				
				VOML((SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1) :=
				EPVOM(DistributedGenType, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DistributedGenType, first(PlanYear)));
				
				
				PVFOM((SupplyRegion_SUB, DistributedGenType, PlanYear)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') ) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1,
				!PVV_Function(FOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, DistributedGenType)-1);
				
				PVVOM((SupplyRegion_SUB, DistributedGenType, PlanYear)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1,
				!PVV_Function(VOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, DistributedGenType)-1);
				
				PVPRM((SupplyRegion_SUB, DistributedGenType, PlanYear)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') ) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1,
				!PVV_Function(PRM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				PRM(SupplyRegion_SUB, DistributedGenType, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, DistributedGenType)-1);
				!since column intersects carbon and fuel supply rows, only markup/premium needs to be added here
				PVFUEL((SupplyRegion_SUB, DistributedGenType, PlanYear)| OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') ) := PVPRM(SupplyRegion_SUB, DistributedGenType, PlanYear)*
				AVG_HTRT(DistributedGenType,element(FuelRegion_,MapFuelRegion(DistributedGenType,SupplyRegion_SUB)),SupplyRegion_SUB,ExplicitPlanningHorizon_element(PlanYear));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				
				!PVEXT(SupplyRegion_SUB, Intermittent, PlanYear) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, Intermittent) + 1,
				!PVV_Function(EXTR(SupplyRegion_SUB, Intermittent, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				!PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, Intermittent)-1);
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY AND EXTERNALITY COSTS
				PVFOML(SupplyRegion_SUB, DistributedGenType) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1,
				!PVV_Function(FOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), DistributedGenType)-1);
				
				PVVOML(SupplyRegion_SUB, DistributedGenType) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1,
				!PVV_Function(VOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOML(SupplyRegion_SUB, DistributedGenType, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), DistributedGenType)-1);
				
				PVGNP(SupplyRegion_SUB, DistributedGenType) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), DistributedGenType),(UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				EPLVFOM_calc(DistributedGenType, SupplyRegion_SUB, cyr) := PVFOML(SupplyRegion_SUB, DistributedGenType)  /$ PVGNP(SupplyRegion_SUB, DistributedGenType);
				EPLVVOM_calc(DistributedGenType, SupplyRegion_SUB, cyr) := PVVOML(SupplyRegion_SUB, DistributedGenType) /$ PVGNP(SupplyRegion_SUB, DistributedGenType);
				EPLVEXT_calc(DistributedGenType, SupplyRegion_SUB, cyr) :=  - PVSOML(SupplyRegion_SUB, DistributedGenType) /$ PVGNP(SupplyRegion_SUB, DistributedGenType);
				EPLVFLC_calc(DistributedGenType, SupplyRegion_SUB, cyr) := 0.0;
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(DistributedGenType):=(UPANNADJ(DistributedGenType, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(DistributedGenType, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((DistributedGenType, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(DistributedGenType, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(DistributedGenType, last(MNUMYR)) * ANNRTE(DistributedGenType) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, DistributedGenType, PlanYear) | OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') and
				UPAVLYR(DistributedGenType)<= FULLYEAR_ALT(PlanYear, DistributedGenType) AND (UPBLDREG_us00(DistributedGenType)> 0 AND UPBLDREG(DistributedGenType, SupplyRegion_SUB)>0) ):=
				if OLYEAR(PlanYear, DistributedGenType)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, DistributedGenType)-1) <= UNYEAR('1') THEN
				        UPANNADJ(DistributedGenType, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, DistributedGenType)-1))
				  ELSE
				        UPANNADJ(DistributedGenType, last(MNUMYR)) * ANNRTE(DistributedGenType) ^ ((CURIYR('1')+OLYEAR(PlanYear, DistributedGenType)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(DistributedGenType, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(DistributedGenType, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				Condition_DG((SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type) | UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and
				OLYEAR(PlanYear, DistributedGenType) <= UNXPH('1') AND UPAVLYR(DistributedGenType)<= FULLYEAR_ALT(PlanYear, DistributedGenType) AND
				(UPBLDREG_us00(DistributedGenType)> 0 AND UPBLDREG(DistributedGenType, SupplyRegion_SUB)>0) ):=1;
				
				OVRCST((SupplyRegion_SUB, DistributedGenType, PlanYear,OwnerType,DistGenAvoidStep,subsidy_type)|
				Condition_DG(SupplyRegion_SUB, DistributedGenType, PlanYear,OwnerType,DistGenAvoidStep,subsidy_type)):=
				UPOVR(DistributedGenType) * UPLRPC(DistributedGenType) * UPLROPT(DistributedGenType) * UPLRLC(DistributedGenType) * EPRGM(DistributedGenType, SupplyRegion_SUB, cyr) * EPACM(DistributedGenType, SupplyRegion_SUB, cyr) *
				ANNADJ(SupplyRegion_SUB, DistributedGenType, PlanYear);
				OVRCST((SupplyRegion_SUB, DistributedGenType, PlanYear,OwnerType,DistGenAvoidStep,SubsidyType_X)| UPSUBCAS(DistributedGenType)= 2 AND Subsidy_Case(PlanYear, DistributedGenType)=2)/=
				      (1.0 - UPCSB(DistributedGenType));
				
				ROR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type)
				endif;
				
				INTR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type)
				endif;
				EPINCST_p(
					PLTS         : DistributedGenType_ ,
					Steps        : DistGenAvoidStep_ ,
					SubCondition : Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type) ,
					CLT          : UPCLYR(DistributedGenType) ,
					PLT          : UPPLYR(DistributedGenType) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) ,
					PROFILE      : UPCPRO(DistributedGenType, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, DistributedGenType) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) :=
				TXBOOK(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) / $
				FNBOOK(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				CAPNNSTL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) :=
				FNBOOK(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				
				
				DR_EPNBLD(SupplyRegion_SUB, DistributedGenType):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(DistributedGenType));
				EPNBLD_p(
					PLTS         : DistributedGenType_ ,
					Steps        : DistGenAvoidStep_ ,
					SubCondition : Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type) ,
					ROR          : UTROR(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType1, subsidy_type) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, DistributedGenType) ,
					RATIO        : PRATIO(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType1, DistGenAvoidStep, subsidy_type) ,
					PE           : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL           : UPECLF(DistributedGenType) ,
					TL           : UPTXLF(DistributedGenType) ,
					T            : UPTXRT('1') ,
					CL           : UPUCLF(DistributedGenType) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType1, DistGenAvoidStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS   : DistributedGenType_ ,
					Steps        : DistGenAvoidStep_ ,
					SubCondition : Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type) ,
					DF2    : DEBT_F(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType2, subsidy_type) ,
					RATIO  : PRATIO(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType2, DistGenAvoidStep, subsidy_type) ,
					ROEPRM : UPNRPRM('1') ,
					INTPRM : UPNIPRM('1') ,
					UTROE  : UTROE(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType2, subsidy_type) ,
					UTINT  : UTINT(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType2, subsidy_type) ,
					TR     : UPTXRT('1') ,
					TL     : UPTXLF(DistributedGenType) ,
					CL     : UPNCLF(DistributedGenType) ,
					DL2    : UPNLLF(DistributedGenType) ,
					CAP    : CAPNUG(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType2, DistGenAvoidStep, subsidy_type) );
				CAP((SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) |
				Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, DistributedGenType, PlanYear,DistGenAvoidStep) := (EPCOVR(DistributedGenType, SupplyRegion_SUB, cyr) + EPCTRM(DistributedGenType, SupplyRegion_SUB, cyr) -
				EPDAVD(DistGenAvoidStep, SupplyRegion_SUB, cyr) * UPDGAVR('1')) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, DistributedGenType)+CURIYR('1')-1))) * EPCCRF(DistributedGenType, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) |
				Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidy_type)):=
				(( CAPNNSTL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) *
				CAP(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type) + TRANS(SupplyRegion_SUB, DistributedGenType, PlanYear,DistGenAvoidStep) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(DistributedGenType)),(UNFPH('1') - OLYEAR(PlanYear, DistributedGenType) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(DistributedGenType)),OLYEAR(PlanYear, DistributedGenType));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cBX_DGN_ECPCOSTS((SupplyRegion_SUB, DistributedGenType, OwnerType, DistGenAvoidStep, PlanYear) |
				Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidytype_X)):=
				OBJVAL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, DistributedGenType, PlanYear) -
				PVSOM(SupplyRegion_SUB, DistributedGenType, PlanYear) +
				(PVVOM(SupplyRegion_SUB, DistributedGenType, PlanYear) + PVFUEL(SupplyRegion_SUB, DistributedGenType, PlanYear)) *
				DGNGEN(DistributedGenType,PlanYear,SupplyRegion_SUB) * 0.000001 +
				IF (UPSUBCAS(DistributedGenType)= 1 AND Subsidy_Case(PlanYear, DistributedGenType)=2) THEN
				        PVSOM(SupplyRegion_SUB, DistributedGenType, PlanYear)
				ENDIF;
				
				ccalc_cBSDGN_ECPCOSTS((SupplyRegion_SUB, DistributedGenType, OwnerType, DistGenAvoidStep, PlanYear) |
				Condition_DG(SupplyRegion_SUB,DistributedGenType,PlanYear,OwnerType,DistGenAvoidStep,subsidytype_S) and Subsidy_Case(PlanYear, DistributedGenType)=2):=
				OBJVAL(SupplyRegion_SUB, DistributedGenType, PlanYear, OwnerType, DistGenAvoidStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, DistributedGenType, PlanYear) -
				PVSOM(SupplyRegion_SUB, DistributedGenType, PlanYear) +
				(PVVOM(SupplyRegion_SUB, DistributedGenType, PlanYear) + PVFUEL(SupplyRegion_SUB, DistributedGenType, PlanYear)) *
				DGNGEN(DistributedGenType,PlanYear,SupplyRegion_SUB) * 0.000001 ;
				
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((DistributedGenType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) | UPBLDREG(DistributedGenType, SupplyRegion)> 0.0 and
				Condition_DG(SupplyRegion, DistributedGenType, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), DistGenAvoidStep1, SubsidyType_X)) :=Subsidy_Case(PlanYear, DistributedGenType);
				
				!COMPUTE LEVELIZED CAPITAL COST AND FIXED CHARGE FACTOR--NUGS
				subsidy_type0(PlanYear, DistributedGenType):=element(Subsidy_Type_, Subsidy_Case(PlanYear, DistributedGenType)) ;
				EPLVCAP_calc(DistributedGenType, OwnerType, SupplyRegion_SUB, cyr):=
				(( CAP(SupplyRegion_SUB, DistributedGenType, first(PlanYear), OwnerType, DistGenAvoidStep1, subsidy_type0(first(PlanYear), DistributedGenType)) *
				CAPUTIL(SupplyRegion_SUB, DistributedGenType, first(PlanYear), OwnerType, DistGenAvoidStep1, subsidy_type0(first(PlanYear), DistributedGenType)) ) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, DistributedGenType) ,(UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, DistributedGenType),OLYEAR(first(PlanYear), DistributedGenType)) /$ PVGNP(SupplyRegion_SUB, DistributedGenType);
				
				
				EPLVFCF_calc(DistributedGenType, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(DistributedGenType, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, DistributedGenType, first(PlanYear),OwnerType,DistGenAvoidStep1,subsidy_type0(first(PlanYear), DistributedGenType));
				
				EPLVTRN_calc(DistributedGenType, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, DistributedGenType, first(PlanYear),DistGenAvoidStep1) /
				CRF_f(DR_EPNBLD(SupplyRegion_SUB, DistributedGenType),(UNFPH('1') - OLYEAR(first(PlanYear), DistributedGenType) + 1)) ) *
				PWF_f(DR_EPNBLD(SupplyRegion_SUB, DistributedGenType) ,OLYEAR(first(PlanYear), DistributedGenType)) /$ PVGNP(SupplyRegion_SUB, DistributedGenType);
				
				EPLVBCK_calc(DistributedGenType, SupplyRegion_SUB, cyr):=1;
			}
			Comment: "Calculates costs for EP$BDGN subroutine: ccalc_cBX_DGN_ECPCOSTS and ccalc_cBSDGN_ECPCOSTS";
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,DistGenAvoidStep);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,DistGenAvoidStep,subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter PRM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVFUEL {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVPRM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DR_EPNBLD {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_DG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, DistGenAvoidStep, subsidy_type);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
			}
		}
		Procedure Calculate_RNWBLDCOSTS {
			Body: {
				! DETERMINE PRESENT VALUE OF PRODUCTION TAX CREDIT SUBSIDIES
				DSCRT(SupplyRegion_SUB, OtherRenewable):=EPDSCRT(('1'), SupplyRegion_SUB, cyr) ;
				DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(OtherRenewable));
				
				SOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(OtherRenewable) and
				((UPGSUB(OtherRenewable) >0 AND (CURIYR('1') + OLYEAR(PlanYear, OtherRenewable) - 1) >= (UPGSY1(OtherRenewable) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, OtherRenewable) - 1) <= (UPGSYL(OtherRenewable) - UHBSYR('1'))) OR
				(UPGSUBPT(OtherRenewable) > 0 AND UPGSUBYR(OtherRenewable, OLYEAR_MNUMYR(PlanYear, OtherRenewable))> 0))) :=
				IF (UPGSUBPT(OtherRenewable)<= 0) THEN
				        UPGSUB(OtherRenewable) * 8.76 * TMP_RCF(OtherRenewable, SupplyRegion_SUB)
				ELSE
				        UPGSUBYR(OtherRenewable, OLYEAR_MNUMYR(PlanYear, OtherRenewable)) * 8.76 * TMP_RCF(OtherRenewable, SupplyRegion_SUB)
				ENDIF;
				!CHECK IF PTC IS CAPPED
				SOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)| UPGSMX(OtherRenewable)>0):= MIN(SOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon),UPGSMX(OtherRenewable));
				!IF PTC IS REAL, THEN APPLY DEFLATOR
				SOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)| UPGSTY(OtherRenewable)<=0) *= UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, PlanYear));
				!ADJUST FOR TAX BENEFIT
				SOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon) /= 1.0 - UPTXRT('1');
				SOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon):=
				SOM(SupplyRegion_SUB, OtherRenewable, first(PlanYear), FullPlanningHorizon)/
				(8.76 * TMP_RCF(OtherRenewable, SupplyRegion_SUB));  !only for PlanYear=1
				PVSOM(SupplyRegion_SUB, OtherRenewable, PlanYear) :=
				if (UPGSUB(OtherRenewable) >0 AND (CURIYR('1') + OLYEAR(PlanYear, OtherRenewable) - 1) >= (UPGSY1(OtherRenewable) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, OtherRenewable) - 1) <= (UPGSYL(OtherRenewable) - UHBSYR('1'))) OR
				(UPGSUBPT(OtherRenewable) > 0 AND UPGSUBYR(OtherRenewable, OLYEAR_MNUMYR(PlanYear, OtherRenewable))> 0) then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(OtherRenewable),
				!PVV_Function(SOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, OtherRenewable)))*
				SOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, OtherRenewable)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, OtherRenewable),OLYEAR(PlanYear, OtherRenewable)-1)
				else
				0
				endif;
				PVSOML(SupplyRegion_SUB, OtherRenewable) :=
				if (UPGSUB(OtherRenewable) >0 AND (CURIYR('1') + OLYEAR(first(PlanYear_), OtherRenewable) - 1) >= (UPGSY1(OtherRenewable) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(first(PlanYear_), OtherRenewable) - 1) <= (UPGSYL(OtherRenewable) - UHBSYR('1'))) OR
				(UPGSUBPT(OtherRenewable) > 0 AND UPGSUBYR(OtherRenewable, OLYEAR_MNUMYR(first(PlanYear_), OtherRenewable))> 0) then
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(OtherRenewable),
				!PVV_Function(SOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, OtherRenewable)))*
				SOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, OtherRenewable)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, OtherRenewable),OLYEAR(first(PlanYear_), OtherRenewable)-1)
				else
				0
				endif;
				
				!DETERMINE PRESENT VALUE OF FIXED O&M AT OLYR INCLUDE EXTERNALITY COSTS, IF ANY
				
				FOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1) :=
				EPIRFOM(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, PlanYear));
				
				VOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)|
				 ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1) :=
				(EPIRVOM(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) * 8.76 * TMP_RCF(OtherRenewable, SupplyRegion_SUB)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, PlanYear));
				
				TOM((SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1) :=
				EPCFOM(OtherRenewable, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, PlanYear));
				
				!EXT and GPS are not converted, exist but not used in FORTRAN  */
				
				FOML((SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1) :=
				EPIRFOM(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, first(PlanYear)));
				
				VOML((SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1) :=
				EPIRVOM(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, first(PlanYear)));
				
				TOML((SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1) :=
				EPCFOM(OtherRenewable, SupplyRegion_SUB, cyr) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, OtherRenewable, first(PlanYear)));
				
				PVFOM(SupplyRegion_SUB, OtherRenewable, PlanYear):=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1,
				!PVV_Function(FOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, OtherRenewable)-1);
				
				PVVOM(SupplyRegion_SUB, OtherRenewable, PlanYear) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1,
				!PVV_Function(VOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, OtherRenewable)-1);
				
				PVTOM(SupplyRegion_SUB, OtherRenewable, PlanYear) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1,
				!PVV_Function(TOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				TOM(SupplyRegion_SUB, OtherRenewable, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, OtherRenewable)-1);
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY AND EXTERNALITY COSTS
				PVFOML(SupplyRegion_SUB, OtherRenewable) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1,
				!PVV_Function(FOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), OtherRenewable)-1);
				
				PVVOML((SupplyRegion_SUB, OtherRenewable)| OtherRenewable=WIHY_element or OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1,
				!PVV_Function(VOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				VOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), OtherRenewable)-1);
				
				PVTOML(SupplyRegion_SUB, OtherRenewable) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1,
				!PVV_Function(TOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				TOML(SupplyRegion_SUB, OtherRenewable, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), OtherRenewable)-1);
				
				PVGNPR(SupplyRegion_SUB, OtherRenewable) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), OtherRenewable),(UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1),
				(EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(OtherRenewable)));
				PVGNP(SupplyRegion_SUB, OtherRenewable) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), OtherRenewable),(UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				EPLVFOM_calc(OtherRenewable, SupplyRegion_SUB, cyr) := (PVFOML(SupplyRegion_SUB, OtherRenewable) + PVTOML(SupplyRegion_SUB, OtherRenewable)) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				EPLVVOM_calc((OtherRenewable, SupplyRegion_SUB, cyr)| OtherRenewable=WIHY_element or OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element) := PVVOML(SupplyRegion_SUB, OtherRenewable) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				EPLVEXT_calc(OtherRenewable, SupplyRegion_SUB, cyr) := (- PVSOML(SupplyRegion_SUB, OtherRenewable)) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				EPLVFLC_calc((OtherRenewable, SupplyRegion_SUB, cyr)| OtherRenewable=WIHY_element) := 0.0;
				
				
				
				
				
				ITCADJ((OtherRenewable, PlanYear) | OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable)):=
				IF ((UPGSUB(OtherRenewable) > 0.0 AND (CURIYR('1')+OLYEAR(PlanYear, OtherRenewable) - 1) >= (UPGSY1(OtherRenewable) - UHBSYR('1')) AND
				(CURIYR('1')+OLYEAR(PlanYear, OtherRenewable) - 1) <= (UPGSYL(OtherRenewable) - UHBSYR('1'))) OR
				(UPGSUBPT(OtherRenewable) > 0 AND UPGSUBYR(OtherRenewable,element(MNUMYR_,min(UNYEAR('1') , CURIYR('1')+OLYEAR(PlanYear, OtherRenewable) - 1))) > 0.0)) THEN
				        1.0-UPCSB(OtherRenewable)
				ELSE
				        1.0
				ENDIF;
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(OtherRenewable):=(UPANNADJ(OtherRenewable, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(OtherRenewable, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((OtherRenewable, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(OtherRenewable, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(OtherRenewable, last(MNUMYR)) * ANNRTE(OtherRenewable) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, OtherRenewable, PlanYear) | OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable) AND (UPBLDREG_us00(OtherRenewable)> 0 AND UPBLDREG(OtherRenewable, SupplyRegion_SUB)>0) AND
				        (EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr)<9000 and EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr))):=
				if OLYEAR(PlanYear, OtherRenewable)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, OtherRenewable)-1) <= UNYEAR('1') THEN
				        UPANNADJ(OtherRenewable, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, OtherRenewable)-1))
				  ELSE
				        UPANNADJ(OtherRenewable, last(MNUMYR)) * ANNRTE(OtherRenewable) ^ ((CURIYR('1')+OLYEAR(PlanYear, OtherRenewable)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(OtherRenewable, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(OtherRenewable, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				OVRCST((SupplyRegion_SUB, OtherRenewable, PlanYear,OwnerType,ElasticityStep,subsidy_type)|
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable) AND (UPBLDREG_us00(OtherRenewable)> 0 AND UPBLDREG(OtherRenewable, SupplyRegion_SUB)>0) AND
				(EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr)<9000 and EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr))):=
				IF (UPSUBCAS(OtherRenewable)= 2 AND Subsidy_Case(PlanYear, OtherRenewable)=2)THEN
				   IF subsidy_type='X' THEN
				        (EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) / (1.0 - UPCSB(OtherRenewable))) * UPLRPC(OtherRenewable) * UPLROPT(OtherRenewable) * UPLRLC(OtherRenewable) *
				        EPRGM(OtherRenewable, SupplyRegion_SUB, cyr) * EPACM(OtherRenewable, SupplyRegion_SUB, cyr) *
				        EPCCSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) *
				        ANNADJ(SupplyRegion_SUB, OtherRenewable, PlanYear)
				   ELSE
				        EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr) * UPLRPC(OtherRenewable) * UPLROPT(OtherRenewable) * UPLRLC(OtherRenewable) *
				        EPRGM(OtherRenewable, SupplyRegion_SUB, cyr) * EPACM(OtherRenewable, SupplyRegion_SUB, cyr) *
				        EPCCSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) * ANNADJ(SupplyRegion_SUB, OtherRenewable, PlanYear)
				   ENDIF
				 ELSE
				   (EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr)/ITCADJ(OtherRenewable, PlanYear)) * UPLRPC(OtherRenewable) * UPLROPT(OtherRenewable) * UPLRLC(OtherRenewable) *
				   EPRGM(OtherRenewable, SupplyRegion_SUB, cyr) * EPACM(OtherRenewable, SupplyRegion_SUB, cyr) *
				   EPCCSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) * ANNADJ(SupplyRegion_SUB, OtherRenewable, PlanYear)
				ENDIF;
				
				!EPINCST;
				Condition_RNW((SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type) |
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable) AND (UPBLDREG_us00(OtherRenewable)> 0 AND UPBLDREG(OtherRenewable, SupplyRegion_SUB)>0) AND
				(EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr)<9000 and EPIROVR(RnwStor(OtherRenewable), SupplyRegion_SUB, cyr))):=1;
				
				ROR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type)
				endif;
				
				INTR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type)
				endif;
				EPINCST_p(
					PLTS         : OtherRenewable_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					CLT          : UPCLYR(OtherRenewable) ,
					PLT          : UPPLYR(OtherRenewable) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PROFILE      : UPCPRO(OtherRenewable, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, OtherRenewable) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				TXBOOK(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) / $
				FNBOOK(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				CAPNNSTL(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				FNBOOK(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				
				EPNBLD_p(
					PLTS         : OtherRenewable_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					ROR          : UTROR(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType1, subsidy_type) ,
					DR           : DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable) ,
					RATIO        : PRATIO(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType1, ElasticityStep, subsidy_type) ,
					PE           : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL           : UPECLF(OtherRenewable) ,
					TL           : UPTXLF(OtherRenewable) ,
					T            : UPTXRT('1') ,
					CL           : UPUCLF(OtherRenewable) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType1, ElasticityStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS         : OtherRenewable_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					DF2          : DEBT_F(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType2, subsidy_type) ,
					RATIO        : PRATIO(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType2, ElasticityStep, subsidy_type) ,
					ROEPRM       : UPNRPRM('1') ,
					INTPRM       : UPNIPRM('1') ,
					UTROE        : UTROE(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType2, subsidy_type) ,
					UTINT        : UTINT(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType2, subsidy_type) ,
					TR           : UPTXRT('1') ,
					TL           : UPTXLF(OtherRenewable) ,
					CL           : UPNCLF(OtherRenewable) ,
					DL2          : UPNLLF(OtherRenewable) ,
					CAP          : CAPNUG(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType2, ElasticityStep, subsidy_type) );
				CAP((SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear) := (EPCOVR(OtherRenewable, SupplyRegion_SUB, cyr) + EPCTRM(OtherRenewable, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, OtherRenewable)+CURIYR('1')-1))) * EPCCRF(OtherRenewable, SupplyRegion_SUB, cyr);
				
				TRANS((SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear)| FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0) := (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion) + EPCTRM(WIWD_Element, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, WIWD_Element)+CURIYR('1')-1))) * EPCCRF(WIWD_Element, SupplyRegion_SUB, cyr);
				
				! WIBI
				TRANS((SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear)| FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0) := (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion) + EPCTRM(WIBI_Element, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, WIBI_Element)+CURIYR('1')-1))) * EPCCRF(WIBI_Element, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_RNW(SupplyRegion_SUB,WIWD_Element,PlanYear,OwnerType,ElasticityStep,subsidy_type) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0):=
				(( CAPNNSTL(SupplyRegion_SUB, WIWD_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, WIWD_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIWD_Element)),(UNFPH('1') - OLYEAR(PlanYear, WIWD_Element) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIWD_Element)),OLYEAR(PlanYear, WIWD_Element));
				
				! WIBI
				OBJVAL((SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_RNW(SupplyRegion_SUB,WIBI_Element,PlanYear,OwnerType,ElasticityStep,subsidy_type) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0):=
				(( CAPNNSTL(SupplyRegion_SUB, WIBI_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, WIBI_Element, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIBI_Element)),(UNFPH('1') - OLYEAR(PlanYear, WIBI_Element) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(WIBI_Element)),OLYEAR(PlanYear, WIBI_Element));
				
				OBJVAL((SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				(( CAPNNSTL(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, OtherRenewable, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear) ) / $
				CRF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(OtherRenewable)),(UNFPH('1') - OLYEAR(PlanYear, OtherRenewable) + 1)) ) *
				PWF_f((EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(OtherRenewable)),OLYEAR(PlanYear, OtherRenewable));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cBBIO_ECPCOSTS((SupplyRegion_SUB, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) |
				Condition_RNW(SupplyRegion_SUB,WIWD_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_X) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0):=
				IF (UPSUBCAS(WIWD_Element)= 1 AND Subsidy_Case(PlanYear, WIWD_Element)=2) THEN
				        OBJVAL(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, WIWD_Element, PlanYear) *
				        EPFXSUP(WIWD_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIWD_Element, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, WIWD_Element, PlanYear) *
				        EPFXSUP(WIWD_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIWD_Element, PlanYear) -
				        PVSOM(SupplyRegion_SUB, WIWD_Element, PlanYear)
				ENDIF;
				
				ccalc_cBBIOSUB_ECPCOSTS((SupplyRegion_SUB, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, WIWD_Element)=2 and
				Condition_RNW(SupplyRegion_SUB,WIWD_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_S) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 ):=
				OBJVAL(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, WIWD_Element, PlanYear) *
				EPFXSUP(WIWD_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIWD_Element, PlanYear) -
				PVSOM(SupplyRegion_SUB, WIWD_Element, PlanYear);
				
				! BI
				ccalc_cBBIO_ECPCOSTS((SupplyRegion_SUB, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) |
				Condition_RNW(SupplyRegion_SUB,WIBI_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_X) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0):=
				IF (UPSUBCAS(WIBI_Element)= 1 AND Subsidy_Case(PlanYear, WIBI_Element)=2) THEN
				        OBJVAL(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, WIBI_Element, PlanYear) *
				        EPFXSUP(WIBI_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIBI_Element, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, WIBI_Element, PlanYear) *
				        EPFXSUP(WIBI_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIBI_Element, PlanYear) -
				        PVSOM(SupplyRegion_SUB, WIBI_Element, PlanYear)
				ENDIF;
				
				ccalc_cBBIOSUB_ECPCOSTS((SupplyRegion_SUB, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, WIBI_Element)=2 and
				Condition_RNW(SupplyRegion_SUB,WIBI_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_S) and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 ):=
				OBJVAL(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, WIBI_Element, PlanYear) *
				EPFXSUP(WIBI_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, WIBI_Element, PlanYear) -
				PVSOM(SupplyRegion_SUB, WIBI_Element, PlanYear);
				
				ccalc_cBXRNW_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, OwnerType, ElasticityStep, PlanYear) |
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,SubsidyType_X) and OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element):=
				IF (UPSUBCAS(OtherRenewable)= 1 AND Subsidy_Case(PlanYear, OtherRenewable)=2) THEN
				        OBJVAL(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, OtherRenewable, PlanYear) *
				        EPFXSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, OtherRenewable, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, OtherRenewable, PlanYear) *
				        EPFXSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, OtherRenewable, PlanYear) -
				        PVSOM(SupplyRegion_SUB, OtherRenewable, PlanYear)
				ENDIF;
				ccalc_cBXRNW_ECPCOSTS((SupplyRegion_SUB, WIHY_Element, OwnerType, ElasticityStep, PlanYear) |
				Condition_RNW(SupplyRegion_SUB,WIHY_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_X))+=
				PVVOM(SupplyRegion_SUB, WIHY_Element, PlanYear) * EPVRSUP(WIHY_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr);
				
				ccalc_cBSRNW_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, OwnerType, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, OtherRenewable)=2 and
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear,OwnerType,ElasticityStep,SubsidyType_S) and OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element):=
				OBJVAL(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, OtherRenewable, PlanYear) *
				EPFXSUP(RnwStor(OtherRenewable), ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr) + PVTOM(SupplyRegion_SUB, OtherRenewable, PlanYear) -
				PVSOM(SupplyRegion_SUB, OtherRenewable, PlanYear);
				ccalc_cBSRNW_ECPCOSTS((SupplyRegion_SUB, WIHY_Element, OwnerType, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, WIHY_Element)=2 and
				Condition_RNW(SupplyRegion_SUB,WIHY_Element,PlanYear,OwnerType,ElasticityStep,SubsidyType_S))+=
				PVVOM(SupplyRegion_SUB, WIHY_Element, PlanYear) * EPVRSUP(WIHY_Element, ElasticityStep_Element(ElasticityStep), SupplyRegion_SUB, cyr);
				
				!EPIROVR=0
				ccalc_cBBIO_ECPCOSTS((SupplyRegion_SUB, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIWD_Element) <= UNXPH('1') AND UPVTYP(WIWD_Element)= 1 and
				UPAVLYR(WIWD_Element)<= FULLYEAR_ALT(PlanYear, WIWD_Element) AND (UPBLDREG_us00(WIWD_Element)> 0 AND UPBLDREG(WIWD_Element, SupplyRegion_SUB)>0) AND
				EPIROVR(WIWD_Element, SupplyRegion_SUB, cyr)=0) := 7000;
				
				ccalc_cBBIOSUB_ECPCOSTS((SupplyRegion_SUB, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, WIWD_Element)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIWD_Element) <= UNXPH('1') AND UPVTYP(WIWD_Element)= 1 and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				UPAVLYR(WIWD_Element)<= FULLYEAR_ALT(PlanYear, WIWD_Element) AND (UPBLDREG_us00(WIWD_Element)> 0 AND UPBLDREG(WIWD_Element, SupplyRegion_SUB)>0) AND
				EPIROVR(WIWD_Element, SupplyRegion_SUB, cyr)=0) := 7000;
				
				! WIBI
				ccalc_cBBIO_ECPCOSTS((SupplyRegion_SUB, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIBI_Element) <= UNXPH('1') AND UPVTYP(WIBI_Element)= 1 and
				UPAVLYR(WIBI_Element)<= FULLYEAR_ALT(PlanYear, WIBI_Element) AND (UPBLDREG_us00(WIBI_Element)> 0 AND UPBLDREG(WIBI_Element, SupplyRegion_SUB)>0) AND
				EPIROVR(WIBI_Element, SupplyRegion_SUB, cyr)=0) := 7000;
				
				ccalc_cBBIOSUB_ECPCOSTS((SupplyRegion_SUB, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, WIBI_Element)=2 and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, WIBI_Element) <= UNXPH('1') AND UPVTYP(WIBI_Element)= 1 and FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				UPAVLYR(WIBI_Element)<= FULLYEAR_ALT(PlanYear, WIBI_Element) AND (UPBLDREG_us00(WIBI_Element)> 0 AND UPBLDREG(WIBI_Element, SupplyRegion_SUB)>0) AND
				EPIROVR(WIBI_Element, SupplyRegion_SUB, cyr)=0) := 7000;
				
				ccalc_cBXRNW_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, OwnerType, ElasticityStep, PlanYear) |  OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable) AND (UPBLDREG_us00(OtherRenewable)> 0 AND UPBLDREG(OtherRenewable, SupplyRegion_SUB)>0) AND
				EPIROVR(OtherRenewable, SupplyRegion_SUB, cyr)=0) := 7000;
				
				ccalc_cBSRNW_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, OwnerType, ElasticityStep, PlanYear) | Subsidy_Case(PlanYear, OtherRenewable)=2 and OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, OtherRenewable) <= UNXPH('1') AND UPVTYP(OtherRenewable)= 1 and
				UPAVLYR(OtherRenewable)<= FULLYEAR_ALT(PlanYear, OtherRenewable) AND (UPBLDREG_us00(OtherRenewable)> 0 AND UPBLDREG(OtherRenewable, SupplyRegion_SUB)>0) AND
				EPIROVR(OtherRenewable, SupplyRegion_SUB, cyr)=0) := 7000;
				
				!PURCHASED CAPACITY ROW
				ccalc_cBBIO_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) | FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				Condition_RNW(SupplyRegion_SUB,WIWD_Element,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_X) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIWD_Element)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X));
				
				ccalc_cBBIOSUB_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and Subsidy_Case(PlanYear_ALTB, WIWD_Element)=2 and
				Condition_RNW(SupplyRegion_SUB,WIWD_Element,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_S) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIWD_Element)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, WIWD_Element, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S));
				
				! WIBI
				ccalc_cBBIO_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) | FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and
				Condition_RNW(SupplyRegion_SUB,WIBI_Element,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_X) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIBI_Element)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X));
				
				ccalc_cBBIOSUB_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0 and Subsidy_Case(PlanYear_ALTB, WIBI_Element)=2 and
				Condition_RNW(SupplyRegion_SUB,WIBI_Element,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_S) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIBI_Element)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, WIBI_Element, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S));
				
				ccalc_cBXRNW_rPXXXXXn((SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB) |  OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element and
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_X) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, OtherRenewable)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X));
				
				ccalc_cBSRNW_rPXXXXXn((SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB) |  OtherRenewable<>WIWD_Element and OtherRenewable<>WIBI_Element and Subsidy_Case(PlanYear_ALTB, OtherRenewable)=2 and
				Condition_RNW(SupplyRegion_SUB,OtherRenewable,PlanYear_ALTB,OwnerType,ElasticityStep,SubsidyType_X) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, OtherRenewable)):=
				min(80, 0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion0, OtherRenewable, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S));
				
				ccalc_cBBIO_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBBIO_rPXXXXXn(SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				ccalc_cBBIOSUB_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBBIOSUB_rPXXXXXn(SupplyRegion_SUB, PlanYear, WIWD_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				! WIBI
				ccalc_cBBIO_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBBIO_rPXXXXXn(SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				ccalc_cBBIOSUB_rPXXXXXn((SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBBIOSUB_rPXXXXXn(SupplyRegion_SUB, PlanYear, WIBI_Element, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				ccalc_cBXRNW_rPXXXXXn((SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBXRNW_rPXXXXXn(SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				ccalc_cBSRNW_rPXXXXXn((SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB) |
				abs(ccalc_cBSRNW_rPXXXXXn(SupplyRegion_SUB, PlanYear, OtherRenewable, OwnerType, ElasticityStep, PlanYear_ALTB))<ECP_MIN('1')):=0;
				
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) | UPBLDREG(OtherRenewable, SupplyRegion)> 0.0 and
				Condition_RNW(SupplyRegion, OtherRenewable, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), ElasticityStep1, SubsidyType_X)) :=Subsidy_Case(PlanYear, OtherRenewable);
				
				!COMPUTE LEVELIZED CAPITAL COST AND FIXED CHARGE FACTOR--NUGS
				subsidy_type0(PlanYear, OtherRenewable):=element(Subsidy_Type_, Subsidy_Case(PlanYear, OtherRenewable)) ;
				EPLVCAP_calc(OtherRenewable, OwnerType, SupplyRegion_SUB, cyr):=
				(( CAP(SupplyRegion_SUB, OtherRenewable, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), OtherRenewable)) *
				CAPUTIL(SupplyRegion_SUB, OtherRenewable, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), OtherRenewable)) ) /
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable) ,(UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable),OLYEAR(first(PlanYear), OtherRenewable)) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				
				
				EPLVFCF_calc(OtherRenewable, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(OtherRenewable, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, OtherRenewable, first(PlanYear),OwnerType,ElasticityStep1,subsidy_type0(first(PlanYear), OtherRenewable));
				
				EPLVTRN_calc(OtherRenewable, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, first(FuelRegion), OtherRenewable, first(PlanYear)) /
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable),(UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable) ,OLYEAR(first(PlanYear), OtherRenewable)) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				
				EPLVBCK_calc(OtherRenewable, SupplyRegion_SUB, cyr):=1;
				EPLVBCK_calc(WIHY_Element, SupplyRegion_SUB, cyr):=EPIRCCR(WIHY_Element, SupplyRegion_SUB, cyr);
				
				!STORE EMM/COAL REGION COSTS FOR BIOMASS PLANTS
				!WDLCAP(SupplyRegion_SUB, FuelRegion, OwnerType) := EPLVCAP(WIWD_Element, OwnerType, SupplyRegion_SUB, cyr);
				!WDLFCF(SupplyRegion_SUB, FuelRegion, OwnerType) := EPLVFCF(WIWD_Element, OwnerType, SupplyRegion_SUB, cyr);
				!WDLTRN(SupplyRegion_SUB, FuelRegion, OwnerType) := (TRANS(SupplyRegion_SUB, FuelRegion, OtherRenewable, first(PlanYear)) /
				!CRF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable),(UNFPH('1') - OLYEAR(first(PlanYear), OtherRenewable) + 1)) ) *
				!PWF_f(DSCRT_WRSK(SupplyRegion_SUB, OtherRenewable) ,OLYEAR(first(PlanYear), OtherRenewable)) /$ PVGNP(SupplyRegion_SUB, OtherRenewable);
				!
			}
			Comment: {
				"Calculates costs for EP$BRNW subroutine: ccalc_cBBIO_ECPCOSTS, ccalc_cBBIOSUB_ECPCOSTS, ccalc_cBXRNW_ECPCOSTS, and ccalc_cBSRNW_ECPCOSTS;
				also ccalc_cBBIO_rPXXXXXn, ccalc_cBBIOSUB_rPXXXXXn, ccalc_cBXRNW_rPXXXXXn, ccalc_cBSRNW_rPXXXXXn"
			}
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, FuelRegion_SUP, PlantType, PlanYear);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, FuelRegion_SUP, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,ElasticityStep,subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter TOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVTOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DSCRT {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter DSCRT_WRSK {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_RNW {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FLCST {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter FLCSTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
			}
		}
		Procedure Calculate_DSPBLDCOSTS {
			Body: {
				! DETERMINE PRESENT VALUE OF PRODUCTION TAX CREDIT SUBSIDIES
				DSCRT(SupplyRegion_SUB, DSP_Types):=EPDSCRT(('1'), SupplyRegion_SUB, cyr) ;
				DSCRT_WRSK(SupplyRegion_SUB, DSP_Types):=(EPDSCRT(('1'), SupplyRegion_SUB, cyr) - UPRSK(DSP_Types));
				
				SOM((SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UPGSYR(DSP_Types) and
				((UPGSUB(DSP_Types) >0 AND (CURIYR('1') + OLYEAR(PlanYear, DSP_Types) - 1) >= (UPGSY1(DSP_Types) - UHBSYR('1')) AND
				(CURIYR('1') + OLYEAR(PlanYear, DSP_Types) - 1) <= (UPGSYL(DSP_Types) - UHBSYR('1'))) OR
				(UPGSUBPT(DSP_Types) > 0 AND UPGSUBYR(DSP_Types, OLYEAR_MNUMYR(PlanYear, DSP_Types))> 0))) :=
				IF (UPGSUBPT(DSP_Types)<= 0) THEN
				        UPGSUB(DSP_Types) * 8.76 * CFCPLT(SupplyRegion_SUB, DSP_Types)
				ELSE
				        UPGSUBYR(DSP_Types, OLYEAR_MNUMYR(PlanYear, DSP_Types)) * 8.76 * CFCPLT(SupplyRegion_SUB, DSP_Types)
				ENDIF;
				
				!CHECK IF PTC IS CAPPED
				SOM((SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon)| UPGSMX(DSP_Types)>0):= MIN(SOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon),UPGSMX(DSP_Types));
				!IF PTC IS REAL, THEN APPLY DEFLATOR
				SOM((SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon)| UPGSTY(DSP_Types)<=0) *= UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DSP_Types, PlanYear));
				!ADJUST FOR TAX BENEFIT
				SOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon) /= 1.0 - UPTXRT('1');
				SOML((SupplyRegion_SUB, DSP_Types, FullPlanningHorizon)|
				ord(FullPlanningHorizon)<=UPGSYR(DSP_Types)):=
				SOM(SupplyRegion_SUB, DSP_Types, first(PlanYear), FullPlanningHorizon)/
				(8.76 * CFCPLT(SupplyRegion_SUB, DSP_Types));  !only for PlanYear=1
				PVSOM(SupplyRegion_SUB, DSP_Types, PlanYear) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(DSP_Types),
				!PVV_Function(SOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, DSP_Types)))*
				SOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, DSP_Types)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, DSP_Types),OLYEAR(PlanYear, DSP_Types)-1);
				PVSOML(SupplyRegion_SUB, DSP_Types) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UPGSYR(DSP_Types),
				!PVV_Function(SOML(SupplyRegion_SUB, DSP_Types, FullPlanningHorizon),ord(FullPlanningHorizon),DSCRT(SupplyRegion_SUB, DSP_Types)))*
				SOML(SupplyRegion_SUB, DSP_Types, FullPlanningHorizon) / ((1 + DSCRT(SupplyRegion_SUB, DSP_Types)) ^ ord(FullPlanningHorizon)))*
				PWF_f(DSCRT(SupplyRegion_SUB, DSP_Types),OLYEAR(first(PlanYear_), DSP_Types)-1);
				
				!DETERMINE PRESENT VALUE OF FIXED O&M AT OLYR INCLUDE EXTERNALITY COSTS, IF ANY
				
				FOM((SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DSP_Types) + 1) :=
				(EPFOM(DSP_Types, SupplyRegion_SUB, cyr) + EPCFOM(DSP_Types, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DSP_Types, PlanYear));
				
				!EXTR are not converted, exist but not used in FORTRAN  */
				
				FOML((SupplyRegion_SUB, DSP_Types, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1) :=
				(EPFOM(DSP_Types, SupplyRegion_SUB, cyr) + EPCFOM(DSP_Types, SupplyRegion_SUB, cyr)) * UPGNPD(OLYEAR_MNUMRF(FullPlanningHorizon, DSP_Types, first(PlanYear)));
				
				PVFOM(SupplyRegion_SUB, DSP_Types, PlanYear) :=
				 sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(PlanYear, DSP_Types) + 1,
				!PVV_Function(FOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOM(SupplyRegion_SUB, DSP_Types, PlanYear, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(PlanYear, DSP_Types)-1);
				
				!PV$EXT is not converted, exists but not used in FORTRAN  */
				
				! COMPUTE LEVELIZED GENERATION O&M, SUBSIDY AND EXTERNALITY COSTS
				PVFOML(SupplyRegion_SUB, DSP_Types) :=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1,
				!PVV_Function(FOML(SupplyRegion_SUB, DSP_Types, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr))) *
				FOML(SupplyRegion_SUB, DSP_Types, FullPlanningHorizon) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))*
				PWF_f(EPDSCRT('1', SupplyRegion_SUB, cyr),OLYEAR(first(PlanYear), DSP_Types)-1);
				
				PVGNPR(SupplyRegion_SUB, DSP_Types) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), DSP_Types),(UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1),
				(EPDSCRT('1', SupplyRegion_SUB, cyr) - UPRSK(DSP_Types)));
				PVGNP(SupplyRegion_SUB, DSP_Types) :=
				 EP_LGNP_f(OLYEAR(first(PlanYear), DSP_Types),(UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1),EPDSCRT('1', SupplyRegion_SUB, cyr));
				EPLVFOM_calc(DSP_Types, SupplyRegion_SUB, cyr) := PVFOML(SupplyRegion_SUB, DSP_Types) /$ PVGNP(SupplyRegion_SUB, DSP_Types);
				EPLVEXT_calc(DSP_Types, SupplyRegion_SUB, cyr) := (- PVSOML(SupplyRegion_SUB, DSP_Types)) /$ PVGNP(SupplyRegion_SUB, DSP_Types);
				
				
				! IF SUBSIDY LIMIT FOR INVESTMENT TAX CREDIT, REMOVE IT FOR ADDITIONS WITHOUT SUBSIDY
				ANNRTE(DSP_Types):=(UPANNADJ(DSP_Types, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(DSP_Types, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((DSP_Types, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(DSP_Types, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(DSP_Types, last(MNUMYR)) * ANNRTE(DSP_Types) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ((SupplyRegion_SUB, DSP_Types, PlanYear) | OLYEAR(PlanYear, DSP_Types) <= UNXPH('1') AND UPVTYP(DSP_Types)= 1 and
				UPAVLYR(DSP_Types)<= FULLYEAR_ALT(PlanYear, DSP_Types) AND (UPBLDREG_us00(DSP_Types)> 0 AND UPBLDREG(DSP_Types, SupplyRegion_SUB)>0)):=
				if OLYEAR(PlanYear, DSP_Types)< UNXPH('1') then
				  IF (CURIYR('1')+OLYEAR(PlanYear, DSP_Types)-1) <= UNYEAR('1') THEN
				        UPANNADJ(DSP_Types, element(MNUMYR_,CURIYR('1')+OLYEAR(PlanYear, DSP_Types)-1))
				  ELSE
				        UPANNADJ(DSP_Types, last(MNUMYR)) * ANNRTE(DSP_Types) ^ ((CURIYR('1')+OLYEAR(PlanYear, DSP_Types)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(ANN(DSP_Types, FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))/
				        ANN(DSP_Types, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        !PVV_Function(AN1(FullPlanningHorizon+UNXPH('1') - 1),ord(FullPlanningHorizon),EPDSCRT('1', SupplyRegion_SUB, cyr)))
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				Condition_DSP((SupplyRegion_SUB,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type) | ORD(ElasticityStep) <= MAX(1,ESTSWTCH(DSP_Types)) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, DSP_Types) <= UNXPH('1') AND UPVTYP(DSP_Types)= 1 and
				UPAVLYR(DSP_Types)<= FULLYEAR_ALT(PlanYear, DSP_Types) AND (UPBLDREG_us00(DSP_Types)> 0 AND UPBLDREG(DSP_Types, SupplyRegion_SUB)>0)):=1;
				
				Condition_DSP_Fuel((SupplyRegion_SUB,FuelRegion,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type) | ORD(ElasticityStep) <= MAX(1,ESTSWTCH(DSP_Types)) and
				UPBLDTYP(SupplyRegion_SUB)=ord(OwnerType) and OLYEAR(PlanYear, DSP_Types) <= UNXPH('1') AND UPVTYP(DSP_Types)= 1 and
				UPAVLYR(DSP_Types)<= FULLYEAR_ALT(PlanYear, DSP_Types) AND (UPBLDREG_us00(DSP_Types)> 0 AND UPBLDREG(DSP_Types, SupplyRegion_SUB)>0) AND
				FL_CNXT_CST(SupplyRegion_SUB, FuelRegion)>0):=1;
				
				CapCost_Adjustment_NETLprogram;
				
				OVRCST((SupplyRegion_SUB, DSP_Types, PlanYear,OwnerType,ElasticityStep,subsidy_type)|
				Condition_DSP(SupplyRegion_SUB, DSP_Types, PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				UPOVR(DSP_Types) * UPLRPC(DSP_Types) * UPLROPT(DSP_Types) * UPLRLC(DSP_Types) * EPRGM(DSP_Types, SupplyRegion_SUB, cyr) * EPACM(DSP_Types, SupplyRegion_SUB, cyr) *
				ESTCPCST(DSP_Types, ElasticityStep) * ANNADJ(SupplyRegion_SUB, DSP_Types, PlanYear) * B_CCST_ADJ_ALT(DSP_Types, first(FuelRegion), SupplyRegion_SUB, PlanYear);
				OVRCST((SupplyRegion_SUB, DSP_Types, PlanYear,OwnerType,ElasticityStep,SubsidyType_X)| UPSUBCAS(DSP_Types)= 2 AND Subsidy_Case(PlanYear, DSP_Types)=2)/=
				      (1.0 - UPCSB(DSP_Types));
				
				
				
				ROR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTROR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGROR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type)
				endif;
				
				INTR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type):=
				if ord(OwnerType)=1 then
				UTINT(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type)
				elseif ord(OwnerType)=2 then
				EWGINT(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type)
				endif;
				EPINCST_p(
					PLTS         : DSP_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DSP(SupplyRegion_SUB,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					CLT          : UPCLYR(DSP_Types) ,
					PLT          : UPPLYR(DSP_Types) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PROFILE      : UPCPRO(DSP_Types, ConstructionPeriod) ,
					CAPESC       : UPCAPD(MNUMYRX, DSP_Types) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					DEBT_F       : DEBT_F(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					ROR          : ROR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				PRATIO(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				TXBOOK(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) / $
				FNBOOK(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				CAPNNSTL(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) :=
				FNBOOK(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				
				
				EPNBLD_p(
					PLTS         : DSP_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DSP(SupplyRegion_SUB,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					ROR          : UTROR(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					DR           : DSCRT_WRSK(SupplyRegion_SUB, DSP_Types) ,
					RATIO        : PRATIO(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					PE           : EPUFPE('1', SupplyRegion_SUB, cyr) ,
					EL           : UPECLF(DSP_Types) ,
					TL           : UPTXLF(DSP_Types) ,
					T            : UPTXRT('1') ,
					CL           : UPUCLF(DSP_Types) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) ) ;
				EPCNBLD_p(
					PLTS         : DSP_Types_ ,
					Steps        : ElasticityStep_ ,
					SubCondition : Condition_DSP(SupplyRegion_SUB,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type) ,
					DF2          : DEBT_F(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					RATIO        : PRATIO(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) ,
					ROEPRM       : UPNRPRM('1') ,
					INTPRM       : UPNIPRM('1') ,
					UTROE        : UTROE(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					UTINT        : UTINT(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, subsidy_type) ,
					TR           : UPTXRT('1') ,
					TL           : UPTXLF(DSP_Types) ,
					CL           : UPNCLF(DSP_Types) ,
					DL2          : UPNLLF(DSP_Types) ,
					CAP          : CAPNUG(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) );
				CAP((SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_DSP(SupplyRegion_SUB,DSP_Types,PlanYear,OwnerType,ElasticityStep,subsidy_type)):=
				if ord(OwnerType)=2 then
				CAPNUG(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				elseif ord(OwnerType)=1 then
				CAPUTIL(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type)
				endif;
				
				TRANS(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear) := (FL_CNXT_CST(SupplyRegion_SUB, FuelRegion) + EPCTRM(DSP_Types, SupplyRegion_SUB, cyr)) *
				UPGNPD(element(MNUMYRF_,(OLYEAR(PlanYear, DSP_Types)+CURIYR('1')-1))) * EPCCRF(DSP_Types, SupplyRegion_SUB, cyr);
				
				OBJVAL((SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) |
				Condition_DSP_Fuel(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type)):=
				(( CAPNNSTL(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) *
				CAP(SupplyRegion_SUB, DSP_Types, PlanYear, OwnerType, ElasticityStep, subsidy_type) + TRANS(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear) ) / $
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types) ,(UNFPH('1') - OLYEAR(PlanYear, DSP_Types) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types),OLYEAR(PlanYear, DSP_Types));
				
				!PV$EXT and PV$GPS are not converted, exist but not used in FORTRAN  */
				ccalc_cB_DSP_ECPCOSTS((SupplyRegion_SUB, DSP_Types, OwnerType, FuelRegion, ElasticityStep, PlanYear) |
				Condition_DSP_Fuel(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, SubsidyType_X)):=
				IF (UPSUBCAS(DSP_Types)= 1 AND Subsidy_Case(PlanYear, DSP_Types)=2) THEN
				        OBJVAL(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, DSP_Types, PlanYear)
				ELSE
				        OBJVAL(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, SubsidyType_X) + PVFOM(SupplyRegion_SUB, DSP_Types, PlanYear)  -
				        PVSOM(SupplyRegion_SUB, DSP_Types, PlanYear)
				ENDIF;
				!
				ccalc_cBDSPSUB_ECPCOSTS((SupplyRegion_SUB, DSP_Types, OwnerType, FuelRegion, ElasticityStep, PlanYear) |
				Condition_DSP_Fuel(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) and Subsidy_Case(PlanYear, DSP_Types)=2):=
				OBJVAL(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear, OwnerType, ElasticityStep, SubsidyType_S) + PVFOM(SupplyRegion_SUB, DSP_Types, PlanYear) -
				PVSOM(SupplyRegion_SUB, DSP_Types, PlanYear)  ;
				!
				!STORE INDEX FOR AVAILABILITY OF TECHNOLOGY AND SUBSIDY
				BUILD_AVL_calc((DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) | UPBLDREG(DSP_Types, SupplyRegion)> 0.0 and
				Condition_DSP(SupplyRegion, DSP_Types, PlanYear, element(OwnerType_,UPBLDTYP(SupplyRegion)), ElasticityStep1, SubsidyType_X)) :=Subsidy_Case(PlanYear, DSP_Types);
				
				subsidy_type0(PlanYear, DSP_Types):=element(Subsidy_Type_, Subsidy_Case(PlanYear, DSP_Types)) ;
				
				
				EPLVCAP_calc(DSP_Types, OwnerType, SupplyRegion_SUB, cyr):=
				(( CAPNNSTL(SupplyRegion_SUB, DSP_Types, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), DSP_Types)) *
				CAP(SupplyRegion_SUB, DSP_Types, first(PlanYear), OwnerType, ElasticityStep1, subsidy_type0(first(PlanYear), DSP_Types)) ) /
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types) ,(UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types),OLYEAR(first(PlanYear), DSP_Types)) /$ PVGNP(SupplyRegion_SUB, DSP_Types);
				
				EPLVFCF_calc(DSP_Types, OwnerType, SupplyRegion_SUB, cyr):=EPLVCAP_calc(DSP_Types, OwnerType, SupplyRegion_SUB, cyr)/$
				OVRCST(SupplyRegion_SUB, DSP_Types, first(PlanYear),OwnerType,ElasticityStep1,subsidy_type0(first(PlanYear), DSP_Types));
				
				EPLVTRN_calc(DSP_Types, SupplyRegion_SUB, cyr):=
				(TRANS(SupplyRegion_SUB, first(FuelRegion), DSP_Types, first(PlanYear)) /
				CRF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types),(UNFPH('1') - OLYEAR(first(PlanYear), DSP_Types) + 1)) ) *
				PWF_f(DSCRT_WRSK(SupplyRegion_SUB, DSP_Types) ,OLYEAR(first(PlanYear), DSP_Types)) /$ PVGNP(SupplyRegion_SUB, DSP_Types);
				
				EPLVBCK_calc(DSP_Types, SupplyRegion_SUB, cyr):=1;
				
				!PURCHASED CAPACITY ROW
				ccalc_cB_DSP_rPXXXXXn((SupplyRegion_SUB, PlanYear, DSP_Types, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				Condition_DSP_Fuel(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, DSP_Types)):=
				0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_X);
				
				ccalc_cBDSPSUB_rPXXXXXn((SupplyRegion_SUB, PlanYear, DSP_Types, OwnerType, FuelRegion, ElasticityStep, PlanYear_ALTB) |
				Condition_DSP_Fuel(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S) and
				Subsidy_Case(PlanYear, DSP_Types)=2 and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, DSP_Types)):=
				0.001 * OBJVAL(SupplyRegion_SUB, FuelRegion, DSP_Types, PlanYear_ALTB, OwnerType, ElasticityStep, SubsidyType_S);
			}
			Comment: {
				"Calculates costs for EP$BDSP subroutine: ccalc_cB_DSP_ECPCOSTS and ccalc_cBDSPSUB_ECPCOSTS;
				also, ccalc_cB_DSP_rPXXXXXn and ccalc_cBDSPSUB_rPXXXXXn"
			}
			DeclarationSection Local_Declaration {
				Parameter ANNRTE {
					IndexDomain: PlantType;
				}
				Parameter ANNADJ {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (PlantType,FullPlanningHorizon);
				}
				Parameter ITCADJ {
					IndexDomain: (PlantType,PlanYear);
				}
				Parameter TRANS {
					IndexDomain: (SupplyRegion, FuelRegion, PlantType, PlanYear);
				}
				Parameter OBJVAL {
					IndexDomain: (SupplyRegion, FuelRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, PlantType, PlanYear,OwnerType,ElasticityStep,subsidy_type);
				}
				Parameter GENNEW {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter SOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter SOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVSOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVSOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter TOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter EXTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,FullPlanningHorizon);
				}
				Parameter FOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter TOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter VOML {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter EXTL {
					IndexDomain: (SupplyRegion,PlantType,FullPlanningHorizon);
				}
				Parameter PVARB {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVTOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVVOM {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVEXT {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter PVFOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVTOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVVOML {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVEXTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,PlantType,PlanYear,OwnerType,subsidy_type);
				}
				Parameter DSCRT {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter DSCRT_WRSK {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter Condition_DSP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter Condition_DSP_Fuel {
					IndexDomain: (SupplyRegion, FuelRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAP {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FLCST {
					IndexDomain: (SupplyRegion,PlantType,PlanYear);
				}
				Parameter FLCSTL {
					IndexDomain: (SupplyRegion,PlantType);
				}
				ElementParameter subsidy_type0 {
					IndexDomain: (PlanYear, PlantType);
					Range: Subsidy_Type_;
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
				Parameter CAPNUG {
					IndexDomain: (SupplyRegion, PlantType, PlanYear, OwnerType, ElasticityStep, subsidy_type);
				}
			}
		}
		Procedure Calculate_NGRETBLDCOSTS {
			Body: {
				
				Condition_NGBS((NaturalGasGroup_SUB, NGCommitYear) |
				ord(NGCommitYear)<=N_OPT(NaturalGasGroup_SUB) and
				GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup_SUB)>0.001):=1;
				
				
				
				ANNRTE:=(UPANNADJ(WICC_Element, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(WICC_Element, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(WICC_Element, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(WICC_Element, last(MNUMYR)) * ANNRTE ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ:=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				ANN(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + AVGUDCR) ^ ord(FullPlanningHorizon)))/
				!PVV_Function(ANN(FullPlanningHorizon),ord(FullPlanningHorizon),AVGUDCR))/
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + AVGUDCR) ^ ord(FullPlanningHorizon)));
				!PVV_Function(AN1(FullPlanningHorizon+),ord(FullPlanningHorizon),AVGUDCR));
				
				!OwnerType and subsidy_type dimensions are not needed but are required to use EPINCST_p and EPNBLD_p procedures
				SubCondition((NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType_X)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and OPT(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=2 and
				TEST_OBJ(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=1):=1;
				!
				ROR(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				if USW_RTRSK('1')<=0 then
				EPUROR('1', NGSupplyRegion(NaturalGasGroup_SUB), cyr)
				else
				EPURORR('1', NGSupplyRegion(NaturalGasGroup_SUB), cyr)
				endif;
				!
				INTR(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				if USW_RTRSK('1')<=0 then
				EPUIRT('1', NGSupplyRegion(NaturalGasGroup_SUB), cyr)
				else
				EPUIRTR('1', NGSupplyRegion(NaturalGasGroup_SUB), cyr)
				endif;
				
				FDT(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUFDT('1', NGSupplyRegion(NaturalGasGroup_SUB), cyr);
				
				FPE(SupplyRegion_SUB):=
				if USW_RTRSK('1')<=0 then
				EPUFPE('1', SupplyRegion_SUB, cyr)
				else
				EPUFPER('1', SupplyRegion_SUB, cyr)
				endif;
				
				OVRCST((NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear,OwnerType1,NGCommitYear,SubsidyType_X)|
				SubCondition(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType_X)=1):=
				GRP_CCS_O(NaturalGasGroup_SUB) * TCCF_GL(LastModelYear_MNUMYR(PlanYear), element(Four_,3)) * ANNADJ;
				!
				CLT(NaturalGasGroup_SUB):=UPSCLT('1');
				PROFILE(NaturalGasGroup_SUB, ConstructionPeriod):= UPSCPR(ConstructionPeriod);
				CAPESC(MNUMYRX, NaturalGasGroup_SUB):=UPCAPD(MNUMYRX, WICC_Element);
				CL(NaturalGasGroup_SUB):=UPSELF('1');
				TL(NaturalGasGroup_SUB):=UPSTXLF(Two_element);
				
				EPINCST_p(
					PLTS         : NaturalGasGroup_SUB_ ,
					Steps        : NGCommitYear_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ,
					CLT          : CLT(NaturalGasGroup_SUB) ,
					PLT          : CLT(NaturalGasGroup_SUB) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, NaturalGasGroup, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ,
					PROFILE      : PROFILE(NaturalGasGroup_SUB, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, NaturalGasGroup_SUB) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) );
				PRATIO(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X) :=
				TXBOOK(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X) / $
				FNBOOK(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X);
				CAPNNSTL(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X) :=
				FNBOOK(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X);
				!
				DR_EPNBLD(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB):=AVGUDCR;
				EPNBLD_p(
					PLTS         : NaturalGasGroup_SUB_ ,
					Steps        : NGCommitYear_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, NaturalGasGroup_SUB) ,
					RATIO        : PRATIO(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : CL(NaturalGasGroup_SUB),
					TL           : TL(NaturalGasGroup_SUB) ,
					T            : UPTXRT('1') ,
					CL           : CL(NaturalGasGroup_SUB) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, NaturalGasGroup_SUB, PlanYear, OwnerType1, NGCommitYear, SubsidyType1) ) ;
				
				ANN_INV((NaturalGasGroup_SUB, NGCommitYear, PlanYear)|Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				OPT(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=2 and TEST_OBJ(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=1) :=
				CAPNNSTL(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X)*
				CAPUTIL(NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, PlanYear, One_element, NGCommitYear, SubsidyType_X);
				
				ANN_INV((NaturalGasGroup_SUB, NGCommitYear, PlanYear)|Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				OPT(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=2 and TEST_OBJ(NaturalGasGroup_SUB, PlanYear, NGCommitYear)>1) :=
				ANN_INV(NaturalGasGroup_SUB, NGCommitYear, PlanYear-1);
				
				INV(NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon):=
				ANN_INV(NaturalGasGroup_SUB, NGCommitYear, PlanYear_FullPlanningHorizon(FullPlanningHorizon));
				
				FOM((NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(FullPlanningHorizon)<=END_YEAR_FULL(NaturalGasGroup_SUB, NGCommitYear)):=
				if NGOPT_plantA2(NaturalGasGroup_SUB, PlanYear_FullPlanningHorizon(FullPlanningHorizon), NGCommitYear)=GRP_ECP(NaturalGasGroup_SUB) then
				GRP_FOM(Explicit2FullPlanningHorizon(FullPlanningHorizon), NaturalGasGroup_SUB) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
				else
				(GRP_FOM(Explicit2FullPlanningHorizon(FullPlanningHorizon), NaturalGasGroup_SUB) +
				GRP_CCS_F(NaturalGasGroup_SUB) * TCCF_GL(LastModelYear_MNUMYR2(FullPlanningHorizon), element(Four_,3)))*
				UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
				endif;
				
				VOM((NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(FullPlanningHorizon)<=END_YEAR_FULL(NaturalGasGroup_SUB, NGCommitYear)):=
				if NGOPT_plantA2(NaturalGasGroup_SUB, PlanYear_FullPlanningHorizon(FullPlanningHorizon), NGCommitYear)=GRP_ECP(NaturalGasGroup_SUB) then
				(GRP_VOM(NaturalGasGroup_SUB) - EPVOM(NGGRP_plants(NaturalGasGroup_SUB), NGSupplyRegion(NaturalGasGroup_SUB), cyr)) * GRP_CF(NaturalGasGroup_SUB) * 8.760
				else
				((GRP_VOM(NaturalGasGroup_SUB) + GRP_CCS_V(NaturalGasGroup_SUB) * TCCV_GL(LastModelYear_MNUMYR2(FullPlanningHorizon), element(Four_,3))) -
				EPVOM(WIA2_Element, NGSupplyRegion(NaturalGasGroup_SUB), cyr)) * GRP_CF(NaturalGasGroup_SUB) * 8.760
				endif;
				
				PVFOM((NaturalGasGroup_SUB, NGCommitYear) | Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear)):=
				sum(FullPlanningHorizon,
				!PVV_Function(FOM(NaturalGasGroup, FullPlanningHorizon, NGCommitYear),ord(FullPlanningHorizon),AVGUDCR)) *
				!PWF_f(AVGUDCR,1);
				FOM(NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon) / ((1 + AVGUDCR) ^ ord(FullPlanningHorizon)))*
				((1 + AVGUDCR) ^ ( -1));
				
				PVVOM((NaturalGasGroup_SUB, NGCommitYear) | Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear)):=
				sum(FullPlanningHorizon,
				!PVV_Function(VOM(NaturalGasGroup, FullPlanningHorizon, NGCommitYear),ord(FullPlanningHorizon),AVGUDCR)) *
				!PWF_f(AVGUDCR,1);
				VOM(NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon) / ((1 + AVGUDCR) ^ ord(FullPlanningHorizon)))*
				((1 + AVGUDCR) ^ ( -1));
				
				PVINV((NaturalGasGroup_SUB, NGCommitYear) | Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear)):=
				sum(FullPlanningHorizon,
				INV(NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon) / ((1 + AVGUDCR) ^ ord(FullPlanningHorizon)))*
				((1 + AVGUDCR) ^ ( -1));
				
				
				!OBJECTIVE FUNCTION
				!EP$NGBS,4
				ccalc_cE_ECPCOSTS((NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear) |
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear)):=PVFOM(NaturalGasGroup_SUB, NGCommitYear) +
				PVVOM(NaturalGasGroup_SUB, NGCommitYear) + PVINV(NaturalGasGroup_SUB, NGCommitYear);
				
				!INTERSECT WITH CAPACITY ROWS
				!EP$NGBS,5
				ccalc_cE_rCMle((NGSupplyRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), NGFuelRegion(NaturalGasGroup_SUB),
				 Season, PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) ):=
				if Check_MR(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=1 then
				-1.0 * CAP_FCTR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) *
				GRP_CAP(ExplicitPlanningHorizon_element(PlanYear), NaturalGasGroup_SUB) /
				GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup_SUB) *
				GRP_SP_CAP_FAC(Season, NaturalGasGroup_SUB)
				endif;
				
				ccalc_cE_rCXle((NGSupplyRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), NGFuelRegion(NaturalGasGroup_SUB),
				 Season, PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) ):=
				if Check_MR(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=0 then
				-1.0 * CAP_FCTR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) *
				GRP_CAP(ExplicitPlanningHorizon_element(PlanYear), NaturalGasGroup_SUB) /
				GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup_SUB) *
				GRP_SP_CAP_FAC(Season, NaturalGasGroup_SUB)
				endif;
				
				!ADJUST FUEL CONSUMPTION
				!EP$NGBS,7
				ccalc_cE_rFXXle((NGFuelRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), GasSeason, PlanYear, NaturalGasGroup_SUB,
				 NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				 ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				if Check_MR(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=0 then
				 (0.001) * GEN_NGBS(NaturalGasGroup_SUB, PlanYear, GasSeason_element(GasSeason)) *
				 (UNIT_HTRT(NaturalGasGroup_SUB, PlanYear, NGCommitYear) -
				 AVG_HTRT(NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), NGFuelRegion(NaturalGasGroup_SUB), NGSupplyRegion(NaturalGasGroup_SUB), ExplicitPlanningHorizon_element(PlanYear)))
				endif;
				
				ccalc_cE_rFMRle((NGFuelRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), GasSeason, PlanYear, NaturalGasGroup_SUB,
				 NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)| Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				 ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				if Check_MR(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=1 then
				 (0.001) * GEN_NGBS(NaturalGasGroup_SUB, PlanYear, GasSeason_element(GasSeason)) *
				 (UNIT_HTRT(NaturalGasGroup_SUB, PlanYear, NGCommitYear) -
				 AVG_HTRT_MR(NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), NGFuelRegion(NaturalGasGroup_SUB), NGSupplyRegion(NaturalGasGroup_SUB), ExplicitPlanningHorizon_element(PlanYear)))
				endif;
				
				!INTERSECT RESERVE MARGIN ROW
				Value((NaturalGasGroup_SUB, PlanYear, NGCommitYear) |Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ) :=
				CAP_FCTR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) *
				GRP_CAP(ExplicitPlanningHorizon_element(PlanYear), NaturalGasGroup_SUB) /
				GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup_SUB);
				
				!EP$NGBS,9
				ccalc_cE_rRXXXXXge((NGSupplyRegion(NaturalGasGroup_SUB), PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				if  ord(PlanYear)>UPPLYR(WICT_element) then
				 Value(NaturalGasGroup_SUB, PlanYear, NGCommitYear)
				endif;
				
				ccalc_cE_rRXXXXXn((NGSupplyRegion(NaturalGasGroup_SUB), PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				if  ord(PlanYear)<=UPPLYR(WICT_element) then
				 Value(NaturalGasGroup_SUB, PlanYear, NGCommitYear)
				endif;
				
				!INTERSECT TOTAL CAPACITY ROW
				!EP$NGBS,10
				ccalc_cE_rTOTCAPn((NGSupplyRegion(NaturalGasGroup_SUB), PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				Value(NaturalGasGroup_SUB, PlanYear, NGCommitYear);
				
				!INTERSECT REGIONAL CAPACITY ROW
				!EP$NGBS,11
				ccalc_cE_rFCAPn((NGSupplyRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				Value(NaturalGasGroup_SUB, PlanYear, NGCommitYear);
				
				!INTERSECT MAXIMUM RETIREMENT ROW
				!EP$NGBS,12
				ccalc_cE_rRMXRET0ge((NGSupplyRegion(NaturalGasGroup_SUB), NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear) ):=
				IF UPRETRAT('1')>0 AND USW_ERET('1')=1 THEN
				 Value(NaturalGasGroup_SUB, PlanYear2_element, NGCommitYear)
				ENDIF;
				
				!INTERSECT PLANNED MAINTENACE ROW
				!EP$NGBS,13
				ccalc_cE_rMXXge((NGSupplyRegion(NaturalGasGroup_SUB), NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear), NGFuelRegion(NaturalGasGroup_SUB), PlanYear, NaturalGasGroup_SUB, NGGRP_plants(NaturalGasGroup_SUB), NGCommitYear)|
				Condition_NGBS(NaturalGasGroup_SUB, NGCommitYear)=1 and
				ord(PlanYear)<=END_YEAR(NaturalGasGroup_SUB, PlanYear, NGCommitYear) ):=
				if Check_MR(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=1 then
				   - 8.760 * UPPMRT(NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear)) * (1.0 - UPFORT(NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear)))
				else
				   - 8.760 * UPPMRT(NGOPT_plants(NaturalGasGroup_SUB, PlanYear, NGCommitYear))
				endif;
			}
			Comment: "Calculates coefficients for EP$NGBS subroutine";
			DeclarationSection Local_Declaration {
				Parameter ANNRTE;
				Parameter ANNADJ;
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (FullPlanningHorizon);
				}
				Parameter ANN_INV {
					IndexDomain: (NaturalGasGroup_SUB, NGCommitYear, PlanYear);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear,OwnerType,NGCommitYear,subsidy_type);
				}
				Parameter FOM {
					IndexDomain: (NaturalGasGroup, NGCommitYear, FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (NaturalGasGroup, NGCommitYear, FullPlanningHorizon);
				}
				Parameter INV {
					IndexDomain: (NaturalGasGroup_SUB, NGCommitYear, FullPlanningHorizon);
				}
				Parameter PVFOM {
					IndexDomain: (NaturalGasGroup,NGCommitYear);
				}
				Parameter PVVOM {
					IndexDomain: (NaturalGasGroup,NGCommitYear);
				}
				Parameter PVINV {
					IndexDomain: (NaturalGasGroup,NGCommitYear);
				}
				Parameter PVGNPR {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter PVGNP {
					IndexDomain: (SupplyRegion,PlantType);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,NaturalGasGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,NaturalGasGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter FDT {
					IndexDomain: (SupplyRegion,NaturalGasGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter FPE {
					IndexDomain: (SupplyRegion);
				}
				Parameter DR_EPNBLD {
					IndexDomain: (SupplyRegion,NaturalGasGroup_SUB);
				}
				Parameter Condition_NGBS {
					IndexDomain: (NaturalGasGroup,NGCommitYear);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear, OwnerType, NGCommitYear, subsidy_type);
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear, OwnerType, NGCommitYear, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear, OwnerType, NGCommitYear, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear, OwnerType, NGCommitYear, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, NaturalGasGroup, PlanYear, OwnerType, NGCommitYear, subsidy_type);
				}
				Parameter SubCondition {
					IndexDomain: (SupplyRegion,NaturalGasGroup,PlanYear,OwnerType,NGCommitYear,subsidy_type);
				}
				Parameter CLT {
					IndexDomain: NaturalGasGroup_SUB;
				}
				Parameter CL {
					IndexDomain: NaturalGasGroup_SUB;
				}
				Parameter TL {
					IndexDomain: NaturalGasGroup_SUB;
				}
				Parameter PROFILE {
					IndexDomain: (NaturalGasGroup_SUB,ConstructionPeriod);
				}
				Parameter CAPESC {
					IndexDomain: (MNUMYRX,NaturalGasGroup_SUB);
				}
				Parameter Value {
					IndexDomain: (NaturalGasGroup_SUB, PlanYear, NGCommitYear);
				}
			}
		}
		Procedure Calculate_CL_NNGCOSTS {
			Body: {
				!Create Coal to Natural Gas Conversion Vectors -
				!Note: unlike other retrofit options these vectors convert capacity for the rest of the planning horizon
				OV_CLtNG(CoalGroup_SUB,PlanYear):=
				  IF (USW_EPA111('1') and (CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1) > UEPA_GSYR('1')) then
				     0
				  else
				     ECL_CL_NG_COST(CoalGroup_SUB)+ECL_CL_NG_TRAN(CoalGroup_SUB)
				  endif;
				
				VAL_CL_NG((SupplyRegion_SUB, Season, CoalGroup_SUB)|ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr)) :=
				-(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECL_SP_CAP_FAC(Season, CoalGroup_SUB);
				!Check for NaNQ
				VAL_CL_NG((SupplyRegion_SUB, Season, CoalGroup_SUB)| Mapval(VAL_CL_NG(SupplyRegion_SUB, Season, CoalGroup_SUB))>0):=-1;
				
				!Planned Maintenance Requirement
				VAL_CL_NG1(SupplyRegion_SUB, PlanYear, CoalGroup_SUB) := - 8.760 *
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				if ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))>0 then
				  ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))
				else
				  UPPMRT(WING_Element)
				endif;
				!Check
				VAL_CL_NG1((SupplyRegion_SUB, PlanYear, CoalGroup_SUB)| abs(VAL_CL_NG1(SupplyRegion_SUB, PlanYear, CoalGroup_SUB))<ECP_MIN('1')):=0;
				
				ANNRTE:=(UPANNADJ(WING_Element, element(MNUMYR_,UNYEAR('1'))) / UPANNADJ(WING_Element, element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(WING_Element, ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(WING_Element, last(MNUMYR)) * ANNRTE ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ(SupplyRegion_SUB, PlanYear):=
				if ord(PlanYear)< UNXPH('1') then
				  IF (CURIYR('1')+ord(PlanYear)-1) <= UNYEAR('1') THEN
				        UPANNADJ(WING_Element, LastModelYear_MNUMYR(PlanYear))
				  ELSE
				        UPANNADJ(WING_Element, last(MNUMYR)) * ANNRTE ^ ((CURIYR('1')+ord(PlanYear)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        ANN(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				
				OVRCST(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, '1', SubsidyType_X):=
				OV_CLtNG(CoalGroup_SUB,PlanYear) * ANNADJ(SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear);
				
				ROR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUROR('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				!
				INTR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUIRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				FDT(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUFDT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				FPE(SupplyRegion_SUB):= EPUFPE('1', SupplyRegion_SUB, cyr);
				!
				CLT(CoalGroup_SUB):=UPSCLT('1');
				PROFILE(CoalGroup_SUB, ConstructionPeriod):= UPSCPR(ConstructionPeriod);
				CAPESC(MNUMYRX, CoalGroup_SUB):=UPCAPD(MNUMYRX, WING_Element);
				CL(CoalGroup_SUB):=UPSELF('1');
				TL(CoalGroup_SUB):=
				if ECL_YR(CoalGroup_SUB)< UPSTXYR('1') then
				  UPSTXLF(One_element)
				else
				  UPSTXLF(Two_element)
				endif;
				
				SubCondition((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, '1', SubsidyType_X)|
				(CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear)>0 and ord(PlanYear)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001):=1;
				
				EPINCST_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : ScalarSet_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					CLT          : CLT(CoalGroup_SUB) ,
					PLT          : CLT(CoalGroup_SUB) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					PROFILE      : PROFILE(CoalGroup_SUB, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, CoalGroup_SUB) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) );
				PRATIO(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, ScalarSet, SubsidyType_X) :=
				TXBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, ScalarSet, SubsidyType_X) / $
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, ScalarSet, SubsidyType_X);
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, ScalarSet, SubsidyType_X) :=
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, ScalarSet, SubsidyType_X);
				
				DR_EPNBLD(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB):=EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				EPNBLD_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : ScalarSet_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, CoalGroup_SUB) ,
					RATIO        : PRATIO(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : CL(CoalGroup_SUB),
					TL           : TL(CoalGroup_SUB) ,
					T            : UPTXRT('1') ,
					CL           : CL(CoalGroup_SUB) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ) ;
				
				CLtNG_Annuity(CoalGroup_SUB, PlanYear):=
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, '1', SubsidyType_X)*
				CAPUTIL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, '1', SubsidyType_X);
				
				OBJ_CLtNG(CoalGroup_SUB, PlanYear):= (CLtNG_Annuity(CoalGroup_SUB, PlanYear)/$
				CRF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),(UNFPH('1') - ord(PlanYear) + 1))) *
				PWF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),ord(PlanYear)-1);
				
				ECPt_FROM(CoalGroup_SUB, PlanYear):= element(PlantType_,
				UCL_ECP(I_CoalConfiguration(CoalGroup_SUB, PlanYear)));
				ITYP(CoalGroup_SUB, PlanYear):= CapacityType_element(ECPt_FROM(CoalGroup_SUB, PlanYear));
				LYR_CL_Parameter(PlanYear) := MIN(ord(PlanYear)+1 , UNXPH('1'));
				LYR_CL(PlanYear) := element(PlanYear_ , LYR_CL_Parameter(PlanYear));
				CF_COAL(CoalGroup_SUB, PlanYear) :=
				IF (UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)), ITYP(CoalGroup_SUB, PlanYear), CoalDemandRegion_CoalGroup(CoalGroup_SUB)) > 0.001) THEN
				  MIN(UPMCF(ECPt_FROM(CoalGroup_SUB, PlanYear)) ,
				  UECP_GEN(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)), ITYP(CoalGroup_SUB, PlanYear), CoalDemandRegion_CoalGroup(CoalGroup_SUB)) /
				  (8.76 * UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)), ITYP(CoalGroup_SUB, PlanYear), CoalDemandRegion_CoalGroup(CoalGroup_SUB))))
				ELSE
				  0.10
				ENDIF;
				CF_COAL(CoalGroup_SUB, PlanYear):= MAX(CF_COAL(CoalGroup_SUB, PlanYear) , 0.10);
				CF_COAL(CoalGroup_SUB, PlanYear):= MAX(EMM_CL_CF(CoalGroup_SUB, LastModelYear_MNUMYR(PlanYear)), CF_COAL(CoalGroup_SUB, PlanYear));
				
				
				FOM((CoalGroup_SUB, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)>=ord(PlanYear) and
				SubCondition(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, '1', SubsidyType_X)):=
				ECL_FOM(Explicit2FullPlanningHorizon(FullPlanningHorizon), CoalGroup_SUB) *
				UCL_CL_NG_FOM_ADJ('1') * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
				
				VOM((CoalGroup_SUB, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)>=ord(PlanYear) and
				SubCondition(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, '1', SubsidyType_X)):=
				((ECL_VADJ(Explicit2FullPlanningHorizon(FullPlanningHorizon), CoalGroup_SUB) * UCL_CL_NG_VOM_ADJ('1')) -
				EPVOM(WING_Element, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) * CF_COAL(CoalGroup_SUB, PlanYear) * 8.760 *
				UPGNPD(MNUMYRF_KYR(FullPlanningHorizon));
				
				PVFOM(CoalGroup_SUB, PlanYear):=
				sum(FullPlanningHorizon,
				FOM(CoalGroup_SUB, PlanYear, FullPlanningHorizon) /
				((1 + EPDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				PVVOM(CoalGroup_SUB, PlanYear):=
				sum(FullPlanningHorizon,
				VOM(CoalGroup_SUB, PlanYear, FullPlanningHorizon) /
				((1 + EPDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				!EP$COAL,28
				ccalc_cNNG_ECPCOSTS(CoalGroup_SUB, PlanYear):=OBJ_CLtNG(CoalGroup_SUB, PlanYear)+
				PVFOM(CoalGroup_SUB, PlanYear)+PVVOM(CoalGroup_SUB, PlanYear);
				
				!to impose the same conversion cost to coal part of cofiring capacity if the model chooses coal-gas co-firing instead of 100% coal to gas conversion
				ccalc_cNNGCL_ECPCOSTS(element(CommitYear_,ord(PlanYear)),CoalGroup_SUB):=OBJ_CLtNG(CoalGroup_SUB, PlanYear)+
				PVFOM(CoalGroup_SUB, PlanYear)+PVVOM(CoalGroup_SUB, PlanYear);
			}
			Comment: "Condition (UCL_VIN(IYR) .GT. 0 .AND. IFRST .EQ. 1) is replaced with PlanYear>1 since IFRST=1 for all Plan years and UCL_VIN(1)=0";
			Parameter VAL_CL_NG {
				IndexDomain: (SupplyRegion_SUB, Season, CoalGroup_SUB);
			}
			Parameter VAL_CL_NG1 {
				IndexDomain: (SupplyRegion_SUB, PlanYear, CoalGroup_SUB);
			}
			Parameter VALUe_CL {
				IndexDomain: (SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration);
			}
			Parameter CF_FL;
			Parameter ANNRTE;
			Parameter ANNADJ {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
			}
			Parameter AN1 {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter ANN {
				IndexDomain: (FullPlanningHorizon);
			}
			Parameter OVRCST {
				IndexDomain: (SupplyRegion, CoalGroup_SUB, PlanYear,OwnerType,ScalarSet,subsidy_type);
			}
			Parameter ROR {
				IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
			}
			Parameter INTR {
				IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
			}
			Parameter FDT {
				IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
			}
			Parameter FPE {
				IndexDomain: (SupplyRegion);
			}
			Parameter SubCondition {
				IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,ScalarSet,subsidy_type);
			}
			Parameter DR_EPNBLD {
				IndexDomain: (SupplyRegion,CoalGroup_SUB);
			}
			Parameter CAPUTIL {
				IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, ScalarSet, subsidy_type);
			}
			Parameter TXBOOK {
				IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, ScalarSet, subsidy_type);
			}
			Parameter FNBOOK {
				IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, ScalarSet, subsidy_type);
			}
			Parameter PRATIO {
				IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, ScalarSet, subsidy_type);
			}
			Parameter CAPNNSTL {
				IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, ScalarSet, subsidy_type);
			}
			Parameter CLT {
				IndexDomain: CoalGroup_SUB;
			}
			Parameter PROFILE {
				IndexDomain: (CoalGroup_SUB,ConstructionPeriod);
			}
			Parameter CAPESC {
				IndexDomain: (MNUMYRX,CoalGroup_SUB);
			}
			Parameter CL {
				IndexDomain: CoalGroup_SUB;
			}
			Parameter TL {
				IndexDomain: CoalGroup_SUB;
			}
			Parameter CLtNG_Annuity {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter OBJ_CLtNG {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			Parameter FOM {
				IndexDomain: (CoalGroup_SUB,PlanYear,FullPlanningHorizon);
			}
			Parameter VOM {
				IndexDomain: (CoalGroup_SUB,PlanYear,FullPlanningHorizon);
			}
			Parameter PVFOM {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter PVVOM {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter CF_COAL {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			ElementParameter ECPt_FROM {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: PlantType_;
			}
			ElementParameter ECPt_TO {
				IndexDomain: CoalConfiguration;
				Range: PlantType_ECP_;
			}
			ElementParameter ECPt_TO1 {
				IndexDomain: CoalConfiguration;
				Range: PlantType_;
			}
			ElementParameter LYR_CL {
				IndexDomain: PlanYear;
				Range: PlanYear_;
			}
			Parameter LYR_CL_Parameter {
				IndexDomain: PlanYear;
			}
			ElementParameter ITYP {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: CapacityType_;
			}
		}
		Procedure Calculate_CL_RETROFITCOSTS {
			Body: {
				ECPt_TO(CoalConfiguration):=element(PlantType_, UCL_ECP(CoalConfiguration));
				ECPt_FROM(CoalGroup_SUB, PlanYear):= element(PlantType_,
				UCL_ECP(I_CoalConfiguration(CoalGroup_SUB, PlanYear)));
				ITYP(CoalGroup_SUB, PlanYear):= CapacityType_element(ECPt_FROM(CoalGroup_SUB, PlanYear));
				
				!Determine Cost
				
				ANNRTE(CoalConfiguration):=(UPANNADJ(ECPt_TO(CoalConfiguration), element(MNUMYR_,UNYEAR('1'))) /$
				UPANNADJ(ECPt_TO(CoalConfiguration), element(MNUMYR_,UNYEAR('1') - 10))) ^ (1.0 / 10.0);
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNAPH('1')) :=1;
				
				ANN((CoalConfiguration, FullPlanningHorizon)| UNXPH('1')<=ord(FullPlanningHorizon)<=UNAPH('1')):=
				IF (CURIYR('1')+ord(FullPlanningHorizon)-1) <= UNYEAR('1') THEN
				        UPANNADJ(ECPt_TO(CoalConfiguration), ModelYear_MNUMYR1(FullPlanningHorizon))
				ELSE
				        UPANNADJ(ECPt_TO(CoalConfiguration), last(MNUMYR)) *
				        ANNRTE(CoalConfiguration) ^ ((CURIYR('1')+ord(FullPlanningHorizon)-1) - UNYEAR('1'))
				ENDIF;
				
				ANNADJ(CoalConfiguration, SupplyRegion_SUB, PlanYear):=
				if ord(PlanYear)< UNXPH('1') then
				  IF (CURIYR('1')+ord(PlanYear)-1) <= UNYEAR('1') THEN
				        UPANNADJ(ECPt_TO(CoalConfiguration), LastModelYear_MNUMYR(PlanYear))
				  ELSE
				        UPANNADJ(ECPt_TO(CoalConfiguration), last(MNUMYR)) * ANNRTE(CoalConfiguration) ^ ((CURIYR('1')+ord(PlanYear)-1) - UNYEAR('1'))
				  ENDIF
				else
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        ANN(CoalConfiguration, FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				        AN1(FullPlanningHorizon+UNXPH('1') - 1) / ((1 + EPDSCRT('1', SupplyRegion_SUB, cyr)) ^ ord(FullPlanningHorizon)))
				endif;
				!USE Weighted Capacity Factor for All Periods in the Explicit Planning Horizon
				TCF((CoalGroup_SUB, PlanYear, FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1')-ord(PlanYear)+1):=
				max(0.75 , EMM_CL_CF(CoalGroup_SUB, Element(MNUMYR_,min(UNYEAR('1'),CURIYR('1')+ord(FullPlanningHorizon)+ord(PlanYear)-2))));
				KW(FullPlanningHorizon) :=1;
				
				CF_COAL(CoalGroup_SUB, PlanYear):=sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')-ord(PlanYear)+1,
				        TCF(CoalGroup_SUB, PlanYear, FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)))/
				        sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')-ord(PlanYear)+1,
				        KW(FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				VADJ((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				ECL_VADJ(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) +
				if ord(RetrofitCFG)<>1 then
				if (UCL_ROPT('1', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD FGD
				ECL_FGD_V(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('2', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD COMB
				ECL_CMB_V(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('3', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SNCR
				ECL_SNCR_V(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('4', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SCR
				ECL_SCR_V(CoalGroup_SUB)
				endif
				endif;
				
				FOM((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				max(ECL_FOM(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB), 0) +
				if ord(RetrofitCFG)<>1 then
				if (UCL_ROPT('1', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD FGD
				(UPFOM(WIB3_Element) - UPFOM(WIB1_Element))
				endif +
				if (UCL_ROPT('2', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD COMB
				ECL_CMB_F(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('3', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SNCR
				ECL_SNCR_F(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('4', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SCR
				ECL_SCR_F(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('6', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD FF
				UCL_FF_F('1')
				endif
				endif;
				
				OV_CST((CoalGroup_SUB, PlanYear, RetrofitCFG)| ord(RetrofitCFG)<>1 and
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				if (UCL_ROPT('1', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD FGD
				!DON'T ALLOW FGD IF DSI INSTALLED
				if ((CURIYR('1') + UHBSYR('1') + UPSCLT('1')) <= UDSI_YR('1'))THEN
				    ECL_FGD_O(CoalGroup_SUB)
				else
				   9999.9
				endif
				endif +
				if (UCL_ROPT('2', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD COMB
				ECL_CMB_O(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('3', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SNCR
				ECL_SNCR_O(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('4', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD SCR
				ECL_SCR_O(CoalGroup_SUB)
				endif +
				if (UCL_ROPT('6', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0) then        ! ADD FF
				UCL_FF_O('1')
				endif;
				
				!Always ignore risk premium for CCS Retrofits
				ROR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUROR('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				!
				INTR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUIRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				FDT(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUFDT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				FPE(SupplyRegion_SUB):= EPUFPE('1', SupplyRegion_SUB, cyr);
				!
				CLT(CoalGroup_SUB):=UPSCLT('1');
				PROFILE(CoalGroup_SUB, ConstructionPeriod):= UPSCPR(ConstructionPeriod);
				CAPESC(MNUMYRX, CoalGroup_SUB):=UPCAPD(MNUMYRX, ECPt_FROM(CoalGroup_SUB, first(PlanYear)));
				CL(CoalGroup_SUB):=UPSELF('1');
				TL(CoalGroup_SUB):=
				if ECL_YR(CoalGroup_SUB)< UPSTXYR('1') then
				  UPSTXLF(One_element)
				else
				  UPSTXLF(Two_element)
				endif;
				
				SubCondition((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and ord(RetrofitCFG)<>1 and
				UCL_ROPT('5', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0 and
				ECL_CCS_O(CoalGroup_SUB)>0.0001):=1;
				
				!CO2 CCS - Overnight Cost 1987$/kWh
				OVRCST((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				SubCondition(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)):=
				ECL_CCS_O(CoalGroup_SUB)*
				ANNADJ(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear);
				
				EPINCST_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					CLT          : CLT(CoalGroup_SUB) ,
					PLT          : CLT(CoalGroup_SUB) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PROFILE      : PROFILE(CoalGroup_SUB, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, CoalGroup_SUB) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) );
				PRATIO(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				TXBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) / $
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				
				DR_EPNBLD(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB):=EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				EPNBLD_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, CoalGroup_SUB) ,
					RATIO        : PRATIO(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : CL(CoalGroup_SUB),
					TL           : TL(CoalGroup_SUB) ,
					T            : UPTXRT('1') ,
					CL           : CL(CoalGroup_SUB) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ) ;
				
				CTS_INV_Annuity(CoalGroup_SUB, PlanYear, RetrofitCFG):=
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X)*
				CAPUTIL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				
				CTS_C_B4((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('5', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))) :=
				if ECL_CCS_O(CoalGroup_SUB)>0.0001 then
				(CTS_INV_Annuity(CoalGroup_SUB, PlanYear, RetrofitCFG)/$
				CRF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),(NYR(PlanYear)))) *
				PWF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),ord(PlanYear)-1)
				endif;
				
				CTS_C_B4(CoalGroup_SUB, PlanYear, RetrofitCFG)*= TCCF_GL(LastModelYear_MNUMYR(PlanYear), '1');
				
				CTS_F_B4((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('5', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))) :=
				ECL_CCS_F(CoalGroup_SUB);
				
				CTS_V_B4((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('5', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))):=
				ECL_CCS_V(CoalGroup_SUB);
				
				!FOR DSI CASE, ADD DSI COSTS IF NO FGD -- ALSO ESP AND CFB UPGRADES IF NEEDED
				DOV_CST((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				UDSI_YR('1')<9999 and (CURIYR('1')+UHBSYR('1')+UPSCLT('1'))=UDSI_YR('1') and ord(PlanYear)=UPSCLT('1')+1):=
				ECL_ESP_O(CoalGroup_SUB) + ECL_CFB_O(CoalGroup_SUB) +
				if UCL_CNFG('3',RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))<=0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>25 then
				  ECL_DSI_O(CoalGroup_SUB)
				endif;
				
				DFOM((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				UDSI_YR('1')<9999 and (CURIYR('1')+UHBSYR('1')+UPSCLT('1'))=UDSI_YR('1') and ord(PlanYear)>UPSCLT('1')):=
				ECL_CFB_F(CoalGroup_SUB) +
				if UCL_CNFG('3',RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))<=0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>25 then
				  ECL_DSI_F(CoalGroup_SUB)
				endif;
				
				DVOM((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				UDSI_YR('1')<9999 and (CURIYR('1')+UHBSYR('1')+UPSCLT('1'))=UDSI_YR('1') and ord(PlanYear)>UPSCLT('1')):=
				ECL_CFB_V(CoalGroup_SUB) +
				if UCL_CNFG('3',RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))<=0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>25 then
				  ECL_DSI_V(CoalGroup_SUB)
				endif;
				
				OV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG)+=DOV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!ADJUST FOR DIFFERENCE IN VARIABLE OPERATING COST - CONVERTED TO FIX COST
				VOM(CoalGroup_SUB, PlanYear, RetrofitCFG):= CTS_V_B4(CoalGroup_SUB, PlanYear, RetrofitCFG) +
				(VADJ(CoalGroup_SUB, PlanYear, RetrofitCFG)/$ UECP_CPEN_ADJ(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))));
				
				empty VADJ;
				VADJ((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				(VOM(CoalGroup_SUB, PlanYear, RetrofitCFG) -
				EPVOM(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), SupplyRegion_CoalGroup(CoalGroup_SUB), cyr))*
				CF_COAL(CoalGroup_SUB, PlanYear) * 8.760;
				
				DVOM(CoalGroup_SUB, PlanYear, RetrofitCFG)*=CF_COAL(CoalGroup_SUB, PlanYear) * 8.760;
				
				!YEAR 1 FOM IS A SUNK COST SO SET TO 0
				FOM(CoalGroup_SUB, first(PlanYear), RetrofitCFG) := 0.0;
				FOM(CoalGroup_SUB, PlanYear, RetrofitCFG)+=CTS_F_B4(CoalGroup_SUB, PlanYear, RetrofitCFG) + VADJ(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				TFOM(CoalGroup_SUB, PlanYear, RetrofitCFG, FullPlanningHorizon):=
				if ord(PlanYear)<=ord(FullPlanningHorizon)<=UNXPH('1') and ord(FullPlanningHorizon)<ord(PlanYear)+NYR(PlanYear) then
				  FOM(CoalGroup_SUB, PlanYear, RetrofitCFG) * UPGNPD(ModelYear_MNUMYRF(PlanYear))
				elseif ord(FullPlanningHorizon)>UNXPH('1') and ord(PlanYear)+NYR(PlanYear)>UNXPH('1') then
				  FOM(CoalGroup_SUB, PlanYear, RetrofitCFG) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
				endif;
				
				TFOMD(CoalGroup_SUB, PlanYear, RetrofitCFG, FullPlanningHorizon):=
				if ord(PlanYear)<=ord(FullPlanningHorizon)<=UNXPH('1') and ord(FullPlanningHorizon)<ord(PlanYear)+NYR(PlanYear) then
				  (DFOM(CoalGroup_SUB, PlanYear, RetrofitCFG) + DVOM(CoalGroup_SUB, PlanYear, RetrofitCFG)) * UPGNPD(ModelYear_MNUMYRF(PlanYear))
				elseif ord(FullPlanningHorizon)>UNXPH('1') and ord(PlanYear)+NYR(PlanYear)>UNXPH('1') then
				  (DFOM(CoalGroup_SUB, PlanYear, RetrofitCFG) + DVOM(CoalGroup_SUB, PlanYear, RetrofitCFG)) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
				endif;
				
				PVFOM((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)) :=
				sum(FullPlanningHorizon,
				TFOM(CoalGroup_SUB, PlanYear, RetrofitCFG, FullPlanningHorizon) /
				((1 + EPDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				PVDFOM((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				sum(FullPlanningHorizon,
				TFOMD(CoalGroup_SUB, PlanYear, RetrofitCFG, FullPlanningHorizon) /
				((1 + EPDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				!USE RETROFIT RISK PREMIUM, IF SWITCH IS ON
				ROR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				if USW_RTRSK('1') <= 0 then
				EPUROR('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)
				else
				EPURORR('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)
				endif;
				!
				INTR(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				if USW_RTRSK('1') <= 0 then
				EPUIRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)
				else
				EPUIRTR('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)
				endif;
				
				FDT(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType_X):=
				EPUFDT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				
				FPE(SupplyRegion_SUB):=
				if USW_RTRSK('1') <= 0 then
				EPUFPE('1', SupplyRegion_SUB, cyr)
				else
				EPUFPER('1', SupplyRegion_SUB, cyr)
				endif;
				
				empty SubCondition, OVRCST, PRATIO, TXBOOK, FNBOOK, CAPNNSTL, CAPUTIL;
				SubCondition((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				OV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG)>0.0001):=1;
				
				OVRCST((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				SubCondition(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)):=
				OV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG)*
				ANNADJ(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear);
				
				EPINCST_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					CLT          : CLT(CoalGroup_SUB) ,
					PLT          : CLT(CoalGroup_SUB) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PROFILE      : PROFILE(CoalGroup_SUB, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, CoalGroup_SUB) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) );
				PRATIO(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				TXBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) / $
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				
				DR_EPNBLD(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB):=EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				EPNBLD_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, CoalGroup_SUB) ,
					RATIO        : PRATIO(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : CL(CoalGroup_SUB),
					TL           : TL(CoalGroup_SUB) ,
					T            : UPTXRT('1') ,
					CL           : CL(CoalGroup_SUB) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ) ;
				
				R_INV((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				if OV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG)>0.0001 then
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X)*
				CAPUTIL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X)/$
				CRF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),(NYR(PlanYear))) *
				PWF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),ord(PlanYear)-1)
				endif;
				
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG):= CTS_C_B4(CoalGroup_SUB, PlanYear, RetrofitCFG) +
				PVFOM(CoalGroup_SUB, PlanYear, RetrofitCFG) + R_INV(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				Value((CoalGroup_SUB, PlanYear, RetrofitCFG)| ord(RetrofitCFG)<>1):=
				max(Value(CoalGroup_SUB, PlanYear, RetrofitCFG), Value(CoalGroup_SUB, PlanYear, first(RetrofitCFG))+1);
				
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG)+=PVDFOM(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!EP$COAL,83
				ccalc_cRETRO_ECPCOSTS((CommitYear, CoalGroup_SUB, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG)):=
				max(Value(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG), ECP_MIN('1'));
				
				!HTRT
				empty SubCondition, OVRCST, PRATIO, TXBOOK, FNBOOK, CAPNNSTL, CAPUTIL;
				SubCondition((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=1;
				
				OVRCST((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)|
				SubCondition(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType_X)):=
				HTRT_OVRQ(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CLSG_QT(CoalGroup_SUB));
				
				EPINCST_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					CLT          : CLT(CoalGroup_SUB) ,
					PLT          : CLT(CoalGroup_SUB) ,
					OVRCST       : OVRCST(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PROFILE      : PROFILE(CoalGroup_SUB, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, CoalGroup_SUB) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) );
				PRATIO(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				TXBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) / $
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X) :=
				FNBOOK(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X);
				
				DR_EPNBLD(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB):=EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr);
				EPNBLD_p(
					PLTS         : CoalGroup_SUB_ ,
					Steps        : RetrofitCFG ,
					SubCondition : SubCondition(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, CoalGroup_SUB) ,
					RATIO        : PRATIO(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : CL(CoalGroup_SUB),
					TL           : TL(CoalGroup_SUB) ,
					T            : UPTXRT('1') ,
					CL           : CL(CoalGroup_SUB) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, CoalGroup_SUB, PlanYear, OwnerType1, RetrofitCFG, SubsidyType1) ) ;
				
				HTRT_INV_CST((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				CAPNNSTL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X)*
				CAPUTIL(SupplyRegion_CoalGroup(CoalGroup_SUB), CoalGroup_SUB, PlanYear, One_element, RetrofitCFG, SubsidyType_X)/$
				CRF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),(NYR(PlanYear))) *
				PWF_f(EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),ord(PlanYear)-1);
				
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG)+=HTRT_INV_CST(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!EP$COAL,83
				ccalc_cRETROHTRT_ECPCOSTS((HTRTYear, CoalGroup_SUB, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG) and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				max(Value(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG), ECP_MIN('1'));
			}
			Comment: "Condition (UCL_VIN(IYR) .GT. 0 .AND. IFRST .EQ. 1) is replaced with PlanYear>1 since IFRST=1 for all Plan years and UCL_VIN(1)=0";
			DeclarationSection CLRETROFITCOSTS_Declaration {
				Parameter ANNRTE {
					IndexDomain: (CoalConfiguration);
				}
				Parameter ANNADJ {
					IndexDomain: (CoalConfiguration, SupplyRegion_SUB, PlanYear);
				}
				Parameter AN1 {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter ANN {
					IndexDomain: (CoalConfiguration, FullPlanningHorizon);
				}
				Parameter KW {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter TCF {
					IndexDomain: (CoalGroup_SUB, PlanYear, FullPlanningHorizon);
				}
				Parameter VADJ {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter OVRCST {
					IndexDomain: (SupplyRegion, CoalGroup_SUB, PlanYear,OwnerType,RetrofitCFG,subsidy_type);
				}
				Parameter ROR {
					IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter INTR {
					IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter FDT {
					IndexDomain: (SupplyRegion,CoalGroup,PlanYear,OwnerType,subsidy_type);
				}
				Parameter FPE {
					IndexDomain: (SupplyRegion);
				}
				Parameter SubCondition {
					IndexDomain: (SupplyRegion,CoalGroup_SUB,PlanYear,OwnerType,RetrofitCFG,subsidy_type);
				}
				Parameter DR_EPNBLD {
					IndexDomain: (SupplyRegion,CoalGroup_SUB);
				}
				Parameter CAPUTIL {
					IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, RetrofitCFG, subsidy_type);
				}
				Parameter TXBOOK {
					IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, RetrofitCFG, subsidy_type);
				}
				Parameter FNBOOK {
					IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, RetrofitCFG, subsidy_type);
				}
				Parameter PRATIO {
					IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, RetrofitCFG, subsidy_type);
				}
				Parameter CAPNNSTL {
					IndexDomain: (SupplyRegion, CoalGroup, PlanYear, OwnerType, RetrofitCFG, subsidy_type);
				}
				Parameter CLT {
					IndexDomain: CoalGroup_SUB;
				}
				Parameter PROFILE {
					IndexDomain: (CoalGroup_SUB,ConstructionPeriod);
				}
				Parameter CAPESC {
					IndexDomain: (MNUMYRX,CoalGroup_SUB);
				}
				Parameter CL {
					IndexDomain: CoalGroup_SUB;
				}
				Parameter TL {
					IndexDomain: CoalGroup_SUB;
				}
				Parameter CTS_INV_Annuity {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG);
				}
				Parameter R_INV {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG);
				}
				Parameter HTRT_INV_CST {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG);
				}
				Parameter Value {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG);
				}
				Parameter CTS_C_B4 {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter CTS_F_B4 {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter CTS_V_B4 {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter DOV_CST {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter DFOM {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter DVOM {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter FOM {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter TFOM {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG,FullPlanningHorizon);
				}
				Parameter TFOMD {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG,FullPlanningHorizon);
				}
				Parameter VOM {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter PVFOM {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter PVDFOM {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter PVVOM {
					IndexDomain: (CoalGroup_SUB,PlanYear);
				}
				Parameter CF_COAL {
					IndexDomain: (CoalGroup_SUB, PlanYear);
				}
				Parameter OV_CST {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter HR_PEN {
					IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
				}
				ElementParameter ECPt_FROM {
					IndexDomain: (CoalGroup_SUB, PlanYear);
					Range: PlantType_;
				}
				ElementParameter ECPt_TO {
					IndexDomain: CoalConfiguration;
					Range: PlantType_;
				}
				ElementParameter ITYP {
					IndexDomain: (CoalGroup_SUB, PlanYear);
					Range: CapacityType_;
				}
			}
		}
		Procedure Calculate_BCOF_Costs {
			Body: {
				TFOM(BiomassCOF,PlanYear_ALTB,FullPlanningHorizon):=
				if (ord(FullPlanningHorizon) <= ord(PlanYear_ALTB) - 1) then
				 0.0
				else
				UPCFFOM(BiomassCOF) * UPCFLEV(BioMassCOF,element(BiomassOption_,UPCFNSTP(BioMassCOF))) * UPGNPD(element(MNUMYRF_,ord(cyr)+ord(FullPlanningHorizon)-1))
				endif;
				PVV_FOM(BiomassCOF,PlanYear_ALTB):=SUM(FullPlanningHorizon,(TFOM(BiomassCOF,PlanYear_ALTB,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)));
				
				!EPINCST(UNYEAR,ECP_D_XPH,ECP_D_FPH,ECP_D_LCP,UPCFCLT,UPCFCLT,CURIYR,YEAR,OV_CST,UPCFCPR,UPCAPD,UPGNPD,EPUIRT,EPUFDT,EPUROR,TXBOOK,FNBOOK)
				ROR(SupplyRegion_SUB, BiomassCOF, PlanYear_ALTB, OwnerType1, SubsidyType_X):=
				EPUROR('1', SupplyRegion_SUB, cyr);
				!
				INTR(SupplyRegion_SUB, BiomassCOF, PlanYear_ALTB, OwnerType1, SubsidyType_X):=
				EPUIRT('1', SupplyRegion_SUB, cyr);
				
				FDT(SupplyRegion_SUB, BiomassCOF, PlanYear_ALTB, OwnerType1, SubsidyType_X):=
				EPUFDT('1', SupplyRegion_SUB, cyr);
				
				FPE(SupplyRegion_SUB):= EPUFPE('1', SupplyRegion_SUB, cyr);
				!
				CLT(BiomassCOF):=UPCFCLT('1');
				PROFILE(BiomassCOF, ConstructionPeriod):= UPCFCPR(ConstructionPeriod);
				CAPESC(MNUMYRX, BiomassCOF):=UPCAPD(MNUMYRX,FIRST(PlantType));
				EL(BiomassCOF):=UPSELF('1');
				CL(BiomassCOF):=UPCFELF('1');
				TL(BiomassCOF):=UPCFELF('1');
				!TL(BiomassCOF):=
				!if ECL_YR(CoalGroup_SUB)< UPSTXYR('1') then
				!  UPSTXLF(One_element)
				!else
				!  UPSTXLF(Two_element)
				!endif;
				
				SubCondition((SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType_X)|
				((ord(cyr) + UHBSYR('1') + ord(PlanYear) - UPCFCLT('1') - 1) >= UYR_STEO('1') ) or ord(PlanYear) = UNXPH('1')
				):=1;
				
				!CO2 CCS - Overnight Cost 1987$/kWh
				OVRCST_BCOF((SupplyRegion_SUB,BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType_X)|
				SubCondition(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType_X)):=
				UPCFCST(BiomassCOF) * UPCFLEV(BiomassCOF,element(BiomassOption_,UPCFNSTP(BioMassCOF)));
				
				EPINCST_p(
					PLTS         : BiomassCOF_ ,
					Steps        : ScalarSet_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1,SCALARSet,SubsidyType1) ,
					CLT          : CLT(BiomassCOF) ,
					PLT          : CLT(BiomassCOF) ,
					OVRCST       : OVRCST_BCOF(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType1) ,
					PROFILE      : PROFILE(BiomassCOF, ConstructionPeriod) ,
					CAPESC       : CAPESC(MNUMYRX, BiomassCOF) ,
					GNPF         : UPGNPD(MNUMYRF) ,
					INTR         : INTR(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SubsidyType1) ,
					DEBT_F       : FDT(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SubsidyType1) ,
					TXBOOK       : TXBOOK(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType1) ,
					BVBOOK       : FNBOOK(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SCALARSet, SubsidyType1) );
				PRATIO(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X) :=
				TXBOOK(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X) / $
				FNBOOK(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X);
				CAPNNSTL(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X) :=
				FNBOOK(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X);
				
				DR_EPNBLD(SupplyRegion_SUB, BiomassCOF):=AVGDCR;
				
				EPNBLD_p(
					PLTS         : BiomassCOF_ ,
					Steps        : ScalarSet_ ,
					SubCondition : SubCondition(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1,SCALARSet,SubsidyType1) ,
					ROR          : ROR(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, SubsidyType1) ,
					DR           : DR_EPNBLD(SupplyRegion_SUB, BiomassCOF) ,
					RATIO        : PRATIO(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ,
					PE           : FPE(SupplyRegion_SUB) ,
					EL           : EL(BiomassCOF),
					TL           : TL(BiomassCOF) ,
					T            : UPTXRT('1') ,
					CL           : CL(BiomassCOF) ,
					NBLDP1       : CAPUTIL(SupplyRegion_SUB, BiomassCOF, PlanYear, OwnerType1, ScalarSet, SubsidyType1) ) ;
				
				COF_OBJVAL(SupplyRegion_SUB,BiomassCOF, PlanYear):=
				PVV_FOM(BiomassCOF,PlanYear) +
				CAPNNSTL(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X)*
				CAPUTIL(SupplyRegion_SUB, BiomassCOF, PlanYear, One_element, '1', SubsidyType_X)/ $
				CRF_f(AVGDCR ,(UNFPH('1') - ord(PlanYear) + 1))  *
				PWF_f(AVGDCR,ord(PlanYear));
				
				SubCondition_bld((PlanYear_ALTB)|
				(((ord(cyr) + UHBSYR('1') + ord(PlanYear_ALTB) - 1) >= UYR_STEO('1') ) or (ord(PlanYear_ALTB)+UPCFCLT('1') = UNXPH('1')))
				and ord(PlanYear_ALTB)+UPCFCLT('1') <= UNXPH('1')
				) :=1;
				
				ccalc_cBCOF_ECPCOSTS((SupplyRegion_SUB,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB) |
				SubCondition_bld(PlanYear_ALTB)
				 and ( UCF_TCAP1(BiomassCOF,SupplyRegion_SUB,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0  OR
				UCF_RCAP1(BiomassCOF,SupplyRegion_SUB,CoalDemandRegion_ALT1,ModelYear_MNUMYRX(PlanYear_ALTB+UPCFCLT('1')))> 0.0) ) :=
				COF_OBJVAL(SupplyRegion_SUB,BiomassCOF,PlanYear_ALTB+UPCFCLT('1'));
			}
			Parameter CL {
				IndexDomain: BiomassCOF;
			}
			Parameter EL {
				IndexDomain: BiomassCOF;
			}
			Parameter OVRCST_BCOF {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType1,SCALARSet,subsidy_type);
			}
			Parameter TL {
				IndexDomain: BiomassCOF;
			}
			Parameter FPE {
				IndexDomain: (SupplyRegion);
			}
			Parameter ANNADJ {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
			}
			Parameter CAPNNSTL {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,SCALARSet,subsidy_type);
			}
			Parameter PRATIO {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,SCALARSet,subsidy_type);
			}
			Parameter FNBOOK {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,SCALARSet,subsidy_type);
			}
			Parameter TXBOOK {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,SCALARSet,subsidy_type);
			}
			Parameter CAPUTIL {
				IndexDomain: (SupplyRegion, BiomassCOF, PlanYear, OwnerType, SCALARSet, subsidy_type);
			}
			Parameter ROR {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,subsidy_type);
			}
			Parameter FDT {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,subsidy_type);
			}
			Parameter INTR {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,subsidy_type);
			}
			Parameter CAPESC {
				IndexDomain: (MNUMYRX,BiomassCOF);
			}
			Parameter DR_EPNBLD {
				IndexDomain: (SupplyRegion_SUB,BiomassCOF);
			}
			Parameter PROFILE {
				IndexDomain: (BiomassCOF,ConstructionPeriod);
			}
			Parameter CLT {
				IndexDomain: BiomassCOF;
			}
			Parameter SubCondition {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear,OwnerType,SCALARSet,subsidy_type);
			}
			Parameter SubCondition_BLD {
				IndexDomain: PlanYear_ALTB;
			}
			Parameter PVV_FOM {
				IndexDomain: (BiomassCOF,PlanYear_ALTB);
			}
			Parameter TFOM {
				IndexDomain: (BiomassCOF,PlanYear_ALTB,FullPlanningHorizon);
			}
			Parameter COF_OBJVAL {
				IndexDomain: (SupplyRegion,BiomassCOF,PlanYear);
			}
		}
		Procedure Calculate_CL_NOXEmissionReductions {
			Body: {
				!Create NOX Emission Reductions
				ECPt_TO(CoalConfiguration):=element(PlantType_, UCL_ECP(CoalConfiguration));
				ECPt_FROM(CoalGroup_SUB, PlanYear):= element(PlantType_, UCL_ECP(I_CoalConfiguration(CoalGroup_SUB, PlanYear)));
				ITYP_FROM(CoalGroup_SUB, PlanYear):= CapacityType_element(ECPt_FROM(CoalGroup_SUB, PlanYear));
				ITYP_TO(CoalConfiguration):= CapacityType_element(ECPt_TO(CoalConfiguration));
				LYR_CL_Parameter(PlanYear) := MIN(ord(PlanYear)+1 , UNXPH('1'));
				LYR_CL(PlanYear) := element(PlanYear_ , LYR_CL_Parameter(PlanYear));
				INOX_GRP(CoalGroup_SUB,NOXRegion):= sum(ExplicitPlanningHorizon|ord(ExplicitPlanningHorizon)<=UNXPH('1'),
				ECL_NXG(ExplicitPlanningHorizon, NOXRegion, CoalGroup_SUB));
				
				
				NOX_RMV((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):= -1;
				! ADD COMB
				NOX_RMV((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('2', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0)*=
				1 - ECL_CMB_R(CoalGroup_SUB);
				! ADD SNCR
				NOX_RMV((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('3', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0)*=
				1-ECL_SNCR_R(CoalGroup_SUB);
				! ADD SCR
				NOX_RMV((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(RetrofitCFG)<>1 and
				UCL_ROPT('4', I_RetrofitCombinations(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)))>0)*=
				1-ECL_SCR_R(CoalGroup_SUB);
				NOX_RMV((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG))+= 1;
				
				!EFD_CF_FROM((CoalGroup_SUB,PlanYear)|Condition_COAL(CoalGroup_SUB, PlanYear, first(RetrofitCFG))):=
				EFD_CF_FROM(CoalGroup_SUB,PlanYear):=
				if UEFD_CAP(ECPt_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB),cyr) > 0.001 then
				min(UPMCF(ECPt_FROM(CoalGroup_SUB, PlanYear)),
				UEFD_GEN(ECPt_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB),cyr) /
				(8.76 * UEFD_CAP(ECPt_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB),cyr)))
				else
				0.001
				endif;
				
				!CNFG_CF_FROM((CoalGroup_SUB,PlanYear)|Condition_COAL(CoalGroup_SUB, PlanYear, first(RetrofitCFG))):=
				CNFG_CF_FROM(CoalGroup_SUB,PlanYear):=
				if CNFG_CAP(I_CoalConfiguration(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) > 0.001 then
				min(UPMCF(ECPt_FROM(CoalGroup_SUB, PlanYear)),
				CNFG_GEN(I_CoalConfiguration(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) /
				(8.76 * CNFG_CAP(I_CoalConfiguration(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB))))
				else
				EFD_CF_FROM(CoalGroup_SUB,PlanYear)
				endif;
				
				!ECP_CF_FROM((CoalGroup_SUB,PlanYear)|Condition_COAL(CoalGroup_SUB, PlanYear, first(RetrofitCFG))):=
				ECP_CF_FROM(CoalGroup_SUB,PlanYear):=
				if UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) > 0.001 then
				min(UPMCF(ECPt_FROM(CoalGroup_SUB, PlanYear)),
				UECP_GEN(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) /
				(8.76 * UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_FROM(CoalGroup_SUB, PlanYear),CoalDemandRegion_CoalGroup(CoalGroup_SUB))))
				else
				CNFG_CF_FROM(CoalGroup_SUB,PlanYear)
				endif;
				
				ECP_CF_TO((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)) :=
				if UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) > 0.001 then
				min(UPMCF(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))),
				UECP_GEN(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)),CoalDemandRegion_CoalGroup(CoalGroup_SUB)) /
				(8.76 * UECP_CAP(ExplicitPlanningHorizon_element(LYR_CL(PlanYear)),ITYP_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)),CoalDemandRegion_CoalGroup(CoalGroup_SUB))))
				else
				ECP_CF_FROM(CoalGroup_SUB,PlanYear)
				endif;
				
				ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG):=
				max(ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG),ECP_CF_FROM(CoalGroup_SUB, PlanYear),0.75);
				
				ECP_CF_FROM(CoalGroup_SUB, PlanYear):=
				max(ECP_CF_FROM(CoalGroup_SUB, PlanYear),0.75);
				
				!NOX_FROM((CoalGroup_SUB, PlanYear, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, first(RetrofitCFG)) and
				!INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')) := sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),
				!0.0000005 * NOX_ECP(Season, NOXRegion) * ECP_CF_FROM(CoalGroup_SUB, PlanYear) *
				!EPNOX_G(Season, ExplicitPlanningHorizon_element(PlanYear), ECPt_FROM(CoalGroup_SUB, PlanYear), NOXRegion, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)*
				!if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				!  AVG_HTRT(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				!else
				!  AVG_HTRT_MR(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				!endif);
				
				NOX_FROM((CoalGroup_SUB, PlanYear, NOXRegion)|
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')) := sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),
				0.0000005 * NOX_ECP(Season, NOXRegion) * ECP_CF_FROM(CoalGroup_SUB, PlanYear) *
				EPNOX_G(Season, ExplicitPlanningHorizon_element(PlanYear), ECPt_FROM(CoalGroup_SUB, PlanYear), NOXRegion, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)*
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  AVG_HTRT(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				  AVG_HTRT_MR(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				NOX_TO((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')) := sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),
				0.0000005 * NOX_ECP(Season, NOXRegion) * ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG) *
				EPNOX_G(Season, ExplicitPlanningHorizon_element(PlanYear), ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)*
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  AVG_HTRT(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				  AVG_HTRT_MR(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				!NOX_FROM_HTRT((CoalGroup_SUB, PlanYear, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, first(RetrofitCFG)) and
				NOX_FROM_HTRT((CoalGroup_SUB, PlanYear, NOXRegion)|
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),
				0.0000005 * NOX_ECP(Season, NOXRegion) * ECP_CF_FROM(CoalGroup_SUB, PlanYear) *
				EPNOX_G(Season, ExplicitPlanningHorizon_element(PlanYear), ECPt_FROM(CoalGroup_SUB, PlanYear), NOXRegion, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)*
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  AVG_HTRT_MOD(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				  AVG_HTRT_MR_MOD(ECPt_FROM(CoalGroup_SUB, PlanYear), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				NOX_TO_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr),
				0.0000005 * NOX_ECP(Season, NOXRegion) * ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG) *
				EPNOX_G(Season, ExplicitPlanningHorizon_element(PlanYear), ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)*
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  AVG_HTRT_MOD(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				  AVG_HTRT_MR_MOD(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				NOX_RMV2((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')):=
				sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr), NOX_ECP(Season, NOXRegion));
				
				!NOX_RMV2_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				!INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')):=
				!sum(Season| ord(Season)<=EPNMSP('1',SupplyRegion_CoalGroup(CoalGroup_SUB), cyr), NOX_ECP(Season, NOXRegion));
				
				NOX_RMV2(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)*=0.0000005 * ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG)*
				ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear))*
				ECL_NXR(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)* NOX_RMV(CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				Value((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1')):=
				- NOX_RMV2(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion) - NOX_FROM(CoalGroup_SUB, PlanYear, NOXRegion) + NOX_TO(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				
				Value_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				- NOX_RMV2(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion) - NOX_FROM_HTRT(CoalGroup_SUB, PlanYear, NOXRegion) + NOX_TO_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				
				TST_NOX_temp((CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)<0):=1;
				
				TST_NOX_COAL(CoalPlant,NOXRegion,PlanYear):=sum((CoalGroup_SUB,RetrofitCFG)|
				CoalPlant=ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)),
				TST_NOX_temp(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion));
				
				!EP$COAL,85
				ccalc_cRETRO_rEVNle((ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and ord(PlanYear)=ord(CommitYear) and
				(UCL_CNFG('4',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) + UCL_CNFG('5',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) +
				UCL_CNFG('6',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) < 2 and ord(RetrofitCFG)<>1) and
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)< -ECP_MIN('1')):=
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)*
				CP_PEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,85
				ccalc_cRETRO_rEUNle((ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and ord(PlanYear)=ord(CommitYear) and
				(UCL_CNFG('4',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) + UCL_CNFG('5',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) +
				UCL_CNFG('6',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) < 2 and ord(RetrofitCFG)<>1) and
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion) > ECP_MIN('1')):=
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)*
				CP_PEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,86
				ccalc_cRETROHTRT_rEVNle((ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and ord(PlanYear)=ord(HTRTYear) and
				(UCL_CNFG('4',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) + UCL_CNFG('5',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) +
				UCL_CNFG('6',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) < 2 and ord(RetrofitCFG)<>1) and
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)<0 and
				abs(Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion))> ECP_MIN('1')):=
				Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)*
				CP_PEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,86
				ccalc_cRETROHTRT_rEUNle((ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), NOXRegion, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				INOX_GRP(CoalGroup_SUB, NOXRegion)>0 and ord(PlanYear)>NOX_LT('1') and ord(PlanYear)=ord(HTRTYear) and
				(UCL_CNFG('4',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) + UCL_CNFG('5',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) +
				UCL_CNFG('6',I_CoalConfiguration(CoalGroup_SUB, PlanYear)) < 2 and ord(RetrofitCFG)<>1) and
				Value(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)>=0 and
				abs(Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)) > ECP_MIN('1')):=
				Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion)*
				CP_PEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(ECPt_TO(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				CF_NewECPType((CoalGroup_SUB, PlanYear, RetrofitCFG)|Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				MAX(EMM_CL_CF(CoalGroup_SUB, LastModelYear_TYR(PlanYear)) ,
				ECP_CF_TO(CoalGroup_SUB, PlanYear, RetrofitCFG));
				
				CF_NewECPType_CGCF((CoalGroup_SUB, PlanYear, 'COL')|Condition_COAL_CGCF(CoalGroup_SUB, PlanYear)):=
				MAX(EMM_CL_CF(CoalGroup_SUB, LastModelYear_TYR(PlanYear)) ,
				ECP_CF_TO(CoalGroup_SUB, PlanYear, 'COL'));
			}
			Comment: "Condition (UCL_VIN(IYR) .GT. 0 .AND. IFRST .EQ. 1) is replaced with PlanYear>1 since IFRST=1 for all Plan years and UCL_VIN(1)=0";
			DeclarationSection NOX_Declaration {
				Parameter INOX_GRP {
					IndexDomain: (CoalGroup_SUB,NOXRegion);
				}
				Parameter NOX_RMV {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG);
				}
				Parameter NOX_RMV2 {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				}
				Parameter NOX_RMV2_HTRT {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				}
				Parameter NOX_FROM {
					IndexDomain: (CoalGroup_SUB, PlanYear, NOXRegion);
				}
				Parameter NOX_TO {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				}
				Parameter NOX_FROM_HTRT {
					IndexDomain: (CoalGroup_SUB, PlanYear, NOXRegion);
				}
				Parameter NOX_TO_HTRT {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				}
				Parameter EFD_CF_FROM {
					IndexDomain: (CoalGroup_SUB,PlanYear);
				}
				Parameter CNFG_CF_FROM {
					IndexDomain: (CoalGroup_SUB,PlanYear);
				}
				Parameter ECP_CF_FROM {
					IndexDomain: (CoalGroup_SUB,PlanYear);
				}
				Parameter ECP_CF_TO {
					IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				}
				Parameter Value {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG, NOXRegion);
				}
				Parameter Value_HTRT {
					IndexDomain: (CoalGroup_SUB,PlanYear, RetrofitCFG, NOXRegion);
				}
				ElementParameter ECPt_FROM {
					IndexDomain: (CoalGroup_SUB, PlanYear);
					Range: PlantType_;
				}
				ElementParameter ECPt_TO {
					IndexDomain: CoalConfiguration;
					Range: PlantType_;
				}
				ElementParameter ITYP_FROM {
					IndexDomain: (CoalGroup_SUB, PlanYear);
					Range: CapacityType_;
				}
				ElementParameter ITYP_TO {
					IndexDomain: CoalConfiguration;
					Range: CapacityType_;
				}
				ElementParameter LYR_CL {
					IndexDomain: PlanYear;
					Range: PlanYear_;
				}
				Parameter LYR_CL_Parameter {
					IndexDomain: PlanYear;
				}
				Parameter TST_NOX_temp {
					IndexDomain: (CoalGroup_SUB, PlanYear, RetrofitCFG, NOXRegion);
				}
			}
		}
		Procedure EP_CCAP_Calculations {
			Body: {
				FACTOR:=1;
				
				!PRC(FullPlanningHorizon, OGSMRegion, OGSMSector) := UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * OGCO2PRC(OGSMRegion, OGSMSector_element(OGSMSector), LastModelYear_MNUMYR2(FullPlanningHorizon)) /$
				!UPGNPD(element(MNUMYRF_,OGSM_YR)) * 18.000;
				!CO2(FullPlanningHorizon, OGSMRegion, OGSMSector) := OGCO2PUR2(OGSMRegion, OGSMSector_element(OGSMSector), LastModelYear_MNUMYR2(FullPlanningHorizon)) / 18000.0;
				!AVL(FullPlanningHorizon, OGSMRegion, OGSMSector) := FACTOR * OGCO2AVL(OGSMRegion, OGSMSector_element(OGSMSector), LastModelYear_MNUMYR2(FullPlanningHorizon)) / 18000.0;
				ONE(FullPlanningHorizon) := 1.0;
				!SFTY(FullPlanningHorizon) := UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * 99.9;
				
				!OBJVAL(OGSMSector, OGSMRegion, PlanYear):=
				!if ord(PlanYear)<UNXPH('1') then
				!PRC(FullPlanningHorizon_PlanYear(PlanYear), OGSMRegion, OGSMSector) * PWF_Function(AVGDCR,Year)(PlanYear)
				!else
				!sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!!PVV_Function(PRC(FullPlanningHorizon+2, OGSMRegion, OGSMSector),ord(FullPlanningHorizon),AVGDCR)) *
				!PRC(FullPlanningHorizon+2, OGSMRegion, OGSMSector) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
				!PWF_Function(AVGDCR,Year)(PlanYear)
				!endif;
				!
				!CO2VAL(OGSMSector, OGSMRegion, PlanYear):=
				!if ord(PlanYear)<UNXPH('1') then
				!CO2(FullPlanningHorizon_PlanYear(PlanYear), OGSMRegion, OGSMSector)
				!else
				!sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!!PVV_Function(CO2(FullPlanningHorizon+2, OGSMRegion, OGSMSector),ord(FullPlanningHorizon),AVGDCR))
				!CO2(FullPlanningHorizon+2, OGSMRegion, OGSMSector) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
				!endif;
				!
				!AVLVAL(OGSMSector, OGSMRegion, PlanYear):=
				!if ord(PlanYear)<UNXPH('1') then
				!AVL(FullPlanningHorizon_PlanYear(PlanYear), OGSMRegion, OGSMSector)
				!else
				!sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!!PVV_Function(AVL(FullPlanningHorizon+2, OGSMRegion, OGSMSector),ord(FullPlanningHorizon),AVGDCR))
				!AVL(FullPlanningHorizon+2, OGSMRegion, OGSMSector) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
				!endif;
				!
				ONEVAL(PlanYear):=
				if ord(PlanYear)<UNXPH('1') then
				ONE(FullPlanningHorizon_PlanYear(PlanYear))
				else
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!PVV_Function(ONE(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR))
				ONE(FullPlanningHorizon+2) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
				endif;
				
				!SAFETY(PlanYear):=
				!if ord(PlanYear)<UNXPH('1') then
				!SFTY(FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
				!else
				!sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!!PVV_Function(SFTY(FullPlanningHorizon+2),ord(FullPlanningHorizon),AVGDCR)) *
				!SFTY(FullPlanningHorizon+2) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
				!PWF_Function(AVGDCR,Year)(PlanYear)
				!endif;
				!
			}
			DeclarationSection Local_Declaration {
				Parameter L_YR {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter N_YR {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter FACTOR;
				Parameter ONE {
					IndexDomain: FullPlanningHorizon;
				}
				Parameter SFTY {
					IndexDomain: FullPlanningHorizon;
				}
			}
		}
		Procedure EP_ODSP_Calculations {
			Body: {
				Calculate_HTRT_TEST;
				Seasonmd_element(Season):=elementcast(Seasonmd_,season,0);
				
				for (SlicePerSeason)   do
				
				VLSLoadGroup((SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and Ord(LoadGroup)=
				  EPLDGR(VLSSliceGroup_element(SlicePerSeason, Season_elementx(Seasonx, SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				  ord(SlicePerSeason)>NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB)-ORD(OperatingMode)+1 and ord(SlicePerSeason)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB)):=1;
				
				VLSLoadSegment((SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and Ord(LoadSegment)=
				  EPLDSG(VLSSliceGroup_element(SlicePerSeason, Season_elementx(Seasonx, SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				  ord(SlicePerSeason)>NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB)-ORD(OperatingMode)+1 and ord(SlicePerSeason)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB)):=1;
				
				VLSLoadGroup1((SupplyRegion_SUB, OperatingMode, Season, LoadGroup, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and Ord(LoadGroup)=
				  EPLDGR(VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				  ord(SlicePerSeason)<=NSTP(Season, SupplyRegion_SUB)-ORD(OperatingMode)+1):=1;
				
				VLSLoadSegment1((SupplyRegion_SUB, OperatingMode, Season, LoadSegment, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and Ord(LoadSegment)=
				  EPLDSG(VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				  ord(SlicePerSeason)<=NSTP(Season, SupplyRegion_SUB)-ORD(OperatingMode)+1):=1;
				
				VLSLoad((SliceGroup, SupplyRegion_SUB, OperatingMode, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and SliceGroup=
				VLSSliceGroup_element(SlicePerSeason, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and ord(SlicePerSeason)<=NSTP(Season, SupplyRegion_SUB)-ORD(OperatingMode)+1):=1;
				
				endfor;
				VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear):=VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear);
				VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear):=VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear);
				
				Condition_ODSP((SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) |
				ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear)):=
				IF (EPECAP(FuelRegion0, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR (UPVTYP(DSP_Types)= 1 AND
				UPAVLYR(DSP_Types)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(DSP_Types,SupplyRegion_SUB)>0) ) THEN
				IF (UPPCFB(DSP_Types, Two_element)>= CapacityFactor(Slice_element(OperatingMode, Season, SupplyRegion_SUB), Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB)
				and UPPCFB(DSP_Types, One_element) <= CapacityFactor(Slice_element(OperatingMode, Season, SupplyRegion_SUB)+1, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB)) THEN
				IF  (ord(PlanYear)=1 AND EPECAP(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)> 0) OR (ord(PlanYear)>1) THEN
				1
				endif
				endif
				endif;
				Condition_ODSP_ALT((SupplyRegion_SUB, DSP_Types, PlanYear, OperatingMode, Season) |
				ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF (EPECAP(FuelRegion0, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR (UPVTYP(DSP_Types)= 1 AND
				UPAVLYR(DSP_Types)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(DSP_Types,SupplyRegion_SUB)>0)) THEN
				IF (UPPCFB(DSP_Types, Two_element)>= CapacityFactor(Slice_element(OperatingMode, Season, SupplyRegion_SUB), Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB)
				and UPPCFB(DSP_Types, One_element) <= CapacityFactor(Slice_element(OperatingMode, Season, SupplyRegion_SUB)+1, Season, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB)) THEN
				1
				endif
				endif;
				
				!CAPACITY BALANCE ROWS
				!EP$ODSP,10
				ccalc_cO_DISP_rCXle((SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, Season, PlanYear, DSP_Types, OperatingMode, Seasonmd_element(Season)) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1
				endif
				endif;
				!EP$ODSP,11
				ccalc_cO_DISP_rCHle((SupplyRegion_SUB,DSP_Types,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Season_hr) | ord(Season_hr)=ord(season)
				and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				1
				endif
				endif;
				!EP$ODSP,12
				ccalc_cJ_rCXle((SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, Season, PlanYear, DSP_Types, OperatingMode, Seasonmd_element(Season)) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1
				endif
				endif;
				!EP$ODSP,13
				ccalc_cU_rCXle((SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, Season, PlanYear, DSP_Types, OperatingMode, Seasonmd_element(Season))|
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1
				endif
				endif;
				!EP$ODSP,14
				ccalc_cJ_rCHle((SupplyRegion_SUB,DSP_Types,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Season_hr) | ord(Season_hr)=ord(season)
				and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				1
				endif
				endif;
				!EP$ODSP,15
				ccalc_cU_rCHle((SupplyRegion_SUB,DSP_Types,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Season_hr) | ord(Season_hr)=ord(season)
				and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				1
				endif
				endif;
				!EP$ODSP,16
				ccalc_cM_rCMle((SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, Season, PlanYear, DSP_Types, OperatingMode, Seasonmd_element(Season))|
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1
				endif
				endif;
				!EP$ODSP,17
				ccalc_cM_rCYle((SupplyRegion_SUB,DSP_Types,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Season_hr) | ord(Season_hr)=ord(season)
				and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season) then
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				1
				endif
				endif;
				!If capacity can provide non-spinning reserves then add to operating reserve for all load slice that it is not being used
				!EP$ODSP,18
				ccalc_cO_DISP_rNSRn((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, NSR_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegment(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF HR_NMR(NSR_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1 - FOR_ODSP(SupplyRegion_SUB, NSR_Types, PlanYear)
				endif
				endif;
				!EP$ODSP,19
				ccalc_cJ_rNSRn((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, NSR_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegment(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(NSR_Types)>0 and HR_NMR(NSR_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1 - FOR_ODSP(SupplyRegion_SUB, NSR_Types, PlanYear)
				endif
				endif;
				!EP$ODSP,20
				ccalc_cU_rNSRn((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, NSR_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegment(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(NSR_Types)>0 and HR_NMR(NSR_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1 - FOR_ODSP(SupplyRegion_SUB, NSR_Types, PlanYear)
				endif
				endif;
				!EP$ODSP,21
				ccalc_cM_rNSRn((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, NSR_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegment(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, NSR_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF EPECAP_MR(FuelRegion_ALT1, NSR_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(NSR_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				1 - FOR_ODSP(SupplyRegion_SUB, NSR_Types, PlanYear)
				endif
				endif;
				!Create Derates
				
				GEN_ODSP((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) ) :=
				  if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season) then
				  sum(SliceGroup | VLSLoad(SliceGroup, SupplyRegion_SUB, OperatingMode, Season, PlanYear),
				 DERATE_ODSP(DSP_Types, SliceGroup, SupplyRegion_SUB, PlanYear) * EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr))
				 endif;
				
				!EP$ODSP,22
				ccalc_cO_DISP_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				endif
				endif;
				!EP$ODSP,25
				ccalc_cO_DISP_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				
				endif
				endif;
				!EP$ODSP,28
				ccalc_cM_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				endif
				endif;
				!EP$ODSP,31
				ccalc_cM_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				
				endif
				endif;
				!EP$ODSP,34
				ccalc_cO_DISP_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				SR_CREDIT(DSP_Types) *
				(1 - DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				endif
				endif;
				!EP$ODSP,35
				ccalc_cO_DISP_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				SR_CREDIT(DSP_Types) *
				(1 - DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				
				endif
				endif;
				!EP$ODSP,36
				ccalc_cM_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HR_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				SR_CREDIT(DSP_Types) *
				(1 - DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				endif
				endif;
				!EP$ODSP,37
				ccalc_cM_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				SR_CREDIT(DSP_Types) *
				(1 - DERATE_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				
				endif
				endif;
				
				!Derate for min el and max sr mode = (1 - sr_min_lf) * sr_min_cf * (ld / min_ld) + sr_min_lf * sr_min_cf
				VALUE_MIN_SR_ODSP((DSP_Types, SliceGroup, SupplyRegion_SUB, PlanYear)| ord(SliceGroup)<=9 and SR_CREDIT(DSP_Types)>0) :=
				IF (EPECAP(FuelRegion0, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR (UPVTYP(DSP_Types)= 1 AND
				UPAVLYR(DSP_Types)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(DSP_Types,SupplyRegion_SUB)>0) ) THEN
				SR_MIN_LF(DSP_Types) * SR_MIN_CF(DSP_Types) + (1.0 - SR_MIN_LF(DSP_Types)) * SR_MIN_CF(DSP_Types) *
				((EPHGHT(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) + ADJ_HGHT_ODSP(SupplyRegion_SUB, PlanYear)) /
				 MIN_HGHT_ODSP(SupplyRegion_SUB, VLSSeason_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), PlanYear))
				 endif;
				
				 GEN_MIN_SR_ODSP((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				 ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) ) :=
				 if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season) then
				 sum(SliceGroup | VLSLoad(SliceGroup, SupplyRegion_SUB, OperatingMode, Season, PlanYear),
				 VALUE_MIN_SR_ODSP(DSP_Types, SliceGroup, SupplyRegion_SUB, PlanYear) * EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr))
				 endif;
				
				!EP$ODSP,38
				ccalc_cJ_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				Value_MIN_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				
				endif
				endif;
				!EP$ODSP,41
				ccalc_cJ_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				Value_MIN_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				
				endif
				endif;
				!EP$ODSP,44
				ccalc_cJ_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				SR_CREDIT(DSP_Types) *
				(1 - Value_MIN_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				endif
				endif;
				!EP$ODSP,45
				ccalc_cJ_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				SR_CREDIT(DSP_Types) *
				(1 - Value_MIN_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				
				endif
				endif;
				!Derate for max el and min sr mode = (1 - sr_max_lf) * (1 - for) * (ld / max_ld) + sr_max_lf * (1 - for)
				VALUE_MAX_SR_ODSP((DSP_Types, SliceGroup, SupplyRegion_SUB, PlanYear)| ord(SliceGroup)<=9 and SR_CREDIT(DSP_Types)>0) :=
				IF (EPECAP(FuelRegion0, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR (UPVTYP(DSP_Types)= 1 AND
				UPAVLYR(DSP_Types)<=FULLYEAR_YR(PlanYear)) OR (WPTTYP(DSP_Types,SupplyRegion_SUB)>0) ) THEN
				SR_MAX_LF(DSP_Types) * (1 - FOR_ODSP(SupplyRegion_SUB, DSP_Types, PlanYear)) +
				(1.0 - SR_MAX_LF(DSP_Types)) * (1 - FOR_ODSP(SupplyRegion_SUB, DSP_Types, PlanYear)) *
				((EPHGHT(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) + ADJ_HGHT_ODSP(SupplyRegion_SUB, PlanYear)) /
				MAX_HGHT_ODSP(SupplyRegion_SUB, VLSSeason_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), PlanYear))
				endif;
				
				GEN_MAX_SR_ODSP((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				 ord(OperatingMode)<=NSTP(Season, SupplyRegion_SUB) ) :=
				 if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season) then
				 sum(SliceGroup | VLSLoad(SliceGroup, SupplyRegion_SUB, OperatingMode, Season, PlanYear),
				 VALUE_MAX_SR_ODSP(DSP_Types, SliceGroup, SupplyRegion_SUB, PlanYear) * EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr))
				 endif;
				
				!EP$ODSP,46
				ccalc_cU_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				Value_MAX_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				endif
				endif;
				!EP$ODSP,49
				ccalc_cU_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroupx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadGroup, PlanYear) and
				  VLSLoadSegmentx(SupplyRegion_SUB, OperatingMode, Seasonx, LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				Value_MAX_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear)
				
				endif
				endif;
				!EP$ODSP,52
				ccalc_cU_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				ord(Seasonx)=ord(Season1) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				SR_CREDIT(DSP_Types) *
				(1 - Value_MAX_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				endif
				endif;
				!EP$ODSP,53
				ccalc_cU_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				ord(Season_hr)=ord(seasonx) and FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				  ord(OperatingMode)<=NSTP(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB) and
				  VLSLoadGroup1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadGroup, PlanYear) and
				  VLSLoadSegment1(SupplyRegion_SUB, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB), LoadSegment, PlanYear)):=
				
				if Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear, OperatingMode, Season_elementx(Seasonx, SupplyRegion_SUB)) then
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				SR_CREDIT(DSP_Types) *
				(1 - Value_MAX_SR_ODSP(DSP_Types, LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), SupplyRegion_SUB, PlanYear))
				
				endif
				endif;
				
				load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear):=
				GEN_ODSP(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) /$ (SHOURS(Season, SupplyRegion_SUB, PlanYear) * 1000.0);
				HTRT_Adjustment(
					load_level     : load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) ,
					HTRTADJ        : HTRT_ADJ(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) );
				
				load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear):= 0;
				load_level((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_SUB,cyr) and SR_CREDIT(DSP_Types)>0):=
				GEN_MIN_SR_ODSP(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) /$ (SHOURS(Season, SupplyRegion_SUB, PlanYear) * 1000.0);
				HTRT_Adjustment(
					load_level     : load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) ,
					HTRTADJ        : HTRT_ADJ_MIN(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) );
				
				load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear):= 0;
				load_level((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) | ORD(Season) <= EPNMSP('1',SupplyRegion_SUB,cyr) and SR_CREDIT(DSP_Types)>0):=
				GEN_MAX_SR_ODSP(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) /$ (SHOURS(Season, SupplyRegion_SUB, PlanYear) * 1000.0);
				HTRT_Adjustment(
					load_level     : load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear) ,
					HTRTADJ        : HTRT_ADJ_MAX(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) );
				
				!EP$ODSP,54
				ccalc_cO_DISP_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1, PlanYear) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * VOMCST_DSP(DSP_Types, SupplyRegion_SUB, PlanYear)
				endif;
				!EP$ODSP,55
				ccalc_cO_DISP_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr, PlanYear) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) ):=
				
				IF HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * VOMCST_DSP(DSP_Types, SupplyRegion_SUB, PlanYear)
				
				endif;
				!EP$ODSP,56
				ccalc_cM_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1, PlanYear) |

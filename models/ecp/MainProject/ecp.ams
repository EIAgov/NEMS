			Parameter ccalc_cIS_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and SupplyRegion_ALT2=SupplyRegion_ALT1 and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: GRGRD(**)(*)";
				Definition: {
					IF GRD_RATS(PlantType, SupplyRegion_ALT1)>0 THEN
					IF ( -ECP_MIN('1') < GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)))< ECP_MIN('1')) then
					0
					else
					GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)))
					endif
					endif
				}
				Comment: "EP$INT,62";
			}

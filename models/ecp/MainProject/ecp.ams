					!Done in EP_INT_Calculations procedure to save time
				}
				Comment: "EP$INT,78";
			}
			Parameter ccalc_cI_IMP_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) | PlantType_ALT1 in Intermittent_ and
					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and
					UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType_ALT1) and SupplyRegion_ALT1=SupplyRegion_ALTZ and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!IMP and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND UPVTYP(PlantType_ALT1)= 1) and (UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType_ALT1) AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALTfrom)>0) AND
					 (UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALTfrom) > 0)) THEN
					IF UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999 then
					if ccalc_cI_IMP_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, SupplyRegion_ALTfrom, PlantType_ALT1, OwnerType, SupplyRegion_ALTZ, ElasticityStep, PlanYear_ALTB) and
					SR_INT(PlantType_ALT1, SupplyRegion_ALTfrom)>0 then
					-1* UPICFC1(PlantType_ALT1, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALTfrom, cyr)*
					SR_INT(PlantType_ALT1, SupplyRegion_ALTfrom)
					endif
					endif
					endif
				}
				Comment: "EP$INT,81";
			}
			Parameter ccalc_cI_SUBIMP_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType_ALT1 in Intermittent_ and
					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and
					UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType_ALT1) and SupplyRegion_ALT1=SupplyRegion_ALTZ and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and Subsidy_Case(PlanYear_ALTB, PlantType_ALT1)=2
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!SUBIMP and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND UPVTYP(PlantType_ALT1)= 1) and (UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType_ALT1) AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALTfrom)>0) AND
					 (UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALTfrom) > 0)) THEN
					IF UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999 then
					if ccalc_cI_IMP_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, SupplyRegion_ALTfrom, PlantType_ALT1, OwnerType, SupplyRegion_ALTZ, ElasticityStep_ALT1, PlanYear_ALTB) and
					SR_INT(PlantType_ALT1, SupplyRegion_ALTfrom)>0 then
					-1* UPICFC1(PlantType_ALT1, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALTfrom, cyr)*
					SR_INT(PlantType_ALT1, SupplyRegion_ALTfrom)
					endif
					endif
					endif
				}
				Comment: "EP$INT,81";
			}

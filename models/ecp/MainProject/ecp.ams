					      cGXCOF(SupplyState,PlanYear)
					+
					sum((PlantType,SupplyRegion_ALT1),
					coeff_cNN_rGRPSge(SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1) *
					      cNN(SupplyState,PlantType,SupplyRegion_ALT1,PlanYear))
					+
					sum((PlantType,SupplyRegion_ALT1),
					coeff_cXX_rGRPSge(SupplyState,RPSTrancheID,PlanYear,PlantType,SupplyRegion_ALT1) *
					      cXX(SupplyState,PlantType,SupplyRegion_ALT1,PlanYear))
					
					>=
					
					0.
				}
				Comment: "state level RPS constraint by state, tranche and planning year (bkwh)";
			}

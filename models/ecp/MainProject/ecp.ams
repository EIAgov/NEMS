					coeff_cEMRX_RNW_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DSP_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_INT_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_INT(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_RNW_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rRXXXXXn(SupplyRegion_ALTX,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rRXXXXXn(SupplyRegion_ALTX,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cRDBLDX_rRXXXXXn(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1) *
					      cRDBLDX(SupplyRegion_ALT1,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rRXXXXXn(SupplyRegion_ALTX,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
				}
			}
			Parameter rTOTBLDn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "Free row in OML, Rows: TOTBLD(*)(*)";
				Definition: {
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB),
					coeff_cI_IMP_rTOTBLDn(SupplyRegion_ALT1,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) *
					      cI_IMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cI_SUBIMP_rTOTBLDn(SupplyRegion_ALT1,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cI_SUBIMP(SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIS_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIS(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cIX_rTOTBLDn(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
				}
			}
			Parameter rTOTCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "Free row in OML, Rows: TOTCAP(*)(*)";
				Definition: {
					sum((PlantType),
					coeff_cE_MR_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType) *
					      cE_MR(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rTOTCAPn(SupplyRegion_ALT1,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType),
					coeff_cEMRX_RNW_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_DSP_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) *
					      cEXX0_DSP(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_RNW_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_DSP_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_RNW_rTOTCAPn(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rTOTCAPn(SupplyRegion_ALT1,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rTOTCAPn(SupplyRegion_ALT1,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rTOTCAPn(SupplyRegion_ALT1,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rTOTCAPn(SupplyRegion_ALT1,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rTOTCAPn(SupplyRegion_ALT1,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
				}
			}
		}
	}
	Procedure WriteToNEMS {
		Body: {
			    OutToNEMS_FileName:="../../ecp/OutToNEMS_"+formatstring("%i",curcalyr(1))+".txt";
			    put OutToNEMS; ! opens the file and sets stage for subsequent display and put statements
			    display ECP_WithoutSafety.ProgramStatus ;
			    display ECP_WithSafety.ProgramStatus ;
			    display {cB_DSP.level, cB_DSP.NominalCoefficient, cB_DSP.lower, cB_DSP.upper, cB_DSP.ReducedCost} where decimals := 10 ;
			    display {cBBIO.level, cBBIO.NominalCoefficient, cBBIO.lower, cBBIO.upper, cBBIO.ReducedCost} where decimals := 10 ;
			    display {cBDSPSUB.level, cBDSPSUB.NominalCoefficient, cBDSPSUB.lower, cBDSPSUB.upper, cBDSPSUB.ReducedCost} where decimals := 10 ;
			    display {cBBIOSUB.level, cBBIOSUB.NominalCoefficient, cBBIOSUB.lower, cBBIOSUB.upper, cBBIOSUB.ReducedCost} where decimals := 10 ;
			    display {cBCOF.level, cBCOF.NominalCoefficient, coeff_cBCOF_LBOUND, coeff_cBCOF_UBOUND, cBCOF.ReducedCost} where decimals := 10 ;
			    display {cBELXX.level, cBELXX.NominalCoefficient, cBELXX.lower, cBELXX.upper, cBELXX.ReducedCost} where decimals := 10 ;
			    display {cBNK_HG.level, cBNK_HG.NominalCoefficient, coeff_cBNK_HG_LBOUND, coeff_cBNK_HG_UBOUND, cBNK_HG.ReducedCost} where decimals := 10 ;
			    display {cBNKSO2.level, cBNKSO2.NominalCoefficient, coeff_cBNKSO2_LBOUND, coeff_cBNKSO2_UBOUND, cBNKSO2.ReducedCost} where decimals := 10 ;
			    display {cBSDGN.level, cBSDGN.NominalCoefficient, cBSDGN.lower, cBSDGN.upper, cBSDGN.ReducedCost} where decimals := 10 ;
			    display {cBSNUC.level, cBSNUC.NominalCoefficient, cBSNUC.lower, cBSNUC.upper, cBSNUC.ReducedCost} where decimals := 10 ;
			    display {cBSRNW.level, cBSRNW.NominalCoefficient, cBSRNW.lower, cBSRNW.upper, cBSRNW.ReducedCost} where decimals := 10 ;
			    display {cBXNUC.level, cBXNUC.NominalCoefficient, cBXNUC.lower, cBXNUC.upper, cBXNUC.ReducedCost} where decimals := 10 ;
			    display {cBXRNW.level, cBXRNW.NominalCoefficient, cBXRNW.lower, cBXRNW.upper, cBXRNW.ReducedCost} where decimals := 10 ;
			    display {cBX_DGN.level, cBX_DGN.NominalCoefficient, cBX_DGN.lower, cBX_DGN.upper, cBX_DGN.ReducedCost} where decimals := 10 ;
			    display {cCARBK.level, cCARBK.NominalCoefficient, cCARBK.lower, cCARBK.upper, cCARBK.ReducedCost} where decimals := 10 ;
			    display {cCARES.level, cCARES.NominalCoefficient, cCARES.lower, cCARES.upper, cCARES.ReducedCost} where decimals := 10 ;
			    display {cCARLM.level, cCARLM.NominalCoefficient, coeff_cCARLM_LBOUND, coeff_cCARLM_UBOUND, cCARLM.ReducedCost} where decimals := 10 ;
			    display {cCAROF.level, cCAROF.NominalCoefficient, coeff_cCAROF_LBOUND, coeff_cCAROF_UBOUND, cCAROF.ReducedCost} where decimals := 10 ;
			    display {cCARRS.level, cCARRS.NominalCoefficient, coeff_cCARRS_LBOUND, coeff_cCARRS_UBOUND, cCARRS.ReducedCost} where decimals := 10 ;
			    display {cE.level, cE.NominalCoefficient, coeff_cE_LBOUND, coeff_cE_UBOUND, cE.ReducedCost} where decimals := 10 ;
			    display {cEXX0_DSP.level, cEXX0_DSP.NominalCoefficient, coeff_cEXX0_DSP_LBOUND, coeff_cEXX0_DSP_UBOUND, cEXX0_DSP.ReducedCost} where decimals := 10 ;
			    display {cEXX0_RNW.level, cEXX0_RNW.NominalCoefficient, coeff_cEXX0_RNW_LBOUND, coeff_cEXX0_RNW_UBOUND, cEXX0_RNW.ReducedCost} where decimals := 10 ;
			    display {cEXX0_INT.level, cEXX0_INT.NominalCoefficient, coeff_cEXX0_INT_LBOUND, coeff_cEXX0_INT_UBOUND, cEXX0_INT.ReducedCost} where decimals := 10 ;
			    display {cEXXX_DSP.level, cEXXX_DSP.NominalCoefficient, coeff_cEXXX_DSP_LBOUND, coeff_cEXXX_DSP_UBOUND, cEXXX_DSP.ReducedCost} where decimals := 10 ;
			    display {cF.level, cF.NominalCoefficient, cF.lower, cF.upper, cF.ReducedCost} where decimals := 10 ;
			    display {cFXX.level, cFXX.NominalCoefficient, cFXX.lower, cFXX.upper, cFXX.ReducedCost} where decimals := 10 ;
			    display {cG.level, cG.NominalCoefficient, cG.lower, cG.upper, cG.ReducedCost} where decimals := 10 ;
			    display {cGCAP.level, cGCAP.NominalCoefficient, cGCAP.lower, cGCAP.upper, cGCAP.ReducedCost} where decimals := 10 ;
			    display {cGCRRNW.level, cGCRRNW.NominalCoefficient, cGCRRNW.lower, cGCRRNW.upper, cGCRRNW.ReducedCost} where decimals := 10 ;
			    display {cGUCRRNW.level, cGUCRRNW.NominalCoefficient, cGUCRRNW.lower, cGUCRRNW.upper, cGUCRRNW.ReducedCost} where decimals := 10 ;
			    display {cGTRPS.level, cGTRPS.NominalCoefficient, cGTRPS.lower, cGTRPS.upper, cGTRPS.ReducedCost} where decimals := 10 ;
			    display {cGXCOF.level, cGXCOF.NominalCoefficient, cGXCOF.lower, cGXCOF.upper, cGXCOF.ReducedCost} where decimals := 10 ;
			    display {cHGEN.level, cHGEN.NominalCoefficient, cHGEN.lower, cHGEN.upper, cHGEN.ReducedCost} where decimals := 10 ;
			    display {cIS.level, cIS.NominalCoefficient, cIS.lower, cIS.upper, cIS.ReducedCost} where decimals := 10 ;
			    display {cIX.level, cIX.NominalCoefficient, coeff_cIX_LBOUND, coeff_cIX_UBOUND, cIX.ReducedCost} where decimals := 10 ;
			    display {cI_IMP.level, cI_IMP.NominalCoefficient, cI_IMP.lower, cI_IMP.upper, cI_IMP.ReducedCost} where decimals := 10 ;
			    display {cI_SUBIMP.level, cI_SUBIMP.NominalCoefficient, cI_SUBIMP.lower, cI_SUBIMP.upper, cI_SUBIMP.ReducedCost} where decimals := 10 ;
			    display {cMV.level, cMV.NominalCoefficient, coeff_cMV_LBOUND, coeff_cMV_UBOUND, cMV.ReducedCost} where decimals := 10 ;
			    display {cMVUP6.level, cMVUP6.NominalCoefficient, coeff_cMVUP6_LBOUND, coeff_cMVUP6_UBOUND, cMVUP6.ReducedCost} where decimals := 10 ;
			    display {cNN.level, cNN.NominalCoefficient, cNN.lower, cNN.upper, cNN.ReducedCost} where decimals := 10 ;
			    display {cNNG.level, cNNG.NominalCoefficient, coeff_cNNG_LBOUND, coeff_cNNG_UBOUND, cNNG.ReducedCost} where decimals := 10 ;
			    display {cNNGCL.level, cNNGCL.NominalCoefficient, coeff_cNNGCL_LBOUND, coeff_cNNGCL_UBOUND, cNNGCL.ReducedCost} where decimals := 10 ;
			    display {cNUC.level, cNUC.NominalCoefficient, coeff_cNUC_LBOUND, coeff_cNUC_UBOUND, cNUC.ReducedCost} where decimals := 10 ;
			    display {cNUCSR.level, cNUCSR.NominalCoefficient, coeff_cNUCSR_LBOUND, coeff_cNUCSR_UBOUND, cNUCSR.ReducedCost} where decimals := 10 ;
			    display {cRETRO.level, cRETRO.NominalCoefficient, coeff_cRETRO_LBOUND, coeff_cRETRO_UBOUND, cRETRO.ReducedCost} where decimals := 10 ;
			    display {cRETROHTRT.level, cRETROHTRT.NominalCoefficient, coeff_cRETROHTRT_LBOUND, coeff_cRETROHTRT_UBOUND, cRETROHTRT.ReducedCost} where decimals := 10 ;
			    display {cSR.level, cSR.NominalCoefficient, coeff_cSR_LBOUND, coeff_cSR_UBOUND, cSR.ReducedCost} where decimals := 10 ;
			    display {cSUNGX.level, cSUNGX.NominalCoefficient, coeff_cSUNGX_LBOUND, coeff_cSUNGX_UBOUND, cSUNGX.ReducedCost} where decimals := 10 ;
			    display {cSUOLX.level, cSUOLX.NominalCoefficient, coeff_cSUOLX_LBOUND, coeff_cSUOLX_UBOUND, cSUOLX.ReducedCost} where decimals := 10 ;
			    display {cT.level, cT.NominalCoefficient, coeff_cT_LBOUND, coeff_cT_UBOUND, cT.ReducedCost} where decimals := 10 ;
			    display {ECPCOSTS} where decimals := 10 ;
			    display {r2P2le.level, r2P2le.lower, r2P2le.upper, r2P2le.ShadowPrice} where decimals := 10  ;
			    display {rCXle.level, rCXle.lower, rCXle.upper, rCXle.ShadowPrice} where decimals := 10  ;
			    display {rCXsxle.level, rCXsxle.lower, rCXsxle.upper, rCXsxle.ShadowPrice} where decimals := 10  ;
			    display {rCXXle.level, rCXXle.lower, rCXXle.upper, rCXXle.ShadowPrice} where decimals := 10  ;
			    display {rEUCARle.level, rEUCARle.lower, rEUCARle.upper, rEUCARle.ShadowPrice} where decimals := 10  ;
			    display {rEUCARn} where decimals := 10 ;
			    display {rEUCARXXn} where decimals := 10 ;
			    display {rEUCARXXle.level, rEUCARXXle.lower, rEUCARXXle.upper, rEUCARXXle.ShadowPrice} where decimals := 10  ;
			    display {rEUHGXXle.level, rEUHGXXle.lower, rEUHGXXle.upper, rEUHGXXle.ShadowPrice} where decimals := 10  ;
			    display {rEUNle.level, rEUNle.lower, rEUNle.upper, rEUNle.ShadowPrice} where decimals := 10  ;
			    display {rEUNOXle.level, rEUNOXle.lower, rEUNOXle.upper, rEUNOXle.ShadowPrice} where decimals := 10  ;
			    display {rEUNOXn} where decimals := 10 ;
			    display {rEUSO2le.level, rEUSO2le.lower, rEUSO2le.upper, rEUSO2le.ShadowPrice} where decimals := 10  ;
			    display {rEUSO2Xle.level, rEUSO2Xle.lower, rEUSO2Xle.upper, rEUSO2Xle.ShadowPrice} where decimals := 10  ;
			    display {rEUSO2Xn} where decimals := 10 ;
			    display {rEX_Xle.level, rEX_Xle.lower, rEX_Xle.upper, rEX_Xle.ShadowPrice} where decimals := 10  ;
			    display {rEXXXle.level, rEXXXle.lower, rEXXXle.upper, rEXXXle.ShadowPrice} where decimals := 10  ;
			    display {rFCAPn} where decimals := 10 ;
			    display {rFDVLle.level, rFDVLle.lower, rFDVLle.upper, rFDVLle.ShadowPrice} where decimals := 10  ;
			    display {rFDVSle.level, rFDVSle.lower, rFDVSle.upper, rFDVSle.ShadowPrice} where decimals := 10  ;
			    display {rFGENge.level, rFGENge.lower, rFGENge.upper, rFGENge.ShadowPrice} where decimals := 10  ;
			    display {rFGWDn} where decimals := 10 ;
			    display {rFUELNGXle.level, rFUELNGXle.lower, rFUELNGXle.upper, rFUELNGXle.ShadowPrice} where decimals := 10  ;
			    display {rFUELOLXle.level, rFUELOLXle.lower, rFUELOLXle.upper, rFUELOLXle.ShadowPrice} where decimals := 10  ;
			    display {rFWDXXXle.level, rFWDXXXle.lower, rFWDXXXle.upper, rFWDXXXle.ShadowPrice} where decimals := 10  ;
			    display {rFXXle.level, rFXXle.lower, rFXXle.upper, rFXXle.ShadowPrice, rFXXle.basic} where decimals := 10  ;
			    display {rFXXSle.level, rFXXSle.lower, rFXXSle.upper, rFXXSle.ShadowPrice, rFXXSle.basic} where decimals := 10  ;
			    display {rGCLXn} where decimals := 10 ;
			    display {rGNNUCge.level, rGNNUCge.lower, rGNNUCge.upper, rGNNUCge.ShadowPrice} where decimals := 10  ;
			    display {rGRGRDge.level, rGRGRDge.lower, rGRGRDge.upper, rGRGRDge.ShadowPrice} where decimals := 10  ;
			    display {rGRNWXXge.level, rGRNWXXge.lower, rGRNWXXge.upper, rGRNWXXge.ShadowPrice} where decimals := 10  ;
			    display {rGRPSge.level, rGRPSge.lower, rGRPSge.upper, rGRPSge.ShadowPrice} where decimals := 10  ;
			    display {rGURNWXge.level, rGURNWXge.lower, rGURNWXge.upper, rGURNWXge.ShadowPrice} where decimals := 10  ;
			    display {rGURNWXXge.level, rGURNWXXge.lower, rGURNWXXge.upper, rGURNWXXge.ShadowPrice} where decimals := 10  ;

				Text: "OML Rows: E(*)(**)XX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEMRX_RNW_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					sum((RetireGroup),
					coeff_cEXX0_RNW_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((LoadGroup,LoadSegment),
					coeff_cH_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,LoadGroup,LoadSegment) *
					      cH(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((LoadGroup,LoadSegment),
					coeff_cJ_MINSR_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,LoadGroup,LoadSegment) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((LoadGroup,LoadSegment),
					coeff_cO_HYD_rEXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,LoadGroup,LoadSegment) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					0.
				}
				Comment: "renewable generation balance row by EMM region, plant type (excluding biomass, pump storage,intermittents), season, and planning year (bkwh)";
			}
			Constraint rEXXXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: E(*)(**)XXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((Seasonx),
					coeff_cJXX_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cOXX_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((Seasonx),
					coeff_cUXX_rEXXXle(SupplyRegion_ALT1,PlantType,PlanYear,Seasonx) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					<=
					
					0.
				}
				Comment: "renewable generation balance row by EMM region, plant type (excluding biomass, pump storage,intermittents) and planning year (bkwh)";
			}
			Constraint rFCFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Rows: F(*)CFGEN(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyState),
					coeff_cGXCOF_rFCFGENge(SupplyRegion_ALT1,PlanYear,SupplyState) *
					      cGXCOF(SupplyState,PlanYear))
					+
					coeff_cSCFGEN_rFCFGENge(SupplyRegion_ALT1,PlanYear) *
					      cSCFGEN(SupplyRegion_ALT1,PlanYear)
					+
					sum((FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber),
					coeff_cW_rFCFGENge(SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber) *
					      cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					>=
					
					0.
				}
				Comment: "cofiring generation balance row by EMM region and planning year (billion kwh)";
			}
			Constraint rFDVLle {
				IndexDomain: (CoalDemandRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: FDV(*)L(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlanYear_ALTB),
					coeff_cEXXX_DSP_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rFDVLle(CoalDemandRegion_ALT1,PlantType,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}
				Comment: "lignite diversity row by Coal Demand region, plant type (coal), and planning year (trillion Btu * 0.1)";
			}
			Constraint rFDVSle {
				IndexDomain: (CoalDemandRegion_ALT1,PlantType,PlanYear);
				Text: "OML Rows: FDV(*)S(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rFDVSle(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+

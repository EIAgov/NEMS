			    display {rPSELXle.level, rPSELXle.lower, rPSELXle.upper, rPSELXle.ShadowPrice} where decimals := 10  ;
			    display {rQMRXge.level, rQMRXge.lower, rQMRXge.upper, rQMRXge.ShadowPrice} where decimals := 10  ;
			    display {rQXXXge.level, rQXXXge.lower, rQXXXge.upper, rQXXXge.ShadowPrice} where decimals := 10  ;

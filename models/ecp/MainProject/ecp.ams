				!IF UNRGNS('1') = 22 and  (ord(SupplyRegion)=6 or ord(SupplyRegion)=7) THEN
				!Element(SupplyRegion_, 8)
				!ELSEIF (UNRGNS('1')= 25 and ord(SupplyRegion)=8) THEN
				!Element(SupplyRegion_, 9)
				!else
				!Element(SupplyRegion_, ord(SupplyRegion))
				!ENDIF
				Element(SupplyRegion_,UPRNWRGN(SupplyRegion))
			}
		}

			Parameter ccalc_cBBIO_rCXsxle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) | (PlantType=WIWD_Element or PlantType=WIBI_Element) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					ord(Seasonx)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!BIO and OML Rows: C(*)(**)X(*)(*)(*)!x"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr) AND
					 (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 -1
					 endif
					 endif
				}
				Comment: "EP$BRNW,74";
			}
			Parameter ccalc_cBBIOSUB_rCXsxle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB) | (PlantType=WIWD_Element or PlantType=WIBI_Element) and ord(SupplyRegion_ALT1)<=UNRGNS('1') and

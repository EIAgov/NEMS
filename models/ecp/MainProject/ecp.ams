	Section ECP_Variables {
		DeclarationSection Decision_Variable_Declare {
			Variable c2EL {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Columns: 2(*)EL(*)(*)(*)(*)";
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "generation required to store demand response use (P2 technology), by EMM region, season, load group, load segment and planning year (GW)";
			}
			Variable cACIXSS {
				IndexDomain: (numACSS,PlanYear);
				Text: "OML Columns: ACIXSS(*)(*)";
				Range: [coeff_cACIXSS_LBOUND(numACSS, PlanYear), coeff_cACIXSS_UBOUND(numACSS, PlanYear)];
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "activated carbon required to remove mercury emissions";
			}
			Parameter coeff_cACIXSS_LBOUND {
				IndexDomain: (numACSS,PlanYear);
				Range: nonnegative;
			}
			Parameter coeff_cACIXSS_UBOUND {
				IndexDomain: (numACSS,PlanYear);
				Range: nonnegative;
				Default: inf;
				Definition: ccalc_cACIXSS_UBOUND(numACSS,PlanYear);
			}
			Variable cB_DSP {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB);
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP"
				}
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "build unsubsidized dispatchable capacity, by EMM region, plant type, owner type, in fuel region_ALT1, at supply elasticity step, and planning year (GW";
			}
			Variable cBBIO {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB);
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!BIO"
				}
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "build unsubsidized biomass capacity, by EMM region, plant type, owner type, in fuel region_ALT1, at supply elasticity step, and planning year (GW)";
			}
			Variable cBDSPSUB {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB);
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB"
				}
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "build subsidized dispatchable capacity, by EMM region, plant type, owner type, in fuel region_ALT1, at supply elasticity step, and planning year (GW)";
			}
			Variable cBBIOSUB {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB);
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!BIOSUB"
				}
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "build subsidized biomass capacity, by EMM region, plant type, owner type, in fuel region_ALT1, at supply elasticity step, and planning year (GW)";
			}
			Variable cBCOF {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB);
				Text: "OML Columns: B(*)(*)(*)COF(*)";
				Range: [coeff_cBCOF_LBOUND(SupplyRegion_ALT1, CoalDemandRegion_ALT1, BiomassCOF, PlanYear_ALTB), coeff_cBCOF_UBOUND(SupplyRegion_ALT1, CoalDemandRegion_ALT1, BiomassCOF, PlanYear_ALTB)];
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "retrofit for biomass cofiring by EMM region, coal demand region, cofiring category and planning year (GW)";
			}
			Parameter coeff_cBCOF_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB);
				Range: nonnegative;
			}
			Parameter coeff_cBCOF_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB);
				Range: nonnegative;
				Default: inf;
				Definition: ccalc_cBCOF_UBOUND(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB);
			}
			Variable cBELXX {
				IndexDomain: (SupplyRegion_ALTY,SupplyRegion_ALTZ,PlanYear_ALTB);
				Text: "OML Columns: B(*)(*)ELXX(*)";
				Range: nonnegative;
				Property: ReducedCost, CoefficientRange, Basic;
				Comment: "build transmission capacity between EMM regions, to count toward reserve margin of importing region (ALTZ), by planning year (GW)";
			}
			Variable cBELYY {
				IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear);
				Text: "OML Columns: B(*)(*)ELYY(*)";

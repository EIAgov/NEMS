			IndexDomain: Intermittent;
			Range: IntermittentRenStor_;
			Definition: Element(IntermittentRenStor_,UIRINTI(Intermittent));
		}
		ElementParameter RnwStor {
			IndexDomain: OtherRenewable;
			Range: IntermittentRenStor_;
			Definition: Element(IntermittentRenStor_, UIRRNWI(OtherRenewable));
		}
		ElementParameter BCAP_element {
			IndexDomain: (Intermittent,SupplyRegion);
			Range: Intermittent_;
			Definition: {
				IF Intermittent= WISO_Element THEN
				  IF EPCURCL_PV(SupplyRegion, cyr) = EPCURCL_SO(SupplyRegion, cyr) THEN
				        WIPV_Element
				  ELSEIF EPCurCL_PT(SupplyRegion, cyr)= EPCurCL_SO(SupplyRegion, cyr) THEN
				        WIPT_Element
				  ENDIF
				elseif Intermittent= WIPT_Element THEN
				  IF EPCurCL_PV(SupplyRegion, cyr) = EPCurCL_PT(SupplyRegion, cyr) THEN
				        WIPV_Element
				  ENDIF
				elseif Intermittent= WIWL_Element THEN
				  IF EPCurCL_WN(SupplyRegion, cyr) = EPCurCL_WL(SupplyRegion, cyr) and EPCurBF_WN(SupplyRegion, cyr) = EPCurBF_WL(SupplyRegion, cyr) THEN
				        WIWN_Element
				  ENDIF
				else
				  Intermittent
				ENDIF
			}
		}
		ElementParameter LCAP_element {
			IndexDomain: (Intermittent);
			Range: Intermittent_;
			Definition: {
				IF Intermittent= WIWF_Element THEN
				  WIWN_Element
				elseif Intermittent= WIWL_Element THEN
				  WIWN_Element
				else
				  Intermittent
				ENDIF
			}
		}
		ElementParameter KCAP_element {
			IndexDomain: (Intermittent);
			Range: Intermittent_;
			Definition: {
				IF Intermittent= WIWL_Element THEN
				  WIWN_Element
				elseif Intermittent= WIPT_Element THEN
				  WIPV_Element
				else
				  Intermittent
				ENDIF
			}
		}
		ElementParameter ElasticityStep_Element {
			IndexDomain: ElasticityStep;
			Range: Three_;
			Definition: element(Three_, ord(ElasticityStep));
		}
		ElementParameter SubsidyType_X {
			Range: Subsidy_Type_;
			Definition: 'X';
		}
		ElementParameter SubsidyType_S {
			Range: Subsidy_Type_;
			Definition: 'S';
		}

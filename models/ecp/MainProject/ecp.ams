					ord(SupplyRegion_ALT1)<=UNRGNS('1') and SupplyRegion_ALT1=SupplyRegion_ALTfrom and MAP_ImportRegion(SupplyRegion_ALT1, SupplyRegion_ALTZ) and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and PlantType_ALT2=BCAP_element(PlantType_ALT1, SupplyRegion_ALT1) and PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!IMP and OML Rows: L(*)(**)INT(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear, PlantType_ALT1) <= UNXPH('1') AND UPVTYP(PlantType_ALT1)= 1) and (UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear, PlantType_ALT1) AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALT1)>0) AND
					 (UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALT1) > 0)) THEN
					IF UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALT1, Counter_ImportRegion(SupplyRegion_ALT1, SupplyRegion_ALTZ), cyr)<9999 then
					IF (ESTSWTCH(PlantType_ALT1) > 0) THEN
					1
					endif
					endif
					endif
				}
				Comment: "EP$INT,64";
			}

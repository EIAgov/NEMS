			Parameter ccalc_cI_IMP_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) | PlantType_ALT1 in Intermittent_ and
					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and
					UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType_ALT1) and SupplyRegion_ALTX=SupplyRegion_ALTZ
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!IMP and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND UPVTYP(PlantType_ALT1)= 1) and (UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType_ALT1) AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALTfrom)>0) AND
					 (UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALTfrom) > 0)) THEN
					IF UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999 then
					IF EPIRCCR(IntStor(PlantType_ALT1), SupplyRegion_ALTfrom, cyr) * (1.0 - EPTLOSS(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, cyr))>ECP_MIN('1') then
					EPIRCCR(IntStor(PlantType_ALT1), SupplyRegion_ALTfrom, cyr) * (1.0 - EPTLOSS(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, cyr))
					endif
					endif
					endif
				}
				Comment: "EP$INT,70";
			}
			Parameter ccalc_cI_SUBIMP_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType_ALT1 in Intermittent_ and
					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and Subsidy_Case(PlanYear_ALTB, PlantType_ALT1)=2 and
					UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType_ALT1) and SupplyRegion_ALTX=SupplyRegion_ALTZ
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!SUBIMP and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND UPVTYP(PlantType_ALT1)= 1) and (UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType_ALT1) AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALTfrom)>0) AND
					 (UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALTfrom) > 0)) THEN
					IF UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999 then
					IF EPIRCCR(IntStor(PlantType_ALT1), SupplyRegion_ALTfrom, cyr) * (1.0 - EPTLOSS(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, cyr))>ECP_MIN('1') then
					EPIRCCR(IntStor(PlantType_ALT1), SupplyRegion_ALTfrom, cyr) * (1.0 - EPTLOSS(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, cyr))
					endif
					endif
					endif
				}
			}

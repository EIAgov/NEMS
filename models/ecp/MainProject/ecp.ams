				ccalc_cU_rEUNle(DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				
				!GRID RESILIENCE ROW, IF APPROPRIATE

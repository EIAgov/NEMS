					coeff_cPM_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cPM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cPX_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cPX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cPY_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cPY(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					                sum((SupplyRegion_ALT1,PlantType,PlanYear),
					coeff_cQXMR_ECPCOSTS(SupplyRegion_ALT1,PlantType,PlanYear)
					*              cQXMR(SupplyRegion_ALT1,PlantType,PlanYear))
					
					+
					
					                  sum((SupplyRegion_ALT1,PlanYear),
					coeff_cRCFGEN_ECPCOSTS(SupplyRegion_ALT1,PlanYear)
					*              cRCFGEN(SupplyRegion_ALT1,PlanYear))
					
					+
					
					                  sum((SupplyRegion_ALT1,PlanYear),
					coeff_cRDBLDX_ECPCOSTS(SupplyRegion_ALT1,PlanYear)
					*              cRDBLDX(SupplyRegion_ALT1,PlanYear))
					
					+
					
					                 sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_ECPCOSTS(CommitYear,CoalGroup,RetrofitCFG)
					*              cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					
					+
					
					                     sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_ECPCOSTS(HTRTYear,CoalGroup,RetrofitCFG)
					*              cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					+
					
					                  sum((SupplyRegion_ALT1,PlanYear),
					coeff_cRINTXX_ECPCOSTS(SupplyRegion_ALT1,PlanYear)
					*              cRINTXX(SupplyRegion_ALT1,PlanYear))
					
					+
					
					                  sum((RPSRegion_ALT1,PlanYear),
					coeff_cRNWGEN_ECPCOSTS(RPSRegion_ALT1,PlanYear)
					*              cRNWGEN(RPSRegion_ALT1,PlanYear))
					
					+
					
					                   sum((PlanYear),
					coeff_cRNWGENU_ECPCOSTS(PlanYear)
					*              cRNWGENU(PlanYear))
					
					+
					
					                  sum((SupplyRegion_ALT1,PlanYear),
					coeff_cSCFGEN_ECPCOSTS(SupplyRegion_ALT1,PlanYear)
					*              cSCFGEN(SupplyRegion_ALT1,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear),
					coeff_cSR_ECPCOSTS(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
					*              cSR(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear))
					
					+
					
					                 sum((SupplyRegion_ALT1,VLoadSegment,PlanYear),
					coeff_cSRBLD_ECPCOSTS(SupplyRegion_ALT1,VLoadSegment,PlanYear)
					*              cSRBLD(SupplyRegion_ALT1,VLoadSegment,PlanYear))
					
					+
					
					                sum((CensusRegion_ALT1,H2SupplyStep,Season,PlanYear),
					coeff_cSUH2_ECPCOSTS(CensusRegion_ALT1,H2SupplyStep,Season,PlanYear)
					*              cSUH2(CensusRegion_ALT1,H2SupplyStep,Season,PlanYear))
					
					+
					
					                 sum((GasSupplyStep,PlanYear),
					coeff_cSUNGX_ECPCOSTS(GasSupplyStep,PlanYear)
					*              cSUNGX(GasSupplyStep,PlanYear))
					
					+
					
					                 sum((OilSupplyStep,PlanYear),
					coeff_cSUOLX_ECPCOSTS(OilSupplyStep,PlanYear)
					*              cSUOLX(OilSupplyStep,PlanYear))
					
					+
					
					                 sum((NOXRegion,PlanYear),
					coeff_cSVNOX_ECPCOSTS(NOXRegion,PlanYear)
					*              cSVNOX(NOXRegion,PlanYear))
					
					+
					
					                sum((CoalDemandRegion_ALT1,BiomassStep,PlanYear),
					coeff_cSWDX_ECPCOSTS(CoalDemandRegion_ALT1,BiomassStep,PlanYear)
					*              cSWDX(CoalDemandRegion_ALT1,BiomassStep,PlanYear))
					
					+
					
					              sum((CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear),
					coeff_cSX_ECPCOSTS(CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear)
					*              cSX(CoalDemandRegion_ALT1,BiomassType,BiomassStep,PlanYear))
					
					+
					
					             sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear),
					coeff_cT_ECPCOSTS(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear)
					*              cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					+
					
					                 sum((FuelRegion_ALT1,PlanYear),
					coeff_cTDSXX_ECPCOSTS(FuelRegion_ALT1,PlanYear)
					*              cTDSXX(FuelRegion_ALT1,PlanYear))
					
					+
					
					               sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear),
					coeff_cTEL_ECPCOSTS(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear)
					*              cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					+
					
					                  sum((CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear),
					coeff_cTELCAN_ECPCOSTS(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear)
					*              cTELCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					
					+
					
					               sum((FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear),
					coeff_cTNG_ECPCOSTS(FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear)
					*              cTNG(FuelRegion_ALT1,FuelSupplyStep,GasSeason,PlanYear))
					
					+
					
					                sum((FuelRegion_ALT1,GasSeason,PlanYear),
					coeff_cTNG0_ECPCOSTS(FuelRegion_ALT1,GasSeason,PlanYear)
					*              cTNG0(FuelRegion_ALT1,GasSeason,PlanYear))
					
					+
					
					                 sum((FuelRegion_ALT1,PlanYear),
					coeff_cTRSXX_ECPCOSTS(FuelRegion_ALT1,PlanYear)
					*              cTRSXX(FuelRegion_ALT1,PlanYear))
					
					+
					
					               sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear),
					coeff_cTSR_ECPCOSTS(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear)
					*              cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					+
					
					                  sum((CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear),
					coeff_cTSRCAN_ECPCOSTS(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear)
					*              cTSRCAN(CanadianSupplyRegion,SupplyRegion_ALTa,LoadGroup,LoadSegment,PlanYear))
					
					+
					
					               sum((CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear),
					coeff_cTZZ_ECPCOSTS(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)
					*              cTZZ(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear))
					
					+
					
					             sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear),
					coeff_cU_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear)
					*              cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cUM_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					               sum((SupplyRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cUMR_ECPCOSTS(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cUX_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					               sum((SupplyRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cUXX_ECPCOSTS(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					               sum((CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear),
					coeff_cVEL_ECPCOSTS(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear)
					*              cVEL(CanadianSupplyRegion,LoadGroup,LoadSegment,ImportStep,PlanYear))
					
					+
					
					             sum((SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear),
					coeff_cW_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear)
					*              cW(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,PlantType,Scrubber,PlanYear))
					
					+
					
					               sum((CoalType,CoalSupplyCurve,PlanYear),
					coeff_cXCX_ECPCOSTS(CoalType,CoalSupplyCurve,PlanYear)
					*              cXCX(CoalType,CoalSupplyCurve,PlanYear))
					
					+
					
					                sum((SupplyRegion_ALT1,PlantType,PlanYear),
					coeff_cXGEN_ECPCOSTS(SupplyRegion_ALT1,PlantType,PlanYear)
					*              cXGEN(SupplyRegion_ALT1,PlantType,PlanYear))
					
					+
					
					                  sum((SupplyRegion_ALT1,PlanYear),
					coeff_cXP2XXX_ECPCOSTS(SupplyRegion_ALT1,PlanYear)
					*              cXP2XXX(SupplyRegion_ALT1,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cZH_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cZH(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cZM_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cZM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					                 sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cZMrnw_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cZX_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cZX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					+
					
					                 sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear),
					coeff_cZXrnw_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					*              cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					+
					
					              sum((SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear),
					coeff_cZY_ECPCOSTS(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					*              cZY(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
				}
			}
		}
	}
	Section ECP_Constraints {
		DeclarationSection ConstraintDeclare {
			Constraint r2P2le {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: 2(*)P2(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_c2EL_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      c2EL(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_RNW_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_RNW_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cJ_MINSR_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					+
					sum((PlantType),
					coeff_cO_HYD_r2P2le(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					0.
				}
				Comment: "capacity balance row (store or use) for demand response by EMM region, season, load group load segment, and planning year (GW)";
			}
			Constraint rACIXXXXle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: ACIXXXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((numACSS),
					coeff_cACIXSS_rACIXXXXle(PlanYear,numACSS) *
					      cACIXSS(numACSS,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rACIXXXXle(PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate activated carbon injection for mercury removal (pounds)";
			}
			Constraint rCCOFXle {
				IndexDomain: (SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF);
				Text: "OML Rows: C(*)(*)(*)COFX";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBCOF_rCCOFXle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB) *
					      cBCOF(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear_ALTB))
					
					<=
					
					coeff_cRHS_rCCOFXle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF)
				}
				Comment: "limit  biomass cofiring retrofits by available capacity by EMM region, fuel region, and biomass cofiring category (GW)";
			}
			Constraint rCHeq {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)H(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rCHeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					=
					0.
				}
				Comment: "not used unless no capacity available (??)";
			}
			Constraint rCHle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)H(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OperatingMode,Seasonmd),
					coeff_cJ_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((OperatingMode,Seasonmd),
					coeff_cO_DISP_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cPH_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cPH(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((OperatingMode,Seasonmd),
					coeff_cU_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cZH_rCHle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cZH(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row for capacity with heat rate improvement by EMM region, plant type, fuel region, season, and planning year (GW)";
			}
			Constraint rCle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: C(*)(**)(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((RetireGroup),
					coeff_cEXX0_RNW_rCle(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rCle(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					coeff_cJ_MINSR_rCle(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cJ_MINSR(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear)
					+
					coeff_cO_HYD_rCle(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear) *
					      cO_HYD(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row by EMM region, hydro plant type, season, load group, load segment, and planning year (GW)";
			}
			Constraint rCMeq {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)M(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cPM_rCMeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cPM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					
					=
					0.
				}
				Comment: "not used unless no capacity available (??)";
			}
			Constraint rCMle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)M(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType),
					coeff_cE_MR_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cE_MR(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType,OperatingMode,Seasonmd),
					coeff_cM_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((PlantType),
					coeff_cMN_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cMN(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Season,PlanYear))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cPM_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cPM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((PlantType),
					coeff_cZM_rCMle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cZM(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					<=
					
					0.
				}
				Comment: "capacity balance row for must-runs by EMM region, Fuel region, fossil plant type, season, and planning year (GW)";
			}
			Constraint rCMsxle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear);
				Text: {
					"OML Rows: C(*)(**)M(*)(*)(*)!x"
				}
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEMRX_RNW_rCMsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					coeff_cJM_rCMsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cUM_rCMsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cZMrnw_rCMsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row for must-runs by EMM region, Fuel region, biomass plant type, season, and planning year (GW)";
			}
			Constraint rCMXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,Seasonx,PlanYear);
				Text: "OML Rows: C(*)(**)MX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEMRX_RNW_rCMXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cEMRX_RNW(SupplyRegion_ALT1,PlantType,PlanYear)
					+
					coeff_cJMR_rCMXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cOMR_rCMXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cUMR_rCMXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row for must-run renewables (except biomass) by EMM region, plant type, season, and planning year (GW)";
			}
			Constraint rCXeq {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)X(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OperatingMode,Seasonmd),
					coeff_cJ_rCXeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((OperatingMode,Seasonmd),
					coeff_cO_DISP_rCXeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cPX_rCXeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cPX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rCXeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((OperatingMode,Seasonmd),
					coeff_cU_rCXeq(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					
					=
					0.
				}
				Comment: "not used unless no capacity available (??)";
			}
			Constraint rCXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)X(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType,RetireGroup),
					coeff_cEXX0_DSP_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,RetireGroup) *
					      cEXX0_DSP(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlantType,PlanYear_ALTB),
					coeff_cEXXX_DSP_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,PlanYear_ALTB) *
					      cEXXX_DSP(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((PlantType),
					coeff_cON_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cON(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Season,PlanYear))
					+
					sum((PlantType),
					coeff_cPX_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cPX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((PlantType,OperatingMode,Seasonmd),
					coeff_cU_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((PlantType),
					coeff_cZX_rCXle(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) *
					      cZX(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear))
					
					<=
					
					0.
				}
				Comment: "capacity balance row by EMM region, fossil plant type, Fuel region, season, and planning year (GW)";
			}
			Constraint rCXsxle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear);
				Text: {
					"OML Rows: C(*)(**)X(*)(*)(*)!x"
				}
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBBIOSUB_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBBIOSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((RetireGroup),
					coeff_cEXX0_RNW_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					coeff_cJX_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cUX_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cZXrnw_rCXsxle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row by EMM region, biomass plant type, Fuel region, season, and planning year (GW)";
			}
			Constraint rCXXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,Seasonx,PlanYear);
				Text: "OML Rows: C(*)(**)XX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSRNW_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXRNW_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXRNW(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((RetireGroup),
					coeff_cEXX0_RNW_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,RetireGroup) *
					      cEXX0_RNW(SupplyRegion_ALT1,PlantType,RetireGroup))
					+
					sum((PlanYear_ALTB),
					coeff_cEXXX_RNW_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,PlanYear_ALTB) *
					      cEXXX_RNW(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					coeff_cJXX_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cOXX_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					+
					coeff_cUXX_rCXXle(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row by EMM region, nonhydro dispatchable renewable plant type, season, and planning year (GW)";
			}
			Constraint rCYle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear);
				Text: "OML Rows: C(*)(**)Y(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OperatingMode,Seasonmd),
					coeff_cM_rCYle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cPY_rCYle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cPY(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rCYle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					coeff_cZY_rCYle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear) *
					      cZY(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Season,PlanYear)
					
					<=
					
					0.
				}
				Comment: "capacity balance row by EMM region, fossil w or heatrate improvement plant type, Fuel region, season, and planning year (GW)";
			}
			Constraint rETRPSle {
				IndexDomain: (RPSRegion,RPSRegion_ALTX,PlanYear);
				Text: "OML Rows: E(*)(*)TRPS(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((RPSRegion_ALT1,RPSRegion_ALT2),
					coeff_cGTRPS_rETRPSle(RPSRegion,RPSRegion_ALTX,PlanYear,RPSRegion_ALT1,RPSRegion_ALT2) *
					      cGTRPS(RPSRegion_ALT1,RPSRegion_ALT2,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment),
					coeff_cTEL_rETRPSle(RPSRegion,RPSRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment),
					coeff_cTSR_rETRPSle(RPSRegion,RPSRegion_ALTX,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					0.
				}
				Comment: "Regional RPS transfer balance constraint - trade of RPS credits must match power transfer (bill kWh)";
			}
			Constraint rEUBNKle {
				IndexDomain: (CarbonRegion);
				Text: "OML Rows: EUBNK(**)X";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear),
					coeff_cCARBK_rEUBNKle(CarbonRegion,PlanYear) *
					      cCARBK(CarbonRegion,PlanYear))
					
					<=
					
					coeff_cRHS_rEUBNKle(CarbonRegion)
				}
				Comment: "balance row to limit using banked allowance to available bank by Carbon region (MM mtC -- currently AB32 only)";
			}
			Constraint rEUCARle {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "OML Rows: EUCAR(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					coeff_cCARBK_rEUCARle(CarbonRegion,PlanYear) *
					      cCARBK(CarbonRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1),
					coeff_cCARD_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1) *
					      cCARD(SupplyRegion_ALT1,CarbonRegion,PlanYear))
					+
					coeff_cCAREC_rEUCARle(CarbonRegion,PlanYear) *
					      cCAREC(CarbonRegion,PlanYear)
					+
					coeff_cCARES_rEUCARle(CarbonRegion,PlanYear) *
					      cCARES(CarbonRegion,PlanYear)
					+
					coeff_cCARFL_rEUCARle(CarbonRegion,PlanYear) *
					      cCARFL(CarbonRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1),
					coeff_cCARI_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1) *
					      cCARI(SupplyRegion_ALT1,CarbonRegion,PlanYear))
					+
					coeff_cCARIN_rEUCARle(CarbonRegion,PlanYear) *
					      cCARIN(CarbonRegion,PlanYear)
					+
					coeff_cCARLM_rEUCARle(CarbonRegion,PlanYear) *
					      cCARLM(CarbonRegion,PlanYear)
					+
					coeff_cCAROF_rEUCARle(CarbonRegion,PlanYear) *
					      cCAROF(CarbonRegion,PlanYear)
					+
					coeff_cCAROT_rEUCARle(CarbonRegion,PlanYear) *
					      cCAROT(CarbonRegion,PlanYear)
					+
					coeff_cCARRF_rEUCARle(CarbonRegion,PlanYear) *
					      cCARRF(CarbonRegion,PlanYear)
					+
					coeff_cCARRS_rEUCARle(CarbonRegion,PlanYear) *
					      cCARRS(CarbonRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rEUCARle(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUCARle(CarbonRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment),
					coeff_cTEL_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment),
					coeff_cTSR_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rEUCARle(CarbonRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cY_rEUCARle(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate carbon emissions by Carbon region (if limited) and planning year (MM mtC)";
			}
			Constraint rEUCARXXle {
				IndexDomain: (PlanYear);
				Text: "OML Rows: EUCARXX(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rEUCARXXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rEUCARXXle(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					coeff_cCARBONX_rEUCARXXle(PlanYear) *
					      cCARBONX(PlanYear)
					+
					coeff_cCAROTHX_rEUCARXXle(PlanYear) *
					      cCAROTHX(PlanYear)
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rEUCARXXle(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rEUCARXXle(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUCARXXle(PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cY_rEUCARXXle(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					
					<=
					
					coeff_cRHS_rEUCARXXle(PlanYear)
				}
				Comment: "enforce national carbon limit by planning year (MM mtC)";
			}
			Constraint rEUHGle {
				IndexDomain: (PlantType,nHGCODE,PlanYear);
				Text: "OML Rows: EUHG(**)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEUHG_rEUHGle(PlantType,nHGCODE,PlanYear) *
					      cEUHG(PlantType,nHGCODE,PlanYear)
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUHGle(PlantType,nHGCODE,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate mercury emissions by plant type, mercury region, and planning year (thousands of tons)";
			}
			Constraint rEUHGRSle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Rows: EUHGRS(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEUHGRS_rEUHGRSle(nHGCODE,PlanYear) *
					      cEUHGRS(nHGCODE,PlanYear)
					+
					sum((FuelRegion_ALT1),
					coeff_cTRSXX_rEUHGRSle(nHGCODE,PlanYear,FuelRegion_ALT1) *
					      cTRSXX(FuelRegion_ALT1,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate mercury emissions (from resid consumption) by planning year (thousands of tons)";
			}
			Constraint rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Rows: EUHGXX(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBNK_HG_rEUHGXXle(nHGCODE,PlanYear,PlanYear_ALTB) *
					      cBNK_HG(nHGCODE,PlanYear_ALTB))
					+
					coeff_cCTLHGXX_rEUHGXXle(nHGCODE,PlanYear) *
					      cCTLHGXX(PlanYear)
					+
					sum((PlantType),
					coeff_cEUHG_rEUHGXXle(nHGCODE,PlanYear,PlantType) *
					      cEUHG(PlantType,nHGCODE,PlanYear))
					+
					coeff_cEUHGRS_rEUHGXXle(nHGCODE,PlanYear) *
					      cEUHGRS(nHGCODE,PlanYear)
					+
					coeff_cGCHGXX_rEUHGXXle(nHGCODE,PlanYear) *
					      cGCHGXX(nHGCODE,PlanYear)
					
					<=
					
					coeff_cRHS_rEUHGXXle(nHGCODE,PlanYear)
				}
				Comment: "accumulate total mercury emissions by mercury region and planning year (thousands of tons)";
			}
			Constraint rEUNle {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Text: "OML Rows: EUN(**)(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					coeff_cEUN_rEUNle(PlantType,NOXRegion,PlanYear) *
					      cEUN(PlantType,NOXRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cJ_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cJM_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cJM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cJMR_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cJMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cJX_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cJXX_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cJXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cM_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cO_DISP_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cOMR_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cOMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cOXX_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cOXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rEUNle(PlantType,NOXRegion,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rEUNle(PlantType,NOXRegion,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd),
					coeff_cU_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cUM_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cUM(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cUMR_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cUMR(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cUX_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,Seasonx),
					coeff_cUXX_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,Seasonx) *
					      cUXX(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cZMrnw_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cZMrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx),
					coeff_cZXrnw_rEUNle(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate NOX emissions by plant type, NOX program (annual, seasonal), and planning year (thousand tons)";
			}
			Constraint rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear);
				Text: "OML Rows: EUNOX(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cCTLNX_rEUNOXle(NOXRegion,PlanYear) *
					      cCTLNX(NOXRegion,PlanYear)
					+
					sum((PlantType),
					coeff_cEUN_rEUNOXle(NOXRegion,PlanYear,PlantType) *
					      cEUN(PlantType,NOXRegion,PlanYear))
					+
					sum((PlantType),

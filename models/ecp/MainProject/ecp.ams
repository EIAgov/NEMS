			IndexDomain: PlanYear;
			Definition: ord(PlanYear);
		}
		Parameter KYR {
			IndexDomain: PlanYear;
			Definition: {
				if (ord(PlanYear) < UNXPH('1')) then
				       ord(PlanYear)
				else
				       UNFPH('1')
				endif
			}
		}

				ccalc_cM_rGRNWXXge((RPSRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB) and
				  UPRNWSHRR(DSP_Types, SupplyRegion_SUB)>0 AND UPRNWEXGR(DSP_Types, SupplyRegion_SUB)<=0 ):=
				
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHRR(DSP_Types, SupplyRegion_SUB) * 0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				
				endif;
				
				!EP$ODSP,108
				ccalc_cJ_rGRNWXXge((RPSRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB) and
				  UPRNWSHRR(DSP_Types, SupplyRegion_SUB)>0 AND UPRNWEXGR(DSP_Types, SupplyRegion_SUB)<=0):=
				
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHRR(DSP_Types, SupplyRegion_SUB) * 0.001 * GEN_MIN_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,109
				ccalc_cJ_rGRNWXXge((RPSRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB) and
				  UPRNWSHRR(DSP_Types, SupplyRegion_SUB)>0 AND UPRNWEXGR(DSP_Types, SupplyRegion_SUB)<=0 ):=
				
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHRR(DSP_Types, SupplyRegion_SUB) * 0.001 * GEN_MIN_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				
				endif;
				!EP$ODSP,110
				ccalc_cU_rGRNWXXge((RPSRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB) and
				  UPRNWSHRR(DSP_Types, SupplyRegion_SUB)>0 AND UPRNWEXGR(DSP_Types, SupplyRegion_SUB)<=0):=
				
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHRR(DSP_Types, SupplyRegion_SUB) * 0.001 * GEN_MAX_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,111
				ccalc_cU_rGRNWXXge((RPSRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB) and
				  UPRNWSHRR(DSP_Types, SupplyRegion_SUB)>0 AND UPRNWEXGR(DSP_Types, SupplyRegion_SUB)<=0 ):=
				
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHRR(DSP_Types, SupplyRegion_SUB) * 0.001 * GEN_MAX_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				
				endif;
				
				!If National RPS and Regional and National Contributions Differ
				!EP$ODSP,113
				ccalc_cO_DISP_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0):=
				
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,114
				ccalc_cO_DISP_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0 ):=
				
				IF HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,115
				ccalc_cM_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0):=
				
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,116
				ccalc_cM_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0 ):=
				
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				
				!EP$ODSP,117
				ccalc_cJ_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0):=
				
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_MIN_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,118
				ccalc_cJ_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0 ):=
				
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_MIN_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,119
				ccalc_cU_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0):=
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_MAX_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,120
				ccalc_cU_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_ALT1, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and SupplyRegion_SUB=SupplyRegion_ALT1 and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)<=0 and UPRNWSHR(DSP_Types)> 0 ):=
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				UPRNWSHR(DSP_Types) * 0.001 * GEN_MAX_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				
				!row to exclude existing generation
				!EP$ODSP,121
				ccalc_cO_DISP_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0):=
				IF HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.001 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,122
				ccalc_cO_DISP_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0 ):=
				IF HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,123
				ccalc_cM_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0):=
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.001 * GEN_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,124
				ccalc_cM_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0 ):=
				
				IF EPECAP_MR(FuelRegion_ALT1, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				
				!EP$ODSP,125
				ccalc_cJ_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0):=
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.001 * GEN_MIN_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,126
				ccalc_cJ_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0 ):=
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.001 * GEN_MIN_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,127
				ccalc_cU_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0):=
				IF SR_CREDIT(DSP_Types)>0 and HR_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.001 * GEN_MAX_SR_ODSP(DSP_Types, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!EP$ODSP,128
				ccalc_cU_rGINCge((SupplyRegion_SUB, DSP_Types, PlanYear, FuelRegion_ALT1, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and
				  UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 and UPRNWEXG(DSP_Types)> 0 ):=
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.001 * GEN_MAX_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				endif;
				!REVISE CONSUMPTION ROW COEFFICIENT
				!EP$ODSP,130
				ccalc_cO_DISP_rFXXle((FuelRegion_ALT1, Disp_NoCoal, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, Disp_NoCoal, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				
				IF HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and (Disp_NoCoal <> 'NG') THEN
				0.000001 * GEN_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				ELSEIF  HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and (Disp_NoCoal = 'NG')  THEN   !<--------------- added to handle gas cofiring of NG operation
				0.000001 * GEN_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * (1-EDMXCL_ECP(Disp_NoCoal,FuelRegion_ALT1))
				endif;
				!EP$ODSP,130
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1,CoalPlant,Scrubber_Type(CoalPlant),PlanYear,SupplyRegion_SUB,PlantType,OperatingMode,Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CoalPlant = PlantType):=
				IF HR_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_ODSP(CoalPlant, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1,CoalPlant,Scrubber_Type(CoalPlant),PlanYear,SupplyRegion_SUB,'NG',OperatingMode,Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and NG_CoalShareExist2(FuelRegion_ALT1,CoalPlant)=1):=
				IF HR_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_ODSP('NG', Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * NG_CoalShare(FuelRegion_ALT1,CoalPlant) * EDMXCL_ECP('NG',FuelRegion_ALT1)
				endif;
				!EP$ODSP,131
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType,OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CoalPlant = PlantType):=
				
				IF HTRT_TEST(CoalPlant, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_ODSP(CoalPlant, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear)
				endif;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG',OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB)):=
				
				IF HTRT_TEST('NG', PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element('NG'), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_ODSP('NG', Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear) * NG_CoalShare(FuelRegion_ALT1,CoalPlant) * EDMXCL_ECP('NG',FuelRegion_ALT1)
				endif;
				
				ccalc_cO_DISP_rFXXle((FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) |
				ccalc_cO_DISP_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) |
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and CoalPlant = PlantType):=0;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cO_DISP_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) |
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				
				!EP$ODSP,132
				ccalc_cJ_rFXXle((FuelRegion_ALT1, Disp_NoCoal, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, Disp_NoCoal, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				IF SR_CREDIT(Disp_NoCoal)>0 and HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and Disp_NoCoal <>'NG'  THEN
				0.000001 * GEN_MIN_SR_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				ELSEIF SR_CREDIT(Disp_NoCoal)>0 and HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and Disp_NoCoal ='NG'  THEN    !<---------------- added to handle gas cofiring of NG
				0.000001 * GEN_MIN_SR_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * (1-EDMXCL_ECP(Disp_NoCoal,FuelRegion_ALT1))
				ENDIF;
				!EP$ODSP,132
				ccalc_cJ_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CoalPlant = PlantType):=
				IF SR_CREDIT(CoalPlant)>0 and HR_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_MIN_SR_ODSP(CoalPlant, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cJ_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and NG_CoalShareExist2(FuelRegion_ALT1,CoalPlant)=1):=
				IF SR_CREDIT('NG')>0 and HR_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_MIN_SR_ODSP('NG', Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * NG_CoalShare(FuelRegion_ALT1,CoalPlant) * EDMXCL_ECP('NG',FuelRegion_ALT1)
				endif;
				
				!EP$ODSP,133
				ccalc_cJ_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CoalPlant = PlantType):=
				IF SR_CREDIT(CoalPlant)>0 and HTRT_TEST(CoalPlant, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_MIN_SR_ODSP(CoalPlant, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MIN(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear)
				endif;
				
				ccalc_cJ_rFXXle((FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) |
				ccalc_cJ_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				ccalc_cJ_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) |
				ccalc_cJ_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and CoalPlant = PlantType):=0;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cJ_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) |
				ccalc_cJ_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;   !added to handle coal cofiring part of NG
				
				
				!EP$ODSP,134
				ccalc_cU_rFXXle((FuelRegion_ALT1, Disp_NoCoal, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, Disp_NoCoal, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				IF SR_CREDIT(Disp_NoCoal)>0 and HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and Disp_NoCoal <> 'NG' THEN
				0.000001 * GEN_MAX_SR_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MAX(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				ElSEIF SR_CREDIT(Disp_NoCoal)>0 and HR_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and Disp_NoCoal = 'NG' THEN    !<---- added to handle gas cofiring of NG operation
				0.000001 * GEN_MAX_SR_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MAX(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * (1-EDMXCL_ECP(Disp_NoCoal,FuelRegion_ALT1))
				ENDIF;
				!EP$ODSP,134
				ccalc_cU_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CoalPlant = PlantType):=
				IF SR_CREDIT(CoalPlant)>0 and HR_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_MAX_SR_ODSP(CoalPlant, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MAX(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cU_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and NG_CoalShareExist2(FuelRegion_ALT1,CoalPlant)=1):=
				IF SR_CREDIT('NG')>0 and HR_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_MAX_SR_ODSP('NG', Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_NMR('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ('NG', FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MAX(SupplyRegion_SUB, 'NG', FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear) * NG_CoalShare(FuelRegion_ALT1,CoalPlant) * EDMXCL_ECP('NG',FuelRegion_ALT1)
				endif;
				
				!EP$ODSP,135
				ccalc_cU_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CoalPlant = PlantType):=
				IF SR_CREDIT(CoalPlant)>0 and HTRT_TEST(CoalPlant, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_MAX_SR_ODSP(CoalPlant, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ_MAX(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear)
				endif;
				
				ccalc_cU_rFXXle((FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) |
				ccalc_cU_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				ccalc_cU_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) |
				ccalc_cU_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and CoalPlant = PlantType):=0;
				!<-----------------following was added to address NG operation related to coal cofiring
				ccalc_cU_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) |
				ccalc_cU_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) <=ECP_MIN('1') and
				ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, 'NG', OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				
				!EP$ODSP,148
				ccalc_cM_rFMRle((FuelRegion_ALT1, Disp_NoCoal, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, Disp_NoCoal, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB)):=
				
				IF EPECAP_MR(FuelRegion_ALT1, Disp_NoCoal, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_ODSP(Disp_NoCoal, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MR(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(Disp_NoCoal, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, Disp_NoCoal, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!EP$ODSP,148
				ccalc_cM_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CoalPlant = PlantType):=
				
				IF EPECAP_MR(FuelRegion_ALT1, CoalPlant, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and HR_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) THEN
				0.000001 * GEN_ODSP(CoalPlant, Season1_element(Season1), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Season1_element(Season1), PlanYear)
				endif;
				!EP$ODSP,149
				ccalc_cM_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType,OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CoalPlant = PlantType):=
				
				IF EPECAP_MR(FuelRegion_ALT1, CoalPlant, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				HTRT_TEST(CoalPlant, PlanYear)=0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_ODSP(CoalPlant, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				HTRT_ADJ(SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, OperatingMode, Seasonhr_element(Season_hr), PlanYear)
				endif;
				ccalc_cM_rFMRle((FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) |
				ccalc_cM_rFMRle(FuelRegion_ALT1, DSP_Types, GasSeason, PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Seasonmd) <=ECP_MIN('1')):=0;
				ccalc_cM_rFXXSle((FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) |
				ccalc_cM_rFXXSle(FuelRegion_ALT1, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_SUB, PlantType, OperatingMode, Seasonmd) <=ECP_MIN('1') and CoalPlant = PlantType):=0;
				
				!Track Captured CO2 for CCATS
				!No longer use MUST_STORE condition, assumes all CO2 must be captured
				
				!EP$ODSP,136
				ccalc_cO_DISP_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1)):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cO_DISP_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				endif;
				
				!EP$ODSP,137
				ccalc_cO_DISP_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1) ):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cO_DISP_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cO_DISP_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season_hr), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				endif;
				
				!EP$ODSP,138
				ccalc_cJ_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1)):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cJ_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cJ_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				endif;
				!EP$ODSP,139
				ccalc_cJ_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1) ):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cJ_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cJ_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season_hr), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				endif;
				!EP$ODSP,140
				ccalc_cU_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1)):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cU_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cU_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season1), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season1)
				endif;
				!EP$ODSP,141
				ccalc_cU_rZCSRGeq((CensusRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) and CensusRegion = CensusRegion_EPCSMP(FuelRegion_ALT1) ):=
				IF (UPTTYP(DSP_Types)<= NW_COAL('1')) THEN
				UPPCEF(DSP_Types) * ECLEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cU_rFXXSle(FuelRegion_ALT1, DSP_Types, Scrubber_Type(DSP_Types), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				else
				UPPCEF(DSP_Types) * ENGEL(cyr) * 0.001 * (44.0 / 12.0)*ccalc_cU_rFXXle(FuelRegion_ALT1, DSP_Types, GasSeason1_element(Season_hr), PlanYear, SupplyRegion_SUB, DSP_Types, OperatingMode, Season_hr)
				endif;
				
				!ACCOUNT FOR OUT-OF-STATE CARBON EMISSIONS IN CA
				!EP$ODSP,142
				ccalc_cO_DISP_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_CA)):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cO_DISP_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season1)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
				!EP$ODSP,143
				ccalc_cO_DISP_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_CA) ):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cO_DISP_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season_hr)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
				!EP$ODSP,144
				ccalc_cJ_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_CA)):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cJ_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season1)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
				!EP$ODSP,145
				ccalc_cJ_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_CA) ):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cJ_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season_hr)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
				!EP$ODSP,146
				ccalc_cU_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_CA)):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cU_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season1)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
				!EP$ODSP,147
				ccalc_cU_rEUCARle((CarbonRegion, PlanYear, SupplyRegion_CA, FuelRegion_noCA, CoalPlant, OperatingMode, Season_hr) |
				FuelRegion_DSP(SupplyRegion_CA, CoalPlant, FuelRegion_noCA, PlanYear) and
				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_CA) ):=
				
				IF (UPTTYP(CoalPlant)<= EX_COAL('1') and CO2_OS_BY_RG(SupplyRegion_CA, CO2CapGroup_element(CarbonRegion)) > 0) THEN
				ccalc_cU_rFXXSle(FuelRegion_noCA, CoalPlant, Scrubber_Type(CoalPlant), PlanYear, SupplyRegion_CA, CoalPlant, OperatingMode, Season_hr)*
				UFRCAR(EFDFuelType_PlantType(CoalPlant), FuelRegion_EPCLMP(FuelRegion_noCA)) * (1.0 / 2204.0)
				endif;
			}
		}
		Procedure EP_ORNW_Calculations {
			Body: {
				Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) :=
				IF (UPOVR(OtherRenewable) < 9000 OR EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) THEN
				   IF (EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				   (UPVTYP(OtherRenewable)= 1 AND UPAVLYR(OtherRenewable) <= CURIYR('1') + UHBSYR('1') + UNFPH('1') AND UPBLDREG(OtherRenewable,SupplyRegion_SUB) > 0)) THEN
				        IF (UPTOPR(OtherRenewable)= 2) THEN       !Hydro should not be assigned to this type
				             1
				        endif
				    endif
				endif;
				Condition_ORNW_Hydro((OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)) :=
				IF (UPOVR(OtherRenewable) < 9000 OR EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) THEN
				   IF (EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				   (UPVTYP(OtherRenewable)= 1 AND UPAVLYR(OtherRenewable) <= CURIYR('1') + UHBSYR('1') + UNFPH('1') AND UPBLDREG(OtherRenewable,SupplyRegion_SUB) > 0)) THEN
				        IF (UPTOPR(OtherRenewable)= 1 or UPTOPR(OtherRenewable)= 3) THEN       !Hydro should not be assigned to this type
				         if EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 then
				             1
				         endif
				        endif
				    endif
				endif;
				Condition_ORNW_Hydro_ALT(OtherRenewable, SupplyRegion_SUB, PlanYear)  :=
				IF (UPOVR(OtherRenewable) < 9000 OR EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) THEN
				   IF (EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 OR
				   (UPVTYP(OtherRenewable)= 1 AND UPAVLYR(OtherRenewable) <= CURIYR('1') + UHBSYR('1') + UNFPH('1') AND UPBLDREG(OtherRenewable,SupplyRegion_SUB) > 0)) THEN
				        IF (UPTOPR(OtherRenewable)= 1 or UPTOPR(OtherRenewable)= 3) THEN       !Hydro should not be assigned to this type
				             1
				        endif
				    endif
				endif;
				!EP$ORNW,1 (1)
				ccalc_cZMrnw_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * 8.760
				endif;
				
				!EP$ORNW,1 (2)
				ccalc_cOMR_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * 8.760
				endif;
				
				!EP$ORNW,2 (1)
				ccalc_cJM_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) |ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element))  :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				
				!EP$ORNW,2 (2)
				ccalc_cJMR_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				
				!EP$ORNW,3 (1)
				ccalc_cUM_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) |ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				 FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * (1 - UPFORT(OtherRenewable))
				endif;
				
				!EP$ORNW,3 (2)
				ccalc_cUMR_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *  (1 - UPFORT(OtherRenewable))
				endif;
				
				!EP$ORNW,5 (1)
				ccalc_cZXrnw_rCXsxle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				1
				endif;
				
				!EP$ORNW,5 (2)
				ccalc_cOXX_rCXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				1
				endif;
				
				!EP$ORNW,6 (1)
				ccalc_cZXrnw_rEX_Xle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				
				!EP$ORNW,6 (2)
				ccalc_cOXX_rEXXXle((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				
				!EP$ORNW,7 (1)
				ccalc_cZMrnw_rCMsxle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				1
				endif;
				
				!EP$ORNW,7 (2)
				ccalc_cOMR_rCMXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				1
				endif;
				
				!EP$ORNW,10 (1)
				ccalc_cJX_rCXsxle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				1
				endif;
				
				!EP$ORNW,10 (2)
				ccalc_cJXX_rCXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				1
				endif;
				
				!EP$ORNW,11 (1)
				ccalc_cUX_rCXsxle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				1
				endif;
				
				!EP$ORNW,11 (2)
				ccalc_cUXX_rCXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				1
				endif;
				
				!EP$ORNW,12 (1)
				ccalc_cJX_rEX_Xle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				
				!EP$ORNW,12 (2)
				ccalc_cJXX_rEXXXle((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				
				!EP$ORNW,13 (1)
				ccalc_cUX_rEX_Xle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * (1 - UPFORT(OtherRenewable))
				endif;
				
				!EP$ORNW,13 (2)
				ccalc_cUXX_rEXXXle((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * (1 - UPFORT(OtherRenewable))
				endif;
				
				!EP$ORNW,14 (1)
				ccalc_cJM_rCMsxle((SupplyRegion_SUB, OtherRenewable, FuelRegion_ALT1, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and

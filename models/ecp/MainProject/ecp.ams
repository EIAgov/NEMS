				HR_MOD_MR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.001 * GEN_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear)
				
				endif;
				!  NOX EMISSIONS CONSTRAINT
				!EP$ODSP,64
				ccalc_cO_DISP_rEUNle((DSP_Types, NOXRegion, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, Season1) |
				FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion_ALT1, PlanYear) and
				  ord(OperatingMode)<=NSTP(Season1_element(Season1), SupplyRegion_SUB) and ord(PlanYear)>NOX_LT('1')):=
				

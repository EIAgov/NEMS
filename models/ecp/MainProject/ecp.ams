			Parameter ccalc_cFXX_ECPCOSTS {
				IndexDomain: (FuelRegion_ALT1,PlantType,Scrubber,PlanYear) | Scrubber = Scrubber_Type(PlantType) and FuelRegion_ALT1 <> 'US';
				Text: "OML Columns: F(*)(**)(*)XX(*) and OML Rows: ECPCOSTS";
				Definition: {
					if (C_ECP_CDS(CoalPlant_UtilitySector(DispatchableECP_PlantType(PlantType)), CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) = 1) Then

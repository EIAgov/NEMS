	Section Move_completed_ccalc_parameters_here {
		DeclarationSection CALC_STORAGE_VAL_Completed {
			Parameter ccalc_cEXXX_INT_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType=WIDS_Element and PlanYear_ALTB=FirstPlanYear;
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: LBOUND";
				Definition: NET_STORAGE_CAP_EX(element(Season_,EPNMSP('1',SupplyRegion_ALT1,cyr)), SupplyRegion_ALT1, cyr);
				Comment: "CALC_STORAGE_VAL,1";
			}
			Parameter ccalc_cIX_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)  | ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType=WIDS_Element and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and  ElasticityStep= '1' and
					OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1')
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: MAX(ENERGY_STORED(element(Three_,N_STO_INC('1')+1), SupplyRegion_ALT1), BATTERY_USED(element(Three_,N_STO_INC('1')+1), SupplyRegion_ALT1));
				Comment: "CALC_STORAGE_VAL,11";
			}
		}
		DeclarationSection EP_ALLOW_Completed {
			Parameter SO2 {
				IndexDomain: (FullPlanningHorizon, SO2Region);
				Definition: EMRFSA(LastModelYear_MNUMYR2(FullPlanningHorizon), SO2Region_SO2ComplyGroup(SO2Region))*0.001;
			}
			Parameter PV_SO2 {
				IndexDomain: (SO2Region,PlanYear);
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					if ord(PlanYear)<UNXPH('1') then
					SO2(FullPlanningHorizon_PlanYear(PlanYear), SO2Region)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))/
					SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
					endif
				}
			}
			Parameter SO2_REV {
				IndexDomain: (FullPlanningHorizon, SO2Region);
				Definition: {
					SO2(FullPlanningHorizon, SO2Region) *
					ECP_PSO2(XPH0, LastModelYear_MNUMYR2(FullPlanningHorizon), SO2Region_SO2ComplyGroup(SO2Region)) *
					UPGNPD(LastModelYear_MNUMYRF2(FullPlanningHorizon)) * 0.001
				}
			}
			Parameter CAP_SO2 {
				IndexDomain: (FullPlanningHorizon, SO2Region);
				Definition: {
					MAX(0, (PV_SO2(SO2Region,UNXPH_PlanYear)-SO2(FullPlanningHorizon,SO2Region)+0.0001)/
					(PV_SO2(SO2Region,UNXPH_PlanYear)-SO2(last(FullPlanningHorizon), SO2Region) + 0.0001))
				}
			}
			Parameter PV_CAP_SO2 {
				IndexDomain: (SO2Region);
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + UNXPH('1') - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(CAP_SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))/
					CAP_SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(UNXPH_PlanYear)
					endif
				}
			}
			Parameter SO2_CLRG {
				IndexDomain: (FullPlanningHorizon, CoalDemandRegion);
				Definition: TSO2_VR1_BY_CLRG(CoalDemandRegion);
			}
			Parameter SO2_SHR {
				IndexDomain: (CoalDemandRegion,SO2Region,PlanYear);
				Definition: {
					IF (CURIYR('1') + UHBSYR('1') + Year(PlanYear) - 1) >= TRANRULE1('1') THEN
					   TSO2_SHR_BY_CLRG(CoalDemandRegion, SO2Region_SO2Transport(SO2Region))
					ELSE
					   SO2_SHR_BY_CLRG(CoalDemandRegion, SO2Region_SO2ComplyGroup(SO2Region))
					ENDIF
				}
			}
			Parameter SO2_CTL {
				IndexDomain: (FullPlanningHorizon, SO2Region);
				Definition: {
					sum((CoalSupplyCurve_Dom, CoalDemandRegion)|
					SO2_SHR(CoalDemandRegion, SO2Region, PlanYear_FullPlanningHorizon(FullPlanningHorizon))>0.0001 and
					TOT_TYPE(CoalSupplyCurve_Dom)>0 and
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon))>0,
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon)) *
					XCL_SO2_YR(CoalSupplyCurve_Dom, cyr) *
					(1.0 - RCLCLNR(CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon), WIIG_ECP_Element)) *
					SO2_SHR(CoalDemandRegion, SO2Region, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) * 0.5)
				}
			}
			Parameter PV_SO2_CTL {
				IndexDomain: (SO2Region,PlanYear);
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					SO2_CTL(FullPlanningHorizon_PlanYear(PlanYear), SO2Region)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2_CTL(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))/
					SO2_CTL(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
			}
			Parameter SO_CTL {
				IndexDomain: (FullPlanningHorizon, CoalDemandRegion);
				Definition: {
					sum(CoalSupplyCurve_Dom|
					TSO2_YR_BY_CLRG('1') < 9999 and TOT_TYPE(CoalSupplyCurve_Dom)>0 and
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon))>0,
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon)) *
					XCL_SO2_YR(CoalSupplyCurve_Dom, cyr) *
					(1.0 - RCLCLNR(CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon), WIIG_ECP_Element)) * 0.5)
				}
			}
			Parameter PV_SO_CTL {
				IndexDomain: (CoalDemandRegion,PlanYear);
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					SO_CTL(FullPlanningHorizon_PlanYear(PlanYear), CoalDemandRegion)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO_CTL(FullPlanningHorizon+(UNXPH('1')-1), CoalDemandRegion),ord(FullPlanningHorizon),AVGDCR))/
					SO_CTL(FullPlanningHorizon+(UNXPH('1')-1), CoalDemandRegion) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
			}
			Parameter HG {
				IndexDomain: (FullPlanningHorizon, nHGCODE);
				Definition: EMEL_QHG(nHGCODE_CDR(nHGCODE), LastModelYear_MNUMYR2(FullPlanningHorizon));
			}
			Parameter PV_HG {
				IndexDomain: (nHGCODE,PlanYear);
				Definition: {
					IF USW_HG('1')>0 and (EMEL_QHG(nHGCODE_CDR(nHGCODE), LastModelYear_MNUMYR(PlanYear))>0) THEN
					  if ord(PlanYear)<UNXPH('1') then
					    HG(FullPlanningHorizon_PlanYear(PlanYear), nHGCODE)
					  else
					     sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					     !PVV_Function(HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE),ord(FullPlanningHorizon),AVGDCR))/
					     HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					     ONEVAL(PlanYear)
					  endif
					endif
				}
			}
			Parameter CAP_HG {
				IndexDomain: (FullPlanningHorizon, nHGCODE);
				Definition: {
					max((PV_HG(nHGCODE, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) - HG(FullPlanningHorizon, nHGCODE)+0.0001)/
					(PV_HG(nHGCODE, PlanYear_FullPlanningHorizon(FullPlanningHorizon)) - HG(last(FullPlanningHorizon_), nHGCODE)+0.0001),0)
				}
			}
			Parameter PVCAP_HG {
				IndexDomain: (nHGCODE,PlanYear);
				Definition: {
					IF USW_HG('1')>0 and (EMEL_QHG(nHGCODE_CDR(nHGCODE), LastModelYear_MNUMYR(PlanYear))>0) THEN
					  if ord(PlanYear)=UNXPH('1') then
					     sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					     !PVV_Function(CAP_HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE),ord(FullPlanningHorizon),AVGDCR))/
					     CAP_HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					     ONEVAL(PlanYear)
					  endif
					endif
				}
			}
			Parameter GNP_ALLOW {
				IndexDomain: FullPlanningHorizon;
				Definition: UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) / UPGNPD(UNXPH_MNUMYRF);
			}
			Parameter PV_GNP {
				IndexDomain: (PlanYear);
				Definition: {
					if ord(PlanYear)=UNXPH('1') then
					     sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					     !PVV_Function(GNP_ALLOW(FullPlanningHorizon+(UNXPH('1')-1)),ord(FullPlanningHorizon),AVGDCR))
					     GNP_ALLOW(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
					endif
				}
			}
			Parameter HGCAP {
				IndexDomain: FullPlanningHorizon;
				Definition: {
					if USW_HG('1')>0 and UCAP_HG('1')>0 then
					UCAP_HG('1') * 0.001 * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
				}
			}
			Parameter HG_CTL {
				IndexDomain: (FullPlanningHorizon);
				Definition: {
					IF USW_HG('1')>0 then
					sum((CoalSupplyCurve_Dom, CoalDemandRegion)| TOT_TYPE(CoalSupplyCurve_Dom)>0 and
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon))>0,
					CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon)) *
					XCL_HG_YR(CoalSupplyCurve_Dom, cyr) * PLNT_EMF(WIIG_Element, Rank_Element(CoalSupplyCurve_Dom)) * 0.5)
					endif
				}
			}
			Parameter PV_HG_CTL {
				IndexDomain: (PlanYear);
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					HG_CTL(FullPlanningHorizon_PlanYear(PlanYear))
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(HG_CTL(FullPlanningHorizon+(UNXPH('1')-1)),ord(FullPlanningHorizon),AVGDCR))/
					HG_CTL(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
			}
			Parameter ACIX {
				IndexDomain: (FullPlanningHorizon, numACSS);
				Definition: {
					if USW_HG('1')>0 then
					UCL_PAC(numACI_element(numACSS)) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
				}
			}
			Parameter BA {
				IndexDomain: FullPlanningHorizon | ord(FullPlanningHorizon)<=UNFPH('1')-UNXPH('1')+1;
				Definition: {
					USO2_BA_WGT(Element(MNUMYR_,min(CURIYR('1') + UNXPH('1') + ord(FullPlanningHorizon) - 2, UNYEAR('1'))))/$
					USO2_BA_WGT(Element(MNUMYR_, MIN(CURIYR('1') + UNXPH('1') - 2, UNYEAR('1'))))
				}
			}
			Parameter PV_BA {
				IndexDomain: (PlanYear, SO2Region) | ord(PlanYear)>1;
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					-1 * (USO2_BA_WGT(Element(MNUMYR_, MIN(CURIYR('1') + ord(PlanYear) - 2, UNYEAR('1')))) /$
					USO2_BA_WGT(Element(MNUMYR_, MIN(CURIYR('1') + ord(PlanYear)-1, MYR1(PlanYear)-1))))
					else
					- SO2_REV_FAC(SO2Region) * (1 /$
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(BA(FullPlanningHorizon),ord(FullPlanningHorizon),AVGDCR)))
					BA(FullPlanningHorizon) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon))))
					endif
				}
			}
			Parameter MYR1 {
				IndexDomain: PlanYear;
				Definition: MIN(CURIYR('1') + ord(PlanYear) , UNYEAR('1'));
			}
			Parameter PYR_SO2 {
				Definition: MIN(CURIYR('1') + (UNFPH('1') / 2) - 1 , UNYEAR('1'));
			}
			Parameter ZYR {
				Definition: exists(MNUMYR | ord(MNUMYR)>1 and USO2_BA_CRD(MNUMYR) > USO2_BA_CRD(MNUMYR-1));
			}
			ElementParameter XYR_Year {
				Range: PlanYear_;
				Definition: element(PlanYear_, MIN(UNXPH('1') , XYR_index - CURIYR('1') + 1));
			}
			Parameter XYR_index {
				Range: integer;
				Definition: {
					min(MNUMYR |CURIYR('1')<=ord(MNUMYR)<=MIN(UNYEAR('1'), CURIYR('1')+UNFPH('1')-1) and
					USO2_BA_CRD(MNUMYR) > USO2_BA_CRD(MNUMYR-1), ord(MNUMYR))
				}
			}
			Parameter SO2_REV_FAC {
				IndexDomain: SO2Region;
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1')) = UPSTYR('1')) THEN
					   AVG_SO2_PRC(SO2Region) /$ (ECP_PSO2(XPH0, Element(MNUMYR_,PYR_SO2), SO2Region_SO2ComplyGroup(SO2Region)) *
					   UPGNPD(Element(MNUMYRF_,PYR_SO2)) * 0.001)
					ELSE
					   !0.5 * SO2_REV_FAC(ISO2) +
					   0.5 * AVG_SO2_PRC(SO2Region) /$ (MAX(ECP_MIN('1'),
					   ECP_PSO2(XPH0, Element(MNUMYR_,PYR_SO2), SO2Region_SO2ComplyGroup(SO2Region)) *
					   UPGNPD(Element(MNUMYRF_,PYR_SO2)) * 0.001))
					ENDIF
				}
			}
			Parameter AVG_SO2_PRC {
				IndexDomain: SO2Region;
				Definition: {
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2_REV(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))/$
					SO2_REV(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/$
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))
					SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))
				}
			}
			Parameter NOX {
				IndexDomain: (FullPlanningHorizon, NOXRegion);
				Definition: NOXBYGRP(NOXRegion, LastModelYear_MNUMYR2(FullPlanningHorizon));
			}
			Parameter PV_NOX {
				IndexDomain: (NOXRegion,PlanYear);
				Definition: {
					IF (0<NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))<9990.0) and ord(PlanYear)>NOX_LT('1') THEN
					if ord(PlanYear)<UNXPH('1') then
					NOX(FullPlanningHorizon_PlanYear(PlanYear), NOXRegion)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(NOX(FullPlanningHorizon+(UNXPH('1')-1), NOXRegion),ord(FullPlanningHorizon),AVGDCR))/
					NOX(FullPlanningHorizon+(UNXPH('1')-1), NOXRegion) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
					endif
				}
			}
			Parameter NOX_CTL {
				IndexDomain: (FullPlanningHorizon, NOXRegion);
				Definition: {
					sum((CoalDemandRegion, Season), NOXEM(CoalDemandRegion, NOXRegion, Season) *
					CTLSUM(CoalDemandRegion, FullPlanningHorizon) * EETIME(Season, last(SupplyRegion_SUB)) / 8760.0)
				}
			}
			Parameter NOXEM {
				IndexDomain: (CoalDemandRegion, NOXRegion, Season);
				Definition: {
					NOX_NEW(first(BoilerType), WIIG_Element) * (NOX_EFD(Season, NOXRegion) /$ EETIME(Season, last(SupplyRegion_SUB))) *
					NOX_SHR_BY_CLRG(CoalDemandRegion, NOXRegion) * 0.0005 * 1000
				}
			}
			Parameter CTLSUM {
				IndexDomain: (CoalDemandRegion, FullPlanningHorizon);
				Definition: sum(CoalSupplyCurve_Dom, CTLBTU(CoalSupplyCurve_Dom, CoalDemandRegion, LastModelYear_MNUMYR2(FullPlanningHorizon)));
			}
			Parameter PV_NOX_CTL {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1');
				Definition: {
					if ord(PlanYear)<UNXPH('1') then
					NOX_CTL(FullPlanningHorizon_PlanYear(PlanYear), NOXRegion)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(NOX_CTL(FullPlanningHorizon+(UNXPH('1')-1), NOXRegion),ord(FullPlanningHorizon),AVGDCR))/
					NOX_CTL(FullPlanningHorizon+(UNXPH('1')-1), NOXRegion) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					endif
				}
			}
			Parameter ccalc_cRHS_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					if ord(PlanYear)<UNXPH('1') then
					SO2(FullPlanningHorizon_PlanYear(PlanYear), SO2Region)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region),ord(FullPlanningHorizon),AVGDCR))/
					SO2(FullPlanningHorizon+(UNXPH('1')-1), SO2Region) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					!PVV_Function(SO2(FullPlanningHorizon+2, SO2Region),ord(FullPlanningHorizon),EPDSCRT('1',LastSupplyRegion,cyr)))/
					!PVV_KW2(LastSupplyRegion)
					
					
					endif
					endif
				}
				Comment: "EP$ALLOW,1";
			}
			Parameter ccalc_cRHS_rMVSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: MVSO2(**)(*)";
				Definition: {
					IF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1') and TSO2_SHR_BY_CLRG(CoalDemandRegion, first(SO2_Transport_))>0 and
					(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TSO2_VR_BY_CLRG('1') THEN
					if ord(PlanYear)<UNXPH('1') then
					SO2_CLRG(FullPlanningHorizon_PlanYear(PlanYear), CoalDemandRegion)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(SO2_CLRG(FullPlanningHorizon+(UNXPH('1')-1), CoalDemandRegion),ord(FullPlanningHorizon),AVGDCR))/
					SO2_CLRG(FullPlanningHorizon+(UNXPH('1')-1), CoalDemandRegion) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					ONEVAL(PlanYear)
					
					endif
					endif
				}
				Comment: "EP$ALLOW,9";
			}
			Parameter ccalc_cMVS_ECPCOSTS {
				IndexDomain: (CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto,PlanYear);
				Text: "OML Columns: MVS(**)(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1') and TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTto, first(SO2_Transport_))>0 and
					TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTfrom, first(SO2_Transport_))>0 and CoalDemandRegion_ALTfrom<>CoalDemandRegion_ALTto THEN
					ECP_MIN('1')
					endif
				}
				Comment: "EP$ALLOW,10";
			}
			Parameter ccalc_cMVS_rMVSO2le {
				IndexDomain: {
					(CoalDemandRegion,PlanYear,CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto) | CoalDemandRegion=CoalDemandRegion_ALTto and
					CoalDemandRegion_ALTfrom<>CoalDemandRegion_ALTto
				}
				Text: "OML Columns: MVS(**)(**)(*) and OML Rows: MVSO2(**)(*)";
				Definition: {
					IF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1') and TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTto, first(SO2_Transport_))>0 and
					TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTfrom, first(SO2_Transport_))>0 and (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1)>= TSO2_VR_BY_CLRG('1') THEN
					1
					endif
				}
				Comment: "EP$ALLOW,11";
			}
			Parameter ccalc_cMVS_rEUSO2le {
				IndexDomain: (CoalDemandRegion,PlanYear,CoalDemandRegion_ALTfrom,CoalDemandRegion_ALTto);
				Text: "OML Columns: MVS(**)(**)(*) and OML Rows: EUSO2(**)(*)";
				Definition: {
					IF (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >= TRANRULE1('1') and TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTto, first(SO2_Transport_))>0 and
					TSO2_SHR_BY_CLRG(CoalDemandRegion_ALTfrom, first(SO2_Transport_))>0 and CoalDemandRegion_ALTfrom<>CoalDemandRegion_ALTto THEN
					if CoalDemandRegion=CoalDemandRegion_ALTto then
					-1
					elseif CoalDemandRegion=CoalDemandRegion_ALTfrom then
					1
					endif
					endif
				}
				Comment: {
					"EP$ALLOW,12; EP$ALLOW,13"
				}
			}
			Parameter ccalc_cCTLSO2_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear) | PV_SO2_CTL(SO2Region, PlanYear)>0;
				Text: "OML Columns: CTLSO2(*)(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					1
					endif
				}
				Comment: "EP$ALLOW,14";
			}
			Parameter ccalc_cCTLSO2_rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear) | PV_SO2_CTL(SO2Region, PlanYear)>0;
				Text: "OML Columns: CTLSO2(*)(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >=TRANRULE1('1') AND ord(SO2Region)<> NUM_SO2_GRP('1')) THEN
					1
					endif
				}
			}
			Parameter ccalc_cCTLSO2_UBOUND {
				IndexDomain: (SO2Region,PlanYear) | PV_SO2_CTL(SO2Region, PlanYear)>0;
				Text: "OML Columns: CTLSO2(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: PV_SO2_CTL(SO2Region, PlanYear);
				Comment: "EP$ALLOW,15";
			}
			Parameter ccalc_cCTLSO_UBOUND {
				IndexDomain: {
					(CoalDemandRegion,PlanYear) | PV_SO_CTL(CoalDemandRegion, PlanYear)>ECP_MIN('1') and
					TSO2_SHR_BY_CLRG(CoalDemandRegion, first(SO2_Transport_))>ECP_MIN('1')
				}
				Text: "OML Columns: CTLSO(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: PV_SO_CTL(CoalDemandRegion, PlanYear);
				Comment: "EP$ALLOW,16";
			}
			Parameter ccalc_cCTLSO2_LBOUND {
				IndexDomain: (SO2Region,PlanYear) | PV_SO2_CTL(SO2Region, PlanYear)>0;
				Text: "OML Columns: CTLSO2(*)(*) and OML Rows: LBOUND";
				Definition: PV_SO2_CTL(SO2Region, PlanYear);
				Comment: "EP$ALLOW,15";
			}
			Parameter ccalc_cCTLSO_LBOUND {
				IndexDomain: {
					(CoalDemandRegion,PlanYear) | PV_SO_CTL(CoalDemandRegion, PlanYear)>ECP_MIN('1') and
					TSO2_SHR_BY_CLRG(CoalDemandRegion, first(SO2_Transport_))>ECP_MIN('1')
				}
				Text: "OML Columns: CTLSO(**)(*) and OML Rows: LBOUND";
				Definition: PV_SO_CTL(CoalDemandRegion, PlanYear);
				Comment: "EP$ALLOW,16";
			}
			Parameter ccalc_cRHS_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: EUHGXX(*)(*)";
				Definition: {
					IF USW_HG('1')>0 THEN
					1000*
					IF (EMEL_QHG(nHGCODE_CDR(nHGCODE), LastModelYear_MNUMYR(PlanYear))>0) THEN
					  if ord(PlanYear)<UNXPH('1') then
					    HG(FullPlanningHorizon_PlanYear(PlanYear), nHGCODE)
					  else
					     sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					     !PVV_Function(HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE),ord(FullPlanningHorizon),AVGDCR))/
					     HG(FullPlanningHorizon+(UNXPH('1')-1), nHGCODE) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))/
					     ONEVAL(PlanYear)
					  endif
					else
					  100
					endif
					endif
				}
				Comment: "EP$ALLOW,17";
			}
			Parameter ccalc_cBNK_HG_UBOUND {
				IndexDomain: (nHGCODE,PlanYear_ALTB) | ord(PlanYear_ALTB)=1;
				Text: "OML Columns: BNK_HG(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF USW_HG('1')>0 and ord(LastModelYear_MNUMYR(PlanYear_ALTB)) >= HG_BYR('1') - UHBSYR('1') THEN
					 IF ((sum(PlanYear| ord(LastModelYear_MNUMYR(PlanYear))=HG_SYR('1')-UHBSYR('1'),1)>0 OR
					 (ord(LastModelYear_MNUMYR(UNXPH_PlanYear)) < HG_SYR('1') - UHBSYR('1'))) AND
					  ord(PlanYear_ALTB)>= MAX((HG_BYR('1') - CURIYR('1') - UHBSYR('1') + 2) , 1)) OR
					  ord(LastModelYear_MNUMYR(PlanYear_ALTB)) > HG_SYR('1') - UHBSYR('1') THEN
					    BANK_HG(nHGCODE_CDR(nHGCODE))*
					      if ord(LastModelYear_MNUMYR(UNXPH_PlanYear)) <= HG_SYR('1') - UHBSYR('1') then
					        PVCAP_HG(nHGCODE, PlanYear_ALTB)/PV_GNP(PlanYear_ALTB)
					      else
					        1
					      endif
					 else
					  inf
					 endif
					endif
					!
					!
				}
				Comment: {
					"EP$ALLOW,18; EP$ALLOW,23; EP$ALLOW,30"
				}
			}
			Parameter ccalc_cBNK_HG_ECPCOSTS {
				IndexDomain: (nHGCODE,PlanYear_ALTB);
				Text: "OML Columns: BNK_HG(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF USW_HG('1')>0 and ord(LastModelYear_MNUMYR(PlanYear_ALTB)) >= HG_BYR('1') - UHBSYR('1') THEN
					IF ((sum(PlanYear| ord(LastModelYear_MNUMYR(PlanYear))=HG_SYR('1')-UHBSYR('1'),1)>0 OR
					(ord(LastModelYear_MNUMYR(UNXPH_PlanYear)) < HG_SYR('1') - UHBSYR('1'))) AND
					ord(PlanYear_ALTB)>= MAX((HG_BYR('1') - CURIYR('1') - UHBSYR('1') + 2) , 1)) OR
					ord(LastModelYear_MNUMYR(PlanYear_ALTB)) > HG_SYR('1') - UHBSYR('1') THEN
					0.0001
					endif
					endif
				}
				Comment: {
					"EP$ALLOW,20; EP$ALLOW,22; EP$ALLOW,25; EP$ALLOW,27; EP$ALLOW,31; EP$ALLOW,33; EP$ALLOW,35"
				}
			}
			Parameter ccalc_cBNK_HG_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear,PlanYear_ALTB);
				Text: "OML Columns: BNK_HG(*)(*) and OML Rows: EUHGXX(*)(*)";
				Definition: {
					IF USW_HG('1')>0 and ord(LastModelYear_MNUMYR(PlanYear)) >= HG_BYR('1') - UHBSYR('1') then
					if ((ord(LastModelYear_MNUMYR(PlanYear)) = HG_SYR('1') - UHBSYR('1') or
					(ord(PlanYear)=UNXPH('1') and ord(LastModelYear_MNUMYR(PlanYear)) < HG_SYR('1') - UHBSYR('1'))) and
					ord(PlanYear_ALTB)>= MAX((HG_BYR('1') - CURIYR('1') - UHBSYR('1') + 2) , 1)) then
					  if ord(PlanYear)<UNXPH('1') then
					     -1        !EP$ALLOW,19; 21; 24
					  else
					    -PVCAP_HG(nHGCODE, PlanYear)/PV_GNP(PlanYear)   !EP$ALLOW,26
					  endif
					elseif  ord(LastModelYear_MNUMYR(PlanYear)) = HG_SYR('1') - UHBSYR('1') +1 and
					ord(PlanYear_ALTB)>= MAX((HG_BYR('1')-CURIYR('1')-UHBSYR('1')+2) , 1) and ord(PlanYear_ALTB)<ord(PlanYear) then
					  0        !EP$ALLOW,28
					elseif ord(LastModelYear_MNUMYR(PlanYear)) > HG_SYR('1') - UHBSYR('1') and PlanYear=PlanYear_ALTB then
					  if ord(PlanYear)<UNXPH('1') then
					    -1      !EP$ALLOW,29; 32
					  else
					    -PVCAP_HG(nHGCODE, PlanYear)/PV_GNP(PlanYear)  !EP$ALLOW,34
					  endif
					elseif ord(LastModelYear_MNUMYR(PlanYear)) > HG_SYR('1') - UHBSYR('1') and PlanYear_ALTB=PlanYear+1 then
					  1    !EP$ALLOW,36
					elseif ord(LastModelYear_MNUMYR(PlanYear)) <= HG_SYR('1') - UHBSYR('1') and PlanYear_ALTB=PlanYear+1 then
					  1/HG_FCTR('1')      !EP$ALLOW,36
					endif
					endif
				}
				Comment: "EP$ALLOW,19 EP$ALLOW,36";
			}
			Parameter ccalc_cGCHGXX_UBOUND {
				IndexDomain: (nHGCODE,PlanYear) | USW_HG('1')>0 and UCAP_HG('1')>0;
				Text: "OML Columns: GCHGXX(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: 100000;
				Comment: "EP$ALLOW,37";
			}
			Parameter ccalc_cGCHGXX_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: GCHGXX(*)(*) and OML Rows: EUHGXX(*)(*)";
				Definition: {
					if USW_HG('1')>0 and UCAP_HG('1')>0 then
					-1
					endif
				}
				Comment: "EP$ALLOW,38";
			}
			Parameter ccalc_cGCHGXX_ECPCOSTS {
				IndexDomain: (nHGCODE,PlanYear);
				Text: "OML Columns: GCHGXX(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if USW_HG('1')>0 and UCAP_HG('1')>0 then
					max(ECP_MIN('1'),
					if ord(PlanYear)<UNXPH('1') then
					HGCAP(FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(AVGDCR,Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(HGCAP(FullPlanningHorizon+(UNXPH('1')-1)),ord(FullPlanningHorizon),AVGDCR)) *
					HGCAP(FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					endif)
					endif
				}
				Comment: "EP$ALLOW,39";
			}
			Parameter ccalc_cCTLHGXX_rEUHGXXle {
				IndexDomain: (nHGCODE,PlanYear) | ord(nHGCODE)=1 and PV_HG_CTL(PlanYear)>0;
				Text: "OML Columns: CTLHGXX(*) and OML Rows: EUHGXX(*)(*)";
				Definition: 1;
				Comment: "EP$ALLOW,40";
			}
			Parameter ccalc_cCTLHGXX_UBOUND {
				IndexDomain: (PlanYear) | PV_HG_CTL(PlanYear)>0;
				Text: "OML Columns: CTLHGXX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: PV_HG_CTL(PlanYear);
				Comment: "EP$ALLOW,41";
			}
			Parameter ccalc_cCTLHGXX_LBOUND {
				IndexDomain: (PlanYear) | PV_HG_CTL(PlanYear)>0;
				Text: "OML Columns: CTLHGXX(*) and OML Rows: LBOUND";
				Definition: PV_HG_CTL(PlanYear);
				Comment: "EP$ALLOW,41";
			}
			Parameter ccalc_cACIXSS_rACIXXXXle {
				IndexDomain: (PlanYear,numACSS);
				Text: "OML Columns: ACIXSS(*)(*) and OML Rows: ACIXXXX(*)";
				Definition: {
					IF USW_HG('1')>0 then
					-10   ! Scale by 10.0 to hopefully help reduce numerical singularities
					endif
				}
				Comment: "EP$ALLOW,43";
			}
			Parameter ccalc_cACIXSS_ECPCOSTS {
				IndexDomain: (numACSS,PlanYear);
				Text: "OML Columns: ACIXSS(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if USW_HG('1')>0 then
					if ord(PlanYear)<UNXPH('1') then
					ACIX(FullPlanningHorizon_PlanYear(PlanYear), numACSS) * PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(ACIX(FullPlanningHorizon+(UNXPH('1')-1), numACSS),ord(FullPlanningHorizon),AVGDCR)) *
					ACIX(FullPlanningHorizon+(UNXPH('1')-1), numACSS) / ((1 + AVGDCR) ^ ord(FullPlanningHorizon)))*
					PWF_Function(AVGDCR,UNXPH01)(PlanYear)
					endif
					endif
				}
				Comment: "EP$ALLOW,44";
			}
			Parameter ccalc_cACIXSS_UBOUND {
				IndexDomain: (numACSS,PlanYear) | USW_HG('1')>0 and ord(numACSS)<NUM_ACSS('1');
				Text: "OML Columns: ACIXSS(*)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: UCL_QAC(numACI_element(numACSS));
				Comment: "EP$ALLOW,45";
			}
			Parameter ccalc_cBNKSO2_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear,PlanYear_ALTB);
				Text: "OML Columns: BNK(*)SO2(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					  if (CURIYR('1') + UHBSYR('1')) <> (TRANRULE1('1') - UPSCLT('1')) and
					  PlanYear_ALTB=PlanYear+1 and ord(PlanYear)<UNXPH('1') then
					    1
					  elseif PlanYear_ALTB=PlanYear and ord(PlanYear)=1 then
					    -1
					  elseif PlanYear_ALTB=PlanYear and ord(PlanYear)>1 and
					  ((EMELBNK(cyr-1,SO2Region_SO2ComplyGroup(SO2Region)) * 0.000001) >= 0.005 or NUM_SO2_GRP('1')>1) then
					    if (CURIYR('1') + UHBSYR('1')) <> (TRANRULE1('1') - UPSCLT('1')) then
					      if MapVal(PV_BA(PlanYear, SO2Region)>0) or PV_BA(PlanYear, SO2Region)=0 then
					        -0.1
					      else
					        PV_BA(PlanYear, SO2Region)
					      endif
					    endif
					  endif
					endif
				}
				Comment: {
					"EP$ALLOW,50; EP$ALLOW,52; EP$ALLOW,62"
				}
			}
			Parameter ccalc_cBNKSO2_rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear,PlanYear_ALTB);
				Text: "OML Columns: BNK(*)SO2(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >=TRANRULE1('1') AND ord(SO2Region)<> NUM_SO2_GRP('1')) THEN
					  IF (CURIYR('1') + UHBSYR('1')) <> (TRANRULE1('1') - UPSCLT('1')) AND
					  PlanYear_ALTB=PlanYear+1 and ord(PlanYear)<UNXPH('1') THEN
					    1
					  elseif PlanYear_ALTB=PlanYear and ord(PlanYear)=1 THEN
					    -1
					  elseif PlanYear_ALTB=PlanYear and ord(PlanYear)>1 and
					  ((EMELBNK(cyr-1,SO2Region_SO2ComplyGroup(SO2Region)) * 0.000001) >= 0.005 OR NUM_SO2_GRP('1')>1) then
					    if (CURIYR('1') + UHBSYR('1')) <> (TRANRULE1('1') - UPSCLT('1')) then
					      if MapVal(PV_BA(PlanYear, SO2Region)>0) or PV_BA(PlanYear, SO2Region)=0 then
					        -0.1
					      else
					        PV_BA(PlanYear, SO2Region)
					      endif
					    endif
					  endif
					endif
				}
				Comment: {
					"EP$ALLOW,50; EP$ALLOW,52; EP$ALLOW,62"
				}
			}
			Parameter ccalc_cBNKSO2_ECPCOSTS {
				IndexDomain: (SO2Region,PlanYear_ALTB);
				Text: "OML Columns: BNK(*)SO2(*) and OML Rows: ECPCOSTS";
				Definition: {
					if (CURIYR('1') + UHBSYR('1')) <> (TRANRULE1('1') - UPSCLT('1')) and ord(PlanYear_ALTB)>1 then
					  if ord(SO2Region)=1 then
					    ECP_MIN('1')
					  else
					   ECP_MIN('1') + 0.0001
					  endif
					endif
				}
				Comment: "EP$ALLOW,51";
			}
			Parameter ccalc_cBNKSO2_UBOUND {
				IndexDomain: (SO2Region,PlanYear_ALTB) |(CURIYR('1') + UHBSYR('1')) >= TRANRULE1('1');
				Text: "OML Columns: BNK(*)SO2(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: 0;
				Comment: "EP$ALLOW,55";
			}
			Parameter ccalc_cBNKRET0_UBOUND {
				IndexDomain: (SO2Region) | ZYR>0;
				Text: "OML Columns: BNK(*)RET0 and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: max(EMELBNK(first(MNUMYR), SO2Region_SO2ComplyGroup(SO2Region)) * 0.001, 0);
				Comment: "EP$ALLOW,56";
			}
			Parameter ccalc_cBNKRET0_rEXSO2X0le {
				IndexDomain: (SO2Region) | ZYR>0;
				Text: "OML Columns: BNK(*)RET0 and OML Rows: EXSO2X(*)0";
				Definition: -1;
				Comment: "EP$ALLOW,57";
			}
			Parameter ccalc_cBNKXTR_UBOUND {
				IndexDomain: (SO2Region,PlanYear_ALTB) | ZYR>0 and ord(PlanYear_ALTB)>1;
				Text: "OML Columns: BNK(*)XTR(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if PlanYear_ALTB=XYR_Year then
					90000
					endif
				}
				Comment: "EP$ALLOW,58";
			}
			Parameter ccalc_cBNKXTR_rEXSO2X0le {
				IndexDomain: (SO2Region,PlanYear_ALTB) | ZYR>0 and ord(PlanYear_ALTB)>1;
				Text: "OML Columns: BNK(*)XTR(*) and OML Rows: EXSO2X(*)0";
				Definition: 1;
				Comment: "EP$ALLOW,59";
			}
			Parameter ccalc_cBNKXTR_rEUSO2Xle {
				IndexDomain: (SO2Region,PlanYear,PlanYear_ALTB) | ZYR>0 and ord(PlanYear_ALTB)>1;
				Text: "OML Columns: BNK(*)XTR(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1') OR ord(SO2Region)= NUM_SO2_GRP('1')) THEN
					if PlanYear=PlanYear_ALTB-1 then
					1
					elseif PlanYear=PlanYear_ALTB then
					 if (ord(PlanYear_ALTB)<UNXPH('1')) then
					   - 1
					 else
					   -PV_CAP_SO2(SO2Region) / PV_GNP(PlanYear_ALTB)
					 endif
					endif
					ENDIF
				}
				Comment: {
					"EP$ALLOW,60; EP$ALLOW,61"
				}
			}
			Parameter ccalc_cBNKXTR_rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear,PlanYear_ALTB) | ZYR>0 and ord(PlanYear_ALTB)>1;
				Text: "OML Columns: BNK(*)XTR(*) and OML Rows: EUSO2X(*)(*)";
				Definition: {
					IF ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) >=TRANRULE1('1') AND ord(SO2Region)<> NUM_SO2_GRP('1')) THEN
					if PlanYear=PlanYear_ALTB-1 then
					1
					elseif PlanYear=PlanYear_ALTB then
					 if (ord(PlanYear_ALTB)<UNXPH('1')) then
					   - 1
					 else
					   -PV_CAP_SO2(SO2Region) / PV_GNP(PlanYear_ALTB)
					 endif
					endif
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: RHSECP and OML Rows: EUNOX(**)(*)";
				Definition: PV_NOX(NOXRegion, PlanYear);
				Comment: "EP$ALLOW,73";
			}
			Parameter ccalc_cSVNOX_rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: SVNOX(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (0<NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))<9990.0) THEN
					-1
					ENDIF
				}
				Comment: "EP$ALLOW,94";
			}
			Parameter ccalc_cSVNOX_rEUNOXn {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: SVNOX(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))<=0 OR
					NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))>=9990.0) THEN
					-1
					ENDIF
				}
				Comment: "EP$ALLOW,94";
			}
			Parameter ccalc_cSVNOX_ECPCOSTS {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: SVNOX(**)(*) and OML Rows: ECPCOSTS";
				Definition: 2000 * UPGNPD(ModelYear_MNUMYRF(PlanYear));
				Comment: "EP$ALLOW,95";
			}
			Parameter ccalc_cCTLNX_rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1') and PV_NOX_CTL(NOXRegion, PlanYear)>0;
				Text: "OML Columns: CTLNX(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (0<NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))<9990.0) THEN
					1
					ENDIF
				}
				Comment: "EP$ALLOW,96";
			}
			Parameter ccalc_cCTLNX_rEUNOXn {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1') and PV_NOX_CTL(NOXRegion, PlanYear)>0;
				Text: "OML Columns: CTLNX(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))<=0 OR
					NOXBYGRP(NOXRegion, LastModelYear_MNUMYR(PlanYear))>=9990.0) THEN
					1
					ENDIF
				}
			}
			Parameter ccalc_cCTLNX_LBOUND {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1') and PV_NOX_CTL(NOXRegion, PlanYear)>0;
				Text: "OML Columns: CTLNX(**)(*) and OML Rows: LBOUND";
				Definition: PV_NOX_CTL(NOXRegion, PlanYear);
				Comment: "EP$ALLOW,97";
			}
			Parameter ccalc_cCTLNX_UBOUND {
				IndexDomain: (NOXRegion,PlanYear) | ord(PlanYear)>NOX_LT('1') and PV_NOX_CTL(NOXRegion, PlanYear)>0;
				Text: "OML Columns: CTLNX(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: PV_NOX_CTL(NOXRegion, PlanYear);
				Comment: "EP$ALLOW,97";
			}
		}
		DeclarationSection EP_BDGN_Completed {
			Parameter PVV_NWSOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					SUM(FullPlanningHorizon,(NWSOM(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter NWSOM1 {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon) | ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					                                        IF (AIMMS_GRP(PlantType) = AIDG('1') AND (ORD(PlanYear) + UPPLYR(PlantType) <= UNXPH('1')) ) THEN
					
					                                        IF ((UPGSUB(PlantType) > 0.0 AND (ORD(cyr) + ORD(PlanYear) + UPPLYR(PlantType) - 1) > (UPGSY1(PlantType) - UHBSYR('1'))
					                                           AND (ORD(cyr) + ORD(PlanYear) + UPPLYR(PlantType) - 1) <= UPGSYL(PlantType)-UHBSYR('1')) OR
					UPGSUBPT(PlantType) > 0) THEN
					                                        	IF(ORD(FullPlanningHorizon) <= UPGSYR(PlantType)) THEN
					                                        	         IF (UPGSUBPT(PlantType) <= 0) THEN
					          UPGSUB(PlantType) * 8.76 * UPMCF(PlantType)
					       ELSE
					        UPGSUBYR(PlantType,element(MNUMYR_,MIN(UNYEAR('1'),ORD(FullPlanningHorizon)+ORD(CYR)+ORD(PlanYear) + UPPLYR(PlantType)-2)))  * 8.76 * UPMCF(PlantType)
					       ENDIF
					
					                                        	ELSE
					                                        		0.0
					                                        	ENDIF
					
					                                        ENDIF
					
					                                        ENDIF
					                                        /*
					                                        !                 CHECK IF PTC IS CAPPED
					
					        IF (UPGSMX(IECP) .GT. 0)SOM(JYR) = MIN(SOM(JYR),UPGSMX(IECP))
					
					                                        !                 IF PTC IS REAL, THEN APPLY DEFLATOR
					
					        IF (UPGSTY(IECP) .LE. 0)SOM(JYR) = SOM(JYR) * UPGNPD(JYR + CURIYR + OLYR - 2)
					
					                                        !                 ADJUST FOR TAX BENEFIT
					
					        SOM(JYR) = SOM(JYR) / (1.0 - UPTXRT)
					                                        */
				}
			}
			Parameter NWSOM2 {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon);
				Definition: {
					IF (UPGSMX(PlantType) > 0) THEN
					      MIN(NWSOM1(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon),UPGSMX(PlantType))
					ELSE
					      NWSOM1(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon)
					ENDIF
				}
			}
			Parameter NWSOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon);
				Definition: {
					IF (UPGSTY(PlantType) <= 0) THEN
					      NWSOM2(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon)
					      * UPGNPD(element(MNUMYRF_,ORD(FullPlanningHorizon)+ORD(CYR)+ORD(PlanYear) + UPPLYR(PlantType)-2)) / (1.0 - UPTXRT('1'))
					ELSE
					      NWSOM2(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon)/ (1.0 - UPTXRT('1'))
					ENDIF
				}
			}
			Parameter NWDG_SOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					    PVV_NWSOM(PlantType,SupplyRegion,PlanYear) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear) + UPPLYR(PlantType)-1)
					 ENDIF
				}
			}
			Parameter PVV_NWPRM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					SUM(FullPlanningHorizon,(NWPRM(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter NWPRM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1') AND (ORD(PlanYear) + UPPLYR(PlantType) <= UNXPH('1')) ) THEN
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - (ORD(PlanYear) + UPPLYR(PlantType)) + 1) )  THEN
					 (PNGELGR(element(GasRegion_,UPNGRG(SupplyRegion)),cyr) - OGWPRNG(element(OGSMReg_,card(OGSMReg)),cyr)/CFNGU(cyr) + UPDGFPR('1'))
					    * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + (ORD(PlanYear) + UPPLYR(PlantType)) - 2))
					
					ELSE
					    0.0
					ENDIF
					
					ENDIF
				}
			}
			Parameter NWDG_PRM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					    PVV_NWPRM(PlantType,SupplyRegion,PlanYear) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear) + UPPLYR(PlantType)-1)
					 ENDIF
				}
			}
			Parameter NWDG_FUEL {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion)),SupplyRegion,ExplicitPlanningHorizon_element(PlanYear)) *
					NWDG_PRM(PlantType,SupplyRegion,PlanYear)
				}
			}
			Parameter PVV_NWVOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					SUM(FullPlanningHorizon,(NWVOM(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter NWVOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon);
				Definition: {
					                                      IF (AIMMS_GRP(PlantType) = AIDG('1') AND (ORD(PlanYear) + UPPLYR(PlantType) <= UNXPH('1')) ) THEN
					                                      IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - (ORD(PlanYear) + UPPLYR(PlantType)) + 1) )  THEN
					                                          (EPVOM(PlantType,SupplyRegion,cyr) * 1000.0)*
					UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + (ORD(PlanYear) + UPPLYR(PlantType)) - 2))
					                                      ELSE
					                                          0.0
					                                      ENDIF
					
					                                      ENDIF
				}
			}
			Parameter NWDG_VOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					    PVV_NWVOM(PlantType,SupplyRegion,PlanYear) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear) + UPPLYR(PlantType)-1)
					 ENDIF
				}
			}
			Parameter PVV_NWFOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					SUM(FullPlanningHorizon,(NWFOM(PlantType,SupplyRegion,PlanYear,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter NWFOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear,FullPlanningHorizon);
				Definition: {
					                                      IF (AIMMS_GRP(PlantType) = AIDG('1') AND (ORD(PlanYear) + UPPLYR(PlantType) <= UNXPH('1')) ) THEN
					                                      IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - (ORD(PlanYear) + UPPLYR(PlantType)) + 1) )  THEN
					                                          (EPFOM(PlantType,SupplyRegion,cyr) + EPCFOM(PlantType,SupplyRegion,cyr))*
					UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + (ORD(PlanYear) + UPPLYR(PlantType)) - 2))
					                                      ELSE
					                                          0.0
					                                      ENDIF
					
					                                      ENDIF
				}
			}
			Parameter NWDG_FOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					    PVV_NWFOM(PlantType,SupplyRegion,PlanYear) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear) + UPPLYR(PlantType)-1)
					 ENDIF
				}
			}
			Parameter EXPRM {
				IndexDomain: (PlantType,SupplyRegion,FullPlanningHorizon)|ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1) )  THEN
					    (PNGELGR(element(GasRegion_,UPNGRG(SupplyRegion)),cyr) - OGWPRNG(element(OGSMReg_,card(OGSMReg)),cyr)/CFNGU(cyr) + UPDGFPR('1'))
					    * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + UNXPH('1') - 2))
					ELSE
					    0.0
					ENDIF
					ENDIF
				}
			}
			Parameter PVV_EXPRM {
				IndexDomain: (PlantType,SupplyRegion)|ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					SUM(FullPlanningHorizon,(EXPRM(PlantType,SupplyRegion,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter EXDG_PRM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear)|ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					
					IF (ORD(PlanYear) < UNXPH('1'))THEN
					   (PNGELGR(element(GasRegion_,UPNGRG(SupplyRegion)),cyr) - OGWPRNG(element(OGSMReg_,card(OGSMReg)),cyr)/CFNGU(cyr) + UPDGFPR('1'))
					              * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(PlanYear) - 1)) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(PlanYear)
					ELSE
						     PVV_EXPRM(PlantType,SupplyRegion) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear)-1)
					ENDIF
					ENDIF
				}
			}
			Parameter EXVOM {
				IndexDomain: (PlantType,SupplyRegion,FullPlanningHorizon);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1) )  THEN
					    EPVOM(PlantType,SupplyRegion,cyr) * 1000.0 * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + UNXPH('1') - 2))
					ELSE
					    0.0
					ENDIF
					ENDIF
				}
			}
			Parameter PVV_EXVOM {
				IndexDomain: (PlantType,SupplyRegion);
				Definition: {
					SUM(FullPlanningHorizon,(EXVOM(PlantType,SupplyRegion,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter EXDG_VOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					
					IF (ORD(PlanYear) < UNXPH('1'))THEN
					            EPVOM(PlantType,SupplyRegion,cyr) *1000.0 * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(PlanYear) - 1))
					           / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(PlanYear)
					ELSE
						     PVV_EXVOM(PlantType,SupplyRegion) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear)-1)
					ENDIF
					ENDIF
				}
			}
			Parameter EXFOM {
				IndexDomain: (PlantType,SupplyRegion,FullPlanningHorizon);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					IF (ORD(FullPlanningHorizon) <= (UNFPH('1') - UNXPH('1') + 1) )  THEN
					    EPFOM(PlantType,SupplyRegion,cyr) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) + UNXPH('1') - 2))
					ELSE
					    0.0
					ENDIF
					ENDIF
				}
			}
			Parameter PVV_EXFOM {
				IndexDomain: (PlantType,SupplyRegion);
				Definition: {
					SUM(FullPlanningHorizon,(EXFOM(PlantType,SupplyRegion,FullPlanningHorizon) )/
					(1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon) )
				}
			}
			Parameter EXDG_FOM {
				IndexDomain: (PlantType,SupplyRegion,PlanYear);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					
					IF (ORD(PlanYear) < UNXPH('1'))THEN
					            EPFOM(PlantType,SupplyRegion,cyr) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(PlanYear) - 1))
					           / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(PlanYear)
					ELSE
						     PVV_EXFOM(PlantType,SupplyRegion) / (1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ (ORD(PlanYear)-1)
					ENDIF
					ENDIF
				}
			}
			Parameter BDGFOM {
				IndexDomain: (PlantType,FullPlanningHorizon,PlanYear);
			}
			Parameter DGNGEN {
				IndexDomain: (PlantType,PlanYear,SupplyRegion);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
					Sum(SliceGroup,
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion),
					          VLSSeason_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion),PlanYear,SupplyRegion) *
					          EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion,cyr ) )
					ENDIF
				}
			}
			Parameter ADJDGN {
				IndexDomain: (PlantType,OperatingMode,Season,PlanYear,SupplyRegion)| ORD(OperatingMode) <= NSTP(Season,SupplyRegion) AND ORD(SupplyRegion) <= UNRGNS('1') AND ORD(Season) <= EPNMSP('1',SupplyRegion,cyr);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						IF (CapacityFactor(SlicePerSeason_element(OperatingMode),Season,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion) <= UPMCF(PlantType)) THEN
							IF (CapacityFactor(SlicePerSeason_element(OperatingMode+1),Season,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion) <= UPMCF(PlantType)) THEN
								1.0
							ELSE
								(UPMCF(PlantType) - CapacityFactor(SlicePerSeason_element(OperatingMode),Season,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion)) /
								    (CapacityFactor(SlicePerSeason_element(OperatingMode+1),Season,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion) - CapacityFactor(SlicePerSeason_element(OperatingMode),Season,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion))
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter DERATE_DGN {
				IndexDomain: PlantType | AIMMS_GRP(PlantType) = AIDG('1');
				Definition: 1.0 - UPFORT(PlantType);
			}
			Parameter TST_NOX {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Definition: {
					if  ord(PlanYear)>NOX_LT('1') then
					if PlantType in DistributedGenType_ and sum(PlanYear_ALTB,Condition_BDGN_NOX(PlantType, PlanYear, PlanYear_ALTB)) then
					1
					elseif PlantType in DSP_Types_ and sum((SupplyRegion_SUB, OperatingMode, Season),
					Condition_ODSP_ALT(SupplyRegion_SUB, PlantType, PlanYear, OperatingMode, Season)) then
					1
					elseif PlantType in OtherRenewable_ and sum(SupplyRegion_SUB, Condition_ORNW_NoHydro(PlantType, SupplyRegion_SUB, PlanYear)) then
					1
					endif
					endif
				}
			}
			Parameter Condition_BDGN_NOX {
				IndexDomain: (DistributedGenType,PlanYear,PlanYear_ALTB);
				Definition: {
					if OLYEAR(PlanYear_ALTB, DistributedGenType) <= UNXPH('1') AND UPAVLYR(DistributedGenType)<= FULLYEAR_ALT(PlanYear_ALTB, DistributedGenType) AND
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, DistributedGenType) then
					1
					endif
				}
			}
			Parameter ccalc_cBX_DGN_rRUYYYYYn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) |PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: RUYYYYY(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN   !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALTX = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rTOTBLDn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: TOTBLD(*)(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rLDGXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,DistGenAvoidStep,PlanYear,PlantType,OwnerType,PlanYear_ALTB) |PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: L(*)DGXX(*)(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) > 0) THEN
						IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
					Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) )
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) > 0) THEN
						IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
							DGNGEN(PlantType,PlanYear,SupplyRegion_ALT1) / 1000.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SliceGroup, ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) )
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB AND ORD(PlanYear) > UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1') AND SupplyRegion_ALTX = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						1.0
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rRXXXXXn {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB AND ORD(PlanYear) <= UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1') AND SupplyRegion_ALTX = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						1.0
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rTOTCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: TOTCAP(*)(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						1.0
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB)| PlanYear = PlanYear_ALTB
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						DGNGEN(PlantType,PlanYear,SupplyRegion_ALT1) / 1000.0
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: LBOUND"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						EPECAP0(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) * 0.001
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						EPECAP0(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) * 0.001
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rFUELNGXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) |PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: FUELNGX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 15 ) THEN
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB))
					ENDIF
					endif
				}
			}
			Parameter ccalc_cBX_DGN_rEUCARXXn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) | PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and CarbonNationalCap(PlanYear) = 0
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rEUCARXXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and CarbonNationalCap(PlanYear) = 1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND
					CarbonRegionCap(CarbonRegion,PlanYear) = 1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rEUCARn {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND CarbonRegionCap(CarbonRegion,PlanYear) = 0
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rEUCARXXn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB AND ORD(SupplyRegion_ALT1) <= UNRGNS('1') AND
					CarbonNationalCap(PlanYear) = 0
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					 AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					  ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
				}
			}
			Parameter ccalc_cEXXX_DGN_rEUCARXXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB AND ORD(SupplyRegion_ALT1) <= UNRGNS('1') AND
					CarbonNationalCap(PlanYear) = 1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					 AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					  ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
				}
			}
			Parameter ccalc_cEXXX_DGN_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) |PlanYear = PlanYear_ALTB AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND CarbonRegionCap(CarbonRegion,PlanYear) = 1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					  ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
				}
			}
			Parameter ccalc_cEXXX_DGN_rEUCARn {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)|PlanYear = PlanYear_ALTB AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND CarbonRegionCap(CarbonRegion,PlanYear) = 0
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					  ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
				}
			}
			Parameter ccalc_cEXXX_DGN_rFUELOLXle {
				IndexDomain: (PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB;
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: FUELOLX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 14 ) THEN
					   (0.000001) * DGNGEN(PlantType,PlanYear,SupplyRegion_ALT1) *
					   AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rFUELNGXle {
				IndexDomain: (PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB;
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: FUELNGX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 15 ) THEN
					   (0.000001) * DGNGEN(PlantType,PlanYear,SupplyRegion_ALT1) *
					   AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					IF (Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) ) > 0.0) THEN
					
					       SR_CREDIT(PlantType) * (1.0 -
					       Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) ))
					ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cEXXX_DGN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB);
				Text: {
					"OML Columns: E(*)(**)XXX(*)!DGN and OML Rows: ECPCOSTS"
				}
				Definition: {
					EXDG_FOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) +
					(AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB))
					* EXDG_PRM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) + EXDG_VOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) )
					* DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) * 0.000001
				}
			}
			Parameter ccalc_cBX_DGN_rLUBLDXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and PlantType in DistributedGenType_ and PlantType_ALT2=PlantType
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: LU(**)BLDX"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
					!	IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
						IF (Subsidy_Case(PlanYear_ALTB, PlantType) >0) THEN
							IF (UPBLDREG(PlantType,element(SupplyRegion_,card(SupplyRegion_ALT1))) > 0.0 AND UPBLDREG(PlantType,element(SupplyRegion_,card(SupplyRegion_ALT1))) < 999.0)THEN
					   			1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rLBLDXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and PlantType in DistributedGenType_ and PlantType_ALT2=PlantType
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: L(*)(**)BLDX"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (UPBLDREG(PlantType,SupplyRegion_ALT1) > 0.0 AND UPBLDREG(PlantType,SupplyRegion_ALT1) < 999.0)THEN
					   			1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPRNWRGN(SupplyRegion_ALT1) = ORD(RPSRegion)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					 IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
							IF (UPRNWSHRR(PlantType,SupplyRegion_ALT1) > 0) THEN
					 			UPRNWSHRR(PlantType,SupplyRegion_ALT1) * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1)/1000.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					           IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) > 0) THEN
					           IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
					           	IF (Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					                      EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					                      DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					                      Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) )) > 0.0 THEN
					
					           	SR_CREDIT(PlantType) * (1.0 -
					           Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					                      EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					                      DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					                      Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) ) )
					           	ENDIF
					           ENDIF
					           ENDIF
					
					
					             /*
					IF (SR_CREDIT(IECP) .GT. 0.0) THEN
					   ROW_SR = 'R'//UPRGCD(NERC)//'SR'//UPLDCD(ISP)//UPRGCD(IGRP)//UPRGCD(ISEG)//UPYRCD(JYR); call makmsk(ROW_SR_mask,':R:',UPRGCD(NERC),':SR:',UPLDCD(ISP),UPRGCD(IGRP),UPRGCD(ISEG),UPYRCD(JYR))
					   VALUE = SR_CREDIT(IECP) * (1.0 - (DERATE(VLS,ISP) * ADJ(JVLS)))
					   IF (USW_DIGIT .GT. 0)VALUE = DIGITS2( VALUE , DIGITS_PARM)
					   IF (VALUE .NE. 0.0) CALL CVAL(COLUMN,ROW_SR,VALUE,COLUMN_mask,ROW_SR_mask,'EP$BDGN,19')
					END IF
					           */
				}
			}
			Parameter ccalc_cBX_DGN_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALTY = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					 IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					             IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWSHR(PlantType) > 0.0) THEN
					             	UPRNWSHR(PlantType) * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1)/1000.0
					             ENDIF
					        ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cBX_DGN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) |ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)AND ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: ECPCOSTS"
				}
				Definition: {
					!                    IF (UPDGAVR('1') > 0.0) THEN
					!                    	IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) >0) THEN
					!
					!
					!                                        OBJVAL_X_dll(SupplyRegion_ALT1,PlantType,element(ExplicitPlanningHorizon_,ORD(PlanYear_ALTB)),OwnerType,DistGenAvoidStep) +
					!                                        NWDG_FOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) + !PV$EXT
					!                                         (NWDG_FUEL(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) + NWDG_VOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) )
					!                                        * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) * 0.000001
					!
					!                    	ENDIF
					!                    ENDIF
					
					                                        /* PV$EXT calculation not converted, exists but not used in FORTRAN  */
				}
			}
			Parameter ccalc_cBSDGN_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
							DGNGEN(PlantType,PlanYear,SupplyRegion_ALT1) / 1000.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
					Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) )
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rLUSUBXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and ORD(PlantType_ALT2) = ORD(PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: LU(**)SUBX"
				}
				Definition: {
					IF (AIMMS_GRP(PlantType) = AIDG('1') AND UPSUBCAS(PlantType) > 0 AND BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
					IF (LIMSUB_calc(PlantType) > 0.0 AND UPSUBLIM(PlantType) < 999.0) THEN
					1.0
					ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rRUYYYYYn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: RUYYYYY(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN   !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALTX = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rTOTBLDn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: TOTBLD(*)(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rEUCARXXn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)and CarbonNationalCap(PlanYear) = 0
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rEUCARXXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)and CarbonNationalCap(PlanYear) = 1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: EUCARXX(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rEUCARle {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND
					CarbonRegionCap(CarbonRegion,PlanYear) = 1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rEUCARn {
				IndexDomain: {
					(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPCARG(SupplyRegion_ALT1) = ORD(CarbonRegion) AND CarbonRegionCap(CarbonRegion,PlanYear) = 0
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: EUCAR(**)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					  .000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					    AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					     ENGEL(cyr) * 0.001 * (1.0 - UPDCEF(PlantType))
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rFUELNGXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: FUELNGX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 15 ) THEN
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB))
					ENDIF
					endif
				}
			}
			Parameter ccalc_cBSDGN_rLDGXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,DistGenAvoidStep,PlanYear,PlantType,OwnerType,PlanYear_ALTB)|PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: L(*)DGXX(*)(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
							IF (AIMMS_GRP(PlantType) = AIDG('1') ) THEN  !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
								1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rLUBLDXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and PlantType in DistributedGenType_ and PlantType_ALT2=PlantType
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: LU(**)BLDX"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
					!	IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
					        IF (Subsidy_Case(PlanYear_ALTB, PlantType) =2) THEN
							IF (UPBLDREG(PlantType,element(SupplyRegion_,card(SupplyRegion_ALT1))) > 0.0 AND UPBLDREG(PlantType,element(SupplyRegion_,card(SupplyRegion_ALT1))) < 999.0)THEN
					   			1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rLBLDXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and PlantType in DistributedGenType_ and PlantType_ALT2=PlantType
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: L(*)(**)BLDX"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
					!	IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
						IF (Subsidy_Case(PlanYear_ALTB, PlantType) =2) THEN
							IF (UPBLDREG(PlantType,SupplyRegion_ALT1) > 0.0 AND UPBLDREG(PlantType,SupplyRegion_ALT1) < 999.0)THEN
					   			1.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND UPRNWRGN(SupplyRegion_ALT1) = ORD(RPSRegion)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) =2) THEN
							IF (UPRNWSHRR(PlantType,SupplyRegion_ALT1) > 0) THEN
					 			UPRNWSHRR(PlantType,SupplyRegion_ALT1) * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1)/1000.0
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
					IF (AIMMS_GRP(PlantType) = AIDG('1')) THEN
						IF (Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) )) > 0.0 THEN
					
						SR_CREDIT(PlantType) * (1.0 -
					Sum(SliceGroup|EPLDGR(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadGroup) AND
					           EPLDSG(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) = ORD(LoadSegment),
					           DERATE_DGN(PlantType) * ADJDGN(PlantType,VLSMode_element(SLiceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),
					           Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear,SupplyRegion_ALT1) ) )
						ENDIF
					ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSDGN_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALTY = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (UPDGAVR('1') > 0.0) THEN
						IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
					             IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWSHR(PlantType) > 0.0) THEN
					             	UPRNWSHR(PlantType) * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1)/1000.0
					             ENDIF
					        ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cBSDGN_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB)|ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)AND ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: ECPCOSTS"
				}
				Definition: {
					!IF (UPDGAVR('1') > 0.0) THEN
					!	IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
					!                    OBJVAL_S_dll(SupplyRegion_ALT1,PlantType,element(ExplicitPlanningHorizon_,ORD(PlanYear_ALTB)),OwnerType,DistGenAvoidStep) +
					!                    NWDG_FOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB)  - NWDG_SOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) + !PV$EXT
					!                     (NWDG_FUEL(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) + NWDG_VOM(PlantType,SupplyRegion_ALT1,PlanYear_ALTB) )
					!                    * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) * 0.000001
					!	ENDIF
					!ENDIF
					!                    /* PV$EXT calculation not converted, exists but not used in FORTRAN  */
				}
			}
			Parameter ccalc_cBX_DGN_rEUNle {
				IndexDomain: {
					(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB) | PlantType in DistributedGenType_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: EUN(**)(**)(*)"
				}
				Definition: {
					if ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and ord(PlanYear)>NOX_LT('1') then
					(0.0000005 * DGNGEN(PlantType, PlanYear_ALTB, SupplyRegion_ALT1) *
					AVG_HTRT(PlantType, FuelRegion0, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					EPNOX_G(element(Season_,EPNMSP('1', SupplyRegion_ALT1, cyr)), ExplicitPlanningHorizon_element(PlanYear), PlantType, NOXRegion, SupplyRegion_ALT1, cyr)) $
					(0.0000005 * DGNGEN(PlantType, PlanYear_ALTB, SupplyRegion_ALT1) *
					AVG_HTRT(PlantType, FuelRegion0, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					EPNOX_G(element(Season_,EPNMSP('1', SupplyRegion_ALT1, cyr)), ExplicitPlanningHorizon_element(PlanYear), PlantType, NOXRegion, SupplyRegion_ALT1, cyr))
					endif
				}
				Comment: "EP$BDGN,20";
			}
			Parameter ccalc_cBSDGN_rEUNle {
				IndexDomain: {
					(PlantType,NOXRegion,PlanYear,SupplyRegion_ALT1,OwnerType,DistGenAvoidStep,PlanYear_ALTB) | PlantType in DistributedGenType_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: EUN(**)(**)(*)"
				}
				Definition: {
					if ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and ord(PlanYear)>NOX_LT('1') then
					(0.0000005 * DGNGEN(PlantType, PlanYear_ALTB, SupplyRegion_ALT1) *
					AVG_HTRT(PlantType, FuelRegion0, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					EPNOX_G(element(Season_,EPNMSP('1', SupplyRegion_ALT1, cyr)), ExplicitPlanningHorizon_element(PlanYear), PlantType, NOXRegion, SupplyRegion_ALT1, cyr)) $
					(0.0000005 * DGNGEN(PlantType, PlanYear_ALTB, SupplyRegion_ALT1) *
					AVG_HTRT(PlantType, FuelRegion0, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
					EPNOX_G(element(Season_,EPNMSP('1', SupplyRegion_ALT1, cyr)), ExplicitPlanningHorizon_element(PlanYear), PlantType, NOXRegion, SupplyRegion_ALT1, cyr))
					endif
				}
				Comment: "EP$BDGN,20";
			}
			Parameter ccalc_cBSDGN_rFUELOLXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) | PlantType in DistributedGenType_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					Subsidy_Case(PlanYear_ALTB, PlantType) =2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!DGN and OML Rows: FUELOLX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 14 ) THEN
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB))
					endif
				}
				Comment: "EP$BDGN,34";
			}
			Parameter ccalc_cBX_DGN_rFUELOLXle {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) | PlantType in DistributedGenType_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND
					(UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)X(*)(*)!DGN and OML Rows: FUELOLX(*)"
				}
				Definition: {
					IF (UDFLTP(element(DispatchableECP_,UCPDGNIS(PlantType)),'1') = 14 ) THEN
					.000001 * DGNGEN(PlantType,PlanYear_ALTB,SupplyRegion_ALT1) *
					AVG_HTRT(PlantType,element(FuelRegion_,MapFuelRegion(PlantType,SupplyRegion_ALT1)),SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB))
					endif
				}
				Comment: "EP$BDGN,34";
			}
			Parameter ccalc_cEUN_rEUNle {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Text: "OML Columns: EUN(**)(**)(*) and OML Rows: EUN(**)(**)(*)";
				Definition: {
					if TST_NOX(PlantType, NOXRegion, PlanYear)>0 and ord(PlanYear)>NOX_LT('1') then
					-1
					endif
				}
				Comment: {
					"EP$BDGN,44; EP$ODSP,150; EP$ORNW,150;"
				}
			}
			Parameter ccalc_cEUN_rEUNOXle {
				IndexDomain: (NOXRegion,PlanYear,PlantType) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: EUN(**)(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))>0 AND NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))< 9990.0) THEN
					if TST_NOX(PlantType, NOXRegion, PlanYear)>0 then
					1
					endif
					endif
				}
				Comment: {
					"EP$BDGN,45; EP$ODSP,151; EP$ORNW,151;"
				}
			}
			Parameter ccalc_cEUN_rEUNOXn {
				IndexDomain: (NOXRegion,PlanYear,PlantType) | ord(PlanYear)>NOX_LT('1');
				Text: "OML Columns: EUN(**)(**)(*) and OML Rows: EUNOX(**)(*)";
				Definition: {
					IF (NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))<=0 or NOXBYGRP(NOXRegion, LastModelYear_MNUMYR4(PlanYear))>= 9990.0) THEN
					if TST_NOX(PlantType, NOXRegion, PlanYear)>0 then
					1
					endif
					endif
				}
				Comment: {
					"EP$BDGN,45; EP$ODSP,151; EP$ORNW,151;"
				}
			}
			Parameter ccalc_cEUN_ECPCOSTS {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Text: "OML Columns: EUN(**)(**)(*) and OML Rows: ECPCOSTS";
				Definition: {
					if TST_NOX(PlantType, NOXRegion, PlanYear)>0 and ord(PlanYear)>NOX_LT('1') then
					ECP_MIN('1')
					endif
				}
				Comment: {
					"EP$BDGN,46; EP$ODSP,152; EP$ORNW,152;"
				}
			}
		}
		DeclarationSection EP_BDSP_Completed {
			Parameter BNDROW_EXX0 {
				IndexDomain: {
					(SupplyRegion,PlantType,RetireGroup,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					USW_ERET('1')=1 and ord(PlanYear)>UPRTLT('1') then
					sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'),  EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr) * 0.001)
					endif
				}
			}
			Parameter BNDROW_EXXX {
				IndexDomain: {
					(SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>EX_COAL('1') then
					if (UPVTYP(PlantType)=1 and UPTTYP(PlantType)>NW_COAL('1')) then
					max( ECP_MIN('1'), sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), ( EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
					EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)) * 0.001) -
					if ord(PlanYear)>UPRTLT('1') then
					sum((FuelRegion, RetireGroup) |ord(FuelRegion)<=UNFRGN('1'), EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr) * 0.001)
					endif)
					elseif (UPVTYP(PlantType)=1) then !new coal plant types, set to minimum default value
					  ECP_MIN('1')
					else
					( sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), (round(EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr),4) -
					round(EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr),4)) * 0.001) -
					if ord(PlanYear)>UPRTLT('1') then
					sum((FuelRegion, RetireGroup) |ord(FuelRegion)<=UNFRGN('1'), round(EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr),4) * 0.001)
					endif) $
					(( sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), (EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
					EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)) * 0.001) -
					if ord(PlanYear)>UPRTLT('1') then
					sum((FuelRegion, RetireGroup) |ord(FuelRegion)<=UNFRGN('1'), EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr) * 0.001)
					endif)> ECP_MIN('1')*0.01)
					
					endif
					endif
				}
			}
			Parameter TMP_CAP_EXXX {
				IndexDomain: {
					(FuelRegion,SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>NW_COAL('1') then
						(EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
						EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)) * 0.001 -
						if ord(PlanYear)>UPRTLT('1') then
							sum( RetireGroup, EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr) * 0.001)
						endif
					endif
				}
			}
			Parameter BNDROW_MR {
				IndexDomain: {
					(SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>EX_COAL('1') then
					sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) * 0.001)
					endif
				}
			}
			Parameter TMP_CAP_MR {
				IndexDomain: {
					(FuelRegion,SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>NW_COAL('1') then
					EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) * 0.001
					endif
				}
			}
			Parameter FOM_EXX0_DSP {
				IndexDomain: {
					(RetireGroup, DispatchableECP, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(DispatchableECP)<>AINU('1') and
					DispatchableECP<>WIEC_Element AND DispatchableECP<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, DispatchableECP, RetirementYear, SupplyRegion, cyr)>0 OR WPTTYP(DispatchableECP, SupplyRegion)>0) and UPTTYP(DispatchableECP)>NW_COAL('1') and
					USW_ERET('1')=1 and BNDROW_EXX0(SupplyRegion, DispatchableECP, RetireGroup,RetirementPlanYear)>0 then
					if ord(FullPlanningHorizon)=1 then
					0
					else
					EPGFOM(RetireGroup, DispatchableECP, SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
				}
			}
			Parameter FOM_EXXX_DSP {
				IndexDomain: {
					(DispatchableECP, SupplyRegion, FullPlanningHorizon) | ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(DispatchableECP)<>AINU('1') and
					DispatchableECP<>WIEC_Element AND DispatchableECP<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, DispatchableECP, Explicit2FullPlanningHorizon(FullPlanningHorizon), SupplyRegion, cyr)>0 OR WPTTYP(DispatchableECP, SupplyRegion)>0) and
					UPTTYP(DispatchableECP)>EX_COAL('1') then
					if ord(FullPlanningHorizon)=1 then
					0
					else
					EPFOM(DispatchableECP, SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
				}
			}
			Parameter SHR_FLRG_EXX0_DSP {
				IndexDomain: {
					(FuelRegion, RetireGroup, PlantType, SupplyRegion,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and
					ord(FuelRegion)<=UNFRGN('1') and AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR WPTTYP(PlantType, SupplyRegion)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					USW_ERET('1')=1 and BNDROW_EXX0(SupplyRegion, PlantType, RetireGroup, PlanYear) and EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion, cyr)>0 then
					IF ((FRG_EMM_MAP(SupplyRegion, FuelRegion)>0 AND UPVTYP(PlantType)=0) OR (FL_CNXT_CST(SupplyRegion, FuelRegion)>0 AND UPVTYP(PlantType)=1) OR
					EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr)>0) THEN
					if UPVTYP(PlantType)=1 then
					max(1, EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr))
					else
					EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr)
					endif
					endif
					endif
				}
			}
			Parameter TOT_FLRG_EXX0_DSP {
				IndexDomain: {
					(RetireGroup, PlantType, SupplyRegion,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and
					AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Definition: sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_EXX0_DSP(FuelRegion, RetireGroup, PlantType, SupplyRegion, PlanYear));
			}
			Parameter SHR_FLRG_EXXX_DSP {
				IndexDomain: {
					(FuelRegion,SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Definition: {
					IF (BNDROW_EXXX(SupplyRegion, PlantType, PlanYear) > ECP_MIN('1') OR (BNDROW_EXXX(SupplyRegion, PlantType, PlanYear) > 0 AND UPVTYP(PlantType)= 0)) THEN
						IF ((FRG_EMM_MAP(SupplyRegion, FuelRegion)> 0 AND UPVTYP(PlantType)=0) OR (FL_CNXT_CST(SupplyRegion, FuelRegion)>0 AND UPVTYP(PlantType)= 1) OR
							TMP_CAP_EXXX(FuelRegion, SupplyRegion, PlantType, PlanYear)> 0) THEN
							if UPVTYP(PlantType)= 1 then
							max(1, TMP_CAP_EXXX(FuelRegion, SupplyRegion, PlantType, PlanYear))
							else
							TMP_CAP_EXXX(FuelRegion, SupplyRegion, PlantType, PlanYear)
							endif
						endif
					elseif BNDROW_EXXX(SupplyRegion, PlantType, PlanYear) = ECP_MIN('1') and FL_CNXT_CST(SupplyRegion, FuelRegion)>0 then
						ECP_MIN('1')
					endif
				}
			}
			Parameter TOT_FLRG_EXXX_DSP {
				IndexDomain: {
					(SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Definition: sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_EXXX_DSP(FuelRegion, SupplyRegion, PlantType, PlanYear));
			}
			Parameter SHR_FLRG_MR_DSP {
				IndexDomain: {
					(FuelRegion,SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Definition: {
					IF (BNDROW_MR(SupplyRegion, PlantType, PlanYear) > 0 AND TMP_CAP_MR(FuelRegion, SupplyRegion, PlantType, PlanYear)> 0) THEN
					max(0.0001, TMP_CAP_MR(FuelRegion, SupplyRegion, PlantType, PlanYear))
					endif
				}
			}
			Parameter TOT_FLRG_MR_DSP {
				IndexDomain: {
					(SupplyRegion,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Definition: sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_MR_DSP(FuelRegion, SupplyRegion, PlantType, PlanYear));
			}
			Parameter ccalc_cEXX0_DSP_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					!IF (EPECAP(FuelRegion0, PlantType, YearINT, SupplyRegion_ALT1, cyr)>0 OR WPTTYP(PlantType, SupplyRegion_ALT1)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					!USW_ERET('1')=1 and
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup,RetirementPlanYear)>0 then
					BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup,RetirementPlanYear)
					else
					inf
					endif
				}
				Comment: "EP$BDSP,5";
			}
			Parameter ccalc_cEXX0_DSP_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: ECPCOSTS";
				Definition: {
					!IF (EPECAP(FuelRegion0, PlantType, YearINT, SupplyRegion_ALT1, cyr)>0 OR WPTTYP(PlantType, SupplyRegion_ALT1)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					!USW_ERET('1')=1 and
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup,RetirementPlanYear)>0 then
					max(ECP_MIN('1'),
					(sum(FullPlanningHorizon, !PVV_Function(FOM_EXX0_DSP(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXX0_DSP(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					sum(PlanYear| PlanYear=RetirementPlanYear, PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear)) - (ord(RetireGroup)-1))*
					(1.0 - UPRETFHU('1')))
					endif
				}
				Comment: "EP$BDSP,8";
			}
			Parameter ccalc_cEXX0_DSP_rCXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and
					ord(FuelRegion_ALT1)<=UNFRGN('1') and AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element and PlantType=PlantType_ALT2
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: C(*)(**)X(*)(*)(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR WPTTYP(PlantType, SupplyRegion_ALT1)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					USW_ERET('1')=1 and BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, PlanYear) and
					ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr) then
					-max(0, EP_SP_CAP_FAC(Season, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) *
					SHR_FLRG_EXX0_DSP(FuelRegion_ALT1, RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear) / $
					TOT_FLRG_EXX0_DSP(RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear))
					endif
				}
				Comment: "EP$BDSP,12";
			}
			Parameter ccalc_cEXX0_DSP_rMXXge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and
					ord(FuelRegion_ALT1)<=UNFRGN('1') and AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element and PlantType=PlantType_ALT2
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: M(*)(**)X(*)X(*)";
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR WPTTYP(PlantType, SupplyRegion_ALT1)>0) and UPTTYP(PlantType)>NW_COAL('1') and
					USW_ERET('1')=1 and BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, PlanYear)>0 then
					IF (MUSTRUN(PlantType, SupplyRegion_ALT1)> 0) THEN
					-8.760 * UPPMRT(PlantType) * (1.0 - UPFORT(PlantType)) * SHR_FLRG_EXX0_DSP(FuelRegion_ALT1, RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear) / $
					TOT_FLRG_EXX0_DSP(RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear)
					ELSE
					-8.760 * UPPMRT(PlantType) * SHR_FLRG_EXX0_DSP(FuelRegion_ALT1, RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear) / $
					TOT_FLRG_EXX0_DSP(RetireGroup, PlantType, SupplyRegion_ALT1, PlanYear)
					ENDIF
					endif
				}
				Comment: "EP$BDSP,15";
			}
			Parameter ccalc_cEXX0_DSP_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and
					AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element and SupplyRegion_ALTX=SupplyRegion_ALT1
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, PlanYear)>0 then
					1
					endif
				}
				Comment: "EP$BDSP,25";
			}
			Parameter ccalc_cEXX0_DSP_rRMXRET0ge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					AIMMS_GRP(PlantType)<>AINU('1') and PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: R(*)MXRET0";
				Definition: {
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, RetirementPlanYear)>0  and UPRETRAT('1')>0 then
					1
					endif
				}
				Comment: "EP$BDSP,28";
			}
			Parameter ccalc_cEXX0_DSP_rTOTCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup);
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: TOTCAP(*)(*)";
				Definition: {
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, PlanYear)>0 then
					1
					endif
				}
				Comment: "EP$BDSP,31";
			}
			Parameter ccalc_cEXX0_DSP_rFCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,RetireGroup) | PlantType_ALT2=PlantType;
				Text: "OML Columns: E(*)(**)XX(*)0 and OML Rows: F(*)(**)CAP(*)";
				Definition: {
					if BNDROW_EXX0(SupplyRegion_ALT1, PlantType, RetireGroup, PlanYear)>0 then
					1
					endif
				}
				Comment: "EP$BDSP,34";
			}
			Parameter ccalc_cEXXX_DSP_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: LBOUND";
				Definition: BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB);
				Comment: "EP$BDSP,37";
			}
			Parameter ccalc_cEXXX_DSP_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB);
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)
					else
					inf
					endif
				}
				Comment: "EP$BDSP,37";
			}
			Parameter ccalc_cE_MR_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: LBOUND";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)
					endif
				}
				Comment: "EP$BDSP,38";
			}
			Parameter ccalc_cE_MR_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear);
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)
					else
					inf
					endif
				}
				Comment: "EP$BDSP,38";
			}
			Parameter ccalc_cEXXX_DSP_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: ECPCOSTS";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					max(ECP_MIN('1'),
					IF ord(PlanYear_ALTB)< UNXPH('1') THEN
					FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear_ALTB)) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear_ALTB)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear_ALTB)
					endif)
					endif
				}
				Comment: "EP$BDSP,39";
			}
			Parameter ccalc_cE_MR_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: ECPCOSTS";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					max(ECP_MIN('1'),
					IF ord(PlanYear)< UNXPH('1') THEN
					FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXXX_DSP(PlantType, SupplyRegion_ALT1, FullPlanningHorizon+(UNXPH('1') - 1)) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear)
					endif)
					endif
				}
				Comment: "EP$BDSP,40";
			}
			Parameter ccalc_cEXXX_DSP_rCXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')  and PlantType = PlantType_ALT2 and PlanYear=PlanYear_ALTB and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: C(*)(**)X(*)(*)(*)";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 and SHR_FLRG_EXXX_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear)>0  then
					-max(0,
					EP_SP_CAP_FAC(Season, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) * SHR_FLRG_EXXX_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear) /$
					TOT_FLRG_EXXX_DSP(SupplyRegion_ALT1, PlantType, PlanYear))
					endif
				}
				Comment: "EP$BDSP,42";
			}
			Parameter ccalc_cEXXX_DSP_rMXXge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlantType=PlantType_ALT2 and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: M(*)(**)X(*)X(*)";
				Definition: {
					if SHR_FLRG_EXXX_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					- 8.760 * UPPMRT(PlantType) * SHR_FLRG_EXXX_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear) /$
					TOT_FLRG_EXXX_DSP(SupplyRegion_ALT1, PlantType, PlanYear)
					endif
				}
				Comment: "EP$BDSP,45";
			}
			Parameter ccalc_cE_MR_rCMle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlantType=PlantType_ALT2 and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: C(*)(**)M(*)(*)(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 and TMP_CAP_MR(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear)> 0 then
					-max(0,
					EP_SP_CAP_FAC(Season, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) * SHR_FLRG_MR_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear) /$
					TOT_FLRG_MR_DSP(SupplyRegion_ALT1, PlantType, PlanYear))
					endif
				}
				Comment: "EP$BDSP,47";
			}
			Parameter ccalc_cE_MR_rMXXge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlantType=PlantType_ALT2
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: M(*)(**)X(*)X(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 and TMP_CAP_MR(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear)> 0 then
					- 8.760 * UPPMRT(PlantType) * SHR_FLRG_MR_DSP(FuelRegion_ALT1, SupplyRegion_ALT1, PlantType, PlanYear) /$
					TOT_FLRG_MR_DSP(SupplyRegion_ALT1, PlantType, PlanYear)
					endif
				}
				Comment: "EP$BDSP,50";
			}
			Parameter ccalc_cEXXX_DSP_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and SupplyRegion_ALTX=SupplyRegion_ALT1 and PlanYear=PlanYear_ALTB and ord(PlanYear)>1
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,51";
			}
			Parameter ccalc_cEXXX_DSP_rRXXXXXn {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and SupplyRegion_ALTX=SupplyRegion_ALT1 and PlanYear=PlanYear_ALTB and ord(PlanYear)=1
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,51";
			}
			Parameter ccalc_cE_MR_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and SupplyRegion_ALTX=SupplyRegion_ALT1 and ord(PlanYear)>1
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,52";
			}
			Parameter ccalc_cE_MR_rRXXXXXn {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and SupplyRegion_ALTX=SupplyRegion_ALT1 and ord(PlanYear)=1
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: R(*)XXXXX(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,52";
			}
			Parameter ccalc_cEXXX_DSP_rTOTCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlanYear=PlanYear_ALTB
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: TOTCAP(*)(*)";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,53";
			}
			Parameter ccalc_cE_MR_rTOTCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: TOTCAP(*)(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,54";
			}
			Parameter ccalc_cEXXX_DSP_rFCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlanYear=PlanYear_ALTB and PlantType_ALT2=PlantType
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: F(*)(**)CAP(*)";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,55";
			}
			Parameter ccalc_cE_MR_rFCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1') and PlantType_ALT2=PlantType
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: F(*)(**)CAP(*)";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0  then
					1
					endif
				}
				Comment: "EP$BDSP,56";
			}
			Parameter ccalc_cEXXX_DSP_rRMXRET0ge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: R(*)MXRET0";
				Definition: {
					if BNDROW_EXXX(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 and USW_ERET('1')=1 AND UPRETRAT('1')>0 and ord(PlanYear_ALTB)=UPRTLT('1')+1 then
					1
					endif
				}
				Comment: "EP$BDSP,57";
			}
			Parameter ccalc_cE_MR_rRMXRET0ge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in DispatchableECP_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and AIMMS_GRP(PlantType)<>AINU('1') and
					PlantType<>WIEC_Element AND PlantType<>WIST_Element and UPTTYP(PlantType)>EX_COAL('1')
				}
				Text: "OML Columns: E(*)(**)_MR(*) and OML Rows: R(*)MXRET0";
				Definition: {
					if BNDROW_MR(SupplyRegion_ALT1, PlantType, PlanYear)>0 and USW_ERET('1')=1 AND UPRETRAT('1')>0 and ord(PlanYear)=UPRTLT('1')+1 then
					1
					endif
				}
				Comment: "EP$BDSP,58";
			}
			Parameter ccalc_cEXXX_DSP_rFDVLle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,PlanYear_ALTB) | UPTTYP(PlantType)>EX_COAL('1') and UPTTYP(PlantType)<=NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear) = ord(PlanYear_ALTB)
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: FDV(*)L(**)(*)";
				Definition: {
					
					 -8.760 * 0.0001 *
					  mean(FuelRegion|SHR_FLRG_EXXX_DSP(FuelRegion, SupplyRegion_ALT1, PlantType, PlanYear)>0 and CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion_ALT1 ,AVG_HTRT(PlantType,FuelRegion,SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)))
					 * UPMCF(PlantType) * CMM_LDV_PRF(element(DiversityProfile_, NEW_LDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear_ALTB))
					
					!average works because the AVG_HTRT is the same for all regions for new plant types, OML code was looping over fuel region and overwriting if mapped to the same coal region
				}
				Comment: "EP$BDSP,44";
			}
			Parameter ccalc_cEXXX_DSP_rFDVSle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,PlanYear_ALTB)| UPTTYP(PlantType)>EX_COAL('1') and UPTTYP(PlantType)<=NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(PlanYear) = ord(PlanYear_ALTB)
				}
				Text: "OML Columns: E(*)(**)XXX(*) and OML Rows: FDV(*)S(**)(*)";
				Definition: {
					 -8.760 * 0.0001 *
					  mean(FuelRegion|SHR_FLRG_EXXX_DSP(FuelRegion, SupplyRegion_ALT1, PlantType, PlanYear)>0 and CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion_ALT1 ,AVG_HTRT(PlantType,FuelRegion,SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear_ALTB)))
					 * UPMCF(PlantType) * CMM_SDV_PRF(element(DiversityProfile_, NEW_SDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear_ALTB))
					
					!average works because the AVG_HTRT is the same for all regions for new plant types, OML code was looping over fuel region and overwriting if mapped to the same coal region
				}
			}
			Parameter ccalc_cB_DSP_rLUANNn {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and PlanYear=PlanYear_ALTB and ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) > 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
					 endif
				}
				Comment: "EP$BDSP,60";
			}
			Parameter ccalc_cBDSPSUB_rLUANNn {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and PlanYear=PlanYear_ALTB and ORD(ElasticityStep_ALT1) <= MAX(1,ESTSWTCH(PlantType)) and Subsidy_Case(PlanYear, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) > 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
					 endif
				}
				Comment: "EP$BDSP,60";
			}
			Parameter ccalc_cB_DSP_rLUANNle {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and PlanYear=PlanYear_ALTB and ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) <= 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) THEN
					IF (UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
					 endif
				}
				Comment: "EP$BDSP,60";
			}

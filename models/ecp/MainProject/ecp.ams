			Parameter ccalc_cIX_rLXXINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and

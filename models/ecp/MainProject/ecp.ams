					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND

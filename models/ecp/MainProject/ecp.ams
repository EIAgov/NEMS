				  ord(OperatingMode)<=NSTP(Seasonhr_element(Season_hr), SupplyRegion_SUB) ):=
				
				IF SR_CREDIT(DSP_Types)>0 and HTRT_TEST(DSP_Types, PlanYear)=0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.000001 * GEN_MIN_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * VOMCST_DSP(DSP_Types, SupplyRegion_SUB, PlanYear)
				
				endif;
				!EP$ODSP,60
				ccalc_cU_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, DSP_Types, OperatingMode, Season1, PlanYear) |

			Parameter ccalc_cI_IMP_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALTfrom,PlantType_ALT1,OwnerType,SupplyRegion_ALTZ,ElasticityStep,PlanYear_ALTB) | PlantType_ALT1 in Intermittent_ and
					ord(SupplyRegion_ALTfrom)<=UNRGNS('1') and UPBLDTYP(SupplyRegion_ALTfrom)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType_ALT1) <= UNXPH('1') AND
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType_ALT1) and UPAVLYR(PlantType_ALT1)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType_ALT1) and UPVTYP(PlantType_ALT1)= 1 AND
					(UPBLDREG_us00(PlantType_ALT1)> 0 AND UPBLDREG(PlantType_ALT1, SupplyRegion_ALTfrom)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType_ALT1)) > 0 AND UPBLDREG(LCAP_element(PlantType_ALT1),SupplyRegion_ALTfrom) > 0) and
					MAP_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ) and UPETTSW(PlantType_ALT1)= 1 and 0<EPTCST(SupplyRegion_ALTfrom, Counter_ImportRegion(SupplyRegion_ALTfrom, SupplyRegion_ALTZ), cyr)<9999 and
					SupplyRegion_ALT2=SupplyRegion_ALTZ
				}
				Text: {
					"OML Columns: I(*)(**)(*)(*)(*)(*)!IMP and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF GRD_RATS(PlantType_ALT1, SupplyRegion_ALT2)>0 THEN
					IF ( -ECP_MIN('1') < GENIMP_INT(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, PlantType_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 *
					(GRD_RATS(PlantType_ALT1, SupplyRegion_ALT2) - GRD_NRYR(SupplyRegion_ALT2, ExplicitPlanningHorizon_element(PlanYear_ALTB)))< ECP_MIN('1')) then
					0
					else
					GENIMP_INT(SupplyRegion_ALTfrom, SupplyRegion_ALTZ, PlantType_ALT1, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) * 0.001 *
					(GRD_RATS(PlantType_ALT1, SupplyRegion_ALT2) - GRD_NRYR(SupplyRegion_ALT2, ExplicitPlanningHorizon_element(PlanYear_ALTB)))
					endif
					endif

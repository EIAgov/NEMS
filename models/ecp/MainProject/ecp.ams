			Parameter ccalc_cRHS_rLUXXCCSle {
				IndexDomain: (PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: LUXXCCS(*)";
				Definition: {
					if 1 < ord(PlanYear) < UNXPH('1') then
					  if (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < UPAVLYR(WIIS_Element) then
					    0
					  else
					    UPCQMAX('1') * (1.0 + UPCRMAX('1')) ^ I_PWR(PlanYear)
					  endif
					endif
				}
				Comment: "EP$COAL,14";
			}
			Parameter ccalc_cLP_RET_rLP_RETge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | PlanYear=UNXPH_PlanYear and SupplyRegion_ALT1 in SupplyRegion_SUB_;
				Text: "OML Columns: L(*)P_RET(*) and OML Rows: L(*)P_RET(*)";
				Definition: 1;
				Comment: {
					"EP$COAL,15
					FORCE PLANNED RETROFITS FOR LAST PLANNING YEAR(S)"
				}
			}
			Parameter ccalc_cLP_RET_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | PlanYear=UNXPH_PlanYear and SupplyRegion_ALT1 in SupplyRegion_SUB_;
				Text: "OML Columns: L(*)P_RET(*) and OML Rows: ECPCOSTS";
				Definition: 2000.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear));
				Comment: {
					"EP$COAL,16
					FORCE PLANNED RETROFITS FOR LAST PLANNING YEAR(S)"
				}
			}
			Parameter ccalc_cRHS_rLP_RETge {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | PlanYear=UNXPH_PlanYear and SupplyRegion_ALT1 in SupplyRegion_SUB_;
				Text: "OML Columns: RHSECP and OML Rows: L(*)P_RET(*)";
				Definition: {
					sum(MNUMYR | MIN(UNYEAR('1'), CURIYR('1')+UNXPH('1'))<=ord(MNUMYR)<=MIN(UNYEAR('1'), CURIYR('1')+UNFPH('1')-1),
					EMELRETP(SupplyRegion_ALT1, MNUMYR))
				}
				Comment: {
					"EP$COAL,17
					FORCE PLANNED RETROFITS FOR LAST PLANNING YEAR(S)"
				}
			}

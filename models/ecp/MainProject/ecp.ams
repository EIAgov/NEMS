			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			      for (Season,SupplyRegion) do
			        if URNCSTIM_ECP(Season,SupplyRegion,NEMSYearIndex) then
			             put @5,ord(Season):<10:0,ord(SupplyRegion):<10:0,URNCSTIM_ECP(Season,SupplyRegion,NEMSYearIndex):>18:10,/;
			        endif; 
			      endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"URNCSTIM_EFD":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			      for (Season,SupplyRegion) do
			        if URNCSTIM_EFD(Season,SupplyRegion,NEMSYearIndex) then
			             put @5,ord(Season):<10:0,ord(SupplyRegion):<10:0,URNCSTIM_EFD(Season,SupplyRegion,NEMSYearIndex):>18:10,/;
			        endif; 
			      endfor; 
			      put @5,";",/; 
			      put "",/;
			! write variables with implicit year and region indices as implemented via direct access files in nems.
			! use NEMSYearIndex to set the Year and SupplyRegionNumber to set the Region   
			      NEMSYearIndex:=stringtoelement(mnumyr_,FormatString("%02i", CURCALYR('1')-1989));
			      for (SupplyRegion in SupplyRegion_) do
			        SupplyRegionNumber:=ord(SupplyRegion);
			        display SupplyRegionNumber;
			        put "",/;
			        put "Composite table:",/;
			        put @5,"SCALARSet":<13,"EPBANK":>16/;
			        put "!",@5,"---------":<13,"----------------":>16,/;
			        for (SCALARSet) do
			            if EPBANK(SCALARSet,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(SCALARSet):<13:0,EPBANK(SCALARSet,SupplyRegion,NEMSYearIndex):>16:10,/;
			            endif; 
			        endfor; 
			        put @5,";",/; 
			        put "",/;
			        put "Composite table:",/;
			        put @5,"Index1":<10,"EPLVBCK":>18,/;
			        put "!",@5,"------":<10,"------------------":>18,/;
			        for (PlantType) do
			            if EPLVBCK(PlantType,SupplyRegion,NEMSYearIndex) then
			                   put @5,ord(PlantType):<10:0,EPLVBCK(PlantType,SupplyRegion,NEMSYearIndex):>18:10,/;
			            endif; 
			        endfor; 

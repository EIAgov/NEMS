			Parameter ccalc_cIS_rLUSUBXge {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and PlantType_ALT2=PlantType
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: LU(**)SUBX";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					        IF (UPSUBCAS(PlantType)> 0 AND LIMSUB_calc(PlantType)> 0 AND UPSUBLIM(PlantType)< 999.0) THEN
					        1
					        endif
					endif
				}
				Comment: {
					"EP$INT,47
					PUT INTO CONSTRAINT TO LIMIT SUBSIDIZED CAPACITY ADDITIONS, IF ANY"
				}
			}
			Parameter ccalc_cIS_rPXXXXXn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB);
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: P(*)XXXXX(*)";
				Definition: {
					!Calculated in Calculate_INTBLDCOSTS
				}
				Comment: "EP$INT,48";
			}
			Parameter ccalc_cIX_rPXXXXXn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB);
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: P(*)XXXXX(*)";
				Definition: {
					!Calculated in Calculate_INTBLDCOSTS
				}
				Comment: "EP$INT,48";
			}
			Parameter ccalc_cIX_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)  | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					if PlantType in Intermittent_  then
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF (PlantType = WIWN_Element or PlantType = WIWL_Element) AND (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) - 1) <= (ECP_FYR('1') + UPPLYR(PlantType)) then
					0
					elseif UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)>ECP_MIN('1') then
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)
					endif
					endif
					elseif PlantType=WIDS_Element and ElasticityStep=ElasticityStep1 then
					NET_STORAGE_LOAD_NW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
				}
				Comment: {
					"EP$INT,49; CALC_STORAGE_VAL,10"
				}
			}
			Parameter ccalc_cIS_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF (PlantType = WIWN_Element or PlantType = WIWL_Element) AND (CURIYR('1') + UHBSYR('1') + OLYEAR(PlanYear, PlantType) - 1) <= (ECP_FYR('1') + UPPLYR(PlantType)) then
					0
					elseif UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)>ECP_MIN('1') then
					UPICFC1(PlantType, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_ALT1, cyr)
					endif
					endif
				}
				Comment: "EP$INT,49";
			}
			Parameter ccalc_cIX_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: {
					if PlantType in Intermittent_  then
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF ccalc_cIX_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, OwnerType, ElasticityStep, PlanYear_ALTB)<>0 and
					SR_INT(PlantType, SupplyRegion_ALT1)>0 THEN
					-1 * ccalc_cIX_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, OwnerType, ElasticityStep, PlanYear_ALTB) * SR_INT(PlantType, SupplyRegion_ALT1)+
					if SR_CREDIT(PlantType)> 0.0 AND PlantType=WIPT_Element then
					NET_PT_STORAGE_SR_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
					endif
					endif
					elseif PlantType=WIDS_Element and ElasticityStep=ElasticityStep1 then
					NET_STORAGE_SR_NW(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
				}
				Comment: {
					"EP$INT,52; CALC_STORAGE_VAL,14"
				}
			}
			Parameter ccalc_cIS_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: {
					IF UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					        (UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) THEN
					IF ccalc_cIX_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, OwnerType, ElasticityStep, PlanYear_ALTB)<>0 and
					SR_INT(PlantType, SupplyRegion_ALT1)>0 THEN
					-1 * ccalc_cIX_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear, PlantType, OwnerType, ElasticityStep, PlanYear_ALTB) * SR_INT(PlantType, SupplyRegion_ALT1)+
					if SR_CREDIT(PlantType)> 0.0 AND PlantType=WIPT_Element then
					NET_PT_STORAGE_SR_EX(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_ALT1, cyr)
					endif
					endif
					endif
				}
				Comment: "EP$INT,52";
			}
			Parameter ccalc_cIS_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB)  | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: {
					IF ( -ECP_MIN('1') < GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
				}
				Comment: "EP$INT,53";
			}
			Parameter ccalc_cIX_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: F(*)(**)GEN(*)";
				Definition: {
					IF ( -ECP_MIN('1') < GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
				}
				Comment: "EP$INT,53";
			}
			Parameter ccalc_cIS_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and
					RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF ( -ECP_MIN('1') < UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
				}
				Comment: "EP$INT,54";
			}
			Parameter ccalc_cIX_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and
					RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: G(*)RNWXX(*)";
				Definition: {
					IF ( -ECP_MIN('1') < UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					UPRNWSHRR(PlantType, SupplyRegion_ALT1) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
				}
				Comment: "EP$INT,54";
			}
			Parameter ccalc_cIS_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and SupplyRegion_ALTY=SupplyRegion_ALT1 and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.005 AND UPRNWSHR(PlantType)> 0.0) THEN
					IF ( -ECP_MIN('1') < UPRNWSHR(PlantType) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					UPRNWSHR(PlantType) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
					endif
				}
				Comment: "EP$INT,55";
			}
			Parameter ccalc_cIX_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: "OML Columns: I(*)(**)(*)X(*)(*) and OML Rows: GURNWX(*)(*)";
				Definition: {
					IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear)) > 0.005 AND UPRNWSHR(PlantType)> 0.0) THEN
					IF ( -ECP_MIN('1') < UPRNWSHR(PlantType) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					UPRNWSHR(PlantType) * GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
					endif
				}
				Comment: "EP$INT,55";
			}
			Parameter ccalc_cIS_rLXXINTle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)  | PlantType in Intermittent_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) and OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) and UPVTYP(PlantType)= 1 AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) AND
					(UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion_ALT1) > 0) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: "OML Columns: I(*)(**)(*)S(*)(*) and OML Rows: L(*)XXINT(*)";
				Definition: {
					if UPINTSW('1') >= 2 and UCPINTIS(PlantType)>0 then
					IF ( -ECP_MIN('1') < GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000< ECP_MIN('1')) then
					0
					else
					GEN_INT(SupplyRegion_ALT1, PlantType, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)/1000
					endif
					endif
				}
				Comment: "EP$INT,56";

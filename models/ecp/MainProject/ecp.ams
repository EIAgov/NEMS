						Element(SupplyRegionAll_,ord(CanadianSupplyRegion)+card(SupplyRegion_)+10)
				elseif RegGridIndex('1') = 4 then
						Element(SupplyRegionAll_,ord(CanadianSupplyRegion)+card(SupplyRegion_)+21)
				else
						Element(SupplyRegionAll_,ord(CanadianSupplyRegion)+card(SupplyRegion_))

			Range: PlanYear_;
			Definition: first(PlanYear_);
		}
		ElementParameter PlanYear_Two {
			Range: PlanYear_;
			Definition: element(PlanYear_,2);
		}
		Parameter MAP_ImportRegion {
			IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTZ);
			Definition: {
				if RegGridIndex('1') = 1 then
						sum(SupplyRegion | ord(SupplyRegion_ALTZ)=EPTIRGN(SupplyRegion_ALT1, SupplyRegion, cyr)-1  , 1)
				elseif RegGridIndex('1') = 4 then
						if (ord(SupplyRegion_ALT1) > 1) then
						       sum(SupplyRegion | ord(SupplyRegion_ALTZ)=EPTIRGN(SupplyRegion_ALT1, SupplyRegion, cyr)-18, 1)
						else
						       sum(SupplyRegion | ord(SupplyRegion_ALTZ)=EPTIRGN(SupplyRegion_ALT1, SupplyRegion, cyr), 1)
						endif
				else
				    		sum(SupplyRegion | ord(SupplyRegion_ALTZ)=EPTIRGN(SupplyRegion_ALT1, SupplyRegion, cyr), 1)
				endif
			}
		}
		ElementParameter Counter_ImportRegion {
			IndexDomain: (SupplyRegion_ALT1,SupplyRegion_ALTZ);
			Range: SupplyRegion_;
			Definition: element(SupplyRegion_, sum(SupplyRegion | ord(SupplyRegion_ALTZ)=EPTIRGN(SupplyRegion_ALT1, SupplyRegion, cyr), ord(SupplyRegion)));
		}
		ElementParameter TYR2 {
			IndexDomain: PlanYear;
			Range: MNUMYR_;
			Definition: {
				IF ord(PlanYear)<UNXPH('1') THEN
				element(MNUMYR_, MIN(CURIYR('1') + ord(PlanYear) - 1 , UNYEAR('1')))
				ELSE
				element(MNUMYR_, UNYEAR('1'))
				ENDIF
			}
		}
		Parameter FuelRegion_DSP {
			IndexDomain: (SupplyRegion,DispatchableECP,FuelRegion,PlanYear) | ord(SupplyRegion)<=UNRGNS('1');
			Definition: {
				IF (EPECAP(FuelRegion0, DispatchableECP, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(DispatchableECP)= 1 AND
				UPAVLYR(DispatchableECP)<=FULLYEAR_YR(PlanYear) ) OR WPTTYP(DispatchableECP,SupplyRegion)>0 ) THEN
				  if UPTTYP(DispatchableECP) <= NW_COAL('1') then
				    IF ((C_EMM_CDS(SupplyRegion, CoalDemandRegion_EPCLMP(FuelRegion))= 1 AND C_ECP_CDS(CoalPlant_UtilitySector(DispatchableECP), CoalDemandRegion_EPCLMP(FuelRegion)) = 1) OR
				    (FL_CNXT_CST(SupplyRegion, FuelRegion)> 0 AND C_ECP_CDS(CoalPlant_UtilitySector(DispatchableECP), CoalDemandRegion_EPCLMP(FuelRegion))= 1 AND UPVTYP(DispatchableECP)= 1)) THEN
				      1
				    endif
				  else
				    IF (HR_NMR(DispatchableECP, FuelRegion, SupplyRegion, PlanYear) OR HR_MR(DispatchableECP, FuelRegion, SupplyRegion, PlanYear) OR
				    HR_MOD_NMR(DispatchableECP, FuelRegion, SupplyRegion, PlanYear) OR HR_MOD_MR(DispatchableECP, FuelRegion, SupplyRegion, PlanYear) ) THEN
				      1
				    endif
				  endif
				endif
			}
		}
		Parameter FuelRegion_PM {
			IndexDomain: (SupplyRegion,DispatchableECP,FuelRegion,PlanYear) | ord(SupplyRegion)<=UNRGNS('1');
			Definition: {
				IF  WPTTYP(DispatchableECP,SupplyRegion)>0 THEN
				  if UPTTYP(DispatchableECP) <= NW_COAL('1') then
				    IF ((C_EMM_CDS(SupplyRegion, CoalDemandRegion_EPCLMP(FuelRegion))= 1 AND C_ECP_CDS(CoalPlant_UtilitySector(DispatchableECP), CoalDemandRegion_EPCLMP(FuelRegion)) = 1) OR
				    (FL_CNXT_CST(SupplyRegion, FuelRegion)> 0 AND C_ECP_CDS(CoalPlant_UtilitySector(DispatchableECP), CoalDemandRegion_EPCLMP(FuelRegion))= 1 AND UPVTYP(DispatchableECP)= 1)) THEN
				      1
				    endif
				  else
				    IF ((FRG_EMM_MAP(SupplyRegion, FuelRegion)> 0 AND UPVTYP(DispatchableECP)=0) OR (FL_CNXT_CST(SupplyRegion, FuelRegion)>0 AND UPVTYP(DispatchableECP)= 1)) THEN
				      1
				    endif
				  endif
				endif
			}
		}

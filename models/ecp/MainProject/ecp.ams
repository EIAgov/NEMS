	DeclarationSection PassBacktoNEMSDeclare {
		ElementParameter NEMSYearIndex {
			Range: MNUMYR_;
		}
		Parameter SupplyRegionNumber {
			Range: integer;
		}
	}
	Procedure PassBackToNEMS_old {
		Body: {
			      OutToNEMS_FileName:="../../ecp/PassBack_"+formatstring("%i",curcalyr(1))+".txt";
			      put OutToNEMS; ! opens the file and sets stage for subsequent display and put statements
			      display ECP_WithoutSafety.ProgramStatus ;
			      display ECP_WithSafety.ProgramStatus ;
			! output the EMM variables derived from the LP solution values
			      display {B_CCST_ADJ} where decimals := 10 ;
			      display {BANK_HG} where decimals := 10 ;
			      display {BILCAP} where decimals := 10 ;
			      display {BILFCF} where decimals := 10 ;
			      display {BILFLC} where decimals := 10 ;
			      display {BILTRN} where decimals := 10 ;
			      display {BNK_TO_CMM_HG} where decimals := 10 ;
			      display {BUILD_AVL} where decimals := 10 ;
			      display {ECP_SCRUB} where decimals := 10 ;
			      display {CAPSUB} where decimals := 10 ;
			      display {CARECP} where decimals := 10 ;
			      display {CMM_LDV_INDX} where decimals := 10 ;
			      display {ECP_LCAR} where decimals := 10 ;
			      display {ECP_PCAR} where decimals := 10 ;
			      display {ECP_PECP} where decimals := 10 ;
			      display {ECP_PHG} where decimals := 10 ;
			      display {ECP_PSO2} where decimals := 10 ;
			      display {ECP_PSO2CL} where decimals := 10 ;
			      display {ECP_QCAR} where decimals := 10 ;
			      display {ECP_QECP} where decimals := 10 ;
			      display {ECP_QHG} where decimals := 10 ;
			      display {ECP_QNOX} where decimals := 10 ;
			      display {ECP_QSO2} where decimals := 10 ;
			      display {EMELBNK} where decimals := 10 ;
			      display {EMM_MEF} where decimals := 10 ;
			      display {EPCARPR} where decimals := 10 ;
			      display {EPNOXPR} where decimals := 10 ;
			      display {EPRPSCP} where decimals := 10 ;
			      display {EPRPSCPR} where decimals := 10 ;
			      display {EPRPSCR} where decimals := 10 ;
			      display {EPRPSCRR} where decimals := 10 ;
			      display {EPRPSLM} where decimals := 10 ;
			      display {EPRPSLMR} where decimals := 10 ;
			      display {EPRPSPR} where decimals := 10 ;
			      display {EPRPSPRR} where decimals := 10 ;
			      display {EPZECGEN} where decimals := 10 ;
			      display {EPZECPRC} where decimals := 10 ;
			      display {EPZECSUB} where decimals := 10 ;
			      display {ERMRGN} where decimals := 10 ;
			      display {FLLCAP} where decimals := 10 ;
			      display {FLLFCF} where decimals := 10 ;
			      display {FLLFLC} where decimals := 10 ;
			      display {FLLTRN} where decimals := 10 ;
			      display {IRNWGEN} where decimals := 10 ;
			      display {IRNWPCT} where decimals := 10 ;
			      display {ITOTGEN} where decimals := 10 ;
			      display {LEVRMC} where decimals := 10 ;
			      display {LEVRMD} where decimals := 10 ;
			      display {LEVRMD2} where decimals := 10 ;
			      display {LEVRMD2C} where decimals := 10 ;
			      display {LIMSUB} where decimals := 10 ;
			      display {ST_RNW_SHR} where decimals := 10 ;
			      display {ST_RPS_DUALS} where decimals := 10 ;
			      display {ST_RPS_EMM_P} where decimals := 10 ;
			      display {ST_RPS_EMM_Q} where decimals := 10 ;
			      display {ST_RPS_EX_GEN} where decimals := 10 ;
			      display {ST_RPS_NW_GEN} where decimals := 10 ;
			      display {ST_RPS_PRC_87} where decimals := 10 ;
			      display {ST_RPS_XP_GEN} where decimals := 10 ;
			      display {UCF_RCAP1} where decimals := 10 ;
			      display {UCF_TCAP1} where decimals := 10 ;
			      display {UECP_GEN} where decimals := 10 ;
			      display {ULEL} where decimals := 10 ;
			      display {ULOV} where decimals := 10 ;
			      display {UPBQMAX} where decimals := 10 ;
			      display {UPCFGNN} where decimals := 10 ;
			      display {UPWDCFN} where decimals := 10 ;
			      display {UPWDCFR} where decimals := 10 ;
			      display {UTNEWTRN} where decimals := 10 ;
			      display {UTRELADJ} where decimals := 10 ;
			      display {WDLCAP} where decimals := 10 ;
			      display {WDLFCF} where decimals := 10 ;
			      display {WDLFLC} where decimals := 10 ;
			      display {WDLTRN} where decimals := 10 ;
			! write variables with implicit year and region indices as implemented via direct access files in nems.
			! use NEMSYearIndex to set the Year and SupplyRegionNumber to set the Region   
			      NEMSYearIndex:=stringtoelement(mnumyr_,FormatString("%02i", CURCALYR('1')-1989));
			      for (SupplyRegion in SupplyRegion_) do
			        SupplyRegionNumber:=ord(SupplyRegion);
			        display SupplyRegionNumber;
			        display {EPBANK(SCALARSet,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVBCK(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVCAP(PlantType,OwnerType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVEXT(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVFCF(PlantType,OwnerType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVFLC(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVFOM(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVTRN(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPLVVOM(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPRENEW(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPRMRGN(ExplicitPlanningHorizon,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {EPTAVD(PlantType,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {URNCSTEX_ECP(Season,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {URNCSTEX_EFD(Season,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {URNCSTIM_ECP(Season,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			        display {URNCSTIM_EFD(Season,SupplyRegion,NEMSYearIndex)} where decimals := 10 ;
			      endfor;
			      putclose;
		}
	}
	Procedure PassBackToNEMS_new {
		Body: {
			      OutToNEMS_FileName:="../../ecp/PassBack_new_"+formatstring("%i",curcalyr(1))+".txt";
			      put OutToNEMS; ! opens the file and sets stage for subsequent display and put statements
			      display ECP_WithoutSafety.ProgramStatus ;
			      display ECP_WithSafety.ProgramStatus ;
			! output the non-DAF EMM variables derived from the LP solution values
			      put "Composite table:",/;
			      put @5,"Index1":<10,"B_CCST_ADJ":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (PlantType) do
			            if B_CCST_ADJ(PlantType) then
			              put @5,ord(PlantType):<10:0,B_CCST_ADJ(PlantType):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"BANK_HG":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (CoalDemandRegion) do
			            if BANK_HG(CoalDemandRegion) then
			              put @5,ord(CoalDemandRegion):<10:0,BANK_HG(CoalDemandRegion):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"Index3":<10,"BILCAP":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------":<10,"------------------":>18,/;
			         for (SupplyRegion_ALT1,FuelRegion,OwnerType) do
			            if BILCAP(SupplyRegion_ALT1,FuelRegion,OwnerType) then
			              put @5,ord(SupplyRegion_ALT1):<10:0,ord(FuelRegion):<10:0,ord(OwnerType):<10:0,BILCAP(SupplyRegion_ALT1,FuelRegion,OwnerType):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"Index3":<10,"BILFCF":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------":<10,"------------------":>18,/;
			         for (SupplyRegion_ALT1,FuelRegion,OwnerType) do
			            if BILFCF(SupplyRegion_ALT1,FuelRegion,OwnerType) then
			              put @5,ord(SupplyRegion_ALT1):<10:0,ord(FuelRegion):<10:0,ord(OwnerType):<10:0,BILFCF(SupplyRegion_ALT1,FuelRegion,OwnerType):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"BILFLC":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (FuelRegion,ExplicitPlanningHorizon) do
			            if BILFLC(FuelRegion,ExplicitPlanningHorizon) then
			              put @5,ord(FuelRegion):<10:0,ord(ExplicitPlanningHorizon):<10:0,BILFLC(FuelRegion,ExplicitPlanningHorizon):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"BILTRN":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (SupplyRegion_ALT1,FuelRegion) do
			            if BILTRN(SupplyRegion_ALT1,FuelRegion) then
			              put @5,ord(SupplyRegion_ALT1):<10:0,ord(FuelRegion):<10:0,BILTRN(SupplyRegion_ALT1,FuelRegion):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"BNK_TO_CMM_HG":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (MNUMYR) do
			            if BNK_TO_CMM_HG(MNUMYR) then
			              put @5,ord(MNUMYR):<10:0,BNK_TO_CMM_HG(MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"Index3":<10,"Index4":<10,"BUILD_AVL":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------":<10,"------":<10,"------------------":>18,/;
			         for (PlantType,ExplicitPlanningHorizon,SupplyRegion_ALT1,MNUMYR) do
			            if BUILD_AVL(PlantType,ExplicitPlanningHorizon,SupplyRegion_ALT1,MNUMYR) then
			              put @5,ord(PlantType):<10:0,ord(ExplicitPlanningHorizon):<10:0,ord(SupplyRegion_ALT1):<10:0,ord(MNUMYR):<10:0,BUILD_AVL(PlantType,ExplicitPlanningHorizon,SupplyRegion_ALT1,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"ECP_SCRUB":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (UtilitySector,MNUMYR) do
			            if ECP_SCRUB(UtilitySector,MNUMYR) then
			              put @5,ord(UtilitySector):<10:0,ord(MNUMYR):<10:0,ECP_SCRUB(UtilitySector,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"CAPSUB":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (PlantType) do
			            if CAPSUB(PlantType) then
			              put @5,ord(PlantType):<10:0,CAPSUB(PlantType):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"CARECP":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (CO2CapGroup,MNUMYR) do
			            if CARECP(CO2CapGroup,MNUMYR) then
			              put @5,ord(CO2CapGroup):<10:0,ord(MNUMYR):<10:0,CARECP(CO2CapGroup,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"CMM_LDV_INDX":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (CoalGroup) do
			            if CMM_LDV_INDX(CoalGroup) then
			              put @5,ord(CoalGroup):<10:0,CMM_LDV_INDX(CoalGroup):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"ECP_LCAR":>18,/;
			      put "!",@5,"------":<10,"------------------":>18,/;
			         for (MNUMYR) do
			            if ECP_LCAR(MNUMYR) then
			              put @5,ord(MNUMYR):<10:0,ECP_LCAR(MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"ECP_PCAR":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (ExplicitPlanningHorizon_SUP,MNUMYR) do
			            if ECP_PCAR(ExplicitPlanningHorizon_SUP,MNUMYR) then
			              put @5,ord(ExplicitPlanningHorizon_SUP)-1:<10:0,ord(MNUMYR):<10:0,ECP_PCAR(ExplicitPlanningHorizon_SUP,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"Index3":<10,"ECP_PECP":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------":<10,"------------------":>18,/;
			         for (CoalSupplyCurve_Dom,ExplicitPlanningHorizon_SUP,MNUMYR) do
			            if ECP_PECP(CoalSupplyCurve_Dom,ExplicitPlanningHorizon_SUP,MNUMYR) then
			              put @5,ord(CoalSupplyCurve_Dom):<10:0,ord(ExplicitPlanningHorizon_SUP)-1:<10:0,ord(MNUMYR):<10:0,ECP_PECP(CoalSupplyCurve_Dom,ExplicitPlanningHorizon_SUP,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"ECP_PHG":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------------------":>18,/;
			         for (CoalDemandRegion,MNUMYR) do
			            if ECP_PHG(CoalDemandRegion,MNUMYR) then
			              put @5,ord(CoalDemandRegion):<10:0,ord(MNUMYR):<10:0,ECP_PHG(CoalDemandRegion,MNUMYR):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"Index3":<10,"ECP_PSO2":>18,/;
			      put "!",@5,"------":<10,"------":<10,"------":<10,"------------------":>18,/;
			         for (ExplicitPlanningHorizon_SUP,MNUMYR,SO2ComplyGroup) do
			            if ECP_PSO2(ExplicitPlanningHorizon_SUP,MNUMYR,SO2ComplyGroup) then
			              put @5,ord(ExplicitPlanningHorizon_SUP)-1:<10:0,ord(MNUMYR):<10:0,ord(SO2ComplyGroup):<10:0,ECP_PSO2(ExplicitPlanningHorizon_SUP,MNUMYR,SO2ComplyGroup):>18:10,/;
			            endif; 
			          endfor; 
			      put @5,";",/; 
			      put "",/;
			      put "Composite table:",/;
			      put @5,"Index1":<10,"Index2":<10,"ECP_PSO2CL":>18,/;

					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and EPIROVR(RnwStor(PlantType), SupplyRegion_ALT1, cyr)<9000 and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType)

					      cIX(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((CoalGroup,PlanYear_ALTB),
					coeff_cNNG_rRXXXXXge(SupplyRegion_ALTX,PlanYear,CoalGroup,PlanYear_ALTB) *
					      cNNG(CoalGroup,PlanYear_ALTB))
					+
					sum((CommitYear,CoalGroup),
					coeff_cNNGCL_rRXXXXXge(SupplyRegion_ALTX,PlanYear,CommitYear,CoalGroup) *
					      cNNGCL(CommitYear,CoalGroup))
					+
					sum((CommitYear,Nuclear),
					coeff_cNUC_rRXXXXXge(SupplyRegion_ALTX,PlanYear,CommitYear,Nuclear) *
					      cNUC(CommitYear,Nuclear))
					+
					sum((CommitYearSR,Nuclear),
					coeff_cNUCSR_rRXXXXXge(SupplyRegion_ALTX,PlanYear,CommitYearSR,Nuclear) *
					      cNUCSR(CommitYearSR,Nuclear))
					+
					sum((SupplyRegion_ALT1),
					coeff_cRDBLDX_rRXXXXXge(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1) *
					      cRDBLDX(SupplyRegion_ALT1,PlanYear))
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rRXXXXXge(SupplyRegion_ALTX,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rRXXXXXge(SupplyRegion_ALTX,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					>=
					
					coeff_cRHS_rRXXXXXge(SupplyRegion_ALTX,PlanYear)
				}
				Comment: "reserve margin constraint for future years (GW)";
			}
			Constraint rSCXle {
				IndexDomain: (CoalType,CoalSupplyCurve,PlanYear);
				Text: "OML Rows: SC(**)(**)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CoalSupplyStep),
					coeff_cMV_rSCXle(CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStep) *
					      cMV(CoalSupplyCurve,CoalSupplyStep,PlanYear))
					+
					coeff_cMVI11_rSCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVI11(CoalSupplyCurve,PlanYear)
					+
					sum((CoalSupplyStepINT),
					coeff_cMVINT_rSCXle(CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStepINT) *
					      cMVINT(CoalSupplyCurve,CoalSupplyStepINT,PlanYear))
					+
					coeff_cMVOTH_rSCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVOTH(CoalSupplyCurve,PlanYear)
					+
					coeff_cMVUP6_rSCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVUP6(CoalSupplyCurve,PlanYear)
					+
					sum((FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rSCXle(CoalType,CoalSupplyCurve,PlanYear,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					
					<=
					
					0.
				}
				Comment: "coal supply curve (trill BTU)";
			}
			Constraint rTZZle {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear);
				Text: "OML Rows: T(**)(*)(*)ZZ(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rTZZle(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rTZZle(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					+
					sum((FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rTZZle(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					coeff_cTZZ_rTZZle(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear) *
					      cTZZ(CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)
					
					<=
					
					0.
				}
				Comment: "impose limit on coal available at tier 1 rates, if any (trill BTU * 0.1)";
			}
			Constraint rXCXle {
				IndexDomain: (CoalType,CoalSupplyCurve,PlanYear);
				Text: "OML Rows: XC(**)(**)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CoalSupplyStep),
					coeff_cMV_rXCXle(CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStep) *
					      cMV(CoalSupplyCurve,CoalSupplyStep,PlanYear))
					+
					coeff_cMVI11_rXCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVI11(CoalSupplyCurve,PlanYear)
					+
					sum((CoalSupplyStepINT),
					coeff_cMVINT_rXCXle(CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStepINT) *
					      cMVINT(CoalSupplyCurve,CoalSupplyStepINT,PlanYear))
					+
					coeff_cMVOTH_rXCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVOTH(CoalSupplyCurve,PlanYear)
					+
					coeff_cMVUP6_rXCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cMVUP6(CoalSupplyCurve,PlanYear)
					+
					coeff_cXCX_rXCXle(CoalType,CoalSupplyCurve,PlanYear) *
					      cXCX(CoalType,CoalSupplyCurve,PlanYear)
					
					<=
					
					coeff_cRHS_rXCXle(CoalType,CoalSupplyCurve,PlanYear)
				}
				Comment: "limit coal production by available capacity (trill BTU)";
			}
			Constraint rXELle {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear);
				Text: "OML Rows: X(*)EL(*)(*)(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALTa),
					coeff_cBELYY_rXELle(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTa) *
					      cBELYY(SupplyRegion_ALT1,SupplyRegion_ALTa,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTEL_rXELle(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTEL(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					+
					sum((SupplyRegion_ALTfrom,SupplyRegion_ALTX),
					coeff_cTSR_rXELle(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,SupplyRegion_ALTfrom,SupplyRegion_ALTX) *
					      cTSR(SupplyRegion_ALTfrom,SupplyRegion_ALTX,LoadGroup,LoadSegment,PlanYear))
					
					<=
					
					coeff_cRHS_rXELle(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)
				}
				Comment: "limit total exports to other regions (GW)";
			}
			Constraint rYCTSle {
				IndexDomain: (CoalGroup);
				Text: "OML Rows: Y(****)CTS";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,RetrofitCFG),
					coeff_cRETRO_rYCTSle(CoalGroup,CommitYear,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,RetrofitCFG),
					coeff_cRETROHTRT_rYCTSle(CoalGroup,HTRTYear,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					coeff_cRHS_rYCTSle(CoalGroup)
				}
				Comment: "limit sum of CCS retrofit options by available capacity (GW)";
			}
			Constraint rYFGDle {
				IndexDomain: (CoalGroup);
				Text: "OML Rows: Y(****)FGD";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,RetrofitCFG),
					coeff_cRETRO_rYFGDle(CoalGroup,CommitYear,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,RetrofitCFG),
					coeff_cRETROHTRT_rYFGDle(CoalGroup,HTRTYear,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					coeff_cRHS_rYFGDle(CoalGroup)
				}
				Comment: "limit sum of FGD retrofit options by available capacity (GW)";
			}
			Constraint rYNCRle {
				IndexDomain: (CoalGroup);
				Text: "OML Rows: Y(****)NCR";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((CommitYear,RetrofitCFG),
					coeff_cRETRO_rYNCRle(CoalGroup,CommitYear,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,RetrofitCFG),
					coeff_cRETROHTRT_rYNCRle(CoalGroup,HTRTYear,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					coeff_cRHS_rYNCRle(CoalGroup)
				}
				Comment: "limit sum of SNCR retrofit options by available capacity (GW)";
			}
			Constraint rZCSRGeq {
				IndexDomain: (CensusRegion,PlanYear);
				Text: "OML Rows: ZCSRG(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cJX_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cJX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					coeff_cNTX_rZCSRGeq(CensusRegion,PlanYear) *
					      cNTX(CensusRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cUX_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cUX(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx),
					coeff_cZXrnw_rZCSRGeq(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx) *
					      cZXrnw(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,Seasonx,PlanYear))
					
					=
					0.
				}
				Comment: "balance row for captured CO2 from power plants and storage or use for EOR, by Census region (million metric tons CO2)";
			}
			Constraint rZCSRGge {
				IndexDomain: (CensusRegion,PlanYear);
				Text: "OML Rows: ZCSRG(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cJ_rZCSRGge(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cJ(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					coeff_cNTX_rZCSRGge(CensusRegion,PlanYear) *
					      cNTX(CensusRegion,PlanYear)
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cO_DISP_rZCSRGge(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cO_DISP(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					+
					sum((SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd),
					coeff_cU_rZCSRGge(CensusRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd) *
					      cU(SupplyRegion_ALT1,FuelRegion_ALT1,PlantType,OperatingMode,Seasonmd,PlanYear))
					
					>=
					
					0.
				}
				Comment: "balance row for captured CO2 if not carbon constrained (not required to transport) (million metric tons CO2)";
			}
			Parameter rEUCARCRn {
				IndexDomain: (PlanYear);
				Text: "Free row in OML, Rows: EUCARCR(*)";
				Definition: {
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rEUCARCRn(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUCARCRn(PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cY_rEUCARCRn(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
				}
			}
			Parameter rEUCARn {
				IndexDomain: (CarbonRegion,PlanYear);
				Text: "Free row in OML, Rows: EUCAR(**)(*)";
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rEUCARn(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rEUCARn(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rEUCARn(CarbonRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rEUCARn(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUCARn(CarbonRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cY_rEUCARn(CarbonRegion,PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
				}
			}
			Parameter rEUCARXXn {
				IndexDomain: (PlanYear);
				Text: "Free row in OML, Rows: EUCARXX(*)";
				Definition: {
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBSDGN_rEUCARXXn(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBSDGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					sum((SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB),
					coeff_cBX_DGN_rEUCARXXn(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB) *
					      cBX_DGN(SupplyRegion_ALT1,PlantType,OwnerType,DistGenAvoidStep,PlanYear_ALTB))
					+
					coeff_cCAROTHX_rEUCARXXn(PlanYear) *
					      cCAROTHX(PlanYear)
					+
					sum((SupplyRegion_ALT1,PlantType,PlanYear_ALTB),
					coeff_cEXXX_DGN_rEUCARXXn(PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) *
					      cEXXX_DGN(SupplyRegion_ALT1,PlantType,PlanYear_ALTB))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cF_rEUCARXXn(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cF(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
					+
					sum((CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption),
					coeff_cT_rEUCARXXn(PlanYear,CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption) *
					      cT(CoalSupplyCurve,FuelRegion_ALT1,PlantType_ALT2,ACIOption,PlanYear))
					+
					sum((FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason),
					coeff_cY_rEUCARXXn(PlanYear,FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason) *
					      cY(FuelRegion_ALT1,PlantType,ECPFuelType,GasSeason,PlanYear))
				}
			}
			Parameter rEUNOXn {
				IndexDomain: (NOXRegion,PlanYear);
				Text: "Free row in OML, Rows: EUNOX(**)(*)";
				Definition: {
					coeff_cCTLNX_rEUNOXn(NOXRegion,PlanYear) *
					      cCTLNX(NOXRegion,PlanYear)
					+
					sum((PlantType),
					coeff_cEUN_rEUNOXn(NOXRegion,PlanYear,PlantType) *
					      cEUN(PlantType,NOXRegion,PlanYear))
					+
					sum((PlantType),
					coeff_cEVN_rEUNOXn(NOXRegion,PlanYear,PlantType) *
					      cEVN(PlantType,NOXRegion,PlanYear))
					+
					coeff_cSVNOX_rEUNOXn(NOXRegion,PlanYear) *
					      cSVNOX(NOXRegion,PlanYear)
				}
			}
			Parameter rEUSO2Xn {
				IndexDomain: (SO2Region,PlanYear);
				Text: "Free row in OML, Rows: EUSO2X(*)(*)";
				Definition: {
					sum((PlanYear_ALTB),
					coeff_cBNKSO2_rEUSO2Xn(SO2Region,PlanYear,PlanYear_ALTB) *
					      cBNKSO2(SO2Region,PlanYear_ALTB))
					+
					sum((PlanYear_ALTB),
					coeff_cBNKXTR_rEUSO2Xn(SO2Region,PlanYear,PlanYear_ALTB) *
					      cBNKXTR(SO2Region,PlanYear_ALTB))
					+
					coeff_cCTLSO2_rEUSO2Xn(SO2Region,PlanYear) *
					      cCTLSO2(SO2Region,PlanYear)
					+
					sum((PlantType),
					coeff_cEUSO_rEUSO2Xn(SO2Region,PlanYear,PlantType) *
					      cEUSO(PlantType,SO2Region,PlanYear))
					+
					coeff_cEUSORS_rEUSO2Xn(SO2Region,PlanYear) *
					      cEUSORS(SO2Region,PlanYear)
				}
			}
			Parameter rFCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear);
				Text: "Free row in OML, Rows: F(*)(**)CAP(*)";
				Definition: {
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB),
					coeff_cB_DSP_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) *
					      cB_DSP(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB),
					coeff_cBDSPSUB_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) *
					      cBDSPSUB(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBSNUC_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBSNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType,OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBXNUC_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBXNUC(SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB))
					+
					sum((PlantType),
					coeff_cE_MR_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType) *
					      cE_MR(SupplyRegion_ALT1,PlantType,PlanYear))
					+
					sum((NaturalGasGroup,PlantType,NGCommitYear),
					coeff_cE_rFCAPn(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,NaturalGasGroup,PlantType,NGCommitYear) *
					      cE(NaturalGasGroup,PlantType,NGCommitYear))
					+
					sum((PlantType,RetireGroup),

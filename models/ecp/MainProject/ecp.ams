				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					1
					endif
				}
				Comment: "EP$BDSP,78";
			}
			Parameter ccalc_cBDSPSUB_rFCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep_ALT1) <= MAX(1,ESTSWTCH(PlantType)) and PlantType_ALT2=PlantType and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB and OML Rows: F(*)(**)CAP(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					1
					endif
				}
				Comment: "EP$BDSP,78";
			}
			Parameter ccalc_cB_DSP_rCXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and PlantType_ALT2=PlantType and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP and OML Rows: C(*)(**)X(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					-1
					endif
				}
				Comment: "EP$BDSP,79";
			}
			Parameter ccalc_cBDSPSUB_rCXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,PlantType,OwnerType,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType in DSP_Types_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep_ALT1) <= MAX(1,ESTSWTCH(PlantType)) and PlantType_ALT2=PlantType and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2 and ord(Season)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB and OML Rows: C(*)(**)X(*)(*)(*)"
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					-1
					endif
				}
				Comment: "EP$BDSP,79";
			}
			Parameter ccalc_cB_DSP_rFDVSle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) | PlantType in DSP_Types_ and UPTTYP(PlantType)<=NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CoalDemandRegion_ALT1)=EPCLMP(FuelRegion_ALT1) and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP and OML Rows: FDV(*)S(**)(*)"
				}
				Definition: {
					!	IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					!	(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					!	-8.760 * 0.0001 * AVG_HTRT(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)) *
					!	B_HTRT_ADJ(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear_ALTB) * UPMCF(PlantType) * CMM_SDV_PRF(element(DiversityProfile_, NEW_SDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear))
					!	endif
					
					! exclude new coal from diversity constraints - causes unexpected duals and impact on build decisions
				}
				Comment: "EP$BDSP,80";
			}
			Parameter ccalc_cBDSPSUB_rFDVSle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType in DSP_Types_ and UPTTYP(PlantType)<= NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CoalDemandRegion_ALT1)=EPCLMP(FuelRegion_ALT1) and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep_ALT1) <= MAX(1,ESTSWTCH(PlantType)) and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB and OML Rows: FDV(*)S(**)(*)"
				}
				Definition: {
					!	IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					!	(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					!	-8.760 * 0.0001 * AVG_HTRT(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)) *
					!	B_HTRT_ADJ(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear_ALTB) * UPMCF(PlantType) * CMM_SDV_PRF(element(DiversityProfile_, NEW_SDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear))
					!	endif
					
					! exclude new coal from diversity constraints - causes unexpected duals and impact on build decisions
				}
				Comment: "EP$BDSP,80";
			}
			Parameter ccalc_cB_DSP_rFDVLle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB) | PlantType in DSP_Types_ and UPTTYP(PlantType)<= NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CoalDemandRegion_ALT1)=EPCLMP(FuelRegion_ALT1) and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSP and OML Rows: FDV(*)L(**)(*)"
				}
				Definition: {
					!	IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					!	(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					!	-8.760 * 0.0001 * AVG_HTRT(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)) *
					!	B_HTRT_ADJ(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear_ALTB) * UPMCF(PlantType) * CMM_LDV_PRF(element(DiversityProfile_, NEW_LDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear))
					!	endif
					
					! exclude new coal from diversity constraints - causes unexpected duals and impact on build decisions
				}
				Comment: "EP$BDSP,81";
			}
			Parameter ccalc_cBDSPSUB_rFDVLle {
				IndexDomain: {
					(CoalDemandRegion_ALT1,PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,FuelRegion_ALT1,ElasticityStep_ALT1,PlanYear_ALTB) | PlantType in DSP_Types_ and UPTTYP(PlantType)<= NW_COAL('1') and
					ord(SupplyRegion_ALT1)<=UNRGNS('1') and ord(CoalDemandRegion_ALT1)=EPCLMP(FuelRegion_ALT1) and
					FL_CNXT_CST(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ORD(ElasticityStep_ALT1) <= MAX(1,ESTSWTCH(PlantType)) and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, PlantType) and Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)(*)(*)(*)!DSPSUB and OML Rows: FDV(*)L(**)(*)"
				}
				Definition: {
					!	IF (OLYEAR(PlanYear_ALTB, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					!	(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear_ALTB, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					!	-8.760 * 0.0001 * AVG_HTRT(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)) *
					!	B_HTRT_ADJ(PlantType, FuelRegion_ALT1, SupplyRegion_ALT1, PlanYear_ALTB) * UPMCF(PlantType) * CMM_LDV_PRF(element(DiversityProfile_, NEW_LDV_INDX(CoalDemandRegion_ALT1)), TYR2(PlanYear))
					!	endif
					
					! exclude new coal from diversity constraints - causes unexpected duals and impact on build decisions
				}
				Comment: "EP$BDSP,81";
			}
		}
		DeclarationSection EP_BLD_Completed {
			Parameter ccalc_cRHS_rLDGXXle {
				IndexDomain: (SupplyRegion_ALT1,DistGenAvoidStep,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: L(*)DGXX(*)(*)";
				Definition: {
					!
					!        LIMIT DISTRIBUTED GENERATION BUILDS TO NEW DEMAND GROWTH
					!
					IF (PlanYear = '1')THEN
					    0.0
					 ELSE
					
					   MAX(EPPEAK(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) - EPPEAK(ExplicitPlanningHorizon_element(Prior_PlanYear_member(PlanYear)),SupplyRegion_ALT1,cyr),0.0) * EPDPCT(DistGenAvoidStep,SupplyRegion_ALT1,cyr)
					ENDIF
				}
			}
		}
		DeclarationSection EP_BLDLIM_Completed {
			Parameter ccalc_cRHS_rLBLDXle {
				IndexDomain: (SupplyRegion,PlantType) | ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					IF (UPBLDREG(PlantType,SupplyRegion) > 0.0 AND UPBLDREG(PlantType,SupplyRegion) < 999.0) THEN
					    UPBLDREG(PlantType,SupplyRegion)
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rLUBLDXle {
				IndexDomain: PlantType;
				Definition: {
					IF (UPBLDREG_us00(PlantType) > 0.0 AND UPBLDREG_us00(PlantType) < 999.0) THEN
					    UPBLDREG_us00(PlantType)
					 ENDIF
				}
			}
		}
		DeclarationSection EP_BRNW_Completed {
			Parameter HYDFAC {
				Text: "ANNUAL HYDRO CAPACITY FACTOR ADJUSTMENT";
				Definition: 1;
			}
			Parameter TMP_ECF {
				IndexDomain: (OtherRenewable, SupplyRegion);
				Definition: MAX( EPECFC(OtherRenewable, first(ExplicitPlanningHorizon_), SupplyRegion, cyr), 0.01);
			}
			Parameter TMP_RCF {
				IndexDomain: (OtherRenewable, SupplyRegion);
				Definition: MAX( EPRCFC(OtherRenewable, SupplyRegion, cyr), 0.01);
			}
			Parameter FOM_EXX0_RNW {
				IndexDomain: (RetireGroup, OtherRenewable, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, OtherRenewable, RetirementYear, SupplyRegion, cyr)>0 OR (UPVTYP(OtherRenewable)= 1 AND UPBLDREG(OtherRenewable, SupplyRegion)>0)) THEN
					if USW_ERET('1')=1 then
					if ord(FullPlanningHorizon)=1 then
					0
					else
					EPGFOM(RetireGroup, OtherRenewable, SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
					endif
				}
			}
			Parameter FOM_EXXX_RNW {
				IndexDomain: (OtherRenewable, SupplyRegion, FullPlanningHorizon)| ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, OtherRenewable,Explicit2FullPlanningHorizon(FullPlanningHorizon), SupplyRegion, cyr)>0 OR (UPVTYP(OtherRenewable)= 1 AND UPBLDREG(OtherRenewable, SupplyRegion)>0)) THEN
					if ord(FullPlanningHorizon)=1 then
					0
					else
					if OtherRenewable=WIHY_Element then
					EPFOM(OtherRenewable, SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					else
					EPIRFOM(RnwStor(OtherRenewable), SupplyRegion, cyr) * UPGNPD(MNUMYRF_KYR(FullPlanningHorizon))
					endif
					endif
					endif
				}
			}
			Parameter SHR_FLRG_EXX0 {
				IndexDomain: {
					(FuelRegion, PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and FRG_EMM_MAP(SupplyRegion, FuelRegion)>0 and
					ord(FuelRegion)<=UNFRGN('1') and (PlantType=WIWD_Element or PlantType=WIBI_Element)
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion)>0)) AND
					USW_ERET('1')=1 THEN
					max(0.1, (EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
					sum(RetireGroup, EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr))))
					endif
				}
			}
			Parameter TOT_FLRG_EXX0 {
				IndexDomain: (PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1') and ord(PlanYear)>UPRTLT('1') and (PlantType=WIWD_Element or PlantType=WIBI_Element);
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion)>0)) AND
					USW_ERET('1')=1 THEN
					sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_EXX0(FuelRegion, PlantType, PlanYear, SupplyRegion))
					endif
				}
			}
			Parameter SHR_FLRG_EXXX {
				IndexDomain: {
					(FuelRegion, PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1') and FRG_EMM_MAP(SupplyRegion, FuelRegion)>0 and
					ord(FuelRegion)<=UNFRGN('1') and (PlantType=WIWD_Element or PlantType=WIBI_Element)
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion)>0)) THEN
					if TST_RNW(SupplyRegion, PlantType, PlanYear)>0 then
					max(1, (EPECAP(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
					EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr) -
					if ord(PlanYear)>UPRTLT('1') then
					sum(RetireGroup, EPGCAP(FuelRegion, RetireGroup, PlantType, SupplyRegion, cyr))
					endif))
					endif
					endif
				}
			}
			Parameter TOT_FLRG_EXXX {
				IndexDomain: (PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1');
				Definition: sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_EXXX(FuelRegion, PlantType, PlanYear, SupplyRegion));
			}
			Parameter SHR_FLRG_EMRX {
				IndexDomain: {
					(FuelRegion, PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1') and FRG_EMM_MAP(SupplyRegion, FuelRegion)>0 and
					ord(FuelRegion)<=UNFRGN('1') and (PlantType=WIWD_Element or PlantType=WIBI_Element)
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion)>0)) THEN
					if TST_MR_RNW(SupplyRegion, PlantType, PlanYear)>0 then
					EPECAP_MR(FuelRegion, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					endif
					endif
				}
			}
			Parameter TOT_FLRG_EMRX {
				IndexDomain: (PlantType, PlanYear, SupplyRegion) | ord(SupplyRegion)<=UNRGNS('1');
				Definition: sum(FuelRegion |ord(FuelRegion)<=UNFRGN('1'), SHR_FLRG_EMRX(FuelRegion, PlantType, PlanYear, SupplyRegion));
			}
			Parameter TST_RNW {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					max(ECP_MIN('1'), (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr) -
					EPECAP_MR(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)) * 0.001 -
					if ord(PlanYear_ALTB)>UPRTLT('1') then
					sum(RetireGroup, EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion_ALT1, cyr)*0.001)
					endif)
					endif
				}
			}
			Parameter TST_MR_RNW {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if PlantType<>WIHY_Element then
					EPECAP_MR(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr) * 0.001
					else
					0
					endif
					endif
				}
			}
			Parameter GEN_RNW_Intermediate {
				IndexDomain: {
					(SupplyRegion,OwnerType,ElasticityStep,PlanYear,PlanYear_ALTB) | ord(SupplyRegion)<=UNRGNS('1') and EPIROVR(WIHY_Element, SupplyRegion, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIHY_Element)
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, WIHY_Element) <= UNXPH('1') AND UPBLDTYP(SupplyRegion)=ord(OwnerType) AND UPVTYP(WIHY_Element)= 1) THEN
					IF (UPAVLYR(WIHY_Element)<= FULLYEAR_ALT(PlanYear_ALTB, WIHY_Element) AND EPIROVR(RnwStor(WIHY_Element), SupplyRegion, cyr) AND
					 (UPBLDREG_us00(WIHY_Element)> 0 AND UPBLDREG(WIHY_Element, SupplyRegion)>0) ) THEN
					sum(SliceGroup| ord(SliceGroup)<= EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr),
					EPRSCFC(WIHY_Element, ElasticityStep_Element(ElasticityStep), Season_elementx(Seasonx_SliceGroup(SliceGroup, PlanYear, SupplyRegion), SupplyRegion), SupplyRegion, cyr) * HYDFAC *
					EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr))
					endif
					endif
				}
			}
			Parameter GEN_RNW {
				IndexDomain: {
					(SupplyRegion,OwnerType,ElasticityStep,PlanYear,PlanYear_ALTB) | ord(SupplyRegion)<=UNRGNS('1') and EPIROVR(WIHY_Element, SupplyRegion, cyr)<9000 and
					ord(PlanYear)>=OLYEAR(PlanYear_ALTB, WIHY_Element)
				}
				Definition: {
					IF (OLYEAR(PlanYear_ALTB, WIHY_Element) <= UNXPH('1') AND UPBLDTYP(SupplyRegion)=ord(OwnerType) AND UPVTYP(WIHY_Element)= 1) THEN
					IF (UPAVLYR(WIHY_Element)<= FULLYEAR_ALT(PlanYear_ALTB, WIHY_Element) AND EPIROVR(RnwStor(WIHY_Element), SupplyRegion, cyr) AND
					 (UPBLDREG_us00(WIHY_Element)> 0 AND UPBLDREG(WIHY_Element, SupplyRegion)>0) ) THEN
					if GEN_RNW_Intermediate(SupplyRegion, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB) <=0 then
					0.0001
					else
					GEN_RNW_Intermediate(SupplyRegion, OwnerType, ElasticityStep, PlanYear, PlanYear_ALTB)
					endif
					endif
					endif
				}
			}
			Parameter ccalc_cEXX0_RNW_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIHY_Element
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					( -max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
				}
				Comment: "EP$BRNW,1";
			}
			Parameter ccalc_cEXX0_RNW_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlantType<>WIHY_Element and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)>0 and
					 -max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
				}
				Comment: "EP$BRNW,2";
			}
			Parameter ccalc_cEXX0_RNW_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIHY_Element
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-max(UPRNWSHR(PlantType)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(PlantType)>0  and
					 -max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
				}
				Comment: "EP$BRNW,3";
			}
			Parameter ccalc_cEXX0_RNW_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIHY_Element and SupplyRegion_ALT2=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					(TMP_ECF(PlantType, SupplyRegion_ALT1) - TMP_RCF(PlantType, SupplyRegion_ALT1)) * 8.76 *
					(GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear))) $
					(GRD_RATS(PlantType, SupplyRegion_ALT1)>=0  and
					 abs((TMP_ECF(PlantType, SupplyRegion_ALT1) - TMP_RCF(PlantType, SupplyRegion_ALT1)) * 8.76 *
					 (GRD_RATS(PlantType, SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1, ExplicitPlanningHorizon_element(PlanYear)))) >= ECP_MIN('1'))
					endif
				}
				Comment: "EP$BRNW,6";
			}
			Parameter ccalc_cEXX0_RNW_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion_ALT1, cyr) * 0.001
					else
					inf
					endif
				}
				Comment: "EP$BRNW,7";
			}
			Parameter ccalc_cEXX0_RNW_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: ECPCOSTS"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					max(0,
					(sum(FullPlanningHorizon, !PVV_Function(FOM_EXX0_RNW(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_ALT1,cyr))) *
					FOM_EXX0_RNW(RetireGroup, PlantType, SupplyRegion_ALT1, FullPlanningHorizon) / ((1 + EPDSCRT('1',SupplyRegion_ALT1,cyr)) ^ ord(FullPlanningHorizon)))*
					sum(PlanYear| PlanYear=RetirementPlanYear, PWF_Function(EPDSCRT('1',SupplyRegion_ALT1,cyr),UNXPH01)(PlanYear)) - (ord(RetireGroup)-1))*
					(1.0 - UPRETFHU('1')))
					endif
				}
				Comment: "EP$BRNW,8";
			}
			Parameter ccalc_cEXX0_RNW_rCXsxle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,Seasonx,PlanYear,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and (PlantType=WIWD_Element or PlantType=WIBI_Element) and FRG_EMM_MAP(SupplyRegion_ALT1, FuelRegion_ALT1)>0 and ord(Seasonx)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: C(*)(**)X(*)(*)(*)!x"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-max(0, (SHR_FLRG_EXX0(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion_ALT1) /$ TOT_FLRG_EXX0(PlantType, PlanYear, SupplyRegion_ALT1))) $
					(-max(0, (SHR_FLRG_EXX0(FuelRegion_ALT1, PlantType, PlanYear, SupplyRegion_ALT1) /$ TOT_FLRG_EXX0(PlantType, PlanYear, SupplyRegion_ALT1))) < -ECP_MIN('1'))
					endif
				}
				Comment: "EP$BRNW,10";
			}
			Parameter ccalc_cEXX0_RNW_r2P2le {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,RetireGroup) | ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType=WIP2_Element and (UPTOPR(PlantType)=1 OR UPTOPR(PlantType)=3) and
					LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and ord(LoadSegment)=1
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: 2(*)P2(*)(*)(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-1
					endif
				}
				Comment: "EP$BRNW,11";
			}
			Parameter ccalc_cEXX0_RNW_rEXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIWD_Element and PlantType<>WIBI_Element and PlantType<>WIP2_Element and PlantType<>WIHY_Element and
					(UPTOPR(PlantType)=1 OR UPTOPR(PlantType)=3) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: E(*)(**)XX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-EP_SP_CAP_FAC(Season_elementx(Seasonx, SupplyRegion_ALT1), PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)
					endif
				}
				Comment: "EP$BRNW,13";
			}
			Parameter ccalc_cEXX0_RNW_rCle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,Seasonx,LoadGroup,LoadSegment,PlanYear,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIWD_Element and PlantType<>WIBI_Element and PlantType<>WIP2_Element and PlantType<>WIHY_Element and
					(UPTOPR(PlantType)=1 OR UPTOPR(PlantType)=3) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
					and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: C(*)(**)(*)(*)(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 and SR_CREDIT(PlantType)>0 THEN
					-1
					endif
				}
				Comment: "EP$BRNW,15";
			}
			Parameter ccalc_cEXX0_RNW_rCXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,Seasonx,PlanYear,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType<>WIWD_Element and PlantType<>WIBI_Element and (UPTOPR(PlantType)<>1 and UPTOPR(PlantType)<>3) and ord(Seasonx)<=EPNMSP('1', SupplyRegion_ALT1, cyr)
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: C(*)(**)XX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					-1
					endif
				}
				Comment: "EP$BRNW,17";
			}
			Parameter ccalc_cEXX0_RNW_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and SupplyRegion_ALT1=SupplyRegion_ALTX
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					if PlantType=WIHY_Element then
					RNWFAC('1')
					else
					UPCCR(PlantType)
					endif
					endif
				}
				Comment: "EP$BRNW,18";
			}
			Parameter ccalc_cEXX0_RNW_rTOTCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1')
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: TOTCAP(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					1
					endif
				}
				Comment: "EP$BRNW,19";
			}
			Parameter ccalc_cEXX0_RNW_rLP2XXXle {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					ord(PlanYear)>UPRTLT('1') and PlantType=WIP2_Element and UPP2LIM(ModelYear_MNUMYRF(PlanYear), SupplyRegion_ALT1)<1
				}
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: L(*)P2XXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 THEN
					1
					endif
				}
				Comment: "EP$BRNW,20";
			}
			Parameter ccalc_cEXX0_RNW_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,RetireGroup) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XX(*)0!RNW and OML Rows: R(*)MXRET0"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, RetirementYear, SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) AND
					USW_ERET('1')=1 and RET_GRP(PlantType)>0 and UPRETRAT('1')>0 THEN
					1
					endif
				}
				Comment: "EP$BRNW,21";
			}
			Parameter ccalc_cEXXX_RNW_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: LBOUND"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					max(ECP_MIN('1'), (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr) -
					EPECAP_MR(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)) * 0.001 -
					if ord(PlanYear_ALTB)>UPRTLT('1') then
					sum(RetireGroup, EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion_ALT1, cyr)*0.001)
					endif)
					endif
				}
				Comment: "EP$BRNW,22";
			}
			Parameter ccalc_cEXXX_RNW_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					max(ECP_MIN('1'), (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr) -
					EPECAP_MR(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)) * 0.001 -
					if ord(PlanYear_ALTB)>UPRTLT('1') then
					sum(RetireGroup, EPGCAP(FuelRegion0, RetireGroup, PlantType, SupplyRegion_ALT1, cyr)*0.001)
					endif)
					else
					inf
					endif
				}
				Comment: "EP$BRNW,22";
			}
			Parameter ccalc_cEMRX_RNW_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: LBOUND"
				}
				Definition: TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear);
				Comment: "EP$BRNW,23";
			}
			Parameter ccalc_cEMRX_RNW_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1');
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					if PlantType=WIHY_Element or TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)
					else
					inf
					endif
				}
				Comment: "EP$BRNW,23";
			}
			Parameter ccalc_cEXXX_RNW_rFGENge {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType,PlanYear,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType<>WIHY_Element and
					PlanYear=PlanYear_ALTB
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_RNW(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					-max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					( -max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,24";
			}
			Parameter ccalc_cEMRX_RNW_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType<>WIHY_Element;
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					-max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					( -max((TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,25";
			}
			Parameter ccalc_cEXXX_RNW_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlanYear=PlanYear_ALTB and PlantType<>WIHY_Element and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_RNW(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					-max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)>0 and
					 -max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,26";
			}
			Parameter ccalc_cEMRX_RNW_rGRNWXXge {
				IndexDomain: {
					(RPSRegion,PlanYear,SupplyRegion_ALT1,PlantType) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and
					PlantType<>WIHY_Element and RPSRegion=MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: E(*)(**)MRX(*)!RNW and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_MR_RNW(SupplyRegion_ALT1, PlantType, PlanYear)>0 then
					-max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWSHRR(PlantType, SupplyRegion_ALT1)>0 and
					 -max(UPRNWSHRR(PlantType, SupplyRegion_ALT1)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,27";
			}
			Parameter ccalc_cEXXX_RNW_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,PlanYear_ALTB) | PlantType in OtherRenewable_ and ord(SupplyRegion_ALT1)<=UNRGNS('1') and PlantType<>WIHY_Element and
					PlanYear=PlanYear_ALTB and SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: E(*)(**)XXX(*)!RNW and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (EPECAP(FuelRegion0, PlantType, ExplicitPlanningHorizon_element(PlanYear_ALTB), SupplyRegion_ALT1, cyr)>0 OR (UPVTYP(PlantType)= 1 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0)) THEN
					if TST_RNW(SupplyRegion_ALT1, PlantType, PlanYear_ALTB)>0 then
					-max(UPRNWSHR(PlantType)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) $
					(UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(PlantType)>0  and
					 -max(UPRNWSHR(PlantType)*(TMP_RCF(PlantType, SupplyRegion_ALT1) - TMP_ECF(PlantType, SupplyRegion_ALT1)) * 8.76, 0) < -ECP_MIN('1'))
					endif
					endif
				}
				Comment: "EP$BRNW,28";

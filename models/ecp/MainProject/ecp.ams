				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				1 - ccalc_cUMR_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)
				endif;
				
				!OBJECTIVE FUNCTION VALUE ; COMPUTE VARIABLE OPERATING COST
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				VOMCST_ORNW(OtherRenewable, SupplyRegion_SUB, PlanYear)
				endif;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * VOMCST_ORNW(OtherRenewable, SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				(1 - UPFORT(OtherRenewable)) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				VOMCST_ORNW(OtherRenewable, SupplyRegion_SUB, PlanYear)
				endif;
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				
				!EP$ORNW,46 (1)
				ccalc_cZXrnw_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,46 (2)
				ccalc_cOXX_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,47 (1)
				ccalc_cZMrnw_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,47 (2)
				ccalc_cOMR_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)  and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,48 (1)
				ccalc_cJX_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,48 (2)
				ccalc_cJXX_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,49 (1)
				ccalc_cJM_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,49 (2)
				ccalc_cJMR_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,50 (1)
				ccalc_cUX_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,50 (2)
				ccalc_cUXX_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,51 (1)
				ccalc_cUM_ECPCOSTS((SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,51 (2)
				ccalc_cUMR_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!PUT BIOMASS OPERATE IN FUEL SUPPLY ROW
				!EP$ORNW,52
				VALUE_FLC(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) :=
				  EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * 0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				  AVG_HTRT(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear));
				
				ccalc_cZXrnw_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 THEN
				  VALUE_FLC(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx)
				endif;
				
				!EP$ORNW,53
				ccalc_cZMrnw_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and
				EPECAP_MR(FuelRegion, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * 0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				AVG_HTRT_MR(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
				endif;
				
				!EP$ORNW,54
				VALUE_FLC_MIN_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) :=
				  0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				AVG_HTRT(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) *
				  IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				   SR_MIN_CF(OtherRenewable)
				  else
				   0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				  endif;
				
				ccalc_cJX_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable)>0 THEN
				  VALUE_FLC_MIN_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx)
				endif;
				
				!EP$ORNW,55
				VALUE_FLC_MAX_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) :=
				  (1 - UPFORT(OtherRenewable)) * 0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				  AVG_HTRT(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear));
				
				ccalc_cUX_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable)>0 THEN
				   VALUE_FLC_MAX_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx)
				endif;
				
				!EP$ORNW,56
				ccalc_cJM_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				AVG_HTRT_MR(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				
				!EP$ORNW,57
				ccalc_cUM_rFWDXXXle((CoalDemandRegion_EPCLMP(FuelRegion), PlanYear, SupplyRegion_SUB, FuelRegion, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				(1 - UPFORT(OtherRenewable)) * 0.001 * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				AVG_HTRT_MR(OtherRenewable, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))
				endif;
				
				! new intersections with CCATS CCS capture constraint (for BECCS) - 26 is hard-coded carbon content used for biomass here
				ccalc_cZXrnw_rZCSRGeq((CensusRegion_EPCSMP(FuelRegion),PlanYear,SupplyRegion_SUB,FuelRegion,OtherRenewable,Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and UPPCEF(OtherRenewable) > 0.0 ) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 THEN
				   UPPCEF(OtherRenewable) * VALUE_FLC(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) * (26) * 0.001 * (44.0 / 12.0)
				endif;
				
				ccalc_cJX_rZCSRGeq((CensusRegion_EPCSMP(FuelRegion),PlanYear,SupplyRegion_SUB,FuelRegion,OtherRenewable,Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and UPPCEF(OtherRenewable) > 0.0 ) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable) > 0 THEN
				   UPPCEF(OtherRenewable) * VALUE_FLC_MIN_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) * (26) * 0.001 * (44.0 / 12.0)
				endif;
				
				ccalc_cUX_rZCSRGeq((CensusRegion_EPCSMP(FuelRegion),PlanYear,SupplyRegion_SUB,FuelRegion,OtherRenewable,Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion)>0 and UPPCEF(OtherRenewable) > 0.0 ) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and WSTBMEL('1')>0 and SR_CREDIT(OtherRenewable) > 0 THEN
				   UPPCEF(OtherRenewable) * VALUE_FLC_MAX_SR(SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx) * (26) * 0.001 * (44.0 / 12.0)
				endif;
				
				!Include in Generation Row
				!ADJUST RPS GENERATION FOR DIFFERENCE BETWEEN CAPACITY FACTORS FOR EXISTING AND NEW PLANTS
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				(1 - UPFORT(OtherRenewable)) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				abs(VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))<ECP_MIN('1')):=0;
				
				!EP$ORNW,58 (1)
				ccalc_cZXrnw_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,58 (2)
				ccalc_cOXX_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,59 (1)
				ccalc_cZMrnw_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,59 (2)
				ccalc_cOMR_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,60 (1)
				ccalc_cJX_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,60 (2)
				ccalc_cJXX_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,61 (1)
				ccalc_cJM_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,61 (2)
				ccalc_cJMR_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,62 (1)
				ccalc_cUX_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,62 (2)
				ccalc_cUXX_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,63 (1)
				ccalc_cUM_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,63 (2)
				ccalc_cUMR_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!INCLUDE IN RENEWABLE GENERATION BOUND ROW
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) THEN
				UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 THEN
				UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) * (1 - UPFORT(OtherRenewable)) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				!EP$ORNW,64 (1)
				ccalc_cZXrnw_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,64 (2)
				ccalc_cOXX_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,65 (1)
				ccalc_cZMrnw_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,65 (2)
				ccalc_cOMR_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,66 (1)
				ccalc_cJX_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,66 (2)
				ccalc_cJXX_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,67 (1)
				ccalc_cJM_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,67 (2)
				ccalc_cJMR_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,68 (1)
				ccalc_cUX_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,68 (2)
				ccalc_cUXX_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,69 (1)
				ccalc_cUM_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,69 (2)
				ccalc_cUMR_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!If National RPS and Regional and National Contributions Differ
				
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(OtherRenewable)>0 THEN
				UPRNWSHR(OtherRenewable) * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(OtherRenewable)>0 THEN
				UPRNWSHR(OtherRenewable) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWSHR(OtherRenewable)>0 THEN
				UPRNWSHR(OtherRenewable) * (1 - UPFORT(OtherRenewable)) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				!EP$ORNW,70 (1)
				ccalc_cZXrnw_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,70 (2)
				ccalc_cOXX_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,71 (1)
				ccalc_cZMrnw_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,71 (2)
				ccalc_cOMR_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,72 (1)
				ccalc_cJX_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,72 (2)
				ccalc_cJXX_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,73 (1)
				ccalc_cJM_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,73 (2)
				ccalc_cJMR_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,74 (1)
				ccalc_cUX_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,74 (2)
				ccalc_cUXX_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,75 (1)
				ccalc_cUM_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, FuelRegion_ALT1, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,75 (2)
				ccalc_cUMR_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!row to exclude existing generation from baseline
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0 THEN
				EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0 THEN
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) *
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				SR_MIN_CF(OtherRenewable)
				else
				0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)
				endif
				endif;
				VALUE_MIN_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr)):=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and SR_CREDIT(OtherRenewable)>0 and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0 THEN
				(1 - UPFORT(OtherRenewable)) * SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear)
				endif;
				VALUE_MAX_SR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) |
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)<ECP_MIN('1')):=0;
				
				!EP$ORNW,76 (1)
				ccalc_cZXrnw_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,76 (2)
				ccalc_cOXX_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,77 (1)
				ccalc_cZMrnw_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,77 (2)
				ccalc_cOMR_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,78 (1)
				ccalc_cJX_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,78 (2)
				ccalc_cJXX_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,79 (1)
				ccalc_cJM_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,79 (2)
				ccalc_cJMR_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MIN_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,80 (1)
				ccalc_cUX_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) := VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,80 (2)
				ccalc_cUXX_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,81 (1)
				ccalc_cUM_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, FuelRegion_ALT1, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				if EPECAP_MR(FuelRegion_ALT1, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!EP$ORNW,81 (2)
				ccalc_cUMR_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				if EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				VALUE_MAX_SR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)
				endif;
				
				!!hydro will always be here
				CAP_MR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element) := EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				CAP_NMR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx)) :=
				EPECAP(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 - CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!REVISE UPPER BOUND ON 'YY' OPERATE
				Empty VALUE, VALUE_MIN_SR, VALUE_MAX_SR;
				VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx):= inf;
				VALUE((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and OtherRenewable<>WIP2_Element):=
				IF OtherRenewable=WIHY_Element THEN
				MAX(0,CAP_NMR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)) * (1.0 - UPFORT(OtherRenewable))
				else
				MAX(0,CAP_NMR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx))
				endif;
				VALUE_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) := inf;
				VALUE_MR((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and OtherRenewable<>WIP2_Element and
				CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx)):= MAX(0,CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx));
				
				!EP$ORNW,104
				ccalc_cO_HYD_UBOUND((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,105
				ccalc_cJ_MINSR_UBOUND((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0):=VALUE(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!EP$ORNW,106
				ccalc_cH_UBOUND((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(OtherRenewable)>0):=VALUE_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
				
				!LOAD CONSTRAINTS
				
				!EP$ORNW,107
				ccalc_cO_HYD_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				 LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				
				!EP$ORNW,108
				ccalc_cH_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and  (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				
				!EP$ORNW,113
				ccalc_cO_HYD_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				UPFORT(OtherRenewable) * SR_CREDIT(OtherRenewable);
				
				!EP$ORNW,114
				ccalc_cH_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				UPFORT(OtherRenewable) * SR_CREDIT(OtherRenewable);
				
				!EP$ORNW,115
				ccalc_cJ_MINSR_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				SR_MIN_CF(OtherRenewable);
				
				!EP$ORNW,116
				ccalc_cJ_MINSR_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				(1 - SR_MIN_CF(OtherRenewable)) * SR_CREDIT(OtherRenewable);
				
				!ADD ELECTRICITY CONSUMPTION REQUIREMENT FOR PUMP STORAGE UNITS
				!EP$ORNW,117
				ccalc_cO_HYD_rPSELXle((SupplyRegion_SUB, Seasonx, PlanYear, WIPS_Element, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(WIPS_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=
				UFACPS('1') * (1.0 - UPFORT(WIPS_Element)) *
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				
				ccalc_cO_HYD_rPSELXle((SupplyRegion_SUB, Seasonx, PlanYear, WIPS_Element, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rPSELXle(SupplyRegion_SUB, Seasonx, PlanYear, WIPS_Element, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,118
				ccalc_cJ_MINSR_rPSELXle((SupplyRegion_SUB, Seasonx, PlanYear, WIPS_Element, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(WIPS_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(WIPS_Element)>0) := UFACPS('1') * SR_MIN_CF(WIPS_Element) *
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				
				!EP$ORNW,119
				ccalc_cO_HYD_rP2ELXeq((SupplyRegion_SUB, Seasonx, PlanYear, WIP2_Element, LoadGroup, LoadSegment1) | Condition_ORNW_Hydro(WIP2_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) ):=
				UFACP2('1') * (1.0 - UPFORT(WIP2_Element)) *
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment1, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				
				ccalc_cO_HYD_rP2ELXeq((SupplyRegion_SUB, Seasonx, PlanYear, WIP2_Element, LoadGroup, LoadSegment1) |
				abs(ccalc_cO_HYD_rP2ELXeq(SupplyRegion_SUB, Seasonx, PlanYear, WIP2_Element, LoadGroup, LoadSegment1))<ECP_MIN('1')):=0;
				
				!EP$ORNW,120
				ccalc_cJ_MINSR_rP2ELXeq((SupplyRegion_SUB, Seasonx, PlanYear, WIP2_Element, LoadGroup, LoadSegment1) | Condition_ORNW_Hydro(WIP2_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and SR_CREDIT(WIP2_Element)>0) := UFACP2('1') * SR_MIN_CF(WIP2_Element) *
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment1, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				
				!EP$ORNW,121
				ccalc_cO_HYD_r2P2le((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment1, PlanYear, WIP2_Element) | Condition_ORNW_Hydro(WIP2_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) ):= 1;
				
				!EP$ORNW,122
				ccalc_cJ_MINSR_r2P2le((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment1, PlanYear, WIP2_Element) | Condition_ORNW_Hydro(WIP2_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and SR_CREDIT(WIP2_Element)>0) := 1;
				
				!OBJECTIVE FUNCTION
				!EP$ORNW,123
				ccalc_cO_HYD_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				(OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				(1.0 - UPFORT(OtherRenewable)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				VOMCST_ORNW(OtherRenewable, SupplyRegion_SUB, PlanYear) * 0.001;
				
				!EP$ORNW,124
				ccalc_cJ_MINSR_ECPCOSTS((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				SR_MIN_CF(OtherRenewable) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				VOMCST_ORNW(OtherRenewable, SupplyRegion_SUB, PlanYear) * 0.001;
				
				!Include in Row for Generation
				!EP$ORNW,125
				ccalc_cO_HYD_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				 LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cO_HYD_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rFGENge(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,126
				ccalc_cH_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and  (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cH_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cH_rFGENge(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,127
				ccalc_cJ_MINSR_rFGENge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				SR_MIN_CF(OtherRenewable) /
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				
				!INCLUDE IN RENEWABLE GENERATION BOUND ROW
				!EP$ORNW,128
				ccalc_cO_HYD_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				 LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)/HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cO_HYD_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rGRNWXXge(MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,129
				ccalc_cH_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and  (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)/HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cH_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cH_rGRNWXXge(MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,130
				ccalc_cJ_MINSR_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				SR_MIN_CF(OtherRenewable) * UPRNWSHRR(OtherRenewable, SupplyRegion_SUB) /
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				ccalc_cJ_MINSR_rGRNWXXge((MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cJ_MINSR_rGRNWXXge(MAP_NERC_TO_RPS_RGN(SupplyRegion_SUB), PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!If National RPS and Regional and National Contributions Differ
				!EP$ORNW,131
				ccalc_cO_HYD_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				 LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				UPRNWSHR(OtherRenewable) *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)/HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cO_HYD_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rGURNWXge(SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,132
				ccalc_cH_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and  (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				UPRNWSHR(OtherRenewable) *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)/HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cH_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cH_rGURNWXge(SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,133
				ccalc_cJ_MINSR_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1)):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				SR_MIN_CF(OtherRenewable) * UPRNWSHR(OtherRenewable) /
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				ccalc_cJ_MINSR_rGURNWXge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cJ_MINSR_rGURNWXge(SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!row to exclude existing generation from baseline
				!EP$ORNW,134
				ccalc_cO_HYD_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				 LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				 (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cO_HYD_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rGBASge(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,135
				ccalc_cH_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and  (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				IF OtherRenewable=WIHY_Element THEN
				HY_CF_ECP(LoadSegment_to_StepsPerGroup(LoadSegment), ECPLoadGroup_element(LoadGroup), SupplyRegion_SUB)
				else
				1.0 - UPFORT(OtherRenewable)
				endif;
				ccalc_cH_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cH_rGBASge(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,136
				ccalc_cJ_MINSR_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and
				UPRNWBND(ModelYear_MNUMYRX(PlanYear))>0.005 AND UPRNWBAS(OtherRenewable)>0):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				SR_MIN_CF(OtherRenewable) /
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				ccalc_cJ_MINSR_rGBASge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cJ_MINSR_rGBASge(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!GRID RESILIENCE STANDARD, IF APPROPRIATE
				!EP$ORNW,141
				ccalc_cO_HYD_rGRGRDge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				(OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and GRD_RATS(OtherRenewable, SupplyRegion_SUB)>0):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				(1.0 - UPFORT(OtherRenewable)) * (GRD_RATS(OtherRenewable, SupplyRegion_SUB) - GRD_NRYR(SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)))/
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				ccalc_cO_HYD_rGRGRDge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cO_HYD_rGRGRDge(SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!EP$ORNW,142
				ccalc_cJ_MINSR_rGRGRDge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				OtherRenewable<>WIHY_Element and SR_CREDIT(OtherRenewable)>0 and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and (OtherRenewable<>WIP2_Element or LoadSegment=LoadSegment1) and
				GRD_RATS(OtherRenewable, SupplyRegion_SUB)>0):=
				EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001 *
				SR_MIN_CF(OtherRenewable) * (GRD_RATS(OtherRenewable, SupplyRegion_SUB) - GRD_NRYR(SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))) /
				IF OtherRenewable=WIHY_Element THEN
				HYDFAC_ALT(SupplyRegion_SUB, PlanYear)
				else
				1
				endif;
				ccalc_cJ_MINSR_rGRGRDge((SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment) |
				abs(ccalc_cJ_MINSR_rGRGRDge(SupplyRegion_SUB, PlanYear, SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment))<ECP_MIN('1')):=0;
				
				!CAPACITY BALANCE ROW
				!EP$ORNW,143
				ccalc_cO_HYD_rEXXeq((SupplyRegion_SUB, WIPS_Element, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(WIPS_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) ):=
				(1.0 - UPFORT(WIPS_Element)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), WIPS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!EP$ORNW,144 (2)
				ccalc_cO_HYD_rEXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element and OtherRenewable<>WIPS_Element):=
				(1.0 - UPFORT(OtherRenewable)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!EP$ORNW,144 (1)
				ccalc_cH_rEXXeq((SupplyRegion_SUB, WIPS_Element, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(WIPS_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				CAP_MR(SupplyRegion_SUB, WIPS_Element, PlanYear, Seasonx)):=
				(1.0 - UPFORT(WIPS_Element)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), WIPS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!EP$ORNW,144 (2)
				ccalc_cH_rEXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element and OtherRenewable<>WIPS_Element):=
				(1.0 - UPFORT(OtherRenewable)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!COUNT GENERATION FOR MUSTRUN CONSTRAINT
				!EP$ORNW,145
				ccalc_cH_rQXXXge((SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element):=
				(1.0 - UPFORT(OtherRenewable)) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) * 0.001;
				
				!EP$ORNW,146
				ccalc_cO_HYD_rCle((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(WIPS_Element)>0 and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element):= 1;
				
				!EP$ORNW,147
				ccalc_cH_rKHY_le((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(WIPS_Element)>0 and CAP_MR(SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx) and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element):= 1;
				
				!EP$ORNW,148
				ccalc_cJ_MINSR_rCle((SupplyRegion_SUB, OtherRenewable, Seasonx, LoadGroup, LoadSegment, PlanYear) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(WIPS_Element)>0 and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element):= 1;
				
				!EP$ORNW,149 (1)
				ccalc_cJ_MINSR_rEXXeq((SupplyRegion_SUB, WIPS_Element, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(WIPS_Element, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(WIPS_Element)>0):=
				SR_MIN_CF(WIPS_Element) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), WIPS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!EP$ORNW,149 (2)
				ccalc_cJ_MINSR_rEXXle((SupplyRegion_SUB, OtherRenewable, Seasonx, PlanYear, LoadGroup, LoadSegment) | Condition_ORNW_Hydro(OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				SR_CREDIT(OtherRenewable)>0 and OtherRenewable<>WIP2_Element and OtherRenewable<>WIHY_Element and OtherRenewable<>WIPS_Element):=
				SR_MIN_CF(OtherRenewable) * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) /
				(EPESCFC(Season_elementx(Seasonx, SupplyRegion_SUB), OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) *
				SHOURS(Season_elementx(Seasonx, SupplyRegion_SUB), SupplyRegion_SUB, PlanYear) * 1000.0);
				
				!SET UP ROWS TO REQUIRE PUMP STORAGE UNITS TO USE OFF-PEAK ELECTRICITY
				empty ccalc_cSEL_UBOUND,ccalc_cSEL_rLEL2ge,ccalc_cSEL_rPSELXle,ccalc_c2EL_rLEL2ge,ccalc_c2EL_r2P2le;
				!EP$ORNW,154
				ccalc_cSEL_UBOUND(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear):=inf;
				ccalc_cSEL_UBOUND((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear) | PS_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=
				0.001 * PS_TEST(SupplyRegion_SUB, PlanYear);
				
				!EP$ORNW,155
				ccalc_cSEL_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear) | PS_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):= -1;
				
				!EP$ORNW,158
				ccalc_cSEL_rPSELXle((SupplyRegion_SUB, Seasonx, PlanYear, LoadGroup, LoadSegment) | PS_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=
				-0.001 * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr);
				
				!EP$ORNW,159
				ccalc_c2EL_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear) | P2_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):= -1;
				
				!EP$ORNW,162
				ccalc_c2EL_rP2ELXeq((SupplyRegion_SUB, Seasonx, PlanYear, LoadGroup, LoadSegment) | P2_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=
				-0.001 * EPWDTH(LoadSlice_element(SupplyRegion_SUB, LoadGroup, LoadSegment, PlanYear), ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr);
				
				!EP$ORNW,159
				ccalc_c2EL_r2P2le((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment1, PlanYear) | P2_TEST(SupplyRegion_SUB, PlanYear)>0 and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB))):= 1;
			}
			Parameter VALUE {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
			Parameter VALUE_MR {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
			Parameter VALUE_MIN_SR {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
			Parameter VALUE_MAX_SR {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
			Parameter VALUE_FLC {
				IndexDomain: (SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx);
			}
			Parameter VALUE_FLC_MIN_SR {
				IndexDomain: (SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx);
			}
			Parameter VALUE_FLC_MAX_SR {
				IndexDomain: (SupplyRegion_SUB,FuelRegion,OtherRenewable,PlanYear,Seasonx);
			}
			Parameter CAP_MR {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
			Parameter CAP_NMR {
				IndexDomain: (SupplyRegion_SUB, OtherRenewable, PlanYear, Seasonx);
			}
		}
		Procedure EP_RFS_Calculations {
			Body: {
				!T_BM((BiomassStep, CoalDemandRegion, FullPlanningHorizon, BiomassType)| ord(BiomassStep)<=NM_BM_SUP_STP('1') and WDSUP_AVL(BiomassType)=1 AND MP_BM_PW(BiomassType)> 0):=
				!if ord(BiomassStep)=1 then
				!max(0, WDSUP_Q(BiomassStep_element(BiomassStep), CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType))
				!else
				!max(0, (WDSUP_Q(BiomassStep_element(BiomassStep), CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType) -
				!WDSUP_Q(BiomassStep_element(BiomassStep)-1, CoalDemandRegion, BiomassPlanYear(FullPlanningHorizon), BiomassType)))
				!endif;
				!
				!Value_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon, BiomassType):=
				!PVV_Function(T_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon+2, BiomassType),ord(FullPlanningHorizon),AVGDCR);
				!
				!Biomass_Bound(BiomassStep, CoalDemandRegion, PlanYear, BiomassType):=
				!if ord(PlanYear)<UNXPH('1') then
				!T_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon_PlanYear(PlanYear), BiomassType)
				!else
				!sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				!Value_BM(BiomassStep, CoalDemandRegion, FullPlanningHorizon, BiomassType))/
				!ONEVAL(PlanYear)
				!endif;
				!
			}
			Parameter Value_BM {
				IndexDomain: (BiomassStep,CoalDemandRegion,FullPlanningHorizon,BiomassType);
			}
		}
		Procedure EP_SUBLIM_Calculations {
			Body: {
				LIMSUB_calc((PlantType) | UPSUBCAS(PlantType)>0 and (CURIYR('1') + UHBSYR('1'))=UPSTYR('1') ) :=
				if UPSUBLIM(PlantType)>0 then
				  if (PlantType<>WIAN_Element and PlantType<>WISM_Element and PlantType<>WIGN_Element) or UPSUBFCF(PlantType)<=0 then
				    1
				  else
				    UPSUBLIM(PlantType)
				  endif
				endif;
				
				CAPSUB_calc((PlantType) | UPSUBCAS(PlantType)>0 and (CURIYR('1') + UHBSYR('1'))=UPSTYR('1') ) :=
				if UPSUBLIM(PlantType)>0 then
				  if (PlantType<>WIAN_Element and PlantType<>WISM_Element and PlantType<>WIGN_Element) or UPSUBFCF(PlantType)<=0 then
				    UPSUBLIM(PlantType)
				  else
				    0
				  endif
				endif;
				
				! If the year is greater than the first year set the _calc value to Tranfer variable from previous year
				LIMSUB_calc((PlantType) | (CURIYR('1') + UHBSYR('1'))>UPSTYR('1') ) := LIMSUB(PlantType);
				CAPSUB_calc((PlantType) | (CURIYR('1') + UHBSYR('1'))>UPSTYR('1') ) := CAPSUB(PlantType);
				
				CAPSUB_calc((PlantType) | LIMSUB_calc(PlantType)>0 and UPSUBCAS(PlantType)=1 and
				((PlantType<>WIAN_Element and PlantType<>WISM_Element and PlantType<>WIGN_Element) or UPSUBFCF(PlantType)<=0) and
				((UPGSUBPT(PlantType)<= 0 and UHBSYR('1') + CURIYR('1') + UPPLYR(PlantType) > UPGSYL(PlantType)) or
				(UPGSUBPT(PlantType)> 0 and UPGSUBYR(PlantType, element(MNUMYR_, min(UNYEAR('1') ,CURIYR('1') + UPPLYR(PlantType))))<= 0)) ) := 0;
				
				LIMSUB_calc((PlantType) | UPSUBCAS(PlantType)>0 and LIMSUB_calc(PlantType)>0 and
				((PlantType<>WIAN_Element and PlantType<>WISM_Element and PlantType<>WIGN_Element) or UPSUBFCF(PlantType)<=0) and
				CAPSUB_calc(PlantType)< (UPMSSIZ(PlantType) * UPLRMIN(PlantType) * 0.001)) :=0;
				
				!EP$SUBLIM,1
				ccalc_cRHS_rLUSUBXle((PlantType) | UPSUBCAS(PlantType)>0 and LIMSUB_calc(PlantType)>0 and
				((PlantType<>WIAN_Element and PlantType<>WISM_Element and PlantType<>WIGN_Element) or UPSUBFCF(PlantType)<=0) and
				CAPSUB_calc(PlantType)>= (UPMSSIZ(PlantType) * UPLRMIN(PlantType) * 0.001) and
				0 < UPSUBLIM(PlantType)< 999):= CAPSUB_calc(PlantType);
			}
		}
		Procedure EP_PM_LF_Calculations {
			Body: {
				Condition_PX((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) | FuelRegion_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				WPTTYP(DSP_Types, SupplyRegion_SUB)>0):=
				!if there is existing non-mrun capacity, or new build type (forced capacity)
				IF ( (EPECAP(FuelRegion, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)-
				EPECAP_MR(FuelRegion, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr))>0 OR UPVTYP(DSP_Types)=1) OR
				 !or in future years, if new build/retrofit type is possible
				(ord(PlanYear) > 1 AND AVG_HTRT(DSP_Types, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0 AND FULLYEAR_PM(PlanYear, DSP_Types) >= UPAVLYR(DSP_Types)) THEN
				1
				endif;
				
				Condition_PM((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) | FuelRegion_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				WPTTYP(DSP_Types, SupplyRegion_SUB)>0):=
				! if existing must-run or future must-run for retrofit/new build is possible
				IF (EPECAP_MR(FuelRegion, DSP_Types, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) OR (ord(PlanYear) > 1 AND
				AVG_HTRT_MR(DSP_Types, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0 AND FULLYEAR_PM(PlanYear, DSP_Types) >= UPAVLYR(DSP_Types))  THEN
				1
				endif;
				
				Condition_PH((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) | FuelRegion_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				WPTTYP(DSP_Types, SupplyRegion_SUB)>0):=
				!if HRI option possible
				IF (HTRT_TEST_PM(DSP_Types, PlanYear)= 0 AND HTRT_CAP(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				AVG_HTRT_MOD(DSP_Types, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0 AND ord(PlanYear) > 1) THEN
				1
				endif;
				
				Condition_PY((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) | FuelRegion_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				WPTTYP(DSP_Types, SupplyRegion_SUB)>0):=
				!if HRI option possible for a must-run
				IF (HTRT_TEST_PM(DSP_Types, PlanYear)= 0 AND HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(DSP_Types), FuelRegion,ExplicitPlanningHorizon_element(PlanYear))>0 AND
				AVG_HTRT_MR_MOD(DSP_Types, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))>0 AND ord(PlanYear) > 1) THEN
				1
				endif;
				
				
				!EP$PM$LF,2
				ccalc_cPX_ECPCOSTS((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PX(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=0.001;
				
				!EP$PM$LF,3
				ccalc_cPX_rMXXge((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, DSP_Types, Season) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PX(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=SHOURS(Season, SupplyRegion_SUB, PlanYear);
				
				!EP$PM$LF,4
				ccalc_cPX_rCXle((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear, DSP_Types) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PX(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):= 1;
				
				!EP$PM$LF,5
				ccalc_cPM_ECPCOSTS((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=0.001;
				
				!EP$PM$LF,6
				ccalc_cPM_rMXXge((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, DSP_Types, Season) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=SHOURS(Season, SupplyRegion_SUB, PlanYear);
				
				!EP$PM$LF,7
				ccalc_cPM_rCMle((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear, DSP_Types) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PM(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):= 1;
				
				!EP$PM$LF,8
				ccalc_cPH_ECPCOSTS((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PH(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=0.001;
				
				!EP$PM$LF,9
				ccalc_cPH_rMXXge((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, DSP_Types, Season) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PH(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=SHOURS(Season, SupplyRegion_SUB, PlanYear);
				
				!EP$PM$LF,10
				ccalc_cPH_rCHle((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PH(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):= 1;
				
				!EP$PM$LF,11
				ccalc_cPY_ECPCOSTS((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PY(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=0.001;
				
				!EP$PM$LF,12
				ccalc_cPY_rMXXge((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, DSP_Types, Season) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PY(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=SHOURS(Season, SupplyRegion_SUB, PlanYear);
				
				!EP$PM$LF,13
				ccalc_cPY_rCYle((SupplyRegion_SUB, DSP_Types, FuelRegion, Season, PlanYear) | ord(Season)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				Condition_PY(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):= 1;
			}
		}
		Procedure EP_ST_RPS_Calculations {
			Body: {
				! Estimate generation from existing units that qualify, take generation from total generation row by EMM region and ECP type and give credit to state RPS
				PlantType_noINT_:=PlantType_-Intermittent_-WIHY_Element;
				TRIAL_AGE(RPSTranche):=CURIYR('1') + UHBSYR('1') - ST_RPS_SYR(RPSTranche);
				
				AVG_PV_CF((SupplyRegion_SUB,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType) | ord(PlantType)=WIPV('1')):=(DPVTOTCAPNR(SupplyRegion_SUB,LastModelYear_MNUMYR(PlanYear))*0.001 * DPV_CF(LoadGroup,LoadSegment,Seasonx,SupplyRegion_SUB,PlanYear) +
				 UPV_CF(LoadGroup,LoadSegment,Seasonx,SupplyRegion_SUB,PlanYear) *
				 (EPECAP('00',WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_SUB,cyr)*0.001 - DPVTOTCAPNR(SupplyRegion_SUB,LastModelYear_MNUMYR(PlanYear))*0.001))/ EPECAP('00',WIPV_Element,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_SUB,cyr)/0.001;
				
				GWH((PlantType_noINT, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(ST_RPS_ECP_EX(PlantType_noINT, RPSTranche)>0 OR ST_RPS_ECP_NW(PlantType_noINT, RPSTranche)>0)):=
				sum(ExistingPlantGroup | PlantType_noINT=ULECPT_Map(ExistingPlantGroup) and SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and
				ULAGE(ExistingPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(ExistingPlantGroup),
				ULCAPC(ExistingPlantGroup) * 0.001 * EPECFC(PlantType_noINT, first(ExplicitPlanningHorizon), SupplyRegion_SUB, cyr) * 8.760);
				
				GWH((WIHY_Element, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(ST_RPS_ECP_EX(WIHY_Element, RPSTranche)>0 OR ST_RPS_ECP_NW(WIHY_Element, RPSTranche)>0)):=
				sum((HYPlantGroup,SliceGroup) | ord(SliceGroup)<=EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				SupplyRegion_SUB=ULORGN_MAP(HYPlantGroup) and
				ULAGE(HYPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(HYPlantGroup),
				ULCAPC(HYPlantGroup) * (1 - UPFORT(WIHY_Element)) * 0.001 *
				HY_CF_ECP(StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), SupplyRegion_SUB) *
				EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/1000.0);
				
				
				GWH_Int(Intermittent, ActiveSliceGroup, PlanYear, SupplyRegion_SUB):=
				UPICFC1(Intermittent, ECPLoadGroup_fromSliceGroup(ActiveSliceGroup, PlanYear, SupplyRegion_SUB), StepsPerGroup_fromSliceGroup(ActiveSliceGroup, PlanYear, SupplyRegion_SUB), SupplyRegion_SUB, cyr)*
				0.001 * EPECFC(Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/ EPIACF(Intermittent, SupplyRegion_SUB, cyr) *
				EP_SP_CAP_FAC(Season_element2(ActiveSliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)*
				EPWDTH(ActiveSliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/1000.0;
				
				GWH((Intermittent, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and Intermittent<>WIPT_Element and Intermittent<>WIPV_Element and
				(ST_RPS_ECP_EX(Intermittent, RPSTranche)>0 OR ST_RPS_ECP_NW(Intermittent, RPSTranche)>0)):=
				sum((IntermittentPlantGroup,ActiveSliceGroup) | !ord(SliceGroup)<=EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				Intermittent=ULECPT_Map(IntermittentPlantGroup) and SupplyRegion_SUB=ULORGN_MAP(IntermittentPlantGroup) and
				ULAGE(IntermittentPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(IntermittentPlantGroup),
				ULCAPC(IntermittentPlantGroup) * GWH_Int(Intermittent, ActiveSliceGroup, PlanYear, SupplyRegion_SUB));
				
				!UPICFC1(Intermittent, ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), SupplyRegion_SUB, cyr)*
				!0.001 * EPECFC(Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/ EPIACF(Intermittent, SupplyRegion_SUB, cyr) *
				!EP_SP_CAP_FAC(Season_element2(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB), Intermittent, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)*
				!EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/1000.0);
				
				GWH((WIPT_Element, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(ST_RPS_ECP_EX(WIPT_Element, RPSTranche)>0 OR ST_RPS_ECP_NW(WIPT_Element, RPSTranche)>0)):=
				sum((PTPlantGroup,SliceGroup) | ord(SliceGroup)<=EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				SupplyRegion_SUB=ULORGN_MAP(PTPlantGroup) and ULAGE(PTPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(PTPlantGroup),
				ULCAPC(PTPlantGroup) *
				UPICFC1(WIPT_Element, ECPLoadGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), StepsPerGroup_fromSliceGroup(SliceGroup, PlanYear, SupplyRegion_SUB), SupplyRegion_SUB, cyr)*
				0.001 * EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/1000.0);
				
				GWH((WIPV_Element, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(ST_RPS_ECP_EX(WIPT_Element, RPSTranche)>0 OR ST_RPS_ECP_NW(WIPT_Element, RPSTranche)>0)):=
				sum((PVPlantGroup,SliceGroup) | ord(SliceGroup)<=EPNSTP(ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) and
				SupplyRegion_SUB=ULORGN_MAP(PVPlantGroup) and ULAGE(PVPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(PVPlantGroup),
				ULCAPC(PVPlantGroup) *
				AVG_PV_CF(SupplyRegion_SUB,Seasonx_SliceGroup(SliceGroup,PlanYear,SupplyRegion_SUB),LoadGroup_SliceGroup(SliceGroup,PlanYear,SupplyRegion_SUB), LoadSegment_SliceGroup(SliceGroup,PlanYear,SupplyRegion_SUB),PlanYear,WIPV_Element) *
				0.001 * EPWDTH(SliceGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)/1000.0);
				
				EX_GEN((PlantType, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(ST_RPS_ECP_EX(PlantType, RPSTranche)>0 OR ST_RPS_ECP_NW(PlantType, RPSTranche)>0)):=
				sum(ExistingPlantGroup | PlantType=ULECPT_Map(ExistingPlantGroup) and SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and
				ULAGE(ExistingPlantGroup)>=TRIAL_AGE(RPSTranche) and ST_RPS_STnm(RPSTranche)=ULSTATE(ExistingPlantGroup),
				ULTGEN_ECP(ExistingPlantGroup, ExplicitPlanningHorizon_element(PlanYear)) * 0.001 );
				
				EX_GEN((IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear) |ord(RPSTranche)<= NM_ST_RPS('1') and ord(PlanYear)>=2 and
				(UCPRNWIS(IntermittentRenStor) OR UCPINTIS(IntermittentRenStor)) and
				(EX_GEN(IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear)>0 or GWH(IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear)>0) and
				EX_GEN(IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear)> GWH(IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear)) :=
				GWH(IntermittentRenStor, SupplyRegion_SUB, RPSTranche, PlanYear);
				
				! Test if multiple tranches apply to the same state, if so, qualified generation can apply to all tranches in the state
				empty TST_STATES, AvailableSupplyState_;
				AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear):= SupplyState_;
				for RPSTranche | ord(RPSTranche)<=NM_ST_RPS('1') do
				
				SupplyState_Element:= element(SupplyState_,ST_RPS_STnm(RPSTranche));
				
				TST_STATES((SupplyState_Element, PlantType, SupplyRegion_SUB, PlanYear)| ord(PlanYear)>=2 and
				SupplyState_Element in AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear) and
				(ST_RPS_ECP_EX(PlantType, RPSTranche)>0 OR ST_RPS_ECP_NW(PlantType, RPSTranche)>0) and
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, ModelYear_MNUMYRF(PlanYear))>0 and
				EX_GEN(PlantType, SupplyRegion_SUB, RPSTranche, PlanYear) - 0.001 >= ECP_MIN('1')):=RPSTranche;
				
				AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear)-=SupplyState_Element $ TST_STATES(SupplyState_Element, PlantType, SupplyRegion_SUB, PlanYear);
				endfor;
				
				!EP$ST_RPS,12
				ccalc_cXX_UBOUND((SupplyState, PlantType, SupplyRegion_SUB, PlanYear) |
				EX_GEN(PlantType, SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), PlanYear) - 0.001 >= ECP_MIN('1')):=
				EX_GEN(PlantType, SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), PlanYear) - 0.001;
				
				ccalc_cXX_LBOUND((SupplyState, PlantType, SupplyRegion_SUB, PlanYear) |
				EX_GEN(PlantType, SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), PlanYear) - 0.001 >= ECP_MIN('1')):=
				EX_GEN(PlantType, SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), PlanYear) - 0.001;
				
				!EP$ST_RPS,13
				ccalc_cXX_rGRPSge((SupplyState, RPSTrancheID, PlanYear, PlantType, SupplyRegion_SUB)| ord(PlanYear)>=2 and Map_ST_RPS(SupplyState, RPSTrancheID)):=
				if (ST_RPS_ECP_EX(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID))>0 OR ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID))>0) and
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID), ModelYear_MNUMYRF(PlanYear))>0 and
				EX_GEN(PlantType, SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID), PlanYear) - 0.001 >= ECP_MIN('1') then
				ST_RPS_ECP_EX(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID))
				endif;
				
				!EP$ST_RPS,14
				ccalc_cXX_rFGENge((SupplyRegion_SUB, PlantType, PlanYear, SupplyState) |
				EX_GEN(PlantType, SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), PlanYear) - 0.001 >= ECP_MIN('1')):= -1;
				
				
				
				! Pull generation from generation balance rows to satisfy state RPS requirements
				!EP$ST_RPS,19
				ccalc_cNN_rGRPSge((SupplyState, RPSTrancheID, PlanYear, PlantType, SupplyRegion_SUB) | ord(PlanYear)>=2 and
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID), LastModelYear_MNUMYRF(PlanYear))>0 AND
				ST_RPS_EMM_MAP(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID))>0 and ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID))>0):=
				ST_RPS_ECP_NW(PlantType, RPSTranche_Element(SupplyState, RPSTrancheID));
				
				! Test if multiple tranches apply to the same state, if so, qualified generation can apply to all tranches in the state
				empty TST_STATES, AvailableSupplyState_;
				AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear):= SupplyState_;
				for RPSTranche | ord(RPSTranche)<=NM_ST_RPS('1') do
				
				SupplyState_Element:= element(SupplyState_,ST_RPS_STnm(RPSTranche));
				
				TST_STATES((SupplyState_Element, PlantType, SupplyRegion_SUB, PlanYear)| ord(PlanYear)>=2 and
				SupplyState_Element in AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear) and
				ST_RPS_EMM_MAP(SupplyRegion_SUB, RPSTranche)>0 and ST_RPS_ECP_NW(PlantType, RPSTranche)>0 and
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, LastModelYear_MNUMYRF(PlanYear))>0):=RPSTranche;
				AvailableSupplyState_(PlantType, SupplyRegion_SUB, PlanYear)-=SupplyState_Element $ TST_STATES(SupplyState_Element, PlantType, SupplyRegion_SUB, PlanYear);
				endfor;
				
				!EP$ST_RPS,20
				ccalc_cNN_rFGENge((SupplyRegion_SUB, PlantType, PlanYear, SupplyState) | ord(PlanYear)>=2 and
				ST_RPS_REQ(SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear), LastModelYear_MNUMYRF(PlanYear))>0 AND
				ST_RPS_EMM_MAP(SupplyRegion_SUB, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear))>0 and
				ST_RPS_ECP_NW(PlantType, TST_STATES(SupplyState, PlantType, SupplyRegion_SUB, PlanYear))):=-1;
				
				!Add cofiring if it qualifies
				!EP$ST_RPS,25
				ccalc_cGXCOF_rGRPSge(SupplyState, RPSTrancheID, PlanYear):=0;
				ccalc_cGXCOF_rGRPSge((SupplyState, RPSTrancheID, PlanYear) | ord(PlanYear)>=2 and sum(SupplyRegion_SUB|
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID), LastModelYear_MNUMYRF(PlanYear))>0 and
				ST_RPS_EMM_MAP(SupplyRegion_SUB, RPSTranche_Element(SupplyState, RPSTrancheID))>0,1)
				and ST_RPS_COFIRE(RPSTranche_Element(SupplyState, RPSTrancheID))>0):=
				ST_RPS_COFIRE(RPSTranche_Element(SupplyState, RPSTrancheID));
				
				! Test if multiple tranches apply to the same state, if so, qualified generation can apply to all tranches in the state
				empty TST_STATES1, AvailableSupplyState1_;
				AvailableSupplyState1_(SupplyRegion_SUB, PlanYear):= SupplyState_;
				for RPSTranche | ord(RPSTranche)<=NM_ST_RPS('1') do
				
				SupplyState_Element:= element(SupplyState_,ST_RPS_STnm(RPSTranche));
				
				TST_STATES1((SupplyState_Element, SupplyRegion_SUB, PlanYear)| ord(PlanYear)>=2 and
				SupplyState_Element in AvailableSupplyState1_(SupplyRegion_SUB, PlanYear) and
				ST_RPS_EMM_MAP(SupplyRegion_SUB, RPSTranche)>0 and ST_RPS_COFIRE(RPSTranche)>0 and
				ST_RPS_REQ(SupplyRegion_SUB, RPSTranche, LastModelYear_MNUMYRF(PlanYear))>0):=RPSTranche;
				AvailableSupplyState1_(SupplyRegion_SUB, PlanYear)-=SupplyState_Element $ TST_STATES1(SupplyState_Element, SupplyRegion_SUB, PlanYear);
				endfor;
				
				!EP$ST_RPS,26
				ccalc_cGXCOF_rFCFGENge((SupplyRegion_SUB, PlanYear, SupplyState) | ord(PlanYear)>=2 and
				ST_RPS_REQ(SupplyRegion_SUB, TST_STATES1(SupplyState, SupplyRegion_SUB, PlanYear), LastModelYear_MNUMYRF(PlanYear))>0 AND
				ST_RPS_EMM_MAP(SupplyRegion_SUB, TST_STATES1(SupplyState, SupplyRegion_SUB, PlanYear))>0 and
				ST_RPS_COFIRE(TST_STATES1(SupplyState, SupplyRegion_SUB, PlanYear))):=-1;
			}
			Parameter AVG_PV_CF {
				IndexDomain: (SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType);
			}
			Parameter TRIAL_AGE {
				IndexDomain: RPSTranche;
			}
			Set PlantType_noINT_ {
				SubsetOf: PlantType_;
				Index: PlantType_noINT;
			}
			Set AvailableSupplyState_ {
				IndexDomain: (PlantType, SupplyRegion_SUB, PlanYear);
				SubsetOf: SupplyState_;
			}
			Set AvailableSupplyState1_ {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
				SubsetOf: SupplyState_;
			}
			ElementParameter SupplyState_Element {
				Range: SupplyState_;
			}
			Parameter Test {
				IndexDomain: (SupplyState, PlantType, SupplyRegion_SUB, PlanYear);
			}
			ElementParameter TST_STATES1 {
				IndexDomain: (SupplyState, SupplyRegion_SUB, PlanYear);
				Range: RPSTranche_;
			}
			Parameter GWH_Int {
				IndexDomain: (Intermittent, SliceGroup, PlanYear, SupplyRegion_SUB);
			}
		}
		Procedure EP_COAL_Calculations {
			Body: {
				EPA111_YRS(FullPlanningHorizon | (ord(cyr) + UHBSYR('1') + ord(FullPlanningHorizon) - 1) <= UEPA_CLCFYR('1')) := 1;
				
				EPA_YRSHR(CoalGroup_SUB) := sum(FullPlanningHorizon| ord(FullPlanningHorizon)>= UNXPH('1'),
				EPA111_YRS(FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon))) /
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)>= UNXPH('1'),
				KW(FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)))
				;
				
				!EP$COAL,2
				ccalc_cZX_rCXle((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear, CoalPlant)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				 ((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))) :=
				if AVG_HTRT(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  -1
				endif;
				
				!EP$COAL,3
				ccalc_cZX_ECPCOSTS((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				 ((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))) :=
				if AVG_HTRT(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  UPGNPD(ModelYear_MNUMYRF(PlanYear)) *
				  if ord(PlanYear)<UNXPH('1') then 1000
				  else 2000 endif
				endif;
				
				!EP$COAL,5
				ccalc_cZM_rCMle((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear, CoalPlant)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				 ((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if EPECAP_MR(FuelRegion_ALT1, CoalPlant, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 or
				(ord(PlanYear)>1 and
				AVG_HTRT_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))) then
				  -1
				endif;
				
				!EP$COAL,6
				ccalc_cZM_ECPCOSTS((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if EPECAP_MR(FuelRegion_ALT1, CoalPlant, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 or
				(ord(PlanYear)>1 and
				AVG_HTRT_MR(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))) then
				  UPGNPD(ModelYear_MNUMYRF(PlanYear)) *
				  if ord(PlanYear)<UNXPH('1') then 200
				  else 2000 endif
				endif;
				
				!EP$COAL,8
				ccalc_cZH_rCHle((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				 ((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if ord(PlanYear)>1 and HTRT_CAP(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND HRIOVR(CoalPlant)>0 and
				AVG_HTRT_MOD(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  -1
				endif;
				
				!EP$COAL,9
				ccalc_cZH_ECPCOSTS((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if ord(PlanYear)>1 and HTRT_CAP(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND HRIOVR(CoalPlant)>0 and
				AVG_HTRT_MOD(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  UPGNPD(ModelYear_MNUMYRF(PlanYear)) *
				  if ord(PlanYear)<UNXPH('1') then 200
				  else 2000 endif
				endif;
				
				!EP$COAL,11
				ccalc_cZY_rCYle((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				 ((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if ord(PlanYear)>1 and HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND HRIOVR(CoalPlant)>0 and
				AVG_HTRT_MR_MOD(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  -1
				endif;
				
				!EP$COAL,12
				ccalc_cZY_ECPCOSTS((SupplyRegion_SUB, CoalPlant, FuelRegion_ALT1, Season, PlanYear)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				WPTTYP(CoalPlant, SupplyRegion_SUB)>0 and
				((C_EMM_CDS(SupplyRegion_SUB, CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1) OR
				(FL_CNXT_CST(SupplyRegion_SUB, FuelRegion_ALT1)>0 AND
				C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant), CoalDemandRegion_EPCLMP(FuelRegion_ALT1))=1 AND
				UPVTYP(CoalPlant)=1))):=
				if ord(PlanYear)>1 and HTRT_CAP_MR(SupplyRegion_SUB, CapacityType_element(CoalPlant), FuelRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear))>0 AND HRIOVR(CoalPlant)>0 and
				AVG_HTRT_MR_MOD(CoalPlant, FuelRegion_ALT1, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)) then
				  UPGNPD(ModelYear_MNUMYRF(PlanYear)) *
				  if ord(PlanYear)<UNXPH('1') then 200
				  else 2000 endif
				endif;
				
				!EP$COAL,18
				ccalc_cRHS_rOXXle((CoalGroup_SUB, PlanYear)| ord(PlanYear)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):=
				IF ECL_CAP(ExplicitPlanningHorizon_element(PlanYear)-1, CoalGroup_SUB)<=0 THEN
				   ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				ENDIF;
				
				!Create Coal to Natural Gas Conversion Vectors -
				!Note: unlike other retrofit options these vectors convert capacity for the rest of the planning horizon
				! set OV_CLtNG to 0 if EPA 111 is in effect and past deadline because conversion is no longer allowed
				OV_CLtNG(CoalGroup_SUB,PlanYear):=
				  IF (USW_EPA111('1') and (CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1) > UEPA_GSYR('1')) then
				     0
				  else
				     ECL_CL_NG_COST(CoalGroup_SUB)+ECL_CL_NG_TRAN(CoalGroup_SUB)
				  endif;
				
				!Only create conversion vectors for periods where retrofits and builds are allowed
				!EP$COAL,19
				ccalc_cNNG_UBOUND((CoalGroup_SUB, PlanYear) | (CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear)>0 and ord(PlanYear)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):=
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001;
				
				!EP$COAL,20
				ccalc_cNNG_rOXXle((CoalGroup_SUB, PlanYear, PlanYear) |
				(CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear)>0 and ord(PlanYear)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):= 1;
				
				!added to facilitate Gas-Coal cofiring instead of coal to gas conversion
				ccalc_cNNGCL_rOXXle((CoalGroup_SUB, PlanYear,Element(CommitYear_,ord(PlanYear)))|
				(CURIYR('1')+ord(PlanYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear)>0 and ord(PlanYear)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):= 1;
				
				
				VAL_CL_NG((SupplyRegion_SUB, Season, CoalGroup_SUB)|ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr)) :=
				-(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECL_SP_CAP_FAC(Season, CoalGroup_SUB);
				!Check for NaNQ
				VAL_CL_NG((SupplyRegion_SUB, Season, CoalGroup_SUB)| Mapval(VAL_CL_NG(SupplyRegion_SUB, Season, CoalGroup_SUB))>0):=-1;
				
				!EP$COAL,21
				ccalc_cNNG_rCXle((SupplyRegion_SUB, WING_Element, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and (CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				if ECL_MR(CoalGroup_SUB)<(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VAL_CL_NG(SupplyRegion_SUB, Season, CoalGroup_SUB)
				endif;
				
				ccalc_cNNG_rCMle((SupplyRegion_SUB, WING_Element, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and (CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				if ECL_MR(CoalGroup_SUB)>=(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VAL_CL_NG(SupplyRegion_SUB, Season, CoalGroup_SUB)
				endif;
				
				!EP$COAL,22
				ccalc_cNNG_rFCAPn((SupplyRegion_SUB, WING_Element, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB);
				
				!EP$COAL,23
				ccalc_cNNG_rRXXXXXge((SupplyRegion_SUB, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB);
				
				!EP$COAL,25
				ccalc_cNNG_rTOTCAPn((SupplyRegion_SUB, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB);
				
				!Planned Maintenance Requirement
				VAL_CL_NG1(SupplyRegion_SUB, PlanYear, CoalGroup_SUB) := - 8.760 *
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				if ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))>0 then
				  ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))
				else
				  UPPMRT(WING_Element)
				endif;
				!Check
				VAL_CL_NG1((SupplyRegion_SUB, PlanYear, CoalGroup_SUB)| abs(VAL_CL_NG1(SupplyRegion_SUB, PlanYear, CoalGroup_SUB))<ECP_MIN('1')):=0;
				
				!EP$COAL,26
				ccalc_cNNG_rMXXge((SupplyRegion_SUB, WING_Element, FuelRegion_CoalGroup(CoalGroup_SUB), PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				VAL_CL_NG1(SupplyRegion_SUB, PlanYear, CoalGroup_SUB);
				
				!EP$COAL,27
				CF_FL:=0.01;
				ccalc_cNNG_rFXXle((FuelRegion_CoalGroup(CoalGroup_SUB), WING_Element, GasSeason, PlanYear, CoalGroup_SUB, PlanYear_ALTB)|
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and
				OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>=0.001 and ord(PlanYear)>=ord(PlanYear_ALTB)):=
				SHOURS(GasSeason_element(GasSeason), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear_Two) * CF_FL * 0.001 *
				(ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear_ALTB), ExplicitPlanningHorizon_element(PlanYear_ALTB)) *
				(1.0 + UCL_CL_NG_HR_PEN('1')) -
				if ECL_MR(CoalGroup_SUB)<(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  AVG_HTRT(WING_Element, FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				  AVG_HTRT_MR(WING_Element, FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				!Calculate ccalc_cNNG_ECPCOSTS in Calculate_CLNNGCOSTS procedure
				!EP$COAL,28
				Calculate_CL_NNGCOSTS;
				
				CoalConfiguration_Mapping;
				CNFG_TST((CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear) or
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1):=
				IF ((USW_DSI('1')>0 AND BYR(PlanYear) + UHBSYR('1') <> UDSI_YR('1')) OR
				!After 40th Birthday or Required Year, only allow BACT approved configurations
				   (USW_BACT('1')>0 AND (BYR(PlanYear) + UHBSYR ('1')< UBACT_YR('1') OR AGE(CoalGroup_SUB, PlanYear) <=40)) OR
				   (USW_BACT('1')=0 AND USW_DSI('1')=0) OR (USW_DSI('1')>0 AND
				!EXCLUDE SMALL UNITS FROM MATS
				   ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)<=25)) THEN
				   1
				ELSE
				   UCL_NSR_CFG(CoalConfiguration)
				ENDIF;
				
				CNFG_TST((CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear) or
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1):=
				IF (USW_EPA111('1')>0 AND BYR(PlanYear) + UHBSYR('1') > UEPA_CLYR('1') AND UCL_CNFG('7',CoalConfiguration) <> 1 AND
				!only allow configs with CCS for 111d (2024) - excluding small units
				         ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>25 ) THEN
				   0
				ELSE
				   UCL_NSR_CFG(CoalConfiguration)
				ENDIF;
				
				!EXCLUDE UNITS WITH PLANNED RETROFITS
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration):=
				max(CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration),PLAN_TEST(CoalGroup_SUB) );
				
				ECPt_TO(CoalConfiguration):=element(PlantType_ECP_, UCL_ECP(CoalConfiguration));
				ECPt_TO1(CoalConfiguration):=element(PlantType_, UCL_ECP(CoalConfiguration));
				TST_ACI(PlanYear, CoalConfiguration) :=
				MAX((numACI, EmissionRank),ACI_OPT(numACI, EmissionRank, ECPt_TO(CoalConfiguration), LastModelYear_TYR(PlanYear)));
				
				CLSG_CCS((CoalGroup_SUB, PlanYear)|ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>= UPCCSCAP('1') and
				ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear)) < UPCCSHRT('1')
				 and ECL_SYR(CoalGroup_SUB) > UPCCSSYR and ECL_GRP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 ):=1;
				
				UVALUE(CoalGroup_SUB, PlanYear, CoalConfiguration) :=
				if CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and TST_ACI(PlanYear, CoalConfiguration)>0 then
				if (CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear) and
				(CURIYR('1')+ord(PlanYear)-1 < AYR or ord(PlanYear)=1)) or
				(CURIYR('1')+ord(PlanYear)-1 >= AYR and ord(PlanYear)>1 )!and (ECL_MR(CoalGroup_SUB)<2 or
				 !CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear)))
				 or PlanYear=UNXPH_PlanYear then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif
				endif;
				
				UVALUE((CoalGroup_SUB, PlanYear, CoalConfiguration) | CoalConfiguration<>I_CoalConfiguration(CoalGroup_SUB, PlanYear) and
				UCL_CNFG('7', CoalConfiguration)=1 and
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1)*=
				CLSG_CCS(CoalGroup_SUB, PlanYear);
				
				UVALUE_CGCF(CoalGroup_SUB,PlanYear) :=
				if ((CURIYR('1')+ord(PlanYear)-1 < AYR or ord(PlanYear)=1)) or
				(CURIYR('1')+ord(PlanYear)-1 >= AYR and ord(PlanYear)>1 )
				 or PlanYear=UNXPH_PlanYear  then
				   ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				!EP$COAL,29
				ccalc_cRETRO_UBOUND((CommitYear, CoalGroup_SUB, RetrofitCFG)| ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0):=
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG));
				
				!for coal part of NNG coal-gas cofiring
				ccalc_cNNGCL_UBOUND((CommitYear, CoalGroup_SUB)| ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				UVALUE_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear))>0 and ord(CommitYear)>1):=
				UVALUE_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear))*UEPA_CGSH('1');
				
				!
				!EP$COAL,30
				ccalc_cRETROHTRT_UBOUND((HTRTYear, CoalGroup_SUB, RetrofitCFG)| ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0 ):=
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,31 and 33
				ccalc_cRETRO_rOXXle((CoalGroup_SUB, PlanYear, CommitYear, RetrofitCFG)| ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0):=
				if ord(PlanYear)=ord(CommitYear) and ord(CommitYear)>1 then
				  1
				!Pass Capacity Forward once Fix Costs Are Paid but Only if capacity is still available in the next period
				elseif ord(PlanYear)=ord(CommitYear)+1 and ord(CommitYear)<UNXPH('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0.0001 then
				  -1
				endif;
				
				!EP$COAL,32 and 34
				ccalc_cRETROHTRT_rOXXle((CoalGroup_SUB, PlanYear, HTRTYear, RetrofitCFG)| ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0 ):=
				if ord(PlanYear)=ord(HTRTYear) and ord(HTRTYear)>1 then
				  1
				!Pass Capacity Forward once Fix Costs Are Paid but Only if capacity is still available in the next period
				elseif ord(PlanYear)=ord(HTRTYear)+1 and ord(HTRTYear)<UNXPH('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0.0001 then
				  -1
				endif;
				
				!CPENJJ Start
				HRMAX:=99999;
				
				CP_PEN((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				(CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear))):=1;
				
				!separate calculation for coal-gas cofiring
				CP_PEN_CGCF((CoalPlant, CoalGroup_SUB, PlanYear)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):=1;
				
				HRCPEN((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				(CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear))):= UECP_HTRT_ADJ(CoalPlant);
				
				!separate calculation for coal-gas cofiring
				HRCPEN_CGCF((CoalPlant, CoalGroup_SUB, PlanYear)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0):= UECP_HTRT_ADJ(CoalPlant);
				
				CP_PEN((ECPt_TO1(CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				UPSCPEN1(ECPt_TO1(CoalConfiguration)) < 0.999):= 1 - UPSCPEN1(ECPt_TO1(CoalConfiguration));
				
				CP_PEN((ECPt_TO1(CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				UCL_CNFG('7', CoalConfiguration)=1):=
				if ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear))>HRMAX then
				ECL_CCS_C(CoalGroup_SUB)*(HRMAX/
				ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear)))/
				HRCPEN(ECPt_TO1(CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)
				else
				1 - ECL_CCS_C(CoalGroup_SUB)
				endif;
				
				HRCPEN((ECPt_TO1(CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 and
				UCL_CNFG('7', CoalConfiguration)=1):=
				if ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear))>HRMAX then
				UECP_HTRT_ADJ(ECPt_TO1(CoalConfiguration))
				else
				ECL_CCS_H(CoalGroup_SUB)/ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear))
				endif;
				
				ECP_SHR((IECP_CL(CoalGroup_SUB, PlanYear, CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguration<>I_CoalConfiguration(CoalGroup_SUB, PlanYear) or PlanYear<>UNXPH_PlanYear):=1;
				
				!separate calculation for coal-gas cofiring
				ECP_SHR_CGCF((IECP_CL(CoalGroup_SUB, PlanYear, CoalConfiguration), CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguration<>I_CoalConfiguration(CoalGroup_SUB, PlanYear) or PlanYear<>UNXPH_PlanYear):=1;
				
				TECP((EMM_CL_ECPt_Element(CoalGroup_SUB, FullPlanningHorizon+2), CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(UNXPH_PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, UNXPH_PlanYear, CoalConfiguration)=1 and
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, UNXPH_PlanYear) and
				ord(FullPlanningHorizon)<=UNFPH('1')-UNXPH('1')+1):=1;
				
				TECP_CGCF((EMM_CL_ECPt_Element(CoalGroup_SUB, FullPlanningHorizon+2), CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(UNXPH_PlanYear), CoalGroup_SUB)>0 and
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, UNXPH_PlanYear) and
				ord(FullPlanningHorizon)<=UNFPH('1')-UNXPH('1')+1):=1;
				
				AN1((FullPlanningHorizon)| ord(FullPlanningHorizon)<=UNFPH('1')-UNXPH('1')+1) :=1;
				
				ECP_SHR((PlantType, CoalGroup_SUB, UNXPH_PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(UNXPH_PlanYear), CoalGroup_SUB)>0 and
				CNFG_TST(CoalGroup_SUB, UNXPH_PlanYear, CoalConfiguration)=1 and
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, UNXPH_PlanYear)):=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				TECP(PlantType, CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)))/
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				AN1(FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				!separate calculation for coal-gas cofiring
				ECP_SHR_CGCF((PlantType, CoalGroup_SUB, UNXPH_PlanYear, CoalConfiguration)|
				ECL_CAP(ExplicitPlanningHorizon_element(UNXPH_PlanYear), CoalGroup_SUB)>0 and
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, UNXPH_PlanYear)):=
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				TECP_CGCF(PlantType, CoalGroup_SUB, FullPlanningHorizon, CoalConfiguration) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)))/
				sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
				AN1(FullPlanningHorizon) / ((1 + EPUTDSCRT('1', SupplyRegion_CoalGroup(CoalGroup_SUB), cyr)) ^ ord(FullPlanningHorizon)));
				
				VALUE_CL((SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration)|ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, CoalConfiguration)>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, CoalConfiguration)>0) :=
				-(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECL_SP_CAP_FAC(Season, CoalGroup_SUB)*ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, CoalConfiguration) *
				CP_PEN(PlantType, CoalGroup_SUB, PlanYear, CoalConfiguration);
				
				!separate calculation for coal-gas cofiring
				VALUE_CL_CGCF((SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, Coalconfiguration)|ord(Season)<=EPNMSP('1',SupplyRegion_SUB,cyr) and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')=Coalconfiguration and
				ECP_SHR_CGCF(PlantType, CoalGroup_SUB, PlanYear, Coalconfiguration)>0) :=
				-(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECL_SP_CAP_FAC(Season, CoalGroup_SUB)*ECP_SHR_CGCF(PlantType, CoalGroup_SUB, PlanYear,CoalConfiguration) *
				CP_PEN_CGCF(PlantType, CoalGroup_SUB, PlanYear);
				
				!Check for NaNQ
				VALUE_CL((SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration)|
				Mapval(VALUE_CL(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration))>0):=0;
				
				!Check for NaNQ for coal-gas cofiring
				VALUE_CL_CGCF((SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration)|
				Mapval(VALUe_CL_CGCF(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration))>0):=0;
				
				!INTERSECT APPROPRIATE CAPACITY ROWS
				!EP$COAL,35
				ccalc_cRETRO_rCXle((SupplyRegion_SUB, PlantType, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0):=
				if ECL_MR(CoalGroup_SUB)<(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VALUE_CL(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))
				endif;
				
				!to handle coal part of coal-gas cofiring
				!EP$COAL,35a
				ccalc_cNNGCL_rCXle((SupplyRegion_SUB, PlantType, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, CommitYear, CoalGroup_SUB)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and (CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1 ):=
				!ECP_SHR(PlantType, CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, 'COL'))>0):=
				if ECL_MR(CoalGroup_SUB)<(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VALUE_CL_CGCF(SupplyRegion_SUB, PlantType, Season, PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL'))
				endif;
				
				ccalc_cRETRO_rCMle((SupplyRegion_SUB, PlantType, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0):=
				if ECL_MR(CoalGroup_SUB)>=(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VALUE_CL(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))
				endif;
				
				!EP$COAL,36
				ccalc_cRETROHTRT_rCHle((SupplyRegion_SUB, PlantType, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(HTRTYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				if ECL_MR(CoalGroup_SUB)<(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VALUE_CL(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))
				endif;
				
				ccalc_cRETROHTRT_rCYle((SupplyRegion_SUB, PlantType, FuelRegion_CoalGroup(CoalGroup_SUB), Season, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(HTRTYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				if ECL_MR(CoalGroup_SUB)>=(CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				  VALUE_CL(SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))
				endif;
				
				!TOTAL CAPACITY ROW BY REGION AND PLANT TYPE
				!EP$COAL,37
				ccalc_cRETRO_rFCAPn((SupplyRegion_SUB, PlantType, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				CP_PEN(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,38
				ccalc_cRETROHTRT_rFCAPn((SupplyRegion_SUB, PlantType, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(HTRTYear) and
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				ECP_SHR(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				CP_PEN(PlantType, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!RESERVE MARGIN ROW
				!EP$COAL,39
				ccalc_cRETRO_rRXXXXXge((SupplyRegion_SUB, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and
				ord(PlanYear)>UPPLYR(WICT_element)):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				ccalc_cRETRO_rRXXXXXn((SupplyRegion_SUB, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and
				ord(PlanYear)<=UPPLYR(WICT_element)):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!Added to handle coal part of coal-gas cofiring
				ccalc_cNNGCL_rRXXXXXge((SupplyRegion_SUB, PlanYear, CommitYear, CoalGroup_SUB)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and (CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1 and
				ord(PlanYear)>UPPLYR(WICT_element)):=
				  if (ord(PlanYear) < UNXPH('1')) then
				   (ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))
				  else
				    if (USW_EPA111('1') > 0) then
				      (ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB)) * EPA_YRSHR(CoalGroup_SUB)
				    else
				      (ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))
				    endif
				  endif;
				
				
				!Added to handle coal part of coal-gas cofiring
				!ccalc_cNNGCL_rRXXXXXn((SupplyRegion_SUB, PlanYear, CommitYear, CoalGroup_SUB)|
				!ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				!UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL'))>0 and
				!ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear) and ord(CommitYear) > 1 and
				!ord(PlanYear)<=UPPLYR(WICT_element)):=
				!(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				!CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL'));
				
				!EP$COAL,40
				ccalc_cRETROHTRT_rRXXXXXge((SupplyRegion_SUB, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(HTRTYear) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!MAXIMUM RETIREMENTS ROW
				!EP$COAL,41
				ccalc_cRETRO_rRMXRET0ge((SupplyRegion_SUB, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0):=
				IF (UCL_ECP(RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG)) >= WIPC('1') OR
				((USW_BACT('1') <= 0 OR (UHBSYR('1') + CURIYR('1') + UPRTLT('1')) < UBACT_YR('1')) AND
				(UHBSYR('1') + CURIYR('1') + UPRTLT('1')) <> UDSI_YR('1'))) THEN
				IF (UPRETRAT('1')>0 AND ord(CommitYear) = UPRTLT('1')+1 AND USW_ERET('1')=1) THEN
				    ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB)
				endif
				endif;
				
				!EP$COAL,42
				ccalc_cRETROHTRT_rRMXRET0ge((SupplyRegion_SUB, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				IF (UCL_ECP(RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG)) >= WIPC('1') OR
				((USW_BACT('1') <= 0 OR (UHBSYR('1') + CURIYR('1') + UPRTLT('1')) < UBACT_YR('1')) AND
				(UHBSYR('1') + CURIYR('1') + UPRTLT('1')) <> UDSI_YR('1'))) THEN
				IF (UPRETRAT('1')>0 AND ord(HTRTYear) = UPRTLT('1')+1 AND USW_ERET('1')=1) THEN
				    ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB)
				endif
				endif;
				
				!TOTAL CAPACITY ROW
				!EP$COAL,43
				ccalc_cRETRO_rTOTCAPn((SupplyRegion_SUB, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(CommitYear)):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!EP$COAL,44
				ccalc_cRETROHTRT_rTOTCAPn((SupplyRegion_SUB, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				!UVALUE>0 only when CNFG_TST=1, so CNFG_TST=1 condition is ommitted here
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)>0 and ord(PlanYear)=ord(HTRTYear) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				(ECL_RG_CAP(SupplyRegion_SUB, CoalGroup_SUB)/ECL_RG_CAP_us00(CoalGroup_SUB))*
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				Condition_COAL((CoalGroup_SUB, PlanYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0):=1;
				
				Condition_COAL_CGCF((CoalGroup_SUB, PlanYear)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0):=1;
				
				Condition_TZZ((CoalSupplyCurve_Dom, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				TBTU_COAL(CoalGroup_SUB)>0 and CMM_CL_BTUS(CoalSupplyCurve_Dom, CoalGroup_SUB)>0 and
				XCL_TR_T2(CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), cyr)>
				XCL_TR_T1(CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), cyr) and
				XCL_TR_T1(CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), cyr)< 900 ):=1;
				
				!Increase Amount of Coal Delivered from Each Supply Curve at Lower Transportation Rate
				T_BND((CoalSupplyCurve_Dom, beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				Condition_TZZ(CoalSupplyCurve_Dom, CoalGroup_SUB, PlanYear, RetrofitCFG) ):=
				ECP_SHR(beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) *
				CMM_TRANS_PRF(TransportationProfile_element(CoalSupplyCurve_Dom, CoalGroup_SUB), TYR2(PlanYear)) *
				CP_PEN(beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				T_BND(CoalSupplyCurve_Dom, beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG)/= $
				if T_BND(CoalSupplyCurve_Dom, beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				CFLOW((CoalSupplyCurve_Dom, CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				ECP_SHR(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) * CMM_CL_BTUS(CoalSupplyCurve_Dom, CoalGroup_SUB)*
				CMM_CONT_PRF(ContractProfile_element(CoalSupplyCurve_Dom, CoalGroup_SUB), TYR2(PlanYear)) / $
				TBTU_COAL(CoalGroup_SUB);
				
				CFLOW_TYPE(CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear, RetrofitCFG):=
				sum(CoalPlant| Scrubber=Scrubber_Type(CoalPlant), CFLOW(CoalSupplyCurve_Dom, CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG));
				
				CFLOW_INIT(CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear):=
				sum(CoalPlant| Scrubber=Scrubber_Type(CoalPlant), CFLOW(CoalSupplyCurve_Dom, CoalPlant, CoalGroup_SUB, PlanYear, first(RetrofitCFG)));
				
				CFLOW_MIN((CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') and
				RetrofitCFG<>first(RetrofitCFG)):=min(CFLOW_TYPE(CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear, RetrofitCFG),
				CFLOW_INIT(CoalSupplyCurve_Dom, Scrubber_J(Scrubber), CoalGroup_SUB, PlanYear));
				
				!EP$COAL,45 and 47
				ccalc_cRETRO_rTZZle((CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_Type(beforeWIPC), PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_TZZ(CoalSupplyCurve_Dom, CoalGroup_SUB, PlanYear, RetrofitCFG) and ord(PlanYear)=ord(CommitYear)):=
				if ECP_SHR(beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) then
				  -0.1*T_BND(CoalSupplyCurve_Dom, beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG)
				endif;
				
				!EP$COAL,46 and 48
				ccalc_cRETROHTRT_rTZZle((CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_Type(beforeWIPC), PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_TZZ(CoalSupplyCurve_Dom, CoalGroup_SUB, PlanYear, RetrofitCFG) and
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				if ECP_SHR(beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) then
				  -0.1*T_BND(CoalSupplyCurve_Dom, beforeWIPC, CoalGroup_SUB, PlanYear, RetrofitCFG)
				endif;
				
				
				T_BND1((CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				DV_SUB(CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_OwnerType(CoalPlant))=1):=
				ECP_SHR(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) *
				CMM_SDV_PRF(SubbituminousProfile_element(CoalGroup_SUB), TYR2(PlanYear)) *
				CP_PEN(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				T_BND1_CGCF((CoalPlant, CoalGroup_SUB, PlanYear)|
				Condition_COAL_CGCF(CoalGroup_SUB, PlanYear) and
				DV_SUB(CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_OwnerType(CoalPlant))=1):=
				ECP_SHR_CGCF(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) *
				CMM_SDV_PRF(SubbituminousProfile_element(CoalGroup_SUB), TYR2(PlanYear)) *
				CP_PEN_CGCF(CoalPlant, CoalGroup_SUB, PlanYear) *
				HRCPEN_CGCF(CoalPlant, CoalGroup_SUB, PlanYear);
				
				T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)/= $
				if T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)/= $
				if T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)>ECP_MIN('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				!EP$COAL,49
				ccalc_cRETRO_rFDVSle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ord(PlanYear)=ord(CommitYear)):=   -0.1 * T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!Added to handle coal part of coal-gas cofiring
				ccalc_cNNGCL_rFDVSle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, CommitYear, CoalGroup_SUB)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>= UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1):=
				 if (T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear_Element(CommitYear)) = 0 and ord(PlanYear) > 1) then
				   -0.1 * T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)
				  else
				  -0.1 * T_BND1_CGCF(CoalPlant, CoalGroup_SUB,  PlanYear_Element(CommitYear))
				  endif
				  ;
				
				!EP$COAL,50
				ccalc_cRETROHTRT_rFDVSle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				-0.1 * T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				empty T_BND1;
				T_BND1((CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				DV_LIG(CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_OwnerType(CoalPlant))=1):=
				ECP_SHR(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) *
				CMM_LDV_PRF(LigniteProfile_element(CoalGroup_SUB), TYR2(PlanYear)) *
				CP_PEN(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				HRCPEN(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				empty T_BND1_CGCF;
				T_BND1_CGCF((CoalPlant, CoalGroup_SUB, PlanYear)|
				Condition_COAL_CGCF(CoalGroup_SUB, PlanYear) and
				DV_LIG(CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber_OwnerType(CoalPlant))=1):=
				ECP_SHR_CGCF(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')) *
				EMM_CL_BTUs(CoalGroup_SUB, TYR2(PlanYear)) *
				CMM_LDV_PRF(LigniteProfile_element(CoalGroup_SUB), TYR2(PlanYear)) *
				CP_PEN_CGCF(CoalPlant, CoalGroup_SUB, PlanYear) *
				HRCPEN_CGCF(CoalPlant, CoalGroup_SUB, PlanYear);
				
				T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)/= $
				if T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)/= $
				if T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)>ECP_MIN('1') and
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>ECP_MIN('1') then
				  ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB) * 0.001
				endif;
				
				!EP$COAL,51
				ccalc_cRETRO_rFDVLle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ord(PlanYear)=ord(CommitYear)):= -0.1 * T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!handle coal part of Gas-coal cofiring
				ccalc_cNNGCL_rFDVLle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, CommitYear, CoalGroup_SUB)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1):=
				 if (T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear) = 0) then
				   -0.1 * T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear_Element(CommitYear))
				  else
				  -0.1 * T_BND1_CGCF(CoalPlant, CoalGroup_SUB, PlanYear)
				  endif
				;
				
				!EP$COAL,52
				ccalc_cRETROHTRT_rFDVLle((CoalDemandRegion_CoalGroup(CoalGroup_SUB), CoalPlant, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				-0.1 * T_BND1(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				Scrubber_parameter(Scrubber):=data{ S: -0.1, U: 0.1};
				empty ccalc_cRETRO_rKge,ccalc_cRETROHTRT_rKge;
				!EP$COAL,53
				ccalc_cRETRO_rKge((CoalType_element(CoalSupplyCurve_Dom), CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_S, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ord(PlanYear)=ord(CommitYear)):=
				Scrubber_parameter(Scrubber)*CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_S, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!EP$COAL,54
				ccalc_cRETROHTRT_rKge((CoalType_element(CoalSupplyCurve_Dom), CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_S, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				Scrubber_parameter(Scrubber)*CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_S, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				empty Scrubber_parameter;
				Scrubber_parameter(Scrubber):=data{ S: 0.1, U: -0.1};
				!EP$COAL,55
				ccalc_cRETRO_rKge((CoalType_element(CoalSupplyCurve_Dom), CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber, PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_U, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ord(PlanYear)=ord(CommitYear)):=
				Scrubber_parameter(Scrubber)*CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_U, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!EP$COAL,56
				ccalc_cRETROHTRT_rKge((CoalType_element(CoalSupplyCurve_Dom), CoalSupplyCurve_Dom, CoalDemandRegion_CoalGroup(CoalGroup_SUB), Scrubber, PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_U, CoalGroup_SUB, PlanYear, RetrofitCFG)>ECP_MIN('1') and
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				Scrubber_parameter(Scrubber)*CFLOW_MIN(CoalSupplyCurve_Dom, Scrubber_U, CoalGroup_SUB, PlanYear, RetrofitCFG);
				
				!Require Retrofit in Last Year if the Same Retrofit is Selected in First Year
				!FGD - SO2 Emission Controls
				K_FGD(CoalGroup_SUB, PlanYear):=sum(CoalConfiguration|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear), UCL_CNFG('3', CoalConfiguration));
				!EP$COAL,57
				ccalc_cRETRO_rYFGDle((CoalGroup_SUB, CommitYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0 and K_FGD(CoalGroup_SUB, PlanYear_Element(CommitYear))>0):=
				if (PlanYear_Element(CommitYear)=F_YR and
				UCL_CNFG('3',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0) or
				(PlanYear_Element(CommitYear)= L_YR and
				UCL_CNFG('3',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))=0) then
				  1
				endif;
				
				!EP$COAL,58
				ccalc_cRETROHTRT_rYFGDle((CoalGroup_SUB, HTRTYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0 and K_FGD(CoalGroup_SUB, HTRTYear_Element(HTRTYear))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				if (HTRTYear_Element(HTRTYear)=F_YR and
				UCL_CNFG('3',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0) or
				(HTRTYear_Element(HTRTYear)= L_YR and
				UCL_CNFG('3',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))=0) then
				  1
				endif;
				
				TestFGD(CoalGroup_SUB):=sum(CoalConfiguration|
				((CoalConfiguriation_MAP(CoalGroup_SUB, F_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, F_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(F_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, F_YR, CoalConfiguration)>0 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0 and K_FGD(CoalGroup_SUB, F_YR)>0 and
				UCL_CNFG('3',CoalConfiguration)>0) or
				((CoalConfiguriation_MAP(CoalGroup_SUB, L_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, L_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(L_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, L_YR, CoalConfiguration)>0 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0 and K_FGD(CoalGroup_SUB, L_YR)>0 and
				UCL_CNFG('3',CoalConfiguration)=0), 1 );
				!EP$COAL,59
				ccalc_cRHS_rYFGDle((CoalGroup_SUB)| TestFGD(CoalGroup_SUB)):=
				MAX(ECL_CAP(ExplicitPlanningHorizon_element(F_YR),CoalGroup_SUB),
				ECL_CAP(ExplicitPlanningHorizon_element(L_YR),CoalGroup_SUB)) * 0.001;
				
				!SNCR - NOX Post Combustion Emission Controls
				K_NCR(CoalGroup_SUB, PlanYear):=sum(CoalConfiguration|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear), UCL_CNFG('5', CoalConfiguration));
				!EP$COAL,63
				ccalc_cRETRO_rYNCRle((CoalGroup_SUB, CommitYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('5', I_CNFG(CoalGroup_SUB))=0 and K_NCR(CoalGroup_SUB, PlanYear_Element(CommitYear))>0):=
				if (PlanYear_Element(CommitYear)=F_YR and
				UCL_CNFG('5',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0) or
				(PlanYear_Element(CommitYear)= L_YR and
				UCL_CNFG('5',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))=0) then
				  1
				endif;
				
				!EP$COAL,64
				ccalc_cRETROHTRT_rYNCRle((CoalGroup_SUB, HTRTYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('5', I_CNFG(CoalGroup_SUB))=0 and K_NCR(CoalGroup_SUB, HTRTYear_Element(HTRTYear))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				if (HTRTYear_Element(HTRTYear)=F_YR and
				UCL_CNFG('5',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0) or
				(HTRTYear_Element(HTRTYear)= L_YR and
				UCL_CNFG('5',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))=0) then
				  1
				endif;
				
				TestNCR(CoalGroup_SUB):=sum(CoalConfiguration|
				((CoalConfiguriation_MAP(CoalGroup_SUB, F_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, F_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(F_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, F_YR, CoalConfiguration)>0 and
				UCL_CNFG('5', I_CNFG(CoalGroup_SUB))=0 and K_NCR(CoalGroup_SUB, F_YR)>0 and
				UCL_CNFG('5',CoalConfiguration)>0) or
				((CoalConfiguriation_MAP(CoalGroup_SUB, L_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, L_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(L_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, L_YR, CoalConfiguration)>0 and
				UCL_CNFG('5', I_CNFG(CoalGroup_SUB))=0 and K_NCR(CoalGroup_SUB, L_YR)>0 and
				UCL_CNFG('5',CoalConfiguration)=0), 1 );
				!EP$COAL,65
				ccalc_cRHS_rYNCRle((CoalGroup_SUB)| TestNCR(CoalGroup_SUB)):=
				MAX(ECL_CAP(ExplicitPlanningHorizon_element(F_YR),CoalGroup_SUB),
				ECL_CAP(ExplicitPlanningHorizon_element(L_YR),CoalGroup_SUB)) * 0.001;
				
				!CTS - Carbon Capture, Transport and Storage
				K_CTS(CoalGroup_SUB, PlanYear):=sum(CoalConfiguration|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear), UCL_CNFG('7', CoalConfiguration));
				!EP$COAL,69
				ccalc_cRETRO_rYCTSle((CoalGroup_SUB, CommitYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('7', I_CNFG(CoalGroup_SUB))=0 and K_CTS(CoalGroup_SUB, PlanYear_Element(CommitYear))>0):=
				if (PlanYear_Element(CommitYear)=F_YR and
				UCL_CNFG('7',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0) then
				  1
				elseif  (PlanYear_Element(CommitYear)= L_YR and
				UCL_CNFG('7',RetrofitCFG_Element(PlanYear_Element(CommitYear), CoalGroup_SUB, RetrofitCFG))>0) then
				  -1
				endif;
				
				!EP$COAL,70
				ccalc_cRETROHTRT_rYCTSle((CoalGroup_SUB, HTRTYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				UCL_CNFG('7', I_CNFG(CoalGroup_SUB))=0 and K_CTS(CoalGroup_SUB, HTRTYear_Element(HTRTYear))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0):=
				if (HTRTYear_Element(HTRTYear)=F_YR and
				UCL_CNFG('7',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0) then
				  1
				elseif
				(HTRTYear_Element(HTRTYear)= L_YR and
				UCL_CNFG('7',RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0) then
				  -1
				endif;
				
				TestCTS(CoalGroup_SUB):=sum(CoalConfiguration|
				((CoalConfiguriation_MAP(CoalGroup_SUB, F_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, F_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(F_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, F_YR, CoalConfiguration)>0 and
				UCL_CNFG('7', I_CNFG(CoalGroup_SUB))=0 and K_CTS(CoalGroup_SUB, F_YR)>0 and
				UCL_CNFG('7',CoalConfiguration)>0) or
				((CoalConfiguriation_MAP(CoalGroup_SUB, L_YR, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, L_YR)) and
				ECL_CAP(ExplicitPlanningHorizon_element(L_YR), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, L_YR, CoalConfiguration)>0 and
				UCL_CNFG('7', I_CNFG(CoalGroup_SUB))=0 and K_CTS(CoalGroup_SUB, L_YR)>0 and
				UCL_CNFG('7',CoalConfiguration)=0), 1 );
				!EP$COAL,71
				ccalc_cRHS_rYCTSle((CoalGroup_SUB)| TestCTS(CoalGroup_SUB)):= 0;
				!MAX(ECL_CAP(ExplicitPlanningHorizon_element(F_YR),CoalGroup_SUB),
				!ECL_CAP(ExplicitPlanningHorizon_element(L_YR),CoalGroup_SUB)) * 0.001;
				
				!HRI _ HEAT RATE IMPROVEMENT
				!EP$COAL,96
				ccalc_cRETROHTRT_rOHRIle((CoalGroup_SUB, HTRTYear, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizonH_element(HTRTYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, HTRTYear_Element(HTRTYear), RetrofitCFG_Element(HTRTYear_Element(HTRTYear), CoalGroup_SUB, RetrofitCFG))>0 and
				HTRT_TEST_COAL(CoalGroup_SUB, HTRTYear_Element(HTRTYear))=0 and ord(HTRTYear)>1):=
				if ord(HTRTYear)<UNXPH('1') then
				  1
				else
				  -1
				endif;
				
				!SO2 Retrofit Constraint
				!EP$COAL,75
				ccalc_cRETRO_rLUXXRETn((PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(CommitYear) and ord(PlanYear)>1 and
				UCL_CNFG('3', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('3', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				!EP$COAL,76
				ccalc_cRETROHTRT_rLUXXRETn((PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(HTRTYear) and ord(PlanYear)>1 and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				UCL_CNFG('3', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('3', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				!EP$COAL,77
				ccalc_cRETRO_rLUXXCCSle((PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(CommitYear) and ord(PlanYear)>1 and ord(PlanYear)<UNXPH('1') and
				UCL_CNFG('7', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('7', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				ccalc_cRETRO_rLUXXCCSn((PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(CommitYear) and ord(PlanYear)=UNXPH('1') and
				UCL_CNFG('7', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('7', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				!EP$COAL,78
				ccalc_cRETROHTRT_rLUXXCCSle((PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(HTRTYear) and ord(PlanYear)>1 and ord(PlanYear)<UNXPH('1') and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				UCL_CNFG('7', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('7', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				ccalc_cRETROHTRT_rLUXXCCSn((PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(HTRTYear) and ord(PlanYear)=UNXPH('1') and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				UCL_CNFG('7', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('7', I_CoalConfiguration(CoalGroup_SUB, PlanYear))=0):=1;
				
				!EP$COAL,79
				ccalc_cRETRO_rLP_RETge((SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(CommitYear) and ord(PlanYear)=UNXPH('1') and
				UCL_CNFG('3', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0):=1;
				
				!EP$COAL,80
				ccalc_cRETROHTRT_rLP_RETge((SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(HTRTYear) and ord(PlanYear)=UNXPH('1') and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				UCL_CNFG('3', RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))=1 and
				UCL_CNFG('3', I_CNFG(CoalGroup_SUB))=0):=1;
				
				!Planned Maintenance Requirement
				VALUE_COAL((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear)) :=
				- 8.760 * ECP_SHR(CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration) *
				CP_PEN(CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration) *
				if ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))>0 then
				  ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))
				else
				  UPPMRT(CoalPlant)
				endif;
				
				VALUE_COAL_CGCF((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)|
				CoalConfiguriation_MAP(CoalGroup_SUB, PlanYear, CoalConfiguration)=1 or
				CoalConfiguration=I_CoalConfiguration(CoalGroup_SUB, PlanYear)) :=
				- 8.760 * ECP_SHR_CGCF(CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration) *
				CP_PEN_CGCF(CoalPlant, CoalGroup_SUB, PlanYear) *
				if ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))>0 then
				  ECPMR(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear))
				else
				  UPPMRT(CoalPlant)
				endif;
				
				
				!Check
				VALUE_COAL((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)| abs(VALUE_COAL(CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration))<ECP_MIN('1')):=0;
				VALUE_COAL_CGCF((CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration)| abs(VALUE_COAL_CGCF(CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration))<ECP_MIN('1')):=0;
				
				Condition_HTRT(CoalPlant, FuelRegion, SupplyRegion, PlanYear):=
				if AVG_HTRT(CoalPlant, FuelRegion, SupplyRegion, ExplicitPlanningHorizon_element(PlanYear))>0 or
				AVG_HTRT_MOD(CoalPlant, FuelRegion, SupplyRegion, ExplicitPlanningHorizon_element(PlanYear))>0 or
				AVG_HTRT_MR(CoalPlant, FuelRegion, SupplyRegion, ExplicitPlanningHorizon_element(PlanYear))>0 or
				AVG_HTRT_MR_MOD(CoalPlant, FuelRegion, SupplyRegion, ExplicitPlanningHorizon_element(PlanYear))>0 then
				1
				endif;
				
				!EP$COAL,81
				ccalc_cRETRO_rMXXge((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(CommitYear) and
				Condition_HTRT(CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear)):=
				VALUE_COAL(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!addded to handle the coal part of coal-gas cofiring
				ccalc_cNNGCL_rMXXge((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), PlanYear, CommitYear, CoalGroup_SUB)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_Element(CommitYear))>0 and
				UVALUE_CGCF(CoalGroup_SUB, PlanYear)>0 and
				ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1 and
				Condition_HTRT(CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear_Element(CommitYear))):=
				  if (ord(PlanYear) < UNXPH('1')) then
				   VALUE_COAL_CGCF(CoalPlant, CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL'))
				  else
				    if (USW_EPA111('1') > 0) then
				     VALUE_COAL_CGCF(CoalPlant, CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')) * EPA_YRSHR(CoalGroup_SUB)
				    else
				     VALUE_COAL_CGCF(CoalPlant, CoalGroup_SUB, PlanYear_Element(CommitYear), RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL'))
				    endif
				  endif;
				
				
				!EP$COAL,82
				ccalc_cRETROHTRT_rMXXge((SupplyRegion_CoalGroup(CoalGroup_SUB), CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				ECL_CAP(ExplicitPlanningHorizon_element(PlanYear), CoalGroup_SUB)>0 and
				UVALUE(CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))>0 and
				ord(PlanYear)=ord(HTRTYear) and HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0 and
				Condition_HTRT(CoalPlant, FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), PlanYear)):=
				VALUE_COAL(CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG));
				
				!!EP$COAL,83 ccalc_cRETRO_ECPCOSTS and EP$COAL,84 ccalc_cRETROHTRT_ECPCOSTS
				Calculate_CL_RETROFITCOSTS;
				
				!Create NOX Emission Reductions
				!EP$COAL,85 and EP$COAL,86
				Calculate_CL_NOXEmissionReductions;
				
				!Adjust Fuel Consumption for New ECP Type
				UNIT_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear)) *
				HRCPEN_CGCF(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear);
				
				UNIT_HTRT_CGCF((CoalGroup_SUB, PlanYear)| Condition_COAL_CGCF(CoalGroup_SUB, PlanYear)):=
				ULHTRT_ECP(CoalPlantGroup_ByYear(CoalGroup_SUB, PlanYear), ExplicitPlanningHorizon_element(PlanYear)) *
				HRCPEN_CGCF(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB,'COL')), CoalGroup_SUB, PlanYear);
				
				
				Value((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG)):=
				8.760 * CF_NewECPType(CoalGroup_SUB, PlanYear, RetrofitCFG) * 0.001 *
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				(UNIT_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG) -
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				AVG_HTRT(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				AVG_HTRT_MR(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				Value_CGCF((CoalGroup_SUB, PlanYear)| Condition_COAL_CGCF(CoalGroup_SUB, PlanYear)):=
				8.760 * CF_NewECPType_CGCF(CoalGroup_SUB, PlanYear, 'COL') * 0.001 *
				CP_PEN_CGCF(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')), CoalGroup_SUB, PlanYear) *
				(UNIT_HTRT_CGCF(CoalGroup_SUB, PlanYear) -
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				AVG_HTRT(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				AVG_HTRT_MR(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				
				UNIT_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=max(HTRT_FLOOR(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG))),
				UNIT_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG)*
				(1.0 - HTRT_REDQ(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)),CLSG_QT(CoalGroup_SUB))));
				
				Value_HTRT((CoalGroup_SUB, PlanYear, RetrofitCFG)| Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0):=
				8.760 * CF_NewECPType(CoalGroup_SUB, PlanYear, RetrofitCFG) * 0.001 *
				CP_PEN(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), CoalGroup_SUB, PlanYear, RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)) *
				(UNIT_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG) -
				if ECL_MR(CoalGroup_SUB)< (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) then
				AVG_HTRT_MOD(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				else
				AVG_HTRT_MR_MOD(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), FuelRegion_CoalGroup(CoalGroup_SUB), SupplyRegion_CoalGroup(CoalGroup_SUB), ExplicitPlanningHorizon_element(PlanYear))
				endif);
				Scrubber_element(CoalGroup_SUB, PlanYear, RetrofitCFG):=
				Scrubber_Type(ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)));
				
				!EP$COAL,87
				ccalc_cRETRO_rFXXSle((FuelRegion_CoalGroup(CoalGroup_SUB), ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), Scrubber_element(CoalGroup_SUB, PlanYear, RetrofitCFG), PlanYear, CommitYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and ord(CommitYear)=ord(PlanYear)) :=
				if abs(Value(CoalGroup_SUB, PlanYear, RetrofitCFG))>ECP_MIN('1') then
				 Value(CoalGroup_SUB, PlanYear, RetrofitCFG)
				endif;
				
				!Added to handle coal part of gas-coal cofiring   CTN
				ccalc_cNNGCL_rFXXSle((FuelRegion_CoalGroup(CoalGroup_SUB), ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, 'COL')), Scrubber_element(CoalGroup_SUB, PlanYear, 'COL'), PlanYear, CommitYear, CoalGroup_SUB)|
				 ECL_CAP(ExplicitPlanningHorizonC_element(CommitYear), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(CommitYear)+UHBSYR('1')-1)>= UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear)>0 and
				Condition_COAL_CGCF(CoalGroup_SUB, PlanYear) and ord(PlanYear)>=ord(CommitYear) and ord(CommitYear) > 1) :=
				if (abs(Value_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear)))>ECP_MIN('1') and ord(PlanYear) > 1)then
				  if (ord(PlanYear) < UNXPH('1'))then
				   Value_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear))
				  else
				    if (USW_EPA111('1') > 0) then
				      Value_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear)) * EPA_YRSHR(CoalGroup_SUB)
				    else
				      Value_CGCF(CoalGroup_SUB, PlanYear_Element(CommitYear))
				    endif
				  endif
				endif;
				
				!EP$COAL,88
				ccalc_cRETROHTRT_rFXXSle((FuelRegion_CoalGroup(CoalGroup_SUB), ECPt_TO1(RetrofitCFG_Element(PlanYear, CoalGroup_SUB, RetrofitCFG)), Scrubber_element(CoalGroup_SUB, PlanYear, RetrofitCFG), PlanYear, HTRTYear, CoalGroup_SUB, RetrofitCFG)|
				Condition_COAL(CoalGroup_SUB, PlanYear, RetrofitCFG) and ord(HTRTYear)=ord(PlanYear) and
				HTRT_TEST_COAL(CoalGroup_SUB, PlanYear)=0) :=
				if abs(Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG))>ECP_MIN('1') then
				 Value_HTRT(CoalGroup_SUB, PlanYear, RetrofitCFG)
				endif;
				
				!followings are added to make sure that cNNGCL (coal part of coal-gas cofiring)
				!is always greater than cNNG (NG part of coal-gas cofiring) if coal-gas cofiring is chosen instead of 100% NG conversion is chosen
				
				!EP$COAL,28c
				ccalc_cNNG_rNGCLCFge((CoalGroup_Sub,PlanYear_ALTB)|
				 ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1):=UEPA_CGSH('1');
				!EP$COAL,28c
				ccalc_cNNGCL_rNGCLCFge((CoalGroup_Sub,PlanYear_ALTB,CommitYear)|
				 ECL_CAP(ExplicitPlanningHorizon_element(PlanYear_ALTB), CoalGroup_SUB)>0 and PlanYear_ALTB = PlanYear_element(CommitYear) and
				(CURIYR('1')+ord(PlanYear_ALTB)+UHBSYR('1')-1)>=UCL_CL_NG_SYR('1') and OV_CLtNG(CoalGroup_SUB,PlanYear_ALTB)>0 and ord(PlanYear_ALTB)>1):=UEPA_CGSH('1')-1;
			}
			Comment: "Condition (UCL_VIN(IYR) .GT. 0 .AND. IFRST .EQ. 1) is replaced with PlanYear>1 since IFRST=1 for all Plan years and UCL_VIN(1)=0";
			Parameter AN1 {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter EPA111_YRS {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter EPA_YRSHR {
				IndexDomain: CoalGroup;
			}
			Parameter VAL_CL_NG {
				IndexDomain: (SupplyRegion_SUB, Season, CoalGroup_SUB);
			}
			Parameter VAL_CL_NG1 {
				IndexDomain: (SupplyRegion_SUB, PlanYear, CoalGroup_SUB);
			}
			Parameter VALUe_CL {
				IndexDomain: (SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration);
			}
			Parameter VALUE_CL_CGCF {
				IndexDomain: (SupplyRegion_SUB, PlantType, Season, PlanYear, CoalGroup_SUB, CoalConfiguration);
			}
			Parameter CF_FL;
			Parameter CF_COAL {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			ElementParameter ECPt_FROM {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: PlantType_;
			}
			ElementParameter ECPt_TO {
				IndexDomain: CoalConfiguration;
				Range: PlantType_ECP_;
			}
			ElementParameter ECPt_TO1 {
				IndexDomain: CoalConfiguration;
				Range: PlantType_;
			}
			ElementParameter ECPt_TO2 {
				IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				Range: PlantType_;
			}
			ElementParameter LYR_CL {
				IndexDomain: PlanYear;
				Range: PlanYear_;
			}
			ElementParameter Scrubber_element {
				IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
				Range: Scrubber_;
			}
			Parameter LYR_CL_Parameter {
				IndexDomain: PlanYear;
			}
			ElementParameter ITYP {
				IndexDomain: (CoalGroup_SUB, PlanYear);
				Range: CapacityType_;
			}
			Parameter CNFG_TST {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter TST_ACI {
				IndexDomain: (PlanYear, CoalConfiguration);
			}
			Parameter UVALUE {
				IndexDomain: (CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter UVALUE_CGCF {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter CLSG_CCS {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter HRMAX;
			Parameter K_FGD {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			Parameter TestNCR {
				IndexDomain: CoalGroup_SUB;
			}
			Parameter K_NCR {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			Parameter TestCTS {
				IndexDomain: CoalGroup_SUB;
			}
			Parameter K_CTS {
				IndexDomain: (CoalGroup_SUB, PlanYear);
			}
			Parameter VALUE_COAL {
				IndexDomain: (CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter VALUE_COAL_CGCF {
				IndexDomain: (CoalPlant, CoalGroup_SUB, PlanYear, CoalConfiguration);
			}
			Parameter Condition_HTRT {
				IndexDomain: (CoalPlant, FuelRegion, SupplyRegion, PlanYear);
			}
			Parameter T_BND {
				IndexDomain: (CoalSupplyCurve_Dom, CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter T_BND1 {
				IndexDomain: (CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter T_BND1_CGCF {
				IndexDomain: (CoalPlant,CoalGroup_SUB,PlanYear);
			}
			Parameter CFLOW {
				IndexDomain: (CoalSupplyCurve_Dom, CoalPlant, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter CFLOW_TYPE {
				IndexDomain: (CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter CFLOW_INIT {
				IndexDomain: (CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear);
			}
			Parameter CFLOW_MIN {
				IndexDomain: (CoalSupplyCurve_Dom, Scrubber, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter Scrubber_parameter {
				IndexDomain: Scrubber;
			}
			Parameter Condition_TZZ {
				IndexDomain: (CoalSupplyCurve_Dom, CoalGroup_SUB, PlanYear, RetrofitCFG);
			}
			Parameter Value {
				IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
			}
			Parameter Value_CGCF {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
			Parameter Value_HTRT {
				IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
			}
			Parameter UNIT_HTRT {
				IndexDomain: (CoalGroup_SUB,PlanYear,RetrofitCFG);
			}
			Parameter UNIT_HTRT_CGCF {
				IndexDomain: (CoalGroup_SUB,PlanYear);
			}
		}
		Procedure EP_CSUPPLY_Cofiring {
			Body: {
				Calculate_BCOF_Costs;
				
				! Calculations for Biomass Cofiring Vectors
				
				G_HTRT(CoalPlant,CoalDemandRegion,PlanYear) := SUM((SupplyRegion,FuelRegion) | CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion,
				if ( (C_EMM_CDS(SupplyRegion,CoalDemandRegion) = 1 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1) or
				 (FL_CNXT_CST(SupplyRegion,FuelRegion) > 0.0 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1 and UPVTYP(CoalPlant) = 1) )
				 then
				ECP_GEN(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear))
				 endif);
				
				G_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear) := SUM((SupplyRegion,FuelRegion) | CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion,
				if ( (C_EMM_CDS(SupplyRegion,CoalDemandRegion) = 1 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1) or
				 (FL_CNXT_CST(SupplyRegion,FuelRegion) > 0.0 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1 and UPVTYP(CoalPlant) = 1) )
				 then
				ECP_GEN0(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear))
				 endif);
				
				C_HTRT(CoalPlant,CoalDemandRegion,PlanYear) := SUM((SupplyRegion,FuelRegion) | CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion,
				if ( (C_EMM_CDS(SupplyRegion,CoalDemandRegion) = 1 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1) or
				 (FL_CNXT_CST(SupplyRegion,FuelRegion) > 0.0 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1 and UPVTYP(CoalPlant) = 1) )
				 then
				ECP_GEN(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear)) * AVG_HTRT(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear))
				 endif);
				
				C_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear) := SUM((SupplyRegion,FuelRegion) | CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion,
				if ( (C_EMM_CDS(SupplyRegion,CoalDemandRegion) = 1 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1) or
				 (FL_CNXT_CST(SupplyRegion,FuelRegion) > 0.0 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion)=1 and UPVTYP(CoalPlant) = 1) )
				 then
				ECP_GEN0(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear)) * AVG_HTRT0(CoalPlant,FuelRegion,SupplyRegion,ExplicitPlanningHorizon_element(PlanYear))
				 endif);
				
				C_HTRT(CoalPlant,CoalDemandRegion,PlanYear) /= $
				  if (G_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear) > 0.0 and G_HTRT(CoalPlant,CoalDemandRegion,PlanYear) > 0.0) then
				   G_HTRT(CoalPlant,CoalDemandRegion,PlanYear)
				  endif;
				
				C_HTRT((CoalPlant,CoalDemandRegion,PlanYear)|G_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear) > 0.0 and G_HTRT(CoalPlant,CoalDemandRegion,PlanYear) <= 0.0) :=
				    C_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear)/G_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear);
				
				C_HTRT((CoalPlant,CoalDemandRegion,PlanYear)|G_HTRT_0(CoalPlant,CoalDemandRegion,PlanYear) <= 0.0) :=
				    30000.0;
				
				TST_ACI(CoalPlant,PlanYear) := MAX((numACI,EmissionRank),ACI_OPT(numACI,EmissionRank,element(PlantType_ECP_,ord(CoalPlant)),LastModelYear_TYR(PlanYear)));
				CF_Condition(SupplyRegion,FuelRegion,BiomassCOF,CoalPlant,PlanYear):=
				if (UCF_TCAP1(BiomassCOF,SupplyRegion,CoalDemandRegion_EPCLMP(FuelRegion),ModelYear_MNUMYRX(PlanYear)) > 0.0 and
				  TST_ACI(CoalPlant,PlanYear) > 0 and
				  UPCFBTU(BiomassCOF,CoalDemandRegion_EPCLMP(FuelRegion)) > 0.0001 and
				  COFCAP(BiomassCOF,CoalPlant,SupplyRegion,FuelRegion) > 0.0) then
				  1
				 else
				  0
				 endif;
				
				VALBTU(BiomassCOF,CoalDemandRegion) :=
				  if UPCFBTU(BiomassCOF,CoalDemandRegion) > 0.0001 then
				      1.0 / (UPCFBTU(BiomassCOF,CoalDemandRegion) * UPCFLEV(BiomassCOF,Element(BiomassOption_,UPCFNSTP(BiomassCOF))))
				  else
				      1.0 / UPCFLEV(BiomassCOF,Element(BiomassOption_,UPCFNSTP(BiomassCOF)))
				  endif;
				
				for BiomassCOF do
				  for BiomassOption do
				     BiomassCOF_Element(Element(BioCOFCF_,COF_CMB(BiomassCOF,BiomassOption))) := BiomassCOF;
				     BiomassOption_Element(Element(BioCOFCF_,COF_CMB(BiomassCOF,BiomassOption))) := BiomassOption;
				  endfor;
				endfor;
				
				!  EP$CSUPPLY,12
				ccalc_cW_UBOUND((SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber,PlanYear) |
				 (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) )) :=
				    if (VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0) then
				      COFCAP(BiomassCOF_Element(BioCOFCF),CoalPlant,SupplyRegion_ALT1,FuelRegion_ALT1) / 1000.0 * UPMCF(CoalPlant) * 8.760 *
				      (C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear) / 1000.0) * UPCFLEV(BiomassCOF_Element(BioCOFCF),BiomassOption_Element(BioCOFCF))
				    else
				      0.0       !EP$CSUPPLY,19
				    endif;
				
				!  EP$CSUPPLY,13
				ccalc_cW_rFXXSle(FuelRegion_ALT1,PlantType_ALT2,Scrubber,PlanYear,SupplyRegion_ALT1,BioCOFCF,CoalPlant) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))
				    and PlantTYpe_ALT2 = CoalPlant) then
				    -1.0
				endif;
				
				!  EP$CSUPPLY,14
				ccalc_cW_rFWDXXXle(CoalDemandRegion_ALT1,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))
				    and ord(CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) = ord(CoalDemandRegion_ALT1)) then
				    1.0
				endif;
				
				!  EP$CSUPPLY,15
				TMPVAL(CoalPlant,CoalDemandRegion_ALT1,PlanYear) := 1000.0 / C_HTRT(CoalPlant,CoalDemandRegion_ALT1,PlanYear);
				TMPVAL((CoalPlant,CoalDemandRegion_ALT1,PlanYear) | -ECP_MIN('1')<TMPVAL(CoalPlant,CoalDemandRegion_ALT1,PlanYear)<ECP_MIN('1')):= ECP_MIN('1');
				
				ccalc_cW_rGWDXn(CoalDemandRegion_ALT1,CoalPlant,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))
				    and ord(CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) = ord(CoalDemandRegion_ALT1)) then
				         TMPVAL(CoalPlant,CoalDemandRegion_ALT1,PlanYear)
				endif;
				
				!  EP$CSUPPLY,16
				ccalc_cW_rFGWDn(SupplyRegion_ALT1,CoalPlant,PlanYear,FuelRegion_ALT1,BioCOFCF,Scrubber) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))) then
				         TMPVAL(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)
				endif;
				
				!  EP$CSUPPLY,17
				ccalc_cW_rGCFGENge((SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber)|
				      UPCFGEN(LastModelYear_MNUMYR(PlanYear),SupplyRegion_ALT1) > 0.0) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))) then
				         TMPVAL(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)
				endif;
				
				ccalc_cW_rGCFGENn((SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber)|
				      UPCFGEN(LastModelYear_MNUMYR(PlanYear),SupplyRegion_ALT1) <= 0.0) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))) then
				         TMPVAL(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)
				endif;
				
				!  EP$CSUPPLY,18
				ccalc_cW_rFCFGENge(SupplyRegion_ALT1,PlanYear,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber) :=
				if (CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF))) then
				         TMPVAL(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)
				endif;
				
				!  EP$CSUPPLY,20
				VALBTU((BiomassCOF,CoalDemandRegion_ALT1) | -ECP_MIN('1')<VALBTU(BiomassCOF,CoalDemandRegion_ALT1)<ECP_MIN('1')):= ECP_MIN('1');
				
				ccalc_cW_rHCOFle(SupplyRegion_ALT1,CoalDemandRegion_ALT1,BiomassCOF,PlanYear,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber) :=
				  if (BiomassCOF_Element(BioCOFCF) = BiomassCOF and CoalDemandRegion_EPCLMP(FuelRegion_ALT1) = CoalDemandRegion_ALT1 and
				   CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) and VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0) then
				       VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1))
				   endif;
				
				VALCF((BiomassCOF,BiomassOption)|ord(BiomassOption)<= UPCFNSTP(BiomassCOF)) := (1.0 - UPCFLEV(BiomassCOF,BiomassOption)) / UPCFLEV(BiomassCOF,BiomassOption);
				VALCF((BiomassCOF,BiomassOption) | -ECP_MIN('1')<VALCF(BiomassCOF,BiomassOption)<ECP_MIN('1')):= ECP_MIN('1');
				
				!  EP$CSUPPLY,21
				ccalc_cW_rHCSHle(CoalDemandRegion_ALT1,CoalPlant,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,Scrubber) :=
				  if ( CoalDemandRegion_EPCLMP(FuelRegion_ALT1) = CoalDemandRegion_ALT1 and
				   CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) and VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0) then
				        VALCF(BiomassCOF_Element(BioCOFCF),BiomassOption_Element(BioCOFCF))
				   endif;
				
				!regional RPS contribution
				VALRPS_R(BiomassCOF,CoalPlant,FuelRegion,SupplyRegion,PlanYear) := UPRNWSHRR(WIWD_Element,SupplyRegion) * 1000.0 /$ C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion),PlanYear);
				VALRPS_R((BiomassCOF,CoalPlant,FuelRegion,SupplyRegion,PlanYear)| -ECP_MIN('1')<VALRPS_R(BiomassCOF,CoalPlant,FuelRegion,SupplyRegion,PlanYear)<ECP_MIN('1')):= 0.0;
				
				!  EP$CSUPPLY,22
				ccalc_cW_rGRNWXXge(RPSRegion,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber) :=
				  if ( CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) and VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0
				    and VALRPS_R(BiomassCOF_Element(BioCOFCF),CoalPlant,FuelRegion_ALT1,SupplyRegion_ALT1,PlanYear) <> 0.0 and
				    MAP_NERC_TO_RPS_RGN(SupplyRegion_ALT1) = RPSRegion) then
				         VALRPS_R(BiomassCOF_Element(BioCOFCF),CoalPlant,FuelRegion_ALT1,SupplyRegion_ALT1,PlanYear)
				  endif;
				
				!national RPS contribution
				VALRPS(BiomassCOF,CoalPlant,FuelRegion,PlanYear) := UPRNWSHR(WIWD_Element) * 1000.0 /$ C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion),PlanYear);
				VALRPS((BiomassCOF,CoalPlant,FuelRegion,PlanYear)| -ECP_MIN('1')<VALRPS(BiomassCOF,CoalPlant,FuelRegion,PlanYear)<ECP_MIN('1')):= 0.0;
				
				!  EP$CSUPPLY,23
				ccalc_cW_rGURNWXge(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber) :=
				  if ( CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) and VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0
				    and VALRPS(BiomassCOF_Element(BioCOFCF),CoalPlant,FuelRegion_ALT1,PlanYear) <> 0.0 and SupplyRegion_ALTY = SupplyRegion_ALT1) then
				         VALRPS(BiomassCOF_Element(BioCOFCF),CoalPlant,FuelRegion_ALT1,PlanYear)
				  endif;
				
				XTR_TRN((BiomassCOF,BiomassOption,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   UPGNPD(ModelYear_MNUMYRF(PlanYear)) * UPCFSTEP(BiomassCOF,BiomassOption) / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				XTR_TRN_tmp((BiomassCOF,BiomassOption,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * UPCFSTEP(BiomassCOF,BiomassOption);
				XTR_TRN((BiomassCOF,BiomassOption,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(XTR_TRN_tmp(BiomassCOF,BiomassOption,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				VOMCST((BiomassCOF,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   UPGNPD(ModelYear_MNUMYRF(PlanYear)) * UPCFVOM(BiomassCOF) * 1000.0 / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				VOMCST_tmp((BiomassCOF,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * UPCFVOM(BiomassCOF) * 1000.0;
				VOMCST((BiomassCOF,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(VOMCST_tmp(BiomassCOF,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				COFHUR((PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   UPGNPD(ModelYear_MNUMYRF(PlanYear)) * WDCFHUR(LastModelYear_MNUMYR(PlanYear)) * 1000.0 / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				COFHUR_tmp((FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * WDCFHUR(MNUMYR_KYR(FullPlanningHorizon)) * 1000.0 ;
				COFHUR((PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(COFHUR_tmp(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				COFSUB((PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   UPGNPD(ModelYear_MNUMYRF(PlanYear)) * WDCFSUB(LastModelYear_MNUMYR(PlanYear)) * 1000.0 / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				COFSUB_tmp((FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * WDCFSUB(MNUMYR_KYR(FullPlanningHorizon)) * 1000.0 ;
				COFSUB((PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(COFSUB_tmp(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				VALOBJ(CoalPlant,CoalDemandRegion_ALT1,BiomassCOF,BiomassOption,PlanYear) :=
				   XTR_TRN(BiomassCOF,BiomassOption,PlanYear) + (VOMCST(BiomassCOF,PlanYear) + COFHUR(PlanYear) - COFSUB(PlanYear))
				      / C_HTRT(CoalPlant,CoalDemandRegion_ALT1,PlanYear);
				VALOBJ((CoalPlant,CoalDemandRegion,BiomassCOF,BiomassOption,PlanYear)| -ECP_MIN('1')<VALOBJ(CoalPlant,CoalDemandRegion,BiomassCOF,BiomassOption,PlanYear)<ECP_MIN('1')):= 0.0;
				
				! 'EP$CSUPPLY,24'
				ccalc_cW_ECPCOSTS(SupplyRegion_ALT1,FuelRegion_ALT1,BioCOFCF,CoalPlant,Scrubber,PlanYear) :=
				if ( CF_Condition(SupplyRegion_ALT1,FuelRegion_ALT1,BiomassCOF_Element(BioCOFCF),CoalPlant,PlanYear)
				    and ord(Scrubber) = ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)
				    and ord(BiomassOption_Element(BioCOFCF)) <= UPCFNSTP(BiomassCOF_Element(BioCOFCF)) and VALBTU(BiomassCOF_Element(BioCOFCF),CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) <= 2000.0) then
				   VALOBJ(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),BiomassCOF_Element(BioCOFCF),BiomassOption_Element(BioCOFCF),PlanYear)
				endif;
			}
			Parameter XTR_TRN {
				IndexDomain: (BiomassCOF,BiomassOption,PlanYear);
			}
			Parameter XTR_TRN_tmp {
				IndexDomain: (BiomassCOF,BiomassOption,FullPlanningHorizon);
			}
			Parameter VOMCST {
				IndexDomain: (BiomassCOF,PlanYear);
			}
			Parameter VOMCST_tmp {
				IndexDomain: (BiomassCOF,FullPlanningHorizon);
			}
			Parameter COFHUR {
				IndexDomain: PlanYear;
			}
			Parameter COFHUR_tmp {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter COFSUB {
				IndexDomain: PlanYear;
			}
			Parameter COFSUB_tmp {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter VALOBJ {
				IndexDomain: (CoalPlant,CoalDemandRegion_ALT1,BiomassCOF,BiomassOption,PlanYear);
			}
			Parameter VALRPS {
				IndexDomain: (BiomassCOF,CoalPlant,FuelRegion,PlanYear);
			}
			Parameter VALRPS_R {
				IndexDomain: (BiomassCOF,CoalPlant,FuelRegion,SupplyRegion,PlanYear);
			}
			Parameter VALCF {
				IndexDomain: (BiomassCOF,BiomassOption);
			}
			Parameter VALBTU {
				IndexDomain: (BiomassCOF,CoalDemandRegion_ALT1);
			}
			Parameter TMPVAL {
				IndexDomain: (CoalPlant,CoalDemandRegion_ALT1,PlanYear);
			}
			Parameter C_HTRT_0 {
				IndexDomain: (CoalPlant,CoalDemandRegion,PlanYear);
			}
			Parameter G_HTRT {
				IndexDomain: (CoalPlant,CoalDemandRegion,PlanYear);
			}
			Parameter G_HTRT_0 {
				IndexDomain: (CoalPlant,CoalDemandRegion,PlanYear);
			}
			Parameter TST_ACI {
				IndexDomain: (CoalPlant,PlanYear);
			}
			Parameter CF_Condition {
				IndexDomain: (SupplyRegion,FuelRegion,BiomassCOF,CoalPlant,PlanYear);
			}
		}
		Procedure EP_CSUPPLY_Coal {
			Body: {
				VAL_ESC((PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   UPGNPD(ModelYear_MNUMYRF(PlanYear)) * 9.9 / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				VAL_ESC_tmp((FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * 9.9;
				VAL_ESC((PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(VAL_ESC_tmp(FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				!EP$CSUPPLY,32
				ccalc_cK_ECPCOSTS((CoalType,CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear) |  TOT_TYPE(CoalSupplyCurve) = ord(CoalType) and ord(Scrubber)<3) :=
				  VAL_ESC(PlanYear) * 10.0;
				
				GET_EMF_AND_ACI;
				COMBINE_COAL_RATES;
				
				EMM_MEF(numACI,EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)):= Mean(CoalDemandRegion, EMF_T(CoalSupplyCurve,CoalDemandRegion,CoalPlant,numACI));
				ACI_QAC(numACI,EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)):= Mean(CoalDemandRegion, ACI(CoalSupplyCurve,CoalDemandRegion,CoalPlant,numACI));
				
				Condition_trans((CoalPlant,FuelRegion,PlanYear)| ((TST_CAP_BY_CRG(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion),ExplicitPlanningHorizon_element(PlanYear)) > 0.0 or CPCTNSH(FuelRegion,EFDFuelType_PlantType(CoalPlant)) > 0.0) or
				  UPTTYP(CoalPlant) > EX_COAL('1')) and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion_EPCLMP(FuelRegion)) = 1) := 1;
				
				Condition_T1(CoalDemandRegion,Scrubber,PlanYear) := sum((CoalPlant,FuelRegion)|CoalDemandRegion_EPCLMP(FuelRegion)=CoalDemandRegion and ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)=ord(Scrubber) and ord(CoalPlant) <= WIPC('1'),
				   Condition_trans(CoalPlant,FuelRegion,PlanYear));
				
				!EP$CSUPPLY,33'  not active so not verified
				ccalc_cTZZ_rTZZle((CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear)| TOT_RATE2(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') > TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01')
				   and TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') < 800.0 and Condition_T1(CoalDemandRegion_ALT1,Scrubber,PlanYear)) :=
				   -1.0;
				
				T_TMP((CoalSupplyCurve,CoalDemandRegion,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				    MAX((TOT_RATE2(CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon_PlanYear(PlanYear)) - TOT_RATE1(CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon_PlanYear(PlanYear))) , 0.0001)
				       * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / ((1 + AVGDCR) ^ ORD(PlanYear));
				
				T_TMP_tmp((CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) *  MAX((TOT_RATE2(CoalSupplyCurve,CoalDemandRegion,element(FullPlanningHorizon_,ORD(FullPlanningHorizon)+UNXPH('1')-1)) - TOT_RATE1(CoalSupplyCurve,CoalDemandRegion,element(FullPlanningHorizon_,ORD(FullPlanningHorizon)+UNXPH('1')-1))) , 0.0001) ;
				T_TMP((CoalSupplyCurve,CoalDemandRegion,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(T_TMP_tmp(CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (ORD(PlanYear)-1));
				
				!EP$CSUPPLY,34'  not active so not verified
				ccalc_cTZZ_ECPCOSTS((CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear) | TOT_RATE2(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') > TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01')
				   and TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') < 800.0 and Condition_T1(CoalDemandRegion_ALT1,Scrubber,PlanYear)) :=
				   T_TMP(CoalSupplyCurve,CoalDemandRegion_ALT1,PlanYear) / 0.1;
				
				!'EP$CSUPPLY,35'
				ccalc_cT_rFXXSle((FuelRegion_ALT1,CoalPlant,Scrubber,PlanYear,CoalSupplyCurve,ACIOption)|Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)=ord(Scrubber) and
				TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) := -1;
				
				!'EP$CSUPPLY,36' not active
				ccalc_cT_rTZZle((CoalSupplyCurve,CoalDemandRegion_ALT1,Scrubber,PlanYear,FuelRegion_ALT1,CoalPlant,ACIOption)| CoalDemandRegion_ALT1 = CoalDemandRegion_EPCLMP(FuelRegion_ALT1) and 
				   TOT_RATE2(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') > TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01')
				   and TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01') < 800.0 and Condition_T1(CoalDemandRegion_ALT1,Scrubber,PlanYear)) :=
				   0.1;
				
				!'EP$CSUPPLY,37'
				ccalc_cT_UBOUND((CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption,PlanYear)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) = 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				     30000.0;
				
				ccalc_cT_UBOUND((CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption,PlanYear)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) > 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				     0.0;
				
				
				!'EP$CSUPPLY,38'
				ccalc_cT_rGCLXn((CoalDemandRegion_ALT1,CoalPlant,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_ALT1,CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and
				  CoalDemandRegion_ALT1 = CoalDemandRegion_EPCLMP(FuelRegion_ALT1) ) :=
				 if (1000/$ C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)> -ECP_MIN('1') and 1000/$ C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear) < ECP_MIN('1') )then
				    ECP_MIN('1')
				 else
				    1000/$ C_HTRT(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear)
				 endif;
				
				
				!EP$CSUPPLY,39
				ccalc_cT_rHCSHle((CoalDemandRegion_ALT1,CoalPlant,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_ALT1,CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_ALT1,'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and
				  CoalDemandRegion_ALT1 = CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) :=
				 -1;
				
				
				!'EP$CSUPPLY,40'
				VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,numACI)
				 :=0.5 * XCL_HG_YR(CoalSupplyCurve,cyr) * EMM_MEF(numACI,Rank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant));
				 ccalc_cT_rEUHGle((CoalPlant,nHGCODE,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) |
				 Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear)
				  and USW_HG('1') > 0 ) :=
				 if (VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption))> -ECP_MIN('1') and VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption)) < ECP_MIN('1') )then
				    0.0
				 elseif VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption)) > 0 then
				    VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption))
				 elseif VAL_HG_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption)) < 0 then
				    0.0
				 endif;
				
				
				 !'EP$CSUPPLY,42'
				 SO2SHR(CoalDemandRegion,SO2Region,PlanYear):=
				 if ((CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) < TRANRULE1('1')) then
				 	TSO2_SHR_BY_CLRG(CoalDemandRegion,SO2Region_SO2Transport(SO2Region))
				 else
				        SO2_SHR_BY_CLRG(CoalDemandRegion,SO2Region_SO2ComplyGroup(SO2Region))
				 endif;
				 VAL_SO2_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,SO2Region,numACI,PlanYear):=
				 if (SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),SO2Region,PlanYear)>0.0001) then
				   if (ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr) = 1) then
				       	0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr) * SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),SO2Region,PlanYear) * (1.0 - RCLCLNR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),cyr,PlantType_ECP_element(CoalPlant))) * 10.0
				   else
				        IF ((CURIYR('1') + UHBSYR('1') + KYR(PlanYear) - 1) < UDSI_YR('1'))THEN
				            0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr) * SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),SO2Region,PlanYear)
				        else
				            0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr) * SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),SO2Region,PlanYear)*(1.0 - UPDSISEF('U'))
				        endif
				   endif
				 endif;
				ccalc_cT_rEUSOle((CoalPlant,SO2Region,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| 
				 Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and
				   Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1  ) :=
				     VAL_SO2_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,SO2Region,ACIOption_Mapping(ACIOption),PlanYear);
				
				 !'EPA$TRANRG_ECP,5' via CALL EPA$TRANRG_ECP(1,YEAR,IRG,IPLT,COLUMN,COLUMN_mask,VAL1)
				
				VAL1_SO2_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,numACI,PlanYear):=
				 if (TSO2_YR_BY_CLRG('1')<9999) then
				   if (ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr) = 1) then
				       	0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr) * (1.0 - RCLCLNR(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),cyr,PlantType_ECP_element(CoalPlant)))
				   else
				        IF ((CURIYR('1') + UHBSYR('1') + KYR(PlanYear) - 1) < UDSI_YR('1'))THEN
				            0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr)
				        else
				            0.5 * XCL_SO2_YR(CoalSupplyCurve,cyr) * (1.0 - UPDSISEF('U'))
				        endif
				   endif
				 endif;
				ccalc_cT_rEUSO2le((CoalDemandRegion_EPCLMP(FuelRegion_ALT1),PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| 
				 Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear))
				:=
				if (TSO2_YR_BY_CLRG('1') < 9999 and TSO2_LIM_BY_CLRG(CoalDemandRegion_EPCLMP(FuelRegion_ALT1)) > 0) then
				 VAL1_SO2_EMIS(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,ACIOption_Mapping(ACIOption),PlanYear)*TSO2_SHR_BY_CLRG(CoalDemandRegion_EPCLMP(FuelRegion_ALT1), first(SO2_Transport_))
				endif;
				
				VAL_CAR(CoalPlant,CoalSupplyCurve) :=
				   (1.0 / 2204.0) * XCL_CAR_YR(CoalSupplyCurve,cyr) * (12.0 / 44.0) * (1.0 - UPPCEF(CoalPlant));
				
				! EP$CSUPPLY,43 - fills either 'le' or 'n' depending on national carbon constraint condition
				ccalc_cT_rEUCARXXle((PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) | Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and CarbonNationalCap(PlanYear) = 1 ) :=
				 if (VAL_CAR(CoalPlant,CoalSupplyCurve)> -ECP_MIN('1') and VAL_CAR(CoalPlant,CoalSupplyCurve) < ECP_MIN('1') )then
				    0.0
				 elseif VAL_CAR(CoalPlant,CoalSupplyCurve) > 0 then
				    VAL_CAR(CoalPlant,CoalSupplyCurve)
				 elseif VAL_CAR(CoalPlant,CoalSupplyCurve) < 0 then
				    0.0
				 endif;
				
				ccalc_cT_rEUCARXXn((PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) | Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and CarbonNationalCap(PlanYear) = 0 ) :=
				 if (VAL_CAR(CoalPlant,CoalSupplyCurve)> -ECP_MIN('1') and VAL_CAR(CoalPlant,CoalSupplyCurve) < ECP_MIN('1') )then
				    0.0
				 elseif VAL_CAR(CoalPlant,CoalSupplyCurve) > 0 then
				    VAL_CAR(CoalPlant,CoalSupplyCurve)
				 elseif VAL_CAR(CoalPlant,CoalSupplyCurve) < 0 then
				    0.0
				 endif;
				
				VAL_CARRG(CoalPlant,CoalSupplyCurve, FuelRegion_ALT1,CarbonRegion) :=
				  if VAL_CAR(CoalPlant,CoalSupplyCurve) > ECP_MIN('1') then
				     VAL_CAR(CoalPlant,CoalSupplyCurve) * CO2_CL_BY_FL(FuelRegion_ALT1,CO2CapGroup_element(CarbonRegion))
				  else
				    0.0
				  endif;
				
				!EP$CSUPPLY, 44 - fills either 'le' or 'n' depending on regional carbon constraint condition
				ccalc_cT_rEUCARle((CarbonRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) | Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and CarbonRegionCap(CarbonRegion,PlanYear) = 1 ) :=
				   VAL_CARRG(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,CarbonRegion);
				
				ccalc_cT_rEUCARn((CarbonRegion,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) | Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and CarbonRegionCap(CarbonRegion,PlanYear) = 0 ) :=
				   VAL_CARRG(CoalPlant,CoalSupplyCurve,FuelRegion_ALT1,CarbonRegion);
				
				VAL_CAR_CAP(CoalPlant,CoalSupplyCurve) :=
				   (1.0 / 2204.0) * XCL_CAR_YR(CoalSupplyCurve,cyr) * (12.0 / 44.0) * UPPCEF(CoalPlant);
				
				! EP$CSUPPLY,46 - carbon capture free row
				ccalc_cT_rEUCARCRn((PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption) | Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				 if (VAL_CAR_CAP(CoalPlant,CoalSupplyCurve)> -ECP_MIN('1') and VAL_CAR_CAP(CoalPlant,CoalSupplyCurve) < ECP_MIN('1') )then
				    0.0
				 elseif VAL_CAR_CAP(CoalPlant,CoalSupplyCurve) > 0 then
				    VAL_CAR_CAP(CoalPlant,CoalSupplyCurve)
				 elseif VAL_CAR_CAP(CoalPlant,CoalSupplyCurve) < 0 then
				    0.0
				 endif;
				
				!calculate transportation costs from supply curve to coal demand Region
				
				CTRAN((CoalSupplyCurve,CoalDemandRegion,CoalPlant,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				  if (ord(CoalPlant) < WIPC('1')) then
				     TOT_RATE1(CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon_PlanYear(PlanYear))
				       * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / ((1 + AVGDCR) ^ ORD(PlanYear))
				   else
				     TOT_RATE2(CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon_PlanYear(PlanYear))
				       * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / ((1 + AVGDCR) ^ ORD(PlanYear))
				   endif;
				
				CTRAN_tmp((CoalSupplyCurve,CoalDemandRegion,CoalPlant,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				 if (ord(CoalPlant) < WIPC('1')) then
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * TOT_RATE1(CoalSupplyCurve,CoalDemandRegion,element(FullPlanningHorizon_,ORD(FullPlanningHorizon)+UNXPH('1')-1))
				 else
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * TOT_RATE2(CoalSupplyCurve,CoalDemandRegion,element(FullPlanningHorizon_,ORD(FullPlanningHorizon)+UNXPH('1')-1))
				 endif;
				
				CTRAN((CoalSupplyCurve,CoalDemandRegion,CoalPlant,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(CTRAN_tmp(CoalSupplyCurve,CoalDemandRegion,CoalPlant,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (ORD(PlanYear)-1));
				
				
				!ACI cost
				VOM((CoalSupplyCurve,CoalPlant,numACI,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				  if (ord(numACI) > 1) then
				    ACI_CST(numACI,EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)) * 1000.0
				           * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / ((1 + AVGDCR) ^ ORD(PlanYear))
				  else
				     0.0
				  endif;
				
				VOM_tmp((CoalSupplyCurve,CoalPlant,numACI,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				 if (ord(numACI) > 1) then
				  UPGNPD(ModelYear_KYR(FullPlanningHorizon)) * ACI_CST(numACI,EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)) * 1000.0
				 else
				   0.0
				 endif;
				
				VOM((CoalSupplyCurve,CoalPlant,numACI,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(VOM_tmp(CoalSupplyCurve,CoalPlant,numACI,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (ORD(PlanYear)-1));
				
				! 'EP$CSUPPLY,47'
				ccalc_cT_rACIXXXXle((PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and ord(ACIOption) > 1) :=
				 if (ACI_QAC(ACIOption_Mapping(ACIOption),EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)) * 0.000001 * 10.0 > -ECP_MIN('1') and ACI_QAC(ACIOption_Mapping(ACIOption),EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)) * 0.000001 * 10.0 < ECP_MIN('1') )then
				    ECP_MIN('1')
				 else
				    ACI_QAC(ACIOption_Mapping(ACIOption),EmissionRank_Element(CoalSupplyCurve),PlantType_ECP_element(CoalPlant)) * 0.000001 * 10.0
				 endif;
				
				! 'EP$CSUPPLY,48'
				ccalc_cT_ECPCOSTS((CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption,PlanYear)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				  if (ETAX_FLAG('1')) then
					VOM(CoalSupplyCurve,CoalPlant,ACIOption_Mapping(ACIOption),PlanYear)/10000.0 + JCLCLNR(LastModelYear_MNUMYR(PlanYear),element(NewPrice_,ord(CoalPlant)))
					  + CTRAN(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,PlanYear)
				  else
				      VOM(CoalSupplyCurve,CoalPlant,ACIOption_Mapping(ACIOption),PlanYear)/10000.0 + CTRAN(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,PlanYear)
				  endif;
				
				! 'EP$CSUPPLY,49'
				ccalc_cT_rSCXle((CoalType,CoalSupplyCurve,PlanYear,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				 TOT_TYPE(CoalSupplyCurve) = ord(CoalType) and TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				   1.0;
				
				! 'EP$CSUPPLY,50'
				ccalc_cT_rKge((CoalType,CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),Scrubber,PlanYear,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				  ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr)=ord(Scrubber) and
				 TOT_TYPE(CoalSupplyCurve) = ord(CoalType) and TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) ) :=
				   1.0 * 0.1;
				
				! 'EP$CSUPPLY,51'
				ccalc_cT_rFDVSle((CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				  TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and
				  DV_SUB(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),OwnerType_element(CoalPlant) ) ) :=
				  if (TOT_TYPE(CoalSupplyCurve) = 4 or TOT_TYPE(CoalSupplyCurve) = 5) then
				    0.1
				  endif;
				
				! 'EP$CSUPPLY,52'
				ccalc_cT_rFDVLle((CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,PlanYear,CoalSupplyCurve,FuelRegion_ALT1,CoalPlant,ACIOption)| Allowed(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),CoalPlant,ACIOption_Mapping(ACIOption)) >= 1 and
				  TOT_RATE1(CoalSupplyCurve,CoalDemandRegion_EPCLMP(FuelRegion_ALT1),'01')<800 and Condition_trans(CoalPlant,FuelRegion_ALT1,PlanYear) and
				  DV_LIG(CoalDemandRegion_EPCLMP(FuelRegion_ALT1),OwnerType_element(CoalPlant)) and TOT_TYPE(CoalSupplyCurve) = 6 ) :=
				    0.1;
				
				
				VAL_XC(CoalSupplyCurve_Dom,PlanYear) :=
				  if (ord(cyr) + ord(PlanYear) -1 <= UNYEAR('1')) then
				      XCL_PCAP(CoalSupplyCurve_Dom,cyr + ord(PlanYear) -1)
				   else
				      XCL_PCAP(CoalSupplyCurve_Dom,element(MNUMYR_, UNYEAR('1'))) * (1.0 + XCL_MAX_INCR(CoalSupplyCurve_Dom,cyr)) ^ (ord(cyr) + ord(PlanYear) - UNYEAR('1') - 1)
				   endif;
				VAL_XC(CoalSupplyCurve_Dom,PlanYear) := min(VAL_XC(CoalSupplyCurve_Dom,PlanYear),XCL_PLIM(CoalSupplyCurve_Dom,LastModelYear_MNUMYR(PlanYear)));
				
				! EP$CSUPPLY,62
				ccalc_cRHS_rXCXle((CoalType,CoalSupplyCurve_Dom,PlanYear)|TOT_TYPE(CoalSupplyCurve_Dom) = ord(CoalType))  := VAL_XC(CoalSupplyCurve_Dom,PlanYear);
				! EP$CSUPPLY,63
				ccalc_cXCX_rXCXle((CoalType,CoalSupplyCurve_Dom,PlanYear) |TOT_TYPE(CoalSupplyCurve_Dom) = ord(CoalType)) := -1.0;
				! EP$CSUPPLY,64
				ccalc_cXCX_ECPCOSTS((CoalType,CoalSupplyCurve_Dom,PlanYear)|TOT_TYPE(CoalSupplyCurve_Dom) = ord(CoalType)) :=
				   20.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear));
				
				! Account for other demands on supply curve
				VAL_OTH(CoalSupplyCurve,PlanYear) :=
				  if (ord(CoalSupplyCurve) <= ord(last(CoalSupplyCurve_Dom))) then
				      min((0.9 * XCL_QECP0(element(CoalSupplyCurve_Dom_,ord(CoalSupplyCurve)),LastModelYear_MNUMYR(PlanYear))),XCL_OTHER(CoalSupplyCurve,LastModelYear_MNUMYR(PlanYear)))
				  else
				        XCL_OTHER(CoalSupplyCurve,LastModelYear_MNUMYR(PlanYear))
				  endif;
				
				! EP$CSUPPLY,65 - domestic curves, EP$CSUPPLY,75 - international curves
				ccalc_cMVOTH_LBOUND((CoalSupplyCurve,PlanYear)|XCL_TYPE(CoalSupplyCurve)) :=
				   VAL_OTH(CoalSupplyCurve,PlanYear);
				ccalc_cMVOTH_UBOUND((CoalSupplyCurve,PlanYear)|XCL_TYPE(CoalSupplyCurve)) :=
				   VAL_OTH(CoalSupplyCurve,PlanYear);
				! EP$CSUPPLY,66 - domestic curves, EP$CSUPPLY,76 - international curves
				ccalc_cMVOTH_rSCXle((CoalType,CoalSupplyCurve,PlanYear)|XCL_TYPE(CoalSupplyCurve)=ord(CoalType) ) :=
				   1.0;
				
				! EP$CSUPPLY,67 - Domestic supply curves only
				ccalc_cMV_rSCXle((CoalType,CoalSupplyCurve_Dom,PlanYear,CoalSupplyStep)|XCL_TYPE(CoalSupplyCurve_Dom)=ord(CoalType)) :=
				   -1.0;
				! EP$CSUPPLY,68
				ccalc_cMV_rXCXle((CoalType,CoalSupplyCurve_Dom,PlanYear,CoalSupplyStep) |XCL_TYPE(CoalSupplyCurve_Dom)=ord(CoalType)) :=
				    1.0;
				
				!Coal supply curve OBJ cost by step
				PCL((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   XCL_PECP0(CoalSupplyCurve_Dom,Element(Eleven_,ord(CoalSupplyStep)),LastModelYear_MNUMYR(PlanYear)) * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / (1 + AVGDCR)^ord(PlanYear) ;
				
				PCL_tmp((CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				    XCL_PECP0(CoalSupplyCurve_Dom,Element(Eleven_,ord(CoalSupplyStep)),MNUMYR_KYR(FullPlanningHorizon))
				      * UPGNPD(ModelYear_KYR(FullPlanningHorizon))  ;
				PCL((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(PCL_tmp(CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (UNXPH('1')-1)) ;
				
				!EP$CSUPPLY,69
				 ccalc_cMV_ECPCOSTS((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|XCL_TYPE(CoalSupplyCurve_Dom)) :=
				   PCL(CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear);
				
				!Coal supply curve quantity limit by step
				QCL((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   XCL_QECP0(CoalSupplyCurve_Dom,LastModelYear_MNUMYR(PlanYear)) * StepSize(CoalSupplyStep) ;
				
				QCL_tmp((CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				    XCL_QECP0(CoalSupplyCurve_Dom,MNUMYR_KYR(FullPlanningHorizon)) * StepSize(CoalSupplyStep) ;
				QCL((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(QCL_tmp(CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (UNXPH('1')-1)) / PVV_KW_ALT;
				
				!EP$CSUPPLY,70
				 ccalc_cMV_UBOUND((CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)|XCL_TYPE(CoalSupplyCurve_Dom)) :=
				  if (QCL(CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear) > -ECP_MIN('1') and QCL(CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear) < ECP_MIN('1') )then
				    ECP_MIN('1')
				  else
				    QCL(CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)
				  endif;
				
				! EP$CSUPPLY,71 - Domestic supply curves only
				ccalc_cMVUP6_rSCXle((CoalType,CoalSupplyCurve_Dom,PlanYear)|XCL_TYPE(CoalSupplyCurve_Dom)=ord(CoalType)) :=
				   -1.0;
				! EP$CSUPPLY,72
				ccalc_cMVUP6_rXCXle((CoalType,CoalSupplyCurve_Dom,PlanYear) |XCL_TYPE(CoalSupplyCurve_Dom)=ord(CoalType)) :=
				    1.0;
				
				!Coal supply curve escape vector OBJ cost
				PCL_UP6((CoalSupplyCurve_Dom,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   10.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / (1 + AVGDCR)^ord(PlanYear) ;
				
				PCL_UP6_tmp((CoalSupplyCurve_Dom,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				    10.0 * UPGNPD(ModelYear_KYR(FullPlanningHorizon))  ;
				PCL_UP6((CoalSupplyCurve_Dom,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(PCL_UP6_tmp(CoalSupplyCurve_Dom,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (UNXPH('1')-1)) ;
				
				!EP$CSUPPLY,73
				 ccalc_cMVUP6_ECPCOSTS((CoalSupplyCurve_Dom,PlanYear)|XCL_TYPE(CoalSupplyCurve_Dom)) :=
				   PCL_UP6(CoalSupplyCurve_Dom,PlanYear);
				
				!EP$CSUPPLY,74
				ccalc_cMVUP6_UBOUND((CoalSupplyCurve_Dom,PlanYear)|XCL_TYPE(CoalSupplyCurve_Dom)) :=
				   sum(CoalSupplyStep,ccalc_cMV_UBOUND(CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear)) * 100.0;
				
				!International Supply Curves
				!EP$CSUPPLY,77
				ccalc_cMVINT_rSCXle((CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStepINT)|TOT_TYPE(CoalSupplyCurve) = ord(CoalType)and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)
				  and XCL_QIMP(CoalSupplyCurve_Int_element(CoalSupplyCurve),Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) > 0.0) :=
				  -1.0;
				
				!Coal supply curve OBJ cost by step
				PCL_Int((CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   XCL_PIMP(CoalSupplyCurve_Int,Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) * UPGNPD(ModelYear_MNUMYRF(PlanYear)) / (1 + AVGDCR)^ord(PlanYear) ;
				
				PCL_Int_tmp((CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				    XCL_PIMP(CoalSupplyCurve_Int,Element(Ten_,ord(CoalSupplyStepINT)),MNUMYR_KYR(FullPlanningHorizon))
				      * UPGNPD(ModelYear_KYR(FullPlanningHorizon))  ;
				PCL_Int((CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(PCL_Int_tmp(CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon) / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (UNXPH('1')-1)) ;
				
				!EP$CSUPPLY,78
				 ccalc_cMVINT_ECPCOSTS((CoalSupplyCurve,CoalSupplyStepINT,PlanYear)|XCL_TYPE(CoalSupplyCurve) and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)
				   and XCL_QIMP(CoalSupplyCurve_Int_element(CoalSupplyCurve),Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) > 0.0) :=
				   PCL_Int(CoalSupplyCurve_Int_element(CoalSupplyCurve),CoalSupplyStepINT,PlanYear);
				
				!!Coal supply curve quantity limit by step
				QCL_Int((CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear)|ord(PlanYear) < UNXPH('1')) :=
				   XCL_QIMP(CoalSupplyCurve_Int,Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear));
				
				QCL_Int_tmp((CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon)|ord(FullPlanningHorizon) <= UNFPH('1')-UNXPH('1')+1):=
				    XCL_QIMP(CoalSupplyCurve_Int,Element(Ten_,ord(CoalSupplyStepINT)),MNUMYR_KYR(FullPlanningHorizon))
				        ;
				QCL_Int((CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear)|ord(PlanYear) = UNXPH('1')) :=
				  SUM(FullPlanningHorizon,(QCL_Int_tmp(CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon)  / (1 + AVGDCR) ^ ORD(FullPlanningHorizon)))
				  / ((1 + AVGDCR) ^ (UNXPH('1')-1)) / PVV_KW_ALT;
				
				
				!!EP$CSUPPLY,79
				 ccalc_cMVINT_UBOUND((CoalSupplyCurve,CoalSupplyStepINT,PlanYear)|XCL_TYPE(CoalSupplyCurve) and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)
				   and XCL_QIMP(CoalSupplyCurve_Int_element(CoalSupplyCurve),Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) > 0.0) :=
				  if (QCL_Int(CoalSupplyCurve_Int_element(CoalSupplyCurve),CoalSupplyStepINT,PlanYear) > -ECP_MIN('1') and QCL_Int(CoalSupplyCurve_Int_element(CoalSupplyCurve),CoalSupplyStepINT,PlanYear) < ECP_MIN('1') )then
				    ECP_MIN('1')
				  else
				    QCL_Int(CoalSupplyCurve_Int_element(CoalSupplyCurve),CoalSupplyStepINT,PlanYear)
				  endif;
				
				! escape vector for international supply curves
				! EP$CSUPPLY,80
				ccalc_cMVINT_rSCXle((CoalType,CoalSupplyCurve,PlanYear,CoalSupplyStepINT) | TOT_TYPE(CoalSupplyCurve) = ord(CoalType)and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)
				  and XCL_QIMP(CoalSupplyCurve_Int_element(CoalSupplyCurve),Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) > 0.0) :=
				  -1.0;
				! EP$CSUPPLY,81
				ccalc_cMVI11_ECPCOSTS((CoalSupplyCurve,PlanYear) | XCL_TYPE(CoalSupplyCurve) and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)) :=
				  if (max(CoalSupplyStepINT,ccalc_cMVINT_ECPCOSTS(CoalSupplyCurve,CoalSupplyStepINT,PlanYear)) * 5.0 > -ECP_MIN('1') and max(CoalSupplyStepINT,ccalc_cMVINT_ECPCOSTS(CoalSupplyCurve,CoalSupplyStepINT,PlanYear)) * 5.0 < ECP_MIN('1') )then
				    ECP_MIN('1')
				 else
				   max(CoalSupplyStepINT,ccalc_cMVINT_ECPCOSTS(CoalSupplyCurve,CoalSupplyStepINT,PlanYear)) * 5.0
				 endif;
				
				! EP$CSUPPLY,82
				TVAL_INT(CoalSupplyCurve_Int,PlanYear) :=
				     sum(CoalSupplyStepINT | XCL_QIMP(CoalSupplyCurve_Int,Element(Ten_,ord(CoalSupplyStepINT)),LastModelYear_MNUMYR(PlanYear)) > 0.0,
				           ccalc_cMVINT_UBOUND(CoalSupplyCurve_element(CoalSupplyCurve_Int),CoalSupplyStepINT,PlanYear));
				
				ccalc_cMVI11_UBOUND((CoalSupplyCurve,PlanYear) | XCL_TYPE(CoalSupplyCurve) and ord(CoalSupplyCurve) > card(CoalSupplyCurve_Dom)) :=
				  if (TVAL_INT(CoalSupplyCurve_Int_element(CoalSupplyCurve),PlanYear) * 100.0 > -ECP_MIN('1') and TVAL_INT(CoalSupplyCurve_Int_element(CoalSupplyCurve),PlanYear) * 100.0 < ECP_MIN('1') )then
				    ECP_MIN('1')
				 else
				    TVAL_INT(CoalSupplyCurve_Int_element(CoalSupplyCurve),PlanYear) * 100.0
				 endif;
				
				TST_SO2P(SO2Region,CoalPlant,PlanYear) :=
				  sum(FuelRegion|SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion),So2Region,PlanYear) > 0.0001 and C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion_EPCLMP(FuelRegion))=1
				    and (TST_CAP_BY_CRG(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion),ExplicitPlanningHorizon_element(PlanYear)) > 0.0 or NG_CoalShareExist2(FuelRegion,CoalPlant) or UPTTYP(CoalPlant) > EX_COAL('1')),
				      SO2SHR(CoalDemandRegion_EPCLMP(FuelRegion),So2Region,PlanYear));
				
				! EP$CSUPPLY,86, EP$CSUPPLY,87
				ccalc_cEUSO_rEUSOle((CoalPlant,SO2Region,PlanYear) | TST_SO2P(So2Region,CoalPlant,PlanYear)) :=
				  if (UPTTYP(CoalPlant) <= NW_COAL('1') and ECP_SCRUB(CoalPlant_UtilitySector(CoalPlant),cyr) = 1) then
				     -10.0
				   else
				     -1.0
				   endif;
				
				! EP$CSUPPLY,88 - fill 'le' or 'n' based on whether SO2 region program is active
				ccalc_cEUSO_rEUSO2Xle((SO2Region,PlanYear,CoalPlant)| TST_SO2P(So2Region,CoalPlant,PlanYear) and CHK_rEUSO2X(SO2Region, PlanYear)=1) :=
				  1.0;
				ccalc_cEUSO_rEUSO2Xn((SO2Region,PlanYear,CoalPlant)| TST_SO2P(So2Region,CoalPlant,PlanYear) and CHK_rEUSO2X(SO2Region, PlanYear)=0) :=
				  1.0;
				
				!EP$CSUPPLY,89
				ccalc_cEUSO_ECPCOSTS((CoalPlant,SO2Region,PlanYear)| TST_SO2P(So2Region,CoalPlant,PlanYear) ) :=
				  ECP_MIN('1');
				
				TST_HGP((nHGCODE,CoalPlant,PlanYear)|USW_HG('1')) :=
				  sum(FuelRegion|C_ECP_CDS(CoalPlant_UtilitySector(CoalPlant),CoalDemandRegion_EPCLMP(FuelRegion))=1
				    and (TST_CAP_BY_CRG(CoalPlant,CoalDemandRegion_EPCLMP(FuelRegion),ExplicitPlanningHorizon_element(PlanYear)) > 0.0 or NG_CoalShareExist2(FuelRegion,CoalPlant) or UPTTYP(CoalPlant) > EX_COAL('1')),1);
				
				!EP$CSUPPLY,94
				ccalc_cEUHG_rEUHGle((CoalPlant,nHGCODE,PlanYear)|TST_HGP(nHGCODE,CoalPlant,PlanYear)) :=
				  -1.0;
				!EP$CSUPPLY,95
				ccalc_cEUHG_rEUHGXXle((nHGCODE,PlanYear,CoalPlant)|TST_HGP(nHGCODE,CoalPlant,PlanYear)) :=
				  1.0;
				!EP$CSUPPLY,96
				ccalc_cEUHG_ECPCOSTS((CoalPlant,nHGCODE,PlanYear)|TST_HGP(nHGCODE,CoalPlant,PlanYear)) :=
				  ECP_MIN('1');
			}
			Parameter PCL {
				IndexDomain: (CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear);
			}
			Parameter PCL_TMP {
				IndexDomain: (CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon);
			}
			Parameter PCL_UP6 {
				IndexDomain: (CoalSupplyCurve_Dom,PlanYear);
			}
			Parameter PCL_UP6_TMP {
				IndexDomain: (CoalSupplyCurve_Dom,FullPlanningHorizon);
			}
			Parameter QCL {
				IndexDomain: (CoalSupplyCurve_Dom,CoalSupplyStep,PlanYear);
			}
			Parameter QCL_TMP {
				IndexDomain: (CoalSupplyCurve_Dom,CoalSupplyStep,FullPlanningHorizon);
			}
			Parameter PCL_Int {
				IndexDomain: (CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear);
			}
			Parameter PCL_Int_TMP {
				IndexDomain: (CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon);
			}
			Parameter QCL_Int {
				IndexDomain: (CoalSupplyCurve_Int,CoalSupplyStepINT,PlanYear);
			}
			Parameter QCL_Int_TMP {
				IndexDomain: (CoalSupplyCurve_Int,CoalSupplyStepINT,FullPlanningHorizon);
			}
			Parameter VAL_CAR {
				IndexDomain: (PlantType,CoalSupplyCurve);
			}
			Parameter VAL_CAR_CAP {
				IndexDomain: (PlantType,CoalSupplyCurve);
			}
			Parameter VAL_CARRG {
				IndexDomain: (PlantType,CoalSupplyCurve,FuelRegion_ALT1,CarbonRegion);
			}
			Parameter VAL1_SO2_EMIS {
				IndexDomain: (PlantType,CoalSupplyCurve,FuelRegion_ALT1,numACI,PlanYear);
			}
			Parameter SO2SHR {
				IndexDomain: (CoalDemandRegion,SO2Region,PlanYear);
			}
			Parameter VAL_SO2_EMIS {
				IndexDomain: (PlantType,CoalSupplyCurve,FuelRegion_ALT1,SO2Region,numACI,PlanYear);
			}
			Parameter VAL_HG_EMIS {
				IndexDomain: (PlantType,CoalSupplyCurve,FuelRegion_ALT1,numACI);
			}
			Parameter VAL_ESC {
				IndexDomain: PlanYear;
			}
			Parameter VAL_ESC_TMP {
				IndexDomain: FullPlanningHorizon;
			}
			Parameter T_TMP {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,PlanYear);
			}
			Parameter T_TMP_TMP {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon);
			}
			Parameter CTRAN {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,CoalPlant,PlanYear);
			}
			Parameter CTRAN_TMP {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,CoalPlant,FullPlanningHorizon);
			}
			Parameter VOM {
				IndexDomain: (CoalSupplyCurve,CoalPlant,numACI,PlanYear);
			}
			Parameter VOM_TMP {
				IndexDomain: (CoalSupplyCurve,CoalPlant,numACI,FullPlanningHorizon);
			}
			Parameter Condition_trans {
				IndexDomain: (CoalPlant,FuelRegion,PlanYear);
			}
			Parameter Condition_T1 {
				IndexDomain: (CoalDemandRegion,Scrubber,PlanYear);
			}
			Parameter VAL_XC {
				IndexDomain: (CoalSupplyCurve,PlanYear);
			}
			Parameter TVAL_INT {
				IndexDomain: (CoalSupplyCurve_Int,PlanYear);
			}
			Parameter TST_SO2P {
				IndexDomain: (SO2Region,CoalPlant,PlanYear);
			}
			Parameter TST_HGP {
				IndexDomain: (nHGCODE,CoalPlant,PlanYear);
			}
		}
		Procedure GET_EMF_AND_ACI {
			Body: {
				Allowed(CoalSupplyCurve, CoalDemandRegion, CoalPlant, '1') := 1 $ (ACI_CST('1',  EmissionRank_Element(CoalSupplyCurve), PlantType_ECP_element(CoalPlant))=0);
				MACT_EMF(CoalSupplyCurve,CoalDemandRegion,CoalPlant) := MIN(HG_MEFNC(CoalDemandRegion, cyr),PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))) $ (USW_CAMR('1')>0);
				EMF_T(CoalSupplyCurve, CoalDemandRegion_ALT1, CoalPlant, numACI) := PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve));
				ACI(CoalSupplyCurve, CoalDemandRegion, CoalPlant, numACI):= 0.0;
				
				MACT_SW(EmissionRank, CoalPlant) := 1 $
				(HG_OUTPUT(MercuryClass_ECP(CoalPlant), EmissionRank, cyr)>0 OR HG_INPUT(MercuryClass_ECP(CoalPlant), EmissionRank, cyr)>0 OR
				HG_MEF(MercuryClass_ECP(CoalPlant), EmissionRank, cyr)>0);
				
				EMF_PRCNT(EmissionRank, CoalPlant) :=
				if HG_MEF(MercuryClass_ECP(CoalPlant), EmissionRank, cyr)>0 then HG_MEF(MercuryClass_ECP(CoalPlant), EmissionRank, cyr)
				else 1
				endif;
				
				EMF_IN(CoalSupplyCurve, CoalDemandRegion, CoalPlant) :=
				if HG_INPUT(MercuryClass_ECP(CoalPlant), EmissionRank_Element(CoalSupplyCurve), cyr)>0 then
				MIN(1.0, HG_INPUT(MercuryClass_ECP(CoalPlant), EmissionRank_Element(CoalSupplyCurve), cyr)) /$ (XCL_HG_YR(CoalSupplyCurve, cyr)) !yda: if coef doesn't match, check if XCL_HG_YR is transfered correctly'
				else 1
				endif;
				
				EMF_OUT(CoalSupplyCurve, CoalDemandRegion, CoalPlant) :=
				if HG_OUTPUT(MercuryClass_ECP(CoalPlant), EmissionRank_Element(CoalSupplyCurve), cyr)>0 then
				 MIN(1.0, 1000.0 * HG_OUTPUT(MercuryClass_ECP(CoalPlant), EmissionRank_Element(CoalSupplyCurve), cyr)) /$ HRTCLNR(CoalDemandRegion,cyr,PlantType_ECP_element(CoalPlant)) /$ XCL_HG_YR(CoalSupplyCurve, cyr)
				else 1
				endif;
				!  Skip Steps If No CAMR and Just Specified Required EMF, If Achievable
				IF (USW_CAMR('1')<=0) THEN
				        MACT_EMF(CoalSupplyCurve,CoalDemandRegion,CoalPlant) :=
				        MIN(PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) , EMF_PRCNT(EmissionRank_Element(CoalSupplyCurve), CoalPlant));
				        MACT_EMF(CoalSupplyCurve,CoalDemandRegion, CoalPlant):=
				        IF (HG_CHOICE(CoalPlant)= 1) THEN
				            MIN(MACT_EMF(CoalSupplyCurve,CoalDemandRegion,CoalPlant), EMF_IN(CoalSupplyCurve,CoalDemandRegion, CoalPlant))
				        ELSEIF (HG_CHOICE(CoalPlant)= 2) THEN
				            MIN(MACT_EMF(CoalSupplyCurve,CoalDemandRegion, CoalPlant), EMF_OUT(CoalSupplyCurve, CoalDemandRegion, CoalPlant))
				        ELSEIF (HG_CHOICE(CoalPlant)= 3) THEN
				            MAX(MIN(MACT_EMF(CoalSupplyCurve,CoalDemandRegion,CoalPlant), EMF_IN(CoalSupplyCurve,CoalDemandRegion, CoalPlant)),
				             MIN(MACT_EMF(CoalSupplyCurve,CoalDemandRegion,CoalPlant), EMF_OUT(CoalSupplyCurve, CoalDemandRegion, CoalPlant)))
				        ENDIF;
				
				        EMF_T(CoalSupplyCurve, CoalDemandRegion, CoalPlant, numACI):=
				        IF (MACT_SW(EmissionRank_Element(CoalSupplyCurve), CoalPlant)= 1 AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) > MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) < PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) and
				        ord(numACI)=ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))+1) then
				            MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant)
				        ELSEIF (MACT_SW(EmissionRank_Element(CoalSupplyCurve), CoalPlant)= 1 AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) > MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) < PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) and
				        ord(numACI)>=2 and ord(numACI)<=ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))) then
				            PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) - (ord(numACI) - 1) *
				            ((PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) - MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))) /
				            (ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))-1))
				        ELSEIF (MACT_SW(EmissionRank_Element(CoalSupplyCurve), CoalPlant)= 1 OR EMLIM('4',cyr) <100.0 OR HG_GRAMS_MWH(MercuryClass_ECP(CoalPlant), cyr) > 0.0) AND
				        ord(numACI)>=2 and ord(numACI)<=ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))+1 THEN
				             PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) - (ord(numACI) - 1) *
				            ((PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) - MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))) /
				            (ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))))
				        ENDIF;
				
				
				        Allowed((CoalSupplyCurve, CoalDemandRegion, CoalPlant, numACI)| (MACT_SW(EmissionRank_Element(CoalSupplyCurve), CoalPlant)= 1 OR EMLIM('4',cyr) <100.0 OR
				        HG_GRAMS_MWH(MercuryClass_ECP(CoalPlant), cyr) > 0.0) AND
				        ord(numACI)>=2 and ord(numACI)<=ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))+1):= 1;
				
				        ACI((CoalSupplyCurve, CoalDemandRegion, CoalPlant, numACI)| (MACT_SW(EmissionRank_Element(CoalSupplyCurve), CoalPlant)= 1 OR EMLIM('4',cyr) <100.0 OR
				        HG_GRAMS_MWH(MercuryClass_ECP(CoalPlant), cyr) > 0.0) AND
				        ord(numACI)>=2 and ord(numACI)<=ACI_STEPS(CoalPlant, EmissionRank_Element(CoalSupplyCurve))+1):=
				                1000.0 * 1000.0 * 1000.0 * 0.000454 * PARM_C(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) * 2.2 / 12000.0 *
				        MAX(0.0 , (PARM_A(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) /
				        (PARM_D(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) - 100.0 + 100.0 * EMF_T(CoalSupplyCurve, CoalDemandRegion, CoalPlant, numACI) /
				        (FGD_FCTR(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) * SCR_FCTR(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)))) -
				         PARM_B(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve))));
				ELSE
				        Allowed((CoalSupplyCurve, CoalDemandRegion, CoalPlant, '1')|
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant)<PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				         Allowed(CoalSupplyCurve, CoalDemandRegion, CoalPlant, '1')>0):= 2;
				
				        Allowed((CoalSupplyCurve, CoalDemandRegion, CoalPlant, '2')|
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant)<PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) >= MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))):= 1;
				
				        EMF_T((CoalSupplyCurve, CoalDemandRegion, CoalPlant, '2')|
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant)<PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) >= MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))):=
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant);
				
				        ACI((CoalSupplyCurve, CoalDemandRegion, CoalPlant, '2')|
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant)<PLNT_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve)) AND
				        MACT_EMF(CoalSupplyCurve, CoalDemandRegion, CoalPlant) >= MIN_EMF(CoalPlant, EmissionRank_Element(CoalSupplyCurve))):=
				        1000.0 * 1000.0 * 1000.0 * 0.000454 * PARM_C(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) * 2.2 / 12000.0 *
				        MAX(0.0 , (PARM_A(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) /
				        (PARM_D(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) - 100.0 + 100.0 * EMF_T(CoalSupplyCurve, CoalDemandRegion, CoalPlant, '2') /
				        (FGD_FCTR(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)) * SCR_FCTR(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve)))) -
				         PARM_B(PlantType_ECP_element(CoalPlant), EmissionRank_Element(CoalSupplyCurve))));
				
				ENDIF;
			}
			DeclarationSection Local_Declaration;
		}
		Procedure EP_INT_Calculations {
			Body: {
				!EP$INT,78
				ccalc_cI_IMP_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, SupplyRegion_SUBfrom, Intermittent, OwnerType, SupplyRegion_SUB, ElasticityStep, PlanYear_ALTB)|
				MAP_ImportRegion(SupplyRegion_SUBfrom, SupplyRegion_SUB) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB))
				and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr)):=
				IF UPBLDTYP(SupplyRegion_SUBfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) and
				(OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1) and
				(UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear_ALTB, Intermittent) AND
				(UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUBfrom)>0) AND
				 (UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUBfrom) > 0)) THEN
				IF UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUBfrom, Counter_ImportRegion(SupplyRegion_SUBfrom, SupplyRegion_SUB), cyr)<9999 then
				if UPICFC1(Intermittent, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_SUBfrom, cyr)>ECP_MIN('1') then
				UPICFC1(Intermittent, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_SUBfrom, cyr)
				endif
				endif
				endif;
				!EP$INT,78
				ccalc_cI_SUBIMP_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, SupplyRegion_SUBfrom, Intermittent, OwnerType, SupplyRegion_SUB, ElasticityStep, PlanYear_ALTB)|
				MAP_ImportRegion(SupplyRegion_SUBfrom, SupplyRegion_SUB) and
				LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB))
				and ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and
				Subsidy_Case(PlanYear_ALTB, Intermittent)=2):=
				IF UPBLDTYP(SupplyRegion_SUBfrom)=ord(OwnerType) and ord(PlanYear)>=OLYEAR(PlanYear_ALTB, Intermittent) and
				(OLYEAR(PlanYear_ALTB, Intermittent) <= UNXPH('1') AND UPVTYP(Intermittent)= 1) and
				(UPAVLYR(Intermittent)<= FULLYEAR_ALT(PlanYear_ALTB, Intermittent) AND
				(UPBLDREG_us00(Intermittent)> 0 AND UPBLDREG(Intermittent, SupplyRegion_SUBfrom)>0) AND
				 (UPBLDREG_us00(LCAP_element(Intermittent)) > 0 AND UPBLDREG(LCAP_element(Intermittent),SupplyRegion_SUBfrom) > 0)) THEN
				IF UPETTSW(Intermittent)= 1 and 0<EPTCST(SupplyRegion_SUBfrom, Counter_ImportRegion(SupplyRegion_SUBfrom, SupplyRegion_SUB), cyr)<9999 then
				if UPICFC1(Intermittent, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_SUBfrom, cyr)>ECP_MIN('1') then
				UPICFC1(Intermittent, ECPLoadGroup_element(LoadGroup), LoadSegment_to_StepsPerGroup(LoadSegment), SupplyRegion_SUBfrom, cyr)
				endif
				endif
				endif;
			}
		}
		DeclarationSection Temp_Declaration {
			ElementParameter tmnum {
				IndexDomain: (FullPlanningHorizon,PlanYear);
				Range: MNUMYR_;
				Definition: Element(MNUMYR_,min(UNYEAR('1'),CURIYR('1')+ord(FullPlanningHorizon)+ord(PlanYear)-2));
			}
			Parameter OrdPlntType {
				IndexDomain: PlantType;
				Definition: ord(PlantType);
			}
			Parameter OrdSupRgn {
				IndexDomain: SupplyRegion;
				Definition: ord(SupplyRegion);
			}
			Parameter OrdFlpRgn {
				IndexDomain: FuelRegion;
				Definition: ord(FuelRegion);
			}
			Parameter OrdCLRgn {
				IndexDomain: CoalDemandRegion;
				Definition: ord(CoalDemandRegion);
			}
			ElementParameter TST_DSP {
				IndexDomain: (DispatchableECP);
				Range: PlantType_;
				Definition: element(PlantType_,UCPDSPI(DispatchableECP));
			}
			ElementParameter FuelRegion_DSPelement {
				IndexDomain: (SupplyRegion_SUB,DSP_Types,FuelRegion,PlanYear);
				Range: FuelRegion_;
			}
			ElementParameter Load_element {
				IndexDomain: (OperatingMode, Season, SupplyRegion_SUB);
				Range: SliceGroup_;
			}
			ElementParameter LastCoalplant {
				Range: PlantType_;
			}
		}
		DeclarationSection CFDGN_Declaration {
			Parameter VLSMAP1 {
				IndexDomain: (SlicePerSeason,Season,ExplicitPlanningHorizon,SupplyRegion);
			}
			Parameter VLSMAP2 {
				IndexDomain: (SliceGroup,Season,ExplicitPlanningHorizon,SupplyRegion);
			}
			Parameter NSTP {
				IndexDomain: (Season,SupplyRegion);
			}
			Parameter VLSMODE {
				IndexDomain: (SliceGroup,ExplicitPlanningHorizon,SupplyRegion);
			}
			Parameter VLSSEAS {
				IndexDomain: (SliceGroup,ExplicitPlanningHorizon,SupplyRegion);
			}
			Parameter CapacityFactor {
				IndexDomain: (SlicePerSeason,Season,ExplicitPlanningHorizon,SupplyRegion);
				Property: Double;
			}
			ElementParameter VLSSliceGroup_element {
				IndexDomain: (SlicePerSeason,Season,ExplicitPlanningHorizon,SupplyRegion);
				Range: SliceGroup_;
			}
			ElementParameter VLSMode_element {
				IndexDomain: (SliceGroup,ExplicitPlanningHorizon,SupplyRegion);
				Range: OperatingMode_;
			}
			ElementParameter VLSSeason_element {
				IndexDomain: (SliceGroup,ExplicitPlanningHorizon,SupplyRegion);
				Range: Season_;
			}
			Index SliceGroup_ALT {
				Range: SliceGroup_;
			}
		}
		Procedure EPINCST_p {
			Arguments: {
				(PLTS,Steps,SubCondition,CLT,PLT,OVRCST,PROFILE,CAPESC,GNPF,INTR,DEBT_F,ROR,TXBOOK,
				 BVBOOK)
			}
			Body: {
				KYR_year((Plants, PlanYear, ConstructionPeriod)| ord(ConstructionPeriod)<= CLT(plants)):=
				CURIYR('1')+ord(PlanYear)+ ord(ConstructionPeriod)-2 + PLT(plants)- CLT(plants);
				
				KYR_MNUMYRX(plants, PlanYear, ConstructionPeriod):=element(MNUMYRX_,KYR_year(plants, PlanYear, ConstructionPeriod));
				KYR_MNUMYRF(plants, PlanYear, ConstructionPeriod):=element(MNUMYRF_,KYR_year(plants, PlanYear, ConstructionPeriod));
				
				YCWP((SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod) |
				ord(ConstructionPeriod)<= CLT(plants) and SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type) ):=
				OVRCST(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type) *
				PROFILE(plants, ConstructionPeriod) * CAPESC(KYR_MNUMYRX(plants, PlanYear, ConstructionPeriod), plants) *
				GNPF(KYR_MNUMYRF(plants, PlanYear, ConstructionPeriod));
				
				BVBOOK_temp((SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod) |
				ord(ConstructionPeriod)<= CLT(plants) and SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type) ) :=
				sum(ConstructionPeriod_ALT1 | ConstructionPeriod_ALT1<=ConstructionPeriod,
				YCWP(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod_ALT1)*
				(1+0.5*ROR(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type))*
				(1+ROR(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type))^(ord(ConstructionPeriod)-ord(ConstructionPeriod_ALT1)) );
				
				BVBOOK(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type):=
				BVBOOK_temp(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, element(ConstructionPeriod_,CLT(plants)));
				
				TXBOOK((SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type)|
				 SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type)) :=
				YCWP(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, first(ConstructionPeriod)) +
				0.5* YCWP(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, first(ConstructionPeriod)) *
				INTR(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type)* DEBT_F(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type) +
				sum(ConstructionPeriod| 2<=ord(ConstructionPeriod)<= CLT(plants), YCWP(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod) +
				(BVBOOK_temp(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod-1) +
				0.5* YCWP(SupplyRegion_SUB, plants, PlanYear, OwnerType, Step, subsidy_type, ConstructionPeriod)) *
				INTR(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type)* DEBT_F(SupplyRegion_SUB, plants, PlanYear, OwnerType, subsidy_type)  );
			}
			Parameter OVRCST {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Parameter PROFILE {
				IndexDomain: (plants,ConstructionPeriod);
				Property: Input;
			}
			Parameter CAPESC {
				IndexDomain: (MNUMYRX,plants);
				Property: Input;
			}
			Parameter GNPF {
				IndexDomain: (MNUMYRF);
				Property: Input;
			}
			Parameter INTR {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter DEBT_F {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter ROR {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter TXBOOK {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Output;
			}
			Parameter BVBOOK {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Output;
			}
			Parameter BVBOOK_temp {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type,ConstructionPeriod);
			}
			Parameter YCWP {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type,ConstructionPeriod);
			}
			Parameter KYR_year {
				IndexDomain: (plants,PlanYear,ConstructionPeriod);
			}
			ElementParameter KYR_MNUMYRX {
				IndexDomain: (plants,PlanYear,ConstructionPeriod);
				Range: MNUMYRX_;
			}
			ElementParameter KYR_MNUMYRF {
				IndexDomain: (plants,PlanYear,ConstructionPeriod);
				Range: MNUMYRF_;
			}
			Parameter CLT {
				IndexDomain: plants;
				Property: Input;
			}
			Parameter PLT {
				IndexDomain: plants;
				Property: Input;
			}
			Set PLTS {
				Index: plants;
				Property: Input;
			}
			Parameter SubCondition {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Set Steps {
				Index: step;
				Property: Input;
			}
		}
		Procedure EPCNBLD_p {
			Arguments: (PLTS,Steps,SubCondition,DF2,RATIO,ROEPRM,INTPRM,UTROE,UTINT,TR,TL,CL,DL2,CAP);
			Body: {
				EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) := ROEPRM + UTROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				EWGINT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) := INTPRM + UTINT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				EFRAC2(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) := 1 - DF2(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				X(plt):=DL2(plt);
				!         WRITE(18,'(A,I4,I4)')'DEBT LIFE GT CONTRACT LIFE ',DL2,CL
				DL2((plt) | DL2(plt) > CL(plt)) := CL(plt);
				
				DPP(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) := 1/X(plt) * DF2(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				PVDPP(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) := DPP(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type)/$
				CRF_f(EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type),DL2(plt));
				PVDEBT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) :=
				(X(plt)/ EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) *
				(1 - ((1 - (1 + EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type)) ^ ( - X(plt)))/
				(X(plt) * EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type)))) / X(plt)) * DF2(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				PVINT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) :=
				PVDEBT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) * EWGINT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type);
				
				DepreciationOptions_el(plt):=
				IF TL(plt) = 5 then element(DepreciationOptions_,1)
				ELSEIF TL(plt) = 7 then element(DepreciationOptions_,2)
				ELSEIF TL(plt) = 10 then element(DepreciationOptions_,3)
				ELSEIF TL(plt) = 15 then element(DepreciationOptions_,4)
				ELSEIF TL(plt) = 20 then element(DepreciationOptions_,5)
				endif;
				
				for plt in PLTS do
				if TL(plt)<10 then
				  TL_:=elementrange(1,TL(plt),1,"0");
				else
				  TL_:=elementrange(1,TL(plt));
				endif;
				!D(tlind):=TAXDEPRN(elementcast(DepreciationYears_,tlind), DepreciationOptions_el, element(MNUMYR_, min(CURIYR('1') + UPPLYR(WIPV_element),UNYEAR('1'))));
				!PVTB := sum(tlind, PVV_Function(D(tlind),ord(tlind),EWGROE)) * RATIO;
				PVTB((SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type)) :=
				!sum(tlind, PVV_Function(TAXDEPRN(elementcast(DepreciationYears_,tlind), DepreciationOptions_el(plt),element(MNUMYR_, min(CURIYR('1') + UPPLYR(WIPV_element),UNYEAR('1')))),
				!ord(tlind),EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type))) *
				sum(tlind, TAXDEPRN(elementcast(DepreciationYears_,tlind), DepreciationOptions_el(plt),element(MNUMYR_, min(CURIYR('1') + UPPLYR(WIPV_element),UNYEAR('1')))) /
				((1 + EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type)) ^ ord(tlind)))*
				RATIO(SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type);
				endfor;
				
				CAP((SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type)):=
				(EFRAC2(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type)/(1 - TR) + PVINT(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) -
				(TR/(1 - TR) * PVTB(SupplyRegion_SUB, plt, PlanYear, OwnerType2, Step, subsidy_type)) +
				PVDPP(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type) / (1 - TR)) * CRF_f(EWGROE(SupplyRegion_SUB, plt, PlanYear, OwnerType2, subsidy_type),CL(plt));
				!
			}
			Comment: {
				"EPCNBLD CALCULATES THE CAPACITY PAYMENT DUE FOR PURCHASED POWER UNDER SPECIFIED CONDITIONS
				!     THE OUTPUT OF THE ROUTINE IS THE FRACTION OF THE INSTALLED COST
				!     REQUIRED FOR RECOVERY EACH YEAR DURING THE CONTRACT LIFE TO YIELD
				!     THE TARGET EWG ROE AS AN IRR TO THE PROJECT OWNER (I.E.,CAP)"
			}
			Parameter DF2 {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter RATIO {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Parameter ROEPRM {
				Property: Input;
			}
			Parameter INTPRM {
				Property: Input;
			}
			Parameter UTROE {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter UTINT {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter TR {
				Property: Input;
			}
			Parameter TL {
				IndexDomain: plt;
				Property: Input;
			}
			Parameter CL {
				IndexDomain: plt;
				Property: Input;
			}
			Parameter DL2 {
				IndexDomain: plt;
				Property: Input;
			}
			Parameter CAP {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,Step,subsidy_type);
				Property: Output;
			}
			Parameter EFRAC2 {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter X {
				IndexDomain: plt;
			}
			Parameter EWGROE {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter EWGINT {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter DPP {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter PVDPP {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter PVDEBT {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter PVINT {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,subsidy_type);
			}
			Parameter PVTB {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,Step,subsidy_type);
			}
			Parameter D {
				IndexDomain: tlind;
			}
			ElementParameter DepreciationOptions_el {
				IndexDomain: plt;
				Range: DepreciationOptions_;
			}
			Set TL_ {
				Index: tlind;
			}
			Set PLTS {
				Index: plt;
				Property: Input;
			}
			Parameter SubCondition {
				IndexDomain: (SupplyRegion,plt,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Set Steps {
				Index: step;
				Property: Input;
			}
		}
		Procedure EPNBLD_p {
			Arguments: (PLTS,Steps,SubCondition,ROR,DR,RATIO,PE,EL,TL,T,CL,NBLDP1);
			Body: {
				!     CALCULATE PRESENT VALUE OF RATE BASE
				!
				!     FIRST CALCULATE PV OF ACCUM TAX DEPR
				DepreciationOptions_el(plants):=
				IF TL(plants) = 5 then element(DepreciationOptions_,1)
				ELSEIF TL(plants) = 7 then element(DepreciationOptions_,2)
				ELSEIF TL(plants) = 10 then element(DepreciationOptions_,3)
				ELSEIF TL(plants) = 15 then element(DepreciationOptions_,4)
				ELSEIF TL(plants) = 20 then element(DepreciationOptions_,5)
				endif;
				
				for plants in PLTS do
				TL_:=elementrange(1,CL(plants));
				! NOTE THIS STORES THE ACCUMULATED ANNUAL VALUES AT BEGINING OF YEAR
				! YEAR 1 EQUALS ZERO
				tlind_1:=first(TL_);
				D(tlind_1,plants):=0;
				D((tlind,plants) | 1<ord(tlind)<=21):=sum(tlind1 | tlind1<=tlind-1, TAXDEPRN(elementcast(DepreciationYears_,tlind1), DepreciationOptions_el(plants),
				element(MNUMYR_, min(CURIYR('1') + UPPLYR(WIPV_element),UNYEAR('1')))));
				IF (CL(plants) > TL(plants)+1) THEN D((tlind,plants)| (TL(plants)+1)<ord(tlind)<=CL(plants)):= 1; endif;
				
				!     CALUCULATE PV OF BV OF SL DEPR
				PVRB((SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)) :=
				1/CRF_f(DR(SupplyRegion_SUB, plants),CL(plants)) -
				PVBV_f(EL(plants),CL(plants),DR(SupplyRegion_SUB, plants)) -
				!(sum(tlind, PVV_Function(D(tlind,plants),ord(tlind),DR(SupplyRegion_SUB, plants))) -
				(sum(tlind, D(tlind,plants) / ((1 + DR(SupplyRegion_SUB, plants)) ^ ord(tlind))) -
				PVBV_f(EL(plants),CL(plants),DR(SupplyRegion_SUB, plants))) * T *
				RATIO(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type);
				endfor;
				
				!     NOW CALCULATE THE REST OF THE CAPITAL CHARGE
				X((SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)) :=
				PVRB(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type) * ROR(SupplyRegion_SUB, plants, PlanYear, OwnerType1, subsidy_type);
				Y(SupplyRegion_SUB, plants) :=(1/EL(plants))/$CRF_f(DR(SupplyRegion_SUB, plants),CL(plants));
				Z((SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)) :=
				PVRB(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type) * PE(SupplyRegion_SUB) *
				ROR(SupplyRegion_SUB, plants, PlanYear, OwnerType1, subsidy_type) * T/(1 - T);
				
				NBLDP1((SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)|
				SubCondition(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)) :=
				(X(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type) + Y(SupplyRegion_SUB, plants) +
				Z(SupplyRegion_SUB, plants, PlanYear, OwnerType1, Step, subsidy_type)) *
				 CRF_f(DR(SupplyRegion_SUB, plants),CL(plants));
			}
			Comment: {
				"!     CALCULATE UTILITY CAPITAL CHARGE RATE
				!     ASSUMES:
				!     AT COC = DISCOUNT RATE (DR)
				!     TR=MARGINAL TAX RATE
				!     PE=(CE*CF+PE*PF)/ROR=PORTION OF ROR TAXABLE"
			}
			Set PLTS {
				Index: plants;
				Property: Input;
			}
			Parameter ROR {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,subsidy_type);
				Property: Input;
			}
			Parameter DR {
				IndexDomain: (SupplyRegion,plants);
				Property: Input;
			}
			Parameter RATIO {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Parameter PE {
				IndexDomain: SupplyRegion;
				Property: Input;
			}
			Parameter EL {
				IndexDomain: plants;
				Property: Input;
			}
			Parameter TL {
				IndexDomain: plants;
				Property: Input;
			}
			Parameter T {
				Property: Input;
			}
			Parameter CL {
				IndexDomain: plants;
				Property: Input;
			}
			Parameter NBLDP1 {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Output;
			}
			ElementParameter DepreciationOptions_el {
				IndexDomain: plants;
				Range: DepreciationOptions_;
			}
			Set TL_ {
				Index: tlind, tlind1;
			}
			ElementParameter tlind_1 {
				Range: TL_;
			}
			Parameter D {
				IndexDomain: (tlind,plants);
			}
			Parameter Z {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
			}
			Parameter Y {
				IndexDomain: (SupplyRegion,plants);
			}
			Parameter X {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
			}
			Parameter PVRB {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
			}
			Parameter SubCondition {
				IndexDomain: (SupplyRegion,plants,PlanYear,OwnerType,Step,subsidy_type);
				Property: Input;
			}
			Set Steps {
				Index: step;
				Property: Input;
			}
		}
		DeclarationSection CarbonTaxes {
			Parameter PJRSEL {
				IndexDomain: MNUMYR;
			}
			Parameter PJDSEL {
				IndexDomain: MNUMYR;
			}
			Parameter PJCLEL {
				IndexDomain: MNUMYR;
			}
			Parameter PJNGEL {
				IndexDomain: MNUMYR;
			}
			Parameter FirstTime {
				Range: binary;
				InitialData: 1;
			}
			Parameter FirstYear {
				IndexDomain: MNUMYR;
				Range: binary;
			}
		}
		DeclarationSection Build_Costs_Declaration {
			Parameter CSTDTADJ {
				IndexDomain: (SupplyRegion,PlantType,PlanYear);
			}
			Parameter CSTEQADJ {
				IndexDomain: (SupplyRegion,PlantType,PlanYear);
			}
			Parameter SHRDTADJ {
				IndexDomain: (SupplyRegion,PlantType,PlanYear);
			}
			Parameter DEBT_F {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)| ord(SupplyRegion)<=UNRGNS('1') and UPBLDTYP(SupplyRegion)=ord(OwnerType) and
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1')
				}
				Definition: {
					if (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) and
					((PlantType in Intermittent_  AND UPVTYP(PlantType)= 1 and
					UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) or
					(PlantType in NUC_Types_ and UPVTYP(PlantType)= 1 and UPOVR(PlantType) < 9000) or
					(PlantType in DistributedGenType_) or (PlantType in OtherRenewable_  AND UPVTYP(PlantType)= 1 and
					EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)<9000 and EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)) or
					(PlantType in DSP_Types_ and UPVTYP(PlantType)= 1) or
					(PlantType=WIDS_Element)) then
					SHRDTADJ(SupplyRegion, PlantType, PlanYear)+
						if ord(OwnerType)=1 then
							IF (UPSUBCAS(PlantType)= 3 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        		EPUFDT('1', SupplyRegion, cyr)
							ELSE
					        		EPUFDT('1', SupplyRegion, cyr) + UPNFDTA(PlantType)
							ENDIF
						else
							IF (UPSUBCAS(PlantType)= 3 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        		UPNFDT('1')
							ELSE
					        		UPNFDT('1') + UPNFDTA(PlantType) * DBTADJ(PlantType, PlanYear)
							ENDIF
						endif
					endif
				}
				Comment: "CHECK FOR SUBSIDY LIMIT FOR DEBT FRACTION";
			}
			Parameter DBTADJ {
				IndexDomain: (PlantType, PlanYear) | OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType);
				Definition: {
					IF ((PlantType in Intermittent_ and UPVTYP(PlantType)= 1) or PlantType = WIDS_Element) and UPNFDTA(PlantType)<> 0 AND USW_WACC('1') > 0 THEN
					  IF UPCSBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1')))> 0 THEN
					        1.0 - (UPCSBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1'))) -
					        UPCSBYR(PlantType,element(MNUMYR_,MIN(CURIYR('1') + OLYEAR(PlanYear, PlantType) - 1,UNYEAR('1'))))) /  $
					        UPCSBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1')))
					  ELSEIF (UPGSUBPT(PlantType)> 0 AND UPGSUBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1')))> 0) THEN
					        1.0 - (UPGSUBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1'))) -
					        UPGSUBYR(PlantType,element(MNUMYR_,MIN(CURIYR('1') + OLYEAR(PlanYear, PlantType) - 1,UNYEAR('1'))))) /  $
					        UPGSUBYR(PlantType, element(MNUMYR_,UPSTYR('1') - UHBSYR('1')))
					  ELSE
					        1
					  ENDIF
					else
					1
					endif
				}
				Comment: "ADJUST DEBT FRACTION ADJUSTMENT WHEN SUBSIDY IN PLACE";
			}
			Parameter UTINT {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)|  ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType)
				}
				Definition: {
					if (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) and
					((PlantType in Intermittent_  AND UPVTYP(PlantType)= 1 and
					UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) or
					(PlantType in NUC_Types_ and UPVTYP(PlantType)= 1 and UPOVR(PlantType) < 9000) or
					(PlantType in DistributedGenType_) or (PlantType in OtherRenewable_  AND UPVTYP(PlantType)= 1 and
					EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)<9000 and EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)) or
					(PlantType in DSP_Types_ and UPVTYP(PlantType)= 1) or
					(PlantType=WIDS_Element)) then
					CSTDTADJ(SupplyRegion, PlantType, PlanYear)+
					IF (UPSUBCAS(PlantType)= 4 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        EPUIRT('1', SupplyRegion, cyr)
					ELSE
					        EPUIRT('1', SupplyRegion, cyr) + UPNIRTEA(PlantType)
					ENDIF
					
					endif
				}
				Comment: "CHECK FOR SUBSIDY LIMIT FOR DEBT INTEREST RATE";
			}
			Parameter EWGINT {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)| ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND ord(OwnerType)=2
				}
				Definition: {
					if (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) and
					((PlantType in Intermittent_  AND UPVTYP(PlantType)= 1 and
					UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) or
					(PlantType in NUC_Types_ and UPVTYP(PlantType)= 1 and UPOVR(PlantType) < 9000) or
					(PlantType in DistributedGenType_) or (PlantType in OtherRenewable_  AND UPVTYP(PlantType)= 1 and
					EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)<9000 and EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)) or
					(PlantType in DSP_Types_ and UPVTYP(PlantType)= 1) or
					(PlantType=WIDS_Element)) then
						CSTDTADJ(SupplyRegion, PlantType, PlanYear)+
						IF (UPSUBCAS(PlantType)= 4 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        	EPUIRT('1', SupplyRegion, cyr) + UPNIPRM('1')
						ELSE
					        	EPUIRT('1', SupplyRegion, cyr) + UPNIRTEA(PlantType) + UPNIPRM('1')
						ENDIF
					
					endif
				}
				Comment: "CHECK FOR SUBSIDY LIMIT FOR DEBT INTEREST RATE";
			}
			Parameter UTROE {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)|   ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType)
				}
				Definition: {
					if (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) and
					((PlantType in Intermittent_  AND UPVTYP(PlantType)= 1 and
					UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) or
					(PlantType in NUC_Types_ and UPVTYP(PlantType)= 1 and UPOVR(PlantType) < 9000) or
					(PlantType in DistributedGenType_) or (PlantType in OtherRenewable_  AND UPVTYP(PlantType)= 1 and
					EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)<9000 and EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)) or
					(PlantType in DSP_Types_ and UPVTYP(PlantType)= 1) or
					(PlantType=WIDS_Element)) then
						CSTEQADJ(SupplyRegion, PlantType, PlanYear) +
						if ord(OwnerType)=1 then
							IF (UPSUBCAS(PlantType)= 5 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        		(EPUROR('1', SupplyRegion, cyr) - EPUFDT('1', SupplyRegion, cyr) * EPUIRT('1', SupplyRegion, cyr)) / (1.0 - EPUFDT('1', SupplyRegion, cyr))
							ELSE
					        		(EPUROR('1', SupplyRegion, cyr) - EPUFDT('1', SupplyRegion, cyr) * EPUIRT('1', SupplyRegion, cyr)) / (1.0 - EPUFDT('1', SupplyRegion, cyr)) +
					        		 UPNRRTEA(PlantType)
							ENDIF
						else
							IF (UPSUBCAS(PlantType)= 5 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					       			EPUCRE('1', SupplyRegion, cyr)
							ELSE
					       			EPUCRE('1', SupplyRegion, cyr) + UPNRRTEA(PlantType)
							ENDIF
						endif
					
					endif
				}
				Comment: "CHECK FOR SUBSIDY LIMIT FOR DEBT INTEREST RATE";
			}
			Parameter EWGROE {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)| ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND ord(OwnerType)=2
				}
				Definition: {
					if (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion)>0) and
					((PlantType in Intermittent_  AND UPVTYP(PlantType)= 1 and
					UPBLDREG_us00(LCAP_element(PlantType)) > 0 AND UPBLDREG(LCAP_element(PlantType),SupplyRegion) > 0) or
					(PlantType in NUC_Types_ and UPVTYP(PlantType)= 1 and UPOVR(PlantType) < 9000) or
					(PlantType in DistributedGenType_) or (PlantType in OtherRenewable_  AND UPVTYP(PlantType)= 1 and
					EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)<9000 and EPIROVR(RnwStor(PlantType), SupplyRegion, cyr)) or
					(PlantType in DSP_Types_ and UPVTYP(PlantType)= 1) or
					(PlantType=WIDS_Element)) then
						CSTEQADJ(SupplyRegion, PlantType, PlanYear)+
						IF (UPSUBCAS(PlantType)= 5 AND Subsidy_Case(PlanYear, PlantType)=2 AND subsidy_type='X') THEN
					        	EPUCRE('1', SupplyRegion, cyr) + UPNRPRM('1')
						ELSE
					        	EPUCRE('1', SupplyRegion, cyr) + UPNRPRM('1') + UPNRRTEA(PlantType)
						ENDIF
					
					endif
				}
				Comment: "CHECK FOR SUBSIDY LIMIT FOR DEBT INTEREST RATE";
			}
			Parameter UTROR {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)| ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') and ord(OwnerType)=1
				}
				Definition: {
					UTROE(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type) * (1.0 - DEBT_F(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type)) +
					UTINT(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type) * DEBT_F(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type)
				}
			}
			Parameter EWGROR {
				IndexDomain: {
					(SupplyRegion, PlantType, PlanYear,OwnerType,subsidy_type)| ord(SupplyRegion)<=UNRGNS('1') and
					UPBLDTYP(SupplyRegion)=ord(OwnerType) and OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND
					UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND ord(OwnerType)=2
				}
				Definition: {
					EWGROE(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type) * (1.0 - DEBT_F(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type)) +
					EWGINT(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type) * DEBT_F(SupplyRegion, PlantType, PlanYear, OwnerType, subsidy_type)
				}
			}
		}
		DeclarationSection Common_Declaration {
			ElementParameter TPORT_Element {
				IndexDomain: (CoalSupplyCurve_Int, CoalDemandRegion,FullPlanningHorizon);
				Range: Four_;
				Definition: {
					max(Four | XCL_TRATI2(CoalSupplyCurve_Int, Four) > 0.0 AND XCL_TR_IN(Four, CoalSupplyCurve_Int, CoalDemandRegion, cyr) < 900.0 AND XCL_TR_IN(Four, CoalSupplyCurve_Int, CoalDemandRegion, cyr) > 0.0 and
					 (XCL_TR_IN(Four, CoalSupplyCurve_Int, CoalDemandRegion, cyr) * XCL_TESCI(Four, cyr, CoalDemandRegion) + XCL_TRATI2(CoalSupplyCurve_Int, Four))<=
					 TMP_RATE(Four, CoalSupplyCurve_Int, CoalDemandRegion,FullPlanningHorizon), Four)
				}
			}
			Parameter TOT_RATE1 {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon);
				Definition: {
					if CoalSupplyCurve <= MX_NCOALS_Element then
					 XCL_TR_T1(CoalSupplyCurve, CoalDemandRegion, cyr) * XCL_1TESC0(CoalSupplyCurve, LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion)
					else
					 if TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon) then
					   XCL_TR_IN(TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon), MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion, cyr) *
					   XCL_TESCI(TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon), LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion) +
					    XCL_TRATI2(MX_ISCV_Element(CoalSupplyCurve), TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon))
					 else
					   999.9
					 endif
					endif
				}
			}
			Parameter TOT_RATE2 {
				IndexDomain: (CoalSupplyCurve,CoalDemandRegion,FullPlanningHorizon);
				Definition: {
					if CoalSupplyCurve <= MX_NCOALS_Element then
					 XCL_TR_T2(CoalSupplyCurve, CoalDemandRegion, cyr) * XCL_2TESC0(CoalSupplyCurve, LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion)
					else
					 if TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon) then
					   XCL_TR_IN(TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon), MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion, cyr) *
					   XCL_TESCI(TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon), LastModelYear_MNUMYR2(FullPlanningHorizon), CoalDemandRegion) +
					   XCL_TRATI2(MX_ISCV_Element(CoalSupplyCurve), TPORT_Element(MX_ISCV_Element(CoalSupplyCurve), CoalDemandRegion,FullPlanningHorizon))
					 else
					   999.9
					 endif
					endif
				}
			}
			Parameter TMP_RATE {
				IndexDomain: (Four,CoalSupplyCurve_Int,CoalDemandRegion,FullPlanningHorizon);
				InitialData: 999.999;
			}
			Parameter TOT_TYPE {
				IndexDomain: CoalSupplyCurve;
				Definition: {
					if CoalSupplyCurve <= MX_NCOALS_Element then
					 XCL_TYPE(CoalSupplyCurve)
					else
					 1
					endif
				}
			}
			File CarbonTax_File {
				Name: CarbonTax_FileName;
				Device: Disk;
				Mode: replace;
			}
			StringParameter CarbonTax_FileName;
			Parameter Subsidy_Case {
				IndexDomain: (PlanYear, PlantType);
				Definition: {
					!CREATE EXTRA TECHNOLOGY SUPPLY CURVE STEPS LOOP FOR SUBSIDY LIMITS, IF APPROPRIATE
					IF (UPSUBCAS(PlantType)>0 AND LIMSUB_calc(PlantType)> 0) THEN
					
					!     IF PTC SUBSIDY, CHECK IF VALID ONLINE YEAR
					
					  IF (UPSUBCAS(PlantType)=1) THEN
					   IF (PlantType in (PlantType_-IntermittentRenStor_-DSP_Types_) or (PlantType in (IntermittentRenStor_+DSP_Types_) and UPGSUBPT(PlantType)<=0)) THEN
					     IF (OLYEAR(PlanYear, PlantType) < UNXPH('1')) THEN
					        if ((ord(cyr) + OLYEAR(PlanYear, PlantType) - 1) < (UPGSY1(PlantType) - UHBSYR('1')) OR (ord(cyr) + OLYEAR(PlanYear, PlantType) - 1) > (UPGSYL(PlantType) - UHBSYR('1'))) then
					        1
					        else
					        2
					        endif
					     ELSE
					        if ((ord(cyr) + UNFPH('1') - 1) < (UPGSY1(PlantType) - UHBSYR('1')) OR (ord(cyr) + UNXPH('1') - 1) > (UPGSYL(PlantType) - UHBSYR('1'))) then
					        1
					        else
					        2
					        endif
					     ENDIF
					   ELSE
					        if (UPGSUBYR(PlantType, LastFullYear_MNUMYR(PlanYear, PlantType)) <=0) then
					          1
					        else
					        2
					        endif
					   ENDIF
					  ELSE
					    2
					  ENDIF
					ELSE
					  1
					ENDIF
				}
			}
			Parameter SliceGroup2Season_Map {
				IndexDomain: (Season,SliceGroup,PlanYear,SupplyRegion);
			}
			ElementParameter Season2SliceGroup {
				IndexDomain: (SliceGroup,PlanYear,SupplyRegion);
				Range: Season_;
			}
			Parameter FULLYEAR {
				IndexDomain: (PlanYear,PlantType);
				Definition: {
					IF (OLYEAR(PlanYear,PlantType) < UNXPH('1')) THEN
					      OLYEAR(PlanYear,PlantType) + ORD(cyr) + UHBSYR('1') - 1
					 ELSE
					      UNFPH('1') + ORD(cyr) + UHBSYR('1') - 1
					 ENDIF
				}
			}
			Parameter FULLYEAR_ALT {
				IndexDomain: (PlanYear,PlantType);
				Definition: {
					IF (OLYEAR(PlanYear,PlantType) < UNXPH('1')) THEN
					      OLYEAR(PlanYear,PlantType) + ORD(cyr) + UHBSYR('1') - 1
					 ELSE
					      min((UNFPH('1') + ORD(cyr) + UHBSYR('1') - 1),(UNYEAR('1') + UHBSYR('1')))
					 ENDIF
				}
			}
			Parameter FULLYEAR_YR {
				IndexDomain: (PlanYear);
				Definition: {
					IF (ord(PlanYear) < UNXPH('1')) THEN
					      ord(PlanYear) + ORD(cyr) + UHBSYR('1') - 1
					 ELSE
					      min((UNFPH('1') + ORD(cyr) + UHBSYR('1') - 1),(UNYEAR('1') + UHBSYR('1')))
					 ENDIF
				}
			}
			Parameter FULLYEAR_PM {
				IndexDomain: (PlanYear,DispatchableECP);
				Definition: {
					IF (ord(PlanYear) < UNXPH('1')) THEN
					      ord(PlanYear) + ORD(cyr) + UHBSYR('1') - 1
					 ELSE
					   IF (DispatchableECP = WING_Element) THEN
					        ord(PlanYear) + ORD(cyr) + UHBSYR('1') - 1
					   ELSEIF (DispatchableECP = WIA2_Element) THEN
					        ord(PlanYear) + ORD(cyr) + UHBSYR('1') - 2
					   ELSE
					        UNFPH('1') + ORD(cyr) + UHBSYR('1') - 1
					   ENDIF
					ENDIF
				}
			}
			Parameter OLYEAR {
				IndexDomain: (PlanYear,PlantType);
				Definition: ORD(PlanYear) + UPPLYR(PlantType);
			}
			ElementParameter LastFullYear_MNUMYR {
				IndexDomain: (PlanYear,PlantType);
				Range: MNUMYR_;
				Definition: {
					IF (OLYEAR(PlanYear,PlantType) < UNXPH('1')) THEN
					element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+OLYEAR(PlanYear, PlantType)-1))
					else
					element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+UNXPH('1')-1))
					endif
				}
			}
			ElementParameter OLYEAR_MNUMYR {
				IndexDomain: (PlanYear,PlantType);
				Range: MNUMYR_;
				Definition: element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+OLYEAR(PlanYear, PlantType)-1));
			}
			ElementParameter OLYEAR_MNUMRF {
				IndexDomain: (FullPlanningHorizon,PlantType,PlanYear);
				Range: MNUMYRF_;
				Definition: element(MNUMYRF_,ord(FullPlanningHorizon) + CURIYR('1') + OLYEAR(PlanYear, PlantType) - 2);
			}
			ElementParameter ElasticityStep1 {
				Range: ElasticityStep_;
				Definition: first(ElasticityStep_);
			}
			ElementParameter DistGenAvoidStep1 {
				Range: DistGenAvoidStep_;
				Definition: first(DistGenAvoidStep_);
			}
			Parameter PT_OFFSET {
				IndexDomain: SupplyRegion | ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					sum((PlanYear,StepsPerGroup,ECPLoadGroup)| ord(PlanYear)>=(UPPLYR(WIDS_Element)+1) and  ord(ECPLoadGroup)<=EPNGRP('1', SupplyRegion, cyr) and
					StepsPerGroup<=NumStepsPerGroup_element(ECPLoadGroup_to_LoadGroup(ECPLoadGroup),SupplyRegion),
					-EPAVOID(ECPLoadGroup,StepsPerGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					 * NET_PT_STORAGE_LOAD_EX(StepsPerGroup, ECPLoadGroup, SupplyRegion, cyr)) /
					(sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1')-UPPLYR(WIDS_Element), !PVV_Function(UPGNPD(MNUMYRF_KYR(FullPlanningHorizon+UPPLYR(WIDS_Element))),
					!ord(FullPlanningHorizon), EPDSCRT('1', SupplyRegion, cyr))) *
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon+UPPLYR(WIDS_Element))) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_f(EPDSCRT('1', SupplyRegion, cyr),UPPLYR(WIDS_Element)));
				}
			}
			Parameter OFFSET {
				IndexDomain: SupplyRegion | ord(SupplyRegion)<=UNRGNS('1');
				Definition: {
					sum((PlanYear,StepsPerGroup,ECPLoadGroup)| ord(PlanYear)>=(UPPLYR(WIDS_Element)+1) and  ord(ECPLoadGroup)<=EPNGRP('1', SupplyRegion, cyr) and
					StepsPerGroup<=NumStepsPerGroup_element(ECPLoadGroup_to_LoadGroup(ECPLoadGroup),SupplyRegion),
					-EPAVOID(ECPLoadGroup,StepsPerGroup, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion, cyr)
					 * NET_STORAGE_LOAD_NW(StepsPerGroup, ECPLoadGroup, SupplyRegion, cyr)) /
					(sum(FullPlanningHorizon| ord(FullPlanningHorizon)<=UNFPH('1')-UPPLYR(WIDS_Element), !PVV_Function(UPGNPD(MNUMYRF_KYR(FullPlanningHorizon+UPPLYR(WIDS_Element))),
					!ord(FullPlanningHorizon), EPDSCRT('1', SupplyRegion, cyr))) *
					UPGNPD(MNUMYRF_KYR(FullPlanningHorizon+UPPLYR(WIDS_Element))) / ((1 + EPDSCRT('1', SupplyRegion, cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_f(EPDSCRT('1', SupplyRegion, cyr),UPPLYR(WIDS_Element)));
				}
			}
		}
	}
	Section HeatRate {
		Procedure Calculate_AVG_HTRT {
			Body: {
				!Empty ECP_GEN, ECP_GEN_temp, ECP_GEN0, ECP_GEN_MOD, ECP_GEN_MOD0, ECP_GEN_MR, ECP_GEN_MR0, ECP_GEN_MR_MOD, ECP_GEN_MR_MOD0,
				!AVG_HTRT, AVG_HTRT_temp, AVG_HTRT0, AVG_HTRT_MOD, AVG_HTRT_MOD0, AVG_HTRT_MR, AVG_HTRT_MR0, AVG_HTRT_MR_MOD, AVG_HTRT_MR_MOD0;
				
				
				!ECP_GEN
				ECP_GEN_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				(ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				(ULMRUN(ExistingPlantGroup)< CURIYR('1') + UHBSYR('1') + ord(XYR) - 1), ULTGEN_ECP(ExistingPlantGroup, xyr));
				
				ECP_GEN_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, ECP_GEN_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				ECP_GEN((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				ECP_GEN_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr);
				
				ECP_GEN0((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), ECP_GEN_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion_SUB, xyr));
				
				!_MOD
				ECP_GEN_MOD_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, ExplicitPlanningHorizon):=0;
				ECP_GEN_MOD_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				(ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				(ULMRUN(ExistingPlantGroup)< CURIYR('1') + UHBSYR('1') + ord(XYR) - 1) and
				(HTRT_RESULTS(INIT_GRP(ExistingPlantGroup))=0 and HTRT_OVRQ(PlantType, HTRT_QRT(ExistingPlantGroup))>0), ULTGEN_ECP(ExistingPlantGroup, xyr));
				
				ECP_GEN_MOD_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, ECP_GEN_MOD_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				ECP_GEN_MOD((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				ECP_GEN_MOD_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr);
				
				ECP_GEN_MOD0((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), ECP_GEN_MOD_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion_SUB, xyr));
				
				!MR
				ECP_GEN_MR_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, ExplicitPlanningHorizon):=0;
				ECP_GEN_MR_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				(ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				(ULMRUN(ExistingPlantGroup)>= CURIYR('1') + UHBSYR('1') + ord(XYR) - 1), ULTGEN_ECP(ExistingPlantGroup, xyr));
				
				ECP_GEN_MR_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, ECP_GEN_MR_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				ECP_GEN_MR((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				ECP_GEN_MR_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr);
				
				ECP_GEN_MR0((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), ECP_GEN_MR_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion_SUB, xyr));
				
				!MR_MOD
				ECP_GEN_MR_MOD_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, ExplicitPlanningHorizon):=0;
				ECP_GEN_MR_MOD_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				(ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				(ULMRUN(ExistingPlantGroup)>= CURIYR('1') + UHBSYR('1') + ord(XYR) - 1) and
				(HTRT_RESULTS(INIT_GRP(ExistingPlantGroup))=0 and HTRT_OVRQ(PlantType, HTRT_QRT(ExistingPlantGroup))>0), ULTGEN_ECP(ExistingPlantGroup, xyr));
				
				ECP_GEN_MR_MOD_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, ECP_GEN_MR_MOD_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				ECP_GEN_MR_MOD((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				ECP_GEN_MR_MOD_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr);
				
				ECP_GEN_MR_MOD0((PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr) |UPVTYP(PlantType)=0):=
				sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), ECP_GEN_MR_MOD_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion_SUB, xyr));
				
				!AVG_HTRT
				AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				(ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				(ULMRUN(ExistingPlantGroup)< CURIYR('1') + UHBSYR('1') + ord(XYR) - 1), ULTGEN_ECP(ExistingPlantGroup, xyr)* ULHTRT_ECP(ExistingPlantGroup, xyr) / UECP_HTRT_ADJ(PlantType));
				
				AVG_HTRT_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				AVG_HTRT(PlantType, FuelRegion_SUP, SupplyRegion, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				!     For Biomass Units use heatrate determined by the renewable module - changing to use UPHTRT instead
				!elseif (PlantType=WIWD_Element or PlantType=WIBI_Element) then
				! WHRIGCC(min(element(MNUMYR_,UNYEAR('1')),cyr+ord(xyr)-1))
				!     For New Dispatchable with heatrate learning determine heatrate for current planning year
				elseif  PlantType in DispatchableECP_ then
				  if ECP_LFHR('1') and UPDHRSW(PlantType) > 1 then
				    if CURIYR('1') + UHBSYR('1') + UPPLYR(PlantType) <= UPDHRY0(PlantType) then
				      UPPHRT0(PlantType)
				    elseif CURIYR('1') + UHBSYR('1') + UPPLYR(PlantType) <= UPDHRYN(PlantType) then
				      UPPHRT0(PlantType) + ((UPPHRTN(PlantType) - UPPHRT0(PlantType)) * ((CURIYR('1') + UHBSYR('1') + UPPLYR(PlantType)) - UPDHRY0(PlantType)) /
				      (UPDHRYN(PlantType) - UPDHRY0(PlantType)))
				    else
				      UPPHRTN(PlantType)
				    endif
				  else
				    UPHTRT(PlantType)
				  endif
				!     For all other units use input heatrate - for renewables this has now been set to the historical average from the AER (EPHTRT_AER())
				else
				  UPHTRT(PlantType)
				endif;
				
				AVG_HTRT0(PlantType, FuelRegion_SUP, SupplyRegion, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), AVG_HTRT_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion, xyr))
				!     For Biomass Units use heatrate determined by the renewable module - changing to use UPHTRT instead
				!elseif (PlantType=WIWD_Element or PlantType=WIBI_Element) then
				!  WHRIGCC(min(element(MNUMYR_,UNYEAR('1')),cyr+ord(xyr)-1))
				!     For New Dispatchable with heatrate learning determine heatrate for current planning year
				elseif  PlantType in DispatchableECP_ then
				  AVG_HTRT(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				!     For all other units use input heatrate - for renewables this has now been set to the historical average from the AER (EPHTRT_AER())
				else
				  UPHTRT(PlantType)
				endif;
				
				!MR
				AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=0;
				AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				  SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				  (ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				  (ULMRUN(ExistingPlantGroup)>= CURIYR('1') + UHBSYR('1') + ord(XYR) - 1), ULTGEN_ECP(ExistingPlantGroup, xyr)* ULHTRT_ECP(ExistingPlantGroup, xyr) / UECP_HTRT_ADJ(PlantType));
				
				AVG_HTRT_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				AVG_HTRT_MR(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)
				!     For Biomass Units use heatrate determined by the renewable module - changing to use UPHTRT instead
				!elseif (PlantType=WIWD_Element or PlantType=WIBI_Element) then
				!  WHRIGCC(min(element(MNUMYR_,UNYEAR('1')),cyr+ord(xyr)-1))
				!     For New Dispatchable with heatrate learning determine heatrate for current planning year
				elseif  PlantType in DispatchableECP_ then
				  if PlantType=WIFC_Element and EPECAP_MR(FuelRegion_SUP, PlantType, xyr, SupplyRegion_SUB, cyr)>0 then  !existing fuel cell is must-run
				    AVG_HTRT(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)
				  else
				    0 ! most new DISP is not made must-run
				  endif
				!     For all other units use input heatrate - for renewables this has now been set to the historical average from the AER (EPHTRT_AER())
				else
				  UPHTRT(PlantType)
				endif;
				
				AVG_HTRT_MR0(PlantType, FuelRegion_SUP, SupplyRegion, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), AVG_HTRT_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion, xyr))
				!     For Biomass Units use heatrate determined by the renewable module - changing to use UPHTRT instead
				!elseif (PlantType=WIWD_Element or PlantType=WIBI_Element) then
				!  WHRIGCC(min(element(MNUMYR_,UNYEAR('1')),cyr+ord(xyr)-1))
				!     For New Dispatchable with heatrate learning determine heatrate for current planning year
				elseif  PlantType in DispatchableECP_ then
				  if PlantType=WIFC_Element and EPECAP_MR(FuelRegion_SUP, PlantType, xyr, SupplyRegion, cyr)>0 then  !existing fuel cell is must-run
				    AVG_HTRT(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				  else
				    0 ! most new DISP is not made must-run
				  endif
				!     For all other units use input heatrate - for renewables this has now been set to the historical average from the AER (EPHTRT_AER())
				else
				  UPHTRT(PlantType)
				endif;
				
				!MOD
				AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=0;
				AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				  SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				  (ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				  (ULMRUN(ExistingPlantGroup)< CURIYR('1') + UHBSYR('1') + ord(XYR) - 1) and
				  (HTRT_RESULTS(INIT_GRP(ExistingPlantGroup))=0 and HTRT_OVRQ(PlantType, HTRT_QRT(ExistingPlantGroup))>0),
				  MAX( HTRT_FLOOR(PlantType), ULHTRT_ECP(ExistingPlantGroup, xyr) * (1.0 - HTRT_REDUCTION(PlantType)) ) * ULTGEN_ECP(ExistingPlantGroup, xyr) / UECP_HTRT_ADJ(PlantType));
				
				AVG_HTRT_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				AVG_HTRT_MOD(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)
				endif;
				
				AVG_HTRT_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), AVG_HTRT_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion, xyr))
				endif;
				
				!MR_MOD
				AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=0;
				AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr):=
				sum(ExistingPlantGroup| PlantType=ULECPT_Map(ExistingPlantGroup) and
				  SupplyRegion_SUB=ULORGN_MAP(ExistingPlantGroup) and FuelRegion=ULFRGN_Map(ExistingPlantGroup) and
				  (ULSINDX(ExistingPlantGroup) <= LYR_INDEX(xyr) and ULRINDX(ExistingPlantGroup) >= CYR_INDEX(xyr) and ULTGEN_ECP(ExistingPlantGroup, xyr)>0) and
				  (ULMRUN(ExistingPlantGroup)>= CURIYR('1') + UHBSYR('1') + ord(XYR) - 1) and
				  (HTRT_RESULTS(INIT_GRP(ExistingPlantGroup))=0 and HTRT_OVRQ(PlantType, HTRT_QRT(ExistingPlantGroup))>0),
				  MAX( HTRT_FLOOR(PlantType), ULHTRT_ECP(ExistingPlantGroup, xyr) * (1.0 - HTRT_REDUCTION(PlantType)) ) * ULTGEN_ECP(ExistingPlantGroup, xyr) / UECP_HTRT_ADJ(PlantType));
				
				AVG_HTRT_temp(PlantType, FuelRegion0, SupplyRegion_SUB, xyr):=
				sum(FuelRegion, AVG_HTRT_temp(PlantType, FuelRegion, SupplyRegion_SUB, xyr));
				
				AVG_HTRT_MR_MOD(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  AVG_HTRT_temp(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)
				endif;
				
				AVG_HTRT_MR_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr):=
				!     If heatrate overwrite switch is on use overwrite values
				if ECP_OVHR(PlantType)>0 then
				  UPOVHR(PlantType, min(last(MNUMYR_),cyr+ord(xyr)))
				!     For Existing Only Plant Types Calculate the Average Heatrates
				elseif UPVTYP(PlantType)=0 then
				  sum(PlantType_ALT1|  GRP_ECP_TYPE(PlantType, PlantType_ALT1)=UPTTYP(PlantType), AVG_HTRT_temp(PlantType_ALT1, FuelRegion_SUP, SupplyRegion, xyr))
				endif;
				
				
				TestHR(PlantType, PlantType_ALT1, FuelRegion_SUP, SupplyRegion_SUB, ExplicitPlanningHorizon):=0;
				for (PlantType in PlantType_ | UPVTYP(PlantType)=0 ) do
				PTGroups_:={PlantType_ALT1 | UPTTYP(PlantType)=GRP_ECP_TYPE(PlantType, PlantType_ALT1)};
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				 ECP_GEN_temp(ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr) and ECP_GEN0(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)):= 1;
				
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				TestHR(PlantType, ptg-1, FuelRegion_SUP, SupplyRegion_SUB, xyr)):=1;
				
				endfor;
				AVG_HTRT0((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=AVG_HTRT0(PlantType, FuelRegion_SUP, SupplyRegion, xyr) / $ ECP_GEN0(PlantType, FuelRegion_SUP, SupplyRegion, xyr);
				AVG_HTRT((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=UECP_HTRT_ADJ(PlantType)*
				if ECP_GEN(PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT(PlantType, FuelRegion_SUP, SupplyRegion, xyr) /  ECP_GEN(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				elseif TestHR(PlantType, PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT0(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				endif;
				!!
				!MR
				TestHR(PlantType, PlantType_ALT1, FuelRegion_SUP, SupplyRegion, ExplicitPlanningHorizon):=0;
				for (PlantType in PlantType_ | UPVTYP(PlantType)=0 ) do
				PTGroups_:={PlantType_ALT1 | UPTTYP(PlantType)=GRP_ECP_TYPE(PlantType, PlantType_ALT1)};
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				 ECP_GEN_MR_temp(ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr) and ECP_GEN_MR0(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)):= 1;
				
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				TestHR(PlantType, ptg-1, FuelRegion_SUP, SupplyRegion_SUB, xyr)):=1;
				
				endfor;
				AVG_HTRT_MR0((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=AVG_HTRT_MR0(PlantType, FuelRegion_SUP, SupplyRegion, xyr) / $ ECP_GEN_MR0(PlantType, FuelRegion_SUP, SupplyRegion, xyr);
				AVG_HTRT_MR((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=UECP_HTRT_ADJ(PlantType)*
				if ECP_GEN_MR(PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MR(PlantType, FuelRegion_SUP, SupplyRegion, xyr) /  ECP_GEN_MR(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				elseif TestHR(PlantType, PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MR0(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				endif;
				
				!MOD
				TestHR(PlantType, PlantType_ALT1, FuelRegion_SUP, SupplyRegion, ExplicitPlanningHorizon):=0;
				for (PlantType in PlantType_ | UPVTYP(PlantType)=0 ) do
				PTGroups_:={PlantType_ALT1 | UPTTYP(PlantType)=GRP_ECP_TYPE(PlantType, PlantType_ALT1)};
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				 ECP_GEN_MOD_temp(ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr) and ECP_GEN_MOD0(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)):= 1;
				
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				TestHR(PlantType, ptg-1, FuelRegion_SUP, SupplyRegion_SUB, xyr)):=1;
				
				endfor;
				AVG_HTRT_MOD0((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=AVG_HTRT_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr) / $ ECP_GEN_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr);
				AVG_HTRT_MOD((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=UECP_HTRT_ADJ(PlantType)*
				if ECP_GEN_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr) /  ECP_GEN_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				elseif TestHR(PlantType, PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				endif;
				
				!MR_MOD
				TestHR(PlantType, PlantType_ALT1, FuelRegion_SUP, SupplyRegion, ExplicitPlanningHorizon):=0;
				for (PlantType in PlantType_ | UPVTYP(PlantType)=0 ) do
				PTGroups_:={PlantType_ALT1 | UPTTYP(PlantType)=GRP_ECP_TYPE(PlantType, PlantType_ALT1)};
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				 ECP_GEN_MR_MOD_temp(ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr) and ECP_GEN_MR_MOD0(PlantType, FuelRegion_SUP, SupplyRegion_SUB, xyr)):= 1;
				
				TestHR((PlantType, ptg, FuelRegion_SUP, SupplyRegion_SUB, xyr)|
				TestHR(PlantType, ptg-1, FuelRegion_SUP, SupplyRegion_SUB, xyr)):=1;
				
				endfor;
				AVG_HTRT_MR_MOD0((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=AVG_HTRT_MR_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr) / $ ECP_GEN_MR_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr);
				AVG_HTRT_MR_MOD((PlantType, FuelRegion_SUP, SupplyRegion, xyr) |UPVTYP(PlantType)=0) :=UECP_HTRT_ADJ(PlantType)*
				if ECP_GEN_MR_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MR_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr) /  ECP_GEN_MR_MOD(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				elseif TestHR(PlantType, PlantType, FuelRegion_SUP, SupplyRegion, xyr) then
				AVG_HTRT_MR_MOD0(PlantType, FuelRegion_SUP, SupplyRegion, xyr)
				endif;
			}
			Parameter AVG_HTRT_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MOD_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR_MOD_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_temp {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion_SUB,ExplicitPlanningHorizon);
			}
		}
		Procedure CapCost_Adjustment_NETLprogram {
			Body: {
				!Revise Capital Costs and Heatrates for Plants with Capture to reflect NETL Program Goals if any
				PlantsWithCapture_:= WIPQ_Element + WIIS_Element + WICS_Element;
				B_Plant(WIPQ_Element):=WIIG_Element;
				B_Plant(WIIS_Element):=WIIG_Element;
				B_Plant(WICS_Element):=WIAC_Element;
				B_HTRT_ADJ(PlantType, FuelRegion, SupplyRegion, PlanYear) := 1.0;
				B_CPEN_ADJ(PlantType, FuelRegion, SupplyRegion, PlanYear) := 1.0;
				B_CCST_ADJ_ALT(PlantType, FuelRegion, SupplyRegion, PlanYear) := 1.0;
				
				B_YR(PlanYear, PlantsWithCapture):= element(MNUMYR_,MIN(UNYEAR('1'),ORD(CYR)+OLYEAR(PlanYear, PlantsWithCapture)-1));
				
				B_HTRT_ADJ(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear):=
				(AVG_HTRT(B_Plant(PlantsWithCapture), FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))/
				AVG_HTRT(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))) *
				(1 - HTRT_GL(B_YR(PlanYear, PlantsWithCapture), '2')) + HTRT_GL(B_YR(PlanYear, PlantsWithCapture), '2');
				
				B_CPEN_ADJ(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear):=
				B_HTRT_ADJ(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear) *
				AVG_HTRT(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))/
				AVG_HTRT(B_Plant(PlantsWithCapture), FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear));
				
				B_CAP_CST_O(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear):=
				UPOVR(PlantsWithCapture) - (UPOVR(B_Plant(PlantsWithCapture)) * AVG_HTRT(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear))/
				AVG_HTRT(B_Plant(PlantsWithCapture), FuelRegion, SupplyRegion_SUB, ExplicitPlanningHorizon_element(PlanYear)));
				
				B_CAP_CST_N(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear):=
				B_CAP_CST_O(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear) * TCCF_GL(B_YR(PlanYear, PlantsWithCapture), '2') *
				B_HTRT_ADJ(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear);
				
				B_CCST_ADJ_ALT(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear):=
				(UPOVR(B_Plant(PlantsWithCapture)) * B_CPEN_ADJ(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear) +
				B_CAP_CST_N(PlantsWithCapture, FuelRegion, SupplyRegion_SUB, PlanYear))/ UPOVR(PlantsWithCapture);
				
				B_CCST_ADJ_calc(PlantsWithCapture):=B_CCST_ADJ_ALT(PlantsWithCapture, first(FuelRegion), first(SupplyRegion), first(PlanYear));
			}
			Comment: "yda note: If this is needed, change dimensions on OVRCST in Cost procedures";
		}
		Procedure Calculate_HTRT_TEST {
			Body: {
				HRIOVR(PlantType):=0;
				for (Four ) do
				HRIOVR((DSP_Types)| HRIOVR(DSP_Types)<HTRT_OVRQ(DSP_Types, Four)<900):= HTRT_OVRQ(DSP_Types, Four);
				endfor;
				HTRT_TEST(PlantType, PlanYear):=0;
				HTRT_TEST((DSP_Types, PlanYear)| HRIOVR(DSP_Types)=0):= 1;
				HTRT_TEST((DSP_Types, PlanYear)| (CURIYR('1')+UHBSYR('1')+ord(PlanYear)-1) < HTRT_YEAR('1') AND ord(PlanYear)<UNXPH('1')):= 1;
				
				HTRT_TEST_PM(PlantType, PlanYear):=0;
				HTRT_TEST_PM((DSP_Types, PlanYear)| HRIOVR(DSP_Types)=0):= 1;
				HTRT_TEST_PM((DSP_Types, PlanYear)| (CURIYR('1')+UHBSYR('1')+ord(PlanYear)-1) < HTRT_YEAR('1')):= 1;
				
				HTRT_TEST_COAL((CoalGroup_SUB, PlanYear)| HTRT_OVRQ(CoalPlantType(CoalGroup_SUB, PlanYear), CLSG_QT(CoalGroup_SUB))<=0 or
				HTRT_OVRQ(CoalPlantType(CoalGroup_SUB, PlanYear), CLSG_QT(CoalGroup_SUB))>900):=1;
				
				HTRT_TEST_COAL((CoalGroup_SUB, PlanYear)| HTRT_RESULTS(CoalPlantGroup(CoalGroup_SUB))>0):=1;
				HTRT_TEST_COAL(CoalGroup_SUB, FirstPlanYear):=1;
				HTRT_TEST_COAL((CoalGroup_SUB, PlanYear_Two)| CURIYR('1')+UHBSYR('1')+ord(PlanYear_Two)-1 < HTRT_YEAR('1')):=1;
			}
		}
		Procedure HTRT_Adjustment {
			Arguments: (load_level,HTRTADJ);
			Body: {
				MAX_EFF((SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)| FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)):=
				if FLRG_HR_KNOTS(FuelRegion, DSP_Types)=0 then
				1
				else
				FLRG_HR_EFF(FuelRegion, DSP_Types, N_KNOT(FuelRegion, DSP_Types))
				endif;
				
				load_level((DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear)| load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear)>=1):=1;
				Min_Knot((SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) | FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season)) :=
				min(Eleven| load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear)<= FLRG_HR_LL(FuelRegion, DSP_Types, Eleven), Eleven);
				
				Target_EFF((SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) |FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season)) :=
				if FLRG_HR_KNOTS(FuelRegion, DSP_Types)=0 then
				  1
				elseif Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)=F_KNOT then
				  FLRG_HR_EFF(FuelRegion, DSP_Types, F_KNOT)
				elseif Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)>F_KNOT then
				!                  LL = FLRG_HR_LL(FUEL_RGN,ECPt,KNOT-1)
				!                  EL = FLRG_HR_EFF(FUEL_RGN,ECPt,KNOT-1)
				!                  LH = FLRG_HR_LL(FUEL_RGN,ECPt,KNOT)
				!                  EH = FLRG_HR_EFF(FUEL_RGN,ECPt,KNOT)
				  !Target_EFF = EL + ((EH - EL) / (LH - LL)) * (Load_Level - LL)
				  FLRG_HR_EFF(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)-1) +
				  (FLRG_HR_EFF(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear))-
				  FLRG_HR_EFF(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)-1))*
				  (load_level(DSP_Types, Season, SupplyRegion_SUB, FuelRegion, OperatingMode, PlanYear)-
				  FLRG_HR_LL(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)-1))/$
				  (FLRG_HR_LL(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear))-
				  FLRG_HR_LL(FuelRegion, DSP_Types, Min_Knot(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear)-1))
				endif;
				HTRTADJ((SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear) |FuelRegion_DSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear) and
				Condition_ODSP(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear, OperatingMode, Season)):=
				    MAX_EFF(SupplyRegion_SUB, DSP_Types, FuelRegion, PlanYear)/$ Target_EFF(SupplyRegion_SUB, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear);
			}
			Parameter load_level {
				IndexDomain: (DSP_Types, Season, SupplyRegion, FuelRegion, OperatingMode, PlanYear);
				Property: Input;
			}
			Parameter HTRTADJ {
				IndexDomain: (SupplyRegion, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear);
				Property: Output;
			}
			ElementParameter Min_Knot {
				IndexDomain: (SupplyRegion, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear);
				Range: Eleven_;
			}
			Parameter Target_EFF {
				IndexDomain: (SupplyRegion, DSP_Types, FuelRegion, OperatingMode, Season, PlanYear);
			}
			Parameter MAX_EFF {
				IndexDomain: (SupplyRegion, DSP_Types, FuelRegion, PlanYear);
			}
		}
		DeclarationSection ECP_AVG_HTRT_Declaration {
			Parameter AVG_HTRT {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MR {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MR_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MR0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter AVG_HTRT_MR_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_GEN_MR_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MR {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MR_MOD {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MR0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter ECP_CAP_MR_MOD0 {
				IndexDomain: (PlantType,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter CYR_INDEX {
				IndexDomain: ExplicitPlanningHorizon | ord(ExplicitPlanningHorizon) <= UNXPH('1');
				Definition: (CURIYR('1') + UHBSYR('1') + ord(ExplicitPlanningHorizon) - 1) * 100;
			}
			Parameter LYR_INDEX {
				IndexDomain: ExplicitPlanningHorizon | ord(ExplicitPlanningHorizon) <= UNXPH('1');
				Definition: {
					IF ( ord(ExplicitPlanningHorizon) < UNXPH('1')) THEN
					        (CURIYR('1') + UHBSYR('1') + ord(ExplicitPlanningHorizon) - 1) * 100 + 12
					ELSE
					        (CURIYR('1') + UHBSYR('1') + UNFPH('1') - 1) * 100 + 12
					ENDIF
				}
			}
			ElementParameter INIT_GRP {
				IndexDomain: ExistingPlantGroup;
				Range: PlantGroup_;
				Definition: Element(PlantGroup_, ULIGRP(ExistingPlantGroup));
			}
			ElementParameter HTRT_QRT {
				IndexDomain: ExistingPlantGroup;
				Range: Four_;
				Definition: Element(Four_, ULHRQ(ExistingPlantGroup));
			}
			ElementParameter ULECPT_Map {
				IndexDomain: ExistingPlantGroup;
				Range: PlantType_;
				Definition: Element(PlantType_, ULECPT(ExistingPlantGroup));
			}
			ElementParameter ULORGN_Map {
				IndexDomain: ExistingPlantGroup;
				Range: SupplyRegion_;
				Definition: {
					if RegGridIndex('1') = 1 then
							Element(SupplyRegion_, ULORGN(ExistingPlantGroup)-1)
					elseif RegGridIndex('1') = 4 then
							if (ULORGN(ExistingPlantGroup)> 1) then
							       Element(SupplyRegion_, ULORGN(ExistingPlantGroup)-18)
							else
							       Element(SupplyRegion_, ULORGN(ExistingPlantGroup))
							endif
					else
					    		Element(SupplyRegion_, ULORGN(ExistingPlantGroup))
					endif
				}
			}
			ElementParameter ULFRGN_Map {
				IndexDomain: ExistingPlantGroup;
				Range: FuelRegion_;
				Definition: Element(FuelRegion_, ULFRGN(ExistingPlantGroup));
			}
			Parameter GRP_ECP_TYPE {
				IndexDomain: (PlantType, PlantType_ALT1);
				Definition: {
					!IF (ord(PlantType)= WING('1') AND UPTTYP(PlantType_ALT1)<= EX_COAL('1')) THEN
					!      UPTTYP(PlantType)
					!elseif (ord(PlantType)= WIA2('1') and (ord(PlantType_ALT1)= WIEC('1') or ord(PlantType_ALT1)= WICC('1'))) then
					!      UPTTYP(PlantType)
					!else
					!      UPTTYP(PlantType_ALT1)
					!endif
					IF (PlantType= WING_Element AND UPTTYP(PlantType_ALT1)<= EX_COAL('1')) THEN
					      UPTTYP(PlantType)
					elseif (PlantType= WIA2_Element and (PlantType_ALT1= WIEC_Element)) then
					      UPTTYP(PlantType)
					elseif UPTTYP(PlantType)=UPTTYP(PlantType_ALT1) then
					      UPTTYP(PlantType_ALT1)
					endif
				}
			}
			Parameter PlantGroup_PlantType {
				IndexDomain: (ExistingPlantGroup,PlantType);
				Definition: {
					IF GRP_ECP_TYPE(PlantType, ULECPT_Map(ExistingPlantGroup))=UPTTYP(PlantType) then
					      1
					endif
				}
			}
			Set UNXPH_ {
				SubsetOf: ExplicitPlanningHorizon_;
				Index: xyr;
				Definition: {
					{first(ExplicitPlanningHorizon_)..Element(ExplicitPlanningHorizon_,UNXPH('1'))}
				}
			}
			ElementParameter MaxPlanYr {
				IndexDomain: xyr;
				Range: MNUMYR_;
				Definition: min(last(MNUMYR_),cyr+ord(xyr));
			}
			Parameter TestHR {
				IndexDomain: (PlantType,PlantType_ALT1,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Parameter Test_HR {
				IndexDomain: (PlantType,PlantType_ALT1,FuelRegion_SUP,SupplyRegion,ExplicitPlanningHorizon);
			}
			Set s1_ {
				Index: s1, s4;
				Definition: {
					{1..10}
				}
			}
			Set PTGroups_ {
				SubsetOf: PlantType_;
				Index: ptg;
			}
			Set s2_ {
				Index: s2;
				Definition: {
					{1..10}
				}
			}
			Set s3_ {
				IndexDomain: s4;
				SubsetOf: s1_;
				Definition: {
					{s1|ord(s1)=ord(s4)}
				}
			}
			ElementParameter PT_NG {
				Range: PlantType_;
			}
			Parameter ts2 {
				IndexDomain: planttype;
				Definition: ord(planttype);
			}
		}

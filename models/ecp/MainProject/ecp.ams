		DeclarationSection EP_LGNP_Completed;
		DeclarationSection EP_LINT_Completed {
			Parameter ccalc_cGELXXX_rLXXINTle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: G(*)ELXXX(*) and OML Rows: L(*)XXINT(*)";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
						-MAX(MIN(UPINTBND('1'),UPINTMAX(SupplyRegion_ALT1) + UPINTINC('1') * (ORD(PlanYear) - 1)),UPINTBD0('1'))
					ELSE
						-MAX(UPINTBND('1'),UPINTBD0('1'))
					ENDIF
				}
			}
			Parameter ccalc_cRINTXX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: R(*)INTXX(*) and OML Rows: ECPCOSTS";
				Definition: 2000.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear));
			}
			Parameter ccalc_cRINTXX_rLXXINTle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: R(*)INTXX(*) and OML Rows: L(*)XXINT(*)";
				Definition: -1.0;
			}
		}
		DeclarationSection EP_LOAD_Completed {
			Parameter BTCOGEN_BMEXICAN {
				IndexDomain: (SupplyRegion_ALT1,Seasonx);
				Definition: BTCOGEN(SupplyRegion_ALT1) / 8.76 - BMEXICAN(SupplyRegion_ALT1) / 8.76;
			}
			Parameter MAXICHK {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | SupplyRegion_ALT1 <> 'us00';
				Definition: {
					Max(Seasonx,0 - UEITAJ_ECP(Season_elementx(Seasonx,SupplyRegion_ALT1),SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) +
					 !BTCOGEN(SupplyRegion_ALT1) / 8.76 - BMEXICAN(SupplyRegion_ALT1) / 8.76)
					 BTCOGEN_BMEXICAN(SupplyRegion_ALT1,Seasonx))
				}
			}
			Parameter MINICHK {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)| SupplyRegion_ALT1 <> 'us00';
				Definition: {
					Min(Seasonx,0 - UEITAJ_ECP(Season_elementx(Seasonx,SupplyRegion_ALT1),SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) +
					! BTCOGEN(SupplyRegion_ALT1) / 8.76 - BMEXICAN(SupplyRegion_ALT1) / 8.76)
					  BTCOGEN_BMEXICAN(SupplyRegion_ALT1,Seasonx))
				}
			}
			Parameter ccalc_cLDBLD_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,VLoadSegment,PlanYear) | ORD(VLoadSegment) <= EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr);
				Text: "OML Columns: LDBLD(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					 100.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ELSE
					 1000.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cLDBLD_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,VLoadSegment) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and VLoadSegment = VLSegment_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear)
				}
				Text: "OML Columns: LDBLD(*)(*)(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cSRBLD_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,VLoadSegment,PlanYear) | ORD(VLoadSegment) <= EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr);
				Definition: {
					IF (ORD(PlanYear) < UNXPH('1')) THEN
					 50.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ELSE
					 500.0 * UPGNPD(ModelYear_MNUMYRF(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cSRBLD_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,VLoadSegment) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) and VLoadSegment = VLSegment_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear)
				}
				Text: "OML Columns: SRBLD(*)(*)(*) and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cRHS_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: RHSECP and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					!          VALUE = EPHGHT(VLS,YEAR) + UOUNCP(NERC,MIN(UNYEAR,CURIYR+YEAR-1)) + UOUCCP(NERC,MIN(UNYEAR,CURIYR+YEAR-1))
					 !         VALUE = DIGITS2( VALUE , DIGITS_PARM)	
					 !        CALL CRHS(UPRHS,ROW,VALUE,ROW_mask,'EP$LOAD,1')
					
					  EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) +
					  UOUNCP(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear)) +
					  UOUCCP(SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
				}
			}
			Parameter ccalc_cXEXPRT_LBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: X(*)EXPRT(*) and OML Rows: LBOUND";
				Definition: {
					!IF ( MAXICHK(SupplyRegion_ALT1,PlanYear) <> 0 OR MINICHK(SupplyRegion_ALT1,PlanYear) <> 0) THEN
					if sum((Seasonx, LoadGroup, LoadSegment)| ccalc_cXEXPRT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear),1) then
					   1.0
					ENDIF
				}
				Comment: "EP$LOAD,7";
			}
			Parameter ccalc_cXEXPRT_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear)| LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: X(*)EXPRT(*) and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					(0 - UEITAJ_ECP(Season_elementx(Seasonx,SupplyRegion_ALT1),SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					 + BTCOGEN(SupplyRegion_ALT1) / 8.76 - BMEXICAN(SupplyRegion_ALT1) / 8.76) $
					 ( abs(0 - UEITAJ_ECP(Season_elementx(Seasonx,SupplyRegion_ALT1),SupplyRegion_ALT1,LastModelYear_MNUMYR(PlanYear))
					 + BTCOGEN(SupplyRegion_ALT1) / 8.76 - BMEXICAN(SupplyRegion_ALT1) / 8.76)>=ECP_MIN('1') )
				}
				Comment: "EP$LOAD,2";
			}
			Parameter ccalc_cXEXPRT_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: X(*)EXPRT(*) and OML Rows: UBOUND";
				Default: inf;
				Definition: {
					!IF ( MAXICHK(SupplyRegion_ALT1,PlanYear) <> 0 OR MINICHK(SupplyRegion_ALT1,PlanYear) <> 0) THEN
					if sum((Seasonx, LoadGroup, LoadSegment)| ccalc_cXEXPRT_rLEL2ge(SupplyRegion_ALT1, Seasonx, LoadGroup, LoadSegment, PlanYear),1) then
					   1.0
					ELSE
						inf
					ENDIF
				}
				Comment: "EP$LOAD,7";
			}
		}
		DeclarationSection EP_LTABS_Completed;
		DeclarationSection EP_LRPT_Completed;
		DeclarationSection EP_LVAR_Completed;
		DeclarationSection EP_MRM_Completed {
			Parameter ccalc_cSR_LBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: C(*)SR(*)(*)(*)(*) and OML Rows: LBOUND";
				Definition: {
					! SP_RES_RQMT(VLS,YEAR) = SR_RQMT_HGHT(NERC) * (EPHGHT(VLS,YEAR) + ADJ_HGHT(JSP)) + SR_RQMT_DIFF(NERC) * (MAX_HGHT(JSP) - (EPHGHT(VLS,YEAR) + ADJ_HGHT(JSP)))
					SR_RQMT_HGHT(SupplyRegion_ALT1) * (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
					+ ADJ_HGHT(SupplyRegion_ALT1,Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear))
					+ SR_RQMT_DIFF(SupplyRegion_ALT1) * (MAX_HGHT(SupplyRegion_ALT1,Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear)
					- (EPHGHT(LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr)
					+ ADJ_HGHT(SupplyRegion_ALT1,Season_elementx(Seasonx,SupplyRegion_ALT1),PlanYear)))
				}
			}
			Parameter ccalc_cSR_rNSRn {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: C(*)SR(*)(*)(*)(*) and OML Rows: N(*)SR(*)(*)(*)(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cSR_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: C(*)SR(*)(*)(*)(*) and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: -1.0;
			}
			Parameter ccalc_cSR_UBOUND {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: C(*)SR(*)(*)(*)(*) and OML Rows: UBOUND";
				Default: inf;
				Definition: 30000.0;
			}
			Parameter PKADJ {
				IndexDomain: (SupplyRegion_ALTX,PlanYear);
				Definition: {
					!     IGRP = EPLDGR(1,YEAR)                      ! IGRP is the ECP Group which contains the Peak Slice (i.e. 1)
					!     ISP = MAP_ECP_SP(IGRP)                     ! ISP is the ECP Season which contains the Peak Slice
					
					!     T_VAL = UEITAJ_ECP(ISP,NERC) + UTRELADJ(NERC,MIN(UNYEAR,CURIYR+YEAR-1))
					
					!     STORE TRADE AND COGEN ADJUSTMENTS TO USE FOR FUTURE CYCLES -- USE CURRENT FIRST TIME OUT
					!     IF (UCAPADJ(NERC,MIN(UNYEAR,CURIYR + YEAR - 1)) .EQ. 0.0 .OR. YEAR .EQ. 1)THEN
					!        PKADJ = T_VAL - BTCOGEN(NERC) / 8.76 + BMEXICAN(NERC) / 8.76
					!    ELSE
					!        PKADJ = T_VAL + UCAPADJ(NERC,MIN(UNYEAR,CURIYR + YEAR - 1))
					!     END IF
					!     IF (YEAR .EQ. 1) UCAPADJ(NERC,CURIYR) = - BTCOGEN(NERC) / 8.76 + BMEXICAN(NERC) / 8.76
					
					
					IF (UCAPADJ(SupplyRegion_ALTX,LastModelYear_MNUMYR(PlanYear)) = 0.0 OR ORD(PlanYear) = 1) THEN
					
					UEITAJ_ECP(Season_element(PeakSliceGroup_element(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALTX)),SupplyRegion_ALTX,LastModelYear_MNUMYR(PlanYear))
					+ UTRELADJ(SupplyRegion_ALTX,LastModelYear_MNUMYRX(PlanYear)) - BTCOGEN(SupplyRegion_ALTX) / 8.76 + BMEXICAN(SupplyRegion_ALTX) / 8.76
					ELSE
					UEITAJ_ECP(Season_element(PeakSliceGroup_element(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALTX)),SupplyRegion_ALTX,LastModelYear_MNUMYR(PlanYear))
						+ UTRELADJ(SupplyRegion_ALTX,LastModelYear_MNUMYRX(PlanYear))
						+ UCAPADJ(SupplyRegion_ALTX,LastModelYear_MNUMYR(PlanYear))
					ENDIF
				}
			}
			Parameter ccalc_cSR_ECPCOSTS {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear) |  LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: "OML Columns: C(*)SR(*)(*)(*)(*) and OML Rows: ECPCOSTS";
				Definition: -0.001;
			}
			Parameter ccalc_cRHS_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear) | PlanYear > '1' and SupplyRegion_ALTX <> 'us00' 
					and (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) > UPSTYR('1')+1 ! delay enforcing reserve margin until ECPstart + 1 to reflect real-world limits on adding capacity
				}
				Text: "OML Columns: RHSECP and OML Rows: R(*)XXXXX(*)";
				Definition: {
					EPPEAK(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALTX,CYR) * ( EPMRM('1',SupplyRegion_ALTX,CYR))
					+ PKADJ(SupplyRegion_ALTX,PlanYear) + EP_NET_PEAK(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALTX,CYR)
				}
			}
			Parameter ccalc_cRHS_rLP2XXXle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: L(*)P2XXX(*)";
				Definition: {
					!     IF (UPP2LIM(CURIYR + YEAR - 1,NERC) .LT. 1.00)THEN
					!        ROW1 = 'L'//UPRGCD(NERC)//'P2XXX'//UPYRCD(YEAR); call makmsk(ROW1_mask,':L:',UPRGCD(NERC),':P2XXX:',UPYRCD(YEAR))
					!        CALL CROWTYPE(ROW1,'L       ',ROW1_mask)
					 !       VALUE = EPPEAK(YEAR) + PKADJ
					 !       VALUE = VALUE * UPP2LIM(CURIYR + YEAR - 1,NERC)
					 !       VALUE = DIGITS2( VALUE , DIGITS_PARM)
					 !       CALL CRHS(UPRHS,ROW1,VALUE,ROW1_mask,'EP$MRM,5')
					
					 IF (UPP2LIM(LastModelYear_MNUMYRF(PlanYear),SupplyRegion_ALT1) < 1.0 ) THEN
					
					 (EPPEAK(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,CYR) + PKADJ(SupplyRegion_ALT1,PlanYear)) * UPP2LIM(LastModelYear_MNUMYRF(PlanYear),SupplyRegion_ALT1)
					
					 ENDIF
				}
			}
			Parameter ccalc_cRDBLDX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: RDBLDX(*)(*) and OML Rows: ECPCOSTS";
				Definition: 1500.0 * UPGNPD(element(MNUMYRF_,ORD(CYR)+ORD(PlanYear)-1));
			}
			Parameter ccalc_cRDBLDX_rRXXXXXge {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1)| SupplyRegion_ALTX = SupplyRegion_ALT1 and PlanYear > '1' and ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: "OML Columns: RDBLDX(*)(*) and OML Rows: R(*)XXXXX(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cRDBLDX_rRXXXXXn {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1) | SupplyRegion_ALTX = SupplyRegion_ALT1 and PlanYear = '1' and ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: "OML Columns: RDBLDX(*)(*) and OML Rows: R(*)XXXXX(*)";
				Definition: 1.0;
			}
			Parameter ccalc_cRDBLDX_UBOUND {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: RDBLDX(*)(*) and OML Rows: UBOUND";
				Default: inf;
				Definition: 100;
			}
			Parameter ccalc_cXP2XXX_ECPCOSTS {
				IndexDomain: (SupplyRegion_ALT1,PlanYear) |ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: X(*)P2XXX(*) and OML Rows: ECPCOSTS";
				Definition: 2000;
			}
			Parameter ccalc_cXP2XXX_rLP2XXXle {
				IndexDomain: (SupplyRegion_ALT1,PlanYear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: X(*)P2XXX(*) and OML Rows: L(*)P2XXX(*)";
				Definition: -1.0;
			}
		}
		DeclarationSection EP_NGBS_Completed {
			Parameter XYR_NG {
				Definition: 1;
			}
			Parameter N_OPT {
				IndexDomain: NaturalGasGroup;
				Definition: {
					IF (GRP_ECP(NaturalGasGroup)=WIEC('1') AND GRP_CCS_O(NaturalGasGroup)>0 AND
					CURIYR('1') + UHBSYR('1') + XYR_NG>=NG_CCS_SYR('1') and
					GRP_RYR(NaturalGasGroup)>= CURIYR('1') + UHBSYR('1') + UNXPH('1') - 1) THEN
					UNXPH('1') + UNXPH('1') - XYR_NG
					ELSE
					UNXPH('1')
					ENDIF
				}
			}
			Parameter OPT {
				IndexDomain: (NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1');
				Definition: {
					if ord(NGCommitYear)<=UNXPH('1') and (ord(PlanYear)>ord(NGCommitYear) or
					GRP_RYR(NaturalGasGroup)< CURIYR('1') + UHBSYR('1') + ord(NGCommitYear) - 1) then
					  0
					elseif(GRP_ECP(NaturalGasGroup)=WIEC('1') and GRP_CCS_O(NaturalGasGroup)>0 and
					CURIYR('1') + UHBSYR('1') + XYR_NG>=NG_CCS_SYR('1') and
					GRP_RYR(NaturalGasGroup)>= CURIYR('1') + UHBSYR('1') + UNXPH('1') - 1) then
					  if UNXPH('1')-XYR_NG<=ord(PlanYear)<=UNXPH('1') and
					  UNXPH('1')+1<=ord(NGCommitYear)<=UNXPH('1')+UNXPH('1')-XYR_NG and
					  ord(PlanYear)>=ord(NGCommitYear)+UNXPH('1')-N_OPT(NaturalGasGroup) then
					   2
					  else
					    1
					  endif
					 elseif ord(NGCommitYear)>=UNXPH('1')+1 then
					   0
					 else
					   1
					 endif
				}
				Comment: {
					"Currently there a 3 explicit forecast periods, UNXPH = 3
					The logic above yields the followinf OPT array
					PlanYear NGCommitYear =>     1     2    3
					  1                          1     1    1
					  2                          0     1    1
					  3                          0     0    1
					
					IF 1 means use as is and 0 means don\'t use the unit, then
					Option 1 is use the unit for 1 period and then retire,
					Option 2 is use the unit for 2 periods then retire, and Option 3 is use all 3 periods
					If the unit is eligible to retrofit extend the definition of OPT()"
				}
			}
			Parameter END_YEAR {
				IndexDomain: {
					(NaturalGasGroup,PlanYear,NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup)
				}
				Definition: {
					if OPT(NaturalGasGroup, UNXPH_PlanYear, NGCommitYear)=0 then
					  if OPT(NaturalGasGroup, PlanYear, NGCommitYear)>0 then
					    ord(NGCommitYear)
					  endif
					else
					  UNXPH('1')
					endif
				}
			}
			Parameter END_YEAR_FULL {
				IndexDomain: {
					(NaturalGasGroup, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup)
				}
				Definition: {
					if OPT(NaturalGasGroup, UNXPH_PlanYear, NGCommitYear)=0 then
					  if sum(PlanYear,OPT(NaturalGasGroup, PlanYear, NGCommitYear))>0 then
					    ord(NGCommitYear)
					  endif
					else
					  UNFPH('1')
					endif
				}
			}
			Parameter TEST_RGNS {
				IndexDomain: (NaturalGasGroup, SupplyRegion_SUB, FuelRegion);
			}
			Parameter TEST_RGNS2 {
				IndexDomain: {
					(NaturalGasGroup, SupplyRegion_SUB, FuelRegion)! | ord(SupplyRegion_SUB)=GRP_RG(NaturalGasGroup) and
					!ord(FuelRegion)=GRP_FLRG(NaturalGasGroup) and ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')
				}
				Definition: {
					!sum(NaturalGasGroup1| ord(NaturalGasGroup1)<=NUM_NGBS_GRPS('1') and NaturalGasGroup1<=NaturalGasGroup and
					!ord(SupplyRegion_SUB)=GRP_RG(NaturalGasGroup1) and ord(FuelRegion)=GRP_FLRG(NaturalGasGroup1) and
					!GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup1)>0.001 and
					!GRP_CAP(UNXPH_Element,NaturalGasGroup1)>0.0001,1)
				}
			}
			Parameter TEST_OBJ {
				IndexDomain: {
					(NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup) and GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001
				}
				Definition: {
					sum(PlanYear_ALTB| PlanYear_ALTB<=PlanYear and
					OPT(NaturalGasGroup, PlanYear_ALTB, NGCommitYear)=2,1)
				}
			}
			ElementParameter NGOPT_plants {
				IndexDomain: (NaturalGasGroup_SUB,PlanYear, NGCommitYear);
				Range: PlantType_;
				Definition: {
					if OPT(NaturalGasGroup_SUB, PlanYear, NGCommitYear)=2 then
					WIA2_Element
					else
					element(PlantType_,GRP_ECP(NaturalGasGroup_SUB))
					endif
				}
			}
			Parameter NGOPT_plantA2 {
				IndexDomain: (NaturalGasGroup,PlanYear, NGCommitYear)|ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1');
				Definition: {
					if OPT(NaturalGasGroup, PlanYear, NGCommitYear)=2 then
					WIA2('1')
					else
					GRP_ECP(NaturalGasGroup)
					endif
				}
			}
			ElementParameter NGGRP_plants {
				IndexDomain: NaturalGasGroup;
				Range: PlantType_;
				Definition: element(PlantType_,GRP_ECP(NaturalGasGroup));
			}
			Parameter CAP_FCTR {
				IndexDomain: {
					(NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(PlanYear)<=END_YEAR(NaturalGasGroup, PlanYear, NGCommitYear) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup)
				}
				Definition: {
					if OPT(NaturalGasGroup, PlanYear, NGCommitYear)=2 then
					  GRP_HTRT(ExplicitPlanningHorizon_element(PlanYear), NaturalGasGroup) / GRP_CCS_H(NaturalGasGroup)
					else
					  1
					endif
				}
			}
			Parameter UNIT_HTRT {
				IndexDomain: {
					(NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(PlanYear)<=END_YEAR(NaturalGasGroup, PlanYear, NGCommitYear) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup)
				}
				Definition: {
					if OPT(NaturalGasGroup, PlanYear, NGCommitYear)=2 then
					  GRP_CCS_H(NaturalGasGroup)
					else
					  GRP_HTRT(ExplicitPlanningHorizon_element(PlanYear), NaturalGasGroup)
					endif
				}
			}
			Parameter CCS_FCTR {
				IndexDomain: {
					(NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(PlanYear)<=END_YEAR(NaturalGasGroup, PlanYear, NGCommitYear) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup)
				}
				Definition: {
					if OPT(NaturalGasGroup, PlanYear, NGCommitYear)=2 then
					  1.0 - GRP_CCS_R(NaturalGasGroup)
					else
					  1
					endif
				}
			}
			Parameter GEN_NGBS {
				IndexDomain: (NaturalGasGroup_SUB,PlanYear,Season);
				Definition: GRP_CF(NaturalGasGroup_SUB) * SHOURS(Season, NGSupplyRegion(NaturalGasGroup_SUB), PlanYear);
			}
			Parameter Check_MR {
				IndexDomain: {
					(NaturalGasGroup,PlanYear, NGCommitYear) | ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1') and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup) and
					ord(PlanYear)<=END_YEAR(NaturalGasGroup, PlanYear, NGCommitYear)
				}
				Definition: min(1, max(0, GRP_MR(NaturalGasGroup)- (CURIYR('1') + UHBSYR('1') + ord(PlanYear) - 1) + 1));
			}
			Parameter ccalc_cRHS_rO0le {
				IndexDomain: (NaturalGasGroup,PlantType) | ord(PlantType)=GRP_ECP(NaturalGasGroup) and ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1');
				Text: "OML Columns: RHSECP and OML Rows: O(****)(**)0";
				Definition: {
					GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup) * 0.001 $
					(GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001)
				}
				Comment: "EP$NGBS,1";
			}
			Parameter ccalc_cE_rO0le {
				IndexDomain: {
					(NaturalGasGroup,PlantType,NGCommitYear) | ord(PlantType)=GRP_ECP(NaturalGasGroup) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup) and ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')
				}
				Text: "OML Columns: E(****)(**)(*) and OML Rows: O(****)(**)0";
				Definition: {
					if GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001 then
					1
					endif
				}
				Comment: "EP$NGBS,2";
			}
			Parameter ccalc_cE_LBOUND {
				IndexDomain: {
					(NaturalGasGroup,PlantType,NGCommitYear) | ord(PlantType)=GRP_ECP(NaturalGasGroup) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup) and GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001
					and ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')
				}
				Text: "OML Columns: E(****)(**)(*) and OML Rows: LBOUND";
				Definition: {
					!FORCE A LITTLE RETROFIT CAPACITY IN EACH NERC FUEL REGION COMBINATION
					IF ord(NGCommitYear)=UNXPH('1')+1 AND
					TEST_RGNS(NaturalGasGroup,NGSupplyRegion(NaturalGasGroup),NGFuelRegion(NaturalGasGroup)) AND
					GRP_CAP(UNXPH_Element,NaturalGasGroup)>0.0001 THEN
					   0.0001
					ELSE
					   0
					ENDIF
				}
				Comment: "EP$NGBS,3";
			}
			Parameter ccalc_cE_UBOUND {
				IndexDomain: {
					(NaturalGasGroup,PlantType,NGCommitYear) | ord(PlantType)=GRP_ECP(NaturalGasGroup) and
					ord(NGCommitYear)<=N_OPT(NaturalGasGroup) and GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup)>0.001 and
					ord(NaturalGasGroup)<=NUM_NGBS_GRPS('1')
				}
				Text: "OML Columns: E(****)(**)(*) and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: GRP_CAP(first(ExplicitPlanningHorizon), NaturalGasGroup) * 0.001 + 0.0001;
				Comment: "EP$NGBS,3";
			}
			Parameter ccalc_cE_ECPCOSTS {
				IndexDomain: (NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: ECPCOSTS";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rCMle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: C(*)(**)M(*)(*)(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rCXle {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,Season,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: C(*)(**)X(*)(*)(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rFMRle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: F(*)(**)MR(*)(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rFXXle {
				IndexDomain: (FuelRegion_ALT1,PlantType_ALT2,GasSeason,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: F(*)(**)XX(*)(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rRXXXXXge {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: R(*)XXXXX(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rRXXXXXn {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: R(*)XXXXX(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rTOTCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: TOTCAP(*)(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rFCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: F(*)(**)CAP(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: R(*)MXRET0";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
			Parameter ccalc_cE_rMXXge {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,FuelRegion_ALT1,PlanYear,NaturalGasGroup,PlantType,NGCommitYear);
				Text: "OML Columns: E(****)(**)(*) and OML Rows: M(*)(**)X(*)X(*)";
				Comment: "Done in Calculate_NGRETBLDCOSTS";
			}
		}
		DeclarationSection EP_NUC_Completed {
			Parameter EPLVFL_NUC {
				IndexDomain: (PlantType,SupplyRegion,PlanYear_ALTB);
				Definition: {
					IF (AIMMS_GRP(PlantType) = AINU('1')  AND UPBLDREG(PlantType,SupplyRegion) > 0.0 AND UPBLDREG(PlantType,element(SupplyRegion_,card(SupplyRegion_ALT1))) > 0.0) THEN
						NUC_FLCST_LEV(SupplyRegion,PlantType,PlanYear_ALTB) /$ PVGNP(PlantType,SupplyRegion,PlanYear_ALTB)
					ENDIF
				}
			}
			Parameter PVGNP {
				IndexDomain: (PlantType,SupplyRegion,PlanYear_ALTB) | ORD(PlanYear_ALTB) = 1 AND ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					SUM(FullPlanningHorizon|ORD(FullPlanningHorizon) <= card(FullPlanningHorizon) - (ORD(PlanYear_ALTB) + UPPLYR(PlantType))+1,
					(GNP(PlantType,PlanYear_ALTB,FullPlanningHorizon)) /
					((1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon)) ) *
					(1 + EPDSCRT('1',SupplyRegion,cyr)) ^ (-1)*(ORD(PlanYear_ALTB) + UPPLYR(PlantType) - 1)
				}
			}
			Parameter GNP {
				IndexDomain: (PlantType,PlanYear,FullPlanningHorizon)| ORD(PlanYear) = 1 AND ORD(FullPlanningHorizon) <= card(FullPlanningHorizon) - (ORD(PlanYear) + UPPLYR(PlantType))+1;
				Definition: UPGNPD(Element(MNUMYRF_,ORD(FullPlanningHorizon) + ORD(cyr) + (ORD(PlanYear) + UPPLYR(PlantType) - 2)));
			}
			Parameter NUCPRC {
				IndexDomain: (SupplyRegion,FullPlanningHorizon) | ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					IF (ORD(cyr) + ORD(FullPlanningHorizon) - 1 <= CARD(MNUMYR)) THEN
						UPURELN(SupplyRegion,Element(MNUMYR_,ORD(cyr) + ORD(FullPlanningHorizon) - 1)) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) - 1))
					ELSE
						UPURELN(SupplyRegion,Element(MNUMYR_,CARD(MNUMYR))) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) - 1))  *
						UPNUCGRW('1') ^ (ORD(cyr) + ORD(FullPlanningHorizon) - 1 - CARD(MNUMYR))
					ENDIF
					
					ELSE
					0.0
					ENDIF
				}
				Comment: "NUCPRC uses UPURELN instead of UPPFL because UPPFL is not indexed properly, better to use UPURELN (nuclear fuel)";
			}
			Parameter PVV_NUCPRC {
				IndexDomain: SupplyRegion | ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					SUM(FullPlanningHorizon,(NUCPRC(SupplyRegion,FullPlanningHorizon)) /
					((1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(FullPlanningHorizon)) )
				}
			}
			Parameter NUCFLPRC {
				IndexDomain: (SupplyRegion,CommitYear) | ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					IF (ORD(CommitYear) < UNXPH('1'))THEN
					  IF (ORD(cyr) + ORD(CommitYear) - 1 <= CARD(MNUMYR)) THEN
					      ( UPURELN(SupplyRegion,Element(MNUMYR_,ORD(cyr) + ORD(CommitYear) - 1)) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYear) - 1))) /
					          ((1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(CommitYear))
					   ELSE
					       (UPURELN(SupplyRegion,Element(MNUMYR_,CARD(MNUMYR))) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYear) - 1))  *
					          UPNUCGRW('1') ^ (ORD(cyr) + ORD(CommitYear) - 1 - CARD(MNUMYR)) ) /
					            ((1 + EPDSCRT('1',SupplyRegion,cyr) ) ^ ORD(CommitYear))
					  ENDIF
					
					ELSE
					   PVV_NUCPRC(SupplyRegion)
					ENDIF
				}
			}
			Parameter EXPTC {
				IndexDomain: (Nuclear,FullPlanningHorizon);
				Definition: {
					IF (ord(FullPlanningHorizon)+ord(cyr)-1+UHBSYR('1') >= UPGSY1(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))))
							AND ord(FullPlanningHorizon)+ord(cyr)-1+UHBSYR('1') <= UPGSYL(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) ) THEN
					   ENUC_PTC(NuclearUnit_element(Nuclear))
					ELSE
					   0.0
					ENDIF
				}
			}
			Parameter NFOM {
				IndexDomain: (Nuclear,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					     ENUC_FOM(FullPlanningHorizon,NuclearUnit_element(Nuclear)) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) - 1))
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter NVOM {
				IndexDomain: (Nuclear,FullPlanningHorizon);
				Definition: {
					IF (ORD(FullPlanningHorizon) >= UNXPH('1'))THEN
					     (ENUC_VOM(NuclearUnit_element(Nuclear)) - EXPTC(Nuclear,FullPlanningHorizon) ) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(FullPlanningHorizon) - 1))
					ELSE
					     0.0
					ENDIF
				}
			}
			Parameter PVV_NFOM {
				IndexDomain: Nuclear;
				Definition: {
					SUM(FullPlanningHorizon,(NFOM(Nuclear,FullPlanningHorizon) )/
					(1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter PVV_NVOM {
				IndexDomain: Nuclear;
				Definition: {
					SUM(FullPlanningHorizon,(NVOM(Nuclear,FullPlanningHorizon) )/
					(1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(FullPlanningHorizon))
				}
			}
			Parameter NUCRNWGEN_nat {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYear,Nuclear);
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 AND UPRNWSHR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0 AND UPRNWEXG(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) <= 0.0) THEN
					       UPRNWSHR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) * GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear)
					    ENDIF
					 ENDIF
				}
			}
			Parameter NUCSR_RNWGEN_nat {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYearSR,Nuclear);
				Definition: {
					IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWBND(ModelYear_MNUMYRX(PlanYear))> 0.005 AND UPRNWSHR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0 AND UPRNWEXG(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) <= 0.0) THEN
					       UPRNWSHR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) * GEN_SR(Nuclear,SupplyRegion_ALT1,PlanYear)
					    ENDIF
					 ENDIF
				}
			}
			Parameter NUCRNWGEN_reg {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYear,Nuclear);
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWSHRR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) > 0.0 AND UPRNWEXGR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) <= 0.0) THEN
					       UPRNWSHRR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) * GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear)
					    ENDIF
					 ENDIF
				}
			}
			Parameter NUCSR_RNWGEN_reg {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYearSR,Nuclear);
				Definition: {
					IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWSHRR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) > 0.0 AND UPRNWEXGR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) <= 0.0) THEN
					       UPRNWSHRR(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT1) * GEN_SR(Nuclear,SupplyRegion_ALT1,PlanYear)
					    ENDIF
					 ENDIF
				}
			}
			Parameter NUCAVL {
				IndexDomain: Nuclear | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					(1.0 - UPFORT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))))) *
					(1.0 - UPPMRT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))))
				}
			}
			Parameter NUCFOR {
				IndexDomain: (Nuclear,PlanYear) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					   1.0 - (ENUC_CF(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / NUCAVL(Nuclear)) ^ 0.5 *
					   (1.0 - UPFORT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))))
					ENDIF
				}
			}
			Parameter NUCPMR {
				IndexDomain: (Nuclear,PlanYear) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					  1.0 - (ENUC_CF(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / NUCAVL(Nuclear)) ^ 0.5 *
					  (1.0 - UPPMRT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))))
					ENDIF
				}
			}
			Parameter NUC_FOM {
				IndexDomain: (Nuclear,CommitYear) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					IF (ORD(CommitYear) = 1)THEN
						      0.0
					ELSEIF (ORD(CommitYear) < UNXPH('1'))THEN
						      ENUC_FOM(Element(FullPlanningHorizon_,ORD(CommitYear)),NuclearUnit_element(Nuclear)) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYear) - 1))
						      / (1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(CommitYear)
					ELSE
						     PVV_NFOM(Nuclear)
					
					ENDIF
					 ENDIF
				}
			}
			Parameter NUCSR_FOM {
				IndexDomain: (Nuclear,CommitYearSR)| ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					    IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0)THEN
						IF (ORD(CommitYearSR) = 1)THEN
							      0.0
						ELSEIF (ORD(CommitYearSR) < UNXPH('1'))THEN
							      ENUC_FOM(Element(FullPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYearSR) - 1))
							      / (1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(CommitYearSR)
						ELSE
							     PVV_NFOM(Nuclear)
					
						ENDIF
					     ENDIF
				}
			}
			Parameter NUC_VOM {
				IndexDomain: (Nuclear,CommitYear) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
						IF (ORD(CommitYear) < UNXPH('1'))THEN
					                  (ENUC_VOM(NuclearUnit_element(Nuclear)) - EXPTC(Nuclear,Element(FullPlanningHorizon_,ORD(CommitYear))) )* SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_OP(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYear))))
					                        * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYear) - 1))
					                  / (1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(CommitYear)
						ELSE
					                  PVV_NVOM(Nuclear) * SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_OP(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYear))))
						ENDIF
					 ENDIF
				}
			}
			Parameter NUCSR_VOM {
				IndexDomain: (Nuclear,CommitYearSR) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0)THEN
						IF (ORD(CommitYearSR) < UNXPH('1'))THEN
					                  (ENUC_VOM(NuclearUnit_element(Nuclear)) - EXPTC(Nuclear,Element(FullPlanningHorizon_,ORD(CommitYearSR))) ) * SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_SR(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYearSR))))
					                        * UPGNPD(Element(MNUMYRF_,ORD(cyr) + ORD(CommitYearSR) - 1))
					                  / (1 + SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,EPDSCRT('1',SupplyRegion_ALT1,cyr) )) ^ ORD(CommitYearSR)
						ELSE
					                  PVV_NVOM(Nuclear) * SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_SR(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYearSR))))
						ENDIF
					 ENDIF
				}
			}
			Parameter NUC_FLCST {
				IndexDomain: (Nuclear,CommitYear) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					    	SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_OP(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYear)))) * 0.001 *
					      	  ULHTRT_ECP(Element(PlantGroup_,ENUC_GRP(NuclearUnit_element(Nuclear))),ExplicitPlanningHorizonC_element(CommitYear))
					            *  SUM(SupplyRegion|ENUC_RG(SupplyRegion,NuclearUnit_element(Nuclear)) > 0.0,NUCFLPRC(SupplyRegion,CommitYear))
					ENDIF
				}
			}
			Parameter NUC_FLCST_BLD {
				IndexDomain: (SupplyRegion,PlantType,PlanYear_ALTB) | AIMMS_GRP(PlantType) = AINU('1') AND ORD(SupplyRegion) <= UNRGNS('1');
				Definition: {
					SUM(PlanYear | PlanYear >= PlanYear_ALTB + UPPLYR(PlantType),
						UPMCF(PlantType) * NUCFLPRC(SupplyRegion,Element(CommitYear_,ORD(PlanYear)))*8.76 *
						AVG_HTRT(PlantType,Element(FuelRegion_,NUCFLRG(SupplyRegion)),SupplyRegion,Element(ExplicitPlanningHorizon_,ORD(PlanYear))))
						* 0.001
					
					
					!                           DO JYR = OLYR , UNXPH
					!
					!                            !   CALL ECP_AVG_HTRT(FROM_LABEL, IRG, 0, IECP, JYR, AVG_HTRT, AVG_HTRT_MR, AVG_HTRT_MOD, AVG_HTRT_MR_MOD, ECP_GEN, ECP_GEN_MR, ECP_GEN_MOD, ECP_GEN_MR_MOD)  ** already called in AIMMS
					!
					!                              FLCST = FLCST + UPMCF(IECP) * 8.760 * AVG_HTRT(IECP,FRG,IRG,JYR) * UPPFL(FUEL,FRG,JYR)
					!                              IF (YEAR .EQ. 1) FLCSTL = FLCSTL + AVG_HTRT(IECP,FRG,IRG,JYR) * UPPFL(FUEL,FRG,JYR) * 0.001
					!                           END DO
					!                           FLCST = FLCST * 0.001
				}
			}
			Parameter NUC_FLCST_LEV {
				IndexDomain: (SupplyRegion,PlantType,PlanYear_ALTB) | AIMMS_GRP(PlantType) = AINU('1') AND ORD(SupplyRegion) <= UNRGNS('1') and ORD(PlanYear_ALTB) = 1;
				Definition: {
					SUM(PlanYear | PlanYear >= PlanYear_ALTB + UPPLYR(PlantType),
						NUCFLPRC(SupplyRegion,Element(CommitYear_,ORD(PlanYear))) *
						AVG_HTRT(PlantType,Element(FuelRegion_,NUCFLRG(SupplyRegion)),SupplyRegion,Element(ExplicitPlanningHorizon_,ORD(PlanYear))))
						* 0.001
					
					
					!                           DO JYR = OLYR , UNXPH
					!
					!                            !   CALL ECP_AVG_HTRT(FROM_LABEL, IRG, 0, IECP, JYR, AVG_HTRT, AVG_HTRT_MR, AVG_HTRT_MOD, AVG_HTRT_MR_MOD, ECP_GEN, ECP_GEN_MR, ECP_GEN_MOD, ECP_GEN_MR_MOD)  ** already called in AIMMS
					!
					!                              FLCST = FLCST + UPMCF(IECP) * 8.760 * AVG_HTRT(IECP,FRG,IRG,JYR) * UPPFL(FUEL,FRG,JYR)
					!                              IF (YEAR .EQ. 1) FLCSTL = FLCSTL + AVG_HTRT(IECP,FRG,IRG,JYR) * UPPFL(FUEL,FRG,JYR) * 0.001
					!                           END DO
					!                           FLCST = FLCST * 0.001
					!
				}
			}
			Parameter NUCSR_FLCST {
				IndexDomain: (Nuclear,CommitYearSR) | ORD(Nuclear) <= NUM_NUC('1');
				Definition: {
					IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0)THEN
						SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_SR(Nuclear,SupplyRegion_ALT1,Element(PlanYear_,ORD(CommitYearSR)))) * 0.001 *
						  ULHTRT_ECP(Element(PlantGroup_,ENUC_GRP(NuclearUnit_element(Nuclear))),Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)))
					            *  SUM(SupplyRegion|ENUC_RG(SupplyRegion,NuclearUnit_element(Nuclear)) > 0.0,NUCFLPRC(SupplyRegion,Element(CommitYear_,ORD(CommitYearSR))))
					 ENDIF
				}
			}
			Parameter DERATE_OP {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,Seasonx,PlanYear) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr);
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					     IF (ORD(Seasonx) = 3) THEN  !do planned maintenance in offpeak season
					       MAX(0.0, MIN(1.0, (1.0 - NUCFOR(Nuclear,PlanYear)) * (1.0 - (NUCPMR(Nuclear,PlanYear) * 8.760 / SHOURS(Element(Season_,ORD(Seasonx)),SupplyRegion_ALT1,PlanYear))) * ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Element(Season_,ORD(Seasonx)),NuclearUnit_element(Nuclear))))
					     ELSE
					       MAX(0.0, MIN(1.0, (1.0 - NUCFOR(Nuclear,PlanYear)) * ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Element(Season_,ORD(Seasonx)),NuclearUnit_element(Nuclear))))
					     ENDIF
					ENDIF
				}
			}
			Parameter GEN_OP {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,PlanYear);
				Definition: SUM(Seasonx,DERATE_OP(Nuclear,SupplyRegion_ALT1,Seasonx,PlanYear) * SHOURS(Element(Season_,ORD(Seasonx)),SupplyRegion_ALT1,PlanYear));
			}
			Parameter DERATE_SR_int {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear) | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr));
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					      IF (ORD(Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1)) = 3)THEN
							(MAX((1.0 - NUCFOR(Nuclear,PlanYear)) * NUC_CF_ECP(StepsPerGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),ECPLoadGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),SupplyRegion_ALT1),
							SR_MIN_CF(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) ) )
							* ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),NuclearUnit_element(Nuclear)) *
					 	(1.0 - (NUCPMR(Nuclear,PlanYear) * 8.760 / SHOURS(Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),SupplyRegion_ALT1,PlanYear)) )
						ELSE
							MAX((1.0 - NUCFOR(Nuclear,PlanYear)) * NUC_CF_ECP(StepsPerGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),ECPLoadGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),SupplyRegion_ALT1),
							SR_MIN_CF(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) )
							* ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),NuclearUnit_element(Nuclear))
						ENDIF
					    ENDIF
					ENDIF
				}
			}
			Parameter DERATE_SR {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear) | SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr));
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					       MAX(0.0 ,MIN( 1.0,DERATE_SR_int(Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear) ) )
					   ENDIF
					ENDIF
				}
			}
			Parameter GEN_SR {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,PlanYear);
				Definition: SUM(SliceGroup,DERATE_SR(Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear) * EPWDTH(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr))/1000.0;
			}
			Parameter CREDITSR_int {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear)| SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr));
				Definition: {
					
					    SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) *
					    (1.0 - (MAX((1.0 - NUCFOR(Nuclear,PlanYear)) * NUC_CF_ECP(StepsPerGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),ECPLoadGroup_fromSliceGroup(SliceGroup,PlanYear,SupplyRegion_ALT1),SupplyRegion_ALT1),
							SR_MIN_CF(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) )))
					      * ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Season_element2(SliceGroup,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1),NuclearUnit_element(Nuclear))
				}
			}
			Parameter CREDITSR {
				IndexDomain: (Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear)| SliceGroup <= element(SliceGroup_,EPNSTP(ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr));
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					       MAX(0.0 ,MIN( 1.0,CREDITSR_int(Nuclear,SupplyRegion_ALT1,SliceGroup,PlanYear) ) )
					   ENDIF
					ENDIF
				}
			}
			Parameter BNUCAVL {
				IndexDomain: PlantType | AIMMS_GRP(PlantType) = AINU('1');
				Definition: (1.0 - UPFORT(PlantType)) * (1.0 - UPPMRT(PlantType));
			}
			Parameter BNUCPMR {
				IndexDomain: PlantType| AIMMS_GRP(PlantType) = AINU('1');
				Definition: 1.0 - SQRT(UPMCF(PlantType) / BNUCAVL(PlantType)) * (1.0 - UPPMRT(PlantType));
			}
			Parameter BNUCFOR {
				IndexDomain: PlantType | AIMMS_GRP(PlantType) = AINU('1');
				Definition: 1.0 - SQRT(UPMCF(PlantType) / BNUCAVL(PlantType)) * (1.0 - UPFORT(PlantType));
			}
			Parameter BNUCRNWGEN_nat {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,PlantType);
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) > 0) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') ) THEN
					    		IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005  AND  UPRNWSHR(PlantType) > 0.0) THEN
					       		UPRNWSHR(PlantType) * UPMCF(PlantType) * 8.760
					    		ENDIF
					 	ENDIF
					 ENDIF
				}
			}
			Parameter BNUCRNWGEN_reg {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,PlantType);
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) > 0) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') ) THEN
					    		IF (UPRNWSHRR(PlantType,SupplyRegion_ALT1) > 0.0) THEN
					       		UPRNWSHRR(PlantType,SupplyRegion_ALT1) * UPMCF(PlantType) * 8.760
					    		ENDIF
					 	ENDIF
					 ENDIF
				}
			}
			Parameter DERATE_NEW {
				IndexDomain: {
					(PlantType,SupplyRegion_ALT1,Seasonx,PlanYear) | ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr) AND AIMMS_GRP(PlantType) = AINU('1')
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear),SupplyRegion_ALT1,cyr) > 0) THEN
						IF (ORD(Seasonx) = 3) THEN
							(1.0 - BNUCFOR(PlantType)) * (1.0 - (BNUCPMR(PlantType) * 8.76 / SHOURS(Element(Season_,ORD(Seasonx)),SupplyRegion_ALT1,PlanYear)))
						ELSE
							1.0 - BNUCFOR(PlantType)
						ENDIF
					ENDIF
				}
			}
			Parameter GEN_NEW {
				IndexDomain: (PlantType,SupplyRegion_ALT1,PlanYear);
				Definition: SUM(Seasonx,DERATE_NEW(PlantType,SupplyRegion_ALT1,Seasonx,PlanYear) * SHOURS(Element(Season_,ORD(Seasonx)),SupplyRegion_ALT1,PlanYear));
			}
			Parameter ccalc_cNUC_rNUCle {
				IndexDomain: (Nuclear,PlanYear,CommitYear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: NUC(****)(*)";
				Definition: {
					IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) > ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					        IF (ORD(PlanYear) > 1)THEN
					           IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              IF (ORD(CommitYear) = ORD(PlanYear))THEN
					                 1.0
					              ELSEIF (ORD(CommitYear) = (ORD(PlanYear) - 1))THEN
					                 -1.0 * ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear))
					              ENDIF
					           ELSEIF (ORD(CommitYear) = ORD(PlanYear)) AND (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ELSE
					           IF (ORD(CommitYear) = ORD(PlanYear)) AND
					                (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ENDIF
					     ENDIF
					  ENDIF
				}
			}
			Parameter ccalc_cNUC_rNUCeq {
				IndexDomain: (Nuclear,PlanYear,CommitYear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: NUC(****)(*)";
				Definition: {
					IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) <= ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					        IF (ORD(PlanYear) > 1)THEN
					           IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              IF (ORD(CommitYear) = ORD(PlanYear))THEN
					                 1.0
					              ELSEIF (ORD(CommitYear) = (ORD(PlanYear) - 1))THEN
					                 -1.0 * ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear))
					              ENDIF
					           ELSEIF (ORD(CommitYear) = ORD(PlanYear)) AND (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ELSE
					           IF (ORD(CommitYear) = ORD(PlanYear)) AND
					                (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ENDIF
					     ENDIF
					  ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rNUCle {
				IndexDomain: (Nuclear,PlanYear,CommitYearSR);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: NUC(****)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) > ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					        IF (ORD(PlanYear) > 1)THEN
					           IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              IF (ORD(CommitYearSR) = ORD(PlanYear))THEN
					                 1.0
					              ELSEIF (ORD(CommitYearSR) = (ORD(PlanYear) - 1))THEN
					                 -1.0 * ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear))
					              ENDIF
					           ELSEIF (ORD(CommitYearSR) = ORD(PlanYear)) AND (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ELSE
					           IF (ORD(CommitYearSR) = ORD(PlanYear)) AND
					                (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ENDIF
					     ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rNUCeq {
				IndexDomain: (Nuclear,PlanYear,CommitYearSR);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: NUC(****)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) <= ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					   IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					        IF (ORD(PlanYear) > 1)THEN
					           IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              IF (ORD(CommitYearSR) = ORD(PlanYear))THEN
					                 1.0
					              ELSEIF (ORD(CommitYearSR) = (ORD(PlanYear) - 1))THEN
					                 -1.0 * ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) / ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear))
					              ENDIF
					           ELSEIF (ORD(CommitYearSR) = ORD(PlanYear)) AND (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ELSE
					           IF (ORD(CommitYearSR) = ORD(PlanYear)) AND
					                (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					              1.0
					           ENDIF
					        ENDIF
					     ENDIF
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cRHS_rNUCle {
				IndexDomain: (Nuclear,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: NUC(****)(*)";
				Definition: {
					IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) > ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					  IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					       IF (ORD(PlanYear) > 1)THEN
					          IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) = 0.0
					                AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					             ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) * 0.001
					          ENDIF
					       ELSE
					          IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					             ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) * 0.001
					          ENDIF
					       ENDIF
					   ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cRHS_rNUCeq {
				IndexDomain: (Nuclear,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: NUC(****)(*)";
				Definition: {
					IF ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) <= ULMRUN(NuclearPlantGroup(Nuclear))) THEN
					  IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					       IF (ORD(PlanYear) > 1)THEN
					          IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear-1),NuclearUnit_element(Nuclear)) = 0.0
					                AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					             ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) * 0.001
					          ENDIF
					       ELSE
					          IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					             ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) * 0.001
					          ENDIF
					       ENDIF
					   ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cNUC_UBOUND {
				IndexDomain: (CommitYear,Nuclear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: UBOUND";
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0)THEN
					     ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) * 0.001
					ELSE
					     inf
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_UBOUND {
				IndexDomain: (CommitYearSR,Nuclear);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: UBOUND"
				}
				Range: nonnegative;
				Default: inf;
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0 AND
						ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0) THEN
							ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) * 0.001
					ELSE
						inf
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rRXXXXXge {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,CommitYear,Nuclear) | ORD(PlanYear) > 1 AND ORD(CommitYear) = ORD(PlanYear) AND ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: "OML Columns: (*)(****)NUC and OML Rows: R(*)XXXXX(*)";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear)) > 0)THEN
					    ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear))
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rRXXXXXn {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,CommitYear,Nuclear) | ORD(PlanYear) = 1 AND ORD(CommitYear) = ORD(PlanYear) AND ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: "OML Columns: (*)(****)NUC and OML Rows: R(*)XXXXX(*)";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear)) > 0)THEN
					    ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear))
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rRXXXXXge {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,CommitYearSR,Nuclear)| ORD(PlanYear) > 1 AND ORD(CommitYearSR) = ORD(PlanYear) AND ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear)) > 0)THEN
					     ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear))
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rRXXXXXn {
				IndexDomain: (SupplyRegion_ALTX,PlanYear,CommitYearSR,Nuclear) |ORD(PlanYear) = 1 AND ORD(CommitYearSR) = ORD(PlanYear) AND ORD(SupplyRegion_ALTX) <= UNRGNS('1');
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear)) > 0)THEN
					     ENUC_RG(SupplyRegion_ALTX,NuclearUnit_element(Nuclear))
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,CommitYear,Nuclear)| ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: (*)(****)NUC and OML Rows: R(*)MXRET0";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					   IF (UPRETRAT('1') > 0.0 AND ORD(CommitYear) = UNUC_RLT('1')) THEN
					      ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear))
					   ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rRMXRET0ge {
				IndexDomain: (SupplyRegion_ALT1,CommitYearSR,Nuclear) | ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: R(*)MXRET0"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					     IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					        IF (UPRETRAT('1') > 0.0 AND ORD(CommitYearSR) = UNUC_RLT('1')) THEN
					           ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear))
					        ENDIF
					     ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cNUC_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYear,Nuclear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) AND ORD(CommitYear) = ORD(PlanYear)
				}
				Text: "OML Columns: (*)(****)NUC and OML Rows: L(*)EL(*)(*)(*)(*)";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0) THEN
					   DERATE_OP(Nuclear,SupplyRegion_ALT1,Seasonx,PlanYear)
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYearSR,Nuclear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) AND ORD(CommitYearSR) = ORD(PlanYear)
				}
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					    IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0) THEN
					     DERATE_SR(Nuclear,SupplyRegion_ALT1,LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),PlanYear)
					    ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYear,Nuclear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) AND ORD(CommitYear) = ORD(PlanYear)
				}
				Text: "OML Columns: (*)(****)NUC and OML Rows: R(*)SR(*)(*)(*)(*)";
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					      IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					        MAX(0.0,MIN(1.0, SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) * NUCFOR(Nuclear,PlanYear)
					         * ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) * ENUC_SP_CAP_FAC(Season_elementx(Seasonx,SupplyRegion_ALT1),NuclearUnit_element(Nuclear)) ))
					      ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,CommitYearSR,Nuclear) | LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1)) AND ORD(CommitYearSR) = ORD(PlanYear)
				}
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					    IF (ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0) THEN
					     CREDITSR(Nuclear,SupplyRegion_ALT1,LoadSlice_element(SupplyRegion_ALT1,LoadGroup,LoadSegment,PlanYear),PlanYear)
					    ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,CommitYear,Nuclear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: G(*)RNWXX(*)";
				Definition: Sum(SupplyRegion_ALT1 | Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion, NUCRNWGEN_reg(SupplyRegion_ALT1,PlanYear,CommitYear,Nuclear));
			}
			Parameter ccalc_cNUCSR_rGRNWXXge {
				IndexDomain: (RPSRegion,PlanYear,CommitYearSR,Nuclear);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: G(*)RNWXX(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					   Sum(SupplyRegion_ALT1 | Element(RPSRegion_,UPRNWRGN(SupplyRegion_ALT1)) = RPSRegion, NUCSR_RNWGEN_reg(SupplyRegion_ALT1,PlanYear,CommitYearSR,Nuclear))
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,CommitYearSR,Nuclear);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					   NUCSR_RNWGEN_nat(SupplyRegion_ALTY,PlanYear,CommitYearSR,Nuclear)
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rGURNWXge {
				IndexDomain: (SupplyRegion_ALTY,PlanYear,CommitYear,Nuclear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: GURNWX(*)(*)";
				Definition: NUCRNWGEN_nat(SupplyRegion_ALTY,PlanYear,CommitYear,Nuclear);
			}
			Parameter ccalc_cNUC_rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear);
				Text: "OML Columns: (*)(****)NUC and OML Rows: G(*)(**)INC(*)";
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWEXG(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.00) THEN
					       GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear) / 1000.0
					    ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rGINCge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear);
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: G(*)(**)INC(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					    IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					       IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWEXG(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.00) THEN
					          GEN_SR(Nuclear,SupplyRegion_ALT1,PlanYear) / 1000.0
					       ENDIF
					    ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rGBASge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear) |ORD(PlantType) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: "OML Columns: (*)(****)NUC and OML Rows: G(*)(**)BAS(*)";
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					    IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWBAS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.00) THEN
					       GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear)
					    ENDIF
					 ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rGBASge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear) |ORD(PlantType) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: G(*)(**)BAS(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					     IF (UPRNWBND(Element(MNUMYRX_,ORD(cyr) + ORD(PlanYear) - 1)) > 0.005 AND UPRNWBAS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.00) THEN
					        GEN_SR(Nuclear,SupplyRegion_ALT1,PlanYear)
					     ENDIF
					  ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYear,Nuclear) |ORD(PlantType) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: "OML Columns: (*)(****)NUC and OML Rows: F(*)(**)GEN(*)";
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					   GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear)
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rFGENge {
				IndexDomain: (SupplyRegion_ALT1,PlantType,PlanYear,CommitYearSR,Nuclear) |ORD(PlantType) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: F(*)(**)GEN(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
						IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
							GEN_SR(Nuclear,SupplyRegion_ALT1,PlanYear)
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rFCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear,CommitYear,Nuclear) |ORD(PlantType_ALT2) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: "OML Columns: (*)(****)NUC and OML Rows: F(*)(**)CAP(*)";
				Definition: {
					IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
					   1.0
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rFCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlantType_ALT2,PlanYear,CommitYearSR,Nuclear) |ORD(PlantType_ALT2) = ENUC_ECP(NuclearUnit_element(Nuclear));
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: F(*)(**)CAP(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
						IF (ORD(CommitYearSR) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0)THEN
						  1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rGNNUCge {
				IndexDomain: (SupplyState,PlanYear,CommitYear,Nuclear) | ORD(SupplyState) = ENUC_ZECST(NuclearUnit_element(Nuclear));
				Text: "OML Columns: (*)(****)NUC and OML Rows: GN(**)NUC(*)";
				Definition: {
					 IF (ORD(CommitYear) = ORD(PlanYear) AND ENUC_CAP(ExplicitPlanningHorizon_element(PlanYear),NuclearUnit_element(Nuclear)) > 0.0 )THEN
					      IF (USW_ZECSUB('1') <> 4 AND ((ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) >= ENUC_ZECY1(NuclearUnit_element(Nuclear)) AND (ORD(cyr) + UHBSYR('1') + ORD(PlanYear) - 1) <= ENUC_ZECYR(NuclearUnit_element(Nuclear))))THEN
					          SUM(SupplyRegion_ALT1|ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0.0,GEN_OP(Nuclear,SupplyRegion_ALT1,PlanYear))
					       ENDIF
					ENDIF
				}
				Comment: "need to add a check using URG_ZEC in case a state doesn\'t give to all regions in state (NY)";
			}
			Parameter ccalc_cRHS_rGNNUCge {
				IndexDomain: (SupplyState,PlanYear);
				Text: "OML Columns: RHSECP and OML Rows: GN(**)NUC(*)";
				Definition: {
					sum(SupplyRegion|ORD(SupplyRegion) <= UNRGNS('1'),
						IF (NUCGENST(Element(FortyNine_,ORD(SupplyState)),SupplyRegion,ExplicitPlanningHorizon_element(PlanYear)) > 0.0)THEN
							0.999 * NUCGENST(Element(FortyNine_,ORD(SupplyState)),SupplyRegion,ExplicitPlanningHorizon_element(PlanYear))
						ENDIF)
				}
			}
			Parameter ccalc_cNUC_rTOTCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYear,Nuclear)|  ORD(CommitYear) = ORD(PlanYear) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: "OML Columns: (*)(****)NUC and OML Rows: TOTCAP(*)(*)";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					    1.0
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rTOTCAPn {
				IndexDomain: (SupplyRegion_ALT1,PlanYear,CommitYearSR,Nuclear) |  ORD(CommitYearSR) = ORD(PlanYear) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1');
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: TOTCAP(*)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
					  IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT1,NuclearUnit_element(Nuclear)) > 0)THEN
					    1.0
					  ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUC_rGRGRDge {
				IndexDomain: (SupplyRegion_ALT2,PlanYear,CommitYear,Nuclear) | ORD(CommitYear) = ORD(PlanYear) AND ORD(SupplyRegion_ALT2) <= UNRGNS('1');
				Text: "OML Columns: (*)(****)NUC and OML Rows: GRGRD(**)(*)";
				Definition: {
					IF (ENUC_CAP(ExplicitPlanningHorizonC_element(CommitYear),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT2,NuclearUnit_element(Nuclear)) > 0)THEN
						IF (GRD_RATS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT2) >= 0.0)THEN
					 		 GEN_OP(Nuclear,SupplyRegion_ALT2,PlanYear) * (GRD_RATS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT2) - GRD_NRYR(SupplyRegion_ALT2,ExplicitPlanningHorizon_element(PlanYear)))
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cNUCSR_rGRGRDge {
				IndexDomain: (SupplyRegion_ALT2,PlanYear,CommitYearSR,Nuclear)| ORD(CommitYearSR) = ORD(PlanYear) AND ORD(SupplyRegion_ALT2) <= UNRGNS('1');
				Text: {
					"OML Columns: (*)(****)NUC!SR and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (SR_CREDIT(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear)))) > 0.0)THEN
						IF (ENUC_CAP(Element(ExplicitPlanningHorizon_,ORD(CommitYearSR)),NuclearUnit_element(Nuclear)) > 0.0 AND ENUC_RG(SupplyRegion_ALT2,NuclearUnit_element(Nuclear)) > 0)THEN
							IF (GRD_RATS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT2) >= 0.0)THEN
					 			 GEN_SR(Nuclear,SupplyRegion_ALT2,PlanYear) * (GRD_RATS(Element(PlantType_,ENUC_ECP(NuclearUnit_element(Nuclear))),SupplyRegion_ALT2) -GRD_NRYR(SupplyRegion_ALT2,ExplicitPlanningHorizon_element(PlanYear)))
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rRXXXXXge {
				IndexDomain: {
					(SupplyRegion_ALTX,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND SupplyRegion_ALTX = SupplyRegion_ALT1
					AND ORD(SupplyREgion_ALTX) <= UNRGNS('1') AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: R(*)XXXXX(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN !might consider moving up as domain condition, may need UCPDGNIS/UCPRNWIS/UCPINTIS or UCPDSPIS as condition
							1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rTOTBLDn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: TOTBLD(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rLUSUBXle {
				IndexDomain: {
					(PlantType_ALT2,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) and ORD(PlantType_ALT2) = UPSUBTYP(PlantType)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: LU(**)SUBX"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
					           IF (LIMSUB_calc(Element(PlantType_,UPSUBTYP(PlantType))) > 0.0 AND UPSUBLIM(Element(PlantType_,UPSUBTYP(PlantType))) < 999.0) THEN
							1.0
					           ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rRUYYYYYn {
				IndexDomain: {
					(PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear = PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1)
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: RUYYYYY(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rFCAPn {
				IndexDomain: {
					(SupplyRegion_ALT1,PlantType_ALT2,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType) AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND PlantType_ALT2 = PlantType
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: F(*)(**)CAP(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rLUANNn {
				IndexDomain: {
					(PlantType,PlanYear,SupplyRegion_ALT1,OwnerType,ElasticityStep,PlanYear_ALTB) | PlantType in NUC_Types_ and ORD(SupplyRegion_ALT1) <= UNRGNS('1') and
					ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType)) and UPOVR(PlantType) < 9000 and PlanYear=PlanYear_ALTB and
					Subsidy_Case(PlanYear_ALTB, PlantType)=2
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: LU(**)ANN(*)"
				}
				Definition: {
					if UPANNLMT(PlantType, element(MNUMYR_,MIN(UNYEAR('1'), OLYEAR(PlanYear, PlantType)+CURIYR('1')))) > 999.0  THEN
					IF (OLYEAR(PlanYear, PlantType) <= UNXPH('1') AND UPBLDTYP(SupplyRegion_ALT1)=ord(OwnerType) AND UPVTYP(PlantType)= 1) and
					(UPAVLYR(PlantType)<= FULLYEAR_ALT(PlanYear, PlantType) AND (UPBLDREG_us00(PlantType)> 0 AND UPBLDREG(PlantType, SupplyRegion_ALT1)>0) ) THEN
					 1
					 endif
					 endif
				}
				Comment: "EP$NUC,51";
			}
			Parameter ccalc_cBSNUC_rLUle {
				IndexDomain: {
					(PlantType_ALT2,DispatchType,ElasticityStep,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,PlanYear_ALTB)| PlanYear = PlanYear_ALTB AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND PlantType_ALT2 = PlantType AND DispatchType = 'DS'
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: LU(**)(**)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							1.0
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rLEL2ge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: L(*)EL(*)(*)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							DERATE_NEW(PlantType,SupplyRegion_ALT1,Seasonx,PlanYear_ALTB)
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rGRGRDge {
				IndexDomain: {
					(SupplyRegion_ALT2,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB) | PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALT2 = SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: GRGRD(**)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							IF (GRD_RATS(PlantType,SupplyRegion_ALT1) >= 0.0)THEN
					                        UPMCF(PlantType) * 8.760 * (GRD_RATS(PlantType,SupplyRegion_ALT1) - GRD_NRYR(SupplyRegion_ALT1,ExplicitPlanningHorizon_element(PlanYear)))
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rRSRge {
				IndexDomain: {
					(SupplyRegion_ALT1,Seasonx,LoadGroup,LoadSegment,PlanYear,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND LoadSegment <= NumLoadSegment_element(SupplyRegion_ALT1,LoadGroup) and  ORD(Seasonx) <= EPNMSP('1',SupplyRegion_ALT1,cyr)
					and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_ALT1))
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: R(*)SR(*)(*)(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (AIMMS_GRP(PlantType) = AINU('1') AND ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							IF (SR_CREDIT(PlantType) > 0) THEN
							MAX(0.0, MIN(1.0, (SR_CREDIT(PlantType)*(1.0 - DERATE_NEW(PlantType,SupplyRegion_ALT1,Seasonx,PlanYear_ALTB)))))
							ENDIF
						ENDIF
					ENDIF
				}
			}
			Parameter ccalc_cBSNUC_rGURNWXge {
				IndexDomain: {
					(SupplyRegion_ALTY,PlanYear,SupplyRegion_ALT1,PlantType,OwnerType,ElasticityStep,PlanYear_ALTB)| PlanYear >= PlanYear_ALTB + UPPLYR(PlantType)
					 AND ORD(SupplyRegion_ALT1) <= UNRGNS('1')
					AND ORD(OwnerType) = UPBLDTYP(SupplyRegion_ALT1) AND SupplyRegion_ALTY=SupplyRegion_ALT1
				}
				Text: {
					"OML Columns: B(*)(**)(*)S(*)(*)!NUC and OML Rows: GURNWX(*)(*)"
				}
				Definition: {
					IF (BUILD_AVL(PlantType,ExplicitPlanningHorizon_element(PlanYear_ALTB),SupplyRegion_ALT1,cyr) = 2) THEN
						IF (ORD(ElasticityStep) <= MAX(1,ESTSWTCH(PlantType))) THEN
							BNUCRNWGEN_nat(SupplyRegion_ALT1,PlanYear_ALTB,PlantType)
						ENDIF
					ENDIF
				}

				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 and
				EPECAP_MR(FuelRegion0, OtherRenewable, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0 THEN
				IF (SR_MIN_CF(OtherRenewable)< EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr)) THEN
				round(SR_MIN_CF(OtherRenewable),2)
				else
				round(0.1 * EPRCFC(OtherRenewable, SupplyRegion_SUB, cyr), 2)
				endif
				endif;
				ccalc_cJMR_rLEL2ge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) |
				ccalc_cJMR_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable)<=ECP_MIN('1')):=0;
				
				!EP$ORNW,36 (1)
				ccalc_cJX_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and
				FRG_EMM_MAP(SupplyRegion_SUB, FuelRegion_ALT1)>0 and (OtherRenewable=WIWD_Element or OtherRenewable=WIBI_Element)) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and
				ord(LoadSegment)<=EPNSPG(DayType_element(LoadGroup), SupplyRegion_SUB, cyr) and SR_CREDIT(OtherRenewable)>0 THEN
				1 - ccalc_cJX_rLEL2ge(SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, FuelRegion_ALT1, OtherRenewable)
				endif;
				
				!EP$ORNW,36 (2)
				ccalc_cJXX_rRSRge((SupplyRegion_SUB, Seasonx, LoadGroup, LoadSegment, PlanYear, OtherRenewable) | ord(Seasonx)<=EPNMSP('1', SupplyRegion_SUB, cyr) and OtherRenewable <> WIWD_Element and OtherRenewable <> WIBI_Element) :=
				IF Condition_ORNW_NoHydro(OtherRenewable, SupplyRegion_SUB, PlanYear) and LoadGroup = LoadGroup_element(LoadGroup,Season_elementx(Seasonx,SupplyRegion_SUB)) and

		DeclarationSection EP_ORNW_Completed {
			Parameter Condition_ORNW_NoHydro {
				IndexDomain: (OtherRenewable, SupplyRegion_SUB, PlanYear);
			}
			Parameter Condition_ORNW_Hydro {
				IndexDomain: (OtherRenewable, SupplyRegion_SUB, PlanYear, Seasonx);
			}
			Parameter Condition_ORNW_Hydro_ALT {
				IndexDomain: (OtherRenewable, SupplyRegion_SUB, PlanYear);
			}
			Parameter HYDFAC_ALT {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
				Text: "ANNUAL HYDRO CAPACITY FACTOR ADJUSTMENT";
				Definition: {
					IF (USW_HYD('1') > 0) THEN
					        UQHYFAC(LastModelYear_MNUMYR(PlanYear), SupplyRegion_SUB) / UQHYFAC(cyr, SupplyRegion_SUB)
					ELSE
					        1
					ENDIF
				}
			}
			Parameter PS_TEST {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
				Definition: {
					IF (UPOVR(WIPS_Element)< 9000 OR EPECAP(FuelRegion0, WIPS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) THEN
					EPECAP(FuelRegion0, WIPS_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)
					endif
				}
			}
			Parameter P2_TEST {
				IndexDomain: (SupplyRegion_SUB, PlanYear);
				Definition: {
					IF (UPOVR(WIP2_Element)< 9000 OR EPECAP(FuelRegion0, WIP2_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr)>0) THEN
					EPECAP(FuelRegion0, WIP2_Element, ExplicitPlanningHorizon_element(PlanYear), SupplyRegion_SUB, cyr) + 0.001
					endif
				}
			}
			Parameter VOM_ORNW {
				IndexDomain: (OtherRenewable, SupplyRegion_SUB, FullPlanningHorizon);
				Definition: {
					IF (UPOVR(OtherRenewable) < 9000 OR EPECAP(FuelRegion0, OtherRenewable, Explicit2FullPlanningHorizon(FullPlanningHorizon), SupplyRegion_SUB, cyr)>0) THEN
					   IF (EPECAP(FuelRegion0, OtherRenewable, Explicit2FullPlanningHorizon(FullPlanningHorizon), SupplyRegion_SUB, cyr)>0 OR
					   (UPVTYP(OtherRenewable)= 1 AND UPAVLYR(OtherRenewable) <= CURIYR('1') + UHBSYR('1') + UNFPH('1') AND UPBLDREG(OtherRenewable,SupplyRegion_SUB) > 0)) THEN
					       UPGNPD(MNUMYRF_KYR(FullPlanningHorizon)) * EPIRVOM(OtherRenewable, SupplyRegion_SUB, cyr)
					   endif
					endif;
				}
			}
			Parameter VOMCST_ORNW {
				IndexDomain: (OtherRenewable, SupplyRegion_SUB, PlanYear);
				Definition: {
					IF ord(PlanYear)< UNXPH('1') THEN
					VOM_ORNW(OtherRenewable, SupplyRegion_SUB, FullPlanningHorizon_PlanYear(PlanYear)) * PWF_Function(EPDSCRT('1',SupplyRegion_SUB,cyr),Year)(PlanYear)
					else
					sum(FullPlanningHorizon| ord(FullPlanningHorizon)<= UNFPH('1')- UNXPH('1') + 1,
					!PVV_Function(VOM_ORNW(OtherRenewable, SupplyRegion_SUB, FullPlanningHorizon+2),ord(FullPlanningHorizon),EPDSCRT('1',SupplyRegion_SUB,cyr))) *
					VOM_ORNW(OtherRenewable, SupplyRegion_SUB, FullPlanningHorizon+(UNXPH('1')-1)) / ((1 + EPDSCRT('1',SupplyRegion_SUB,cyr)) ^ ord(FullPlanningHorizon)))*
					PWF_Function(EPDSCRT('1',SupplyRegion_SUB,cyr),UNXPH01)(PlanYear)
					endif;
				}
			}

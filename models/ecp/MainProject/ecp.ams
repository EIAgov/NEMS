			}
			Constraint rEUSORSle {
				IndexDomain: (SO2Region,PlanYear);
				Text: "OML Rows: EUSORS(*)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEUSORS_rEUSORSle(SO2Region,PlanYear) *
					      cEUSORS(SO2Region,PlanYear)
					+
					sum((FuelRegion_ALT1),
					coeff_cTRSXX_rEUSORSle(SO2Region,PlanYear,FuelRegion_ALT1) *
					      cTRSXX(FuelRegion_ALT1,PlanYear))
					
					<=
					
					0.
				}
				Comment: "accumulate SO2 emissions from residual fuel oil plants by SO2 region and planning year (thousand tons --CSAPR)";
			}
			Constraint rEVNle {
				IndexDomain: (PlantType,NOXRegion,PlanYear);
				Text: "OML Rows: EVN(**)(**)(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					coeff_cEVN_rEVNle(PlantType,NOXRegion,PlanYear) *
					      cEVN(PlantType,NOXRegion,PlanYear)
					+
					sum((CommitYear,CoalGroup,RetrofitCFG),
					coeff_cRETRO_rEVNle(PlantType,NOXRegion,PlanYear,CommitYear,CoalGroup,RetrofitCFG) *
					      cRETRO(CommitYear,CoalGroup,RetrofitCFG))
					+
					sum((HTRTYear,CoalGroup,RetrofitCFG),
					coeff_cRETROHTRT_rEVNle(PlantType,NOXRegion,PlanYear,HTRTYear,CoalGroup,RetrofitCFG) *
					      cRETROHTRT(HTRTYear,CoalGroup,RetrofitCFG))
					
					<=
					
					0.
				}
				Comment: "accumulate NOX emissions savings from retrofits by plant type, NOX region (and seasonal), and planning year (1000 tons)";
			}
			Constraint rEX_Xle {
				IndexDomain: (SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,PlanYear);
				Text: "OML Rows: E(*)(**)X(*)X(*)";
				Property: Bound, ShadowPrice, Level;
				Definition: {
					sum((OwnerType,ElasticityStep,PlanYear_ALTB),
					coeff_cBBIO_rEX_Xle(SupplyRegion_ALT1,PlantType,FuelRegion_ALT1,PlanYear,OwnerType,ElasticityStep,PlanYear_ALTB) *
					      cBBIO(SupplyRegion_ALT1,PlantType,OwnerType,FuelRegion_ALT1,ElasticityStep,PlanYear_ALTB))
					+
					sum((OwnerType,ElasticityStep_ALT1,PlanYear_ALTB),

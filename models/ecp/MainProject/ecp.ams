				HR_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) and ord(PlanYear)>1 THEN
				0.0000005 * GEN_MAX_SR_ODSP(DSP_Types, Seasonhr_element(Season_hr), SupplyRegion_SUB, FuelRegion_ALT1, OperatingMode, PlanYear) * DSP_HTRT_MOD_NMR(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *
				B_HTRT_ADJ(DSP_Types, FuelRegion_ALT1, SupplyRegion_SUB, PlanYear) *

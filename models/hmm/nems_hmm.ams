## ams_version=1.0

LibraryModule nems_hmm {
	Prefix: nh;
	Interface: data { MainExecution_API, ncrl, curitr, curcalyr, modscendate} + nh::GDS_Parameters + nh::GDS_Sets;
	Procedure LibraryInitialization {
		Body: {
			pr_InitializeCalendar;
			
			read from file "../../hmm/input/h2config.txt" in merge mode;
			read from file "../../hmm/input/h2setmap.txt" in merge mode;
			
			SeasonalFraction(seas) := DATA {'1' : 0.16666666666, '2': 0.33333333333, '3' : 0.16666666666, '4' : 0.33333333333};
		}
	}
	Module TestModule {
		SourceFile: "MainProject\\AMS Files\\TestModule.ams";
	}
	Section S0_NEMS_Interface {
		SourceFile: "MainProject\\AMS Files\\S0 NEMS Interface.ams";
	}
	Section S1_Data {
		SourceFile: "MainProject\\AMS Files\\S1 Data.ams";
	}
	Section S2_Data_Import_Export {
		SourceFile: "MainProject\\AMS Files\\S2 Data Import Export.ams";
	}
	Section S3_Data_Processing {
		SourceFile: "MainProject\\AMS Files\\S3 Data Processing.ams";
	}
	Section S4_Calculations {
		SourceFile: "MainProject\\AMS Files\\S4 Calculations.ams";
	}
	Section S5_Optimization {
		SourceFile: "MainProject\\AMS Files\\S5 Optimization.ams";
	}
	Section S6_Output {
		SourceFile: "MainProject\\AMS Files\\S6 Output.ams";
	}
	Section S7_GUI {
		SourceFile: "MainProject\\AMS Files\\S7 GUI.ams";
	}
	Section S8_Miscellaneous {
		SourceFile: "MainProject\\AMS Files\\S8 Miscellaneous.ams";
	}
	Procedure MainExecution_API {
		Body: {
			block where
				case_compression_level := 0,
				Global_error_handler := "HMM_Error_Handler",
				initial_column_reservation := 10000000,
				warning_comparing_elements_different_sets := off,
				warning_duplicate_column := off,
				warning_duplicate_row := off,
				advanced_start := 1,
				"CPLEX 22.1".LP_method := 6,
				"CPLEX 22.1".updates_batch_size := 10000000,
				"CPLEX 22.1".barrier_crossover_algorithm := 2,
				"CPLEX 22.1".global_thread_limit := 32,
				"CPLEX 22.1".parallel_mode := 1,
				"CPLEX 22.1".barrier_display := 2,
				"CPLEX 22.1".feasibility := 1e-08,
				"CPLEX 22.1".optimality := 0.0001,
				Number_1000_separator := 3,
				Number_decimal_separator := 2;
			
			SetMappingDefinitions;
			
			! Read file for any scedes switches
			Read_Runtime_Parameters;
			
			! Establish request data paths
			_sp_input := dex::api::RequestAttribute('request-data-path') ; ! API path from NEMS
			_sp_out := dex::api::RequestAttribute('response-data-path') ; ! API path to NEMS
			
			helper_input := dex::api::RequestAttribute('request-data-path') ;
			
			! Generate mappings
			!dex::DatasetGeneratorFilter(dex::gt, dex::mm, dex::amt) := data { ( JSON  ,  Table  , Sparse           ) : 1 };
			!dex::GenerateDatasetMappings;
			
			! Add mapping
			dex::AddMapping(
			mappingName : "json-request-mapping",
			mappingFile : "Mappings/Generated/restinput-request-JSON-Sparse.xml"
			);
			
			
			! Read Year/Iteration/NCRL info from NEMS		
			dex::ReadFromFile(_sp_input,"json-request-mapping");
			
			! Assign the values of what Python sent to these control parameters
			ncntrl_curcalyr('1'):=curcalyr;
			ncntrl_curitr('1'):=curitr;
			ncntrl_ncrl('1'):=ncrl;
			
			nh::MainExecution;
			
			endblock;
			SaveProfilerResults;
		}
		dex::ServiceName: call;
		StringParameter _sp_out;
		StringParameter _sp_input {
			Property: Input;
		}
	}
	Procedure MainInitialization {
		Body: {
			if ProjectDeveloperMode then
				ProfilerStart;
			!	IdentifierShowAttributes('Main_Model');
			endif;
			
			pr_InitializeCalendar;
			
			read from file "../../hmm/input/h2config.txt" in merge mode;
			read from file "../../hmm/input/h2setmap.txt" in merge mode;
			
			SeasonalFraction(seas) := DATA {'1' : 0.16666666666, '2': 0.33333333333, '3' : 0.16666666666, '4' : 0.33333333333};
		}
		Comment: "Add initialization statements here that do NOT require any library being initialized already.";
	}
	Procedure PostMainInitialization {
		Body: {
			pr_WriteIdentifierTranslations;
			pr_MakeIdentifiersReadOnly;
			
			read from file "my_port.txt";
			!my_port := 8050;
			dex::api::ListenerPort := nh::my_port;
			dex::api::StartAPIService;
		}
		Comment: {
			"Add initialization statements here that require that the libraries are already initialized properly,
			or add statements that require the Data Management module to be initialized."
		}
	}
	Procedure NEMS_Monitor {
